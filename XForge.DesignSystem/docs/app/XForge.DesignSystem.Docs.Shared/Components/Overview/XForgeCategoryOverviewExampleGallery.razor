<div class="grid gap-4">
    <XFTypography Variant="XFTypographyVariant.H3" Weight="XFTypographyWeight.Semibold">@Title</XFTypography>

    @foreach (var example in Examples)
    {
        <XFCard Variant="XFCardVariant.Elevated" Padding="XFPadding.Lg" AreaRestricted="false">
            <Header>
                <div class="grid gap-1">
                    <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@example.Title</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Muted">@example.Description</XFTypography>
                </div>
            </Header>
            <ChildContent>
                <div class="grid gap-4">
                    <div class="rounded-xl border border-border-light bg-surface-50 p-4">
                        @example.Preview
                    </div>
                    <XFCode Text="@example.Code" Language="razor" />
                </div>
            </ChildContent>
        </XFCard>
    }
</div>

@code {
    [Parameter]
    public string Title { get; set; } = "Example Gallery";

    [Parameter, EditorRequired]
    public IReadOnlyList<XForgeCategoryOverviewExample> Examples { get; set; } = [];
}
