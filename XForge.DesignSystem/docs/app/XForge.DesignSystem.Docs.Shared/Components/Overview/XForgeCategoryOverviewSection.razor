<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg" AreaRestricted="false">
    <Header>
        <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@Title</XFTypography>
    </Header>
    <ChildContent>
        @if (Description is not null)
        {
            <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Muted">@Description</XFTypography>
        }

        <div class="@GridClass">
            @foreach (var item in Items)
            {
                <XForgeCategoryOverviewTile Item="item" />
            }
        </div>
    </ChildContent>
</XFCard>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<XForgeCategoryOverviewItem> Items { get; set; } = [];

    [Parameter]
    public int Columns { get; set; } = 2;

    private string GridClass => Columns switch
    {
        3 => "grid gap-3 md:grid-cols-3",
        4 => "grid gap-3 md:grid-cols-4",
        _ => "grid gap-3 md:grid-cols-2"
    };
}
