<div class="grid gap-3 rounded-lg border border-border-light bg-surface-50 p-4">
    <div class="flex min-w-0 items-center gap-4">
        <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-primary/10 bg-primary/10 text-primary" aria-hidden="true">
            @((MarkupString)XFSvgIcons.MarkupWithSize(Item.Icon, IconSize))
        </span>
        <div class="min-w-0">
            <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@Item.Title</XFTypography>
        </div>
    </div>
    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@Item.Description</XFTypography>
</div>

@code {
    [Parameter, EditorRequired]
    public XForgeCategoryOverviewItem Item { get; set; } = default!;

    [Parameter]
    public int IconSize { get; set; } = 18;
}
