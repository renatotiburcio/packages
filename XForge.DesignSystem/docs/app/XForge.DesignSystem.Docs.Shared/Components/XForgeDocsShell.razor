@using XForge.DesignSystem.Docs.Shared.Navigation

<article class="mx-auto grid w-full max-w-7xl gap-6">
    <header class="flex flex-wrap items-start justify-between gap-4 border-b border-border-light pb-5">
        <div class="min-w-0">
            <XFTypography Variant="XFTypographyVariant.Overline"
                          Color="XFTypographyColor.Muted"
                          Text="@ProductLabel" />
            <XFTypography Variant="XFTypographyVariant.H3"
                          As="h1"
                          Text="@Title"
                          Class="mt-1" />
        </div>
        @if (!string.IsNullOrWhiteSpace(Status))
        {
            <XFBadge Text="@Status"
                     Variant="XFBadgeVariant.Outline"
                     Color="XFBadgeColor.Neutral"
                     Size="XFBadgeSize.Sm" />
        }
    </header>

    <div class="min-w-0">
        @ChildContent
    </div>
</article>

@code {
    [Parameter, EditorRequired] public string ProductLabel { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Status { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<XForgeDocsNavItem> Items { get; set; } = [];
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
