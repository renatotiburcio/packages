@using XForge.DesignSystem.Core.Primitives
<section class="mt-8 grid gap-5" aria-label="Padrao de documentacao">
    <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg" AreaRestricted="false">
        <Header>
            <div class="grid gap-1">
                <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">
                    @(IsOverview ? "Contrato da visao geral" : "Contrato da pagina")
                </XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">
                    Esta secao padroniza a pagina nova enquanto o conteudo especializado evolui por componente.
                </XFTypography>
            </div>
        </Header>
        <ChildContent>
            <div class="grid gap-4 md:grid-cols-3">
                @foreach (var item in SummaryItems)
                {
                    <div class="grid gap-1 rounded-lg border border-border-light bg-surface-50 p-4">
                        <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
                    </div>
                }
            </div>
        </ChildContent>
    </XFCard>

    @if (!IsOverview)
    {
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.None" AreaRestricted="false">
            <Header>
                <div class="px-6 pt-6">
                    <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">Exemplo base</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">
                        Preview minimo e codigo copiavel usando o componente documentado.
                    </XFTypography>
                </div>
            </Header>
            <ChildContent>
                <div class="grid">
                    <div class="border-t border-border-light p-6">
                        @if (Preview is not null)
                        {
                            @Preview
                        }
                        else
                        {
                            <div class="grid gap-2 rounded-lg border border-border-light bg-surface-50 p-4">
                                <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@ComponentName</XFTypography>
                                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">
                                    Use o preview especifico da pagina para demonstrar estados, variacoes e composicao real.
                                </XFTypography>
                            </div>
                        }
                    </div>
                    <div class="border-t border-border-light bg-surface-50 p-6">
                        <XFCode Text="@ResolvedExampleCode"
                                Language="razor"
                                Title="Codigo base"
                                Variant="XFCodeVariant.Block"
                                Copyable="true"
                                Wrap="true" />
                    </div>
                </div>
            </ChildContent>
        </XFCard>

        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg" AreaRestricted="false">
            <Header>
                <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">API</XFTypography>
            </Header>
            <ChildContent>
                <XFTable Size="XFSize.Sm" Striped="true">
                    <XFTableHeader>
                        <XFTableRow>
                            <XFTableCell Header="true">Area</XFTableCell>
                            <XFTableCell Header="true">Contrato</XFTableCell>
                            <XFTableCell Header="true">Orientacao</XFTableCell>
                        </XFTableRow>
                    </XFTableHeader>
                    <XFTableBody>
                        @foreach (var row in ApiRows)
                        {
                            <XFTableRow>
                                <XFTableCell><XFCode Text="@row.Name" /></XFTableCell>
                                <XFTableCell>@row.Type</XFTableCell>
                                <XFTableCell>@row.Description</XFTableCell>
                            </XFTableRow>
                        }
                    </XFTableBody>
                </XFTable>
            </ChildContent>
        </XFCard>
    }

    <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg" AreaRestricted="false">
        <Header>
            <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">Acessibilidade</XFTypography>
        </Header>
        <ChildContent>
            <div class="grid gap-3 md:grid-cols-2">
                @foreach (var rule in AccessibilityRules)
                {
                    <div class="rounded-lg border border-border-light bg-surface-50 p-4">
                        <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@rule</XFTypography>
                    </div>
                }
            </div>
        </ChildContent>
    </XFCard>

    @if (!IsOverview)
    {
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg" AreaRestricted="false">
            <Header>
                <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">Teclado</XFTypography>
            </Header>
            <ChildContent>
                <XFTable Size="XFSize.Sm" Striped="true">
                    <XFTableHeader>
                        <XFTableRow>
                            <XFTableCell Header="true">Tecla</XFTableCell>
                            <XFTableCell Header="true">Comportamento</XFTableCell>
                        </XFTableRow>
                    </XFTableHeader>
                    <XFTableBody>
                        @foreach (var row in KeyboardRows)
                        {
                            <XFTableRow>
                                <XFTableCell><XFCode Text="@row.Name" /></XFTableCell>
                                <XFTableCell>@row.Description</XFTableCell>
                            </XFTableRow>
                        }
                    </XFTableBody>
                </XFTable>
            </ChildContent>
        </XFCard>
    }

    <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg" AreaRestricted="false">
        <Header>
            <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">Performance</XFTypography>
        </Header>
        <ChildContent>
            <div class="grid gap-3 md:grid-cols-2">
                @foreach (var rule in PerformanceRules)
                {
                    <div class="rounded-lg border border-border-light bg-surface-50 p-4">
                        <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@rule</XFTypography>
                    </div>
                }
            </div>
        </ChildContent>
    </XFCard>

    <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg" AreaRestricted="false">
        <Header>
            <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">Changelog</XFTypography>
        </Header>
        <ChildContent>
            <XFTable Size="XFSize.Sm" Striped="true">
                <XFTableHeader>
                    <XFTableRow>
                        <XFTableCell Header="true">Versao</XFTableCell>
                        <XFTableCell Header="true">Alteracao</XFTableCell>
                    </XFTableRow>
                </XFTableHeader>
                <XFTableBody>
                    <XFTableRow>
                        <XFTableCell><XFCode Text="Migracao split" /></XFTableCell>
                        <XFTableCell>Pagina alinhada ao shell compartilhado, Tailwind v4 e contrato DesignSystem-first.</XFTableCell>
                    </XFTableRow>
                </XFTableBody>
            </XFTable>
        </ChildContent>
    </XFCard>
</section>

@code {
    [Parameter, EditorRequired] public string ComponentName { get; set; } = string.Empty;
    [Parameter] public bool IsOverview { get; set; }
    [Parameter] public RenderFragment? Preview { get; set; }
    [Parameter] public string? ExampleCode { get; set; }

    private string ResolvedExampleCode => !string.IsNullOrWhiteSpace(ExampleCode)
        ? ExampleCode
        : $"<{ComponentName} />";

    private IReadOnlyList<DocStandardItem> SummaryItems => IsOverview
        ? OverviewSummaryItems
        : ComponentSummaryItems;

    private static readonly IReadOnlyList<DocStandardItem> ComponentSummaryItems =
    [
        new("Preview renderizado", "A pagina deve mostrar o componente em uso real, com estados relevantes."),
        new("Codigo copiavel", "Exemplos devem expor snippets completos via XFCode."),
        new("Contrato operacional", "API, acessibilidade, teclado, performance e changelog precisam estar visiveis.")
    ];

    private static readonly IReadOnlyList<DocStandardItem> OverviewSummaryItems =
    [
        new("Mapa da categoria", "A visao geral orienta quando usar cada familia de componentes."),
        new("Padrao visual", "Cards, texto, badges e tabelas devem vir do XForge.DesignSystem quando existirem."),
        new("Governanca", "Overview aponta para qualidade, acessibilidade, performance e evolucao da categoria.")
    ];

    private static readonly IReadOnlyList<DocStandardItem> ApiRows =
    [
        new("Parametros", "Public API", "Documentar parametros reais do componente e valores padrao."),
        new("Eventos", "EventCallback", "Explicar callbacks, payloads e efeitos colaterais esperados."),
        new("Slots", "RenderFragment", "Listar ChildContent, Header, Footer, Actions ou templates aplicaveis."),
        new("Tipos", "Enums/modelos", "Referenciar tipos auxiliares, itens, contextos e contratos.")
    ];

    private static readonly IReadOnlyList<string> AccessibilityRules =
    [
        "Use labels, aria-label ou texto visivel suficiente para controles interativos.",
        "Estados disabled, readonly, invalid, selected e expanded devem ser comunicados por semantica ou ARIA.",
        "Foco visivel e ordem de tabulacao devem permanecer previsiveis dentro de exemplos e composicoes.",
        "Nao use cor como unica forma de comunicar status, erro ou risco."
    ];

    private static readonly IReadOnlyList<DocStandardItem> KeyboardRows =
    [
        new("Tab", "Foco", "Move para o proximo controle interativo."),
        new("Shift+Tab", "Foco", "Retorna para o controle anterior."),
        new("Enter", "Acao", "Ativa botoes, submits ou selecao primaria quando aplicavel."),
        new("Space", "Acao", "Alterna controles como checkbox, switch, botao e itens selecionaveis."),
        new("Escape", "Cancelamento", "Fecha overlays, cancela edicao ou libera foco quando o componente suporta.")
    ];

    private static readonly IReadOnlyList<string> PerformanceRules =
    [
        "Evite recriar colecoes, modelos e delegates pesados a cada render em exemplos complexos.",
        "Use templates e ChildContent de forma deterministica; mova calculos caros para propriedades/cache.",
        "Mantenha dimensoes estaveis para reduzir layout shift em previews, tabelas, listas e overlays.",
        "Documente JS interop, virtualizacao, debounce ou carregamento tardio quando o componente depender disso."
    ];

    private sealed record DocStandardItem(string Name, string Type, string Description)
    {
        public DocStandardItem(string name, string description)
            : this(name, string.Empty, description)
        {
        }

        public string Title => Name;
    }
}
