@inherits LayoutComponentBase
@implements IDisposable

<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-surface focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-text-primary focus:shadow-lg">
    @SkipToContentLabel
</a>

<XFAppShell Theme="@Theme"
            Brand="@CurrentBrand"
            MainClass="flex-1 overflow-y-auto overflow-x-hidden bg-surface-50/30 outline-none p-4 md:p-6 lg:p-8">
    <Rail>
        <XForgeDocsRail Product="@Product" />
    </Rail>
    <Sidebar>
        <XForgeDocsSidebar Product="@Product" />
    </Sidebar>
    <AppBar>
        <XForgeDocsTopBar Product="@Product" IsDark="@_isDark" OnToggleTheme="@ToggleThemeAsync" />
    </AppBar>
    <Footer>
        <XFFooter UserName="@VisitorLabel" AppName="@XForgeDocsNavigation.GetProductName(Product)" Version="v1.0.0" />
    </Footer>
    <ChildContent>
        <XFDialogProvider />
        <XFDrawerProvider />
        <XFToastProvider />
        <XForgeDocsScrollToTop />
        <div @key="_languageRenderKey">
            @Body
        </div>
    </ChildContent>
</XFAppShell>
