<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>XForge.DesignSystem.Docs</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\XForge.DesignSystem\XForge.DesignSystem.csproj" />
    <ProjectReference Include="..\XForge.DesignSystem.Docs.Shared\XForge.DesignSystem.Docs.Shared.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="BuildTailwindCSS" BeforeTargets="Build" Condition="false">
    <Message Text="Tailwind build skipped (npm not configured)" Importance="low" />
  </Target>

</Project>
