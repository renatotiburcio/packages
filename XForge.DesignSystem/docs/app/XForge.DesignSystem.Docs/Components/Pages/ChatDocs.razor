@page "/feedback/chat"
@page "/components/chat"
@using XForge.DesignSystem.Components.Feedback.Chat
@using XForge.DesignSystem.Core.Primitives
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="Core OSS"
                 Title="Chat"
                 Status="Premium"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">

        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFChat" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Templates", "Templates")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Enterprise", "Enterprise")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Interface de chat enterprise para suporte, atendimento e colaboracao.", "Enterprise chat interface for support, service and collaboration.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("Mensagens com roles (User/Assistant/System), avatares, typing indicator, templates customizaveis, composer com adornos e envio por Enter.",
                               "Messages with roles (User/Assistant/System), avatars, typing indicator, custom templates, composer with adornments and Enter-to-send.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico. Interacoes requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderizacao.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Consideracoes", "Considerations")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor Server: eventos sao tratados via SignalR. Sem latencia adicional para componentes puramente renderizados.", "Blazor Server: events are handled via SignalR. No additional latency for purely rendered components.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor WebAssembly: eventos sao tratados diretamente no cliente. Mais responsivo.", "Blazor WebAssembly: events are handled directly on the client. More responsive.")</XFTypography>
                </XFStack>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Basico", "1. Basic"),
                T("Chat simples com mensagens User e Assistant.", "Simple chat with User and Assistant messages."),
                ExBasic(), CodeBasic)

            @Example(T("2. Usuarios com avatares", "2. Users with avatars"),
                T("Usuarios com nomes, avatares e status online.", "Users with names, avatars and online status."),
                ExUsers(), CodeUsers)

            @Example(T("3. Roles de mensagem", "3. Message roles"),
                T("User, Assistant, System e Other � estilos visuais diferentes.", "User, Assistant, System and Other � different visual styles."),
                ExRoles(), CodeRoles)

            @Example(T("4. Loading e typing", "4. Loading & typing"),
                T("Indicador de digitacao e estado de carregamento.", "Typing indicator and loading state."),
                ExLoading(), CodeLoading)

            @Example(T("5. SendOnEnter", "5. SendOnEnter"),
                T("SendOnEnter=false permite Shift+Enter para nova linha.", "SendOnEnter=false allows Shift+Enter for new line."),
                ExSendOnEnter(), CodeSendOnEnter)

            @Example(T("6. Message template", "6. Message template"),
                T("RenderFragment<XFChatMessage> para markup customizado.", "RenderFragment<XFChatMessage> for custom markup."),
                ExMessageTemplate(), CodeMessageTemplate)

            @Example(T("7. Header customizado", "7. Custom header"),
                T("HeaderContent render fragment para toolbar ou status.", "HeaderContent render fragment for toolbar or status."),
                ExCustomHeader(), CodeCustomHeader)

            @Example(T("8. Composer adornos", "8. Composer adornments"),
                T("ComposerStart e ComposerEnd para botoes de anexo e acoes.", "ComposerStart and ComposerEnd for attachment and action buttons."),
                ExComposerAdornments(), CodeComposerAdornments)

            @Example(T("9. Somente leitura", "9. Read-only"),
                T("ReadOnly=true desabilita o composer para visualizacao.", "ReadOnly=true disables composer for viewing."),
                ExReadOnly(), CodeReadOnly)

            @Example(T("10. Cenario enterprise", "10. Enterprise scenario"),
                T("Chat de suporte tecnico com tickets, status e historico.", "Technical support chat with tickets, status and history."),
                ExEnterprise(), CodeEnterprise)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API � XFChat", @<div>@ApiTable(ApiRows)</div>)
            @Section("API � XFChatMessage", @<div>@ApiTable(MessageApiRows)</div>)
            @Section("API � XFChatUser", @<div>@ApiTable(UserApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>

    </XFStack>
</XForgeDocsShell>

@code {
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);
    private string CopyableCodeTitle => T("Copiar codigo", "Copy code");

    // --- State ---
    private IReadOnlyList<XFChatMessage> BasicMessages = new[]
    {
        new XFChatMessage { UserId = "agent", Content = "Ola! Como posso ajudar?", Role = AiRole.Assistant, Timestamp = DateTime.Now.AddMinutes(-5) },
        new XFChatMessage { UserId = "user1", Content = "Preciso verificar o status do pedido #4821.", Role = AiRole.User, Timestamp = DateTime.Now.AddMinutes(-4) },
        new XFChatMessage { UserId = "agent", Content = "Claro! O pedido #4821 esta em transporte. Previsao de entrega: 15/06/2026.", Role = AiRole.Assistant, Timestamp = DateTime.Now.AddMinutes(-3) }
    };

    private IReadOnlyList<XFChatUser> DemoUsers = new[]
    {
        new XFChatUser { Id = "user1", Name = "Maria Silva", IsOnline = true },
        new XFChatUser { Id = "agent", Name = "Suporte XF", IsOnline = true }
    };

    private IReadOnlyList<XFChatMessage> RoleMessages = new[]
    {
        new XFChatMessage { UserId = "user1", Content = "Mensagem do usuario.", Role = AiRole.User, Timestamp = DateTime.Now.AddMinutes(-4) },
        new XFChatMessage { UserId = "agent", Content = "Resposta do assistente.", Role = AiRole.Assistant, Timestamp = DateTime.Now.AddMinutes(-3) },
        new XFChatMessage { UserId = "system", Content = "Conversa iniciada.", Role = AiRole.System, Timestamp = DateTime.Now.AddMinutes(-5) },
        new XFChatMessage { UserId = "other", Content = "Nota interna.", Role = AiRole.Other, Timestamp = DateTime.Now.AddMinutes(-2) }
    };

    private IReadOnlyList<XFChatMessage> EnterpriseMessages = new[]
    {
        new XFChatMessage { UserId = "system", Content = "Ticket #7842 aberto � Setor: Financeiro | Prioridade: Alta", Role = AiRole.System, Timestamp = DateTime.Now.AddMinutes(-10) },
        new XFChatMessage { UserId = "user1", Content = "Nao recebi o boleto da NF-e 2026/0042. Pode reenviar?", Role = AiRole.User, Timestamp = DateTime.Now.AddMinutes(-8) },
        new XFChatMessage { UserId = "agent", Content = "Identifiquei o problema. O boleto foi gerado mas o envio por email falhou. Estou reenviando agora para financeiro@empresa.com.br.", Role = AiRole.Assistant, Timestamp = DateTime.Now.AddMinutes(-6) },
        new XFChatMessage { UserId = "agent", Content = "Boleto reenviado com sucesso. Protocolo: PROT-2026-7842-R. Prazo de compensacao: 3 dias uteis.", Role = AiRole.Assistant, Timestamp = DateTime.Now.AddMinutes(-5) }
    };

    // --- Hero ---
    private RenderFragment HeroPreview() => @<div class="h-80">
        <XFChat
                Title="@T("Suporte XF", "XF Support")"
                Subtitle="@T("Online", "Online")"
                Messages="BasicMessages"
                Users="DemoUsers"
                CurrentUserId="user1"
                Size="XFSize.Md"
                Placeholder="@T("Digite sua mensagem...", "Type your message...")"
                ReadOnly="true" />
    </div>;

    // --- 1. Basic ---
    private RenderFragment ExBasic() => @<div class="h-72">
        <XFChat Title="@T("Chat basico", "Basic chat")"
                Messages="BasicMessages"
                Users="DemoUsers"
                CurrentUserId="user1"
                ReadOnly="true" />
    </div>;

    // --- 2. Users ---
    private RenderFragment ExUsers() => @<div>
        <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted" Class="mb-2">
            @T("Usuarios com Initials computado automaticamente e status online.", "Users with auto-computed Initials and online status.")
        </XFTypography>
        <XFChat Title="@T("Time de suporte", "Support team")"
                Messages="BasicMessages"
                Users="DemoUsers"
                CurrentUserId="user1"
                ReadOnly="true" />
    </div>;

    // --- 3. Roles ---
    private RenderFragment ExRoles() => @<div class="h-72">
        <XFChat Title="@T("4 roles de mensagem", "4 message roles")"
                Messages="RoleMessages"
                Users="DemoUsers"
                CurrentUserId="user1"
                ReadOnly="true" />
    </div>;

    // --- 4. Loading ---
    private RenderFragment ExLoading() => @<div class="h-72">
        <XFChat Title="@T("Com typing indicator", "With typing indicator")"
                Messages="BasicMessages"
                Users="DemoUsers"
                CurrentUserId="user1"
                ShowTypingIndicator="true"
                TypingText="@T("Agente esta digitando...", "Agent is typing...")"
                ReadOnly="true" />
    </div>;

    // --- 5. SendOnEnter ---
    private RenderFragment ExSendOnEnter() => @<div>
        <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted" Class="mb-2">
            @T("SendOnEnter=false: Enter insere nova linha, use o botao para enviar.", "SendOnEnter=false: Enter inserts new line, use button to send.")
        </XFTypography>
        <XFChat Title="@T("Mensagem multi-linha", "Multi-line message")"
                Messages="BasicMessages"
                Users="DemoUsers"
                CurrentUserId="user1"
                SendOnEnter="false"
                Rows="3"
                ReadOnly="true" />
    </div>;

    // --- 6. Message Template ---
    private RenderFragment ExMessageTemplate() => @<div class="h-72">
        <XFChat Title="@T("Template customizado", "Custom template")"
                Messages="BasicMessages"
                Users="DemoUsers"
                CurrentUserId="user1"
                ReadOnly="true">
            <MessageTemplate Context="msg">
                <div class="@(msg.Role == AiRole.User ? "ml-auto max-w-[80%] rounded-xl bg-primary/10 p-3" : "mr-auto max-w-[80%] rounded-xl bg-surface-100 p-3")">
                    <div class="text-xs font-bold @(msg.Role == AiRole.User ? "text-primary" : "text-text-secondary")">
                        @(msg.Role == AiRole.User ? "Voce" : "Assistente")
                    </div>
                    <div class="mt-1 text-sm text-text-primary">@msg.Content</div>
                    <div class="mt-1 text-[10px] text-text-muted">@msg.Timestamp.ToString("HH:mm")</div>
                </div>
            </MessageTemplate>
        </XFChat>
    </div>;

    // --- 7. Custom Header ---
    private RenderFragment ExCustomHeader() => @<div class="h-72">
        <XFChat Messages="BasicMessages"
                Users="DemoUsers"
                CurrentUserId="user1"
                ReadOnly="true">
            <HeaderContent>
                <div class="flex items-center gap-3">
                    <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-success/10 text-success" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize("headset", 16))</span>
                    <div>
                        <div class="text-sm font-semibold text-text-primary">@T("Suporte Tecnico", "Technical Support")</div>
                        <div class="text-xs text-success">@T("Online - Ticket #7842", "Online - Ticket #7842")</div>
                    </div>
                </div>
            </HeaderContent>
        </XFChat>
    </div>;

    // --- 8. Composer Adornments ---
    private RenderFragment ExComposerAdornments() => @<div class="h-72">
        <XFChat Title="@T("Com anexos", "With attachments")"
                Messages="BasicMessages"
                Users="DemoUsers"
                CurrentUserId="user1"
                ReadOnly="true">
            <ComposerStart>
                <button type="button" class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-text-muted hover:bg-surface-100 hover:text-text-primary" aria-label="@T("Anexar arquivo", "Attach file")">
                    @((MarkupString)XFSvgIcons.MarkupWithSize("paperclip", 16))
                </button>
            </ComposerStart>
            <ComposerEnd>
                <button type="button" class="inline-flex h-10 w-10 items-center justify-center rounded-lg text-text-muted hover:bg-surface-100 hover:text-text-primary" aria-label="@T("Emoji", "Emoji")">
                    @((MarkupString)XFSvgIcons.MarkupWithSize("face-smile", 16))
                </button>
            </ComposerEnd>
        </XFChat>
    </div>;

    // --- 9. Read-Only ---
    private RenderFragment ExReadOnly() => @<div class="h-72">
        <XFChat Title="@T("Historico", "History")"
                Subtitle="@T("Somente leitura", "Read-only")"
                Messages="EnterpriseMessages"
                Users="DemoUsers"
                CurrentUserId="user1"
                ReadOnly="true" />
    </div>;

    // --- 10. Enterprise ---
    private RenderFragment ExEnterprise() => @<div class="h-80">
        <XFChat Messages="EnterpriseMessages"
                Users="DemoUsers"
                CurrentUserId="user1"
                ShowTypingIndicator="true"
                TypingText="@T("Agente digitando...", "Agent typing...")"
                ReadOnly="true">
            <HeaderContent>
                <div class="flex items-center justify-between gap-3">
                    <div class="flex items-center gap-3">
                        <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize("headset", 16))</span>
                        <div>
                            <div class="text-sm font-semibold text-text-primary">@T("Suporte Financeiro", "Financial Support")</div>
                            <div class="text-xs text-text-secondary">Ticket #7842 - @T("Aberto", "Open")</div>
                        </div>
                    </div>
                    <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Danger" Text="@T("Alta", "High")" />
                </div>
            </HeaderContent>
        </XFChat>
    </div>;

    // --- Helpers ---
    private RenderFragment Section(string title, RenderFragment content) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
        <Header><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography></Header>
        <ChildContent>@content</ChildContent>
    </XFCard>;

    private RenderFragment Example(string title, string description, RenderFragment preview, string codeText) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.None" AreaRestricted="false">
        <Header><div class="px-6 pt-6 pb-2">
            <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@description</XFTypography>
        </div></Header>
        <ChildContent><div class="flex flex-col">
            <div class="border-t border-border-light p-6">@preview</div>
            <div class="border-t border-border-light bg-surface-50 p-6">
                <XFCode Text="@codeText" Language="razor" Title="@CopyableCodeTitle" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" />
            </div>
        </div></ChildContent>
    </XFCard>;

    private RenderFragment Tile(DocTile item) => @<XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent>
        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <div class="flex items-center gap-4">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-primary/10 bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                <div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div>
            </div>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
        </XFStack>
    </ChildContent></XFCard>;

    private RenderFragment TileGrid(IReadOnlyList<DocTile> items, int columns) => @<XFGrid Cols="1" Md="@Math.Min(columns, 2)" Lg="@columns" Gap="4">@foreach (var item in items) { @Tile(item) }</XFGrid>;

    private RenderFragment WarningGrid(IReadOnlyList<DocTile> items) => @<XFGrid Cols="1" Md="2" Gap="4">@foreach (var item in items) {
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <div class="flex items-center gap-4">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-danger/10 bg-danger/10 text-danger" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                <div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div>
            </div>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
        </XFStack></ChildContent></XFCard>
    }</XFGrid>;

    private RenderFragment NameValueTable(IReadOnlyList<NameValueRow> rows, string nameHeader, string valueHeader) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader><XFTableRow><XFTableCell Header="true">@nameHeader</XFTableCell><XFTableCell Header="true">@valueHeader</XFTableCell></XFTableRow></XFTableHeader>
        <XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Value</XFTableCell></XFTableRow> }</XFTableBody>
    </XFTable>;

    private RenderFragment ApiTable(IReadOnlyList<ApiRow> rows) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader><XFTableRow>
            <XFTableCell Header="true">@T("Parametro", "Parameter")</XFTableCell>
            <XFTableCell Header="true">Type</XFTableCell>
            <XFTableCell Header="true">Default</XFTableCell>
            <XFTableCell Header="true">@T("Descricao", "Description")</XFTableCell>
