    private IReadOnlyList<DocTile> ResponsivenessItems => [
        new(T("Full width", "Full width"), T("Ocupa 100% do container por padrao.", "Occupies 100% of container by default."), "maximize"),
        new(T("Resize responsivo", "Responsive resize"), T("Vertical para mobile, Both para desktop.", "Vertical for mobile, Both for desktop."), "mobile-screen")
    ];

    // === PERFORMANCE ===
    private IReadOnlyList<DocTile> PerformanceItems => [
        new(T("Zero JS", "Zero JS"), T("Nenhum JavaScript interop.", "No JavaScript interop."), "bolt"),
