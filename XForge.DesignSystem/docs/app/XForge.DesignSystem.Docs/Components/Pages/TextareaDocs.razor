    // === ACCESSIBILITY ===
    private IReadOnlyList<DocTile> AccessibilityItems => [
        new(T("Label associado", "Associated label"), T("Label usa 'for' para vincular ao textarea.", "Label uses 'for' to link to textarea."), "tag"),
        new(T("aria-describedby", "aria-describedby"), T("Conecta helper text e erro para leitores de tela.", "Connects helper text and error for screen readers."), "universal-access"),
        new(T("aria-invalid", "aria-invalid"), T("Marcado como 'true' quando ha erro de validacao.", "Set to 'true' when validation error exists."), "circle-exclamation"),
        new(T("role=alert", "role=alert"), T("Mensagem de erro usa role=alert para anuncio imediato.", "Error message uses role=alert for immediate announcement."), "bell"),
        new(T("Touch target", "Touch target"), T("Altura minima de 44px para conformidade mobile.", "Minimum height of 44px for mobile compliance."), "hand-pointer"),
        new(T("Focus ring", "Focus ring"), T("Anel de foco visivel com 40% de contraste.", "Visible focus ring with 40% contrast."), "circle")
    ];

    private IReadOnlyList<NameValueRow> KeyboardRows => [
        new("Tab", T("Move foco para dentro do textarea.", "Moves focus into textarea.")),
        new("Shift + Tab", T("Move foco para fora do textarea.", "Moves focus out of textarea.")),
        new("Enter", T("Quebra linha (nao submete formulario).", "Inserts newline (does not submit form).")),
        new("Escape", T("Limpa o campo quando Immediate=true.", "Clears field when Immediate=true."))
