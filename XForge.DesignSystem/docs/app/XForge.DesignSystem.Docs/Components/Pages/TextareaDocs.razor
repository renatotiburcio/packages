@page "/forms/textarea"
@using XForge.DesignSystem.Core.Primitives
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFTextarea" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Multi-linha com validacao", "Multi-line with validation")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Entrada de texto longo com label, helper text, validacao e redimensionamento.",
                               "Long text input with label, helper text, validation and resize.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("Campo de formulario para textos longos, com 4 variantes, 3 tamanhos, 4 tonalidades, contagem de caracteres e validacao nativa.",
                               "Form field for long texts, with 4 variants, 3 sizes, 4 tones, character counter and native validation.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico. Interacoes requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 6 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Basico", "1. Basic"), T("Textarea com label, placeholder e helper text.", "Textarea with label, placeholder and helper text."), ExBasic(), Code1)
            @Example(T("2. Variantes", "2. Variants"), T("Outline, Filled, Soft e Ghost.", "Outline, Filled, Soft and Ghost."), ExVariants(), Code2)
            @Example(T("3. Estados", "3. States"), T("Desabilitado, somente leitura e obrigatorio.", "Disabled, read-only and required."), ExStates(), Code3)
            @Example(T("4. Tamanhos", "4. Sizes"), T("Small, Medium e Large.", "Small, Medium and Large."), ExSizes(), Code4)
            @Example(T("5. Cores e tons", "5. Tones"), T("Primary, Success, Warning e Danger.", "Primary, Success, Warning and Danger."), ExTones(), Code5)
            @Example(T("6. Contagem de caracteres", "6. Character Count"), T("ShowCount com e sem limite maximo.", "ShowCount with and without max length."), ExCharacterCount(), Code6)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string ProductLabelText => T("Forms", "Forms");
    private string PageTitleText => T("XFTextarea", "XFTextarea");
    private string PageStatusText => T("Documentacao completa", "Complete docs");
    private string T(string pt, string en) => LanguageService.Text(pt, en);
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFTextarea Label="Observacoes" Placeholder="Digite suas observacoes..." HelperText="Texto livre para notas internas." Rows="4" />
        <XFTextarea Label="Justificativa" Placeholder="Descreva a justificativa..." Rows="3" ShowCount="true" MaxLength="200" />
    </XFStack>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("Multi-linha", "Multi-line"), T("Entrada de texto com varias linhas configuravel.", "Text input with configurable multiple lines."), "align-left"),
        new(T("4 variantes", "4 variants"), T("Outline, Filled, Soft e Ghost.", "Outline, Filled, Soft and Ghost."), "palette"),
        new(T("Zero JS", "Zero JS"), T("Nenhum JavaScript interop. Puro C# + Tailwind.", "No JavaScript interop. Pure C# + Tailwind."), "bolt")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFTextarea"),
        new("Namespace", "XForge.DesignSystem.Components.Forms.Textarea"),
        new("Package", "XForge.DesignSystem"),
        new("Category", "Forms / Textarea"),
        new("Status", T("Estavel", "Stable")),
        new("Accessibility", T("label, aria-describedby, aria-invalid, aria-required, aria-readonly, role=alert para erros.", "label, aria-describedby, aria-invalid, aria-required, aria-readonly, role=alert for errors.")),
        new("Theme support", T("Light, dark e data-brand via tokens.", "Light, dark and data-brand via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("Textarea nativo", "Native textarea"), T("Wrapper semantico sobre textarea HTML com Tailwind.", "Semantic wrapper over HTML textarea with Tailwind."), "align-left"),
        new(T("Label e helper", "Label and helper"), T("Label associado via for, helper text com aria-describedby.", "Label associated via for, helper text with aria-describedby."), "tag"),
        new(T("Contagem de caracteres", "Character count"), T("ShowCount com formato configuravel e limite visual.", "ShowCount with configurable format and visual limit."), "hashtag")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Formularios ERP", "ERP forms"), T("Justificativas, observacoes, notas internas.", "Justifications, observations, internal notes."), "file-lines"),
        new(T("Feedback do usuario", "User feedback"), T("Comentarios, reviews, descricao detalhada.", "Comments, reviews, detailed description."), "comment"),
        new(T("Documentacao", "Documentation"), T("Campos de texto longo para documents e relatorios.", "Long text fields for documents and reports."), "book")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Inputs de texto sem validacao, sem label acessivel.", "Text inputs without validation, without accessible label."), "xmark"),
        new(T("Depois", "After"), T("Textarea com label, helper, contagem e validacao nativa.", "Textarea with label, helper, count and native validation."), "check"),
        new(T("Acessibilidade", "Accessibility"), T("aria-describedby, aria-invalid, role=alert para erros.", "aria-describedby, aria-invalid, role=alert for errors."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Textos longos", "Long texts"), T("Observacoes, justificativas, descricao detalhada.", "Observations, justifications, detailed description."), "align-left"),
        new(T("Formularios com validacao", "Forms with validation"), T("Campos obrigatorios com feedback de erro.", "Required fields with error feedback."), "circle-check")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Textos curtos", "Short texts"), T("Use XFInput para titulos, nomes, emails.", "Use XFInput for titles, names, emails."), "text-width"),
        new(T("Dados estruturados", "Structured data"), T("Use XFSelect ou XFCombobox para selecao.", "Use XFSelect or XFCombobox for selection."), "list")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new("Label", T("Texto descritivo acima do campo.", "Descriptive text above field."), "font"),
        new("Textarea", T("Elemento nativo textarea com classes Tailwind.", "Native textarea element with Tailwind classes."), "align-left"),
        new("Helper", T("Texto auxiliar abaixo do campo.", "Auxiliary text below field."), "comment"),
        new("Counter", T("Indicador de contagem de caracteres.", "Character count indicator."), "hashtag"),
        new("Error", T("Mensagem de erro com role=alert.", "Error message with role=alert."), "triangle-exclamation")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(T("Label primeiro", "Label first"), T("Label sempre visivel e acessivel.", "Label always visible and accessible."), "tag"),
        new(T("Helper = contexto", "Helper = context"), T("Helper text esclarece o esperado do usuario.", "Helper text clarifies expected user input."), "comment"),
        new(T("Erro visivel", "Visible error"), T("Erros aparecem inline com role=alert.", "Errors appear inline with role=alert."), "triangle-exclamation")
    ];

    // === EXAMPLES ===
    private RenderFragment ExBasic() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFTextarea Label="Descricao" Placeholder="Digite a descricao do item..." HelperText="Texto livre para descricao detalhada." Rows="4" />
    </XFStack>;

    private RenderFragment ExVariants() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFTextarea Variant="XFFormVariant.Outline" Label="Outline" Placeholder="Variante padrao com borda..." Rows="2" />
        <XFTextarea Variant="XFFormVariant.Filled" Label="Filled" Placeholder="Fundo preenchido..." Rows="2" />
        <XFTextarea Variant="XFFormVariant.Soft" Label="Soft" Placeholder="Borda suave com cor..." Rows="2" />
        <XFTextarea Variant="XFFormVariant.Ghost" Label="Ghost" Placeholder="Sem borda visivel..." Rows="2" />
    </XFStack>;

    private RenderFragment ExStates() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFTextarea Label="Desabilitado" Disabled="true" Rows="2" />
        <XFTextarea Label="Somente leitura" ReadOnly="true" Value="Texto apenas leitura que nao pode ser alterado." Rows="2" />
        <XFTextarea Label="Obrigatorio" Required="true" Placeholder="Este campo e obrigatorio..." Rows="2" />
    </XFStack>;

    private RenderFragment ExSizes() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFTextarea Size="XFSize.Sm" Label="Small" Placeholder="Tamanho pequeno..." Rows="2" />
        <XFTextarea Size="XFSize.Md" Label="Medium" Placeholder="Tamanho medio..." Rows="2" />
        <XFTextarea Size="XFSize.Lg" Label="Large" Placeholder="Tamanho grande..." Rows="2" />
    </XFStack>;

    private RenderFragment ExTones() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFTextarea Tone="XFSemanticColor.Primary" Label="Primary" Placeholder="Foco com cor primaria..." Rows="2" />
        <XFTextarea Tone="XFSemanticColor.Success" Label="Success" Placeholder="Foco com cor de sucesso..." Rows="2" />
        <XFTextarea Tone="XFSemanticColor.Warning" Label="Warning" Placeholder="Foco com cor de alerta..." Rows="2" />
        <XFTextarea Tone="XFSemanticColor.Danger" Label="Danger" Placeholder="Foco com cor de perigo..." Rows="2" />
    </XFStack>;

    private RenderFragment ExCharacterCount() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFTextarea Label="Contagem simples" ShowCount="true" Rows="3" Placeholder="Digite algo para ver a contagem..." />
        <XFTextarea Label="Com limite" ShowCount="true" MaxLength="100" Rows="3" Placeholder="Maximo de 100 caracteres..." />
    </XFStack>;

    private const string Code1 = @"<XFTextarea Label=""Descricao"" Placeholder=""Digite a descricao do item..."" HelperText=""Texto livre para descricao detalhada."" Rows=""4"" />";
    private const string Code2 = @"<XFTextarea Variant=""XFFormVariant.Outline"" Label=""Outline"" Placeholder=""Variante padrao com borda..."" Rows=""2"" />
<XFTextarea Variant=""XFFormVariant.Filled"" Label=""Filled"" Placeholder=""Fundo preenchido..."" Rows=""2"" />
<XFTextarea Variant=""XFFormVariant.Soft"" Label=""Soft"" Placeholder=""Borda suave com cor..."" Rows=""2"" />
<XFTextarea Variant=""XFFormVariant.Ghost"" Label=""Ghost"" Placeholder=""Sem borda visivel..."" Rows=""2"" />";
    private const string Code3 = @"<XFTextarea Label=""Desabilitado"" Disabled=""true"" Rows=""2"" />
<XFTextarea Label=""Somente leitura"" ReadOnly=""true"" Value=""Texto apenas leitura que nao pode ser alterado."" Rows=""2"" />
<XFTextarea Label=""Obrigatorio"" Required=""true"" Placeholder=""Este campo e obrigatorio..."" Rows=""2"" />";
    private const string Code4 = @"<XFTextarea Size=""XFSize.Sm"" Label=""Small"" Placeholder=""Tamanho pequeno..."" Rows=""2"" />
<XFTextarea Size=""XFSize.Md"" Label=""Medium"" Placeholder=""Tamanho medio..."" Rows=""2"" />
<XFTextarea Size=""XFSize.Lg"" Label=""Large"" Placeholder=""Tamanho grande..."" Rows=""2"" />";
    private const string Code5 = @"<XFTextarea Tone=""XFSemanticColor.Primary"" Label=""Primary"" Placeholder=""Foco com cor primaria..."" Rows=""2"" />
<XFTextarea Tone=""XFSemanticColor.Success"" Label=""Success"" Placeholder=""Foco com cor de sucesso..."" Rows=""2"" />
<XFTextarea Tone=""XFSemanticColor.Warning"" Label=""Warning"" Placeholder=""Foco com cor de alerta..."" Rows=""2"" />
<XFTextarea Tone=""XFSemanticColor.Danger"" Label=""Danger"" Placeholder=""Foco com cor de perigo..."" Rows=""2"" />";
    private const string Code6 = @"<XFTextarea Label=""Contagem simples"" ShowCount=""true"" Rows=""3"" Placeholder=""Digite algo para ver a contagem..."" />
<XFTextarea Label=""Com limite"" ShowCount=""true"" MaxLength=""100"" Rows=""3"" Placeholder=""Maximo de 100 caracteres..."" />";

    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("Value", "string?", "null", T("Valor atual do textarea.", "Current textarea value.")),
        new("ValueChanged", "EventCallback<string?>", "-", T("Callback ao alterar valor.", "Callback on value change.")),
        new("Change", "EventCallback<string?>", "-", T("Callback ao perder foco (onchange).", "Callback on blur (onchange).")),
        new("Label", "string?", "null", T("Texto do label associado ao campo.", "Label text associated with field.")),
        new("Placeholder", "string?", "null", T("Texto de placeholder.", "Placeholder text.")),
        new("HelperText", "string?", "null", T("Texto auxiliar abaixo do campo.", "Helper text below field.")),
        new("Name", "string?", "null", T("Atributo name do elemento nativo.", "Native element name attribute.")),
        new("AriaLabel", "string?", "null", T("Rótulo acessível alternativo.", "Alternative accessible label.")),
        new("Variant", "XFFormVariant", "Outline", T("Outline, Filled, Soft, Ghost.", "Outline, Filled, Soft, Ghost.")),
        new("Size", "XFSize", "Md", T("Sm, Md, Lg.", "Sm, Md, Lg.")),
        new("Tone", "XFSemanticColor", "Default", T("Default, Primary, Secondary, Success, Warning, Danger.", "Default, Primary, Secondary, Success, Warning, Danger.")),
        new("Resize", "XFTextareaResize", "Vertical", T("None, Vertical, Horizontal, Both.", "None, Vertical, Horizontal, Both.")),
        new("Rows", "int", "4", T("Numero de linhas visiveis.", "Number of visible rows.")),
        new("Cols", "int?", "null", T("Numero de colunas.", "Number of columns.")),
        new("MaxLength", "int?", "null", T("Limite maximo de caracteres.", "Maximum character limit.")),
        new("MinLength", "int?", "null", T("Limite minimo de caracteres.", "Minimum character limit.")),
        new("Disabled", "bool", "false", T("Desabilita o campo.", "Disables the field.")),
        new("ReadOnly", "bool", "false", T("Somente leitura.", "Read-only mode.")),
        new("Required", "bool", "false", T("Campo obrigatorio.", "Required field.")),
        new("FullWidth", "bool", "true", T("Largura total do container.", "Full container width.")),
        new("Immediate", "bool", "false", T("Atualiza valor a cada tecla.", "Updates value on each keystroke.")),
        new("Trim", "bool", "false", T("Remove espacos em branco nas bordas.", "Trims whitespace on edges.")),
