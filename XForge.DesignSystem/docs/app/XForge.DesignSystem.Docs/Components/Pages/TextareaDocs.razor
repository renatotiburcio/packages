        new("SpellCheck", "bool?", "null", T("Habilita verificacao ortografica.", "Enables spell checking.")),
        new("CharacterCountFormat", "string", "{0}", T("Formato da contagem (ex: {0} caracteres).", "Count format (e.g. {0} characters).")),
        new("CharacterLimitFormat", "string", "{0}/{1}", T("Formato com limite (ex: {0}/{1}).", "Format with limit (e.g. {0}/{1})."))
    ];

    private IReadOnlyList<NameValueRow> EventRows => [
        new("ValueChanged", T("Dispara ao alterar o valor (quando Immediate=true ou no onchange).", "Fires on value change (when Immediate=true or on onchange).")),
        new("Change", T("Dispara ao perder foco ou ao pressionar Enter.", "Fires on blur or Enter key press.")),
        new("oninput", T("Evento nativo capturado para atualizacao imediata.", "Native event captured for immediate update."))
