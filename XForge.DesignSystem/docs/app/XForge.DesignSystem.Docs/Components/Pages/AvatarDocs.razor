@page "/display/avatar"
@using Microsoft.AspNetCore.Components.Web
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@T("Core Open Source", "Core Open Source")"
                 Title="Avatar"
                 Status="@T("Documentacao completa", "Complete docs")"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFAvatar" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Imagem e iniciais", "Image and initials")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Status online", "Online status")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Grupos ERP", "ERP groups")" />
                    </XFStack>

                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Identidade visual compacta para usuarios, equipes e agentes enterprise.",
                               "Compact visual identity for enterprise users, teams and agents.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("XFAvatar exibe identidade visual por imagem, iniciais, icone ou Gravatar com status de disponibilidade. XFAvatarGroup organiza multiplos avatares com empilhamento e overflow.",
                               "XFAvatar displays visual identity via image, initials, icon or Gravatar with availability status. XFAvatarGroup organizes multiple avatars with stacking and overflow.")
                        </XFTypography>
                    </XFStack>

                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts)
                            {
                                @Tile(item)
                            }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico. Interacoes requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderizacao.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Consideracoes", "Considerations")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor Server: eventos sao tratados via SignalR. Sem latencia adicional para componentes puramente renderizados.", "Blazor Server: events are handled via SignalR. No additional latency for purely rendered components.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor WebAssembly: eventos sao tratados diretamente no cliente. Mais responsivo.", "Blazor WebAssembly: events are handled directly on the client. More responsive.")</XFTypography>
                </XFStack>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Hierarquia visual", "Visual Hierarchy"), @<div>@TileGrid(VisualHierarchyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("Preview renderizado", "Live Preview"),
                T("Avatares com iniciais, imagem e status em contexto ERP.", "Avatars with initials, image and status in ERP context."),
                BasicPreview(),
                BasicCode)

            @Example(T("Cobertura de exemplos: tamanhos e formas", "Example Coverage: sizes and shapes"),
                T("Todos os tamanhos e formas publicos do componente.", "All public sizes and shapes of the component."),
                VariantsPreview(),
                VariantsCode)

            @Example(T("XFAvatarGroup com overflow", "XFAvatarGroup with overflow"),
                T("Grupo de usuarios com empilhamento e contador de overflow.", "User group with stacking and overflow counter."),
                GroupPreview(),
                GroupCode)

            @Example(T("Status de disponibilidade", "Availability status"),
                T("Indicadores visuais de online, ausente, ocupado e indisponivel.", "Visual indicators for online, away, busy and offline."),
                StatusPreview(),
                StatusCode)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Variantes", "Variants"), @<div>@NameValueTable(VariantRows, T("Variante", "Variant"), T("Caso de uso", "Use case"))</div>)
            @Section(T("Estados", "States"), @<div>@NameValueTable(StateRows, T("Estado", "State"), T("Comportamento", "Behavior"))</div>)
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Metodos", "Methods"), @<div>@NameValueTable(MethodRows, T("Metodo", "Method"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Navegacao enterprise por teclado", "Enterprise Keyboard Navigation"), @<div>@TileGrid(EnterpriseKeyboardItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Exemplos de integracao", "Integration Examples"), @<div>@TileGrid(IntegrationItems, 2)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("Design Tokens", @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Seguranca", "Security Considerations"), @<div>@TileGrid(SecurityItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Notas de migracao", "Migration Notes"), @<div>@TileGrid(MigrationItems, 2)</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);

    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFStack Orientation="XFOrientation.Horizontal" Gap="4" Wrap="XFWrap.Wrap">
            <XFAvatar Name="Ana Martins" Status="XFAvatarStatus.Online" Size="XFAvatarSize.Lg" />
            <XFAvatar Name="Bruno Lima" Size="XFAvatarSize.Lg" Shape="XFAvatarShape.Rounded" Status="XFAvatarStatus.Away" />
            <XFAvatar Initials="ERP" Size="XFAvatarSize.Lg" Shape="XFAvatarShape.Square" />
        </XFStack>
        <XFGrid Cols="1" Md="3" Gap="3">
            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
                <ChildContent>
                    <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">CRM</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@T("Clientes ativos", "Active clients")</XFTypography>
                    <div class="mt-2"><XFAvatarGroup OverflowCount="3"><XFAvatar Name="Ana" Size="XFAvatarSize.Sm" /><XFAvatar Name="Bruno" Size="XFAvatarSize.Sm" /><XFAvatar Name="Carla" Size="XFAvatarSize.Sm" /><XFAvatar Name="Diego" Size="XFAvatarSize.Sm" /><XFAvatar Name="Elisa" Size="XFAvatarSize.Sm" /></XFAvatarGroup></div>
                </ChildContent>
            </XFCard>
            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
                <ChildContent>
                    <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Financeiro", "Finance")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@T("Equipe fiscal", "Tax team")</XFTypography>
                    <div class="mt-2"><XFAvatar Name="Fernanda Gomes" Status="XFAvatarStatus.Busy" Size="XFAvatarSize.Sm" /></div>
                </ChildContent>
            </XFCard>
            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
                <ChildContent>
                    <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("RH", "HR")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@T("Agente offline", "Offline agent")</XFTypography>
                    <div class="mt-2"><XFAvatar Name="Gabriel Santos" Status="XFAvatarStatus.Offline" Size="XFAvatarSize.Sm" /></div>
                </ChildContent>
            </XFCard>
        </XFGrid>
    </XFStack>;

    private RenderFragment BasicPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFStack Orientation="XFOrientation.Horizontal" Gap="4" Wrap="XFWrap.Wrap">
            <XFAvatar Name="Ana Martins" />
            <XFAvatar Name="Bruno Lima" Size="XFAvatarSize.Lg" Shape="XFAvatarShape.Rounded" />
            <XFAvatar Initials="ERP" Shape="XFAvatarShape.Square" />
        </XFStack>
        <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">
            @T("Avatares com iniciais automaticas, formato arredondado e quadrado para contextos diferentes.",
               "Avatars with automatic initials, rounded and square shapes for different contexts.")
        </XFTypography>
    </XFStack>;

    private RenderFragment VariantsPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFStack Orientation="XFOrientation.Horizontal" Gap="3" Wrap="XFWrap.Wrap">
            <XFAvatar Name="XS" Size="XFAvatarSize.Xs" />
            <XFAvatar Name="SM" Size="XFAvatarSize.Sm" />
            <XFAvatar Name="MD" Size="XFAvatarSize.Md" />
            <XFAvatar Name="LG" Size="XFAvatarSize.Lg" />
            <XFAvatar Name="XL" Size="XFAvatarSize.Xl" />
            <XFAvatar Name="XXL" Size="XFAvatarSize.Xxl" />
        </XFStack>
        <XFStack Orientation="XFOrientation.Horizontal" Gap="3" Wrap="XFWrap.Wrap">
            <XFAvatar Name="Circle" />
            <XFAvatar Name="Square" Shape="XFAvatarShape.Square" />
            <XFAvatar Name="Rounded" Shape="XFAvatarShape.Rounded" />
        </XFStack>
    </XFStack>;

    private RenderFragment GroupPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@T("Stacked (padrao)", "Stacked (default)")</XFTypography>
            <XFAvatarGroup OverflowCount="4" AriaLabel="@T("Equipe de vendas", "Sales team")">
                <XFAvatar Name="Ana" Size="XFAvatarSize.Sm" />
                <XFAvatar Name="Bruno" Size="XFAvatarSize.Sm" />
                <XFAvatar Name="Carla" Size="XFAvatarSize.Sm" />
            </XFAvatarGroup>
        </XFStack>
        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@T("Nao empilhado", "Not stacked")</XFTypography>
            <XFAvatarGroup Stacked="false" Size="XFAvatarSize.Lg">
                <XFAvatar Name="Diego" />
                <XFAvatar Name="Elisa" />
            </XFAvatarGroup>
        </XFStack>
    </XFStack>;

    private RenderFragment StatusPreview() => @<XFStack Orientation="XFOrientation.Horizontal" Gap="4" Wrap="XFWrap.Wrap">
        <XFStack Orientation="XFOrientation.Vertical" Gap="1">
            <XFAvatar Name="Online" Status="XFAvatarStatus.Online" Size="XFAvatarSize.Lg" />
            <XFTypography Variant="XFTypographyVariant.Caption">Online</XFTypography>
        </XFStack>
        <XFStack Orientation="XFOrientation.Vertical" Gap="1">
            <XFAvatar Name="Away" Status="XFAvatarStatus.Away" Size="XFAvatarSize.Lg" />
            <XFTypography Variant="XFTypographyVariant.Caption">@T("Ausente", "Away")</XFTypography>
        </XFStack>
        <XFStack Orientation="XFOrientation.Vertical" Gap="1">
            <XFAvatar Name="Busy" Status="XFAvatarStatus.Busy" Size="XFAvatarSize.Lg" />
            <XFTypography Variant="XFTypographyVariant.Caption">@T("Ocupado", "Busy")</XFTypography>
        </XFStack>
        <XFStack Orientation="XFOrientation.Vertical" Gap="1">
            <XFAvatar Name="Offline" Status="XFAvatarStatus.Offline" Size="XFAvatarSize.Lg" />
            <XFTypography Variant="XFTypographyVariant.Caption">Offline</XFTypography>
        </XFStack>
    </XFStack>;

    private string BasicCode => T("""
<XFAvatar Name="Ana Martins" />
<XFAvatar Name="Bruno Lima" Size="XFAvatarSize.Lg" Shape="XFAvatarShape.Rounded" />
<XFAvatar Initials="ERP" Shape="XFAvatarShape.Square" />
""", """
<XFAvatar Name="Ana Martins" />
<XFAvatar Name="Bruno Lima" Size="XFAvatarSize.Lg" Shape="XFAvatarShape.Rounded" />
<XFAvatar Initials="ERP" Shape="XFAvatarShape.Square" />
""");

    private string VariantsCode => """
<XFAvatar Name="XS" Size="XFAvatarSize.Xs" />
<XFAvatar Name="SM" Size="XFAvatarSize.Sm" />
<XFAvatar Name="MD" Size="XFAvatarSize.Md" />
<XFAvatar Name="LG" Size="XFAvatarSize.Lg" />
<XFAvatar Name="XL" Size="XFAvatarSize.Xl" />
<XFAvatar Name="XXL" Size="XFAvatarSize.Xxl" />

<XFAvatar Name="Circle" />
<XFAvatar Name="Square" Shape="XFAvatarShape.Square" />
<XFAvatar Name="Rounded" Shape="XFAvatarShape.Rounded" />
""";

    private string GroupCode => """
<XFAvatarGroup OverflowCount="4" AriaLabel="Equipe de vendas">
    <XFAvatar Name="Ana" Size="XFAvatarSize.Sm" />
    <XFAvatar Name="Bruno" Size="XFAvatarSize.Sm" />
    <XFAvatar Name="Carla" Size="XFAvatarSize.Sm" />
</XFAvatarGroup>

<XFAvatarGroup Stacked="false" Size="XFAvatarSize.Lg">
    <XFAvatar Name="Diego" />
    <XFAvatar Name="Elisa" />
</XFAvatarGroup>
""";

    private string StatusCode => """
<XFAvatar Name="Online" Status="XFAvatarStatus.Online" Size="XFAvatarSize.Lg" />
<XFAvatar Name="Away" Status="XFAvatarStatus.Away" Size="XFAvatarSize.Lg" />
<XFAvatar Name="Busy" Status="XFAvatarStatus.Busy" Size="XFAvatarSize.Lg" />
<XFAvatar Name="Offline" Status="XFAvatarStatus.Offline" Size="XFAvatarSize.Lg" />
""";
    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("Multi-fonte", "Multi-source"), T("Imagem, iniciais, icone ou Gravatar com fallback automatico.", "Image, initials, icon or Gravatar with automatic fallback."), "user"),
        new(T("Status visivel", "Visible status"), T("Online, ausente, ocupado e indisponivel com cores semanticas.", "Online, away, busy and offline with semantic colors."), "circle-check"),
        new(T("Grupo com overflow", "Group with overflow"), T("XFAvatarGroup empilha e exibe +N para usuarios excedentes.", "XFAvatarGroup stacks and shows +N for excess users."), "users")
    ];

    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFAvatar / XFAvatarGroup"),
        new("Namespace", "XForge.DesignSystem.Components.DataDisplay.Avatar"),
        new("Package", "XForge.DesignSystem"),
        new("Category", "DataDisplay / Avatar"),
        new("Status", T("Estavel", "Stable")),
        new("Accessibility", T("role=img, aria-label, status com cores semanticas.", "role=img, aria-label, status with semantic colors."))
    ];

    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("Identidade visual", "Visual identity"), T("Exibe nome, iniciais, imagem ou icone de forma compacta e consistente.", "Displays name, initials, image or icon in a compact and consistent way."), "user"),
        new(T("Fallback inteligente", "Smart fallback"), T("Cadeia: imagem > iniciais > icone > '?'. Gravatar por email opcional.", "Chain: image > initials > icon > '?'. Gravatar by email optional."), "arrow-rotate-left"),
        new(T("Suporte a grupos", "Group support"), T("XFAvatarGroup com stacking, overflow e tamanhos consistentes.", "XFAvatarGroup with stacking, overflow and consistent sizes."), "users")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Identidade de usuario", "User identity"), T("Mostrar quem esta associado a uma acao, documento ou comentario.", "Show who is associated with an action, document or comment."), "user"),
        new(T("Equipes e grupos", "Teams and groups"), T("Visualizar participantes de workflows, aprovacoes e equipes.", "Visualize participants in workflows, approvals and teams."), "users"),
        new(T("Status de disponibilidade", "Availability status"), T("Indicar se um usuario esta online, ausente ou ocupado.", "Indicate if a user is online, away or busy."), "circle-check")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Imagens de usuario com tamanhos inconsistentes, sem fallback e sem status.", "User images with inconsistent sizes, no fallback and no status."), "xmark"),
        new(T("Depois", "After"), T("Contrato unico para avatar com tamanho, forma, status e grupo.", "One contract for avatar with size, shape, status and group."), "check"),
        new(T("Risco reduzido", "Reduced risk"), T("Fallback automatico evita icones quebrados e espacos vazios.", "Automatic fallback avoids broken icons and empty spaces."), "shield-check")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new("ERP", T("Usuarios em grids, aprovacoes, comentarios e dashboards.", "Users in grids, approvals, comments and dashboards."), "briefcase"),
        new("CRM", T("Contatos, leads e representantes com foto e status.", "Contacts, leads and representatives with photo and status."), "chart-line-up"),
        new("RH", T("Funcionarios em organogramas, escalas e listas de equipe.", "Employees in org charts, schedules and team lists."), "users"),
        new(T("Chat e suporte", "Chat and support"), T("Agentes com status de disponibilidade em tempo real.", "Agents with real-time availability status."), "comments")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Imagem grande", "Large image"), T("Use XFImage ou XFFigure para exibir fotos em tamanho real.", "Use XFImage or XFFigure to display full-size photos."), "image"),
        new(T("Botao de acao", "Action button"), T("Avatar nao e interativo; use XFButton para acoes.", "Avatar is not interactive; use XFButton for actions."), "hand-pointer"),
        new(T("Icone decorativo", "Decorative icon"), T("Use XFSvgIcons ou XFIcon isolados quando nao houver identidade.", "Use standalone XFSvgIcons or XFIcon when there is no identity."), "eye-slash")
    ];

