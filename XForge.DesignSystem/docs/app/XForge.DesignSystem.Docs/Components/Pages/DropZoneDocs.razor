@page "/components/drop-zone"
@using XForge.DesignSystem.Core.Primitives
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@T("Utils", "Utils")"
                 Title="@T("DropZone", "DropZone")"
                 Status="@T("Documentacao completa", "Complete docs")"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFDropZone" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="Drag & Drop" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="Reorder" />
                    </XFStack>
                    <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                        @T("Zona de drag-and-drop para reordenar, mover e organizar itens.",
                           "Drag-and-drop zone for reordering, moving and organizing items.")
                    </XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                        @T("Controle interativo para operacoes de drag-and-drop com suporte a reordenacao, templates customizaveis e headers/footers.",
                           "Interactive control for drag-and-drop operations with reorder support, customizable templates and headers/footers.")
                    </XFTypography>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Parcial", "Partial")" /></XFTableCell><XFTableCell>@T("Renderiza sem interacao drag.", "Renders without drag interaction.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Requer JS interop", "Requires JS interop")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente utiliza JavaScript interop para operacoes de drag-and-drop nativas do navegador.", "This component uses JavaScript interop for native browser drag-and-drop operations.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Basico", "1. Basic"), T("Zona de drop com lista de itens.", "Drop zone with item list."), ExBasic(), Code1)
            @Example(T("2. Com reorder", "2. With reorder"), T("Reordenacao habilitada.", "Reorder enabled."), ExReorder(), Code2)
            @Example(T("3. Enterprise Upload", "3. Enterprise Upload"), T("Upload de arquivos com template.", "File upload with template."), ExEnterprise(), Code3)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string ProductLabelText => T("Utils", "Utils");
    private string PageTitleText => T("XFDropZone", "XFDropZone");
    private string PageStatusText => T("Documentacao completa", "Complete docs");
    private string T(string pt, string en) => LanguageService.Text(pt, en);
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");

    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFCode Text='@("<XFDropZone Items=\"items\" />")' Language="razor" Variant="XFCodeVariant.Block" Wrap="true" />
    </XFStack>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("Drag & Drop", "Drag & Drop"), T("Reordenacao e movimentacao de itens.", "Reorder and move items."), "arrows-up-down"),
        new(T("Template", "Template"), T("ItemTemplate customizavel.", "Customizable ItemTemplate."), "puzzle-piece"),
        new(T("Reorder", "Reorder"), T("Permite reordenar itens na lista.", "Allows reordering items in list."), "sort")
    ];

    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFDropZone"),
        new("Namespace", "XForge.DesignSystem.Components.Utils.DropZone"),
        new("Package", "XForge.DesignSystem"),
        new("Category", "Utils / DropZone"),
        new("Status", T("Estavel", "Stable")),
        new("Accessibility", T("role=list, aria-dropeffect, aria-grabbed, aria-label.", "role=list, aria-dropeffect, aria-grabbed, aria-label.")),
        new("Theme support", T("Light, dark e data-brand via tokens.", "Light, dark and data-brand via tokens."))
    ];

    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("Drop zone", "Drop zone"), T("Area onde itens podem ser soltos.", "Area where items can be dropped."), "inbox"),
        new(T("Drag", "Drag"), T("Itens podem ser arrastados.", "Items can be dragged."), "hand-pointer"),
        new(T("Reorder", "Reorder"), T("Reordenacao na mesma zona.", "Reorder within same zone."), "arrows-up-down")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Organizacao", "Organization"), T("Reordenar itens em lista.", "Reorder items in list."), "sort"),
        new(T("Upload", "Upload"), T("Upload de arquivos por arraste.", "Upload files by dragging."), "upload"),
        new(T("Mover entre zonas", "Move between zones"), T("Transferir itens entre zonas.", "Transfer items between zones."), "arrows-left-right")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Botoes de mover para cima/baixo.", "Move up/down buttons."), "xmark"),
        new(T("Depois", "After"), T("Drag-and-drop nativo e intuitivo.", "Native and intuitive drag-and-drop."), "check"),
        new(T("Acessibilidade", "Accessibility"), T("aria-dropeffect, aria-grabbed, teclado.", "aria-dropeffect, aria-grabbed, keyboard."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Listas reordenaveis", "Reorderable lists"), T("Permitir ao usuario reordenar.", "Allow user to reorder."), "sort"),
        new(T("Upload de arquivos", "File upload"), T("Arrastar arquivos para upload.", "Drag files for upload."), "upload")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Selecao simples", "Simple selection"), T("Use XFCheckbox para selecao.", "Use XFCheckbox for selection."), "check"),
        new(T("Navegacao", "Navigation"), T("Use XFTabs para navegacao.", "Use XFTabs for navigation."), "route")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new("Zone", T("Area de drop com borda tracejada.", "Drop area with dashed border."), "square"),
        new("Item", T("Elemento arrastavel dentro da zona.", "Draggable element within zone."), "grip-vertical"),
        new("Header", T("Cabecalho opcional da zona.", "Optional zone header."), "heading"),
        new("Footer", T("Rodape opcional da zona.", "Optional zone footer."), "heading"),
        new("Placeholder", T("Indicador visual de drop.", "Visual drop indicator."), "plus")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(T("Visual feedback", "Visual feedback"), T("Borda muda ao arrastar sobre a zona.", "Border changes when dragging over zone."), "eye"),
        new(T("Touch-first", "Touch-first"), T("Itens grandes para toque.", "Large items for touch."), "hand-pointer"),
        new(T("Undo", "Undo"), T("Permitir desfazer acao.", "Allow undo action."), "rotate-left")
    ];

    private RenderFragment ExBasic() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFCode Text="@Code1" Language="razor" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" />
    </XFStack>;

    private RenderFragment ExReorder() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFCode Text="@Code2" Language="razor" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" />
    </XFStack>;

    private RenderFragment ExEnterprise() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFCode Text="@Code3" Language="razor" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" />
    </XFStack>;

    private const string Code1 = @"<XFDropZone Items=""@fileList""
             ZoneValue=""@dropZoneValue""
             Header=""Arraste arquivos aqui""
             Footer=""@($""{fileList.Count} itens"")"" />";
    private const string Code2 = @"<XFDropZone Items=""@taskList""
             AllowReorder=""true""
             ItemTemplate=""@((item) => @<div>@item.Name</div>)"" />";
    private const string Code3 = @"<XFDropZone Items=""@uploadFiles""
             ZoneValue=""upload""
             AllowReorder=""false""
             Header=""Upload de documentos"">
    <ItemTemplate>
        <XFStack Orientation=""XFOrientation.Horizontal"" Gap=""2"">
            <XFIcon Name=""file"" />
            <span>@context.FileName</span>
        </XFStack>
    </ItemTemplate>
</XFDropZone>";

    private IReadOnlyList<ApiRow> ApiRows => [
        new("Items", "IList<T>", "[]", T("Lista de itens na zona.", "Items in the zone.")),
        new("ZoneValue", "string?", "null", T("Identificador da zona.", "Zone identifier.")),
        new("Header", "string?", "null", T("Cabecalho da zona.", "Zone header.")),
        new("Footer", "string?", "null", T("Rodape da zona.", "Zone footer.")),
        new("AllowReorder", "bool", "false", T("Permite reordenacao.", "Allows reorder.")),
        new("ItemTemplate", "RenderFragment<T>?", "null", T("Template customizado por item.", "Custom template per item.")),
        new("Disabled", "bool", "false", T("Desabilita a zona.", "Disables the zone."))
    ];

    private IReadOnlyList<NameValueRow> EventRows => [
        new("OnDrop", T("Disparado ao soltar item na zona.", "Fired when item is dropped in zone.")),
        new("OnDragStart", T("Disparado ao iniciar arraste.", "Fired when drag starts.")),
        new("OnDragEnd", T("Disparado ao finalizar arraste.", "Fired when drag ends."))
    ];

    private IReadOnlyList<DocTile> AccessibilityItems => [
        new(T("role=list", "role=list"), T("ARIA role na zona.", "ARIA role on zone."), "universal-access"),
        new(T("aria-dropeffect", "aria-dropeffect"), T("Efeito de drop (move/copy).", "Drop effect (move/copy)."), "arrows-up-down"),
        new(T("aria-grabbed", "aria-grabbed"), T("Estado de arraste.", "Drag state."), "hand-pointer"),
        new(T("Teclado", "Keyboard"), T("Tab para navegar, Enter para soltar.", "Tab to navigate, Enter to drop."), "keyboard")
    ];

    private IReadOnlyList<NameValueRow> KeyboardRows => [
        new("Tab", T("Navega entre itens.", "Navigates between items.")),
        new("Enter", T("Pega/solta item.", "Grabs/drops item.")),
        new("Space", T("Seleciona item.", "Selects item.")),
        new("ArrowUp/Down", T("Move item na lista.", "Moves item in list."))
    ];

    private IReadOnlyList<DocTile> ResponsivenessItems => [
        new(T("Largura total", "Full width"), T("Zona ocupa 100% do container.", "Zone occupies 100% of container."), "maximize"),
        new(T("Touch-first", "Touch-first"), T("Itens grandes para mobile.", "Large items for mobile."), "mobile-screen")
    ];

    private IReadOnlyList<DocTile> PerformanceItems => [
        new(T("Virtualizacao", "Virtualization"), T("Para listas grandes, use virtualizacao.", "For large lists, use virtualization."), "bolt"),
        new(T("Minimal re-render", "Minimal re-render"), T("Apenas itens movidos re-renderizam.", "Only moved items re-render."), "feather")
    ];

    private IReadOnlyList<DocTile> ScenarioItems => [
        new(T("Upload de docs", "Doc upload"), T("Arrastar XMLs, PDFs, imagens.", "Drag XMLs, PDFs, images."), "upload"),
        new(T("Reordenar tarefas", "Reorder tasks"), T("Priorizar backlog de tarefas.", "Prioritize task backlog."), "sort"),
        new(T("Mover entre categorias", "Move between categories"), T("Transferir itens entre listas.", "Transfer items between lists."), "arrows-left-right")
    ];

    private IReadOnlyList<DocTile> CompositionItems => [
        new(T("DropZone + Icon", "DropZone + Icon"), T("Icone por item no template.", "Icon per item in template."), "icon"),
        new(T("DropZone + Badge", "DropZone + Badge"), T("Badge de status por item.", "Status badge per item."), "tag"),
        new(T("DropZone + Button", "DropZone + Button"), T("Botao de acao no footer.", "Action button in footer."), "square")
    ];

    private IReadOnlyList<DocTile> BestPracticeItems => [
        new(T("Feedback visual", "Visual feedback"), T("Mostrar borda ao arrastar.", "Show border on drag."), "eye"),
        new(T("Touch 44px", "Touch 44px"), T("Itens minimos 44px para toque.", "Minimum 44px items for touch."), "hand-pointer"),
        new(T("Header descritivo", "Descriptive header"), T("Indique o que pode ser solto.", "Indicate what can be dropped."), "heading")
    ];

    private IReadOnlyList<DocTile> AntiPatternItems => [
        new(T("Sem feedback", "No feedback"), T("Zona sem indicacao visual de drop.", "Zone without visual drop indicator."), "xmark"),
        new(T("Itens pequenos", "Small items"), T("Itens < 44px dificeis no toque.", "Items < 44px hard to touch."), "triangle-exclamation")
    ];

    private IReadOnlyList<NameValueRow> TokenRows => [
        new("zone", T("border-2 border-dashed border-surface-300 rounded-lg.", "border-2 border-dashed border-surface-300 rounded-lg.")),
        new("zone-hover", T("border-primary bg-primary/5.", "border-primary bg-primary/5.")),
        new("item", T("p-3 bg-surface-50 rounded-lg cursor-grab.", "p-3 bg-surface-50 rounded-lg cursor-grab."))
    ];

    private IReadOnlyList<DocTile> ThemeItems => [
        new("data-theme", T("Tokens light/dark via CSS variables.", "Light/dark tokens via CSS variables."), "moon"),
        new("data-brand", T("Primary acompanha marca ativa.", "Primary follows active brand."), "swatchbook")
    ];

    private IReadOnlyList<NameValueRow> TestingRows => [
        new("Unit", T("Testes de render, props, drag, drop, reorder.", "Render, props, drag, drop, reorder tests.")),
        new("Accessibility", T("role=list, aria-dropeffect, aria-grabbed, teclado.", "role=list, aria-dropeffect, aria-grabbed, keyboard."))
    ];

    private IReadOnlyList<NameValueRow> LimitationRows => [
        new("JS interop", T("Requer JavaScript para drag-and-drop.", "Requires JavaScript for drag-and-drop.")),
        new("SSR", T("Static SSR: renderiza sem interacao drag.", "Static SSR: renders without drag interaction."))
    ];

    private IReadOnlyList<DocTile> RelatedComponentItems => [
        new("XFSortableList", T("Lista ordenavel.", "Sortable list."), "sort"),
        new("XFTransferList", T("Transferencia entre listas.", "Transfer between lists."), "arrows-left-right"),
        new("XFUpload", T("Upload de arquivos.", "File upload."), "upload")
    ];

    private IReadOnlyList<NameValueRow> FaqRows => [
        new(T("DropZone vs SortableList?", "DropZone vs SortableList?"), T("DropZone = zona de drop. SortableList = lista ordenavel.", "DropZone = drop zone. SortableList = sortable list.")),
        new(T("Entre zonas?", "Between zones?"), T("Sim, mova itens entre XFDropZones com ZoneValue diferente.", "Yes, move items between XFDropZones with different ZoneValue.")),
        new(T("Templates customizados?", "Custom templates?"), T("Sim, use ItemTemplate para template por item.", "Yes, use ItemTemplate for template per item."))
    ];

    private IReadOnlyList<NameValueRow> ChangelogRows => [
        new("2026-06-30", T("Pagina criada no padrao enterprise com 3 exemplos.", "Page created in enterprise standard with 3 examples."))
    ];

    private RenderFragment Section(string title, RenderFragment content) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
        <Header><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography></Header>
        <ChildContent>@content</ChildContent>
    </XFCard>;

    private RenderFragment Example(string title, string description, RenderFragment preview, string codeText) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.None" AreaRestricted="false">
        <Header><div class="px-6 pt-6 pb-2">
            <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@description</XFTypography>
        </div></Header>
        <ChildContent><div class="flex flex-col">
            <div class="border-t border-border-light p-6">@preview</div>
            <div class="border-t border-border-light bg-surface-50 p-6">
                <XFCode Text="@codeText" Language="razor" Title="@CopyableCodeTitle" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" />
            </div>
        </div></ChildContent>
    </XFCard>;

    private RenderFragment Tile(DocTile item) => @<XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent>
        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <div class="flex items-center gap-4">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-primary/10 bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                <div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div>
            </div>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
        </XFStack>
    </ChildContent></XFCard>;

    private RenderFragment TileGrid(IReadOnlyList<DocTile> items, int columns) => @<XFGrid Cols="1" Md="@Math.Min(columns, 2)" Lg="@columns" Gap="4">@foreach (var item in items) { @Tile(item) }</XFGrid>;

    private RenderFragment WarningGrid(IReadOnlyList<DocTile> items) => @<XFGrid Cols="1" Md="2" Gap="4">@foreach (var item in items) {
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <div class="flex items-center gap-4">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-danger/10 bg-danger/10 text-danger" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                <div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div>
            </div>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
        </XFStack></ChildContent></XFCard>
    }</XFGrid>;

    private RenderFragment NameValueTable(IReadOnlyList<NameValueRow> rows, string nameHeader, string valueHeader) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader><XFTableRow><XFTableCell Header="true">@nameHeader</XFTableCell><XFTableCell Header="true">@valueHeader</XFTableCell></XFTableRow></XFTableHeader>
        <XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Value</XFTableCell></XFTableRow> }</XFTableBody>
    </XFTable>;

    private RenderFragment ApiTable(IReadOnlyList<ApiRow> rows) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Parametro", "Parameter")</XFTableCell><XFTableCell Header="true">Type</XFTableCell><XFTableCell Header="true">Default</XFTableCell><XFTableCell Header="true">@T("Descricao", "Description")</XFTableCell></XFTableRow></XFTableHeader>
        <XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Type</XFTableCell><XFTableCell><XFCode Text="@row.DefaultValue" /></XFTableCell><XFTableCell>@row.Description</XFTableCell></XFTableRow> }</XFTableBody>
    </XFTable>;

    private sealed record DocTile(string Title, string Description, string Icon);
    private sealed record NameValueRow(string Name, string Value);
    private sealed record ApiRow(string Name, string Type, string DefaultValue, string Description);
}
