<XFCode Text=""pip install xforge"" Language=""bash""
    Variant=""XFCodeVariant.Block"" Copyable=""true"" />

<XFCode Text=""docker compose up -d"" Language=""docker""
    Variant=""XFCodeVariant.Block"" Copyable=""true"" />";

    // ErpScenarios
