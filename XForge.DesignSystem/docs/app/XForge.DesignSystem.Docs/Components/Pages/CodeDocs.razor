        <XFCode Text="docker compose up -d" Language="docker" Variant="XFCodeVariant.Block" Copyable="true" />
    </div>;
    private string LanguageBadgesCode => @"<XFCode Text=""SELECT * FROM Users"" Language=""sql""
    Variant=""XFCodeVariant.Block"" Copyable=""true"" />

<XFCode Text=""{ """"name"""": """"John"""" }"" Language=""json""
    Variant=""XFCodeVariant.Block"" Copyable=""true"" />

<XFCode Text=""<div>...</div>"" Language=""html""
    Variant=""XFCodeVariant.Block"" Copyable=""true"" />

<XFCode Text=""const x = 42;"" Language=""typescript""
