    Language=""sql"" Variant=""XFCodeVariant.Block"" Wrap=""true"" />";

    // NoHeader
    private RenderFragment NoHeaderPreview() => @<div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        <XFCode Text="Loading..." Variant="XFCodeVariant.Block" />
        <XFCode Text="Connection established" Variant="XFCodeVariant.Block" Tone="XFSemanticColor.Success" />
    </div>;
    private string NoHeaderCode => @"<XFCode Text=""Loading..."" Variant=""XFCodeVariant.Block"" />

<XFCode Text=""Connection established"" Variant=""XFCodeVariant.Block""
    Tone=""XFSemanticColor.Success"" />";

    // LanguageBadges
    private RenderFragment LanguageBadgesPreview() => @<div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <XFCode Text="SELECT * FROM Users" Language="sql" Variant="XFCodeVariant.Block" Copyable="true" />
        <XFCode Text='{ "name": "John" }' Language="json" Variant="XFCodeVariant.Block" Copyable="true" />
