@using XForge.DesignSystem.Core.Primitives
@page "/display/code"
@using Microsoft.AspNetCore.Components.Web
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@T("Core Open Source", "Core Open Source")"
                 Title="Code"
                 Status="@T("Documentacao completa", "Complete docs")"
                 Items="XForgeDocsCatalog.CoreItems">
    <div class="space-y-6">
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFCode" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Inline", "Inline")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Block", "Block")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Copyable", "Copyable")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">@T("Exibicao de codigo com copia, tons semanticos e apresentacao consistente.","Code display with copy, semantic tones and consistent presentation.")</XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">@T("XFCode exibe trechos de codigo inline ou em bloco com header, linguagem, copia para clipboard e tons visuais. Ideal para documentacao, logs, configs e respostas de API.","XFCode displays inline or block code snippets with header, language, clipboard copy and visual tones. Ideal for documentation, logs, configs and API responses.")</XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">@HeroPreview()</div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">@foreach (var item in QuickFacts){@Tile(item)}</XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>
        @Section(T("Metadados","Metadata"),@<div>@NameValueTable(MetadataRows,T("Campo","Field"),T("Valor","Value"))</div>)

        @Section(T("Blazor Server e Blazor WebAssembly", "Blazor Server and Blazor WebAssembly"), @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona com prerender-safe guards.", "Works with prerender-safe guards.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona com prerender-safe guards no primeiro render.", "Works with prerender-safe guards on first render.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Parcial", "Partial")" /></XFTableCell><XFTableCell>@T("Renderiza HTML base. Botao de copia indisponivel durante prerender.", "Renders base HTML. Copy button unavailable during prerender.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("JS Interop", "JS Interop")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Arquivo JS: xf-code.js — modulo de clipboard importado sob demanda para copiar texto via navigator.clipboard.writeText.", "JS file: xf-code.js — clipboard module imported on demand to copy text via navigator.clipboard.writeText.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Quando carrega: sob demanda ao clicar no botao de copia.", "When loaded: on demand when clicking the copy button.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Prerender seguro: try/catch para InvalidOperationException e JSDisconnectedException.", "Prerender safe: try/catch for InvalidOperationException and JSDisconnectedException.")</XFTypography>
                </XFStack>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Consideracoes Blazor Server", "Blazor Server Considerations")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Clipboard via SignalR com latencia. Feedback visual pode demorar.", "Clipboard via SignalR with latency. Visual feedback may be delayed.")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Consideracoes Blazor WebAssembly", "Blazor WebAssembly Considerations")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Clipboard direto sem latencia. Disponivel apos carregamento do WASM.", "Direct clipboard with no latency. Available after WASM load.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral","Overview"),@<div>@TileGrid(OverviewItems,3)</div>)
            @Section(T("Proposito","Purpose"),@<div>@TileGrid(PurposeItems,3)</div>)
            @Section(T("Problema resolvido","Problem Solved"),@<div>@TileGrid(ProblemItems,3)</div>)
            @Section(T("Quando usar","When To Use"),@<div>@TileGrid(UseItems,2)</div>)
            @Section(T("Quando nao usar","When Not To Use"),@<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia","Anatomy"),@<div>@TileGrid(AnatomyItems,2)</div>)
        </XFStack>
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Hierarquia visual","Visual Hierarchy"),@<div>@TileGrid(VisualHierarchyItems,3)</div>)
            @Section(T("Principios de design","Design Principles"),@<div>@TileGrid(DesignPrincipleItems,3)</div>)
        </XFStack>
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("Inline basico","Basic Inline"),T("Codigos inline com tons semanticos em contexto de texto.","Inline codes with semantic tones in text context."),InlineBasicPreview(),InlineBasicCode)
            @Example(T("Bloco com header","Block with Header"),T("Bloco com linguagem, titulo e botao de copia com icone SVG.","Block with language, title and copy button with SVG icon."),BlockHeaderPreview(),BlockHeaderCode)
            @Example(T("Tons semanticos inline","Inline Semantic Tones"),T("Neutral, Primary, Success, Warning e Danger.","Neutral, Primary, Success, Warning and Danger."),TonesInlinePreview(),TonesInlineCode)
            @Example(T("Tons semanticos em bloco","Block Semantic Tones"),T("Blocos com bordas semanticas para feedback visual.","Blocks with semantic borders for visual feedback."),TonesBlockPreview(),TonesBlockCode)
            @Example(T("Copia com feedback","Copy with Feedback"),T("Botao de copia com icone SVG, feedback visual e reset automatico apos 2.5s.","Copy button with SVG icon, visual feedback and auto-reset after 2.5s."),CopyFeedbackPreview(),CopyFeedbackCode)
            @Example(T("Quebra de linhas","Line Wrapping"),T("Wrap=true para textos longos em mobile; Wrap=false para scroll horizontal.","Wrap=true for long texts on mobile; Wrap=false for horizontal scroll."),WrapComparisonPreview(),WrapComparisonCode)
            @Example(T("Bloco sem header","Block Without Header"),T("Bloco minimalista sem linguagem nem titulo.","Minimalist block without language or title."),NoHeaderPreview(),NoHeaderCode)
            @Example(T("Badges de linguagem","Language Badges"),T("Diferentes linguagens com badge destacado.","Different languages with highlighted badge."),LanguageBadgesPreview(),LanguageBadgesCode)
            @Example(T("Cenarios ERP","ERP Scenarios"),T("SQL, JSON, XML e configuracoes em contexto administrativo.","SQL, JSON, XML and configs in administrative context."),ErpScenariosPreview(),ErpScenariosCode)
            @Example(T("Composicao com cards","Card Composition"),T("XFCode dentro de XFCard para dashboards e documentacao.","XFCode inside XFCard for dashboards and documentation."),CardCompositionPreview(),CardCompositionCode)
            @Example(T("Inline em texto","Inline in Text"),T("Use XFCode inline para referenciar componentes, valores e propriedades em paragrafos.","Use inline XFCode to reference components, values and properties in paragraphs."),InlineInTextPreview(),InlineInTextCode)
            @Example(T("Highlighter de texto","Text Highlighter"),T("XFHighlighter marca termos de busca em texto com tons semanticos.","XFHighlighter highlights search terms in text with semantic tones."),HighlighterPreview(),HighlighterCode)
        </XFStack>
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Variantes","Variants"),@<div>@NameValueTable(VariantRows,T("Variante","Variant"),T("Caso de uso","Use case"))</div>)
            @Section(T("Estados","States"),@<div>@NameValueTable(StateRows,T("Estado","State"),T("Comportamento","Behavior"))</div>)
            @Section("API",@<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos","Events"),@<div>@NameValueTable(EventRows,T("Evento","Event"),T("Comportamento","Behavior"))</div>)
            @Section(T("Metodos","Methods"),@<div>@NameValueTable(MethodRows,T("Metodo","Method"),T("Comportamento","Behavior"))</div>)
        </XFStack>
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade","Accessibility"),@<div>@TileGrid(AccessibilityItems,2)</div>)
            @Section(T("Navegacao enterprise por teclado","Enterprise Keyboard Navigation"),@<div>@TileGrid(EnterpriseKeyboardItems,2)</div>)
            @Section(T("Suporte de teclado","Keyboard Support"),@<div>@NameValueTable(KeyboardRows,T("Tecla","Key"),T("Comportamento","Behavior"))</div>)
            @Section(T("Responsividade","Responsiveness"),@<div>@TileGrid(ResponsivenessItems,2)</div>)
            @Section(T("Performance","Performance"),@<div>@TileGrid(PerformanceItems,2)</div>)
        </XFStack>
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise","Enterprise Scenarios"),@<div>@TileGrid(ScenarioItems,3)</div>)
            @Section(T("Padroes de composicao","Composition Patterns"),@<div>@TileGrid(CompositionItems,3)</div>)
            @Section(T("Exemplos de integracao","Integration Examples"),@<div>@TileGrid(IntegrationItems,2)</div>)
            @Section(T("Boas praticas de UX","UX Best Practices"),@<div>@TileGrid(BestPracticeItems,2)</div>)
            @Section(T("Anti-padroes","Anti-patterns"),@<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("Design Tokens",@<div>@NameValueTable(TokenRows,"Token",T("Proposito","Purpose"))</div>)
            @Section(T("Temas","Theming"),@<div>@TileGrid(ThemeItems,2)</div>)
            @Section(T("Seguranca","Security Considerations"),@<div>@TileGrid(SecurityItems,2)</div>)
            @Section(T("Testes","Testing"),@<div>@NameValueTable(TestingRows,T("Cobertura","Coverage"),T("Evidencia","Evidence"))</div>)
        </XFStack>
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Limitacoes conhecidas","Known Limitations"),@<div>@NameValueTable(LimitationRows,T("Limitacao","Limitation"),T("Status","Status"))</div>)
            @Section(T("Notas de migracao","Migration Notes"),@<div>@TileGrid(MigrationItems,2)</div>)
            @Section(T("Componentes relacionados","Related Components"),@<div>@TileGrid(RelatedComponentItems,3)</div>)
            @Section("FAQ",@<div>@NameValueTable(FaqRows,T("Pergunta","Question"),T("Resposta","Answer"))</div>)
            @Section("Changelog",@<div>@NameValueTable(ChangelogRows,T("Versao","Version"),T("Mudanca","Change"))</div>)
        </XFStack>
    </div>
</XForgeDocsShell>
@code {
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);
    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFStack Orientation="XFOrientation.Horizontal" Gap="3" Wrap="XFWrap.Wrap">
            <XFCode Text="XFButton" Variant="XFCodeVariant.Inline" />
            <XFCode Text="XFButtonColor.Primary" Variant="XFCodeVariant.Inline" Tone="XFSemanticColor.Primary" />
            <XFCode Text="true" Variant="XFCodeVariant.Inline" Tone="XFSemanticColor.Success" />
        </XFStack>
        <XFCode Text='@T("SELECT * FROM Pedidos WHERE Status = '\''Aprovado'\'' ORDER BY Data DESC;","SELECT * FROM Orders WHERE Status = '\''Approved'\'' ORDER BY Date DESC;")' Title="@T("Consulta SQL","SQL Query")" Language="sql" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" />
        <XFGrid Cols="1" Md="3" Gap="3">
            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("API Response","API Response")</XFTypography><div class="mt-2"><XFCode Text='{ "status": "ok", "id": 1234 }' Variant="XFCodeVariant.Inline" Tone="XFSemanticColor.Success" /></div></ChildContent></XFCard>
            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Config","Config")</XFTypography><div class="mt-2"><XFCode Text='ConnectionTimeout=30' Variant="XFCodeVariant.Inline" Tone="XFSemanticColor.Primary" /></div></ChildContent></XFCard>
            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Warning","Warning")</XFTypography><div class="mt-2"><XFCode Text="Deprecated v2.0" Variant="XFCodeVariant.Inline" Tone="XFSemanticColor.Warning" /></div></ChildContent></XFCard>
        </XFGrid>
    </XFStack>;
    private RenderFragment InlineBasicPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFStack Orientation="XFOrientation.Horizontal" Gap="3" Wrap="XFWrap.Wrap">
            <XFCode Text="XFButton" Variant="XFCodeVariant.Inline" />
            <XFCode Text="@T("Salvar pedido","Save order")" Variant="XFCodeVariant.Inline" />
            <XFCode Text="true" Variant="XFCodeVariant.Inline" Tone="XFSemanticColor.Success" />
        </XFStack>
    </XFStack>;
    private RenderFragment TonesInlinePreview() => @<XFStack Orientation="XFOrientation.Horizontal" Gap="3" Wrap="XFWrap.Wrap">
        <XFCode Text="Neutral" Variant="XFCodeVariant.Inline" Tone="XFSemanticColor.Neutral" />
        <XFCode Text="Primary" Variant="XFCodeVariant.Inline" Tone="XFSemanticColor.Primary" />
        <XFCode Text="Success" Variant="XFCodeVariant.Inline" Tone="XFSemanticColor.Success" />
        <XFCode Text="Warning" Variant="XFCodeVariant.Inline" Tone="XFSemanticColor.Warning" />
        <XFCode Text="Danger" Variant="XFCodeVariant.Inline" Tone="XFSemanticColor.Danger" />
    </XFStack>;
    private RenderFragment BlockHeaderPreview() => @<XFCode Text='@T("{ \"pedido\": 1234, \"status\": \"aprovado\", \"valor\": 84200.50 }","{ \"order\": 1234, \"status\": \"approved\", \"amount\": 84200.50 }")' Title="@T("Resposta da API","API Response")" Language="json" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" Tone="XFSemanticColor.Neutral" />;
    private string InlineBasicCode => T("""<XFCode Text="XFButton" Variant="XFCodeVariant.Inline" /><XFCode Text="Salvar pedido" Variant="XFCodeVariant.Inline" /><XFCode Text="true" Variant="XFCodeVariant.Inline" Tone="XFSemanticColor.Success" />""","""<XFCode Text="XFButton" Variant="XFCodeVariant.Inline" /><XFCode Text="Save order" Variant="XFCodeVariant.Inline" /><XFCode Text="true" Variant="XFCodeVariant.Inline" Tone="XFSemanticColor.Success" />""");
    private string TonesInlineCode => """<XFCode Text="Neutral" Tone="XFSemanticColor.Neutral" /><XFCode Text="Primary" Tone="XFSemanticColor.Primary" /><XFCode Text="Success" Tone="XFSemanticColor.Success" /><XFCode Text="Warning" Tone="XFSemanticColor.Warning" /><XFCode Text="Danger" Tone="XFSemanticColor.Danger" />""";
    private string BlockHeaderCode => """<XFCode Text='{ "order": 1234, "status": "approved" }' Title="API Response" Language="json" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" />""";

    // TonesBlock
    private RenderFragment TonesBlockPreview() => @<div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        <XFCode Text="const config = { theme: 'neutral' }" Title="Neutral" Language="js" Variant="XFCodeVariant.Block" Tone="XFSemanticColor.Neutral" />
        <XFCode Text="const config = { theme: 'primary' }" Title="Primary" Language="js" Variant="XFCodeVariant.Block" Tone="XFSemanticColor.Primary" />
        <XFCode Text="const status = 'connected'" Title="Success" Language="js" Variant="XFCodeVariant.Block" Tone="XFSemanticColor.Success" />
        <XFCode Text="const retries = 3" Title="Warning" Language="js" Variant="XFCodeVariant.Block" Tone="XFSemanticColor.Warning" />
        <XFCode Text="throw new Error('Connection failed')" Title="Danger" Language="js" Variant="XFCodeVariant.Block" Tone="XFSemanticColor.Danger" />
    </div>;
    private string TonesBlockCode => @"<XFCode Text=""const config = { theme: 'neutral' }""
    Title=""Neutral"" Language=""js"" Variant=""XFCodeVariant.Block""
    Tone=""XFSemanticColor.Neutral"" />

<XFCode Text=""const config = { theme: 'primary' }""
    Title=""Primary"" Language=""js"" Variant=""XFCodeVariant.Block""
    Tone=""XFSemanticColor.Primary"" />

<XFCode Text=""const status = 'connected'""
    Title=""Success"" Language=""js"" Variant=""XFCodeVariant.Block""
    Tone=""XFSemanticColor.Success"" />

<XFCode Text=""const retries = 3""
    Title=""Warning"" Language=""js"" Variant=""XFCodeVariant.Block""
    Tone=""XFSemanticColor.Warning"" />

<XFCode Text=""throw new Error('Connection failed')""
    Title=""Danger"" Language=""js"" Variant=""XFCodeVariant.Block""
    Tone=""XFSemanticColor.Danger"" />";

    // CopyFeedback
    private RenderFragment CopyFeedbackPreview() => @<div class="space-y-3">
        <XFCode Text="dotnet add package XForge.DesignSystem --version 2.0.0" Title="@T("Instalacao via CLI","CLI Install")" Language="bash" Variant="XFCodeVariant.Block" Copyable="true" CopyLabel="@T("Copiar comando","Copy command")" CopyText="@T("Copiar","Copy")" CopiedText="@T("Copiado!","Copied!")" Tone="XFSemanticColor.Primary" />
        <XFCode Text="@_npmInstallCmd" Title="@T("Instalacao NPM","NPM Install")" Language="bash" Variant="XFCodeVariant.Block" Copyable="true" Tone="XFSemanticColor.Success" />
    </div>;
    private string CopyFeedbackCode => @"<XFCode Text=""dotnet add package XForge.DesignSystem --version 2.0.0""
    Title=""Instalacao via CLI"" Language=""bash""
    Variant=""XFCodeVariant.Block"" Copyable=""true""
    CopyLabel=""Copiar comando"" CopyText=""Copiar""
    CopiedText=""Copiado!"" Tone=""XFSemanticColor.Primary"" />

<XFCode Text=""npm install @xforge/design-system""
    Title=""Instalacao NPM"" Language=""bash""
    Variant=""XFCodeVariant.Block"" Copyable=""true""
    Tone=""XFSemanticColor.Success"" />";

    // WrapComparison
    private RenderFragment WrapComparisonPreview() => @<div class="grid grid-cols-1 gap-4 md:grid-cols-2">
        <div class="space-y-2"><p class="text-xs font-semibold text-text-muted">Wrap = false</p><XFCode Text="SELECT o.Id, o.Data, c.Nome, c.Email, SUM(i.Quantidade * i.PrecoUnitario) AS Total FROM Pedidos o INNER JOIN Clientes c ON o.ClienteId = c.Id ORDER BY o.Data DESC;" Language="sql" Variant="XFCodeVariant.Block" Wrap="false" /></div>
        <div class="space-y-2"><p class="text-xs font-semibold text-text-muted">Wrap = true</p><XFCode Text="SELECT o.Id, o.Data, c.Nome, c.Email, SUM(i.Quantidade * i.PrecoUnitario) AS Total FROM Pedidos o INNER JOIN Clientes c ON o.ClienteId = c.Id ORDER BY o.Data DESC;" Language="sql" Variant="XFCodeVariant.Block" Wrap="true" /></div>
    </div>;
    private string WrapComparisonCode => @"<!-- Wrap = false -->
<XFCode Text=""SELECT o.Id, o.Data, c.Nome, c.Email, SUM(i.Quantidade * i.PrecoUnitario) AS Total FROM Pedidos o INNER JOIN Clientes c ON o.ClienteId = c.Id ORDER BY o.Data DESC;""
    Language=""sql"" Variant=""XFCodeVariant.Block"" Wrap=""false"" />

