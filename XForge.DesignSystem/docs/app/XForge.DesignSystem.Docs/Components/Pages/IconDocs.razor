@page "/components/icon"
@using XForge.DesignSystem.Core.Primitives
@using Microsoft.AspNetCore.Components.Web
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFSvgIcons" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Catalogo central", "Central catalog")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("SVG seguro", "Safe SVG")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Iconografia consistente para produtos enterprise, docs e playgrounds.",
                               "Consistent iconography for enterprise products, docs and playgrounds.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("XFSvgIcons centraliza nomes, SVGs e tamanhos para evitar icones copiados localmente, SVG vazio e divergencia visual entre componentes.",
                               "XFSvgIcons centralizes names, SVGs and sizes to avoid locally copied icons, empty SVGs and visual drift across components.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico. Interacoes requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderizacao.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(T("Hierarquia visual", "Visual Hierarchy"), @<div>@TileGrid(VisualItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(PrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 3 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Galeria de icones", "1. Icon gallery"), T("Icones reais do catalogo usados em cards, badges e acoes.", "Real catalog icons used in cards, badges and actions."), IconGallery(), GalleryCode)
            @Example(T("2. Uso em componentes", "2. Component usage"), T("Use MarkupWithSize para controlar tamanho sem recriar SVG.", "Use MarkupWithSize to control size without recreating SVG."), UsagePreview(), UsageCode)
            @Example(T("3. Estados enterprise", "3. Enterprise states"), T("Estados enterprise com icone, texto e cor sem depender apenas de cor.", "Enterprise states with icon, text and color without relying on color alone."), StatusPreview(), StatusCode)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Variantes", "Variants"), @<div>@NameValueTable(VariantRows, T("Variante", "Variant"), T("Uso", "Usage"))</div>)
            @Section(T("Estados", "States"), @<div>@NameValueTable(StateRows, T("Estado", "State"), T("Comportamento", "Behavior"))</div>)
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Metodos", "Methods"), @<div>@NameValueTable(MethodRows, T("Metodo", "Method"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Navegacao enterprise por teclado", "Enterprise Keyboard Navigation"), @<div>@TileGrid(KeyboardGuidanceItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsiveItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Exemplos de integracao", "Integration Examples"), @<div>@TileGrid(IntegrationItems, 2)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("Design Tokens", @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Seguranca", "Security Considerations"), @<div>@TileGrid(SecurityItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Notas de migracao", "Migration Notes"), @<div>@TileGrid(MigrationItems, 2)</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>

@code {
    private string ProductLabelText => T("Core Open Source", "Core Open Source");
    private string PageTitleText => T("XFSvgIcons", "XFSvgIcons");
    private string PageStatusText => T("Documentacao completa", "Complete docs");
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFGrid Cols="2" Md="4" Gap="3">
        @foreach (var icon in GalleryIcons)
        {
            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
                <ChildContent>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="3" AlignItems="XFAlignItems.Center">
                        <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-border-light bg-bg-surface text-primary" aria-hidden="true">@XFSvgIcons.MarkupWithSize(icon.Icon, 20)</span>
                        <XFTypography Variant="XFTypographyVariant.Caption" Weight="XFTypographyWeight.Semibold">@icon.Name</XFTypography>
                    </XFStack>
                </ChildContent>
            </XFCard>
        }
    </XFGrid>;

    private RenderFragment IconGallery() => @<XFGrid Cols="2" Md="4" Gap="3">
        @foreach (var icon in GalleryIcons)
        {
            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
                <ChildContent>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="3" AlignItems="XFAlignItems.Center">
                        <span class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-border-light bg-bg-surface text-primary" aria-hidden="true">@XFSvgIcons.MarkupWithSize(icon.Icon, 20)</span>
                        <XFTypography Variant="XFTypographyVariant.Caption" Weight="XFTypographyWeight.Semibold">@icon.Name</XFTypography>
                    </XFStack>
                </ChildContent>
            </XFCard>
        }
    </XFGrid>;

    private RenderFragment UsagePreview() => @<XFStack Orientation="XFOrientation.Horizontal" Gap="3" Wrap="XFWrap.Wrap">
        <XFButton Text="@T("Salvar", "Save")" Color="XFButtonColor.Primary"><StartIcon><span class="inline-flex h-4 w-4">@XFSvgIcons.MarkupWithSize("check", 16)</span></StartIcon></XFButton>
        <XFButton Text="@T("Exportar", "Export")" Variant="XFButtonVariant.Outline"><StartIcon><span class="inline-flex h-4 w-4">@XFSvgIcons.MarkupWithSize("download", 16)</span></StartIcon></XFButton>
        <XFBadge Text="@T("Auditavel", "Auditable")" Color="XFBadgeColor.Success"><StartIcon><span class="inline-flex h-3.5 w-3.5">@XFSvgIcons.MarkupWithSize("shield-check", 14)</span></StartIcon></XFBadge>
    </XFStack>;

    private RenderFragment StatusPreview() => @<XFGrid Cols="1" Md="3" Gap="3">
        @foreach (var item in StatusItems)
        {
            @Tile(item)
        }
    </XFGrid>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("Catalogo unico", "Single catalog"), T("Nomes de icones ficam centralizados em XFSvgIcons.", "Icon names are centralized in XFSvgIcons."), "book"),
        new(T("Tamanho controlado", "Controlled size"), T("MarkupWithSize evita SVG gigante ou apertado.", "MarkupWithSize avoids oversized or cramped SVG."), "arrows-maximize"),
        new(T("Sem SVG vazio", "No empty SVG"), T("Use nomes existentes e valide antes de publicar.", "Use existing names and validate before publishing."), "shield-check")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Artifact", "XFSvgIcons"),
        new("Namespace", "XForge.DesignSystem.Components.Icon"),
        new("Package", "XForge.DesignSystem"),
        new("Category", "Components / Foundation"),
        new("Route", "/components/icon"),
        new(T("Tipo", "Type"), T("Utilitario estatico", "Static utility")),
        new("Theme support", T("currentColor, data-theme light/dark.", "currentColor, data-theme light/dark."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("Catalogo unico", "Single catalog"), T("Nomes de icones ficam centralizados em XFSvgIcons.", "Icon names are centralized in XFSvgIcons."), "book"),
        new(T("Tamanho controlado", "Controlled size"), T("MarkupWithSize evita SVG gigante ou apertado.", "MarkupWithSize avoids oversized or cramped SVG."), "arrows-maximize"),
        new(T("Sem SVG vazio", "No empty SVG"), T("Use nomes existentes e valide antes de publicar.", "Use existing names and validate before publishing."), "shield-check")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Consistencia", "Consistency"), T("Mesma linguagem visual em componentes e docs.", "Same visual language in components and docs."), "swatchbook"),
        new(T("Governanca", "Governance"), T("Evita copiar SVG localmente em paginas.", "Avoids copying SVG locally into pages."), "lock"),
        new(T("Velocidade", "Speed"), T("Icone pronto por nome e tamanho.", "Icon ready by name and size."), "bolt")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Icones duplicados", "Duplicated icons"), T("Remove divergencia entre arquivos SVG locais.", "Removes drift between local SVG files."), "copy"),
        new(T("Proporcao ruim", "Poor proportion"), T("Tamanho explicito preserva equilibrio com texto.", "Explicit size preserves balance with text."), "eye"),
        new(T("A11y inconsistente", "Inconsistent a11y"), T("Icones decorativos devem ficar em container aria-hidden.", "Decorative icons should live in an aria-hidden container."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Botoes", "Buttons"), T("StartIcon e EndIcon com icone decorativo.", "StartIcon and EndIcon with decorative icon."), "arrow-pointer"),
        new(T("Tiles", "Tiles"), T("Container 40x40, icone 18px e texto protagonista.", "40x40 container, 18px icon and text as protagonist."), "square"),
        new(T("Status", "Status"), T("Combine icone, texto e tom semantico.", "Combine icon, text and semantic tone."), "tag")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Nome inventado", "Invented name"), T("Nao use nome ausente do catalogo.", "Do not use a name missing from the catalog."), "xmark"),
        new(T("Icone como texto", "Icon as text"), T("Nao substitua label acessivel por icone.", "Do not replace accessible label with an icon."), "eye-slash"),
        new(T("SVG colado", "Crammed SVG"), T("Nao use icone grande sem padding no container.", "Do not use a large icon without container padding."), "xmark")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new("Name", T("Chave string do catalogo.", "String key in the catalog."), "tag"),
        new("Markup", T("Retorna MarkupString para renderizacao.", "Returns MarkupString for rendering."), "code"),
        new("Container", T("Responsavel por padding, cor e aria-hidden.", "Responsible for padding, color and aria-hidden."), "square")
    ];

    private IReadOnlyList<DocTile> VisualItems => [
        new(T("Icone complementar", "Complementary icon"), T("Texto continua protagonista.", "Text remains protagonist."), "font"),
        new(T("Respiro", "Breathing room"), T("Use container 40x40 para tiles.", "Use 40x40 container for tiles."), "arrows-maximize"),
        new(T("Contraste", "Contrast"), T("Cor do icone deve herdar tokens.", "Icon color should inherit tokens."), "palette")
    ];

    private IReadOnlyList<DocTile> PrincipleItems => [
        new(T("Sem decoracao solta", "No loose decoration"), T("Icone precisa ajudar reconhecimento.", "Icon must help recognition."), "lightbulb"),
        new(T("Sem arbitrariedade", "No arbitrariness"), T("Escolha icone do catalogo mais proximo.", "Choose the closest catalog icon."), "check"),
        new(T("Escala consistente", "Consistent scale"), T("16px em botoes, 18px em tiles, 20px+ em previews.", "16px in buttons, 18px in tiles, 20px+ in previews."), "sliders")
    ];

    // === VARIANTS + STATES + API ===
    private IReadOnlyList<NameValueRow> VariantRows => [
        new("Markup(name)", T("Renderiza tamanho padrao do SVG.", "Renders the SVG default size.")),
        new("MarkupWithSize(name,size)", T("Renderiza SVG com width/height controlados.", "Renders SVG with controlled width/height.")),
        new("Get(name)", T("Retorna string SVG para uso interno.", "Returns SVG string for internal use.")),
        new("GetWithSize(name,size)", T("Retorna string SVG redimensionada.", "Returns resized SVG string."))
    ];

    private IReadOnlyList<NameValueRow> StateRows => [
        new(T("Existente", "Existing"), T("Renderiza SVG real.", "Renders real SVG.")),
        new(T("Ausente", "Missing"), T("Deve ser tratado como erro de documentacao.", "Should be treated as documentation error.")),
        new(T("Decorativo", "Decorative"), T("Use aria-hidden no wrapper.", "Use aria-hidden on the wrapper."))
    ];

    private IReadOnlyList<ApiRow> ApiRows => [
        new("Get", "static method", "string", T("Busca SVG pelo nome.", "Looks up SVG by name.")),
        new("GetWithSize", "static method", "string", T("Busca SVG e injeta tamanho.", "Looks up SVG and injects size.")),
        new("Markup", "static method", "MarkupString", T("Retorna MarkupString para Razor.", "Returns MarkupString for Razor.")),
        new("MarkupWithSize", "static method", "MarkupString", T("Retorna MarkupString com tamanho.", "Returns MarkupString with size."))
    ];

    private IReadOnlyList<NameValueRow> EventRows => [
        new(T("Nao aplicavel", "Not applicable"), T("XFSvgIcons e utilitario estatico e nao dispara eventos.", "XFSvgIcons is a static utility and raises no events."))
    ];

    private IReadOnlyList<NameValueRow> MethodRows => VariantRows;

    // === ACCESSIBILITY ===
    private IReadOnlyList<DocTile> AccessibilityItems => [
        new(T("Decorativo", "Decorative"), T("Wrapper deve usar aria-hidden quando label ja existe.", "Wrapper should use aria-hidden when label already exists."), "eye-slash"),
        new(T("Informativo", "Informative"), T("Se comunica estado, combine com texto.", "If it communicates state, combine with text."), "circle-info"),
        new(T("Contraste", "Contrast"), T("Nao confie apenas na cor do icone.", "Do not rely only on icon color."), "shield-check")
    ];

    private IReadOnlyList<DocTile> KeyboardGuidanceItems => [
        new(T("Sem foco proprio", "No own focus"), T("Icone decorativo nao recebe tab.", "Decorative icon receives no tab stop."), "keyboard"),
        new(T("Foco no controle", "Focus on control"), T("Botao/link dono do icone recebe foco.", "The button/link owning the icon receives focus."), "arrow-pointer"),
        new(T("Label no controle", "Label on control"), T("Use AriaLabel/Title no componente interativo.", "Use AriaLabel/Title on the interactive component."), "tag")
    ];

    private IReadOnlyList<NameValueRow> KeyboardRows => [
        new("Tab", T("Nao foca icone decorativo; foca o controle pai.", "Does not focus decorative icon; focuses parent control.")),
        new("Enter/Space", T("Aciona o controle pai, nao o SVG.", "Activates the parent control, not the SVG."))
    ];

    // === RESPONSIVENESS ===
    private IReadOnlyList<DocTile> ResponsiveItems => [
        new(T("Tamanho fixo", "Fixed size"), T("Use MarkupWithSize para evitar salto.", "Use MarkupWithSize to avoid jumps."), "arrows-maximize"),
        new(T("Truncamento", "Truncation"), T("Icone deve ter shrink-0 em linhas densas.", "Icon should have shrink-0 in dense rows."), "arrows-left-right"),
        new(T("Touch", "Touch"), T("Area de toque pertence ao botao pai.", "Touch area belongs to the parent button."), "hand-pointer")
    ];

    // === PERFORMANCE ===
    private IReadOnlyList<DocTile> PerformanceItems => [
        new(T("Sem JS", "No JS"), T("Renderiza markup SVG estatico.", "Renders static SVG markup."), "code"),
        new(T("Cache por codigo", "Code catalog"), T("Catalogo fica compilado em classe estatica.", "Catalog is compiled in a static class."), "bolt"),
        new(T("Evite excesso", "Avoid excess"), T("Muitos SVGs por linha aumentam DOM.", "Too many SVGs per row increase DOM."), "gauge")
    ];

    // === SCENARIOS ===
    private IReadOnlyList<DocTile> ScenarioItems => [
        new(T("Financeiro", "Finance"), T("Status de pagamento e exportacao.", "Payment and export status."), "money-bill"),
        new(T("Fiscal", "Tax"), T("Auditoria, alerta e documento.", "Audit, alert and document."), "calculator"),
        new(T("Operacao", "Operations"), T("Acoes rapidas e estados de workflow.", "Quick actions and workflow states."), "route")
    ];

    // === COMPOSITION ===
    private IReadOnlyList<DocTile> CompositionItems => [
        new("XFButton", T("Use em StartIcon/EndIcon.", "Use in StartIcon/EndIcon."), "arrow-pointer"),
        new("XFBadge", T("Use icone pequeno com texto.", "Use small icon with text."), "tag"),
        new("XFRail", T("Usa nomes de icone do catalogo.", "Uses catalog icon names."), "window-restore")
    ];

    // === INTEGRATION ===
    private IReadOnlyList<DocTile> IntegrationItems => [
        new("XFSvgIcons.MarkupWithSize", T("Preferido para docs e previews.", "Preferred for docs and previews."), "code"),
        new("icon_names", T("Validar nomes antes de publicar.", "Validate names before publishing."), "check"),
        new("BrandMetadataService", T("Categorias usam icones do catalogo.", "Categories use catalog icons."), "swatchbook")
    ];

    // === BEST PRACTICES ===
    private IReadOnlyList<DocTile> BestPracticeItems => [
        new(T("Valide nome", "Validate name"), T("Confira se existe em XFSvgIcons.", "Check it exists in XFSvgIcons."), "check"),
        new(T("Use wrapper", "Use wrapper"), T("Wrapper controla tamanho, cor e aria.", "Wrapper controls size, color and aria."), "square"),
        new(T("Mantenha texto", "Keep text"), T("Icone nao substitui informacao critica.", "Icon does not replace critical information."), "font")
    ];

    // === ANTI-PATTERNS ===
    private IReadOnlyList<DocTile> AntiPatternItems => [
        new(T("SVG inline local", "Local inline SVG"), T("Nao cole SVG novo dentro da pagina.", "Do not paste new SVG into the page."), "xmark"),
        new(T("Fallback vazio", "Empty fallback"), T("Nao aceite icone invisivel.", "Do not accept invisible icon."), "eye-slash"),
        new(T("Icone gigante", "Giant icon"), T("Nao deixe o simbolo tocar bordas.", "Do not let the symbol touch edges."), "xmark")
    ];

    // === TOKENS ===
    private IReadOnlyList<NameValueRow> TokenRows => [
        new("color", T("text-primary, text-success, text-danger e currentColor.", "text-primary, text-success, text-danger and currentColor.")),
        new("size", "12px, 14px, 16px, 18px, 20px, 24px."),
        new("spacing", T("gap e padding do container.", "container gap and padding.")),
        new("radius", T("rounded-lg no container premium.", "rounded-lg in premium container."))
    ];

    // === THEMING ===
