@page "/overlays/popover"
@page "/components/popover"
@using XForge.DesignSystem.Core.Primitives
@using XForge.DesignSystem.Components.Overlays.Popover
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFPopover" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Focus trap", "Focus trap")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Enterprise", "Enterprise")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Painel ancorado com foco, posicionamento automático e acessibilidade.",
                               "Anchored panel with focus, automatic positioning and accessibility.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("XFPopover renderiza painéis contextuais ancorados a um gatilho com 4 posições, 3 alinhamentos, 3 tamanhos, focus trap, collision detection e fechamento por Escape.",
                               "XFPopover renders contextual panels anchored to a trigger with 4 positions, 3 alignments, 3 sizes, focus trap, collision detection and Escape close.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section(T("Blazor Server e Blazor WebAssembly", "Blazor Server and Blazor WebAssembly"), @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observações", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Parcial", "Partial")" /></XFTableCell><XFTableCell>@T("JS interop via SignalR. Pode haver latência no posicionamento.", "JS interop via SignalR. Positioning may have latency.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("JS interop direto, sem latência de rede.", "Direct JS interop, no network latency.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Parcial", "Partial")" /></XFTableCell><XFTableCell>@T("Depende do modo ativo no momento.", "Depends on the active mode at the time.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Danger" Text="@T("Não", "No")" /></XFTableCell><XFTableCell>@T("JS interop não disponível em modo estático.", "JS interop not available in static mode.")</XFTableCell></XFTableRow></XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("JS Interop", "JS Interop")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("xfPopover.register/release — gerencia posicionamento ancorado com flip, offset e collision padding.", "xfPopover.register/release — manages anchored positioning with flip, offset and collision padding.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("xfFocusTrap.activate/release — gerencia foco preso no painel quando aberto.", "xfFocusTrap.activate/release — manages focus trapped in panel when open.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Quando carrega: OnAfterRenderAsync.", "When loaded: OnAfterRenderAsync.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Prerender seguro: try/catch para InvalidOperationException e JSDisconnectedException.", "Prerender safe: try/catch for InvalidOperationException and JSDisconnectedException.")</XFTypography>
                </XFStack>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Considerações Blazor Server", "Blazor Server Considerations")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("JS interop via SignalR com latência. Posicionamento e focus trap podem ter resposta mais lenta.", "JS interop via SignalR with latency. Positioning and focus trap may have slower response.")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Considerações Blazor WebAssembly", "Blazor WebAssembly Considerations")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("JS interop direto sem latência de rede. Disponível após carregamento do WASM.", "Direct JS interop with no network latency. Available after WASM load.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visão geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Propósito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando não usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Hierarquia visual", "Visual Hierarchy"), @<div>@TileGrid(VisualHierarchyItems, 3)</div>)
            @Section(T("Princípios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 10 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Básico", "1. Basic"),
                T("Popover simples com ButtonText e ChildContent.", "Simple popover with ButtonText and ChildContent."),
                ExBasic(), CodeBasic)

            @Example(T("2. Posições", "2. Positions"),
                T("4 posições: Top, Bottom, Left e Right.", "4 positions: Top, Bottom, Left and Right."),
                ExPositions(), CodePositions)

            @Example(T("3. Alinhamento", "3. Alignment"),
                T("3 alinhamentos: Start, Center e End.", "3 alignments: Start, Center and End."),
                ExAlignment(), CodeAlignment)

            @Example(T("4. Tamanhos", "4. Sizes"),
                T("Sm (w-56), Md (w-72) e Lg (w-96).", "Sm (w-56), Md (w-72) and Lg (w-96)."),
                ExSizes(), CodeSizes)

            @Example(T("5. Gatilho customizado", "5. Custom Trigger"),
                T("Trigger template com XFPopoverTriggerContext para controle total.", "Trigger template with XFPopoverTriggerContext for full control."),
                ExCustomTrigger(), CodeCustomTrigger)

            @Example(T("6. Conteúdo rico", "6. Rich Content"),
                T("Formulário com campos e botões dentro do popover.", "Form with fields and buttons inside the popover."),
                ExRichContent(), CodeRichContent)

            @Example(T("7. Focus Trap", "7. Focus Trap"),
                T("TrapFocus=true mantém o foco dentro do painel.", "TrapFocus=true keeps focus inside the panel."),
                ExFocusTrap(), CodeFocusTrap)

            @Example(T("8. Fechamento", "8. Close Behavior"),
                T("CloseOnEscape e CloseOnOutsideClick.", "CloseOnEscape and CloseOnOutsideClick."),
                ExCloseBehavior(), CodeCloseBehavior)

            @Example(T("9. Collision e Flip", "9. Collision & Flip"),
                T("CollisionPadding e Flip para manter o painel visível.", "CollisionPadding and Flip to keep panel visible."),
                ExCollision(), CodeCollision)

            @Example(T("10. Cenário enterprise", "10. Enterprise Scenario"),
                T("Painel de ajuda fiscal com explicação de campo e atalhos.", "Fiscal help panel with field explanation and shortcuts."),
                ExEnterprise(), CodeEnterprise)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenários enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padrões de composição", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas práticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padrões", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Propósito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidência", "Evidence"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Limitações conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitação", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versão", "Version"), T("Mudança", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>

@code {
    private string ProductLabelText => T("Core Open Source", "Core Open Source");
    private string PageTitleText => T("XFPopover", "XFPopover");
    private string PageStatusText => T("Documentação completa", "Complete docs");
    private string T(string pt, string en) => LanguageService.Text(pt, en);
    private string CopyableCodeTitle => T("Código copiável", "Copyable code");

    // Example state
    private bool _basicOpen;
    private bool _topOpen;
    private bool _bottomOpen;
    private bool _leftOpen;
    private bool _rightOpen;
    private bool _alignStartOpen;
    private bool _alignCenterOpen;
    private bool _alignEndOpen;
    private bool _smOpen;
    private bool _mdOpen;
    private bool _lgOpen;
    private bool _customTriggerOpen;
    private bool _richOpen;
    private bool _focusTrapOpen;
    private bool _closeEscapeOpen;
    private bool _closeOutsideOpen;
    private bool _collisionOpen;
    private bool _enterpriseOpen;

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFStack Orientation="XFOrientation.Horizontal" Gap="3" Wrap="XFWrap.Wrap">
            <XFPopover ButtonText="@T("Ajuda", "Help")" Open="_basicOpen" OpenChanged="v => _basicOpen = v">
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">
                    @T("Este popover explica o campo selecionado com contexto adicional.",
                       "This popover explains the selected field with additional context.")
                </XFTypography>
            </XFPopover>
            <XFPopover ButtonText="@T("Fiscal", "Fiscal")" Placement="XFPopoverPlacement.Top" Open="_topOpen" OpenChanged="v => _topOpen = v">
                <XFTypography Variant="XFTypographyVariant.Body2">@T("ICMS: 18% para operações internas.", "ICMS: 18% for internal operations.")</XFTypography>
            </XFPopover>
            <XFPopover ButtonText="@T("SLA", "SLA")" Placement="XFPopoverPlacement.Bottom" Size="XFSize.Sm" Open="_bottomOpen" OpenChanged="v => _bottomOpen = v">
                <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">SLA 98.4%</XFTypography>
            </XFPopover>
        </XFStack>
    </XFStack>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("WAI-ARIA dialog", "WAI-ARIA dialog"), T("role=dialog, aria-expanded, aria-controls, focus trap.", "role=dialog, aria-expanded, aria-controls, focus trap."), "universal-access"),
        new(T("4 posições fluidas", "4 fluid positions"), T("Top, Bottom, Left e Right com flip automático.", "Top, Bottom, Left and Right with automatic flip."), "arrows-up-down"),
        new(T("Collision detection", "Collision detection"), T("CollisionPadding mantém o painel visível na viewport.", "CollisionPadding keeps panel visible in viewport."), "maximize")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFPopover"),
        new("Namespace", "XForge.DesignSystem.Components.Overlays.Popover"),
        new("Package", "XForge.DesignSystem"),
        new("Category", "Components / Overlays / Popover"),
        new("Status", T("Estável", "Stable")),
        new("Accessibility", T("role=dialog, aria-expanded, aria-controls, focus trap, Escape, touch 44px.", "role=dialog, aria-expanded, aria-controls, focus trap, Escape, 44px touch.")),
        new("Theme support", T("Light, dark e data-brand via tokens.", "Light, dark and data-brand via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("Painel ancorado", "Anchored panel"), T("Renderiza conteúdo contextual ancorado a um gatilho.", "Renders contextual content anchored to a trigger."), "link"),
        new(T("Posicionamento automático", "Auto positioning"), T("Flip, offset e collision padding via JS interop.", "Flip, offset and collision padding via JS interop."), "arrows-up-down"),
        new(T("Focus trap", "Focus trap"), T("Foco preso no painel quando aberto.", "Focus trapped in panel when open."), "lock")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Tooltips não interativos ou modais excessivos para ajuda simples.", "Non-interactive tooltips or excessive modals for simple help."), "xmark"),
        new(T("Depois", "After"), T("Popover ancorado com conteúdo rico, foco gerenciado e fechamento por Escape.", "Anchored popover with rich content, managed focus and Escape close."), "check"),
        new(T("Risco reduzido", "Reduced risk"), T("Focus trap, aria-expanded e collision garantem acessibilidade.", "Focus trap, aria-expanded and collision ensure accessibility."), "shield-check")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Ajuda contextual", "Contextual help"), T("Explicar campos, regras fiscais ou indicadores sem sair da página.", "Explain fields, fiscal rules or indicators without leaving the page."), "circle-info"),
        new(T("Controles leves", "Light controls"), T("Ações secundárias, filtros rápidos e seleções.", "Secondary actions, quick filters and selections."), "sliders"),
        new(T("Formulários inline", "Inline forms"), T("Edição rápida de dados sem navegação.", "Quick data editing without navigation."), "pen")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Conteúdo extenso", "Extensive content"), T("Use XFDrawer ou XFDialog para conteúdo longo.", "Use XFDrawer or XFDialog for long content."), "xmark"),
        new(T("Navegação principal", "Primary navigation"), T("Use Sidebar ou Rail para navegação entre apps.", "Use Sidebar or Rail for app navigation."), "route"),
        new(T("Ação destrutiva", "Destructive action"), T("Use XFDialog para confirmações de ações críticas.", "Use XFDialog for critical action confirmations."), "triangle-exclamation")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new(T("Gatilho (Trigger)", "Trigger"), T("Botão padrão com ButtonText ou template customizado.", "Default button with ButtonText or custom template."), "hand-pointer"),
        new(T("Painel (Panel)", "Panel"), T("Div com role=dialog, aria-label, tabindex=-1 e focus trap.", "Div with role=dialog, aria-label, tabindex=-1 and focus trap."), "window-restore"),
        new(T("Conteúdo", "Content"), T("ChildContent com qualquer markup renderizável.", "ChildContent with any renderable markup."), "layer-group")
    ];

    // === 1. Basic ===
    private RenderFragment ExBasic() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFPopover ButtonText="@T("Abrir popover", "Open popover")" Open="_basicOpen" OpenChanged="v => _basicOpen = v">
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">
                @T("Este é um popover básico com título e descrição.",
                   "This is a basic popover with title and description.")
            </XFTypography>
        </XFPopover>
    </XFStack>;

    // === 2. Positions ===
    private RenderFragment ExPositions() => @<XFStack Orientation="XFOrientation.Horizontal" Gap="3" Wrap="XFWrap.Wrap">
        <XFPopover ButtonText="Top" Placement="XFPopoverPlacement.Top" Open="_topOpen" OpenChanged="v => _topOpen = v">
            <XFTypography Variant="XFTypographyVariant.Body2">@T("Popover no topo.", "Popover on top.")</XFTypography>
        </XFPopover>
        <XFPopover ButtonText="Bottom" Placement="XFPopoverPlacement.Bottom" Open="_bottomOpen" OpenChanged="v => _bottomOpen = v">
            <XFTypography Variant="XFTypographyVariant.Body2">@T("Popover embaixo.", "Popover on bottom.")</XFTypography>
        </XFPopover>
        <XFPopover ButtonText="Left" Placement="XFPopoverPlacement.Left" Open="_leftOpen" OpenChanged="v => _leftOpen = v">
            <XFTypography Variant="XFTypographyVariant.Body2">@T("Popover à esquerda.", "Popover on left.")</XFTypography>
        </XFPopover>
        <XFPopover ButtonText="Right" Placement="XFPopoverPlacement.Right" Open="_rightOpen" OpenChanged="v => _rightOpen = v">
            <XFTypography Variant="XFTypographyVariant.Body2">@T("Popover à direita.", "Popover on right.")</XFTypography>
        </XFPopover>
    </XFStack>;

    // === 3. Alignment ===
    private RenderFragment ExAlignment() => @<XFStack Orientation="XFOrientation.Horizontal" Gap="3" Wrap="XFWrap.Wrap">
        <XFPopover ButtonText="Start" Alignment="XFPopoverAlignment.Start" Open="_alignStartOpen" OpenChanged="v => _alignStartOpen = v">
            <XFTypography Variant="XFTypographyVariant.Body2">@T("Alinhado ao início.", "Aligned to start.")</XFTypography>
        </XFPopover>
        <XFPopover ButtonText="Center" Alignment="XFPopoverAlignment.Center" Open="_alignCenterOpen" OpenChanged="v => _alignCenterOpen = v">
            <XFTypography Variant="XFTypographyVariant.Body2">@T("Centralizado.", "Centered.")</XFTypography>
        </XFPopover>
        <XFPopover ButtonText="End" Alignment="XFPopoverAlignment.End" Open="_alignEndOpen" OpenChanged="v => _alignEndOpen = v">
            <XFTypography Variant="XFTypographyVariant.Body2">@T("Alinhado ao final.", "Aligned to end.")</XFTypography>
        </XFPopover>
    </XFStack>;

    // === 4. Sizes ===
    private RenderFragment ExSizes() => @<XFStack Orientation="XFOrientation.Horizontal" Gap="3" Wrap="XFWrap.Wrap">
        <XFPopover ButtonText="Sm" Size="XFSize.Sm" Open="_smOpen" OpenChanged="v => _smOpen = v">
            <XFTypography Variant="XFTypographyVariant.Caption">Sm — w-56</XFTypography>
        </XFPopover>
        <XFPopover ButtonText="Md" Size="XFSize.Md" Open="_mdOpen" OpenChanged="v => _mdOpen = v">
            <XFTypography Variant="XFTypographyVariant.Body2">Md — w-72</XFTypography>
        </XFPopover>
        <XFPopover ButtonText="Lg" Size="XFSize.Lg" Open="_lgOpen" OpenChanged="v => _lgOpen = v">
            <XFTypography Variant="XFTypographyVariant.Body1">Lg — w-96</XFTypography>
        </XFPopover>
    </XFStack>;

    // === 5. Custom Trigger ===
    private RenderFragment ExCustomTrigger() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFPopover Open="_customTriggerOpen" OpenChanged="v => _customTriggerOpen = v">
            <Trigger>
                <XFButton Variant="XFButtonVariant.Outline" Color="XFButtonColor.Primary" Size="XFExtendedSize.Sm">
                    @T("Gatilho customizado", "Custom trigger")
                </XFButton>
            </Trigger>
            <ChildContent>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">
                    @T("Este popover usa um gatilho customizado com Trigger template.",
                       "This popover uses a custom trigger with Trigger template.")
                </XFTypography>
            </ChildContent>
        </XFPopover>
    </XFStack>;

    // === 6. Rich Content ===
    private RenderFragment ExRichContent() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFPopover ButtonText="@T("Editar", "Edit")" Size="XFSize.Lg" Open="_richOpen" OpenChanged="v => _richOpen = v">
            <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H6" Weight="XFTypographyWeight.Semibold">@T("Editar registro", "Edit record")</XFTypography>
                <div>
                    <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Nome", "Name")</XFTypography>
                    <input type="text" class="mt-1 block w-full rounded-lg border border-border-light bg-bg-surface px-3 py-2 text-sm" placeholder="@T("Nome completo", "Full name")" />
                </div>
                <XFStack Orientation="XFOrientation.Horizontal" Gap="2">
                    <XFButton Variant="XFButtonVariant.Outline" Color="XFButtonColor.Neutral" Size="XFExtendedSize.Sm">@T("Cancelar", "Cancel")</XFButton>
                    <XFButton Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Sm">@T("Salvar", "Save")</XFButton>
                </XFStack>
            </XFStack>
        </XFPopover>
    </XFStack>;

    // === 7. Focus Trap ===
    private RenderFragment ExFocusTrap() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFPopover ButtonText="@T("Focus trap", "Focus trap")" TrapFocus="true" Open="_focusTrapOpen" OpenChanged="v => _focusTrapOpen = v">
            <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.Body2">
                    @T("O foco está preso neste painel. Tab navega apenas dentro dele.",
                       "Focus is trapped in this panel. Tab navigates only within it.")
                </XFTypography>
                <XFButton Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Sm">@T("Entendido", "Got it")</XFButton>
            </XFStack>
        </XFPopover>
    </XFStack>;

    // === 8. Close Behavior ===
    private RenderFragment ExCloseBehavior() => @<XFStack Orientation="XFOrientation.Horizontal" Gap="3" Wrap="XFWrap.Wrap">
        <XFPopover ButtonText="@T("Escape", "Escape")" CloseOnEscape="true" CloseOnOutsideClick="false" Open="_closeEscapeOpen" OpenChanged="v => _closeEscapeOpen = v">
            <XFTypography Variant="XFTypographyVariant.Body2">@T("Fecha apenas com Escape.", "Closes only with Escape.")</XFTypography>
        </XFPopover>
        <XFPopover ButtonText="@T("Clique externo", "Outside click")" CloseOnEscape="false" CloseOnOutsideClick="true" Open="_closeOutsideOpen" OpenChanged="v => _closeOutsideOpen = v">
            <XFTypography Variant="XFTypographyVariant.Body2">@T("Fecha apenas com clique externo.", "Closes only with outside click.")</XFTypography>
        </XFPopover>
    </XFStack>;

    // === 9. Collision ===
    private RenderFragment ExCollision() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFPopover ButtonText="@T("Collision", "Collision")" CollisionPadding="16" Flip="true" Open="_collisionOpen" OpenChanged="v => _collisionOpen = v">
            <XFTypography Variant="XFTypographyVariant.Body2">
                @T("Este popover tem CollisionPadding=16 e Flip=true para manter-se visível.",
                   "This popover has CollisionPadding=16 and Flip=true to stay visible.")
            </XFTypography>
        </XFPopover>
    </XFStack>;

    // === 10. Enterprise ===
    private RenderFragment ExEnterprise() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <div class="rounded-lg border border-border-light p-4">
            <XFStack Orientation="XFOrientation.Horizontal" Gap="3" AlignItems="XFAlignItems.Center">
                <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@T("Alíquota ICMS", "ICMS Rate")</XFTypography>
                <XFPopover ButtonText="@T("Ajuda", "Help")" Size="XFSize.Lg" Open="_enterpriseOpen" OpenChanged="v => _enterpriseOpen = v">
                    <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H6" Weight="XFTypographyWeight.Semibold">@T("Regras de ICMS", "ICMS Rules")</XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">
                            @T("Operações internas: 18%. Interestadual: 12%. Substituição: conforme UF de destino.",
                               "Internal operations: 18%. Interstate: 12%. Substitution: according to destination state.")
                        </XFTypography>
                        <XFStack Orientation="XFOrientation.Horizontal" Gap="2">
                            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="Art. 155, §2º" />
                            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="ICMS-ST" />
