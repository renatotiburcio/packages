@page "/navigation/toc"
@page "/components/toc"
@using XForge.DesignSystem.Components.Navigation.TOC
@using XForge.DesignSystem.Services
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFTOC" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("WAI-ARIA", "WAI-ARIA")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Marcadores", "Markers")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Enterprise", "Enterprise")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Índice de conteúdo para páginas longas com âncoras e navegação local.",
                               "Table of contents for long pages with anchors and local navigation.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("Navegação vertical e horizontal com marcadores customizáveis (ponto, número, ícone, template), itens ativos, filhos aninhados, itens desabilitados e aria-current.",
                               "Vertical and horizontal navigation with customizable markers (dot, number, icon, template), active items, nested children, disabled items and aria-current.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts)
                            {
                                @Tile(item)
                            }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observações", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estático. Interações requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependências JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente não utiliza JavaScript interop. É puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderização.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visão geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Propósito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando não usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Hierarquia visual", "Visual Hierarchy"), @<div>@TileGrid(VisualHierarchyItems, 3)</div>)
            @Section(T("Princípios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== EXEMPLOS ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Básico vertical", "1. Basic vertical"),
                T("XFTOC com marcador padrão (ponto) e navegação por âncora.",
                 "XFTOC with default marker (dot) and anchor navigation."),
                ExBasicVertical(), CodeBasicVertical)

            @Example(T("2. Horizontal", "2. Horizontal"),
                T("XFTOC com Orientation=Horizontal para navegação em linha.",
                 "XFTOC with Orientation=Horizontal for inline navigation."),
                ExHorizontal(), CodeHorizontal)

            @Example(T("3. Marcador numérico", "3. Number marker"),
                T("Marker=Number exibe números sequenciais. StartNumber controla o início.",
                 "Marker=Number displays sequential numbers. StartNumber controls the start."),
                ExNumberMarker(), CodeNumberMarker)

            @Example(T("4. Marcador de ícone", "4. Icon marker"),
                T("Marker=Icon usa o campo Icon de cada XFTOCItem para exibir ícones SVG.",
                 "Marker=Icon uses the Icon field of each XFTOCItem to display SVG icons."),
                ExIconMarker(), CodeIconMarker)

            @Example(T("5. Sem marcador", "5. No marker"),
                T("Marker=None oculta o marcador, mantendo apenas o texto.",
                 "Marker=None hides the marker, keeping only the text."),
                ExNoMarker(), CodeNoMarker)

            @Example(T("6. Template de marcador", "6. Marker template"),
                T("MarkerTemplate permite renderizar qualquer markup customizado como marcador.",
                 "MarkerTemplate allows rendering any custom markup as a marker."),
                ExMarkerTemplate(), CodeMarkerTemplate)

            @Example(T("7. Template de item", "7. Item template"),
                T("ItemTemplate substitui completamente a renderização padrão do item.",
                 "ItemTemplate completely replaces the default item rendering."),
                ExItemTemplate(), CodeItemTemplate)

            @Example(T("8. Item ativo", "8. Active item"),
                T("ActiveId controla qual item recebe aria-current=location e destaque visual.",
                 "ActiveId controls which item receives aria-current=location and visual highlight."),
                ExActiveItem(), CodeActiveItem)

            @Example(T("9. Filhos aninhados", "9. Nested children"),
                T("Itens com Children renderizam sub-listas indentadas no modo Vertical.",
                 "Items with Children render indented sub-lists in Vertical mode."),
                ExNestedChildren(), CodeNestedChildren)

            @Example(T("10. Itens desabilitados", "10. Disabled items"),
                T("Disabled=true impede clique, adiciona aria-disabled e opacidade reduzida.",
                 "Disabled=true prevents click, adds aria-disabled and reduced opacity."),
                ExDisabledItems(), CodeDisabledItems)

            @Example(T("11. Cenário enterprise", "11. Enterprise scenario"),
                T("XFTOC com marcadores numéricos e ícones em sidebar de documentação.",
                 "XFTOC with number and icon markers in a documentation sidebar."),
                ExEnterprise(), CodeEnterprise)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Variantes", "Variants"), @<div>@NameValueTable(VariantRows, T("Variante", "Variant"), T("Caso de uso", "Use case"))</div>)
            @Section(T("Marcadores", "Markers"), @<div>@NameValueTable(MarkerRows, T("Marcador", "Marker"), T("Descrição", "Description"))</div>)
            @Section(T("Estados", "States"), @<div>@NameValueTable(StateRows, T("Estado", "State"), T("Comportamento", "Behavior"))</div>)
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenários enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padrões de composição", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas práticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padrões", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("Design Tokens", @<div>@NameValueTable(TokenRows, "Token", T("Propósito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Segurança", "Security"), @<div>@TileGrid(SecurityItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidência", "Evidence"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Limitações conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitação", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Notas de migração", "Migration Notes"), @<div>@TileGrid(MigrationItems, 2)</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versão", "Version"), T("Mudança", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>

@code {
    private string ProductLabelText => T("Core Open Source", "Core Open Source");
    private string PageTitleText => T("Table of Contents", "Table of Contents");
    private string PageStatusText => T("Documentação completa", "Complete docs");
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);

    // ==================== HERO ====================
    private RenderFragment HeroPreview() => @<div class="h-64 overflow-hidden rounded-lg border border-border-light bg-bg-surface p-4">
        <XFTOC Items="@HeroItems" ActiveId="getting-started" Title="@T("Nesta página", "On this page")" />
    </div>;

    // ==================== 1. BÁSICO ====================
    private RenderFragment ExBasicVertical() => @<div class="rounded-lg border border-border-light bg-bg-surface p-4">
        <XFTOC Items="@BasicItems" Title="@T("Sumário", "Summary")" />
    </div>;
    private string CodeBasicVertical => @"<XFTOC Items=""@Items"" Title=""Sumário"" />";

    // ==================== 2. HORIZONTAL ====================
    private RenderFragment ExHorizontal() => @<div class="rounded-lg border border-border-light bg-bg-surface p-4">
        <XFTOC Items="@BasicItems" Orientation="XFTOCOrientation.Horizontal" />
    </div>;
    private string CodeHorizontal => @"<XFTOC Items=""@Items""
       Orientation=""XFTOCOrientation.Horizontal"" />";

    // ==================== 3. MARCADOR NUMÉRICO ====================
    private RenderFragment ExNumberMarker() => @<div class="rounded-lg border border-border-light bg-bg-surface p-4">
        <XFTOC Items="@BasicItems" Marker="XFTOCMarker.Number" ActiveId="design" Title="@T("Passos", "Steps")" />
    </div>;
    private string CodeNumberMarker => @"<XFTOC Items=""@Items""
       Marker=""XFTOCMarker.Number""
       ActiveId=""@activeId""
       Title=""Passos"" />";

    // ==================== 4. MARCADOR DE ÍCONE ====================
    private RenderFragment ExIconMarker() => @<div class="rounded-lg border border-border-light bg-bg-surface p-4">
        <XFTOC Items="@IconItems" Marker="XFTOCMarker.Icon" ActiveId="config" Title="@T("Navegação", "Navigation")" />
    </div>;
    private string CodeIconMarker => @"<XFTOC Items=""@Items""
       Marker=""XFTOCMarker.Icon""
       ActiveId=""@activeId""
       Title=""Navegação"" />

@code {
    private IReadOnlyList<XFTOCItem> Items => new[]
    {
        new XFTOCItem { Id = ""inicio"", Text = ""Início"", Icon = ""house"" },
        new XFTOCItem { Id = ""config"", Text = ""Configurações"", Icon = ""gear"" },
        new XFTOCItem { Id = ""ajuda"", Text = ""Ajuda"", Icon = ""circle-question"" }
    };
}";

    // ==================== 5. SEM MARCADOR ====================
    private RenderFragment ExNoMarker() => @<div class="rounded-lg border border-border-light bg-bg-surface p-4">
        <XFTOC Items="@BasicItems" Marker="XFTOCMarker.None" Title="@T("Seções", "Sections")" />
    </div>;
    private string CodeNoMarker => @"<XFTOC Items=""@Items""
       Marker=""XFTOCMarker.None""
       Title=""Seções"" />";

    // ==================== 6. TEMPLATE DE MARCADOR ====================
    private RenderFragment ExMarkerTemplate() => @<div class="rounded-lg border border-border-light bg-bg-surface p-4">
        <XFTOC Items="@BasicItems" ActiveId="design" Title="@T("Custom", "Custom")">
            <MarkerTemplate>
                <span class="inline-flex h-5 w-5 shrink-0 items-center justify-center rounded border border-primary/30 bg-primary/10 text-[10px] font-bold text-primary">
                    @context.Text.Substring(0, 1)
                </span>
            </MarkerTemplate>
        </XFTOC>
    </div>;
    private string CodeMarkerTemplate => @"<XFTOC Items=""@Items"" ActiveId=""@activeId"" Title=""Custom"">
    <MarkerTemplate>
        <span class=""inline-flex h-5 w-5 shrink-0 items-center justify-center
              rounded border border-primary/30 bg-primary/10
              text-[10px] font-bold text-primary"">
            @context.Text[0]
        </span>
    </MarkerTemplate>
</XFTOC>";

    // ==================== 7. TEMPLATE DE ITEM ====================
    private RenderFragment ExItemTemplate() => @<div class="rounded-lg border border-border-light bg-bg-surface p-4">
        <XFTOC Items="@IconItems" ActiveId="config">
            <ItemTemplate>
                <XFStack Orientation="XFOrientation.Horizontal" Gap="2" AlignItems="XFAlignItems.Center">
                    @if (!string.IsNullOrWhiteSpace(context.Icon))
                    {
                        <span class="inline-flex h-4 w-4 shrink-0 items-center justify-center text-xs text-primary" aria-hidden="true">
                            @((MarkupString)XFSvgIcons.MarkupWithSize(context.Icon, 14))
                        </span>
                    }
                    <span class="truncate text-sm">@context.Text</span>
                    @if (context.Disabled)
                    {
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Secondary" Text="Off" />
                    }
                </XFStack>
            </ItemTemplate>
        </XFTOC>
    </div>;
    private string CodeItemTemplate => @"<XFTOC Items=""@Items"" ActiveId=""@activeId"">
    <ItemTemplate>
        <XFStack Orientation=""XFOrientation.Horizontal"" Gap=""2""
                 AlignItems=""XFAlignItems.Center"">
            @if (!string.IsNullOrWhiteSpace(context.Icon))
            {
                <span class=""inline-flex h-4 w-4 shrink-0 items-center justify-center
                      text-xs text-primary"" aria-hidden=""true"">
                    @((MarkupString)XFSvgIcons.MarkupWithSize(context.Icon, 14))
                </span>
            }
            <span class=""truncate text-sm"">@context.Text</span>
            @if (context.Disabled)
            {
                <XFBadge Variant=""XFBadgeVariant.Soft"" Color=""XFBadgeColor.Muted""
                         Text=""Off"" />
            }
        </XFStack>
    </ItemTemplate>
</XFTOC>";

    // ==================== 8. ITEM ATIVO ====================
    private RenderFragment ExActiveItem() => @<div class="rounded-lg border border-border-light bg-bg-surface p-4">
        <XFTOC Items="@BasicItems" ActiveId="design" Marker="XFTOCMarker.Number" Title="@T("Nesta página", "On this page")" />
    </div>;
    private string CodeActiveItem => @"<XFTOC Items=""@Items""
       ActiveId=""@activeId""
       Marker=""XFTOCMarker.Number""
       Title=""Nesta página"" />";

    // ==================== 9. FILHOS ANINHADOS ====================
    private RenderFragment ExNestedChildren() => @<div class="rounded-lg border border-border-light bg-bg-surface p-4">
        <XFTOC Items="@NestedItems" ActiveId="api-params" Marker="XFTOCMarker.Number" Title="@T("Nesta página", "On this page")" />
    </div>;
    private string CodeNestedChildren => @"<XFTOC Items=""@Items""
       ActiveId=""@activeId""
       Marker=""XFTOCMarker.Number"" />

@code {
    private IReadOnlyList<XFTOCItem> Items => new[]
    {
        new XFTOCItem { Id = ""intro"", Text = ""Introdução"" },
        new XFTOCItem
        {
            Id = ""api"",
            Text = ""API"",
            Children = new[]
            {
                new XFTOCItem { Id = ""api-params"", Text = ""Parâmetros"" },
                new XFTOCItem { Id = ""api-events"", Text = ""Eventos"" }
            }
        }
    };
}";

    // ==================== 10. ITENS DESABILITADOS ====================
    private RenderFragment ExDisabledItems() => @<div class="rounded-lg border border-border-light bg-bg-surface p-4">
        <XFTOC Items="@DisabledItems" Marker="XFTOCMarker.Icon" Title="@T("Navegação", "Navigation")" />
    </div>;
    private string CodeDisabledItems => @"<XFTOC Items=""@Items"" Marker=""XFTOCMarker.Icon"" />

@code {
    private IReadOnlyList<XFTOCItem> Items => new[]
    {
        new XFTOCItem { Id = ""ativo"", Text = ""Ativo"", Icon = ""circle-check"" },
        new XFTOCItem { Id = ""bloq"", Text = ""Bloqueado"", Icon = ""lock"", Disabled = true }
    };
}";

    // ==================== 11. ENTERPRISE ====================
    private RenderFragment ExEnterprise() => @<div class="rounded-lg border border-border-light bg-bg-surface p-4">
        <XFStack Orientation="XFOrientation.Horizontal" Gap="4" FullWidth="true">
            <div class="w-64 shrink-0">
                <XFTOC Items="@EnterpriseItems" ActiveId="section-3" Marker="XFTOCMarker.Number" Title="@T("Nesta página", "On this page")" />
            </div>
            <div class="flex-1 space-y-4">
                <div id="section-1" class="rounded-lg border border-border-light bg-white p-4">
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">Seção 1</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">Introdução ao sistema ERP.</XFTypography>
                </div>
                <div id="section-2" class="rounded-lg border border-border-light bg-white p-4">
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">Seção 2</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">Configurações gerais.</XFTypography>
                </div>
                <div id="section-3" class="rounded-lg border border-border-light bg-white p-4">
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">Seção 3</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">Módulo financeiro com subseções.</XFTypography>
                </div>
                <div id="section-4" class="rounded-lg border border-border-light bg-white p-4">
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">Seção 4</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">Módulo fiscal.</XFTypography>
                </div>
                <div id="section-5" class="rounded-lg border border-border-light bg-white p-4">
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">Seção 5</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">Módulo de estoque.</XFTypography>
                </div>
            </div>
        </XFStack>
    </div>;
    private string CodeEnterprise => @"<XFStack Orientation=""XFOrientation.Horizontal"" Gap=""4"" FullWidth=""true"">
    <div class=""w-64 shrink-0"">
        <XFTOC Items=""@Items""
               ActiveId=""@activeSectionId""
               Marker=""XFTOCMarker.Number""
               Title=""Nesta página"" />
    </div>
    <div class=""flex-1 space-y-4"">
        <!-- Seções de conteúdo -->
    </div>
</XFStack>";

    // ==================== HELPERS ====================
    private RenderFragment Section(string title, RenderFragment content) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg"><Header><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography></Header><ChildContent>@content</ChildContent></XFCard>;
    private string CopyableCodeTitle => T("Código copiável", "Copyable code");
    private RenderFragment Example(string title, string description, RenderFragment preview, string codeText) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.None" AreaRestricted="false"><Header><div class="px-6 pt-6 pb-2"><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@description</XFTypography></div></Header><ChildContent><div class="flex flex-col"><div class="border-t border-border-light bg-surface-50/30 p-6">@preview</div><div class="border-t border-border-light bg-surface-50 p-6"><XFCode Text="@codeText" Language="razor" Title="@CopyableCodeTitle" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" /></div></div></ChildContent></XFCard>;
    private RenderFragment Tile(DocTile item) => @<XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true"><div class="flex items-center gap-4"><span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-primary/10 bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span><div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div></div><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography></XFStack></ChildContent></XFCard>;
    private RenderFragment TileGrid(IReadOnlyList<DocTile> items, int columns) => @<XFGrid Cols="1" Md="@Math.Min(columns, 2)" Lg="@columns" Gap="4">@foreach (var item in items) { @Tile(item) }</XFGrid>;
    private RenderFragment WarningGrid(IReadOnlyList<DocTile> items) => @<XFGrid Cols="1" Md="2" Gap="4">@foreach (var item in items) { <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true"><div class="flex items-center gap-4"><span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-danger/10 bg-danger/10 text-danger" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span><div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div></div><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography></XFStack></ChildContent></XFCard> }</XFGrid>;
    private RenderFragment NameValueTable(IReadOnlyList<NameValueRow> rows, string nameHeader, string valueHeader) => @<XFTable Striped="true" Hoverable="true" Compact="true"><XFTableHeader><XFTableRow><XFTableCell Header="true">@nameHeader</XFTableCell><XFTableCell Header="true">@valueHeader</XFTableCell></XFTableRow></XFTableHeader><XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Value</XFTableCell></XFTableRow> }</XFTableBody></XFTable>;
    private RenderFragment ApiTable(IReadOnlyList<ApiRow> rows) => @<XFTable Striped="true" Hoverable="true" Compact="true"><XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Parâmetro", "Parameter")</XFTableCell><XFTableCell Header="true">Type</XFTableCell><XFTableCell Header="true">Default</XFTableCell><XFTableCell Header="true">@T("Descrição", "Description")</XFTableCell></XFTableRow></XFTableHeader><XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Type</XFTableCell><XFTableCell><XFCode Text="@row.DefaultValue" /></XFTableCell><XFTableCell>@row.Description</XFTableCell></XFTableRow> }</XFTableBody></XFTable>;

