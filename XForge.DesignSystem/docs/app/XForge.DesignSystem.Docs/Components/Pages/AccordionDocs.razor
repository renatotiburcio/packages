@page "/components/accordion"
@page "/navigation/accordion"
@using XForge.DesignSystem.Core.Primitives
@using XForge.DesignSystem.Components.Icon
@using XForge.DesignSystem.Services
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFAccordion" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("WAI-ARIA", "WAI-ARIA")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Animações", "Animations")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Enterprise", "Enterprise")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Expandir e recolher conteúdo com semântica, acessibilidade e animação nativas.",
                               "Expand and collapse content with native semantics, accessibility and animation.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("XFAccordion organiza informações em painéis expansíveis com navegação por setas, heading hierarchy configurável, touch target AAA e 5 modos de animação.",
                               "XFAccordion organizes information in expandable panels with arrow key navigation, configurable heading hierarchy, AAA touch target and 5 animation modes.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observações", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estático. Interações requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependências JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente não utiliza JavaScript interop. É puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderização.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Considerações", "Considerations")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor Server: eventos são tratados via SignalR. Sem latência adicional para componentes puramente renderizados.", "Blazor Server: events are handled via SignalR. No additional latency for purely rendered components.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor WebAssembly: eventos são tratados diretamente no cliente. Mais responsivo.", "Blazor WebAssembly: events are handled directly on the client. More responsive.")</XFTypography>
                </XFStack>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visão geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Propósito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando não usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Hierarquia visual", "Visual Hierarchy"), @<div>@TileGrid(VisualHierarchyItems, 3)</div>)
            @Section(T("Princípios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>
        <!-- ===== 12 MANDATORY EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Básico", "1. Basic"),
                T("Accordion simples com três itens ERP: dados do pedido, itens e pagamento.", "Simple accordion with three ERP items: order data, items and payment."),
                ExBasic(), CodeBasic)

            @Example(T("2. Tamanhos", "2. Sizes"),
                T("Sm, Md e Lg - todos com touch target 44px minimo (WCAG 2.5.8 AAA).", "Sm, Md and Lg - all with 44px minimum touch target (WCAG 2.5.8 AAA)."),
                ExSizes(), CodeSizes)

            @Example(T("3. Variantes", "3. Variants"),
                T("Todas as variantes visuais: Surface, Soft, Outline e Ghost.", "All visual variants: Surface, Soft, Outline and Ghost."),
                ExVariants(), CodeVariants)

            @Example(T("4. Animações", "4. Animations"),
                T("5 modos de animação: None, Height, HeightFade, SlideFade e ScaleFade.", "5 animation modes: None, Height, HeightFade, SlideFade and ScaleFade."),
                ExAnimations(), CodeAnimations)

            @Example(T("5. Icon modes", "5. Icon modes"),
                T("Chevron, PlusMinus e None com StartIcon.", "Chevron, PlusMinus and None with StartIcon."),
                ExIconModes(), CodeIconModes)

            @Example(T("6. Comportamento", "6. Behavior"),
                T("Multiple=true, Collapsible=false e itens desabilitados em contexto ERP.", "Multiple=true, Collapsible=false and disabled items in ERP context."),
                ExBehavior(), CodeBehavior)

            @Example(T("7. Templates", "7. Templates"),
                T("Header template, StartIcon, Description e EndContent com badge de contagem.", "Header template, StartIcon, Description and EndContent with count badge."),
                ExTemplates(), CodeTemplates)

            @Example(T("8. Lazy + KeepAlive", "8. Lazy + KeepAlive"),
                T("Lazy=true renderiza na primeira expansao; KeepAlive=false destroi ao recolher.", "Lazy=true renders on first expansion; KeepAlive=false destroys on collapse."),
                ExLazy(), CodeLazy)

            @Example(T("9. Feature toggles", "9. Feature toggles"),
                T("StaggerContent=true com animação progressiva nos filhos.", "StaggerContent=true with progressive animation on children."),
                ExStagger(), CodeStagger)

            @Example(T("10. Responsivo", "10. Responsive"),
                T("Accordion dentro de XFCard e em container estreito. Padroes mobile-friendly.", "Accordion inside XFCard and narrow container. Mobile-friendly patterns."),
                ExResponsive(), CodeResponsive)

            @Example(T("11. Cenario enterprise", "11. Enterprise scenario"),
                T("Fluxo completo de aprovacao de NF-e com dados realistas do ERP.", "Complete NF-e approval workflow with realistic ERP data."),
                ExEnterprise(), CodeEnterprise)

            @Example(T("12. Heading hierarchy", "12. Heading hierarchy"),
                T("HeadingLevel para hierarquia de documento correta dentro de secoes h2.", "HeadingLevel for correct document hierarchy inside h2 sections."),
                ExHeading(), CodeHeading)
        </XFStack>
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Variantes", "Variants"), @<div>@NameValueTable(VariantRows, T("Variante", "Variant"), T("Caso de uso", "Use case"))</div>)
            @Section(T("Estados", "States"), @<div>@NameValueTable(StateRows, T("Estado", "State"), T("Comportamento", "Behavior"))</div>)
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("API do XFAccordionItem", "XFAccordionItem API"), @<div>@ApiTable(ItemApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Métodos", "Methods"), @<div>@NameValueTable(MethodRows, T("Método", "Method"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Navegação enterprise por teclado", "Enterprise Keyboard Navigation"), @<div>@TileGrid(EnterpriseKeyboardItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenários enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padrões de composição", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas práticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padrões", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Propósito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Segurança", "Security Considerations"), @<div>@TileGrid(SecurityItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Limitações conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitação", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Notas de migração", "Migration Notes"), @<div>@TileGrid(MigrationItems, 2)</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versão", "Version"), T("Mudança", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string ProductLabelText => T("Core Open Source", "Core Open Source");
    private string PageTitleText => T("Accordion", "Accordion");
    private string PageStatusText => T("Documentacao completa", "Complete docs");
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");

    // --- Hero ---
    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFAccordion Size="XFSize.Md" Variant="XFAccordionVariant.Surface">
            <XFAccordionItem Title="@T("Dados do pedido #4821", "Order data #4821")" Expanded="true">
                <StartIcon>@((MarkupString)XFSvgIcons.MarkupWithSize("file-invoice", 16))</StartIcon>
                <ChildContent>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">
                        @T("Cliente: Silva Comercio LTDA | Emissao: 15/05/2026 | Valor: R$ 12.450,00", "Customer: Silva Commerce Ltd | Date: 05/15/2026 | Amount: R$ 12,450.00")
                    </XFTypography>
                </ChildContent>
            </XFAccordionItem>
            <XFAccordionItem Title="@T("Itens do pedido", "Order items")">
                <StartIcon>@((MarkupString)XFSvgIcons.MarkupWithSize("list", 16))</StartIcon>
                <ChildContent>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">
                        @T("3 itens: Notebook Dell (2), Monitor LG (5), Teclado Mecanico (10).", "3 items: Dell Notebook (2), LG Monitor (5), Mechanical Keyboard (10).")
                    </XFTypography>
                </ChildContent>
            </XFAccordionItem>
            <XFAccordionItem Title="@T("Pagamento", "Payment")">
                <StartIcon>@((MarkupString)XFSvgIcons.MarkupWithSize("credit-card", 16))</StartIcon>
                <ChildContent>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">
                        @T("Boleto 30/60/90 dias. Juros 1.5% a.m. apos vencimento.", "Boleto 30/60/90 days. 1.5% monthly interest after due date.")
                    </XFTypography>
                </ChildContent>
            </XFAccordionItem>
        </XFAccordion>
    </XFStack>;    // --- 1. Basic ---
    private RenderFragment ExBasic() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFAccordion Size="XFSize.Md">
            <XFAccordionItem Title="@T("Dados do pedido", "Order data")" Expanded="true">
                <ChildContent><XFTypography Variant="XFTypographyVariant.Body2">@T("Informacoes gerais do pedido, cliente e endereco de entrega.", "General order information, customer and delivery address.")</XFTypography></ChildContent>
            </XFAccordionItem>
            <XFAccordionItem Title="@T("Itens do pedido", "Order items")">
                <ChildContent><XFTypography Variant="XFTypographyVariant.Body2">@T("Lista de produtos, quantidades e precos unitarios.", "Product list, quantities and unit prices.")</XFTypography></ChildContent>
            </XFAccordionItem>
            <XFAccordionItem Title="@T("Pagamento", "Payment")">
                <ChildContent><XFTypography Variant="XFTypographyVariant.Body2">@T("Forma de pagamento, parcelas e condicoes especiais.", "Payment method, installments and special conditions.")</XFTypography></ChildContent>
            </XFAccordionItem>
        </XFAccordion>
    </XFStack>;

    // --- 2. Sizes ---
    private RenderFragment ExSizes() => @<XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
        <div class="flex flex-col gap-2">
            <div class="flex items-center gap-2">
                <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="Sm" />
                <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Compacto - min-h 44px, px-3, py-2, text-sm.", "Compact - min-h 44px, px-3, py-2, text-sm.")</XFTypography>
            </div>
            <XFAccordion Size="XFSize.Sm">
                <XFAccordionItem Title="@T("Touch target 44px minimo", "Touch target 44px minimum")" Expanded="true">
                    <ChildContent><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("WCAG 2.5.8 AAA: todos os tamanhos respeitam 44px.", "WCAG 2.5.8 AAA: all sizes respect 44px.")</XFTypography></ChildContent>
                </XFAccordionItem>
            </XFAccordion>
        </div>
        <div class="flex flex-col gap-2">
            <div class="flex items-center gap-2">
                <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="Md" />
                <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Padrao - min-h 44px, px-4, py-3, text-sm.", "Default - min-h 44px, px-4, py-3, text-sm.")</XFTypography>
            </div>
            <XFAccordion Size="XFSize.Md">
                <XFAccordionItem Title="@T("Touch target 44px minimo", "Touch target 44px minimum")" Expanded="true">
                    <ChildContent><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Tamanho padrao para maioria dos cenários ERP.", "Default size for most ERP scenários.")</XFTypography></ChildContent>
                </XFAccordionItem>
            </XFAccordion>
        </div>
        <div class="flex flex-col gap-2">
            <div class="flex items-center gap-2">
                <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="Lg" />
                <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Touch-first - min-h 52px, px-5, py-4, text-base.", "Touch-first - min-h 52px, px-5, py-4, text-base.")</XFTypography>
            </div>
            <XFAccordion Size="XFSize.Lg">
                <XFAccordionItem Title="@T("Touch target 52px", "Touch target 52px")" Expanded="true">
                    <ChildContent><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Para tablets, kiosks e telas de ponto de venda.", "For tablets, kiosks and POS screens.")</XFTypography></ChildContent>
                </XFAccordionItem>
            </XFAccordion>
        </div>
    </XFStack>;    // --- 3. Variants ---
    private RenderFragment ExVariants() => @<XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
        @foreach (var variant in Enum.GetValues<XFAccordionVariant>())
        {
            <div>
                <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@variant</XFTypography>
                <XFAccordion Size="XFSize.Md" Variant="@variant" Class="mt-1">
                    <XFAccordionItem Title="@($"{variant} - {T("Item 1", "Item 1")}")" Expanded="true">
                        <ChildContent><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Conteudo do primeiro item.", "First item content.")</XFTypography></ChildContent>
                    </XFAccordionItem>
                    <XFAccordionItem Title="@($"{variant} - {T("Item 2", "Item 2")}")">
                        <ChildContent><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Conteudo do segundo item.", "Second item content.")</XFTypography></ChildContent>
                    </XFAccordionItem>
                </XFAccordion>
            </div>
        }
    </XFStack>;

    // --- 4. Animations ---
    private RenderFragment ExAnimations() => @<XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
        @foreach (var animation in Enum.GetValues<XFAccordionAnimation>())
        {
            <div>
                <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@animation.ToString()" />
                <XFAccordion Size="XFSize.Md" Animation="@animation" Class="mt-1">
                    <XFAccordionItem Title="@($"{animation} - {T("Expansao", "Expand")}")" Expanded="true">
                        <ChildContent><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Animacao ativa: ", "Active animation: ")@animation</XFTypography></ChildContent>
                    </XFAccordionItem>
                    <XFAccordionItem Title="@($"{animation} - {T("Segundo item", "Second item")}")">
                        <ChildContent><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Conteudo do segundo painel.", "Second panel content.")</XFTypography></ChildContent>
                    </XFAccordionItem>
                </XFAccordion>
            </div>
        }
    </XFStack>;    // --- 5. Icon Modes ---
    private RenderFragment ExIconModes() => @<XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
        @foreach (var mode in Enum.GetValues<XFAccordionIconMode>())
        {
            <div>
                <div class="flex items-center gap-2 mb-1">
                    <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@mode.ToString()" />
                    <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@IconModeDesc(mode)</XFTypography>
                </div>
                <XFAccordion Size="XFSize.Md" IconMode="@mode">
                    <XFAccordionItem Title="@T("Vendas do mes", "Monthly sales")">
                        <StartIcon>@((MarkupString)XFSvgIcons.MarkupWithSize("chart-line-up", 16))</StartIcon>
                        <ChildContent><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Sudeste: R$ 245k | Sul: R$ 132k | Nordeste: R$ 89k.", "SE: R$ 245k | S: R$ 132k | NE: R$ 89k.")</XFTypography></ChildContent>
                    </XFAccordionItem>
                    <XFAccordionItem Title="@T("Pendencias", "Pending items")">
                        <StartIcon>@((MarkupString)XFSvgIcons.MarkupWithSize("clock", 16))</StartIcon>
                        <ChildContent><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("12 notas aguardando aprovacao.", "12 invoices awaiting approval.")</XFTypography></ChildContent>
                    </XFAccordionItem>
                </XFAccordion>
            </div>
        }
    </XFStack>;
    private string IconModeDesc(XFAccordionIconMode m) => m switch {
        XFAccordionIconMode.Chevron => T("Seta rotaciona 180 graus.", "Arrow rotates 180 degrees."),
        XFAccordionIconMode.PlusMinus => T("Alterna entre + e -.", "Toggles between + and -."),
        XFAccordionIconMode.None => T("Sem icone de expansao.", "No expand icon."),
        _ => ""
    };

    // --- 6. Behavior ---
    private RenderFragment ExBehavior() => @<XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
        <div>
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="Multiple=true" />
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted" Class="mb-1">@T("Multiplas secoes abertas simultaneamente.", "Multiple sections open simultaneously.")</XFTypography>
            <XFAccordion Size="XFSize.Md" Multiple="true">
                <XFAccordionItem Title="@T("Financeiro", "Finance")" Expanded="true">
                    <ChildContent><XFTypography Variant="XFTypographyVariant.Body2">@T("Relatorios de receita, despesa e fluxo de caixa.", "Revenue, expense and cash flow reports.")</XFTypography></ChildContent>
