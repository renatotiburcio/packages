    private string NavItemsCode => T("""
<XFSidebar>
    <Header>
        <XFTypography Weight="Bold">Fiscal</XFTypography>
        <span class="inline-flex h-5 items-center rounded-full bg-danger/10 px-2 text-xs font-medium text-danger">3</span>
    </Header>
    <ChildContent>
