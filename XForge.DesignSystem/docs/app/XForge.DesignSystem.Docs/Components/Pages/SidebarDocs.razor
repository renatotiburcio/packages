@page "/layout/sidebar"
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        @* ==================== HEADER ==================== *@
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFSidebar" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Navegação contextual", "Contextual navigation")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Shell slot", "Shell slot")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Três variantes", "Three variants")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Navegação contextual do app ativo, com seções e itens hierárquicos.",
                               "Contextual navigation of the active app, with sections and hierarchical items.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("XFSidebar é o painel lateral do shell enterprise que mostra a navegação do app ativo. Ele suporta variantes Persistent, Mini e Drawer, com slots para cabeçalho, conteúdo e rodapé, e controla Expanded para retrair ou expandir.",
                               "XFSidebar is the enterprise shell side panel that shows the active app navigation. It supports Persistent, Mini and Drawer variants, with header, content and footer slots, and controls Expanded to collapse or expand.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">@HeroPreview()</div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">@foreach (var item in QuickFacts) { @Tile(item) }</XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @* ==================== 1. METADATA ==================== *@
        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @* ==================== 2. BLAZOR SERVER / WASM ==================== *@
        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observações", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições. Transições de Expanded via CSS.", "Works without restrictions. Expanded transitions via CSS.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições em ambos os modos.", "Works without restrictions in both modes.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estático. Interações requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependências JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente não utiliza JavaScript interop. É puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderização.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Considerações", "Considerations")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor Server: Expanded/Collapsed e animações de transição (duration-300) funcionam via CSS sem latência.", "Blazor Server: Expanded/Collapsed and transition animations (duration-300) work via CSS without latency.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor WebAssembly: mesmo comportamento. Sem diferença perceptível entre modos.", "Blazor WebAssembly: same behavior. No noticeable difference between modes.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Variant Drawer: posicionamento fixed funciona identicamente em ambos os modos.", "Drawer variant: fixed positioning works identically in both modes.")</XFTypography>
                </XFStack>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Exemplos de uso", "Usage Examples")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFCode Text="@InteractiveServerExample" Language="razor" Title="InteractiveServer" Variant="XFCodeVariant.Block" Copyable="true" />
                    <XFCode Text="@InteractiveWasmExample" Language="razor" Title="InteractiveWebAssembly" Variant="XFCodeVariant.Block" Copyable="true" />
                    <XFCode Text="@InteractiveAutoExample" Language="razor" Title="InteractiveAuto" Variant="XFCodeVariant.Block" Copyable="true" />
                </XFStack>
            </XFStack>
        </div>)

        @* ==================== 3. OVERVIEW ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visão geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Propósito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando não usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 2)</div>)
        </XFStack>

        @* ==================== 4. VARIANTS & STATES ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Variantes", "Variants"), @<div>@NameValueTable(VariantRows, T("Variante", "Variant"), T("Caso de uso", "Use case"))</div>)
            @Section(T("Estados", "States"), @<div>@NameValueTable(StateRows, T("Estado", "State"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        @* ==================== 5. VISUAL HIERARCHY & DESIGN ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Hierarquia visual", "Visual Hierarchy"), @<div>@TileGrid(VisualHierarchyItems, 3)</div>)
            @Section(T("Princípios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        @* ==================== 6-14. EXAMPLES ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Sidebar básica Persistent", "1. Basic Persistent sidebar"),
                T("Sidebar com cabeçalho, navegação e rodapé.", "Sidebar with header, navigation and footer."),
                BasicPreview(), BasicCode)

            @Example(T("2. Sidebar com navegação", "2. Sidebar with navigation"),
                T("Itens de navegação interativos com ícones.", "Interactive navigation items with icons."),
                NavItemsPreview(), NavItemsCode)

            @Example(T("3. Sidebar Expanded=false", "3. Sidebar Expanded=false"),
                T("Sidebar retraída com apenas o cabeçalho visível.", "Collapsed sidebar with only the header visible."),
                CollapsedPreview(), CollapsedCode)

            @Example(T("4. Sidebar Variant Mini", "4. Sidebar Variant Mini"),
                T("Modo compacto com apenas ícones (20rem de largura).", "Compact mode with icons only (20rem width)."),
                MiniPreview(), MiniCode)

            @Example(T("5. Sidebar Variant Drawer", "5. Sidebar Variant Drawer"),
                T("Drawer sobreposto com ContainerRelative para conteúdo.", "Overlay drawer with ContainerRelative for content."),
                DrawerPreview(), DrawerCode)

            @Example(T("6. Sidebar com Footer de ações", "6. Sidebar with action footer"),
                T("Rodapé com botões de ação e informações.", "Footer with action buttons and info."),
                FooterPreview(), FooterCode)

            @Example(T("7. Sidebar com AriaLabel customizado", "7. Sidebar with custom AriaLabel"),
                T("Nome acessível personalizado para a navegação.", "Custom accessible name for navigation."),
                AriaLabelPreview(), AriaLabelCode)

            @Example(T("8. Sidebar com ContainerRelative", "8. Sidebar with ContainerRelative"),
                T("Drawer posicionado relative ao container pai.", "Drawer positioned relative to parent container."),
                ContainerRelativePreview(), ContainerRelativeCode)

            @Example(T("9. Sidebar enterprise completa", "9. Complete enterprise sidebar"),
                T("Sidebar completa no XFAppShell com todas as variantes.", "Full sidebar in XFAppShell with all variants."),
                EnterprisePreview(), EnterpriseCode)
        </XFStack>

        @* ==================== 16. API ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Métodos", "Methods"), @<div>@NameValueTable(MethodRows, T("Método", "Method"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        @* ==================== 17. ACCESSIBILITY & KEYBOARD ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Navegação enterprise por teclado", "Enterprise Keyboard Navigation"), @<div>@TileGrid(EnterpriseKeyboardItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        @* ==================== 18. RESPONSIVENESS & PERFORMANCE ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        @* ==================== 19. ENTERPRISE SCENARIOS & PATTERNS ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenários enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padrões de composição", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Exemplos de integração", "Integration Examples"), @<div>@TileGrid(IntegrationItems, 2)</div>)
            @Section(T("Boas práticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padrões", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        @* ==================== 20. TOKENS, THEMING, SECURITY, TESTING ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("Design Tokens", @<div>@NameValueTable(TokenRows, "Token", T("Propósito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Segurança", "Security Considerations"), @<div>@TileGrid(SecurityItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidência", "Evidence"))</div>)
        </XFStack>

        @* ==================== EXTRA: LIMITATIONS, MIGRATION, RELATED, FAQ, CHANGELOG ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Limitações conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitação", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Notas de migração", "Migration Notes"), @<div>@TileGrid(MigrationItems, 2)</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versão", "Version"), T("Mudança", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string ProductLabelText => T("Core Open Source", "Core Open Source");
    private string PageTitleText => T("Sidebar", "Sidebar");
    private string PageStatusText => T("Documentação completa", "Complete docs");
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);

    // ==================== BLAZOR SECTION EXAMPLES ====================
    private string InteractiveServerExample => @"@page ""/erp/financeiro/dashboard""
@rendermode InteractiveServer
<XFSidebar>
    <Header><XFTypography Weight=""Bold"">Financeiro</XFTypography></Header>
    <ChildContent>
        <div class=""px-3 py-2"">Dashboard</div>
        <div class=""px-3 py-2"">Contas a pagar</div>
    </ChildContent>
</XFSidebar>";

    private string InteractiveWasmExample => @"@page ""/erp/financeiro/dashboard""
@rendermode InteractiveWebAssembly
<XFSidebar>
    <Header><XFTypography Weight=""Bold"">Financeiro</XFTypography></Header>
    <ChildContent>
        <div class=""px-3 py-2"">Dashboard</div>
        <div class=""px-3 py-2"">Contas a pagar</div>
    </ChildContent>
</XFSidebar>";

    private string InteractiveAutoExample => @"@page ""/erp/financeiro/dashboard""
@rendermode InteractiveAuto
<XFSidebar>
    <Header><XFTypography Weight=""Bold"">Financeiro</XFTypography></Header>
    <ChildContent>
        <div class=""px-3 py-2"">Dashboard</div>
        <div class=""px-3 py-2"">Contas a pagar</div>
    </ChildContent>
</XFSidebar>";

    // ==================== HERO PREVIEW ====================
    private RenderFragment HeroPreview() => @<div class="h-72 w-56 border-r border-border-light bg-bg-surface">
        <div class="h-12 border-b border-border-light px-4 flex items-center"><XFTypography Weight="XFTypographyWeight.Bold">@T("Financeiro", "Finance")</XFTypography></div>
        <div class="p-3 text-sm"><div class="rounded bg-primary/10 px-3 py-2 text-primary font-semibold mb-1">@T("Dashboard", "Dashboard")</div><div class="px-3 py-2 text-text-secondary">@T("Contas a pagar", "Accounts payable")</div><div class="px-3 py-2 text-text-secondary">@T("Contas a receber", "Accounts receivable")</div><div class="px-3 py-2 text-text-secondary">@T("Conciliação", "Reconciliation")</div></div>
    </div>;

    // ==================== EXAMPLE PREVIEWS ====================
    private RenderFragment BasicPreview() => @<div class="h-56 w-60 border-r border-border-light bg-bg-surface flex flex-col">
        <div class="h-12 border-b border-border-light px-4 flex items-center"><XFTypography Weight="XFTypographyWeight.Bold">@T("Financeiro", "Finance")</XFTypography></div>
        <div class="flex-1 p-3 text-sm"><div class="px-3 py-2 text-text-secondary">@T("Dashboard", "Dashboard")</div><div class="px-3 py-2 text-text-secondary">@T("Contas a pagar", "Accounts payable")</div><div class="px-3 py-2 text-text-secondary">@T("Contas a receber", "Accounts receivable")</div></div>
        <div class="p-3 border-t border-border-light text-xs text-text-secondary">@T("v2.4.0", "v2.4.0")</div>
    </div>;

    private RenderFragment NavItemsPreview() => @<div class="h-56 w-60 border-r border-border-light bg-bg-surface flex flex-col">
        <div class="h-12 border-b border-border-light px-4 flex items-center gap-2"><XFTypography Weight="XFTypographyWeight.Bold">@T("Fiscal", "Tax")</XFTypography><span class="inline-flex h-5 items-center rounded-full bg-danger/10 px-2 text-xs font-medium text-danger">3</span></div>
        <div class="flex-1 p-3 text-sm"><div class="rounded bg-primary/10 px-3 py-2 text-primary font-semibold mb-1">@T("NF-e emitidas", "Invoices issued")</div><div class="px-3 py-2 text-text-secondary">@T("SPED Fiscal", "SPED Tax")</div><div class="px-3 py-2 text-text-secondary">@T("Obrigações acessórias", "Ancillary obligations")</div></div>
    </div>;

    private RenderFragment CollapsedPreview() => @<div class="h-56 w-60 border-r border-border-light bg-bg-surface flex flex-col">
        <div class="h-12 border-b border-border-light px-4 flex items-center"><XFTypography Weight="XFTypographyWeight.Bold">@T("Financeiro", "Finance")</XFTypography></div>
    </div>;

    private RenderFragment MiniPreview() => @<div class="h-56 w-20 border-r border-border-light bg-bg-surface flex flex-col items-center pt-4 gap-4">
        <div class="h-10 w-10 rounded-lg bg-primary/10 flex items-center justify-center text-primary"><span class="text-lg">D</span></div>
        <div class="h-10 w-10 rounded-lg bg-surface-100 flex items-center justify-center text-text-secondary"><span class="text-lg">P</span></div>
        <div class="h-10 w-10 rounded-lg bg-surface-100 flex items-center justify-center text-text-secondary"><span class="text-lg">R</span></div>
    </div>;

    private RenderFragment DrawerPreview() => @<div class="h-56 w-60 border border-border-light bg-bg-surface shadow-2xl flex flex-col relative">
        <div class="h-12 border-b border-border-light px-4 flex items-center"><XFTypography Weight="XFTypographyWeight.Bold">@T("Drawer", "Drawer")</XFTypography></div>
        <div class="flex-1 p-3 text-sm"><div class="px-3 py-2 text-text-secondary">@T("Item 1", "Item 1")</div><div class="px-3 py-2 text-text-secondary">@T("Item 2", "Item 2")</div><div class="px-3 py-2 text-text-secondary">@T("Item 3", "Item 3")</div></div>
    </div>;

    private RenderFragment FooterPreview() => @<div class="h-64 w-60 border-r border-border-light bg-bg-surface flex flex-col">
        <div class="h-12 border-b border-border-light px-4 flex items-center"><XFTypography Weight="XFTypographyWeight.Bold">@T("Estoque", "Inventory")</XFTypography></div>
        <div class="flex-1 p-3 text-sm"><div class="px-3 py-2 text-text-secondary">@T("Produtos", "Products")</div><div class="px-3 py-2 text-text-secondary">@T("Movimentações", "Movements")</div></div>
        <div class="p-3 border-t border-border-light text-xs flex justify-between"><span class="text-text-secondary">@T("Última atualização:", "Last update:")</span><span class="text-text-primary font-medium">@T("10/06 14:30", "06/10 2:30 PM")</span></div>
    </div>;

    private RenderFragment AriaLabelPreview() => @<div class="h-48 w-60 border-r border-border-light bg-bg-surface flex flex-col">
        <div class="h-12 border-b border-border-light px-4 flex items-center"><XFTypography Weight="XFTypographyWeight.Bold">@T("Configurações", "Settings")</XFTypography></div>
        <div class="flex-1 p-3 text-sm"><div class="px-3 py-2 text-text-secondary">@T("Perfil", "Profile")</div><div class="px-3 py-2 text-text-secondary">@T("Preferências", "Preferences")</div></div>
    </div>;

    private RenderFragment ContainerRelativePreview() => @<div class="h-48 w-60 border border-border-light bg-bg-surface shadow-lg flex flex-col relative">
        <div class="h-12 border-b border-border-light px-4 flex items-center"><XFTypography Weight="XFTypographyWeight.Bold">@T("Drawer relativo", "Relative drawer")</XFTypography></div>
        <div class="flex-1 p-3 text-sm"><div class="px-3 py-2 text-text-secondary">@T("Conteúdo do drawer.", "Drawer content.")</div></div>
    </div>;

    private RenderFragment EnterprisePreview() => @<div class="h-80 w-60 border-r border-border-light bg-bg-surface flex flex-col">
        <div class="h-12 border-b border-border-light px-4 flex items-center justify-between"><XFTypography Weight="XFTypographyWeight.Bold">@T("Financeiro", "Finance")</XFTypography><span class="text-xs text-text-secondary">@T("Expandido", "Expanded")</span></div>
        <div class="flex-1 p-3 text-sm">
            <div class="flex items-center justify-between rounded bg-primary/10 px-3 py-2 text-primary font-semibold mb-1"><span>@T("Dashboard", "Dashboard")</span><span class="inline-flex h-5 items-center rounded-full bg-primary/10 px-2 text-xs">12</span></div>
            <div class="flex items-center justify-between px-3 py-2 text-text-secondary"><span>@T("Contas a pagar", "Accounts payable")</span><span class="inline-flex h-5 items-center rounded-full bg-danger/10 px-2 text-xs text-danger">4</span></div>
            <div class="flex items-center justify-between px-3 py-2 text-text-secondary"><span>@T("Contas a receber", "Accounts receivable")</span><span class="text-xs text-text-secondary">R$ 256k</span></div>
            <div class="px-3 py-2 text-text-secondary">@T("Conciliação", "Reconciliation")</div>
        </div>
        <div class="p-3 border-t border-border-light text-xs text-text-secondary">@T("Usuário: João Silva • Financeiro", "User: John Doe • Finance")</div>
    </div>;

    // ==================== CODE STRINGS ====================
    private string BasicCode => T("""
<XFSidebar>
    <Header>
        <XFTypography Weight="Bold">Financeiro</XFTypography>
    </Header>
    <ChildContent>
        <div class="px-3 py-2">Dashboard</div>
        <div class="px-3 py-2">Contas a pagar</div>
        <div class="px-3 py-2">Contas a receber</div>
    </ChildContent>
    <Footer>
        <span class="text-xs text-text-secondary">v2.4.0</span>
