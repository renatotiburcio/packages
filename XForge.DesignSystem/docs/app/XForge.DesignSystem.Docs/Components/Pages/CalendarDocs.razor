        <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">
            @T("Datas selecionadas: ", "Selected dates: ") @string.Join(", ", rangeDates.Select(d => d.ToString("dd/MM")))
        </XFTypography>
    </div>;

