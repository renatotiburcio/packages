    private string CodeDayTemplate =>
        "<XFCalendar Highlights=\"Highlights\">" + "\n" +
        "    <DayTemplate Context=\"ctx\">" + "\n" +
        "        <span class=\"font-semibold\">@ctx.Date.Day</span>" + "\n" +
        "        @if (ctx.Highlights.Count > 0)" + "\n" +
        "        {" + "\n" +
        "            <span class=\"flex gap-0.5\">" + "\n" +
        "                @foreach (var h in ctx.Highlights.Take(2))" + "\n" +
        "                {" + "\n" +
        "                    <span class=\"h-1 w-1 rounded-full" + "\n" +
        "                      @(ctx.IsSelected ? \"bg-white\" : \"bg-primary\")\">" + "\n" +
        "                    </span>" + "\n" +
        "                }" + "\n" +
        "            </span>" + "\n" +
        "        }" + "\n" +
        "    </DayTemplate>" + "\n" +
        "</XFCalendar>";

    private string CodeCulture =>
        "<!-- Portuguese (Brazil) -->" + "\n" +
        "<XFCalendar Culture=\"@(new CultureInfo(\\\"pt-BR\\\"))\"" + "\n" +
