@page "/display/calendar"
@using XForge.DesignSystem.Components.DataDisplay.Calendar
@using XForge.DesignSystem.Core.Primitives
@using XForge.DesignSystem.Components.Shared
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="Core OSS"
                 Title="Calendar"
                 Status="Premium"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">

        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFCalendar" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("3 Views", "3 Views")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Enterprise", "Enterprise")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Calendario acessivel para selecao de datas, agendas operacionais e datas destacadas.", "Accessible calendar for date selection, operational agendas and highlighted dates.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("3 views (month, week, day), 3 sizes, 3 variants, constrained dates, disabled dates, highlighted dates, day templates, culture e FirstDayOfWeek.",
                               "3 views (month, week, day), 3 sizes, 3 variants, constrained dates, disabled dates, highlighted dates, day templates, culture and FirstDayOfWeek.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico. Interacoes requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderizacao.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Consideracoes", "Considerations")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor Server: eventos sao tratados via SignalR. Sem latencia adicional para componentes puramente renderizados.", "Blazor Server: events are handled via SignalR. No additional latency for purely rendered components.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor WebAssembly: eventos sao tratados diretamente no cliente. Mais responsivo.", "Blazor WebAssembly: events are handled directly on the client. More responsive.")</XFTypography>
                </XFStack>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Basico", "1. Basic"),
                T("Calendario mensal padrao com selecao de data.", "Default monthly calendar with date selection."),
                ExBasic(), CodeBasic)

            @Example(T("2. Tamanhos", "2. Sizes"),
                T("Sm, Md e Lg — larguras progressivas.", "Sm, Md and Lg — progressive widths."),
                ExSizes(), CodeSizes)

            @Example(T("3. Variantes", "3. Variants"),
                T("Surface, Soft e Plain — diferentes niveis de destaque.", "Surface, Soft and Plain — different emphasis levels."),
                ExVariants(), CodeVariants)

            @Example(T("4. Vista diaria", "4. Day View"),
                T("Foco em um unico dia — ideal para agendas.", "Focus on a single day — ideal for schedules."),
                ExDayView(), CodeDayView)

            @Example(T("5. Vista semanal", "5. Week View"),
                T("Visualizacao de 7 dias com cards por dia.", "7-day view with per-day cards."),
                ExWeekView(), CodeWeekView)

            @Example(T("6. Restricao de datas", "6. Date Constraints"),
                T("Min/Max para limitar intervalo e DisabledDate para datas especificas.", "Min/Max to limit range and DisabledDate for specific dates."),
                ExConstraints(), CodeConstraints)

            @Example(T("7. Datas destacadas", "7. Highlighted Dates"),
                T("HighlightedDates para marcar eventos e reunioes.", "HighlightedDates to mark events and meetings."),
                ExHighlighted(), CodeHighlighted)

            @Example(T("8. DayTemplate customizado", "8. Custom DayTemplate"),
                T("RenderFragment<XFCalendarDayContext> para markup rico em cada dia.", "RenderFragment<XFCalendarDayContext> for rich markup in each day."),
                ExDayTemplate(), CodeDayTemplate)

            @Example(T("9. Cultura e FirstDayOfWeek", "9. Culture & FirstDayOfWeek"),
                T("Localizacao e primeiro dia da semana configuravel.", "Localization and configurable first day of week."),
                ExCulture(), CodeCulture)

            @Example(T("10. Bind completo", "10. Full Bind"),
                T("Value + DisplayDate + Change com feedback em tempo real.", "Value + DisplayDate + Change with real-time feedback."),
                ExFullBind(), CodeFullBind)

            @Example(T("11. Selecao por intervalo", "11. Range Selection"),
                T("Selecione um intervalo de datas com arrastar o mouse.", "Select a date range by dragging the mouse."),
                ExRange(), CodeRange)

            @Example(T("12. Multipla selecao", "12. Multiple Selection"),
                T("Selecione multiplas datas clicando.", "Select multiple dates by clicking."),
                ExMultiple(), CodeMultiple)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>

    </XFStack>
</XForgeDocsShell>

@code {
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);
    private string CopyableCodeTitle => T("Copiar codigo", "Copy code");

    // State
    private DateOnly heroDate = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly basicDate = new(2026, 6, 15);
    private DateOnly basicDisplay = new(2026, 6, 1);
    private DateOnly sizeSmDate = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly sizeMdDate = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly sizeLgDate = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly variantSurfaceDate = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly variantSoftDate = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly variantPlainDate = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly dayViewDate = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly dayDisplayDate = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly weekViewDate = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly weekDisplayDate = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly constraintDate = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly highlightedDate = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly templateDate = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly culturePtDate = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly cultureEnDate = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly cultureJpDate = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly fullBindDate = new(2026, 6, 15);
    private DateOnly fullBindDisplay = new(2026, 6, 1);
    private DateOnly? lastChangedDate;

    private static readonly DateOnly MinConstraint = new(2026, 6, 1);
    private static readonly DateOnly MaxConstraint = new(2026, 6, 30);
    private static readonly IReadOnlyList<XFCalendarHighlight> CalendarHighlights = new[]
    {
        new XFCalendarHighlight(new DateOnly(2026, 6, 5), "Lembrete: Revisao do trimestre", XFSemanticColor.Info),
        new XFCalendarHighlight(new DateOnly(2026, 6, 5), "Mensagem: Relatorio pronto", XFSemanticColor.Success),
        new XFCalendarHighlight(new DateOnly(2026, 6, 12), "Agendamento: Reuniao diretoria", XFSemanticColor.Warning),
        new XFCalendarHighlight(new DateOnly(2026, 6, 12), "Lembrete: Enviar convites", XFSemanticColor.Info),
        new XFCalendarHighlight(new DateOnly(2026, 6, 19), "Agendamento: Apresentacao cliente", XFSemanticColor.Danger),
        new XFCalendarHighlight(new DateOnly(2026, 6, 26), "Mensagem: Feedback disponivel", XFSemanticColor.Success),
        new XFCalendarHighlight(new DateOnly(2026, 6, 26), "Lembrete: Atualizar documentacao", XFSemanticColor.Info),
        new XFCalendarHighlight(new DateOnly(2026, 6, 26), "Agendamento: Sprint review", XFSemanticColor.Warning)
    };

    private static bool IsWeekend(DateOnly d) =>
        d.DayOfWeek == DayOfWeek.Saturday || d.DayOfWeek == DayOfWeek.Sunday;

    // Hero
    private RenderFragment HeroPreview() => @<div>
        <XFCalendar Value="heroDate"
                    ValueChanged="@(v => heroDate = v ?? default)"
                    Highlights="CalendarHighlights"
                    Size="XFSize.Md"
                    Variant="XFContainerVariant.Surface" />
    </div>;

    // 1. Basic
    private RenderFragment ExBasic() => @<div>
        <XFCalendar Value="basicDate"
                    ValueChanged="@(v => basicDate = v ?? default)"
                    DisplayDate="basicDisplay"
                    DisplayDateChanged="@(v => basicDisplay = v)" />
    </div>;

    // 2. Sizes
    private RenderFragment ExSizes() => @<div class="flex flex-col gap-6">
        <div>
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">Sm</XFTypography>
            <XFCalendar Value="sizeSmDate" ValueChanged="@(v => sizeSmDate = v ?? default)" Size="XFSize.Sm" />
        </div>
        <div>
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">Md</XFTypography>
            <XFCalendar Value="sizeMdDate" ValueChanged="@(v => sizeMdDate = v ?? default)" Size="XFSize.Md" />
        </div>
        <div>
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">Lg</XFTypography>
            <XFCalendar Value="sizeLgDate" ValueChanged="@(v => sizeLgDate = v ?? default)" Size="XFSize.Lg" />
        </div>
    </div>;

    // 3. Variants
    private RenderFragment ExVariants() => @<div class="grid gap-4 md:grid-cols-3">
        <div>
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">Surface</XFTypography>
            <XFCalendar Value="variantSurfaceDate" ValueChanged="@(v => variantSurfaceDate = v ?? default)" Variant="XFContainerVariant.Surface" />
        </div>
        <div>
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">Soft</XFTypography>
            <XFCalendar Value="variantSoftDate" ValueChanged="@(v => variantSoftDate = v ?? default)" Variant="XFContainerVariant.Soft" />
        </div>
        <div>
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">Plain</XFTypography>
            <XFCalendar Value="variantPlainDate" ValueChanged="@(v => variantPlainDate = v ?? default)" Variant="XFContainerVariant.Plain" />
        </div>
    </div>;

    // 4. Day View
    private RenderFragment ExDayView() => @<div>
        <XFCalendar Value="dayViewDate"
                    ValueChanged="@(v => dayViewDate = v ?? default)"
                    DisplayDate="dayDisplayDate"
                    DisplayDateChanged="@(v => dayDisplayDate = v)"
                    View="XFCalendarView.Day"
                    Highlights="CalendarHighlights"
                    Size="XFSize.Md" />
    </div>;

    // 5. Week View
    private RenderFragment ExWeekView() => @<div>
        <XFCalendar Value="weekViewDate"
                    ValueChanged="@(v => weekViewDate = v ?? default)"
                    DisplayDate="weekDisplayDate"
                    DisplayDateChanged="@(v => weekDisplayDate = v)"
                    View="XFCalendarView.Week"
                    Highlights="CalendarHighlights"
                    Size="XFSize.Lg" />
    </div>;

    // 6. Constraints
    private RenderFragment ExConstraints() => @<div class="grid gap-4 md:grid-cols-2">
        <div>
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">
                @T("Junho 2026 apenas", "June 2026 only")
            </XFTypography>
            <XFCalendar Value="constraintDate"
                        ValueChanged="@(v => constraintDate = v ?? default)"
                        Min="MinConstraint"
                        Max="MaxConstraint"
                        DisplayDate="MinConstraint" />
        </div>
        <div>
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">
                @T("Finais de semana desabilitados", "Weekends disabled")
            </XFTypography>
            <XFCalendar Value="constraintDate"
                        ValueChanged="@(v => constraintDate = v ?? default)"
                        DisabledDate="IsWeekend" />
        </div>
    </div>;

    // 7. Highlighted
    private RenderFragment ExHighlighted() => @<div>
        <XFCalendar Value="highlightedDate"
                    ValueChanged="@(v => highlightedDate = v ?? default)"
                    Highlights="CalendarHighlights"
                    DisplayDate="new(2026, 6, 1)" />
        <div class="mt-3 flex flex-wrap gap-3">
            <span class="inline-flex items-center gap-1.5 text-xs text-text-secondary">
                <span class="h-2 w-2 rounded-full bg-info"></span> @T("Lembrete", "Reminder")
            </span>
            <span class="inline-flex items-center gap-1.5 text-xs text-text-secondary">
                <span class="h-2 w-2 rounded-full bg-success"></span> @T("Mensagem", "Message")
            </span>
            <span class="inline-flex items-center gap-1.5 text-xs text-text-secondary">
                <span class="h-2 w-2 rounded-full bg-warning"></span> @T("Agendamento", "Appointment")
            </span>
            <span class="inline-flex items-center gap-1.5 text-xs text-text-secondary">
                <span class="h-2 w-2 rounded-full bg-danger"></span> @T("Urgente", "Urgent")
            </span>
        </div>
    </div>;

    // 8. DayTemplate
    private RenderFragment ExDayTemplate() => @<div>
        <XFCalendar Value="templateDate"
                    ValueChanged="@(v => templateDate = v ?? default)"
                    Highlights="CalendarHighlights"
                    DisplayDate="new(2026, 6, 1)">
            <DayTemplate Context="ctx">
                <span class="@(ctx.IsSelected ? "font-bold" : "font-semibold")">@ctx.Date.Day</span>
                @if (ctx.Highlights.Count > 0)
                {
                    <span class="flex gap-0.5">
                        @foreach (var h in ctx.Highlights.Take(2))
                        {
                            <span class="h-1 w-1 rounded-full @(ctx.IsSelected ? "bg-white" : "bg-primary")"></span>
                        }
                        @if (ctx.Highlights.Count > 2)
                        {
                            <span class="text-[8px] @(ctx.IsSelected ? "text-white/80" : "text-text-muted")">+@(ctx.Highlights.Count - 2)</span>
                        }
                    </span>
                }
                @if (ctx.IsToday)
                {
                    <span class="text-[10px] font-bold @(ctx.IsSelected ? "text-white" : "text-primary")">@T("Hoje", "Today")</span>
                }
            </DayTemplate>
        </XFCalendar>
    </div>;

    // 9. Culture
    private RenderFragment ExCulture() => @<div class="grid gap-4 md:grid-cols-3">
        <div>
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">pt-BR</XFTypography>
            <XFCalendar Value="culturePtDate" ValueChanged="@(v => culturePtDate = v ?? default)"
                        Culture="@(new System.Globalization.CultureInfo("pt-BR"))"
                        FirstDayOfWeek="DayOfWeek.Sunday" />
        </div>
        <div>
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">en-US (Monday)</XFTypography>
            <XFCalendar Value="cultureEnDate" ValueChanged="@(v => cultureEnDate = v ?? default)"
                        Culture="@(new System.Globalization.CultureInfo("en-US"))"
                        FirstDayOfWeek="DayOfWeek.Monday" />
        </div>
        <div>
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">ja-JP</XFTypography>
            <XFCalendar Value="cultureJpDate" ValueChanged="@(v => cultureJpDate = v ?? default)"
                        Culture="@(new System.Globalization.CultureInfo("ja-JP"))"
                        FirstDayOfWeek="DayOfWeek.Sunday" />
        </div>
    </div>;

    // 10. Full Bind
    private RenderFragment ExFullBind() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFStack Orientation="XFOrientation.Horizontal" Gap="3" Wrap="XFWrap.Wrap" AlignItems="XFAlignItems.Center">
            <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary"
                     Text="@($"Value: {fullBindDate:yyyy-MM-dd}")" />
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info"
                     Text="@($"Display: {fullBindDisplay:yyyy-MM-dd}")" />
            @if (lastChangedDate is not null)
            {
                <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success"
                         Text="@($"Changed: {lastChangedDate:yyyy-MM-dd}")" />
            }
        </XFStack>
        <XFCalendar Value="fullBindDate"
                    ValueChanged="@(v => fullBindDate = v ?? default)"
                    DisplayDate="fullBindDisplay"
                    DisplayDateChanged="@(v => fullBindDisplay = v)"
                    Change="@(v => lastChangedDate = v)"
                    Highlights="CalendarHighlights" />
    </XFStack>;

    // Helpers
    private RenderFragment Section(string title, RenderFragment content) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
        <Header><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography></Header>
        <ChildContent>@content</ChildContent>
    </XFCard>;

    private RenderFragment Example(string title, string description, RenderFragment preview, string codeText) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.None" AreaRestricted="false">
        <Header><div class="px-6 pt-6 pb-2">
            <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@description</XFTypography>
        </div></Header>
        <ChildContent><div class="flex flex-col">
            <div class="border-t border-border-light p-6">@preview</div>
            <div class="border-t border-border-light bg-surface-50 p-6">
                <XFCode Text="@codeText" Language="razor" Title="@CopyableCodeTitle" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" />
            </div>
        </div></ChildContent>
    </XFCard>;

    private RenderFragment Tile(DocTile item) => @<XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent>
        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <div class="flex items-center gap-4">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-primary/10 bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                <div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div>
            </div>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
        </XFStack>
    </ChildContent></XFCard>;

    private RenderFragment TileGrid(IReadOnlyList<DocTile> items, int columns) => @<XFGrid Cols="1" Md="@Math.Min(columns, 2)" Lg="@columns" Gap="4">@foreach (var item in items) { @Tile(item) }</XFGrid>;

    private RenderFragment WarningGrid(IReadOnlyList<DocTile> items) => @<XFGrid Cols="1" Md="2" Gap="4">@foreach (var item in items) {
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <div class="flex items-center gap-4">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-danger/10 bg-danger/10 text-danger" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                <div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div>
            </div>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
        </XFStack></ChildContent></XFCard>
    }</XFGrid>;

    private RenderFragment NameValueTable(IReadOnlyList<NameValueRow> rows, string nameHeader, string valueHeader) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader><XFTableRow><XFTableCell Header="true">@nameHeader</XFTableCell><XFTableCell Header="true">@valueHeader</XFTableCell></XFTableRow></XFTableHeader>
        <XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Value</XFTableCell></XFTableRow> }</XFTableBody>
    </XFTable>;

    private RenderFragment ApiTable(IReadOnlyList<ApiRow> rows) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader><XFTableRow>
            <XFTableCell Header="true">@T("Parametro", "Parameter")</XFTableCell>
            <XFTableCell Header="true">Type</XFTableCell>
            <XFTableCell Header="true">Default</XFTableCell>
            <XFTableCell Header="true">@T("Descricao", "Description")</XFTableCell>
        </XFTableRow></XFTableHeader>
        <XFTableBody>@foreach (var row in rows) {
            <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Type</XFTableCell><XFTableCell><XFCode Text="@row.DefaultValue" /></XFTableCell><XFTableCell>@row.Description</XFTableCell></XFTableRow>
        }</XFTableBody>
    </XFTable>;

