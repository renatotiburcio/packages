@page "/forms/overview"
@using XForge.DesignSystem.Core.Primitives
@inject XForgeDocsLanguageService Language

<XForgeDocsShell ProductLabel="@T("Core Open Source", "Core Open Source")" Title="@T("Visao geral de Forms", "Forms Overview")" Status="@T("Padrao de categoria", "Category standard")" Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Text="Forms" Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Danger" />
                        <XFBadge Text="@T("Entrada de dados", "Data entry")" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" />
                        <XFBadge Text="@T("Validacao primeiro", "Validation first")" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" />
                    </XFStack>

                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Formularios enterprise para capturar dados com contexto, validacao e recuperacao clara.",
                               "Enterprise forms for capturing data with context, validation and clear recovery.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("A categoria Forms cobre entradas textuais, escolhas, datas, upload, validacao, mascaras, assinatura e composicao de formularios. Ela existe para transformar captura de dados em contratos previsiveis, acessiveis e seguros para ERP, backoffice, operacao e workflows AI.",
                               "The Forms category covers text inputs, choices, dates, upload, validation, masks, signature and form composition. It exists to turn data capture into predictable, accessible and safe contracts for ERP, back-office, operations and AI workflows.")
                        </XFTypography>
                    </XFStack>

                    <XFGrid Cols="1" Gap="4" Class="lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in HeroFacts)
                            {
                                <XForgeCategoryOverviewTile Item="item" />
                            }
                        </XFStack>
                    </XFGrid>
                </XFStack>
            </ChildContent>
        </XFCard>

        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
            <Header><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">Blazor Server e Blazor WebAssembly</XFTypography></Header>
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                    <XFTable Striped="true" Hoverable="true" Compact="true">
                        <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                        <XFTableBody>
                            <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                            <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                            <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                            <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico. Interacoes requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                        </XFTableBody>
                    </XFTable>
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderizacao.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
                </XFStack>
            </ChildContent>
        </XFCard>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewSection Title="@T("Visao geral", "Overview")" Items="OverviewItems" Columns="3" />
            <XForgeCategoryOverviewSection Title="@T("Filosofia", "Philosophy")" Items="PhilosophyItems" />
            <XForgeCategoryOverviewSection Title="@T("Objetivos da categoria", "Category Objectives")" Items="ObjectiveItems" Columns="3" />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewComponentTable Rows="ComponentRows"
                                                  Description="@T("Componentes de Forms devem documentar entrada, validacao, acessibilidade e cenario enterprise antes do exemplo visual.",
                                                                  "Forms components must document input, validation, accessibility and enterprise scenario before the visual example.")" />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewSection Title="@T("Linguagem visual", "Visual Language")" Items="VisualLanguageItems" Columns="3" />
            <XForgeCategoryOverviewSection Title="@T("Padroes de UX", "UX Standards")" Items="UxStandardItems" Columns="3" />
            <XForgeCategoryOverviewSection Title="@T("Padroes de acessibilidade", "Accessibility Standards")" Items="AccessibilityItems" />
            <XForgeCategoryOverviewSection Title="@T("Padroes de responsividade", "Responsiveness Standards")" Items="ResponsiveItems" />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewSection Title="@T("Padroes de tema", "Theme Standards")" Items="ThemeItems" />
            <XForgeCategoryOverviewNameDescriptionTable Title="Design Tokens"
                                                        NameHeader="@T("Grupo de token", "Token Group")"
                                                        DescriptionHeader="@T("Proposito", "Purpose")"
                                                        CodeName="true"
                                                        Rows="TokenRows" />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewSection Title="@T("Padroes comuns", "Common Patterns")" Items="PatternItems" Columns="3" />
            <XForgeCategoryOverviewSection Title="@T("Cenarios enterprise", "Enterprise Scenarios")" Items="ScenarioItems" Columns="3" />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewExampleGallery Examples="Examples" />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewSection Title="@T("Padroes de documentacao", "Documentation Standards")" Items="DocumentationItems" Columns="3" />
            <XForgeCategoryOverviewSection Title="@T("Anti-padroes", "Anti-patterns")" Items="AntiPatternItems" Columns="3" />
            <XForgeCategoryOverviewSection Title="@T("Guia de migracao", "Migration Guidance")" Items="MigrationItems" Columns="3" />
            <XForgeCategoryOverviewSection Title="@T("Boas praticas", "Best Practices")" Items="BestPracticeItems" Columns="3" />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewNameDescriptionTable Title="@T("Categorias relacionadas", "Related Categories")"
                                                        NameHeader="@T("Categoria", "Category")"
                                                        DescriptionHeader="@T("Relacao", "Relationship")"
                                                        Rows="RelatedCategories" />
        </XFStack>
    </XFStack>

    <XForgeDocsPageStandard ComponentName="FormsOverviewDocs" IsOverview="true" />
</XForgeDocsShell>

@code {
    private string T(string ptBr, string enUs) => Language.Text(ptBr, enUs);

    private string ActiveStatus => T("Ativo", "Active");
    private string ReviewStatus => T("Em revisao", "In review");
    private string BlockedStatus => T("Bloqueado", "Blocked");
    private string TaxRegimeReal => T("Lucro real", "Real profit");
    private string TaxRegimePresumed => T("Lucro presumido", "Presumed profit");
    private string TaxRegimeSimple => T("Simples nacional", "Simples nacional");

    private IReadOnlyList<string> StatusOptions => [ActiveStatus, ReviewStatus, BlockedStatus];

    private IReadOnlyList<XForgeCategoryOverviewExample> Examples => [
        new(T("Cadastro operacional", "Operational registration"), T("Composicao de campos, select, validacao visual e acoes de formulario.", "Composition of fields, select, visual validation and form actions."), RegistrationPreview(), RegistrationCode),
        new(T("Validacao e consentimento", "Validation and consent"), T("Erros, obrigatoriedade e aceite sem depender de markup nativo cru.", "Errors, required state and consent without raw native markup."), ValidationPreview(), ValidationCode),
        new(T("Upload de evidencias", "Evidence upload"), T("Upload e metadados para anexos de processos fiscais e operacionais.", "Upload and metadata for tax and operational process attachments."), UploadPreview(), UploadCode)
    ];

    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" JustifyContent="XFJustifyContent.SpaceBetween" AlignItems="XFAlignItems.Start" Gap="3" Wrap="XFWrap.Wrap" FullWidth="true">
                        <XFStack Orientation="XFOrientation.Vertical" Gap="1">
                            <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@T("Cadastro operacional", "Operational registration")</XFTypography>
                            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Validacao, selecao e anexo.", "Validation, selection and attachment.")</XFTypography>
                        </XFStack>
                        <XFBadge Text="@T("Rascunho salvo", "Draft saved")" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" />
                    </XFStack>

                    <XFGrid Cols="1" Md="2" Gap="4">
                        <XFTextInput Label="@T("Empresa", "Company")" Value="XForge Agro Ltda" HelperText="@T("Nome exibido em documentos e relatorios.", "Name shown in documents and reports.")" />
                        <XFSelect TValue="string" Label="Status" Value="@ActiveStatus" HelperText="@T("Controle operacional do cadastro.", "Operational control for the record.")">
                            @foreach (var option in StatusOptions)
                            {
                                <XFSelectOption TValue="string" Value="@option" Text="@option" />
                            }
                        </XFSelect>
                        <XFTextInput Label="@T("Documento", "Document")" Value="" Placeholder="00.000.000/0000-00" Tone="XFSemanticColor.Danger" HelperText="@T("Documento obrigatorio para emissao fiscal.", "Document is required for tax issuing.")" />
                        <XFUpload Title="@T("Anexos", "Attachments")" Description="@T("Comprovantes e evidencias", "Receipts and evidence")" HelperText="@T("PDF, XML ou imagem ate 10 MB.", "PDF, XML or image up to 10 MB.")" />
                    </XFGrid>

                    <XFStack Orientation="XFOrientation.Horizontal" JustifyContent="XFJustifyContent.End" Gap="2" Wrap="XFWrap.Wrap" FullWidth="true">
                        <XFButton Text="@T("Cancelar", "Cancel")" Variant="XFButtonVariant.Outline" Color="XFButtonColor.Neutral" />
                        <XFButton Text="@T("Salvar cadastro", "Save record")" Color="XFButtonColor.Danger" />
                    </XFStack>
                </XFStack>
            </ChildContent>
        </XFCard>
    </XFStack>;

    private RenderFragment RegistrationPreview() => @<XFGrid Cols="1" Md="2" Gap="4">
        <XFTextInput Label="@T("Razao social", "Legal name")" Value="XForge Agro Ltda" Required="true" HelperText="@T("Usado em faturamento e contratos.", "Used in billing and contracts.")" />
        <XFTextInput Label="CNPJ" Value="12.345.678/0001-90" Required="true" HelperText="@T("Validado antes de salvar.", "Validated before saving.")" />
        <XFSelect TValue="string" Label="@T("Regime tributario", "Tax regime")" Value="@TaxRegimeReal">
            <XFSelectOption TValue="string" Value="@TaxRegimeReal" Text="@TaxRegimeReal" />
            <XFSelectOption TValue="string" Value="@TaxRegimePresumed" Text="@TaxRegimePresumed" />
            <XFSelectOption TValue="string" Value="@TaxRegimeSimple" Text="@TaxRegimeSimple" />
        </XFSelect>
        <XFTextInput Label="@T("Responsavel", "Owner")" Value="Marina Costa" HelperText="@T("Aprovadora do cadastro.", "Record approver.")" />
    </XFGrid>;

    private RenderFragment ValidationPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFTextInput Label="@T("Email financeiro", "Finance email")" Value="financeiro@xforge" Tone="XFSemanticColor.Danger" HelperText="@T("Informe um email valido para notificacoes.", "Enter a valid email for notifications.")" />
        <XFCheckbox Label="@T("Confirmo que revisei os dados fiscais", "I confirm I reviewed the tax data")" Description="@T("Obrigatorio antes de liberar o cadastro para aprovacao.", "Required before releasing the record for approval.")" Value="true" />
        <XFButton Text="@T("Enviar para aprovacao", "Send for approval")" Color="XFButtonColor.Danger" />
    </XFStack>;

    private RenderFragment UploadPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFUpload Label="@T("Documentos obrigatorios", "Required documents")" Title="@T("Solte XML, PDF ou comprovantes", "Drop XML, PDF or receipts")" Description="@T("Anexos ficam vinculados ao cadastro e ao audit log.", "Attachments are linked to the record and audit log.")" Multiple="true" />
        <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
            <XFBadge Text="XML NF-e" Color="XFBadgeColor.Info" />
            <XFBadge Text="@T("Contrato social", "Articles of incorporation")" Color="XFBadgeColor.Primary" />
            <XFBadge Text="@T("Pendente assinatura", "Signature pending")" Color="XFBadgeColor.Warning" />
        </XFStack>
    </XFStack>;

    private XForgeCategoryOverviewItem Item(string ptTitle, string enTitle, string ptDescription, string enDescription, string icon) =>
        new(T(ptTitle, enTitle), T(ptDescription, enDescription), icon);

    private XForgeCategoryOverviewNameDescription Pair(string name, string ptDescription, string enDescription) =>
        new(name, T(ptDescription, enDescription));

    private XForgeCategoryOverviewComponentRow Row(string component, string ptPurpose, string enPurpose, string ptMain, string enMain, string ptEnterprise, string enEnterprise, string accessibility, string complexity) =>
        new(component, T(ptPurpose, enPurpose), T(ptMain, enMain), T(ptEnterprise, enEnterprise), accessibility, complexity);

    private IReadOnlyList<XForgeCategoryOverviewItem> HeroFacts => [
        Item("Objetivo enterprise", "Enterprise objective", "Reduzir erro humano em cadastros, aprovacoes, anexos e fluxos fiscais.", "Reduce human error in records, approvals, attachments and tax flows.", "input-text"),
        Item("Acessibilidade", "Accessibility", "Labels, descricoes, required, aria-invalid e mensagens de erro fazem parte do contrato.", "Labels, descriptions, required state, aria-invalid and error messages are part of the contract.", "universal-access"),
        Item("Performance", "Performance", "Inputs controlados, debounce e validacao progressiva evitam re-render pesado.", "Controlled inputs, debounce and progressive validation avoid heavy re-renders.", "bolt")
    ];

    private IReadOnlyList<XForgeCategoryOverviewItem> OverviewItems => [
        Item("Captura de dados", "Data capture", "Entradas textuais, numericas, datas e escolhas com semantica previsivel.", "Text, numeric, date and choice inputs with predictable semantics.", "input-text"),
        Item("Fluxo de validacao", "Validation flow", "Erros, helper text e required devem orientar recuperacao imediata.", "Errors, helper text and required state should guide immediate recovery.", "circle-exclamation"),
        Item("Controles de escolha", "Choice controls", "Select, combo, autocomplete, radio, checkbox e switch resolvem decisoes diferentes.", "Select, combo, autocomplete, radio, checkbox and switch solve different decisions.", "list-ul"),
        Item("Evidencia", "Evidence", "Upload e assinatura preservam anexos, provas e aprovacao.", "Upload and signature preserve attachments, proof and approval.", "file-lines"),
        Item("Escala enterprise", "Enterprise scale", "Formularios precisam funcionar em cadastro simples, wizard e grids editaveis.", "Forms must work in simple records, wizards and editable grids.", "building"),
        Item("AI readiness", "AI readiness", "Campos e validacoes fornecem contexto limpo para assistentes e automacoes.", "Fields and validations provide clean context for assistants and automations.", "sparkles")
    ];

    private IReadOnlyList<XForgeCategoryOverviewItem> PhilosophyItems => [
        Item("Contexto antes do input", "Context before input", "Todo campo precisa explicar o que coleta e como sera usado.", "Every field must explain what it captures and how it will be used.", "circle-info"),
        Item("Erros recuperaveis", "Recoverable errors", "Validacao deve apontar problema, local e caminho de correcao.", "Validation should point to the issue, location and recovery path.", "arrow-rotate-left"),
        Item("Revelacao progressiva", "Progressive disclosure", "Campos complexos aparecem quando sao relevantes ao fluxo.", "Complex fields appear when relevant to the flow.", "layer-group"),
        Item("DesignSystem primeiro", "DesignSystem-first", "Entrada nativa so entra quando o componente XForge nao existir.", "Native input is used only when no XForge component exists.", "shield-check")
    ];

    private IReadOnlyList<XForgeCategoryOverviewItem> ObjectiveItems => [
        Item("Padronizacao", "Standardization", "Unificar label, helper, erro, required, disabled, readonly e loading.", "Unify label, helper, error, required, disabled, readonly and loading.", "check"),
        Item("Precisao", "Accuracy", "Reduzir dados invalidos com mascaras, tipos e validacao no ponto certo.", "Reduce invalid data with masks, types and validation at the right point.", "bullseye"),
        Item("Velocidade", "Speed", "Permitir preenchimento rapido com teclado, autocomplete e defaults seguros.", "Enable fast entry with keyboard, autocomplete and safe defaults.", "bolt"),
        Item("Rastreabilidade", "Traceability", "Anexos, assinatura e aceite documentam responsabilidade.", "Attachments, signature and consent document responsibility.", "file-lines"),
        Item("Acessibilidade", "Accessibility", "Todos os controles precisam de nome acessivel e estado real.", "Every control needs an accessible name and real state.", "universal-access"),
        Item("Composicao", "Composability", "Campos funcionam em cards, dialogs, drawers, grids e wizards.", "Fields work in cards, dialogs, drawers, grids and wizards.", "rectangles-mixed")
    ];

    private IReadOnlyList<XForgeCategoryOverviewComponentRow> ComponentRows => [
        Row("XFTextInput", "Entrada textual padronizada.", "Standardized text input.", "Nome, documento, email, busca simples.", "Name, document, email, simple search.", "Cadastro de cliente, fornecedor, produto e usuario.", "Customer, supplier, product and user records.", "High", "Medium"),
        Row("XFTextarea", "Entrada textual longa.", "Long text input.", "Observacoes e justificativas.", "Notes and justifications.", "Motivo de aprovacao, parecer e descricao de chamado.", "Approval reason, review note and ticket description.", "High", "Low"),
        Row("XFSelect", "Escolha unica em lista conhecida.", "Single choice in a known list.", "Status, tipo, categoria.", "Status, type, category.", "Regime tributario, filial, centro de custo.", "Tax regime, branch, cost center.", "High", "Medium"),
        Row("XFAutocomplete", "Busca assistida em lista grande.", "Assisted search in a large list.", "Selecionar entidade por texto.", "Select entity by text.", "Cliente, produto, conta contabil e cidade.", "Customer, product, account and city.", "High", "High"),
        Row("XFCheckbox", "Aceite ou selecao booleana.", "Consent or boolean selection.", "Confirmacoes e flags.", "Confirmations and flags.", "Aceite fiscal, termos, selecao de linhas.", "Tax consent, terms, row selection.", "High", "Medium"),
        Row("XFSwitch", "Alternancia imediata.", "Immediate toggle.", "Ativar/desativar configuracao.", "Enable/disable setting.", "Habilitar modulo, regra ou notificacao.", "Enable module, rule or notification.", "High", "Medium"),
        Row("XFNumberInput", "Numero estruturado.", "Structured number.", "Quantidade, limite, score.", "Quantity, limit, score.", "Estoque minimo, aliquota, prazo e quantidade.", "Minimum stock, rate, term and quantity.", "High", "Medium"),
        Row("XFCurrencyInput", "Valores monetarios.", "Currency values.", "Preco, total, limite.", "Price, total, limit.", "Pedido, faturamento, comissao e teto de credito.", "Order, billing, commission and credit cap.", "High", "Medium"),
        Row("XFDateInput", "Data direta.", "Direct date.", "Data de vencimento ou emissao.", "Due or issue date.", "NF-e, contrato, competencia e agenda.", "Invoice, contract, fiscal period and schedule.", "High", "Medium"),
        Row("XFUpload", "Anexos e evidencias.", "Attachments and evidence.", "Enviar arquivos.", "Send files.", "Comprovantes, XML, contratos e imagens.", "Receipts, XML, contracts and images.", "High", "High"),
        Row("XFSignaturePad", "Assinatura e aceite visual.", "Signature and visual consent.", "Capturar assinatura.", "Capture signature.", "Entrega, aprovacao presencial e termo.", "Delivery, in-person approval and term.", "Medium", "High")
    ];

    private IReadOnlyList<XForgeCategoryOverviewItem> VisualLanguageItems => [
        Item("Anatomia de campo", "Field anatomy", "Label, controle, helper e erro devem ocupar posicoes consistentes.", "Label, control, helper and error must occupy consistent positions.", "rectangle-list"),
        Item("Densidade", "Density", "Tamanhos compactos para grids e tamanho medio para formularios principais.", "Compact sizes for grids and medium size for main forms.", "sliders"),
        Item("Cor de estado", "Status color", "Danger indica erro validavel; warning indica risco; success confirma conclusao.", "Danger indicates validatable error; warning indicates risk; success confirms completion.", "swatchbook"),
        Item("Focus ring", "Focus ring", "Foco visivel deve ser claro em todos os controles.", "Visible focus must be clear in every control.", "bullseye"),
        Item("Agrupamento", "Grouping", "Cards, stack e grid organizam campos por decisao e responsabilidade.", "Cards, stack and grid organize fields by decision and responsibility.", "rectangles-mixed"),
        Item("Affordance", "Affordance", "Select, upload, clearable e date picker precisam parecer interativos.", "Select, upload, clearable and date picker must look interactive.", "hand-pointer")
    ];

    private IReadOnlyList<XForgeCategoryOverviewItem> UxStandardItems => [
        Item("Obrigatorio claro", "Required clarity", "Obrigatorio deve aparecer no label e na validacao.", "Required state must appear in the label and validation.", "asterisk"),
        Item("Helper antes do erro", "Helper before error", "Helper orienta antes do erro; erro substitui helper quando necessario.", "Helper guides before error; error replaces helper when needed.", "circle-info"),
        Item("Teclado primeiro", "Keyboard first", "Tab, Enter, Space, setas e Escape devem funcionar conforme o controle.", "Tab, Enter, Space, arrows and Escape should work according to the control.", "keyboard"),
        Item("Sem surpresa", "Avoid surprise", "Switch altera estado imediato; checkbox registra escolha para submit.", "Switch changes immediate state; checkbox records choice for submit.", "toggle-on"),
        Item("Chunking", "Chunking", "Formularios longos devem ser agrupados por etapa, card ou accordion.", "Long forms should be grouped by step, card or accordion.", "layer-group"),
        Item("Submit seguro", "Submit safety", "Acoes finais precisam indicar loading, sucesso e falha recuperavel.", "Final actions need loading, success and recoverable failure.", "arrows-rotate")
    ];

    private IReadOnlyList<XForgeCategoryOverviewItem> AccessibilityItems => [
        Item("Labels", "Labels", "Todo campo precisa de label visivel ou aria-label quando visualmente oculto.", "Every field needs a visible label or aria-label when visually hidden.", "tag"),
        Item("Descricoes", "Descriptions", "Helper e erro devem estar associados por aria-describedby.", "Helper and error should be associated through aria-describedby.", "file-lines"),
        Item("Estado invalido", "Invalid state", "aria-invalid precisa refletir validacao real.", "aria-invalid must reflect real validation.", "circle-exclamation"),
        Item("Alvo de toque", "Target size", "Checkbox, radio, switch e upload precisam manter alvo de toque.", "Checkbox, radio, switch and upload need a touch target.", "hand-pointer")
    ];

    private IReadOnlyList<XForgeCategoryOverviewItem> ResponsiveItems => [
        Item("Uma coluna no mobile", "One column mobile", "Campos empilham em mobile para leitura e toque confortaveis.", "Fields stack on mobile for comfortable reading and touch.", "mobile-screen"),
        Item("Duas colunas no desktop", "Two column desktop", "Use grid responsivo para pares relacionados, sem quebrar labels.", "Use responsive grid for related pairs without breaking labels.", "table-columns"),
        Item("Valores longos", "Long values", "Entradas com texto longo precisam truncar ou quebrar com previsibilidade.", "Inputs with long text need predictable truncation or wrapping.", "arrows-left-right"),
