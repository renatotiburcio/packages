@page "/components/tooltip"
@page "/components/tooltips"
@using XForge.DesignSystem.Components.Shared
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="Core OSS"
                 Title="XFTooltip"
                 Status="Complete docs"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFTooltip" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("4 Posições", "4 Positions")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Enterprise", "Enterprise")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Dica contextual acessível para ações, status e campos.",
                               "Accessible contextual hint for actions, status and fields.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("XFTooltip renderiza dicas em 4 posições, 3 temas, 3 modos de gatilho, delay configurável, seta direcional e fechamento por Escape.",
                               "XFTooltip renders hints in 4 positions, 3 themes, 3 trigger modes, configurable delay, directional arrow and Escape close.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section(T("Blazor Server e Blazor WebAssembly", "Blazor Server and Blazor WebAssembly"), @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observações", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona com prerender-safe guards.", "Works with prerender-safe guards.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona com prerender-safe guards no primeiro render.", "Works with prerender-safe guards on first render.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Parcial", "Partial")" /></XFTableCell><XFTableCell>@T("Renderiza HTML base. Posicionamento e show/hide indisponíveis durante prerender.", "Renders base HTML. Positioning and show/hide unavailable during prerender.")</XFTableCell></XFTableRow></XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("JS Interop", "JS Interop")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Arquivo JS: xf-tooltip.js — gerencia xfTooltip.init/update/show/hide, posicionamento com CollisionPadding e fechamento por Escape.", "JS file: xf-tooltip.js — manages xfTooltip.init/update/show/hide, positioning with CollisionPadding and Escape close.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Quando carrega: OnAfterRenderAsync.", "When loaded: OnAfterRenderAsync.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Prerender seguro: try/catch para InvalidOperationException e JSDisconnectedException.", "Prerender safe: try/catch for InvalidOperationException and JSDisconnectedException.")</XFTypography>
                </XFStack>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Considerações Blazor Server", "Blazor Server Considerations")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("JS interop via SignalR com latência. Posicionamento do tooltip pode ter resposta mais lenta.", "JS interop via SignalR with latency. Tooltip positioning may have slower response.")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Considerações Blazor WebAssembly", "Blazor WebAssembly Considerations")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("JS interop direto sem latência de rede. Disponível após carregamento do WASM.", "Direct JS interop with no network latency. Available after WASM load.")</XFTypography>
            </XFStack>
        </div>)

        <!-- ===== OVERVIEW ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
        @Section(T("Visão geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
        @Section(T("Propósito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
        @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando não usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
        @Section(T("Princípios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 10 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Básico", "1. Basic"),
                T("Tooltip simples em um botão com posição padrão.", "Simple tooltip on a button with default position."),
                ExBasic(), CodeBasic)

            @Example(T("2. Posições", "2. Positions"),
                T("4 posições: Top, Right, Bottom e Left.", "4 positions: Top, Right, Bottom and Left."),
                ExPositions(), CodePositions)

            @Example(T("3. Temas", "3. Themes"),
                T("3 temas: Dark, Light e Primary.", "3 themes: Dark, Light and Primary."),
                ExThemes(), CodeThemes)

            @Example(T("4. Gatilhos", "4. Triggers"),
                T("3 modos: Hover, Focus e HoverFocus.", "3 modes: Hover, Focus and HoverFocus."),
                ExTriggers(), CodeTriggers)

            @Example(T("5. Delay", "5. Delay"),
                T("Delay customizado para exibição do tooltip.", "Custom delay for tooltip display."),
                ExDelay(), CodeDelay)

            @Example(T("6. Setas", "6. Arrows"),
                T("ShowArrow true/false para seta direcional.", "ShowArrow true/false for directional arrow."),
                ExArrows(), CodeArrows)

            @Example(T("7. Largura máxima", "7. Max Width"),
                T("MaxWidth para tooltips com texto longo.", "MaxWidth for tooltips with long text."),
                ExMaxWidth(), CodeMaxWidth)

            @Example(T("8. Em ícones", "8. On Icons"),
                T("Tooltips em botões de ícone para ações de toolbar.", "Tooltips on icon buttons for toolbar actions."),
                ExIcons(), CodeIcons)

            @Example(T("9. Em texto inline", "9. On Inline Text"),
                T("Tooltips em spans e texto inline para explicações.", "Tooltips on spans and inline text for explanations."),
                ExInlineText(), CodeInlineText)

            @Example(T("10. Cenário enterprise", "10. Enterprise Scenario"),
                T("Tooltips em grid de dados com status e indicadores.", "Tooltips on data grid with status and indicators."),
                ExEnterprise(), CodeEnterprise)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos e métodos", "Events and Methods"), @<div>@NameValueTable(EventRows, T("Método", "Method"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenários enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padrões de composição", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas práticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padrões", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Propósito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidência", "Evidence"))</div>)
            @Section(T("Limitações conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitação", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versão", "Version"), T("Mudança", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>

@code {
    private string T(string pt, string en) => LanguageService.Text(pt, en);
    private string CopyableCodeTitle => T("Copiar código", "Copy code");

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFStack Orientation="XFOrientation.Horizontal" Gap="3" Wrap="XFWrap.Wrap">
            <XFTooltip Text="@T("Salvar registro", "Save record")" Position="XFTooltipPosition.Top">
                <XFButton Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Sm">
                    @T("Salvar", "Save")
                </XFButton>
            </XFTooltip>
            <XFTooltip Text="@T("Excluir permanentemente", "Delete permanently")" Position="XFTooltipPosition.Bottom" Theme="XFTooltipTheme.Dark">
                <XFButton Variant="XFButtonVariant.Solid" Color="XFButtonColor.Danger" Size="XFExtendedSize.Sm">
                    @T("Excluir", "Delete")
                </XFButton>
            </XFTooltip>
            <XFTooltip Text="@T("Configurações avançadas", "Advanced settings")" Position="XFTooltipPosition.Right" Theme="XFTooltipTheme.Light">
                <XFButton Variant="XFButtonVariant.Outline" Color="XFButtonColor.Neutral" Size="XFExtendedSize.Sm">
                    @T("Configurações", "Settings")
                </XFButton>
            </XFTooltip>
        </XFStack>
    </XFStack>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("WAI-ARIA", "WAI-ARIA"), T("aria-describedby no trigger aponta para o tooltip.", "aria-describedby on trigger points to tooltip."), "universal-access"),
        new(T("4 posições", "4 positions"), T("Top, Right, Bottom e Left com flip automático.", "Top, Right, Bottom and Left with automatic flip."), "arrows-up-down"),
        new(T("3 temas", "3 themes"), T("Dark, Light e Primary para diferentes contextos.", "Dark, Light and Primary for different contexts."), "palette")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFTooltip"),
        new("Namespace", "XForge.DesignSystem.Components.Tooltip"),
        new("Package", "XForge.DesignSystem"),
        new("Category", "Components / Tooltip"),
        new("Status", T("Estável", "Stable")),
        new("Accessibility", T("aria-describedby, Escape, trigger por hover e foco, touch 44px.", "aria-describedby, Escape, hover and focus trigger, 44px touch.")),
        new("Theme support", T("Light, dark e data-brand via tokens.", "Light, dark and data-brand via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("Dica contextual", "Contextual hint"), T("Explica ações, status e campos sem aumentar a densidade visual.", "Explains actions, status and fields without increasing visual density."), "circle-info"),
        new(T("Posicionamento automático", "Auto positioning"), T("4 posições com flip e collision padding via JS.", "4 positions with flip and collision padding via JS."), "arrows-up-down"),
        new(T("3 temas visuais", "3 visual themes"), T("Dark, Light e Primary para diferentes contextos.", "Dark, Light and Primary for different contexts."), "palette")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Ações de toolbar", "Toolbar actions"), T("Explicar botões de ícone sem texto.", "Explain icon buttons without text."), "toolbar"),
        new(T("Indicadores de status", "Status indicators"), T("Explicar badges e tags coloridos.", "Explain colored badges and tags."), "signal"),
        new(T("Campos de formulário", "Form fields"), T("Explicar regras de validação ou formato.", "Explain validation rules or format."), "file-lines")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Botões sem contexto, ícones ambíguos, campos sem explicação.", "Buttons without context, ambiguous icons, fields without explanation."), "xmark"),
        new(T("Depois", "After"), T("Tooltips explicam cada elemento sem poluir a interface.", "Tooltips explain each element without polluting the interface."), "check"),
        new(T("Risco reduzido", "Reduced risk"), T("aria-describedby e trigger por foco garantem acessibilidade.", "aria-describedby and focus trigger ensure accessibility."), "shield-check")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Ações de toolbar", "Toolbar actions"), T("Explicar botões de ícone sem texto.", "Explain icon buttons without text."), "toolbar"),
        new(T("Indicadores de status", "Status indicators"), T("Explicar badges, tags e indicadores coloridos.", "Explain badges, tags and colored indicators."), "signal"),
        new(T("Campos de formulário", "Form fields"), T("Explicar regras de validação ou formato.", "Explain validation rules or format."), "file-lines"),
        new(T("Texto abreviado", "Abbreviated text"), T("Mostrar texto completo quando truncado.", "Show full text when truncated."), "text-width")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Conteúdo interativo", "Interactive content"), T("Tooltips não devem conter botões ou inputs. Use XFPopover.", "Tooltips must not contain buttons or inputs. Use XFPopover."), "xmark"),
        new(T("Informação essencial", "Essential information"), T("Não esconda informações críticas apenas no tooltip.", "Don't hide critical information only in tooltip."), "triangle-exclamation"),
        new(T("Texto longo", "Long text"), T("Máximo 1-2 frases. Para texto extenso, use XFPopover.", "Maximum 1-2 sentences. For extensive text, use XFPopover."), "align-left")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new(T("Gatilho (Trigger)", "Trigger"), T("Elemento envolvido (botão, ícone, texto) com aria-describedby.", "Wrapped element (button, icon, text) with aria-describedby."), "hand-pointer"),
        new(T("Painel (Tooltip)", "Tooltip"), T("Div posicionada com texto, seta direcional e tema.", "Positioned div with text, directional arrow and theme."), "comment"),
        new(T("Seta (Arrow)", "Arrow"), T("Seta direcional opcional (ShowArrow=true).", "Optional directional arrow (ShowArrow=true)."), "caret-up")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(T("Não invasivo", "Non-invasive"), T("Aparece apenas quando necessário, sem poluição visual.", "Appears only when needed, no visual pollution."), "eye"),
        new(T("Rápido e leve", "Fast and lightweight"), T("Delay configurável, renderização sob demanda.", "Configurable delay, on-demand rendering."), "bolt"),
        new(T("Acessível por padrão", "Accessible by default"), T("aria-describedby, Escape e trigger por foco.", "aria-describedby, Escape and focus trigger."), "universal-access")
    ];

    // === 1. Basic ===
    private RenderFragment ExBasic() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFTooltip Text="@T("Clique para salvar o registro", "Click to save the record")">
            <XFButton Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Md">
                @T("Salvar", "Save")
            </XFButton>
        </XFTooltip>
    </XFStack>;

    // === 2. Positions ===
    private RenderFragment ExPositions() => @<XFStack Orientation="XFOrientation.Horizontal" Gap="3" Wrap="XFWrap.Wrap">
        <XFTooltip Text="@T("Tooltip no topo", "Tooltip on top")" Position="XFTooltipPosition.Top">
            <XFButton Variant="XFButtonVariant.Outline" Color="XFButtonColor.Primary" Size="XFExtendedSize.Sm">Top</XFButton>
        </XFTooltip>
        <XFTooltip Text="@T("Tooltip à direita", "Tooltip on right")" Position="XFTooltipPosition.Right">
            <XFButton Variant="XFButtonVariant.Outline" Color="XFButtonColor.Primary" Size="XFExtendedSize.Sm">Right</XFButton>
        </XFTooltip>
        <XFTooltip Text="@T("Tooltip embaixo", "Tooltip on bottom")" Position="XFTooltipPosition.Bottom">
            <XFButton Variant="XFButtonVariant.Outline" Color="XFButtonColor.Primary" Size="XFExtendedSize.Sm">Bottom</XFButton>
        </XFTooltip>
        <XFTooltip Text="@T("Tooltip à esquerda", "Tooltip on left")" Position="XFTooltipPosition.Left">
            <XFButton Variant="XFButtonVariant.Outline" Color="XFButtonColor.Primary" Size="XFExtendedSize.Sm">Left</XFButton>
        </XFTooltip>
    </XFStack>;

    // === 3. Themes ===
    private RenderFragment ExThemes() => @<XFStack Orientation="XFOrientation.Horizontal" Gap="3" Wrap="XFWrap.Wrap">
        <XFTooltip Text="@T("Tema escuro (padrão)", "Dark theme (default)")" Theme="XFTooltipTheme.Dark">
            <XFButton Variant="XFButtonVariant.Solid" Color="XFButtonColor.Neutral" Size="XFExtendedSize.Sm">Dark</XFButton>
        </XFTooltip>
        <XFTooltip Text="@T("Tema claro", "Light theme")" Theme="XFTooltipTheme.Light">
            <XFButton Variant="XFButtonVariant.Solid" Color="XFButtonColor.Neutral" Size="XFExtendedSize.Sm">Light</XFButton>
        </XFTooltip>
        <XFTooltip Text="@T("Tema primário", "Primary theme")" Theme="XFTooltipTheme.Primary">
            <XFButton Variant="XFButtonVariant.Solid" Color="XFButtonColor.Neutral" Size="XFExtendedSize.Sm">Primary</XFButton>
        </XFTooltip>
    </XFStack>;

    // === 4. Triggers ===
    private RenderFragment ExTriggers() => @<XFStack Orientation="XFOrientation.Horizontal" Gap="3" Wrap="XFWrap.Wrap">
        <XFTooltip Text="@T("Aparece no hover", "Appears on hover")" Trigger="XFTooltipTrigger.Hover">
            <XFButton Variant="XFButtonVariant.Outline" Color="XFButtonColor.Info" Size="XFExtendedSize.Sm">Hover</XFButton>
        </XFTooltip>
        <XFTooltip Text="@T("Aparece no foco", "Appears on focus")" Trigger="XFTooltipTrigger.Focus">
            <XFButton Variant="XFButtonVariant.Outline" Color="XFButtonColor.Info" Size="XFExtendedSize.Sm">Focus</XFButton>
        </XFTooltip>
        <XFTooltip Text="@T("Hover e foco", "Hover and focus")" Trigger="XFTooltipTrigger.HoverFocus">
            <XFButton Variant="XFButtonVariant.Outline" Color="XFButtonColor.Info" Size="XFExtendedSize.Sm">HoverFocus</XFButton>
        </XFTooltip>
    </XFStack>;

    // === 5. Delay ===
    private RenderFragment ExDelay() => @<XFStack Orientation="XFOrientation.Horizontal" Gap="3" Wrap="XFWrap.Wrap">
        <XFTooltip Text="@T("Delay 0ms — imediato", "Delay 0ms — immediate")" Delay="0">
            <XFButton Variant="XFButtonVariant.Ghost" Color="XFButtonColor.Neutral" Size="XFExtendedSize.Sm">0ms</XFButton>
        </XFTooltip>
        <XFTooltip Text="@T("Delay 500ms", "Delay 500ms")" Delay="500">
            <XFButton Variant="XFButtonVariant.Ghost" Color="XFButtonColor.Neutral" Size="XFExtendedSize.Sm">500ms</XFButton>
        </XFTooltip>
        <XFTooltip Text="@T("Delay 1000ms", "Delay 1000ms")" Delay="1000">
            <XFButton Variant="XFButtonVariant.Ghost" Color="XFButtonColor.Neutral" Size="XFExtendedSize.Sm">1000ms</XFButton>
        </XFTooltip>
    </XFStack>;

    // === 6. Arrows ===
    private RenderFragment ExArrows() => @<XFStack Orientation="XFOrientation.Horizontal" Gap="3" Wrap="XFWrap.Wrap">
        <XFTooltip Text="@T("Com seta direcional", "With directional arrow")" ShowArrow="true">
            <XFButton Variant="XFButtonVariant.Outline" Color="XFButtonColor.Success" Size="XFExtendedSize.Sm">@T("Com seta", "With arrow")</XFButton>
        </XFTooltip>
        <XFTooltip Text="@T("Sem seta", "Without arrow")" ShowArrow="false">
            <XFButton Variant="XFButtonVariant.Outline" Color="XFButtonColor.Warning" Size="XFExtendedSize.Sm">@T("Sem seta", "No arrow")</XFButton>
        </XFTooltip>
    </XFStack>;

    // === 7. Max Width ===
    private RenderFragment ExMaxWidth() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFTooltip Text="@T("Este é um tooltip com texto mais longo que demonstra o uso de MaxWidth para controlar a largura máxima do painel de dica.", "This is a tooltip with longer text demonstrating MaxWidth usage to control the maximum width of the hint panel.")" MaxWidth="250px">
            <XFButton Variant="XFButtonVariant.Outline" Color="XFButtonColor.Info" Size="XFExtendedSize.Sm">@T("Largura máxima", "Max width")</XFButton>
        </XFTooltip>
    </XFStack>;

    // === 8. Icons ===
    private RenderFragment ExIcons() => @<XFStack Orientation="XFOrientation.Horizontal" Gap="3" Wrap="XFWrap.Wrap">
        <XFTooltip Text="@T("Novo registro", "New record")">
            <XFButton Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Sm">
                @T("Novo", "New")
            </XFButton>
        </XFTooltip>
        <XFTooltip Text="@T("Editar registro", "Edit record")">
            <XFButton Variant="XFButtonVariant.Outline" Color="XFButtonColor.Primary" Size="XFExtendedSize.Sm">
                @T("Editar", "Edit")
            </XFButton>
        </XFTooltip>
