@page "/display/timeline"
@using XForge.DesignSystem.Components.DataDisplay.Timeline
@using XForge.DesignSystem.Core.Primitives
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFTimeline" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("2 orientacoes", "2 orientations")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Acessivel", "Accessible")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Sequencia de eventos, auditorias e historicos de processo.",
                               "Sequence of events, audits and process history.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("XFTimeline exibe eventos em sequencia vertical ou horizontal com pontos, conectores, icones, conteudo oposto e 6 tons semanticos.",
                               "XFTimeline displays events in vertical or horizontal sequence with dots, connectors, icons, opposite content and 6 semantic tones.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico. Interacoes requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderizacao.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Consideracoes", "Considerations")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor Server: eventos sao tratados via SignalR. Sem latencia adicional para componentes puramente renderizados.", "Blazor Server: events are handled via SignalR. No additional latency for purely rendered components.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor WebAssembly: eventos sao tratados diretamente no cliente. Mais responsivo.", "Blazor WebAssembly: events are handled directly on the client. More responsive.")</XFTypography>
                </XFStack>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 2)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 2)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Basico", "1. Basic"),
                T("Timeline vertical com 4 eventos de pedido.", "Vertical timeline with 4 order events."),
                ExBasic(), CodeBasic)

            @Example(T("2. Orientacoes", "2. Orientations"),
                T("Vertical e Horizontal com scroll.", "Vertical and horizontal with scroll."),
                ExOrientations(), CodeOrientations)

            @Example(T("3. Alinhamentos", "3. Alignments"),
                T("Start, Alternate e End.", "Start, Alternate and End."),
                ExAlignments(), CodeAlignments)

            @Example(T("4. Tons semanticos", "4. Semantic tones"),
                T("4 tons: Success, Warning, Danger, Primary.", "4 tones: Success, Warning, Danger, Primary."),
                ExTones(), CodeTones)

            @Example(T("5. Conteudo oposto e icones", "5. Opposite content and icons"),
                T("OppositeContent e Icon em cada item.", "OppositeContent and Icon on each item."),
                ExOpposite(), CodeOpposite)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Variantes", "Variants"), @<div>@NameValueTable(VariantRows, T("Variante", "Variant"), T("Caso de uso", "Use case"))</div>)
            @Section(T("Estados", "States"), @<div>@NameValueTable(StateRows, T("Estado", "State"), T("Comportamento", "Behavior"))</div>)
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("API XFTimelineItem", "XFTimelineItem API"), @<div>@ApiTableItem(ApiItemRows)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
            @Section(T("Seguranca", "Security"), @<div>@TileGrid(SecurityItems, 2)</div>)
            @Section(T("Internacionalizacao", "Internationalization"), @<div>@TileGrid(I18nItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
            @Section(T("Guia de migracao", "Migration Guide"), @<div>@NameValueTable(MigrationRows, T("Cenario", "Scenario"), T("Acao", "Action"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Arquitetura interna", "Internal Architecture"), @<div>@TileGrid(ArchitectureItems, 2)</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>

@code {
    private string ProductLabelText => T("Core Open Source", "Core Open Source");
    private string PageTitleText => "Timeline";
    private string PageStatusText => T("Estavel", "Stable");
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");

    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFTimeline Orientation="XFOrientation.Vertical" Align="XFTimelineAlign.Start" ShowConnector="true">
            <XFTimelineItem Title="@T("Pedido criado", "Order created")"
                            Timestamp="01/06 10:00"
                            Text="@T("Pedido #12345 criado pelo cliente Silva LTDA.", "Order #12345 created by client Silva LTDA.")" />
            <XFTimelineItem Title="@T("Pagamento aprovado", "Payment approved")"
                            Timestamp="01/06 10:05"
                            Text="@T("Pagamento de R$ 1.250,00 aprovado pelo gateway.", "Payment of R$ 1,250.00 approved by gateway.")" />
            <XFTimelineItem Title="@T("Em separacao", "In separation")"
                            Timestamp="01/06 14:30"
                            Text="@T("Pedido enviado para o setor de separacao.", "Order sent to separation sector.")">
                <Icon><XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Warning" Size="XFBadgeSize.Xs" Text="!" /></Icon>
            </XFTimelineItem>
            <XFTimelineItem Title="@T("Entregue", "Delivered")"
                            Timestamp="02/06 09:15"
                            Text="@T("Pedido entregue ao cliente com sucesso.", "Order successfully delivered to client.")">
                <Icon><XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Success" Size="XFBadgeSize.Xs" Text="OK" /></Icon>
            </XFTimelineItem>
        </XFTimeline>
    </XFStack>;

    private RenderFragment ExBasic() => @<div class="p-2">
        <XFTimeline Orientation="XFOrientation.Vertical" Align="XFTimelineAlign.Start" ShowConnector="true">
            <XFTimelineItem Title="@T("Pedido criado", "Order created")"
                            Timestamp="01/06/2026 10:00"
                            Text="@T("Pedido #12345 criado pelo cliente Silva LTDA.", "Order #12345 created by client Silva LTDA.")" />
            <XFTimelineItem Title="@T("Pagamento aprovado", "Payment approved")"
                            Timestamp="01/06/2026 10:05"
                            Text="@T("Pagamento de R$ 1.250,00 aprovado.", "Payment of R$ 1,250.00 approved.")" />
            <XFTimelineItem Title="@T("Em separacao", "In separation")"
                            Timestamp="01/06/2026 14:30"
                            Text="@T("Pedido enviado para o setor de separacao.", "Order sent to separation sector.")" />
            <XFTimelineItem Title="@T("Entregue", "Delivered")"
                            Timestamp="02/06/2026 09:15"
                            Text="@T("Pedido entregue ao cliente com sucesso.", "Order successfully delivered to client.")" />
        </XFTimeline>
    </div>;

    private RenderFragment ExOrientations() => @<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 p-2">
        <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted" Weight="XFTypographyWeight.Semibold">Vertical</XFTypography>
            <XFTimeline Orientation="XFOrientation.Vertical" Align="XFTimelineAlign.Start">
                <XFTimelineItem Title="@T("Requisicao recebida", "Request received")"
                                Timestamp="10:00"
                                Text="@T("Servidor recebeu a requisicao HTTP.", "Server received HTTP request.")" />
                <XFTimelineItem Title="@T("Processamento iniciado", "Processing started")"
                                Timestamp="10:01"
                                Text="@T("API iniciou o processamento dos dados.", "API started data processing.")" />
                <XFTimelineItem Title="@T("Resposta enviada", "Response sent")"
                                Timestamp="10:02"
                                Text="@T("Resposta 200 OK enviada ao cliente.", "Response 200 OK sent to client.")" />
            </XFTimeline>
        </XFStack>
        <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted" Weight="XFTypographyWeight.Semibold">Horizontal</XFTypography>
            <div class="max-w-sm">
                <XFTimeline Orientation="XFOrientation.Horizontal" Align="XFTimelineAlign.Start">
                    <XFTimelineItem Title="@T("Backup", "Backup")"
                                    Timestamp="06:00"
                                    Text="@T("Inicio do backup.", "Backup started.")" />
                    <XFTimelineItem Title="@T("Verificacao", "Verification")"
                                    Timestamp="06:30"
                                    Text="@T("Verificacao de integridade.", "Integrity check.")" />
                    <XFTimelineItem Title="@T("Concluido", "Completed")"
                                    Timestamp="07:15"
                                    Text="@T("Backup concluido.", "Backup completed.")" />
                </XFTimeline>
            </div>
        </XFStack>
    </div>;

    private RenderFragment ExAlignments() => @<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 p-2">
        <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted" Weight="XFTypographyWeight.Semibold">Start</XFTypography>
            <XFTimeline Orientation="XFOrientation.Vertical" Align="XFTimelineAlign.Start">
                <XFTimelineItem Title="@T("Analise", "Analysis")"
                                Timestamp="09:00"
                                Text="@T("Analise de requisitos.", "Requirements analysis.")" />
                <XFTimelineItem Title="@T("Desenvolvimento", "Development")"
                                Timestamp="09:30"
                                Text="@T("Desenvolvimento do modulo.", "Module development.")" />
                <XFTimelineItem Title="@T("Review", "Review")"
                                Timestamp="10:00"
                                Text="@T("Revisao de codigo.", "Code review.")" />
            </XFTimeline>
        </XFStack>
        <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted" Weight="XFTypographyWeight.Semibold">Alternate</XFTypography>
            <XFTimeline Orientation="XFOrientation.Vertical" Align="XFTimelineAlign.Alternate">
                <XFTimelineItem Title="@T("Analise", "Analysis")"
                                Timestamp="09:00"
                                Text="@T("Analise de requisitos.", "Requirements analysis.")" />
                <XFTimelineItem Title="@T("Desenvolvimento", "Development")"
                                Timestamp="09:30"
                                Text="@T("Desenvolvimento do modulo.", "Module development.")" />
                <XFTimelineItem Title="@T("Review", "Review")"
                                Timestamp="10:00"
                                Text="@T("Revisao de codigo.", "Code review.")" />
            </XFTimeline>
        </XFStack>
        <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted" Weight="XFTypographyWeight.Semibold">End</XFTypography>
            <XFTimeline Orientation="XFOrientation.Vertical" Align="XFTimelineAlign.End">
                <XFTimelineItem Title="@T("Analise", "Analysis")"
                                Timestamp="09:00"
                                Text="@T("Analise de requisitos.", "Requirements analysis.")" />
                <XFTimelineItem Title="@T("Desenvolvimento", "Development")"
                                Timestamp="09:30"
                                Text="@T("Desenvolvimento do modulo.", "Module development.")" />
                <XFTimelineItem Title="@T("Review", "Review")"
                                Timestamp="10:00"
                                Text="@T("Revisao de codigo.", "Code review.")" />
            </XFTimeline>
        </XFStack>
    </div>;

    private RenderFragment ExTones() => @<div class="p-2">
        <XFTimeline Orientation="XFOrientation.Vertical" Align="XFTimelineAlign.Start" ShowConnector="true">
            <XFTimelineItem Title="@T("Nf-e emitida", "Invoice issued")"
                            Timestamp="14/06/2026 08:00"
                            Text="@T("Nota fiscal eletronica #001928 emitida com sucesso.", "Electronic invoice #001928 issued successfully.")"
                            Tone="XFSemanticColor.Success">
                <Icon><XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Success" Size="XFBadgeSize.Xs" Text="OK" /></Icon>
            </XFTimelineItem>
            <XFTimelineItem Title="@T("Estoque abaixo", "Low stock")"
                            Timestamp="14/06/2026 09:15"
                            Text="@T("Produto Componente PC com estoque abaixo do minimo (5 unidades).", "Product Componente PC below minimum stock (5 units).")"
                            Tone="XFSemanticColor.Warning">
                <Icon><XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Warning" Size="XFBadgeSize.Xs" Text="!" /></Icon>
            </XFTimelineItem>
            <XFTimelineItem Title="@T("Falha de integracao", "Integration failure")"
                            Timestamp="14/06/2026 10:30"
                            Text="@T("Falha ao sincronizar com o gateway de pagamento.", "Failed to sync with payment gateway.")"
                            Tone="XFSemanticColor.Danger">
                <Icon><XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Danger" Size="XFBadgeSize.Xs" Text="X" /></Icon>
            </XFTimelineItem>
            <XFTimelineItem Title="@T("Novo usuario", "New user")"
                            Timestamp="14/06/2026 11:00"
                            Text="@T("Usuario maria.silva cadastrado no sistema.", "User maria.silva registered in the system.")"
                            Tone="XFSemanticColor.Primary">
                <Icon><XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Size="XFBadgeSize.Xs" Text="+" /></Icon>
            </XFTimelineItem>
        </XFTimeline>
    </div>;

    private RenderFragment ExOpposite() => @<div class="p-2">
        <XFTimeline Orientation="XFOrientation.Vertical" Align="XFTimelineAlign.Alternate" ShowConnector="true">
            <XFTimelineItem Title="@T("Compra aprovada", "Purchase approved")"
                            Timestamp="15/06/2026 09:00"
                            Text="@T("Compra de material de escritorio aprovada pelo gestor.", "Office supply purchase approved by manager.")"
                            Tone="XFSemanticColor.Success">
                <Icon><XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Success" Size="XFBadgeSize.Xs" Text="OK" /></Icon>
                <OppositeContent>
                    <XFTypography Variant="XFTypographyVariant.Caption" Weight="XFTypographyWeight.Semibold">R$ 450,00</XFTypography>
                </OppositeContent>
            </XFTimelineItem>
            <XFTimelineItem Title="@T("Reembolso processado", "Refund processed")"
                            Timestamp="15/06/2026 11:30"
                            Text="@T("Reembolso de despesas de viagem processado.", "Travel expense refund processed.")"
                            Tone="XFSemanticColor.Primary">
                <Icon><XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Size="XFBadgeSize.Xs" Text="$" /></Icon>
                <OppositeContent>
                    <XFTypography Variant="XFTypographyVariant.Caption" Weight="XFTypographyWeight.Semibold">R$ 1.280,50</XFTypography>
                </OppositeContent>
            </XFTimelineItem>
            <XFTimelineItem Title="@T("Pagamento pendente", "Pending payment")"
                            Timestamp="15/06/2026 14:00"
                            Text="@T("Pagamento aguardando aprovacao do financeiro.", "Payment awaiting finance approval.")"
                            Tone="XFSemanticColor.Warning">
                <Icon><XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Warning" Size="XFBadgeSize.Xs" Text="!" /></Icon>
                <OppositeContent>
                    <XFTypography Variant="XFTypographyVariant.Caption" Weight="XFTypographyWeight.Semibold">R$ 3.750,00</XFTypography>
                </OppositeContent>
            </XFTimelineItem>
        </XFTimeline>
    </div>;

    private RenderFragment Section(string title, RenderFragment content) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
        <Header><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography></Header>
        <ChildContent>@content</ChildContent>
    </XFCard>;

    private RenderFragment Example(string title, string description, RenderFragment preview, string codeText) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.None" AreaRestricted="false">
        <Header><div class="px-6 pt-6 pb-2">
            <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@description</XFTypography>
        </div></Header>
        <ChildContent><div class="flex flex-col">
            <div class="border-t border-border-light bg-surface-50/30 p-6">@preview</div>
            <div class="border-t border-border-light bg-surface-50 p-6">
                <XFCode Text="@codeText" Language="razor" Title="@CopyableCodeTitle" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" />
            </div>
        </div></ChildContent>
    </XFCard>;

    private RenderFragment Tile(DocTile item) => @<XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent>
        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <div class="flex items-center gap-4">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-primary/10 bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                <div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div>
            </div>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
        </XFStack>
    </ChildContent></XFCard>;

    private RenderFragment TileGrid(IReadOnlyList<DocTile> items, int columns) => @<XFGrid Cols="1" Md="@Math.Min(columns, 2)" Lg="@columns" Gap="4">@foreach (var item in items) { @Tile(item) }</XFGrid>;

    private RenderFragment WarningGrid(IReadOnlyList<DocTile> items) => @<XFGrid Cols="1" Md="2" Gap="4">@foreach (var item in items) {
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <div class="flex items-center gap-4">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-danger/10 bg-danger/10 text-danger" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                <div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div>
            </div>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
        </XFStack></ChildContent></XFCard>
    }</XFGrid>;

    private RenderFragment NameValueTable(IReadOnlyList<NameValueRow> rows, string nameHeader, string valueHeader) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader><XFTableRow><XFTableCell Header="true">@nameHeader</XFTableCell><XFTableCell Header="true">@valueHeader</XFTableCell></XFTableRow></XFTableHeader>
        <XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Value</XFTableCell></XFTableRow> }</XFTableBody>
    </XFTable>;

    private RenderFragment ApiTable(IReadOnlyList<ApiRow> rows) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Parametro", "Parameter")</XFTableCell><XFTableCell Header="true">Type</XFTableCell><XFTableCell Header="true">Default</XFTableCell><XFTableCell Header="true">@T("Descricao", "Description")</XFTableCell></XFTableRow></XFTableHeader>
        <XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Type</XFTableCell><XFTableCell><XFCode Text="@row.DefaultValue" /></XFTableCell><XFTableCell>@row.Description</XFTableCell></XFTableRow> }</XFTableBody>
    </XFTable>;

    private RenderFragment ApiTableItem(IReadOnlyList<ApiRow> rows) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Parametro", "Parameter")</XFTableCell><XFTableCell Header="true">Type</XFTableCell><XFTableCell Header="true">Default</XFTableCell><XFTableCell Header="true">@T("Descricao", "Description")</XFTableCell></XFTableRow></XFTableHeader>
        <XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Type</XFTableCell><XFTableCell><XFCode Text="@row.DefaultValue" /></XFTableCell><XFTableCell>@row.Description</XFTableCell></XFTableRow> }</XFTableBody>
    </XFTable>;

