@page "/navigation/toolbar"
@page "/components/toolbar"
@using XForge.DesignSystem.Components.Navigation.Toolbar
@using XForge.DesignSystem.Components.Button
@using XForge.DesignSystem.Services
@using XForge.DesignSystem.Components.Icon
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">

        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFToolbar" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("role=toolbar", "role=toolbar")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("4 variantes", "4 variants")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Teclado", "Keyboard")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Danger" Text="@T("WAI-ARIA", "WAI-ARIA")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Barra de ferramentas para ações densas, agrupadas e responsivas.",
                               "Toolbar for dense, grouped and responsive actions.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("XFToolbar implementa role=toolbar com navegação por teclado roving tabindex, grupos, separadores, orientação horizontal/vertical e suporte a ícones, texto e templates customizados.",
                               "XFToolbar implements role=toolbar with roving tabindex keyboard navigation, groups, separators, horizontal/vertical orientation and support for icons, text and custom templates.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts)
                            {
                                @Tile(item)
                            }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        <!-- ===== METADATA ===== -->
        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        <!-- ===== BLAZOR COMPAT ===== -->
        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observações", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições. Eventos via SignalR.", "Works without restrictions. Events via SignalR.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições em ambos os estágios.", "Works without restrictions in both stages.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Parcial", "Partial")" /></XFTableCell><XFTableCell>@T("Renderiza HTML base. Cliques e teclado requerem modo interativo.", "Renders base HTML. Clicks and keyboard require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependências JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente não utiliza JavaScript interop. É puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderização.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
            </XFStack>
        </div>)

        <!-- ===== OVERVIEW / PURPOSE / WHEN TO USE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visão geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Propósito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando não usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
        </XFStack>

        <!-- ===== DESIGN ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Princípios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 11 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Básico — formatação de texto", "1. Basic — text formatting"),
                T("Toolbar com botões de formatação (Negrito, Itálico, Sublinhado, Tachado) usando apenas ícones. Clique para ver o estado toggle.",
                 "Toolbar with formatting buttons (Bold, Italic, Underline, Strikethrough) using icons only. Click to see toggle state."),
                ExBasicToolbar(), CodeBasicToolbar)

            @Example(T("2. Com texto e ícone", "2. With text and icon"),
                T("Botões com texto e ícone para ações mais descritivas como Copiar, Colar e Recortar.",
                 "Buttons with text and icon for more descriptive actions like Copy, Paste and Cut."),
                ExTextIconToolbar(), CodeTextIconToolbar)

            @Example(T("3. Variantes", "3. Variants"),
                T("Quatro variantes visuais: Surface (padrão), Plain, Soft e Bordered para diferentes contextos.",
                 "Four visual variants: Surface (default), Plain, Soft and Bordered for different contexts."),
                ExVariants(), CodeVariants)

            @Example(T("4. Tamanhos", "4. Sizes"),
                T("Três tamanhos: Sm (32px), Md (36px) e Lg (44px) para diferentes densidades de UI.",
                 "Three sizes: Sm (32px), Md (36px) and Lg (44px) for different UI densities."),
                ExSizes(), CodeSizes)

            @Example(T("5. Grupos e separadores", "5. Groups and separators"),
                T("Agrupamento lógico com Kind=Group e separadores visuais com Kind=Separator.",
                 "Logical grouping with Kind=Group and visual separators with Kind=Separator."),
                ExGroupsSeparators(), CodeGroupsSeparators)

            @Example(T("6. Estado toggle/ativo", "6. Toggle/active state"),
                T("Botões com Active=true para indicar estado ativado. Use ItemClicked para alternar.",
                 "Buttons with Active=true to indicate activated state. Use ItemClicked to toggle."),
                ExToggleActive(), CodeToggleActive)

            @Example(T("7. Orientação vertical", "7. Vertical orientation"),
                T("Toolbar vertical para sidebars e painéis de ferramentas laterais.",
                 "Vertical toolbar for sidebars and side tool panels."),
                ExVertical(), CodeVertical)

            @Example(T("8. End items", "8. End items"),
                T("Itens à esquerda (Items) e à direita (EndItems) com StartContent/EndContent para layout editor.",
                 "Items on the left (Items) and right (EndItems) with StartContent/EndContent for editor layout."),
                ExEndItems(), CodeEndItems)

            @Example(T("9. Itens desabilitados", "9. Disabled items"),
                T("Alguns itens desabilitados individualmente via Disabled=true, plus componente Disabled.",
                 "Some items individually disabled via Disabled=true, plus component Disabled."),
                ExDisabledItems(), CodeDisabledItems)

            @Example(T("10. Evento ItemClicked", "10. ItemClicked event"),
                T("Toolbar interativa com callback. Clique em qualquer botão para ver o evento disparado.",
                 "Interactive toolbar with callback. Click any button to see the fired event."),
                ExItemClicked(), CodeEvent)

            @Example(T("11. ItemTemplate — renderização customizada", "11. ItemTemplate — custom rendering"),
                T("Template para customizar o render de cada item. Exemplo: badge de contagem no botão.",
                 "Template to customize each item's render. Example: count badge on button."),
                ExItemTemplate(), CodeItemTemplate)
        </XFStack>

        <!-- ===== VARIANTS / STATES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Variantes", "Variants"), @<div>@NameValueTable(VariantRows, T("Variante", "Variant"), T("Descrição", "Description"))</div>)
            @Section(T("Item Kinds", "Item Kinds"), @<div>@NameValueTable(KindRows, T("Tipo", "Kind"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <!-- ===== API ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API: XFToolbar", @<div>@ApiTable(ToolbarApiRows)</div>)
            @Section("API: XFToolbarItem", @<div>@ApiTable(ItemApiRows)</div>)
            @Section("API: XFToolbarItemEventArgs", @<div>@ApiTable(EventArgsApiRows)</div>)
        </XFStack>

        <!-- ===== EVENTS ===== -->
        @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Descrição", "Description"))</div>)

        <!-- ===== ACCESSIBILITY ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 3)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Ação", "Action"))</div>)
        </XFStack>

        <!-- ===== RESPONSIVENESS / PERFORMANCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 3)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 3)</div>)
        </XFStack>

        <!-- ===== ENTERPRISE / COMPOSITION / BEST PRACTICES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenários enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padrões de composição", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas práticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padrões", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <!-- ===== TOKENS / THEMES / SECURITY / TESTING ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("Design Tokens", @<div>@NameValueTable(TokenRows, T("Categoria", "Category"), T("Tokens", "Tokens"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Segurança", "Security"), @<div>@TileGrid(SecurityItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestRows, T("Tipo", "Type"), T("Cobertura", "Coverage"))</div>)
        </XFStack>

        <!-- ===== LIMITATIONS / RELATED / FAQ / CHANGELOG ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Limitações conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitação", "Limitation"), T("Detalhe", "Detail"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, "Version", T("Mudança", "Change"))</div>)
        </XFStack>

    </XFStack>
</XForgeDocsShell>

@code {
    private string ProductLabelText => "Core OSS";
    private string PageTitleText => "Toolbar";
    private string PageStatusText => "Premium";
    private string T(string pt, string en) => LanguageService.Text(pt, en);
    private static RenderFragment SvgIcon(string name) => builder => builder.AddMarkupContent(0, XFSvgIcons.GetWithSize(name, 16));

    // ==================== HERO PREVIEW ====================
    private RenderFragment HeroPreview() => @<XFToolbar Items="@HeroItems" AriaLabel="@T("Formatação de texto", "Text formatting")" />;

    private static readonly IReadOnlyList<XFToolbarItem> HeroItems = [
        new() { Id = "bold", AriaLabel = "Negrito", Icon = SvgIcon("bold") },
        new() { Id = "italic", AriaLabel = "Itálico", Icon = SvgIcon("italic") },
        new() { Id = "underline", AriaLabel = "Sublinhado", Icon = SvgIcon("underline") },
        new() { Kind = XFToolbarItemKind.Separator },
        new() { Id = "align-left", AriaLabel = "Alinhar à esquerda", Active = true, Icon = SvgIcon("align-left") },
        new() { Id = "align-center", AriaLabel = "Centralizar", Icon = SvgIcon("align-center") },
        new() { Id = "align-right", AriaLabel = "Alinhar à direita", Icon = SvgIcon("align-right") }
    ];

    // ==================== QUICK FACTS ====================
    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("role=toolbar", "role=toolbar"), T("Container semântico WAI-ARIA com navegação por teclado roving tabindex.", "WAI-ARIA semantic container with roving tabindex keyboard navigation."), "universal-access"),
        new(T("4 variantes", "4 variants"), T("Surface, Plain, Soft e Bordered para diferentes contextos visuais.", "Surface, Plain, Soft and Bordered for different visual contexts."), "palette"),
        new(T("3 tamanhos", "3 sizes"), T("Sm (32px), Md (36px), Lg (44px) para densidades diferentes.", "Sm (32px), Md (36px), Lg (44px) for different densities."), "ruler"),
        new(T("Grupos e separadores", "Groups & separators"), T("Kind=Group com aria-label e Kind=Separator com role=separator.", "Kind=Group with aria-label and Kind=Separator with role=separator."), "layer-group"),
        new(T("Sem JS", "No JS"), T("Navegação por teclado implementada em C# puro, sem interop.", "Keyboard navigation implemented in pure C#, no interop."), "bolt")
    ];

    // ==================== METADATA ====================
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFToolbar"),
        new("Namespace", "XForge.DesignSystem.Components.Navigation.Toolbar"),
        new("Package", "XForge.DesignSystem"),
        new("Category", "Navigation / Toolbar"),
        new("Status", T("Estável", "Stable")),
        new("Accessibility", T("role=toolbar, roving tabindex, aria-pressed, aria-disabled.", "role=toolbar, roving tabindex, aria-pressed, aria-disabled.")),
        new("Theme support", T("Light e dark via CSS variables.", "Light and dark via CSS variables."))
    ];

    // ==================== OVERVIEW ====================
    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("Container semântico", "Semantic container"), T("role=toolbar com aria-orientation para leitores de tela.", "role=toolbar with aria-orientation for screen readers."), "universal-access"),
        new(T("Navegação por teclado", "Keyboard navigation"), T("Roving tabindex: Arrow keys, Home, End, Enter, Space.", "Roving tabindex: Arrow keys, Home, End, Enter, Space."), "keyboard"),
        new(T("Layout flexível", "Flexible layout"), T("Itens à esquerda, direita e centro com StartContent/EndContent.", "Items left, right and center with StartContent/EndContent."), "arrows-left-right")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Ações densas", "Dense actions"), T("Muitas ações compactas em pouco espaço, como formatação de texto.", "Many compact actions in little space, like text formatting."), "bars"),
        new(T("Editor de rich text", "Rich text editor"), T("Toolbar padrão para editores com formatação, alinhamento e inserção.", "Standard toolbar for editors with formatting, alignment and insertion."), "pen"),
        new(T("Controles de mídia", "Media controls"), T("Play, pause, volume, fullscreen em players de vídeo/audio.", "Play, pause, volume, fullscreen in video/audio players."), "video")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Botões soltos sem container semântico, sem navegação por teclado.", "Loose buttons without semantic container, no keyboard navigation."), "xmark"),
        new(T("Depois", "After"), T("Container com role=toolbar, roving tabindex e grupos lógicos.", "Container with role=toolbar, roving tabindex and logical groups."), "check"),
        new(T("Acessibilidade", "Accessibility"), T("WAI-ARIA Toolbar Pattern implementado nativamente.", "WAI-ARIA Toolbar Pattern natively implemented."), "shield-check")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Editor de texto", "Text editor"), T("Formatação: negrito, itálico, alinhamento, listas.", "Formatting: bold, italic, alignment, lists."), "pen"),
        new(T("IDE/Code editor", "IDE/Code editor"), T("Botões de compilar, depurar, salvar, formatar código.", "Buttons for compile, debug, save, format code."), "code"),
        new(T("Dashboard", "Dashboard"), T("Filtros, ordenação e ações de exportação em tabelas.", "Filters, sorting and export actions in tables."), "chart-line-up")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Navegação principal", "Primary navigation"), T("Use XFRail ou XFSidebar para navegação principal.", "Use XFRail or XFSidebar for primary navigation."), "xmark"),
        new(T("Poucos botões", "Few buttons"), T("2-3 botões isolados não precisam de toolbar. Use XFButton direto.", "2-3 isolated buttons don't need toolbar. Use XFButton directly."), "circle"),
        new(T("Formulários", "Forms"), T("Toolbar não é para campos de input. Use XFStack com XFButton.", "Toolbar is not for input fields. Use XFStack with XFButton."), "triangle-exclamation")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new("div[role=toolbar]", T("Container com role=toolbar e aria-orientation.", "Container with role=toolbar and aria-orientation."), "code"),
        new("button[role=button]", T("Cada item de ação renderiza como button com aria-pressed/aria-disabled.", "Each action item renders as button with aria-pressed/aria-disabled."), "square"),
        new("span[role=separator]", T("Separador visual entre grupos de itens.", "Visual separator between item groups."), "minus"),
        new("div[role=group]", T("Grupo lógico com aria-label para agrupar itens relacionados.", "Logical group with aria-label to group related items."), "layer-group"),
        new("StartContent", T("Slot para conteúdo personalizado no início da toolbar.", "Slot for custom content at the start of the toolbar."), "square-plus"),
        new("EndContent", T("Slot para conteúdo personalizado no final da toolbar.", "Slot for custom content at the end of the toolbar."), "square-plus")
    ];

    // ==================== DESIGN ====================
    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(T("Densidade", "Density"), T("Toolbar maximiza ações por像素 de espaço disponível.", "Toolbar maximizes actions per pixel of available space."), "minimize"),
        new(T("Consistência", "Consistency"), T("Mesmos ícones e posições em todas as instâncias do mesmo editor.", "Same icons and positions across all instances of the same editor."), "arrows-rotate"),
        new(T("Acessibilidade", "Accessibility"), T("Roving tabindex garante navegação acessível por teclado.", "Roving tabindex ensures accessible keyboard navigation."), "universal-access")
    ];

    // ==================== EXAMPLES ====================

    // --- EX 1: BASIC ---
    private bool boldActive = false;
    private bool italicActive = false;
    private bool underlineActive = false;

    private RenderFragment ExBasicToolbar() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFToolbar Items="@BasicFormatItems" ItemClicked="OnBasicFormatClick" AriaLabel="@T("Formatação", "Formatting")" />
        <XFStack Orientation="XFOrientation.Horizontal" Gap="2">
            <XFBadge Variant="@(boldActive ? XFBadgeVariant.Solid : XFBadgeVariant.Soft)" Color="@(boldActive ? XFBadgeColor.Primary : XFBadgeColor.Secondary)" Text="B" />
            <XFBadge Variant="@(italicActive ? XFBadgeVariant.Solid : XFBadgeVariant.Soft)" Color="@(italicActive ? XFBadgeColor.Primary : XFBadgeColor.Secondary)" Text="I" />
            <XFBadge Variant="@(underlineActive ? XFBadgeVariant.Solid : XFBadgeVariant.Soft)" Color="@(underlineActive ? XFBadgeColor.Primary : XFBadgeColor.Secondary)" Text="U" />
        </XFStack>
    </XFStack>;

    private static readonly IReadOnlyList<XFToolbarItem> BasicFormatItems = [
        new() { Id = "bold", AriaLabel = "Negrito", Icon = SvgIcon("bold") },
        new() { Id = "italic", AriaLabel = "Itálico", Icon = SvgIcon("italic") },
        new() { Id = "underline", AriaLabel = "Sublinhado", Icon = SvgIcon("underline") },
        new() { Id = "strikethrough", AriaLabel = "Tachado", Icon = SvgIcon("strikethrough") }
    ];

    private void OnBasicFormatClick(XFToolbarItemEventArgs args)
    {
        switch (args.Id)
        {
            case "bold": boldActive = !boldActive; break;
            case "italic": italicActive = !italicActive; break;
            case "underline": underlineActive = !underlineActive; break;
        }
    }

    private const string CodeBasicToolbar = @"<XFToolbar Items=""@FormatItems"" ItemClicked=""OnFormatClick"" />

@code {
    private bool boldActive = false;
    private bool italicActive = false;
    private bool underlineActive = false;

    private static RenderFragment SvgIcon(string name) => builder =>
        builder.AddMarkupContent(0, XFSvgIcons.GetWithSize(name, 16));

    private static readonly IReadOnlyList<XFToolbarItem> FormatItems = [
        new() { Id = ""bold"", AriaLabel = ""Negrito"", Icon = SvgIcon(""bold"") },
        new() { Id = ""italic"", AriaLabel = ""Itálico"", Icon = SvgIcon(""italic"") },
        new() { Id = ""underline"", AriaLabel = ""Sublinhado"", Icon = SvgIcon(""underline"") },
        new() { Id = ""strikethrough"", AriaLabel = ""Tachado"", Icon = SvgIcon(""strikethrough"") }
    ];

    private void OnFormatClick(XFToolbarItemEventArgs args)
    {
        switch (args.Id)
        {
            case ""bold"": boldActive = !boldActive; break;
            case ""italic"": italicActive = !italicActive; break;
            case ""underline"": underlineActive = !underlineActive; break;
        }
    }
}";

    // --- EX 2: TEXT + ICON ---
    private static readonly IReadOnlyList<XFToolbarItem> TextIconItems = [
        new() { Id = "copy", Text = "Copy", AriaLabel = "Copy", Icon = SvgIcon("clipboard") },
        new() { Id = "paste", Text = "Paste", AriaLabel = "Paste", Icon = SvgIcon("clipboard") },
        new() { Id = "cut", Text = "Cut", AriaLabel = "Cut", Icon = SvgIcon("scissors") }
    ];

    private RenderFragment ExTextIconToolbar() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFTypography Variant="XFTypographyVariant.Body2" Weight="XFTypographyWeight.Semibold">@T("Ícone + Texto", "Icon + Text")</XFTypography>
        <XFToolbar Items="@TextIconItems" AriaLabel="@T("Área de transferência", "Clipboard")" />
    </XFStack>;

    private const string CodeTextIconToolbar = @"<XFToolbar Items=""@TextIconItems"" />

@code {
    private static RenderFragment SvgIcon(string name) => builder =>
        builder.AddMarkupContent(0, XFSvgIcons.GetWithSize(name, 16));

