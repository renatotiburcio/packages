    // --- EX 6: TOGGLE ---
    private bool toggleBold = true;
    private bool toggleItalic = false;
    private bool toggleUnderline = false;

    private RenderFragment ExToggleActive() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFToolbar Items="@ToggleItems" ItemClicked="OnToggleClick" AriaLabel="@T("Toggle", "Toggle")" />
        <XFStack Orientation="XFOrientation.Horizontal" Gap="2">
            <XFBadge Variant="@(toggleBold ? XFBadgeVariant.Solid : XFBadgeVariant.Soft)" Color="@(toggleBold ? XFBadgeColor.Primary : XFBadgeColor.Secondary)" Text="Negrito" />
            <XFBadge Variant="@(toggleItalic ? XFBadgeVariant.Solid : XFBadgeVariant.Soft)" Color="@(toggleItalic ? XFBadgeColor.Primary : XFBadgeColor.Secondary)" Text="Itálico" />
            <XFBadge Variant="@(toggleUnderline ? XFBadgeVariant.Solid : XFBadgeVariant.Soft)" Color="@(toggleUnderline ? XFBadgeColor.Primary : XFBadgeColor.Secondary)" Text="Sublinhado" />
        </XFStack>
    </XFStack>;

    private IReadOnlyList<XFToolbarItem> ToggleItems => [
        new() { Id = "t-bold", AriaLabel = "Negrito", Active = toggleBold, Icon = SvgIcon("bold") },
        new() { Id = "t-italic", AriaLabel = "Itálico", Active = toggleItalic, Icon = SvgIcon("italic") },
        new() { Id = "t-underline", AriaLabel = "Sublinhado", Active = toggleUnderline, Icon = SvgIcon("underline") }
    ];

    private void OnToggleClick(XFToolbarItemEventArgs args)
    {
        switch (args.Id)
        {
            case "t-bold": toggleBold = !toggleBold; break;
            case "t-italic": toggleItalic = !toggleItalic; break;
            case "t-underline": toggleUnderline = !toggleUnderline; break;
        }
    }

