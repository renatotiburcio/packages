@page "/display/pivot-datagrid"
@using XForge.DesignSystem.Core.Primitives
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFPivotDataGrid" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Agregacoes e cruzamento", "Aggregations and cross-tabulation")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Tabela dinamica para agregacoes, dimensoes e cruzamento de dados.",
                               "Dynamic table for aggregations, dimensions and cross-tabulation of data.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("Componente generico para pivot tables com 5 funcoes de agregacao, totais configuraveis, ordenacao customizavel e suporte a formatacao de valores.",
                               "Generic component for pivot tables with 5 aggregation functions, configurable totals, customizable sorting and value formatting support.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5 overflow-x-auto">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico.", "Renders as static HTML.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 6 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Sum por Departamento e Trimestre", "1. Sum by Department and Quarter"), T("Tabela pivot com agregacao Sum e totais por linha e coluna.", "Pivot table with Sum aggregation and totals by row and column."), ExBasic(), Code1)
            @Example(T("2. Contagem de Itens", "2. Item Count"), T("Agregacao Count para contar ocorrencias por dimensao.", "Count aggregation to count occurrences by dimension."), ExCount(), Code2)
            @Example(T("3. Media e Min/Max", "3. Average and Min/Max"), T("Media, minimo e maximo por categoria e mes.", "Average, minimum and maximum by category and month."), ExAverage(), Code3)
            @Example(T("4. Sem totais", "4. Without Totals"), T("Tabela sem linha e coluna de total.", "Table without total row and column."), ExNoTotals(), Code4)
            @Example(T("5. Formatacao de valores", "5. Value Formatting"), T("Formato personalizado de moeda e cultura especifica.", "Custom currency format and specific culture."), ExFormatting(), Code5)
            @Example(T("6. Vazio", "6. Empty State"), T("Estado vazio quando nao ha dados para exibir.", "Empty state when there is no data to display."), ExEmpty(), Code6)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string ProductLabelText => T("Core Open Source", "Core Open Source");
    private string PageTitleText => T("XFPivotDataGrid", "XFPivotDataGrid");
    private string PageStatusText => T("Documentacao completa", "Complete docs");
    private string T(string pt, string en) => LanguageService.Text(pt, en);
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");

    private sealed record SaleItem(string Region, string Quarter, double Amount);

    private readonly IReadOnlyList<SaleItem> SampleData = [
        new("Norte", "Q1", 1200),
        new("Norte", "Q2", 1800),
        new("Norte", "Q3", 900),
        new("Sul", "Q1", 2100),
        new("Sul", "Q2", 1500),
        new("Sul", "Q3", 2400),
        new("Leste", "Q1", 800),
        new("Leste", "Q2", 1100),
        new("Leste", "Q3", 1600),
        new("Oeste", "Q1", 1400),
        new("Oeste", "Q2", 950),
        new("Oeste", "Q3", 1700)
    ];

    // === HERO ===
    private RenderFragment HeroPreview() => @<div class="overflow-x-auto">
        <XFPivotDataGrid Items="SampleData"
                         RowSelector="@(item => item.Region)"
                         ColumnSelector="@(item => item.Quarter)"
                         ValueSelector="@(item => item.Amount)"
                         Aggregate="XFPivotAggregate.Sum"
                         ShowTotals="true"
                         RowHeader="@T("Regiao", "Region")"
                         TotalHeader="@T("Total", "Total")" />
    </div>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("5 funcoes de agregacao", "5 aggregation functions"), T("Sum, Count, Average, Min e Max.", "Sum, Count, Average, Min and Max."), "calculator"),
        new(T("Generico tipado", "Generic typed"), T("Funciona com qualquer tipo TItem.", "Works with any TItem type."), "cubes"),
        new(T("Totais configuraveis", "Configurable totals"), T("Totais por linha, coluna e grand total.", "Totals by row, column and grand total."), "table-cells")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFPivotDataGrid<TItem>"),
        new("Namespace", "XForge.DesignSystem.Components.DataDisplay.PivotDataGrid"),
        new("Package", "XForge.DesignSystem"),
        new("Category", "DataDisplay / PivotDataGrid"),
        new("Status", T("Estavel", "Stable")),
        new("Accessibility", T("role=table, scope=col, scope=row, caption sr-only.", "role=table, scope=col, scope=row, caption sr-only.")),
        new("Theme support", T("Light, dark e data-theme via tokens.", "Light, dark and data-theme via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("Pivot table", "Pivot table"), T("Tabela dinamica para cruzamento de dados.", "Dynamic table for cross-tabulation of data."), "table-cells"),
        new(T("Agregacoes", "Aggregations"), T("5 funcoes: Sum, Count, Average, Min, Max.", "5 functions: Sum, Count, Average, Min, Max."), "calculator"),
        new(T("Totais", "Totals"), T("Totais por linha, coluna e grand total.", "Totals by row, column and grand total."), "plus-square")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Relatorios", "Reports"), T("Cruzamento de vendas por regiao e periodo.", "Sales cross-tabulation by region and period."), "chart-bar"),
        new(T("Financeiro", "Financial"), T("Agregacao de despesas por categoria e mes.", "Expense aggregation by category and month."), "coins"),
        new(T("Logistica", "Logistics"), T("Quantidade de itens por tipo e destino.", "Item quantity by type and destination."), "truck")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Manuais ou planilhas para cruzamento de dados.", "Manual or spreadsheets for data cross-tabulation."), "xmark"),
        new(T("Depois", "After"), T("Tabela pivot automatica com agregacoes.", "Automatic pivot table with aggregations."), "check"),
        new(T("Acessibilidade", "Accessibility"), T("scope=col, scope=row e caption sr-only.", "scope=col, scope=row and caption sr-only."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Relatorios gerenciais", "Management reports"), T("Cruzamento de metricas por dimensoes.", "Cross-tabulation of metrics by dimensions."), "chart-bar"),
        new(T("Analise de dados", "Data analysis"), T("Agregacoes rapidas de conjuntos de dados.", "Quick aggregations of data sets."), "magnifying-glass")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Dados em tempo real", "Real-time data"), T("Use XFDataGrid com signalr para tempo real.", "Use XFDataGrid with signalr for real-time."), "bolt"),
        new(T("Edicao inline", "Inline editing"), T("Use XFDataGrid para edicao de celulas.", "Use XFDataGrid for cell editing."), "pen")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new("Caption", T("Caption sr-only para leitores de tela.", "Screen reader caption."), "tag"),
        new("Row Header", T("Cabecalho da linha com identificadores.", "Row header with identifiers."), "rows"),
        new("Column Header", T("Cabecalho da coluna com dimensoes.", "Column header with dimensions."), "table-columns"),
        new("Cell", T("Celula com valor agregado formatado.", "Cell with formatted aggregated value."), "square"),
        new("Total Row", T("Linha de total por linha.", "Total row per row."), "plus"),
        new("Total Column", T("Coluna de total por coluna.", "Total column per column."), "plus")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(T("Transparencia", "Transparency"), T("Mostra como os dados sao agregados.", "Shows how data is aggregated."), "eye"),
        new(T("Flexibilidade", "Flexibility"), T("5 funcoes de agregacao para diferentes casos.", "5 aggregation functions for different cases."), "sliders"),
        new(T("Simplicidade", "Simplicity"), T("API declarativa com selectors.", "Declarative API with selectors."), "minimize")
    ];

    // === EXAMPLES ===
    private RenderFragment ExBasic() => @<div class="overflow-x-auto">
        <XFPivotDataGrid Items="SampleData"
                         RowSelector="@(item => item.Region)"
                         ColumnSelector="@(item => item.Quarter)"
                         ValueSelector="@(item => item.Amount)"
                         Aggregate="XFPivotAggregate.Sum"
                         ShowTotals="true"
                         RowHeader="@T("Regiao", "Region")"
                         TotalHeader="@T("Total", "Total")" />
    </div>;

    private RenderFragment ExCount() => @<div class="overflow-x-auto">
        <XFPivotDataGrid Items="SampleData"
                         RowSelector="@(item => item.Region)"
                         ColumnSelector="@(item => item.Quarter)"
                         Aggregate="XFPivotAggregate.Count"
                         ShowTotals="true"
                         RowHeader="@T("Regiao", "Region")"
                         TotalHeader="@T("Total", "Total")" />
    </div>;

    private RenderFragment ExAverage() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <div class="overflow-x-auto">
            <XFPivotDataGrid Items="SampleData"
                             RowSelector="@(item => item.Region)"
                             ColumnSelector="@(item => item.Quarter)"
                             ValueSelector="@(item => item.Amount)"
                             Aggregate="XFPivotAggregate.Average"
                             ShowTotals="true"
                             ValueFormat="N1"
                             RowHeader="@T("Regiao", "Region")"
                             TotalHeader="@T("Media", "Average")" />
        </div>
        <div class="overflow-x-auto">
            <XFPivotDataGrid Items="SampleData"
                             RowSelector="@(item => item.Region)"
                             ColumnSelector="@(item => item.Quarter)"
                             ValueSelector="@(item => item.Amount)"
                             Aggregate="XFPivotAggregate.Min"
                             ShowTotals="false"
                             RowHeader="@T("Regiao", "Region")"
                             TotalHeader="@T("Minimo", "Min")" />
        </div>
    </XFStack>;

    private RenderFragment ExNoTotals() => @<div class="overflow-x-auto">
        <XFPivotDataGrid Items="SampleData"
                         RowSelector="@(item => item.Region)"
                         ColumnSelector="@(item => item.Quarter)"
                         ValueSelector="@(item => item.Amount)"
                         Aggregate="XFPivotAggregate.Sum"
                         ShowTotals="false"
                         RowHeader="@T("Regiao", "Region")" />
    </div>;

    private RenderFragment ExFormatting() => @<div class="overflow-x-auto">
        <XFPivotDataGrid Items="SampleData"
                         RowSelector="@(item => item.Region)"
                         ColumnSelector="@(item => item.Quarter)"
                         ValueSelector="@(item => item.Amount)"
                         Aggregate="XFPivotAggregate.Sum"
                         ShowTotals="true"
                         ValueFormat="C2"
                         RowHeader="@T("Regiao", "Region")"
                         TotalHeader="@T("Total", "Total")" />
    </div>;

    private RenderFragment ExEmpty() => @<XFPivotDataGrid Items="@(Array.Empty<SaleItem>())"
                                                          RowSelector="@(item => item.Region)"
                                                          ColumnSelector="@(item => item.Quarter)"
                                                          EmptyText="@T("Nenhum dado para exibir.", "No data to display.")" />;

    private const string Code1 = @"<XFPivotDataGrid Items=""@salesData""
                     RowSelector=""@(item => item.Region)""
                     ColumnSelector=""@(item => item.Quarter)""
                     ValueSelector=""@(item => item.Amount)""
                     Aggregate=""XFPivotAggregate.Sum""
                     ShowTotals=""true""
                     RowHeader=""Regiao""
                     TotalHeader=""Total"" />";
    private const string Code2 = @"<XFPivotDataGrid Items=""@salesData""
                     RowSelector=""@(item => item.Region)""
                     ColumnSelector=""@(item => item.Quarter)""
                     Aggregate=""XFPivotAggregate.Count""
                     ShowTotals=""true""
                     RowHeader=""Regiao""
                     TotalHeader=""Total"" />";
    private const string Code3 = @"<XFPivotDataGrid Items=""@salesData""
                     RowSelector=""@(item => item.Region)""
                     ColumnSelector=""@(item => item.Quarter)""
                     ValueSelector=""@(item => item.Amount)""
                     Aggregate=""XFPivotAggregate.Average""
                     ShowTotals=""true""
                     ValueFormat=""N1""
                     RowHeader=""Regiao""
                     TotalHeader=""Media"" />";
    private const string Code4 = @"<XFPivotDataGrid Items=""@salesData""
                     RowSelector=""@(item => item.Region)""
                     ColumnSelector=""@(item => item.Quarter)""
                     ValueSelector=""@(item => item.Amount)""
                     Aggregate=""XFPivotAggregate.Sum""
                     ShowTotals=""false""
                     RowHeader=""Regiao"" />";
    private const string Code5 = @"<XFPivotDataGrid Items=""@salesData""
                     RowSelector=""@(item => item.Region)""
                     ColumnSelector=""@(item => item.Quarter)""
                     ValueSelector=""@(item => item.Amount)""
                     Aggregate=""XFPivotAggregate.Sum""
                     ShowTotals=""true""
                     ValueFormat=""C2""
                     RowHeader=""Regiao""
                     TotalHeader=""Total"" />";
    private const string Code6 = @"<XFPivotDataGrid Items=""@Array.Empty<SaleItem>()""
                     RowSelector=""@(item => item.Region)""
                     ColumnSelector=""@(item => item.Quarter)""
                     EmptyText=""Nenhum dado para exibir."" />";

    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("Items", "IReadOnlyList<TItem>", "[]", T("Dados para a tabela pivot.", "Data for the pivot table.")),
        new("RowSelector", "Func<TItem, string>?", T("Obrigatorio", "Required"), T("Seletor da dimensao de linha.", "Row dimension selector.")),
        new("ColumnSelector", "Func<TItem, string>?", T("Obrigatorio", "Required"), T("Seletor da dimensao de coluna.", "Column dimension selector.")),
        new("ValueSelector", "Func<TItem, double>?", "null", T("Seletor do valor numerico.", "Numeric value selector.")),
        new("Aggregate", "XFPivotAggregate", "Sum", T("Sum, Count, Average, Min, Max.", "Sum, Count, Average, Min, Max.")),
        new("ShowTotals", "bool", "true", T("Exibe linhas e colunas de total.", "Shows total rows and columns.")),
        new("RowHeader", "string", "Linha", T("Cabecalho da coluna de linha.", "Row column header.")),
        new("TotalHeader", "string", "Total", T("Cabecalho dos totais.", "Totals header.")),
        new("EmptyText", "string", "Nenhum dado para exibir.", T("Texto do estado vazio.", "Empty state text.")),
        new("Caption", "string?", "null", T("Caption sr-only para acessibilidade.", "Screen reader caption for accessibility.")),
        new("DefaultCaption", "string", "Tabela dinamica de dados", T("Caption padrao quando Caption e null.", "Default caption when Caption is null.")),
        new("ValueFormat", "string?", "N0", T("Formato de formato do valor (N0, C2, etc).", "Value format string (N0, C2, etc).")),
        new("Culture", "CultureInfo?", "null", T("Cultura para formatacao de numeros.", "Culture for number formatting.")),
        new("SortComparer", "IComparer<string>?", "null", T("Comparador para ordenacao das dimensoes.", "Comparer for dimension sorting."))
    ];

    private IReadOnlyList<NameValueRow> EventRows => [];

    // === ACCESSIBILITY ===
    private IReadOnlyList<DocTile> AccessibilityItems => [
        new(T("role=table", "role=table"), T("Tabela usa role=table para leitores de tela.", "Table uses role=table for screen readers."), "universal-access"),
        new(T("scope=col / scope=row", "scope=col / scope=row"), T("Cabecalhos usam scope para associacao.", "Headers use scope for association."), "tag"),
        new(T("Caption sr-only", "Caption sr-only"), T("Caption invisivel para navegadores visuais.", "Caption invisible for visual browsers."), "font"),
        new(T("Formato numerico", "Numeric format"), T("Valores formatados com tabular-nums para alinhamento.", "Values formatted with tabular-nums for alignment."), "hashtag")
    ];

    private IReadOnlyList<NameValueRow> KeyboardRows => [];

    // === RESPONSIVENESS ===
    private IReadOnlyList<DocTile> ResponsivenessItems => [
        new(T("Overflow-x-auto", "Overflow-x-auto"), T("Tabela faz scroll horizontal em telas estreitas.", "Table scrolls horizontally on narrow screens."), "mobile-screen"),
        new(T("Largura total", "Full width"), T("Tabela ocupa 100% do container.", "Table occupies 100% of container."), "maximize")
    ];

    // === PERFORMANCE ===
    private IReadOnlyList<DocTile> PerformanceItems => [
        new(T("Zero JS", "Zero JS"), T("Nenhum JavaScript interop.", "No JavaScript interop."), "bolt"),
        new(T("Render leve", "Light render"), T("Tabela HTML nativa sem wrappers.", "Native HTML table without wrappers."), "feather"),
        new(T("LINQ", "LINQ"), T("Agregacoes via LINQ, sem bibliotecas externas.", "Aggregations via LINQ, no external libraries."), "microchip")
    ];

    // === SCENARIOS ===
    private IReadOnlyList<DocTile> ScenarioItems => [
        new(T("Vendas regionais", "Regional sales"), T("Cruzamento de vendas por regiao e trimestre.", "Sales cross-tabulation by region and quarter."), "chart-bar"),
        new(T("Financeiro", "Financial"), T("Despesas por categoria e mes.", "Expenses by category and month."), "coins"),
        new(T("Estoque", "Inventory"), T("Quantidade de itens por tipo e armazem.", "Item quantity by type and warehouse."), "boxes-stacked")
    ];

    // === COMPOSITION ===
    private IReadOnlyList<DocTile> CompositionItems => [
        new(T("Pivot + Card", "Pivot + Card"), T("Tabela dentro de XFCard para contexto.", "Table inside XFCard for context."), "square"),
        new(T("Pivot + Badge", "Pivot + Badge"), T("Badges para indicar tipo de agregacao.", "Badges to indicate aggregation type."), "tag"),
        new(T("Pivot + Typography", "Pivot + Typography"), T("Tipografia para titulos e descricoes.", "Typography for titles and descriptions."), "font")
    ];

    // === BEST PRACTICES ===
    private IReadOnlyList<DocTile> BestPracticeItems => [
        new(T("ValueSelector para Sum/Avg", "ValueSelector for Sum/Avg"), T("Sempre defina ValueSelector quando usar Sum ou Average.", "Always set ValueSelector when using Sum or Average."), "sliders"),
