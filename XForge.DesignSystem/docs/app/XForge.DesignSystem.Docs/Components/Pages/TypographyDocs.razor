@page "/tokens/typography"
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@T("Core Open Source", "Core Open Source")"
                 Title="@T("Tipografia", "Typography")"
                 Status="@T("Documentação completa", "Complete docs")"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        @* ==================== HEADER ==================== *@
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="Design Tokens" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Tipografia", "Typography")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Escala tipográfica", "Type scale")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Leitura", "Readability")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Escala tipográfica para leitura, densidade, títulos e interfaces operacionais.",
                               "Type scale for readability, density, headings and operational interfaces.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("Os tokens de tipografia do XForge definem família, tamanho, peso e altura de linha como Tailwind utilities e CSS custom properties. Eles garantem hierarquia visual consistente em títulos, corpo de texto, labels e interfaces operacionais do ERP.",
                               "XForge typography tokens define family, size, weight and line-height as Tailwind utilities and CSS custom properties. They ensure consistent visual hierarchy in headings, body text, labels and operational ERP interfaces.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">@HeroPreview()</div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">@foreach (var item in QuickFacts) { @Tile(item) }</XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @* ==================== 1. METADATA ==================== *@
        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @* ==================== 2. BLAZOR SERVER / WASM ==================== *@
        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observações", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estático. Interações requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependências JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Tokens de tipografia são CSS puro. Não utilizam JavaScript interop. Funcionam identicamente em todos os modos de renderização.", "Typography tokens are pure CSS. They do not use JavaScript interop. They work identically in all rendering modes.")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Considerações", "Considerations")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor Server: sem latência adicional para tokens CSS.", "Blazor Server: no additional latency for CSS tokens.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor WebAssembly: aplicados diretamente pelo navegador.", "Blazor WebAssembly: applied directly by the browser.")</XFTypography>
                </XFStack>
            </XFStack>
        </div>)

        @* ==================== 3. OVERVIEW ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visão geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Propósito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando não usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 2)</div>)
        </XFStack>

        @* ==================== 4. VARIANTS & STATES ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Variantes", "Variants"), @<div>@NameValueTable(VariantRows, T("Variante", "Variant"), T("Uso", "Usage"))</div>)
            @Section(T("Estados", "States"), @<div>@NameValueTable(StateRows, T("Estado", "State"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        @* ==================== 5. VISUAL HIERARCHY & DESIGN ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Hierarquia visual", "Visual Hierarchy"), @<div>@TileGrid(VisualHierarchyItems, 3)</div>)
            @Section(T("Princípios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        @* ==================== 6-12. EXAMPLES ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Escala de títulos", "1. Heading scale"),
                T("H1 a H6 para hierarquia de conteúdo.", "H1 to H6 for content hierarchy."),
                HeadingScalePreview(), HeadingScaleCode)

            @Example(T("2. Corpo de texto", "2. Body text"),
                T("Body1, Body2 e Caption para texto corrido.", "Body1, Body2 and Caption for body text."),
                BodyTextPreview(), BodyTextCode)

            @Example(T("3. Pesos de fonte", "3. Font weights"),
                T("Regular, Medium, Semibold e Bold.", "Regular, Medium, Semibold and Bold."),
                FontWeightPreview(), FontWeightCode)

            @Example(T("4. Cores de texto", "4. Text colors"),
                T("Primary, Secondary, Muted e Inverse.", "Primary, Secondary, Muted and Inverse."),
                TextColorPreview(), TextColorCode)

            @Example(T("5. XFTypography component", "5. XFTypography component"),
                T("Componente XFTypography com todas as variantes.", "XFTypography component with all variants."),
                TypographyComponentPreview(), TypographyComponentCode)

            @Example(T("6. Densidade em formulários", "6. Density in forms"),
                T("Tipografia compacta para formulários densos.", "Compact typography for dense forms."),
                FormDensityPreview(), FormDensityCode)

            @Example(T("7. Dark mode", "7. Dark mode"),
                T("Cores de texto se adaptam ao tema escuro.", "Text colors adapt to dark theme."),
                DarkModeTypographyPreview(), DarkModeTypographyCode)
        </XFStack>

        @* ==================== 13. API ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        @* ==================== 14. ACCESSIBILITY & KEYBOARD ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Navegação enterprise por teclado", "Enterprise Keyboard Navigation"), @<div>@TileGrid(EnterpriseKeyboardItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        @* ==================== 15. RESPONSIVENESS & PERFORMANCE ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        @* ==================== 16. ENTERPRISE SCENARIOS & PATTERNS ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenários enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padrões de composição", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas práticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padrões", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        @* ==================== 17. TOKENS, THEMING, SECURITY, TESTING ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("Design Tokens", @<div>@NameValueTable(TokenRows, "Token", T("Propósito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Segurança", "Security Considerations"), @<div>@TileGrid(SecurityItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidência", "Evidence"))</div>)
        </XFStack>

        @* ==================== EXTRA ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Limitações conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitação", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Notas de migração", "Migration Notes"), @<div>@TileGrid(MigrationItems, 2)</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versão", "Version"), T("Mudança", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);

    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFTypography Variant="XFTypographyVariant.H1" Weight="XFTypographyWeight.Bold">H1 — Título principal</XFTypography>
        <XFTypography Variant="XFTypographyVariant.H3" Weight="XFTypographyWeight.Semibold">H3 — Subtítulo</XFTypography>
        <XFTypography Variant="XFTypographyVariant.Body1">Body1 — Texto de corpo padrão para leitura.</XFTypography>
        <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">Body2 — Texto secundário com cor atenuada.</XFTypography>
        <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">Caption — Texto de apoio e labels.</XFTypography>
    </XFStack>;

    private RenderFragment HeadingScalePreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
        <XFTypography Variant="XFTypographyVariant.H1" Weight="XFTypographyWeight.Bold">H1 — 36px / Bold</XFTypography>
        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">H2 — 30px / Bold</XFTypography>
        <XFTypography Variant="XFTypographyVariant.H3" Weight="XFTypographyWeight.Semibold">H3 — 24px / Semibold</XFTypography>
        <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">H4 — 20px / Semibold</XFTypography>
        <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Medium">H5 — 18px / Medium</XFTypography>
        <XFTypography Variant="XFTypographyVariant.H6" Weight="XFTypographyWeight.Medium">H6 — 16px / Medium</XFTypography>
    </XFStack>;

    private RenderFragment BodyTextPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFTypography Variant="XFTypographyVariant.Body1">@T("Body1 — Texto de corpo principal para parágrafos e conteúdo longo. Tamanho 16px com altura de linha confortável.", "Body1 — Main body text for paragraphs and long content. 16px size with comfortable line height.")</XFTypography>
        <XFTypography Variant="XFTypographyVariant.Body2">@T("Body2 — Texto secundário para descrições e metadados. Tamanho 14px.", "Body2 — Secondary text for descriptions and metadata. 14px size.")</XFTypography>
        <XFTypography Variant="XFTypographyVariant.Caption">@T("Caption — Texto de apoio para labels, timestamps e notas. Tamanho 12px.", "Caption — Supporting text for labels, timestamps and notes. 12px size.")</XFTypography>
    </XFStack>;

    private RenderFragment FontWeightPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
        <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Normal">Regular (400) — Texto de corpo</XFTypography>
        <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Medium">Medium (500) — Labels e subtítulos</XFTypography>
        <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">Semibold (600) — Títulos e destaque</XFTypography>
        <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Bold">Bold (700) — Títulos principais</XFTypography>
    </XFStack>;

    private RenderFragment TextColorPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Primary">Primary — Texto principal</XFTypography>
        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">Secondary — Texto secundário</XFTypography>
        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Muted">Muted — Texto atenuado</XFTypography>
        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Inverse" Class="bg-surface-900 rounded px-2 py-1">Inverse — Texto sobre fundo escuro</XFTypography>
    </XFStack>;

    private RenderFragment TypographyComponentPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@T("XFTypography — Variantes", "XFTypography — Variants")</XFTypography>
        <XFStack Orientation="XFOrientation.Horizontal" Gap="3" Wrap="XFWrap.Wrap">
            <XFTypography Variant="XFTypographyVariant.H1">H1</XFTypography>
            <XFTypography Variant="XFTypographyVariant.H2">H2</XFTypography>
            <XFTypography Variant="XFTypographyVariant.H3">H3</XFTypography>
            <XFTypography Variant="XFTypographyVariant.H4">H4</XFTypography>
            <XFTypography Variant="XFTypographyVariant.H5">H5</XFTypography>
            <XFTypography Variant="XFTypographyVariant.H6">H6</XFTypography>
        </XFStack>
        <XFStack Orientation="XFOrientation.Horizontal" Gap="3" Wrap="XFWrap.Wrap">
            <XFTypography Variant="XFTypographyVariant.Body1">Body1</XFTypography>
            <XFTypography Variant="XFTypographyVariant.Body2">Body2</XFTypography>
            <XFTypography Variant="XFTypographyVariant.Caption">Caption</XFTypography>
            <XFTypography Variant="XFTypographyVariant.Overline">Overline</XFTypography>
        </XFStack>
    </XFStack>;

    private RenderFragment FormDensityPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Formulário denso", "Dense form")</XFTypography>
        <XFStack Orientation="XFOrientation.Horizontal" Gap="3" Wrap="XFWrap.Wrap">
            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Sm"><ChildContent><XFTypography Variant="XFTypographyVariant.Body2">Label</XFTypography><XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">Valor</XFTypography></ChildContent></XFCard>
            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Sm"><ChildContent><XFTypography Variant="XFTypographyVariant.Body2">Label</XFTypography><XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">Valor</XFTypography></ChildContent></XFCard>
            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Sm"><ChildContent><XFTypography Variant="XFTypographyVariant.Body2">Label</XFTypography><XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">Valor</XFTypography></ChildContent></XFCard>
        </XFStack>
    </XFStack>;

    private RenderFragment DarkModeTypographyPreview() => @<XFStack Orientation="XFOrientation.Horizontal" Gap="4" Wrap="XFWrap.Wrap">
        <div class="rounded-lg p-3"><XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Primary">Light: text-primary</XFTypography></div>
        <div class="rounded-lg bg-surface-900 p-3"><XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Inverse">Dark: text-inverse</XFTypography></div>
    </XFStack>;

    private RenderFragment Section(string title, RenderFragment content) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg"><Header><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography></Header><ChildContent>@content</ChildContent></XFCard>;
    private string CopyableCodeTitle => T("Código copiável", "Copyable code");
    private RenderFragment Example(string title, string description, RenderFragment preview, string codeText) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.None" AreaRestricted="false"><Header><div class="px-6 pt-6"><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@description</XFTypography></div></Header><ChildContent><div class="grid"><div class="border-t border-border-light p-6">@preview</div><div class="border-t border-border-light bg-surface-50 p-6"><XFCode Text="@codeText" Language="razor" Title="@CopyableCodeTitle" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" /></div></div></ChildContent></XFCard>;
    private RenderFragment Tile(DocTile item) => @<XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true"><div class="flex items-center gap-4"><span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-primary/10 bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span><div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div></div><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography></XFStack></ChildContent></XFCard>;
    private RenderFragment TileGrid(IReadOnlyList<DocTile> items, int columns) => @<XFGrid Cols="1" Md="@Math.Min(columns, 2)" Lg="@columns" Gap="4">@foreach (var item in items) { @Tile(item) }</XFGrid>;
    private RenderFragment WarningGrid(IReadOnlyList<DocTile> items) => @<XFGrid Cols="1" Md="2" Gap="4">@foreach (var item in items) { <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true"><div class="flex items-center gap-4"><span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-danger/10 bg-danger/10 text-danger" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span><div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div></div><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography></XFStack></ChildContent></XFCard> }</XFGrid>;
    private RenderFragment NameValueTable(IReadOnlyList<NameValueRow> rows, string nameHeader, string valueHeader) => @<XFTable Striped="true" Hoverable="true" Compact="true"><XFTableHeader><XFTableRow><XFTableCell Header="true">@nameHeader</XFTableCell><XFTableCell Header="true">@valueHeader</XFTableCell></XFTableRow></XFTableHeader><XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Value</XFTableCell></XFTableRow> }</XFTableBody></XFTable>;
    private RenderFragment ApiTable(IReadOnlyList<ApiRow> rows) => @<XFTable Striped="true" Hoverable="true" Compact="true"><XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Parâmetro", "Parameter")</XFTableCell><XFTableCell Header="true">Type</XFTableCell><XFTableCell Header="true">Default</XFTableCell><XFTableCell Header="true">@T("Descrição", "Description")</XFTableCell></XFTableRow></XFTableHeader><XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Type</XFTableCell><XFTableCell><XFCode Text="@row.DefaultValue" /></XFTableCell><XFTableCell>@row.Description</XFTableCell></XFTableRow> }</XFTableBody></XFTable>;

    private string HeadingScaleCode => @"<XFTypography Variant=""XFTypographyVariant.H1"" Weight=""XFTypographyWeight.Bold"">
    H1 — Título principal
</XFTypography>
<XFTypography Variant=""XFTypographyVariant.H2"" Weight=""XFTypographyWeight.Bold"">
    H2 — Seção
</XFTypography>
<XFTypography Variant=""XFTypographyVariant.H3"" Weight=""XFTypographyWeight.Semibold"">
    H3 — Subseção
</XFTypography>
<XFTypography Variant=""XFTypographyVariant.H4"" Weight=""XFTypographyWeight.Semibold"">
    H4 — Card title
</XFTypography>";

    private string BodyTextCode => @"<XFTypography Variant=""XFTypographyVariant.Body1"">
    Body1 — Texto de corpo principal.
</XFTypography>
<XFTypography Variant=""XFTypographyVariant.Body2"">
