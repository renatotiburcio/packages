@page "/forms/password-strength"

@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@T("Core Open Source", "Core Open Source")"
                 Title="PasswordStrength"
                 Status="@T("Documentacao completa", "Complete docs")"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFPasswordStrength" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Strength Meter", "Strength Meter")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Rules", "Rules")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Common Block", "Common Block")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Input de senha com medidor de forca, regras visiveis e bloqueio de senhas comuns.", "Password input with strength meter, visible rules and common password blocking.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("XFPasswordStrength e o campo de senha com medidor de forca em tempo real, regras configuraveis (tamanho, maiuscula, minuscula, numero, especial), bloqueio de senhas comuns e toggle de visibilidade.", "XFPasswordStrength is the password field with real-time strength meter, configurable rules (length, uppercase, lowercase, number, special), common password blocking and visibility toggle.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts)
                            {
                                @Tile(item)
                            }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico. Interacoes requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderizacao.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Consideracoes", "Considerations")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor Server: eventos sao tratados via SignalR. Sem latencia adicional para componentes puramente renderizados.", "Blazor Server: events are handled via SignalR. No additional latency for purely rendered components.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor WebAssembly: eventos sao tratados diretamente no cliente. Mais responsivo.", "Blazor WebAssembly: events are handled directly on the client. More responsive.")</XFTypography>
                </XFStack>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 2)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                        @Example(T("Preview basico", "Basic Preview"),
                T("Senha com medidor de forca e regras.", "Password with strength meter and rules."),
                HeroPreview(), BasicCode)
            @Example(T("Regras customizadas", "Custom Rules"),
                T(@"Regras de tamanho, maiuscula e caracteres especiais.", "Length, uppercase and special character rules."),
                RulesPreview(), RulesCode)
            @Example(T("Cenarios enterprise", "Enterprise Scenarios"),
                T("Cadastro de usuario e troca de senha.", "User registration and password change."),
                EnterprisePreview(), EnterpriseCode)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("Design Tokens", @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>

@code {
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);

    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFPasswordStrength Label="@T("Senha", "Password")" Placeholder="@T("Digite uma senha forte", "Enter a strong password")" />
    </XFStack>;


    private IReadOnlyList<DocTile> QuickFacts =>
    [
        new(T("Medidor de forca", "Strength meter"), T("Score de 0-100 com niveis None, Weak, Fair, Good, Strong.", "Score 0-100 with None, Weak, Fair, Good, Strong levels."), "gauge"),
        new(T("Regras visiveis", "Visible rules"), T("Checklist de regras com status em tempo real.", "Rule checklist with real-time status."), "list-check"),
        new(T("Senhas comuns bloqueadas", "Common passwords blocked"), T("12 senhas comuns bloqueadas por padrao.", "12 common passwords blocked by default."), "shield-check")
    ];

    private IReadOnlyList<NameValueRow> MetadataRows =>
    [
        new("Component", "XFPasswordStrength"),
        new("Namespace", "XForge.DesignSystem.Components.Forms.PasswordStrength"),
        new("Package", "XForge.DesignSystem"),
        new("Category", "Forms / PasswordStrength"),
        new("Status", T("Estavel", "Stable")),
        new("Accessibility", T("Label, aria-label, toggle acessivel, regras anunciadas.", "Label, aria-label, accessible toggle, announced rules."))
    ];

    private IReadOnlyList<DocTile> OverviewItems =>
    [
        new(T("Forca em tempo real", "Real-time strength"), T("Score calculado a cada tecla com nivel visual.", "Score calculated on each keystroke with visual level."), "gauge"),
        new(T("Regras configuraveis", "Configurable rules"), T("Tamanho, maiuscula, minuscula, numero, especial, comum.", "Length, uppercase, lowercase, number, special, common."), "sliders"),
        new(T("Toggle de visibilidade", "Visibility toggle"), T("Mostrar/ocultar senha com botao acessivel.", "Show/hide password with accessible button."), "eye")
    ];

    private IReadOnlyList<DocTile> PurposeItems =>
    [
        new(T("Cadastro seguro", "Secure registration"), T("Garantir senhas fortes no cadastro de usuarios.", "Ensure strong passwords in user registration."), "user-plus"),
        new(T("Troca de senha", "Password change"), T("Validar nova senha antes de confirmar.", "Validate new password before confirming."), "key"),
        new(T("Politica de senha", "Password policy"), T("Aplicar regras de senha da organizacao.", "Apply organization password rules."), "shield-check")
    ];

    private IReadOnlyList<DocTile> ProblemItems =>
    [
        new(T("Antes", "Before"), T("Input de senha sem indicacao de forca ou regras.", "Password input without strength indication or rules."), "xmark"),
        new(T("Depois", "After"), T("Medidor visual com regras e bloqueio de senhas comuns.", "Visual meter with rules and common password blocking."), "check"),
        new(T("Risco reduzido", "Reduced risk"), T("Reduz senhas fracas e comprometidas.", "Reduces weak and compromised passwords."), "shield-check")
    ];

    private IReadOnlyList<DocTile> UseItems =>
    [
        new("ERP", T("Cadastro de usuarios com politica de senha.", "User registration with password policy."), "briefcase"),
        new("Administrativo", T("Troca de senha com validacao forte.", "Password change with strong validation."), "key"),
        new("Portal", T("Auto-cadastro com senha segura.", "Self-registration with secure password."), "globe")
    ];

    private IReadOnlyList<DocTile> AvoidItems =>
    [
        new(T("Senha simples", "Simple password"), T("Use XFTextInput para campos que nao sao senha.", "Use XFTextInput for non-password fields."), "triangle-exclamation"),
        new(T("OTP/PIN", "OTP/PIN"), T("Use XFOneTimeInput para codigos temporarios.", "Use XFOneTimeInput for temporary codes."), "eye")
    ];

    private IReadOnlyList<DocTile> AnatomyItems =>
    [
        new("Root", T("Container com label, field, strength, rules e helper.", "Container with label, field, strength, rules and helper."), "code"),
        new("Input", T("Campo de senha com toggle de visibilidade.", "Password field with visibility toggle."), "keyboard"),
        new("Strength bar", T("Barra colorida com nivel e score.", "Colored bar with level and score."), "gauge"),
        new("Rules list", T("Checklist com icones de status.", "Checklist with status icons."), "list-check")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems =>
    [
        new(T("Feedback constante", "Constant feedback"), T("Forca atualizada a cada tecla.", "Strength updated on each keystroke."), "eye"),
        new(T("Regras claras", "Clear rules"), T("Cada regra com icone de status.", "Each rule with status icon."), "list-check"),
        new(T("Senhas comuns", "Common passwords"), T("Bloqueio automatico de senhas conhecidas.", "Automatic blocking of known passwords."), "shield-check")
    ];

    private IReadOnlyList<ApiRow> ApiRows =>
    [
        new("Value", "string?", "null", T("Senha atual.", "Current password.")),
        new("ValueChanged", "EventCallback<string?>", "default", T("Two-way binding.", "Two-way binding.")),
        new("Change", "EventCallback<string?>", "default", T("Mudanca confirmada.", "Committed change.")),
        new("StrengthChanged", "EventCallback<XFPasswordStrengthChangedEventArgs>", "default", T("Quando forca muda.", "When strength changes.")),
        new("OnFocus", "EventCallback<FocusEventArgs>", "default", T("Ao focar.", "On focus.")),
        new("OnBlur", "EventCallback<FocusEventArgs>", "default", T("Ao desfocar.", "On blur.")),
        new("Label", "string?", "null", T("Texto do label.", "Label text.")),
        new("AriaLabel", "string?", "null", T("Label acessivel.", "Accessible label.")),
        new("Placeholder", "string?", "\"Digite uma senha\"", T("Placeholder.", "Placeholder.")),
        new("HelperText", "string?", "null", T("Texto de ajuda.", "Helper text.")),
        new("AutoComplete", "string", "\"new-password\"", T("Autocomplete.", "Autocomplete.")),
        new("Immediate", "bool", "true", T("Atualiza a cada tecla.", "Updates on each keystroke.")),
        new("ShowStrength", "bool", "true", T("Exibe barra de forca.", "Shows strength bar.")),
        new("ShowRules", "bool", "true", T("Exibe regras.", "Shows rules.")),
        new("ShowPasswordToggle", "bool", "true", T("Exibe toggle de visibilidade.", "Shows visibility toggle.")),
        new("MinimumLength", "int", "12", T("Tamanho minimo.", "Minimum length.")),
        new("RequireUppercase", "bool", "true", T("Exige maiuscula.", "Requires uppercase.")),
        new("RequireLowercase", "bool", "true", T("Exige minuscula.", "Requires lowercase.")),
        new("RequireNumber", "bool", "true", T("Exige numero.", "Requires number.")),
        new("RequireSpecialCharacter", "bool", "true", T("Exige caractere especial.", "Requires special character.")),
        new("RequireNotCommonPassword", "bool", "true", T("Bloqueia senhas comuns.", "Blocks common passwords.")),
        new("BlockedPasswords", "IEnumerable<string>?", "null", T("Senhas adicionais bloqueadas.", "Additional blocked passwords.")),
        new("ReadOnly", "bool", "false", T("Somente leitura.", "Read-only.")),
        new("Required", "bool", "false", T("Obrigatorio.", "Required.")),
        new("FullWidth", "bool", "true", T("Ocupa toda a largura.", "Fills width."))
    ];

    private IReadOnlyList<NameValueRow> EventRows =>
    [
        new("ValueChanged", T("A cada mudanca de senha.", "On each password change.")),
        new("Change", T("Senha confirmada.", "Password committed.")),
        new("StrengthChanged", T("Quando nivel/score muda.", "When level/score changes.")),
        new("OnFocus", T("Ao focar o campo.", "On field focus.")),
        new("OnBlur", T("Ao desfocar o campo.", "On field blur."))
    ];

    private IReadOnlyList<DocTile> AccessibilityItems =>
    [
        new("Label", T("Label associado ao input.", "Label associated to input."), "tag"),
        new("Toggle", T("aria-label para botao de visibilidade.", "aria-label for visibility button."), "eye"),
        new("Rules", T("Regras com status anunciado.", "Rules with announced status."), "list-check"),
        new("Strength", T("Nivel anunciado para leitores de tela.", "Level announced for screen readers."), "gauge")
    ];

    private IReadOnlyList<NameValueRow> KeyboardRows =>
    [
        new("Tab", T("Foca o campo de senha.", "Focuses password field.")),
        new("Shift+Tab", T("Controle anterior.", "Previous control.")),
        new("Enter/Space", T("Toggle de visibilidade quando focado.", "Visibility toggle when focused."))
    ];

    private IReadOnlyList<DocTile> ResponsivenessItems =>
    [
        new("FullWidth", T("Ocupa largura em mobile.", "Fills width on mobile."), "mobile-screen"),
        new("Rules", T("Regras empilham em telas pequenas.", "Rules stack on small screens."), "list-check")
    ];

    private IReadOnlyList<DocTile> PerformanceItems =>
    [
        new("Client-side", T("Avaliacao instantanea sem servidor.", "Instant evaluation without server."), "bolt"),
        new("Common list", T("HashSet para lookup O(1).", "HashSet for O(1) lookup."), "shield-check")
    ];

    private IReadOnlyList<DocTile> ScenarioItems =>
    [
        new("ERP", T("Cadastro de usuarios com politica forte.", "User registration with strong policy."), "briefcase"),
        new("Administrativo", T("Troca de senha obrigatoria.", "Mandatory password change."), "key"),
        new("Portal", T("Auto-cadastro de clientes.", "Client self-registration."), "globe"),
        new("RH", T("Cadastro de funcionarios.", "Employee registration."), "users"),
        new("API", T("Geracao de tokens e chaves.", "Token and key generation."), "code"),
        new("Seguranca", T("Auditoria de politica de senhas.", "Password policy audit."), "shield-check")
    ];

    private IReadOnlyList<DocTile> CompositionItems =>
    [
        new("Formularios", T("Use com XFEditForm para validacao.", "Use with XFEditForm for validation."), "file-lines"),
        new("Dialog", T("Use em modais de troca de senha.", "Use in password change modals."), "window-restore"),
        new("Card", T("Use em cards de cadastro.", "Use in registration cards."), "square")
    ];

    private IReadOnlyList<DocTile> BestPracticeItems =>
    [
        new("MinimumLength 12+", T("Nunca menos de 12 caracteres.", "Never less than 12 characters."), "shield-check"),
        new("Common block", T("Mantenha RequireNotCommonPassword=true.", "Keep RequireNotCommonPassword=true."), "shield-check"),
        new("ShowRules", T("Sempre mostre regras para orientar o usuario.", "Always show rules to guide the user."), "list-check")
    ];

    private IReadOnlyList<DocTile> AntiPatternItems =>
    [
        new("Minimo curto", T("Nao aceite menos de 8 caracteres.", "Do not accept less than 8 characters."), "xmark"),
        new("Sem regras", T("Sempre mostre as regras ativas.", "Always show active rules."), "eye-slash")
    ];


    private IReadOnlyList<NameValueRow> TokenRows =>
    [
        new("colors", T("bg-success, bg-primary, bg-warning, bg-danger por nivel.", "bg-success, bg-primary, bg-warning, bg-danger by level.")),
        new("typography", T("text-sm para input e regras.", "text-sm for input and rules.")),
        new("spacing", T("h-10, px-3.5, gap-2.", "h-10, px-3.5, gap-2."))
    ];

    private IReadOnlyList<DocTile> ThemeItems =>
    [
        new("data-theme", T("Light e dark via CSS variables.", "Light and dark via CSS variables."), "moon"),
        new("Contraste", T("AA em ambos temas.", "AA in both themes."), "eye")
    ];

    private IReadOnlyList<NameValueRow> TestingRows =>
    [
        new("Unit", T("Render, forca, regras, toggle, senhas comuns.", "Render, strength, rules, toggle, common passwords.")),
        new("Accessibility", T("Label, toggle aria-label, regras.", "Label, toggle aria-label, rules."))
    ];

    private IReadOnlyList<NameValueRow> LimitationRows =>
    [
        new(T("Sem confirmacao", "No confirmation"), T("Nao tem campo de confirmacao de senha.", "No password confirmation field.")),
        new(T("Score simplificado", "Simplified score"), T("Score baseado em regras, nao em entropia.", "Score based on rules, not entropy."))
    ];

    private IReadOnlyList<DocTile> RelatedComponentItems =>
    [
        new("XFTextInput", T("Input de texto generico.", "Generic text input."), "font"),
        new("XFOneTimeInput", T("Input de OTP/PIN.", "OTP/PIN input."), "key"),
        new("XFField", T("Wrapper de campo.", "Field wrapper."), "tag")
    ];

    private IReadOnlyList<NameValueRow> FaqRows =>
    [
        new(T("Senhas bloqueadas?", "Blocked passwords?"), T("12 comuns por padrao + BlockedPasswords custom.", "12 common by default + custom BlockedPasswords.")),
        new(T("Niveis de forca?", "Strength levels?"), T("None, Weak (<50), Fair (50-74), Good (75-99), Strong (100).", "None, Weak (<50), Fair (50-74), Good (75-99), Strong (100)."))
    ];

    private IReadOnlyList<NameValueRow> ChangelogRows =>
    [
        new("2026-05-26", T("Pagina criada no padrao enterprise.", "Page created in enterprise standard."))
    ];

    private RenderFragment RulesPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFPasswordStrength Label=@T("Senha com regras strictas", "Password with strict rules") MinimumLength="16" RequireUppercase="true" RequireLowercase="true" RequireNumber="true" RequireSpecialCharacter="true" />
    </XFStack>;

    private RenderFragment EnterprisePreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFPasswordStrength Label=@T("Nova senha", "New password") Placeholder=@T("Minimo 12 caracteres", "Minimum 12 characters") />
    </XFStack>;


    private string BasicCode => @T(
        "<XFPasswordStrength Label=\"Senha\" Placeholder=\"Digite uma senha forte\" />",
        "<XFPasswordStrength Label=\"Password\" Placeholder=\"Enter a strong password\" />");

    private string RulesCode => @T(
        "<XFPasswordStrength MinimumLength=\"16\" RequireUppercase=\"true\" RequireSpecialCharacter=\"true\" />",
        "<XFPasswordStrength MinimumLength=\"16\" RequireUppercase=\"true\" RequireSpecialCharacter=\"true\" />");

    private string EnterpriseCode => @T(
        "<XFPasswordStrength Label=\"Nova senha\" Placeholder=\"Minimo 12 caracteres\" />",
        "<XFPasswordStrength Label=\"New password\" Placeholder=\"Minimum 12 characters\" />");


    private RenderFragment Section(string title, RenderFragment content) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
        <Header><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography></Header>
        <ChildContent>@content</ChildContent>
    </XFCard>;

    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");

    private RenderFragment Example(string title, string description, RenderFragment preview, string codeText) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.None" AreaRestricted="false">
        <Header>
            <div class="px-6 pt-6">
                <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@description</XFTypography>
            </div>
        </Header>
        <ChildContent>
            <div class="grid">
                <div class="border-t border-border-light p-6">@preview</div>
                <div class="border-t border-border-light bg-surface-50 p-6">
                    <XFCode Text="@codeText" Language="razor" Title="@CopyableCodeTitle" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" />
                </div>
            </div>
        </ChildContent>
    </XFCard>;

    private RenderFragment Tile(DocTile item) => @<XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
        <ChildContent>
            <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                <div class="flex items-center gap-4">
                    <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-primary/10 bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                    <div class="min-w-0">
                        <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography>
                    </div>
                </div>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
            </XFStack>
        </ChildContent>
    </XFCard>;

    private RenderFragment TileGrid(IReadOnlyList<DocTile> items, int columns) => @<XFGrid Cols="1" Md="@Math.Min(columns, 2)" Lg="@columns" Gap="4">
        @foreach (var item in items)
        {
            @Tile(item)
        }
    </XFGrid>;

    private RenderFragment WarningGrid(IReadOnlyList<DocTile> items) => @<XFGrid Cols="1" Md="2" Gap="4">
        @foreach (var item in items)
        {
            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
                <ChildContent>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                        <div class="flex items-center gap-4">
                            <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-danger/10 bg-danger/10 text-danger" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                            <div class="min-w-0">
                                <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography>
                            </div>
                        </div>
                        <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
                    </XFStack>
                </ChildContent>
            </XFCard>
        }
    </XFGrid>;

    private RenderFragment NameValueTable(IReadOnlyList<NameValueRow> rows, string nameHeader, string valueHeader) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader>
            <XFTableRow>
                <XFTableCell Header="true">@nameHeader</XFTableCell>
                <XFTableCell Header="true">@valueHeader</XFTableCell>
            </XFTableRow>
        </XFTableHeader>
        <XFTableBody>
            @foreach (var row in rows)
            {
                <XFTableRow>
                    <XFTableCell><XFCode Text="@row.Name" /></XFTableCell>
                    <XFTableCell>@row.Value</XFTableCell>
                </XFTableRow>
            }
        </XFTableBody>
    </XFTable>;

    private RenderFragment ApiTable(IReadOnlyList<ApiRow> rows) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader>
            <XFTableRow>
                <XFTableCell Header="true">@T("Parametro", "Parameter")</XFTableCell>
                <XFTableCell Header="true">Type</XFTableCell>
                <XFTableCell Header="true">Default</XFTableCell>
                <XFTableCell Header="true">@T("Descricao", "Description")</XFTableCell>
            </XFTableRow>
        </XFTableHeader>
        <XFTableBody>
            @foreach (var row in rows)
            {
                <XFTableRow>
                    <XFTableCell><XFCode Text="@row.Name" /></XFTableCell>
                    <XFTableCell>@row.Type</XFTableCell>
                    <XFTableCell><XFCode Text="@row.DefaultValue" /></XFTableCell>
                    <XFTableCell>@row.Description</XFTableCell>
                </XFTableRow>
            }
        </XFTableBody>
    </XFTable>;

    private sealed record DocTile(string Title, string Description, string Icon);
    private sealed record NameValueRow(string Name, string Value);
    private sealed record ApiRow(string Name, string Type, string DefaultValue, string Description);
}
