@page "/display/chart"
@page "/components/chart"
@using XForge.DesignSystem.Components.DataDisplay.Chart
@using XForge.DesignSystem.Core.Primitives
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="Core OSS"
                 Title="Chart"
                 Status="Premium"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">

        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFChart" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="ECharts" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("17 tipos", "17 types")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Enterprise", "Enterprise")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Graficos enterprise com 17 tipos, multi-series, anotacoes e exportacao.", "Enterprise charts with 17 types, multi-series, annotations and export.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("Line, Bar, Pie, Scatter, Candlestick, Radar, Heatmap, Graph, Tree, Treemap, Sunburst, Sankey, Funnel, Gauge, ThemeRiver, Calendar, Chord — todos com ECharts, acessibilidade e data-table sr-only.",
                               "Line, Bar, Pie, Scatter, Candlestick, Radar, Heatmap, Graph, Tree, Treemap, Sunburst, Sankey, Funnel, Gauge, ThemeRiver, Calendar, Chord — all with ECharts, accessibility and sr-only data table.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section(T("Blazor Server e Blazor WebAssembly", "Blazor Server and Blazor WebAssembly"), @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona com prerender-safe guards.", "Works with prerender-safe guards.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona com prerender-safe guards no primeiro render.", "Works with prerender-safe guards on first render.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Parcial", "Partial")" /></XFTableCell><XFTableCell>@T("Renderiza HTML base. JS interop indisponivel durante prerender.", "Renders base HTML. JS interop unavailable during prerender.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("JS Interop", "JS Interop")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Arquivo JS: xf-chart.js — importa Apache ECharts dinamicamente, inicializa instancia do grafico com render() e gerencia dispose seguro.", "JS file: xf-chart.js — dynamically imports Apache ECharts, initializes chart instance with render() and manages safe dispose.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Quando carrega: OnAfterRenderAsync.", "When loaded: OnAfterRenderAsync.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Prerender seguro: try/catch para InvalidOperationException e JSDisconnectedException.", "Prerender safe: try/catch for InvalidOperationException and JSDisconnectedException.")</XFTypography>
                </XFStack>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Consideracoes Blazor Server", "Blazor Server Considerations")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("JS interop via SignalR com latencia. Graficos grandes podem ter renderizacao inicial mais lenta.", "JS interop via SignalR with latency. Large charts may have slower initial rendering.")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Consideracoes Blazor WebAssembly", "Blazor WebAssembly Considerations")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("JS interop direto sem latencia de rede. Disponivel apos carregamento do WASM.", "Direct JS interop with no network latency. Available after WASM load.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Line chart", "1. Line chart"),
                T("Grafico de linha basico com dados simples e area fill.", "Basic line chart with simple data and area fill."),
                ExLine(), CodeLine)

            @Example(T("2. Bar chart", "2. Bar chart"),
                T("Grafico de barras vertical com labels de valor.", "Vertical bar chart with value labels."),
                ExBar(), CodeBar)

            @Example(T("3. Pie chart", "3. Pie chart"),
                T("Grafico de pizza donut com legenda e percentuais.", "Donut pie chart with legend and percentages."),
                ExPie(), CodePie)

            @Example(T("4. Multi-series", "4. Multi-series"),
                T("Multiplo series com tons semanticos diferentes.", "Multiple series with different semantic tones."),
                ExMultiSeries(), CodeMultiSeries)

            @Example(T("5. Scatter", "5. Scatter"),
                T("Grafico de dispersao para analise de correlacao.", "Scatter chart for correlation analysis."),
                ExScatter(), CodeScatter)

            @Example(T("6. Annotations e trendlines", "6. Annotations & trendlines"),
                T("Marcadores, linhas de meta e tendencia.", "Markers, target lines and trend lines."),
                ExAnnotations(), CodeAnnotations)

            @Example(T("7. Data zoom", "7. Data zoom"),
                T("Zoom por slider, interno ou ambos.", "Zoom via slider, inside or both."),
                ExDataZoom(), CodeDataZoom)

            @Example(T("8. Custom palette e formatter", "8. Custom palette & formatter"),
                T("Paleta de cores customizada e formatador de valores.", "Custom color palette and value formatter."),
                ExCustomPalette(), CodeCustomPalette)

            @Example(T("9. Tipos avancados", "9. Advanced types"),
                T("Radar, Funnel, Gauge e Treemap.", "Radar, Funnel, Gauge and Treemap."),
                ExAdvanced(), CodeAdvanced)

            @Example(T("10. Cenario enterprise", "10. Enterprise scenario"),
                T("Dashboard financeiro com receita, margem e KPIs.", "Financial dashboard with revenue, margin and KPIs."),
                ExEnterprise(), CodeEnterprise)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section("API — XFChartSeries", @<div>@ApiTable(SeriesApiRows)</div>)
            @Section("API — XFChartAnnotation", @<div>@ApiTable(AnnotationApiRows)</div>)
            @Section("API — XFChartTrendline", @<div>@ApiTable(TrendlineApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Tipos de grafico", "Chart Types"), @<div>@NameValueTable(ChartTypeRows, T("Tipo", "Type"), T("Descricao", "Description"))</div>)
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>

    </XFStack>
</XForgeDocsShell>

@code {
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);
    private string CopyableCodeTitle => T("Copiar codigo", "Copy code");

    // --- Data models ---
    private sealed record KpiItem(string Label, double Value);
    private sealed record SalesItem(string Month, double Revenue, double Cost);
    private sealed record ScatterPoint(string Label, double X, double Y);

    // --- Hero ---
    private RenderFragment HeroPreview() => @<div>
        <XFChart TItem="KpiItem"
                 Type="XFChartType.Line"
                 Data="@HeroData"
                 LabelSelector="@(i => i.Label)"
                 ValueSelector="@(i => i.Value)"
                 Title="@T("Receita mensal 2026", "Monthly revenue 2026")"
                 Description="@T("R$ milhoes", "R$ millions")"
                 AriaLabel="@T("Grafico de receita mensal", "Monthly revenue chart")"
                 Tone="XFSemanticColor.Primary"
                 ShowLegend="false"
                 ShowSummary="true"
                 ShowValueLabels="true" />
    </div>;

    private IReadOnlyList<KpiItem> HeroData => new[]
    {
        new KpiItem("Jan", 3.2), new KpiItem("Fev", 3.5), new KpiItem("Mar", 3.1),
        new KpiItem("Abr", 3.8), new KpiItem("Mai", 4.1), new KpiItem("Jun", 4.2)
    };

    // --- 1. Line ---
    private RenderFragment ExLine() => @<div>
        <XFChart TItem="KpiItem"
                 Type="XFChartType.Line"
                 Data="@LineData"
                 LabelSelector="@(i => i.Label)"
                 ValueSelector="@(i => i.Value)"
                 Title="@T("Vendas trimestrais", "Quarterly sales")"
                 AriaLabel="Line chart"
                 Tone="XFSemanticColor.Primary"
                 ShowLegend="false" />
    </div>;

    private IReadOnlyList<KpiItem> LineData => new[]
    {
        new KpiItem("Q1", 120), new KpiItem("Q2", 180), new KpiItem("Q3", 150), new KpiItem("Q4", 220)
    };

    // --- 2. Bar ---
    private RenderFragment ExBar() => @<div>
        <XFChart TItem="KpiItem"
                 Type="XFChartType.Bar"
                 Data="@BarData"
                 LabelSelector="@(i => i.Label)"
                 ValueSelector="@(i => i.Value)"
                 Title="@T("Vendas por regiao", "Sales by region")"
                 AriaLabel="Bar chart"
                 Tone="XFSemanticColor.Success"
                 ShowValueLabels="true"
                 ShowLegend="false" />
    </div>;

    private IReadOnlyList<KpiItem> BarData => new[]
    {
        new KpiItem("Sudeste", 450), new KpiItem("Sul", 280), new KpiItem("Nordeste", 190),
        new KpiItem("Centro-Oeste", 120), new KpiItem("Norte", 80)
    };

    // --- 3. Pie ---
    private RenderFragment ExPie() => @<div>
        <XFChart TItem="KpiItem"
                 Type="XFChartType.Pie"
                 Data="@PieData"
                 LabelSelector="@(i => i.Label)"
                 ValueSelector="@(i => i.Value)"
                 Title="@T("Distribuicao de custos", "Cost distribution")"
                 AriaLabel="Pie chart"
                 ShowLegend="true"
                 ShowValueLabels="true" />
    </div>;

    private IReadOnlyList<KpiItem> PieData => new[]
    {
        new KpiItem("Pessoal", 45), new KpiItem("Infraestrutura", 25),
        new KpiItem("Marketing", 15), new KpiItem("TI", 10), new KpiItem("Outros", 5)
    };

    // --- 4. Multi-series ---
    private RenderFragment ExMultiSeries() => @<div>
        <XFChart TItem="SalesItem"
                 Type="XFChartType.Line"
                 Data="@MultiData"
                 LabelSelector="@(i => i.Month)"
                 Series="@MultiSeries"
                 Title="@T("Receita vs Custo", "Revenue vs Cost")"
                 AriaLabel="Multi-series chart"
                 ShowLegend="true"
                 ShowValueLabels="false" />
    </div>;

    private IReadOnlyList<SalesItem> MultiData => new[]
    {
        new SalesItem("Jan", 320, 210), new SalesItem("Fev", 350, 230),
        new SalesItem("Mar", 310, 200), new SalesItem("Abr", 380, 250)
    };

    private IReadOnlyList<XFChartSeries<SalesItem>> MultiSeries => new[]
    {
        new XFChartSeries<SalesItem> { Name = "Receita", ValueSelector = i => i.Revenue, Tone = XFSemanticColor.Primary },
        new XFChartSeries<SalesItem> { Name = "Custo", ValueSelector = i => i.Cost, Tone = XFSemanticColor.Danger }
    };

    // --- 5. Scatter ---
    private RenderFragment ExScatter() => @<div>
        <XFChart TItem="ScatterPoint"
                 Type="XFChartType.Scatter"
                 Data="@ScatterData"
                 LabelSelector="@(i => i.Label)"
                 ValueSelector="@(i => i.Y)"
                 Title="@T("Correlacao preco x volume", "Price vs volume correlation")"
                 AriaLabel="Scatter chart"
                 Tone="XFSemanticColor.Info" />
    </div>;

    private IReadOnlyList<ScatterPoint> ScatterData => new[]
    {
        new ScatterPoint("A", 10, 8.04), new ScatterPoint("B", 8, 6.95),
        new ScatterPoint("C", 13, 7.58), new ScatterPoint("D", 9, 8.81),
        new ScatterPoint("E", 11, 8.33), new ScatterPoint("F", 14, 9.96),
        new ScatterPoint("G", 6, 7.24), new ScatterPoint("H", 4, 4.26)
    };

    // --- 6. Annotations ---
    private RenderFragment ExAnnotations() => @<div>
        <XFChart TItem="KpiItem"
                 Type="XFChartType.Line"
                 Data="@LineData"
                 LabelSelector="@(i => i.Label)"
                 ValueSelector="@(i => i.Value)"
                 Title="@T("Vendas com meta", "Sales with target")"
                 AriaLabel="Chart with annotations"
                 Tone="XFSemanticColor.Primary"
                 ShowLegend="false"
                 ShowValueLabels="true"
                 Annotations="@AnnotationData"
                 Trendlines="@TrendlineData" />
    </div>;

    private IReadOnlyList<XFChartAnnotation> AnnotationData => new[]
    {
        new XFChartAnnotation { Label = "Meta", Value = 200, Axis = XFChartAnnotationAxis.Y, Tone = XFSemanticColor.Warning }
    };

    private IReadOnlyList<XFChartTrendline> TrendlineData => new[]
    {
        new XFChartTrendline { Name = "Tendencia", StartIndex = 0, StartValue = 110, EndIndex = 3, EndValue = 230, Tone = XFSemanticColor.Success }
    };

    // --- 7. Data Zoom ---
    private RenderFragment ExDataZoom() => @<div>
        <XFChart TItem="KpiItem"
                 Type="XFChartType.Bar"
                 Data="@ZoomData"
                 LabelSelector="@(i => i.Label)"
                 ValueSelector="@(i => i.Value)"
                 Title="@T("Vendas mensais com zoom", "Monthly sales with zoom")"
                 AriaLabel="Chart with data zoom"
                 Tone="XFSemanticColor.Primary"
                 ShowLegend="false"
                 DataZoomMode="XFChartDataZoomMode.Slider" />
    </div>;

    private IReadOnlyList<KpiItem> ZoomData => new[]
    {
        new KpiItem("Jan", 120), new KpiItem("Fev", 150), new KpiItem("Mar", 180),
        new KpiItem("Abr", 140), new KpiItem("Mai", 200), new KpiItem("Jun", 170),
        new KpiItem("Jul", 220), new KpiItem("Ago", 190), new KpiItem("Set", 250),
        new KpiItem("Out", 210), new KpiItem("Nov", 280), new KpiItem("Dez", 300)
    };

    // --- 8. Custom Palette ---
    private RenderFragment ExCustomPalette() => @<div>
        <XFChart TItem="KpiItem"
                 Type="XFChartType.Bar"
                 Data="@BarData"
                 LabelSelector="@(i => i.Label)"
                 ValueSelector="@(i => i.Value)"
                 Title="@T("Paleta customizada", "Custom palette")"
                 AriaLabel="Custom palette chart"
                 Palette="@CustomColors"
                 ValueFormatter="@(v => $"R$ {v:N0}K")"
                 ShowLegend="false"
                 ShowValueLabels="true" />
    </div>;

    private IReadOnlyList<string> CustomColors => new[] { "#6366f1", "#8b5cf6", "#a78bfa", "#c4b5fd", "#ddd6fe" };

    // --- 9. Advanced Types ---
    private RenderFragment ExAdvanced() => @<XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
        <div>
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="Radar" />
            <XFChart TItem="KpiItem"
                     Type="XFChartType.Radar"
                     Data="@RadarData"
                     LabelSelector="@(i => i.Label)"
                     ValueSelector="@(i => i.Value)"
                     Title="@T("Competencias", "Competencies")"
                     AriaLabel="Radar chart"
                     ShowLegend="false"
                     Class="mt-2" />
        </div>
        <div>
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="Funnel" />
            <XFChart TItem="KpiItem"
                     Type="XFChartType.Funnel"
                     Data="@FunnelData"
                     LabelSelector="@(i => i.Label)"
                     ValueSelector="@(i => i.Value)"
                     Title="@T("Pipeline de vendas", "Sales pipeline")"
                     AriaLabel="Funnel chart"
                     ShowLegend="false"
                     Class="mt-2" />
        </div>
        <div>
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="Gauge" />
            <XFChart TItem="KpiItem"
                     Type="XFChartType.Gauge"
                     Data="@GaugeData"
                     LabelSelector="@(i => i.Label)"
                     ValueSelector="@(i => i.Value)"
                     Title="@T("NPS Score", "NPS Score")"
                     AriaLabel="Gauge chart"
                     ShowLegend="false"
                     Class="mt-2" />
        </div>
        <div>
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Primary" Text="Treemap" />
            <XFChart TItem="KpiItem"
                     Type="XFChartType.Treemap"
                     Data="@BarData"
                     LabelSelector="@(i => i.Label)"
                     ValueSelector="@(i => i.Value)"
                     Title="@T("Receita por regiao", "Revenue by region")"
                     AriaLabel="Treemap chart"
                     ShowLegend="false"
                     Class="mt-2" />
        </div>
    </XFStack>;

    private IReadOnlyList<KpiItem> RadarData => new[]
    {
        new KpiItem("Tecnico", 90), new KpiItem("Comunicacao", 80), new KpiItem("Lideranca", 70),
        new KpiItem("Inovacao", 85), new KpiItem("Colaboracao", 95)
    };

    private IReadOnlyList<KpiItem> FunnelData => new[]
    {
        new KpiItem("Leads", 1000), new KpiItem("Qualificados", 600),
        new KpiItem("Propostas", 300), new KpiItem("Negociacao", 150), new KpiItem("Fechados", 80)
    };

    private IReadOnlyList<KpiItem> GaugeData => new[] { new KpiItem("NPS", 82) };

    // --- 10. Enterprise ---
    private RenderFragment ExEnterprise() => @<div>
        <XFChart TItem="SalesItem"
                 Type="XFChartType.Bar"
                 Data="@MultiData"
                 LabelSelector="@(i => i.Month)"
                 Series="@EnterpriseSeries"
                 Title="@T("Dashboard financeiro Q1-Q2", "Financial dashboard Q1-Q2")"
                 Description="@T("Receita, custo e margem em R$ milhoes", "Revenue, cost and margin in R$ millions")"
                 AriaLabel="Financial dashboard"
                 ShowLegend="true"
                 ShowSummary="true"
                 ShowValueLabels="true"
                 ExportEnabled="true"
                 ExportFileName="dashboard-financeiro"
                 ExportTitle="@T("Exportar PNG", "Export PNG")" />
    </div>;

    private IReadOnlyList<XFChartSeries<SalesItem>> EnterpriseSeries => new[]
    {
        new XFChartSeries<SalesItem> { Name = "Receita", ValueSelector = i => i.Revenue, Tone = XFSemanticColor.Primary },
        new XFChartSeries<SalesItem> { Name = "Custo", ValueSelector = i => i.Cost, Tone = XFSemanticColor.Danger }
    };

    // --- Helpers ---
    private RenderFragment Section(string title, RenderFragment content) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
        <Header><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography></Header>
        <ChildContent>@content</ChildContent>
    </XFCard>;

    private RenderFragment Example(string title, string description, RenderFragment preview, string codeText) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.None" AreaRestricted="false">
        <Header><div class="px-6 pt-6 pb-2">
            <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@description</XFTypography>
        </div></Header>
        <ChildContent><div class="flex flex-col">
            <div class="border-t border-border-light p-6">@preview</div>
            <div class="border-t border-border-light bg-surface-50 p-6">
                <XFCode Text="@codeText" Language="razor" Title="@CopyableCodeTitle" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" />
            </div>
        </div></ChildContent>
    </XFCard>;

    private RenderFragment Tile(DocTile item) => @<XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent>
        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <div class="flex items-center gap-4">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-primary/10 bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                <div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div>
            </div>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
        </XFStack>
    </ChildContent></XFCard>;

    private RenderFragment TileGrid(IReadOnlyList<DocTile> items, int columns) => @<XFGrid Cols="1" Md="@Math.Min(columns, 2)" Lg="@columns" Gap="4">@foreach (var item in items) { @Tile(item) }</XFGrid>;

    private RenderFragment WarningGrid(IReadOnlyList<DocTile> items) => @<XFGrid Cols="1" Md="2" Gap="4">@foreach (var item in items) {
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <div class="flex items-center gap-4">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-danger/10 bg-danger/10 text-danger" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                <div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div>
            </div>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
        </XFStack></ChildContent></XFCard>
    }</XFGrid>;

    private RenderFragment NameValueTable(IReadOnlyList<NameValueRow> rows, string nameHeader, string valueHeader) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader><XFTableRow><XFTableCell Header="true">@nameHeader</XFTableCell><XFTableCell Header="true">@valueHeader</XFTableCell></XFTableRow></XFTableHeader>
        <XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Value</XFTableCell></XFTableRow> }</XFTableBody>
    </XFTable>;

    private RenderFragment ApiTable(IReadOnlyList<ApiRow> rows) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader><XFTableRow>
            <XFTableCell Header="true">@T("Parametro", "Parameter")</XFTableCell>
            <XFTableCell Header="true">Type</XFTableCell>
            <XFTableCell Header="true">Default</XFTableCell>
            <XFTableCell Header="true">@T("Descricao", "Description")</XFTableCell>
        </XFTableRow></XFTableHeader>
        <XFTableBody>@foreach (var row in rows) {
            <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Type</XFTableCell><XFTableCell><XFCode Text="@row.DefaultValue" /></XFTableCell><XFTableCell>@row.Description</XFTableCell></XFTableRow>
        }</XFTableBody>
    </XFTable>;

