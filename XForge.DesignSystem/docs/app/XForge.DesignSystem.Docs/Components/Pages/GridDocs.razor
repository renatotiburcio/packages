@page "/layout/grid"
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        @* ==================== HEADER ==================== *@
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFGrid" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Grade CSS", "CSS Grid")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Layout responsivo", "Responsive layout")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Contêiner de células", "Cell container")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Sistema de grade CSS Grid para layouts responsivos, dashboards e composições complexas.",
                               "CSS Grid system for responsive layouts, dashboards and complex compositions.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("XFGrid é o componente de grade do XForge. Ele encapsula CSS Grid com parâmetros fortemente tipados para colunas, gaps, alinhamento e fluxo. Suporta breakpoints responsivos (Sm, Md, Lg, Xl) e enumerações semânticas para Flow, AlignItems e JustifyItems.",
                               "XFGrid is the XForge grid component. It wraps CSS Grid with strongly-typed parameters for columns, gaps, alignment and flow. Supports responsive breakpoints (Sm, Md, Lg, Xl) and semantic enumerations for Flow, AlignItems and JustifyItems.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">@HeroPreview()</div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">@foreach (var item in QuickFacts) { @Tile(item) }</XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @* ==================== 1. METADATA ==================== *@
        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @* ==================== 2. BLAZOR SERVER / WASM ==================== *@
        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observações", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estático. Interações requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependências JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente não utiliza JavaScript interop. É puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderização.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Considerações", "Considerations")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor Server: renderização é feita no servidor. CSS Grid é aplicado via classes Tailwind.", "Blazor Server: rendering is done on the server. CSS Grid is applied via Tailwind classes.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor WebAssembly: renderização é feita no cliente. Mesmo comportamento visual.", "Blazor WebAssembly: rendering is done on the client. Same visual behavior.")</XFTypography>
                </XFStack>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Exemplos de uso", "Usage Examples")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFCode Text="@InteractiveServerExample" Language="razor" Title="InteractiveServer" Variant="XFCodeVariant.Block" Copyable="true" />
                    <XFCode Text="@InteractiveWasmExample" Language="razor" Title="InteractiveWebAssembly" Variant="XFCodeVariant.Block" Copyable="true" />
                    <XFCode Text="@InteractiveAutoExample" Language="razor" Title="InteractiveAuto" Variant="XFCodeVariant.Block" Copyable="true" />
                </XFStack>
            </XFStack>
        </div>)

        @* ==================== 3. OVERVIEW ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visão geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Propósito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando não usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 2)</div>)
        </XFStack>

        @* ==================== 4. VARIANTS & STATES ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Variantes", "Variants"), @<div>@NameValueTable(VariantRows, T("Variante", "Variant"), T("Caso de uso", "Use case"))</div>)
            @Section(T("Estados", "States"), @<div>@NameValueTable(StateRows, T("Estado", "State"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        @* ==================== 5. VISUAL HIERARCHY & DESIGN ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Hierarquia visual", "Visual Hierarchy"), @<div>@TileGrid(VisualHierarchyItems, 3)</div>)
            @Section(T("Princípios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        @* ==================== 6-14. EXAMPLES ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Grade básica 3 colunas", "1. Basic 3-column grid"),
                T("Grid com 3 colunas iguais e gap padrão.", "Grid with 3 equal columns and default gap."),
                Basic3ColPreview(), Basic3ColCode)

            @Example(T("2. Grade responsiva", "2. Responsive grid"),
                T("Cols=1 no mobile, 2 no tablet, 4 no desktop.", "Cols=1 on mobile, 2 on tablet, 4 on desktop."),
                ResponsivePreview(), ResponsiveCode)

            @Example(T("3. Dashboard com cards", "3. Dashboard with cards"),
                T("Layout de dashboard com 4 cards em 2 colunas.", "Dashboard layout with 4 cards in 2 columns."),
                DashboardPreview(), DashboardCode)

            @Example(T("4. Grade com gaps customizados", "4. Custom gap grid"),
                T("RowGap e ColumnGap com tokens XFSizeToken.", "RowGap and ColumnGap with XFSizeToken tokens."),
                CustomGapPreview(), CustomGapCode)

            @Example(T("5. Alinhamento centralizado", "5. Centered alignment"),
                T("AlignItems=Center e JustifyItems=Center.", "AlignItems=Center and JustifyItems=Center."),
                CenteredAlignPreview(), CenteredAlignCode)

            @Example(T("6. Fluxo em coluna", "6. Column flow"),
                T("Flow=Column para empilhamento vertical.", "Flow=Column for vertical stacking."),
                ColumnFlowPreview(), ColumnFlowCode)

            @Example(T("7. Grade densa", "7. Dense grid"),
                T("Flow=Dense para preenchimento automático de lacunas.", "Flow=Dense for automatic gap filling."),
                DensePreview(), DenseCode)

            @Example(T("8. Lateral com sidebar", "8. Sidebar layout"),
                T("Grid 12 colunas com área principal e sidebar.", "12-column grid with main area and sidebar."),
                SidebarLayoutPreview(), SidebarLayoutCode)

            @Example(T("9. FullWidth com formulário", "9. FullWidth form"),
                T("FullWidth=true com formulário em 2 colunas.", "FullWidth=true with 2-column form."),
                FullWidthFormPreview(), FullWidthFormCode)
        </XFStack>

        @* ==================== 16. API ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Métodos", "Methods"), @<div>@NameValueTable(MethodRows, T("Método", "Method"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        @* ==================== 17. ACCESSIBILITY & KEYBOARD ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Navegação enterprise por teclado", "Enterprise Keyboard Navigation"), @<div>@TileGrid(EnterpriseKeyboardItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        @* ==================== 18. RESPONSIVENESS & PERFORMANCE ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        @* ==================== 19. ENTERPRISE SCENARIOS & PATTERNS ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenários enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padrões de composição", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Exemplos de integração", "Integration Examples"), @<div>@TileGrid(IntegrationItems, 2)</div>)
            @Section(T("Boas práticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padrões", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        @* ==================== 20. TOKENS, THEMING, SECURITY, TESTING ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("Design Tokens", @<div>@NameValueTable(TokenRows, "Token", T("Propósito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Segurança", "Security Considerations"), @<div>@TileGrid(SecurityItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidência", "Evidence"))</div>)
        </XFStack>

        @* ==================== EXTRA: LIMITATIONS, MIGRATION, RELATED, FAQ, CHANGELOG ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Limitações conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitação", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Notas de migração", "Migration Notes"), @<div>@TileGrid(MigrationItems, 2)</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versão", "Version"), T("Mudança", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string ProductLabelText => T("Core Open Source", "Core Open Source");
    private string PageTitleText => T("Grid", "Grid");
    private string PageStatusText => T("Documentação completa", "Complete docs");
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);

    // ==================== BLAZOR SECTION EXAMPLES ====================
    private string InteractiveServerExample => @"@page ""/erp/financeiro/dashboard""
@rendermode InteractiveServer
<XFGrid Cols=""3"" Gap=""4"">
    <XFCard><ChildContent><XFTypography>Card 1</XFTypography></ChildContent></XFCard>
    <XFCard><ChildContent><XFTypography>Card 2</XFTypography></ChildContent></XFCard>
    <XFCard><ChildContent><XFTypography>Card 3</XFTypography></ChildContent></XFCard>
</XFGrid>";

    private string InteractiveWasmExample => @"@page ""/erp/financeiro/dashboard""
@rendermode InteractiveWebAssembly
<XFGrid Cols=""3"" Gap=""4"">
    <XFCard><ChildContent><XFTypography>Card 1</XFTypography></ChildContent></XFCard>
    <XFCard><ChildContent><XFTypography>Card 2</XFTypography></ChildContent></XFCard>
    <XFCard><ChildContent><XFTypography>Card 3</XFTypography></ChildContent></XFCard>
</XFGrid>";

    private string InteractiveAutoExample => @"@page ""/erp/financeiro/dashboard""
@rendermode InteractiveAuto
<XFGrid Cols=""3"" Gap=""4"">
    <XFCard><ChildContent><XFTypography>Card 1</XFTypography></ChildContent></XFCard>
    <XFCard><ChildContent><XFTypography>Card 2</XFTypography></ChildContent></XFCard>
    <XFCard><ChildContent><XFTypography>Card 3</XFTypography></ChildContent></XFCard>
</XFGrid>";

    // ==================== HERO PREVIEW ====================
    private RenderFragment HeroPreview() => @<XFGrid Cols="3" Gap="4">
        <XFCard Variant="XFCardVariant.Filled"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="2"><XFTypography Weight="XFTypographyWeight.Semibold">@T("Vendas", "Sales")</XFTypography><XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Bold">R$ 124.500</XFTypography></XFStack></ChildContent></XFCard>
        <XFCard Variant="XFCardVariant.Filled"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="2"><XFTypography Weight="XFTypographyWeight.Semibold">@T("Pedidos", "Orders")</XFTypography><XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Bold">384</XFTypography></XFStack></ChildContent></XFCard>
        <XFCard Variant="XFCardVariant.Filled"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="2"><XFTypography Weight="XFTypographyWeight.Semibold">@T("Clientes", "Customers")</XFTypography><XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Bold">1.205</XFTypography></XFStack></ChildContent></XFCard>
    </XFGrid>;

    // ==================== EXAMPLE PREVIEWS ====================
    private RenderFragment Basic3ColPreview() => @<XFGrid Cols="3" Gap="4">
        <XFCard><ChildContent><XFTypography Variant="XFTypographyVariant.Body1">@T("Coluna 1", "Column 1")</XFTypography></ChildContent></XFCard>
        <XFCard><ChildContent><XFTypography Variant="XFTypographyVariant.Body1">@T("Coluna 2", "Column 2")</XFTypography></ChildContent></XFCard>
        <XFCard><ChildContent><XFTypography Variant="XFTypographyVariant.Body1">@T("Coluna 3", "Column 3")</XFTypography></ChildContent></XFCard>
    </XFGrid>;

    private RenderFragment ResponsivePreview() => @<XFGrid Cols="1" Sm="2" Md="3" Lg="4" Gap="4">
        <XFCard><ChildContent><XFTypography Variant="XFTypographyVariant.Body2">Mobile: 1</XFTypography></ChildContent></XFCard>
        <XFCard><ChildContent><XFTypography Variant="XFTypographyVariant.Body2">Sm: 2</XFTypography></ChildContent></XFCard>
        <XFCard><ChildContent><XFTypography Variant="XFTypographyVariant.Body2">Md: 3</XFTypography></ChildContent></XFCard>
        <XFCard><ChildContent><XFTypography Variant="XFTypographyVariant.Body2">Lg: 4</XFTypography></ChildContent></XFCard>
    </XFGrid>;

    private RenderFragment DashboardPreview() => @<XFGrid Cols="1" Md="2" Gap="4">
        <XFCard><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="2"><XFTypography Weight="XFTypographyWeight.Semibold">@T("Faturamento mensal", "Monthly revenue")</XFTypography><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Bold">R$ 482.000</XFTypography><XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Success">@T("+ 12% vs mês anterior", "+ 12% vs previous month")</XFTypography></XFStack></ChildContent></XFCard>
        <XFCard><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="2"><XFTypography Weight="XFTypographyWeight.Semibold">@T("Notas fiscais emitidas", "Invoices issued")</XFTypography><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Bold">1.847</XFTypography><XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Success">@T("+ 8% vs mês anterior", "+ 8% vs previous month")</XFTypography></XFStack></ChildContent></XFCard>
        <XFCard><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="2"><XFTypography Weight="XFTypographyWeight.Semibold">@T("Contas a pagar", "Accounts payable")</XFTypography><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Bold">R$ 128.300</XFTypography><XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Danger">@T("Vencimento: 15/06/2026", "Due: 06/15/2026")</XFTypography></XFStack></ChildContent></XFCard>
        <XFCard><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="2"><XFTypography Weight="XFTypographyWeight.Semibold">@T("Contas a receber", "Accounts receivable")</XFTypography><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Bold">R$ 256.700</XFTypography><XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Warning">@T("3 em atraso", "3 overdue")</XFTypography></XFStack></ChildContent></XFCard>
    </XFGrid>;

    private RenderFragment CustomGapPreview() => @<XFGrid Cols="2" RowGap="6" ColumnGap="4">
        <XFCard><ChildContent><XFTypography Variant="XFTypographyVariant.Body2">@T("RowGap=6, ColumnGap=4", "RowGap=6, ColumnGap=4")</XFTypography></ChildContent></XFCard>
        <XFCard><ChildContent><XFTypography Variant="XFTypographyVariant.Body2">@T("Espaçamento customizado", "Custom spacing")</XFTypography></ChildContent></XFCard>
        <XFCard><ChildContent><XFTypography Variant="XFTypographyVariant.Body2">@T("Entre linhas e colunas", "Between rows and columns")</XFTypography></ChildContent></XFCard>
        <XFCard><ChildContent><XFTypography Variant="XFTypographyVariant.Body2">@T("Controle granular", "Granular control")</XFTypography></ChildContent></XFCard>
    </XFGrid>;

    private RenderFragment CenteredAlignPreview() => @<XFGrid Cols="2" AlignItems="XFGridItems.Center" JustifyItems="XFGridItems.Center" Gap="4">
        <XFCard Padding="XFPadding.Xl"><ChildContent><XFTypography Weight="XFTypographyWeight.Semibold">@T("Centralizado", "Centered")</XFTypography></ChildContent></XFCard>
        <XFCard Padding="XFPadding.Xl"><ChildContent><XFTypography Weight="XFTypographyWeight.Semibold">@T("Alinhado ao centro", "Center aligned")</XFTypography></ChildContent></XFCard>
    </XFGrid>;

    private RenderFragment ColumnFlowPreview() => @<XFGrid Cols="3" Flow="XFGridFlow.Column" Gap="4">
        <XFCard><ChildContent><XFTypography Variant="XFTypographyVariant.Body2">A</XFTypography></ChildContent></XFCard>
        <XFCard><ChildContent><XFTypography Variant="XFTypographyVariant.Body2">B</XFTypography></ChildContent></XFCard>
        <XFCard><ChildContent><XFTypography Variant="XFTypographyVariant.Body2">C</XFTypography></ChildContent></XFCard>
        <XFCard><ChildContent><XFTypography Variant="XFTypographyVariant.Body2">D</XFTypography></ChildContent></XFCard>
        <XFCard><ChildContent><XFTypography Variant="XFTypographyVariant.Body2">E</XFTypography></ChildContent></XFCard>
        <XFCard><ChildContent><XFTypography Variant="XFTypographyVariant.Body2">F</XFTypography></ChildContent></XFCard>
    </XFGrid>;

    private RenderFragment DensePreview() => @<XFGrid Cols="4" Flow="XFGridFlow.Dense" Gap="4">
        <XFCard><ChildContent><XFTypography Variant="XFTypographyVariant.Body2">1</XFTypography></ChildContent></XFCard>
        <XFCard><ChildContent><XFTypography Variant="XFTypographyVariant.Body2">2</XFTypography></ChildContent></XFCard>
        <XFCard><ChildContent><XFTypography Variant="XFTypographyVariant.Body2">3</XFTypography></ChildContent></XFCard>
        <XFCard><ChildContent><XFTypography Variant="XFTypographyVariant.Body2">4</XFTypography></ChildContent></XFCard>
        <XFCard><ChildContent><XFTypography Variant="XFTypographyVariant.Body2">5</XFTypography></ChildContent></XFCard>
        <XFCard><ChildContent><XFTypography Variant="XFTypographyVariant.Body2">6</XFTypography></ChildContent></XFCard>
        <XFCard><ChildContent><XFTypography Variant="XFTypographyVariant.Body2">7</XFTypography></ChildContent></XFCard>
        <XFCard><ChildContent><XFTypography Variant="XFTypographyVariant.Body2">8</XFTypography></ChildContent></XFCard>
    </XFGrid>;

    private RenderFragment SidebarLayoutPreview() => @<XFGrid Cols="12" Gap="4">
        <div class="col-span-12 lg:col-span-8"><XFCard Padding="XFPadding.Lg"><ChildContent><XFTypography Weight="XFTypographyWeight.Semibold">@T("Área principal (8 colunas)", "Main area (8 columns)")</XFTypography><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Conteúdo principal do módulo.", "Main module content.")</XFTypography></ChildContent></XFCard></div>
        <div class="col-span-12 lg:col-span-4"><XFCard Padding="XFPadding.Lg"><ChildContent><XFTypography Weight="XFTypographyWeight.Semibold">@T("Sidebar (4 colunas)", "Sidebar (4 columns)")</XFTypography><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Filtros e ações rápidas.", "Filters and quick actions.")</XFTypography></ChildContent></XFCard></div>
