@page "/tokens/colors"

@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@T("Core Open Source", "Core Open Source")"
                 Title="@T("Tokens de Cores", "Color Tokens")"
                 Status="@T("Documentacao completa", "Complete docs")"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="Design Tokens" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Cores semânticas", "Semantic colors")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Dark/Light", "Dark/Light")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Multi-marca", "Multi-brand")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Paleta semântica para temas, marcas, estados e superficies em light/dark.",
                               "Semantic palette for themes, brands, states and surfaces in light/dark.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("Os tokens de cores do XForge definem cores de texto, borda, fundo, superficie e status como CSS custom properties. Eles suportam troca de tema via data-theme e multiplas marcas via data-brand, garantindo contraste AA e consistencia visual em todo o ERP.",
                               "XForge color tokens define text, border, background, surface and status colors as CSS custom properties. They support theme switching via data-theme and multiple brands via data-brand, ensuring AA contrast and visual consistency across the ERP.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts)
                            {
                                @Tile(item)
                            }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observações", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estático. Interações requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente não utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderizacao.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Consideracoes", "Considerations")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor Server: eventos sao tratados via SignalR. Sem latencia adicional para componentes puramente renderizados.", "Blazor Server: events are handled via SignalR. No additional latency for purely rendered components.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor WebAssembly: eventos sao tratados diretamente no cliente. Mais responsivo.", "Blazor WebAssembly: events are handled directly on the client. More responsive.")</XFTypography>
                </XFStack>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando não usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(T("Hierarquia visual", "Visual Hierarchy"), @<div>@TileGrid(VisualHierarchyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("Preview renderizado", "Live Preview"),
                T("Paleta primaria e cores de status aplicadas a cards e badges.", "Primary palette and status colors applied to cards and badges."),
                ColorPreview(), ColorCode)
            @Example(T("Escala de superficies", "Surface Scale"),
                T("Escala de 50 a 950 para hierarquia de fundo e texto.", "Scale from 50 to 950 for background and text hierarchy."),
                SurfacePreview(), SurfaceCode)
            @Example(T("Cores de status", "Status Colors"),
                T("Cores semânticas para sucesso, alerta, perigo e informacao.", "Semantic colors for success, warning, danger and info."),
                StatusPreview(), StatusCode)
            @Example(T("Multiplas marcas", "Multiple Brands"),
                T("Troca de marca via data-brand sem alterar logica de componentes.", "Brand switching via data-brand without changing component logic."),
                BrandPreview(), BrandCode)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Variantes/Valores", "Variants/Values"), @<div>@NameValueTable(VariantRows, T("Categoria", "Category"), T("Tokens", "Tokens"))</div>)
            @Section(T("Estados", "States"), @<div>@NameValueTable(StateRows, T("Estado", "State"), T("Comportamento", "Behavior"))</div>)
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Navegação enterprise por teclado", "Enterprise Keyboard Navigation"), @<div>@TileGrid(EnterpriseKeyboardItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("cenários enterprise", "Enterprise Scenários"), @<div>@TileGrid(ScenárioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Segurança", "Security Considerations"), @<div>@TileGrid(SecurityItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Notas de migração", "Migration Notes"), @<div>@TileGrid(MigrationItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>

@code {
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);

    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <div class="grid grid-cols-5 gap-3">
            <div class="flex flex-col items-center gap-2"><div class="h-16 w-full rounded-lg bg-primary"></div><span class="text-xs font-medium text-text-secondary">primary</span></div>
            <div class="flex flex-col items-center gap-2"><div class="h-16 w-full rounded-lg bg-success"></div><span class="text-xs font-medium text-text-secondary">success</span></div>
            <div class="flex flex-col items-center gap-2"><div class="h-16 w-full rounded-lg bg-warning"></div><span class="text-xs font-medium text-text-secondary">warning</span></div>
            <div class="flex flex-col items-center gap-2"><div class="h-16 w-full rounded-lg bg-danger"></div><span class="text-xs font-medium text-text-secondary">danger</span></div>
            <div class="flex flex-col items-center gap-2"><div class="h-16 w-full rounded-lg bg-info"></div><span class="text-xs font-medium text-text-secondary">info</span></div>
        </div>
        <div class="grid grid-cols-6 gap-2">
            <div class="h-8 rounded bg-surface-50 border border-border-light"></div>
            <div class="h-8 rounded bg-surface-100"></div>
            <div class="h-8 rounded bg-surface-200"></div>
            <div class="h-8 rounded bg-surface-500"></div>
            <div class="h-8 rounded bg-surface-800"></div>
            <div class="h-8 rounded bg-surface-950"></div>
        </div>
    </XFStack>;

    private RenderFragment ColorPreview() => @<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><div class="h-10 w-10 rounded-lg bg-primary mb-3"></div><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">Primary</XFTypography><XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">--color-primary</XFTypography></ChildContent></XFCard>
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><div class="h-10 w-10 rounded-lg bg-success mb-3"></div><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">Success</XFTypography><XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">--color-success</XFTypography></ChildContent></XFCard>
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><div class="h-10 w-10 rounded-lg bg-warning mb-3"></div><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">Warning</XFTypography><XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">--color-warning</XFTypography></ChildContent></XFCard>
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><div class="h-10 w-10 rounded-lg bg-danger mb-3"></div><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">Danger</XFTypography><XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">--color-danger</XFTypography></ChildContent></XFCard>
    </div>;

    private RenderFragment SurfacePreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <div class="grid grid-cols-5 md:grid-cols-11 gap-1">
            <div class="flex flex-col items-center gap-1"><div class="h-10 w-full rounded bg-surface-50 border border-border-light"></div><span class="text-[10px] text-text-muted">50</span></div>
            <div class="flex flex-col items-center gap-1"><div class="h-10 w-full rounded bg-surface-100"></div><span class="text-[10px] text-text-muted">100</span></div>
            <div class="flex flex-col items-center gap-1"><div class="h-10 w-full rounded bg-surface-200"></div><span class="text-[10px] text-text-muted">200</span></div>
            <div class="flex flex-col items-center gap-1"><div class="h-10 w-full rounded bg-surface-300"></div><span class="text-[10px] text-text-muted">300</span></div>
            <div class="flex flex-col items-center gap-1"><div class="h-10 w-full rounded bg-surface-400"></div><span class="text-[10px] text-text-muted">400</span></div>
            <div class="flex flex-col items-center gap-1"><div class="h-10 w-full rounded bg-surface-500"></div><span class="text-[10px] text-text-muted">500</span></div>
            <div class="flex flex-col items-center gap-1"><div class="h-10 w-full rounded bg-surface-600"></div><span class="text-[10px] text-text-muted">600</span></div>
            <div class="flex flex-col items-center gap-1"><div class="h-10 w-full rounded bg-surface-700"></div><span class="text-[10px] text-text-muted">700</span></div>
            <div class="flex flex-col items-center gap-1"><div class="h-10 w-full rounded bg-surface-800"></div><span class="text-[10px] text-text-muted">800</span></div>
            <div class="flex flex-col items-center gap-1"><div class="h-10 w-full rounded bg-surface-900"></div><span class="text-[10px] text-text-muted">900</span></div>
            <div class="flex flex-col items-center gap-1"><div class="h-10 w-full rounded bg-surface-950"></div><span class="text-[10px] text-text-muted">950</span></div>
        </div>
        <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Escala completa de 50 a 950 usada para fundos, bordas, texto e sobreposicoes.", "Full scale from 50 to 950 used for backgrounds, borders, text and overlays.")</XFTypography>
    </XFStack>;

    private RenderFragment StatusPreview() => @<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Success" Text="@T("Sucesso", "Success")" /><XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted" Class="mt-2 block">--color-success-500</XFTypography></ChildContent></XFCard>
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Warning" Text="@T("Alerta", "Warning")" /><XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted" Class="mt-2 block">--color-warning-500</XFTypography></ChildContent></XFCard>
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Danger" Text="@T("Perigo", "Danger")" /><XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted" Class="mt-2 block">--color-danger-500</XFTypography></ChildContent></XFCard>
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Info" Text="Info" /><XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted" Class="mt-2 block">--color-info-500</XFTypography></ChildContent></XFCard>
    </div>;

    private RenderFragment BrandPreview() => @<div class="grid grid-cols-2 md:grid-cols-3 gap-4">
        <div class="rounded-lg border border-border-light p-4" data-brand="brand-actions"><div class="h-8 rounded bg-primary mb-2"></div><span class="text-xs font-medium">brand-actions (Indigo)</span></div>
        <div class="rounded-lg border border-border-light p-4" data-brand="brand-display"><div class="h-8 rounded bg-primary mb-2"></div><span class="text-xs font-medium">brand-display (Sky)</span></div>
        <div class="rounded-lg border border-border-light p-4" data-brand="brand-feedback"><div class="h-8 rounded bg-primary mb-2"></div><span class="text-xs font-medium">brand-feedback (Amber)</span></div>
        <div class="rounded-lg border border-border-light p-4" data-brand="brand-layout"><div class="h-8 rounded bg-primary mb-2"></div><span class="text-xs font-medium">brand-layout (Emerald)</span></div>
        <div class="rounded-lg border border-border-light p-4" data-brand="brand-forms"><div class="h-8 rounded bg-primary mb-2"></div><span class="text-xs font-medium">brand-forms (Pink)</span></div>
        <div class="rounded-lg border border-border-light p-4" data-brand="brand-tokens"><div class="h-8 rounded bg-primary mb-2"></div><span class="text-xs font-medium">brand-tokens (Violet)</span></div>
    </div>;

    private RenderFragment Section(string title, RenderFragment content) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
        <Header><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography></Header>
        <ChildContent>@content</ChildContent>
    </XFCard>;

    private string CopyableCodeTitle => T("Código copiável", "Copyable code");

    private RenderFragment Example(string title, string description, RenderFragment preview, string codeText) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.None" AreaRestricted="false">
        <Header><div class="px-6 pt-6"><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@description</XFTypography></div></Header>
        <ChildContent><div class="grid"><div class="border-t border-border-light p-6">@preview</div><div class="border-t border-border-light bg-surface-50 p-6"><XFCode Text="@codeText" Language="razor" Title="@CopyableCodeTitle" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" /></div></div></ChildContent>
    </XFCard>;

    private RenderFragment Tile(DocTile item) => @<XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
        <ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true"><div class="flex items-center gap-4"><span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-primary/10 bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span><div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div></div><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography></XFStack></ChildContent>
    </XFCard>;

    private RenderFragment TileGrid(IReadOnlyList<DocTile> items, int columns) => @<XFGrid Cols="1" Md="@Math.Min(columns, 2)" Lg="@columns" Gap="4">@foreach (var item in items) { @Tile(item) }</XFGrid>;

    private RenderFragment WarningGrid(IReadOnlyList<DocTile> items) => @<XFGrid Cols="1" Md="2" Gap="4">@foreach (var item in items) { <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true"><div class="flex items-center gap-4"><span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-danger/10 bg-danger/10 text-danger" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span><div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div></div><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography></XFStack></ChildContent></XFCard> }</XFGrid>;

    private RenderFragment NameValueTable(IReadOnlyList<NameValueRow> rows, string nameHeader, string valueHeader) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader><XFTableRow><XFTableCell Header="true">@nameHeader</XFTableCell><XFTableCell Header="true">@valueHeader</XFTableCell></XFTableRow></XFTableHeader>
        <XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Value</XFTableCell></XFTableRow> }</XFTableBody>
    </XFTable>;

    private RenderFragment ApiTable(IReadOnlyList<ApiRow> rows) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Token", "Token")</XFTableCell><XFTableCell Header="true">@T("Tipo", "Type")</XFTableCell><XFTableCell Header="true">@T("padrão", "Default")</XFTableCell><XFTableCell Header="true">@T("Descrição", "Description")</XFTableCell></XFTableRow></XFTableHeader>
        <XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Type</XFTableCell><XFTableCell><XFCode Text="@row.DefaultValue" /></XFTableCell><XFTableCell>@row.Description</XFTableCell></XFTableRow> }</XFTableBody>
    </XFTable>;

    private IReadOnlyList<DocTile> QuickFacts =>
    [
        new(T("Contraste AA", "AA contrast"), T("Texto e fundo seguem WCAG AA em light e dark.", "Text and background follow WCAG AA in light and dark."), "universal-access"),
        new(T("Multi-marca", "Multi-brand"), T("6 marcas pre-configuradas via data-brand no root.", "6 pre-configured brands via data-brand on root."), "swatchbook"),
        new(T("Dark mode nativo", "Native dark mode"), T("Troca instantanea via data-theme.", "Instant switch via data-theme."), "moon")
    ];

    private IReadOnlyList<NameValueRow> MetadataRows =>
