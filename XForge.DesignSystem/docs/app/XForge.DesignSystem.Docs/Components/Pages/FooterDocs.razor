@page "/layout/footer"
@using XForge.DesignSystem.Components.Layout.Shell
@using XForge.DesignSystem.Components.Navigation.Breadcrumb
@using XForge.DesignSystem.Components.Button
@using XForge.DesignSystem.Components.DataDisplay.Avatar
@using XForge.DesignSystem.Services
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText" Title="@PageTitleText" Status="@PageStatusText" Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFFooter" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Shell slot","Shell slot")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Rodapé","Footer")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("data-theme","data-theme")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">@T("Rodapé da aplicação com metadados, status do sistema e slots flexíveis.","Application footer with metadata, system status and flexible slots.")</XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">@T("XFFooter é o slot de rodapé do XFAppShell. Renderiza um footer semântico com borda superior, status do sistema com ponto indicador, versão, ambiente, nome do usuário, perfil, data e slots StartContent/EndContent para composição livre.","XFFooter is the footer slot of XFAppShell. It renders a semantic footer with top border, system status with indicator dot, version, environment, user name, profile, date and StartContent/EndContent slots for free composition.")</XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">@HeroPreview()</div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">@foreach (var item in QuickFacts) { @Tile(item) }</XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>
        @Section(T("Metadados","Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo","Field"), T("Valor","Value"))</div>)
        <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
            <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">Blazor Server e Blazor WebAssembly</XFTypography>
            <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade","Compatibility")</XFTypography>
            <XFTable Striped="true" Hoverable="true" Compact="true">
                <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo","Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte","Support")</XFTableCell><XFTableCell Header="true">@T("Observações","Notes")</XFTableCell></XFTableRow></XFTableHeader>
                <XFTableBody>
                    <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim","Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições. Layout puramente CSS.","Works without restrictions. Purely CSS layout.")</XFTableCell></XFTableRow>
                    <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim","Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.","Works without restrictions.")</XFTableCell></XFTableRow>
                    <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim","Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições em ambos os estágios.","Works without restrictions in both stages.")</XFTableCell></XFTableRow>
                    <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Parcial","Partial")" /></XFTableCell><XFTableCell>@T("Renderiza HTML base. Interações dos slots requerem modo interativo.","Renders base HTML. Slot interactions require interactive mode.")</XFTableCell></XFTableRow>
                </XFTableBody>
            </XFTable>
            <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependências JS","No JS Dependencies")</XFTypography>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente não utiliza JavaScript interop. É puramente renderizado com C# e Tailwind CSS.","This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS.")</XFTypography>
        </XFStack>
        @Section(T("Visão geral","Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
        @Section(T("Propósito","Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
        @Section(T("Problema resolvido","Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
        @Section(T("Quando usar","When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
        @Section(T("Quando não usar","When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
        @Section(T("Anatomia","Anatomy"), @<div>@TileGrid(AnatomyItems, 2)</div>)
        @Section(T("Hierarquia visual","Visual Hierarchy"), @<div>@TileGrid(VisualHierarchyItems, 3)</div>)
        @Section(T("Princípios de design","Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        @Example(T("1. Footer padrão","1. Default Footer"), T("XFFooter com configuração padrão.","XFFooter with default settings."), ExDefault(), CodeDefault)
        @Example(T("2. Footer com slots customizados","2. Custom slot Footer"), T("StartContent e EndContent para composição livre.","StartContent and EndContent for free composition."), ExCustomSlots(), CodeCustomSlots)
        @Example(T("3. Footer minimalista","3. Minimalist Footer"), T("Apenas versão e ambiente.","Only version and environment."), ExMinimal(), CodeMinimal)
        @Example(T("4. Footer com badges","4. Footer with badges"), T("StartContent com badges de módulo e versão.","StartContent with module and version badges."), ExBadges(), CodeBadges)
        @Example(T("5. Footer sem status dot","5. Footer without status dot"), T("ShowStatusDot=false remove o ponto indicador.","ShowStatusDot=false removes the indicator dot."), ExNoStatusDot(), CodeNoStatusDot)
        @Example(T("6. Footer com StatusClass customizado","6. Custom StatusClass Footer"), T("StatusClass warning para ambiente de homologação.","StatusClass warning for staging environment."), ExWarningStatus(), CodeWarningStatus)
        @Example(T("7. Footer com CustomDate","7. Footer with CustomDate"), T("CustomDate sobrescreve a data atual.","CustomDate overrides the current date."), ExCustomDate(), CodeCustomDate)
        @Example(T("8. Footer apenas com StartContent","8. Footer with StartContent only"), T("EndContent padrão com StartContent customizado.","Default EndContent with custom StartContent."), ExStartOnly(), CodeStartOnly)
        @Example(T("9. Cenário enterprise completo","9. Full enterprise scenario"), T("Footer dentro de XFAppShell completo.","Footer inside complete XFAppShell."), ExEnterprise(), CodeEnterprise)
        @Section(T("Variantes","Variants"), @<div>@NameValueTable(VariantRows, T("Variante","Variant"), T("Caso de uso","Use case"))</div>)
        @Section(T("Estados","States"), @<div>@NameValueTable(StateRows, T("Estado","State"), T("Comportamento","Behavior"))</div>)
        @Section("API — XFFooter", @<div>@ApiTable(FooterApiRows)</div>)
        @Section(T("Eventos","Events"), @<div>@NameValueTable(EventRows, T("Evento","Event"), T("Comportamento","Behavior"))</div>)
        @Section(T("Métodos","Methods"), @<div>@NameValueTable(MethodRows, T("Método","Method"), T("Comportamento","Behavior"))</div>)
        @Section(T("Acessibilidade","Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
        @Section(T("Suporte de teclado","Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla","Key"), T("Comportamento","Behavior"))</div>)
        @Section(T("Responsividade","Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
        @Section(T("Performance","Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        @Section(T("Cenários enterprise","Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
        @Section(T("Padrões de composição","Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
        @Section(T("Exemplos de integração","Integration Examples"), @<div>@TileGrid(IntegrationItems, 2)</div>)
        @Section(T("Boas práticas de UX","UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
        @Section(T("Anti-padrões","Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        @Section("Design Tokens", @<div>@NameValueTable(TokenRows, "Token", T("Propósito","Purpose"))</div>)
        @Section(T("Temas","Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
        @Section(T("Testes","Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura","Coverage"), T("Evidência","Evidence"))</div>)
        @Section(T("Limitações conhecidas","Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitação","Limitation"), T("Status","Status"))</div>)
        @Section(T("Notas de migração","Migration Notes"), @<div>@TileGrid(MigrationItems, 2)</div>)
        @Section(T("Componentes relacionados","Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
        @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta","Question"), T("Resposta","Answer"))</div>)
        @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versão","Version"), T("Mudança","Change"))</div>)
    </XFStack>
</XForgeDocsShell>

@code {
    private string ProductLabelText => T("Core Open Source", "Core Open Source");
    private string PageTitleText => T("Footer", "Footer");
    private string PageStatusText => T("Documentação completa", "Complete docs");
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);

    private RenderFragment HeroPreview() => @<div class="overflow-hidden rounded-lg border border-border-light"><div class="bg-surface-50 p-3"><XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Conteúdo principal acima do Footer.","Main content above the Footer.")</XFTypography></ChildContent></XFCard></div><XFFooter StatusText="@T("Estável","Stable")" UserName="Admin" Profile="TI" AppName="ERP" Environment="@T("Produção","Production")" Version="v2.1.0" ShowStatusDot="true" /></div>;

    private RenderFragment ExDefault() => @<div class="overflow-hidden rounded-lg border border-border-light"><div class="bg-surface-50 p-3"><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Conteúdo da página","Page content")</XFTypography></div><XFFooter StatusText="@T("Online","Online")" UserName="Carlos" Profile="Financeiro" AppName="ERP" Environment="@T("Produção","Production")" Version="v2.1.0" ShowStatusDot="true" /></div>;
    private string CodeDefault => @"<XFFooter StatusText=""Online"" UserName=""Carlos"" Profile=""Financeiro"" AppName=""ERP"" Environment=""Producao"" Version=""v2.1.0"" ShowStatusDot=""true"" />";

    private RenderFragment ExCustomSlots() => @<div class="overflow-hidden rounded-lg border border-border-light"><div class="bg-surface-50 p-3"><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Conteúdo da página","Page content")</XFTypography></div><XFFooter StatusText="@T("Estável","Stable")" Version="v2.1.0"><StartContent><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="XForge" /></StartContent><EndContent><XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Secondary">@T("Suporte: suporte@empresa.com","Support: support@company.com")</XFTypography></EndContent></XFFooter></div>;
    private string CodeCustomSlots => @"<XFFooter StatusText=""Estavel"" Version=""v2.1.0""><StartContent><XFBadge Variant=""XFBadgeVariant.Soft"" Color=""XFBadgeColor.Info"" Text=""XForge"" /></StartContent><EndContent><XFTypography Variant=""XFTypographyVariant.Caption"" Color=""XFTypographyColor.Secondary"">Suporte: suporte@empresa.com</XFTypography></EndContent></XFFooter>";

    private RenderFragment ExMinimal() => @<div class="overflow-hidden rounded-lg border border-border-light"><div class="bg-surface-50 p-3"><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Conteúdo da página","Page content")</XFTypography></div><XFFooter Version="v2.1.0" Environment="@T("Homologação","Staging")" StatusText="@T("Em testes","Testing")" ShowStatusDot="true" StatusClass="text-warning" /></div>;
    private string CodeMinimal => @"<XFFooter Version=""v2.1.0"" Environment=""Homologacao"" StatusText=""Em testes"" ShowStatusDot=""true"" StatusClass=""text-warning"" />";

    private RenderFragment ExBadges() => @<div class="overflow-hidden rounded-lg border border-border-light"><div class="bg-surface-50 p-3"><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Conteúdo da página","Page content")</XFTypography></div><XFFooter StatusText="@T("Manutenção","Maintenance")" Version="v2.2.0" ShowStatusDot="true" StatusClass="text-warning"><StartContent><XFStack Orientation="XFOrientation.Horizontal" Gap="2"><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Primary" Text="ERP" /><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="v2.2.0" /></XFStack></StartContent><EndContent><XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Secondary">@T("Última atualização: 09/06/2026","Last update: 09/06/2026")</XFTypography></EndContent></XFFooter></div>;
    private string CodeBadges => @"<XFFooter StatusText=""Manutencao"" Version=""v2.2.0"" ShowStatusDot=""true"" StatusClass=""text-warning""><StartContent><XFStack Orientation=""XFOrientation.Horizontal"" Gap=""2""><XFBadge Variant=""XFBadgeVariant.Soft"" Color=""XFBadgeColor.Primary"" Text=""ERP"" /><XFBadge Variant=""XFBadgeVariant.Soft"" Color=""XFBadgeColor.Success"" Text=""v2.2.0"" /></XFStack></StartContent><EndContent><XFTypography Variant=""XFTypographyVariant.Caption"" Color=""XFTypographyColor.Secondary"">Ultima atualizacao: 09/06/2026</XFTypography></EndContent></XFFooter>";

    private RenderFragment ExNoStatusDot() => @<div class="overflow-hidden rounded-lg border border-border-light"><div class="bg-surface-50 p-3"><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Conteúdo da página","Page content")</XFTypography></div><XFFooter StatusText="@T("Offline","Offline")" UserName="Sistema" Environment="@T("Desenvolvimento","Development")" Version="v2.1.0-dev" ShowStatusDot="false" /></div>;
    private string CodeNoStatusDot => @"<XFFooter StatusText=""Offline"" UserName=""Sistema"" Environment=""Desenvolvimento"" Version=""v2.1.0-dev"" ShowStatusDot=""false"" />";

    private RenderFragment ExWarningStatus() => @<div class="overflow-hidden rounded-lg border border-border-light"><div class="bg-surface-50 p-3"><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Conteúdo da página","Page content")</XFTypography></div><XFFooter StatusText="@T("Homologação","Staging")" UserName="QA" Profile="Testador" AppName="ERP" Environment="@T("Homologação","Staging")" Version="v2.1.0-rc1" ShowStatusDot="true" StatusClass="text-warning" /></div>;
    private string CodeWarningStatus => @"<XFFooter StatusText=""Homologacao"" UserName=""QA"" Profile=""Testador"" AppName=""ERP"" Environment=""Homologacao"" Version=""v2.1.0-rc1"" ShowStatusDot=""true"" StatusClass=""text-warning"" />";

    private RenderFragment ExCustomDate() => @<div class="overflow-hidden rounded-lg border border-border-light"><div class="bg-surface-50 p-3"><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Conteúdo da página","Page content")</XFTypography></div><XFFooter StatusText="@T("Estável","Stable")" UserName="Admin" Environment="@T("Produção","Production")" Version="v2.1.0" CustomDate="10/06/2026" ShowStatusDot="true" /></div>;
    private string CodeCustomDate => @"<XFFooter StatusText=""Estavel"" UserName=""Admin"" Environment=""Producao"" Version=""v2.1.0"" CustomDate=""10/06/2026"" ShowStatusDot=""true"" />";

    private RenderFragment ExStartOnly() => @<div class="overflow-hidden rounded-lg border border-border-light"><div class="bg-surface-50 p-3"><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Conteúdo da página","Page content")</XFTypography></div><XFFooter Environment="@T("Produção","Production")" Version="v2.1.0" ShowStatusDot="true"><StartContent><XFStack Orientation="XFOrientation.Horizontal" Gap="2" AlignItems="XFAlignItems.Center"><XFAvatar Size="XFAvatarSize.Xs" Text="AD" /><XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">Admin</XFTypography></XFStack></StartContent></XFFooter></div>;
    private string CodeStartOnly => @"<XFFooter Environment=""Producao"" Version=""v2.1.0"" ShowStatusDot=""true""><StartContent><XFStack Orientation=""XFOrientation.Horizontal"" Gap=""2"" AlignItems=""XFAlignItems.Center""><XFAvatar Size=""XFAvatarSize.Xs"" Text=""AD"" /><XFTypography Variant=""XFTypographyVariant.Caption"" Color=""XFTypographyColor.Muted"">Admin</XFTypography></XFStack></StartContent></XFFooter>";

    private RenderFragment ExEnterprise() => @<div class="h-80 overflow-hidden rounded-lg border border-border-light"><XFAppShell Brand="erp" MainClass="flex-1 overflow-auto bg-surface-50 p-4"><Rail><XFRail Items="@EnterpriseRailItems" /></Rail><Sidebar><XFSidebar><Header><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Bold">@T("Financeiro","Finance")</XFTypography></Header><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="1" FullWidth="true"><XFButton Text="@T("Contas a receber","Accounts Receivable")" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" FullWidth="true" /></XFStack></ChildContent></XFSidebar></Sidebar><AppBar><XFAppBar Position="XFAppBarPosition.Fixed" Bordered="true"><ChildContent><XFStack Orientation="XFOrientation.Horizontal" AlignItems="XFAlignItems.Center" JustifyContent="XFJustifyContent.SpaceBetween" FullWidth="true"><XFBreadcrumb Items="BreadcrumbNavItems" /><XFStack Orientation="XFOrientation.Horizontal" Gap="3" AlignItems="XFAlignItems.Center"><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="Mai/2026" /><XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Danger" Text="5" /><XFAvatar Size="XFAvatarSize.Sm" Text="AD" /></XFStack></XFStack></ChildContent></XFAppBar></AppBar><ChildContent><XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFTypography Variant="XFTypographyVariant.Body1">@T("Contas a receber — 12 títulos pendentes","Accounts Receivable — 12 pending receivables")</XFTypography></ChildContent></XFCard></ChildContent><Footer><XFFooter StatusText="@T("Online","Online")" UserName="Admin" Profile="Administrador" AppName="@T("ERP Financeiro","ERP Finance")" Environment="@T("Produção","Production")" Version="v2.1.0" ShowStatusDot="true" /></Footer></XFAppShell></div>;
    private string CodeEnterprise => @"<XFAppShell Brand=""erp"" MainClass=""flex-1 overflow-auto bg-surface-50 p-4""><Rail><XFRail Items=""@RailItems"" /></Rail><Sidebar><XFSidebar><Header><XFTypography Variant=""XFTypographyVariant.Body1"" Weight=""XFTypographyWeight.Bold"">Financeiro</XFTypography></Header><ChildContent><XFStack Orientation=""XFOrientation.Vertical"" Gap=""1"" FullWidth=""true""><XFButton Text=""Contas a receber"" Variant=""XFButtonVariant.Solid"" Color=""XFButtonColor.Primary"" FullWidth=""true"" /></XFStack></ChildContent></XFSidebar></Sidebar><AppBar><XFAppBar Position=""XFAppBarPosition.Fixed"" Bordered=""true""><ChildContent><XFStack Orientation=""XFOrientation.Horizontal"" AlignItems=""XFAlignItems.Center"" JustifyContent=""XFJustifyContent.SpaceBetween"" FullWidth=""true""><XFBreadcrumb Items=""@BreadcrumbItems"" /><XFStack Orientation=""XFOrientation.Horizontal"" Gap=""3"" AlignItems=""XFAlignItems.Center""><XFBadge Variant=""XFBadgeVariant.Soft"" Color=""XFBadgeColor.Info"" Text=""Mai/2026"" /><XFBadge Variant=""XFBadgeVariant.Solid"" Color=""XFBadgeColor.Danger"" Text=""5"" /><XFAvatar Size=""XFAvatarSize.Sm"" Text=""AD"" /></XFStack></XFStack></ChildContent></XFAppBar></AppBar><ChildContent><XFCard Variant=""XFCardVariant.Filled"" Padding=""XFPadding.Lg""><ChildContent><XFTypography Variant=""XFTypographyVariant.Body1"">Contas a receber — 12 títulos pendentes</XFTypography></ChildContent></XFCard></ChildContent><Footer><XFFooter StatusText=""Online"" UserName=""Admin"" Profile=""Administrador"" AppName=""ERP Financeiro"" Environment=""Producao"" Version=""v2.1.0"" ShowStatusDot=""true"" /></Footer></XFAppShell>";

    private RenderFragment Section(string title, RenderFragment content) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg"><Header><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography></Header><ChildContent>@content</ChildContent></XFCard>;
    private RenderFragment Example(string title, string description, RenderFragment preview, string codeText) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.None" AreaRestricted="false"><Header><div class="px-6 pt-6 pb-2"><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@description</XFTypography></div></Header><ChildContent><div class="flex flex-col"><div class="border-t border-border-light bg-surface-50/30 p-6">@preview</div><div class="border-t border-border-light bg-surface-50 p-6"><XFCode Text="@codeText" Language="razor" Title="@T("Código copiável","Copyable code")" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" /></div></div></ChildContent></XFCard>;
    private RenderFragment Tile(DocTile item) => @<XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true"><div class="flex items-center gap-4"><span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-primary/10 bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span><div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div></div><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography></XFStack></ChildContent></XFCard>;
    private RenderFragment TileGrid(IReadOnlyList<DocTile> items, int columns) => @<XFGrid Cols="1" Md="@Math.Min(columns, 2)" Lg="@columns" Gap="4">@foreach (var item in items) { @Tile(item) }</XFGrid>;
    private RenderFragment WarningGrid(IReadOnlyList<DocTile> items) => @<XFGrid Cols="1" Md="2" Gap="4">@foreach (var item in items) { <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true"><div class="flex items-center gap-4"><span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-danger/10 bg-danger/10 text-danger" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span><div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div></div><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography></XFStack></ChildContent></XFCard> }</XFGrid>;
    private RenderFragment NameValueTable(IReadOnlyList<NameValueRow> rows, string nameHeader, string valueHeader) => @<XFTable Striped="true" Hoverable="true" Compact="true"><XFTableHeader><XFTableRow><XFTableCell Header="true">@nameHeader</XFTableCell><XFTableCell Header="true">@valueHeader</XFTableCell></XFTableRow></XFTableHeader><XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Value</XFTableCell></XFTableRow> }</XFTableBody></XFTable>;
    private RenderFragment ApiTable(IReadOnlyList<ApiRow> rows) => @<XFTable Striped="true" Hoverable="true" Compact="true"><XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Parâmetro","Parameter")</XFTableCell><XFTableCell Header="true">Type</XFTableCell><XFTableCell Header="true">Default</XFTableCell><XFTableCell Header="true">@T("Descrição","Description")</XFTableCell></XFTableRow></XFTableHeader><XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Type</XFTableCell><XFTableCell><XFCode Text="@row.DefaultValue" /></XFTableCell><XFTableCell>@row.Description</XFTableCell></XFTableRow> }</XFTableBody></XFTable>;

