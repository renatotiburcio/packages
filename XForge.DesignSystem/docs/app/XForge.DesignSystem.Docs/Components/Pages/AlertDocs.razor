@using XForge.DesignSystem.Core.Primitives
@page "/feedback/alert"
@page "/feedback/alerts"

@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFAlert" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("WAI-ARIA", "WAI-ARIA")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Live Region", "Live Region")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Enterprise", "Enterprise")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Alerta contextual acessivel com live region e 7 intents.", "Contextual accessible alert with live region and 7 intents.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("7 intents, 4 variantes, 3 tamanhos, live region, dismiss, icones, acoes e touch target 44px WCAG AAA.",
                               "7 intents, 4 variants, 3 sizes, live region, dismiss, icons, actions and 44px WCAG AAA touch target.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico. Interacoes requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderizacao.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Consideracoes", "Considerations")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor Server: eventos sao tratados via SignalR. Sem latencia adicional para componentes puramente renderizados.", "Blazor Server: events are handled via SignalR. No additional latency for purely rendered components.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor WebAssembly: eventos sao tratados diretamente no cliente. Mais responsivo.", "Blazor WebAssembly: events are handled directly on the client. More responsive.")</XFTypography>
                </XFStack>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 4)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== ALL MANDATORY EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Basico", "1. Basic"),
                T("Alert simples com configuracao padrao.", "Simple alert with default settings."),
                ExBasic(), CodeBasic)

            @Example(T("2. Tamanhos", "2. Sizes"),
                T("Sm, Md e Lg — todos com touch target 44px.", "Sm, Md and Lg — all with 44px touch target."),
                ExSizes(), CodeSizes)

            @Example(T("3. Intents", "3. Intents"),
                T("7 intents: Info, Success, Warning, Danger, Primary, Secondary, Neutral.", "7 intents: Info, Success, Warning, Danger, Primary, Secondary, Neutral."),
                ExIntents(), CodeIntents)

            @Example(T("4. Variantes", "4. Variants"),
                T("4 variantes: Soft, Solid, Outline, Subtle.", "4 variants: Soft, Solid, Outline, Subtle."),
                ExVariants(), CodeVariants)

            @Example(T("5. Icones", "5. Icons"),
                T("ShowIcon=true/false e icone padrao por intent.", "ShowIcon=true/false and default icon per intent."),
                ExIcons(), CodeIcons)

            @Example(T("6. Dismiss", "6. Dismissible"),
                T("Dismissible=true com OnDismiss callback.", "Dismissible=true with OnDismiss callback."),
                ExDismiss(), CodeDismiss)

            @Example(T("7. Titulo", "7. Title"),
                T("Com e sem titulo, com e sem texto.", "With and without title, with and without text."),
                ExTitle(), CodeTitle)

            @Example(T("8. Acoes", "8. Actions"),
                T("RenderFragment Actions para botoes customizados.", "Actions RenderFragment for custom buttons."),
                ExActions(), CodeActions)

            @Example(T("9. Templates", "9. Templates"),
                T("ChildContent com markup customizado.", "ChildContent with custom markup."),
                ExTemplates(), CodeTemplates)

            @Example(T("10. ARIA Live", "10. ARIA Live"),
                T("Polite, Assertive e Off para regioes live.", "Polite, Assertive and Off for live regions."),
                ExAriaLive(), CodeAriaLive)

            @Example(T("11. StartIcon custom", "11. Custom StartIcon"),
                T("RenderFragment StartIcon para icones customizados.", "StartIcon RenderFragment for custom icons."),
                ExCustomIcon(), CodeCustomIcon)

            @Example(T("12. Cenario enterprise", "12. Enterprise scenario"),
                T("Alertas em contexto ERP com dados realistas.", "Alerts in ERP context with realistic data."),
                ExEnterprise(), CodeEnterprise)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string ProductLabelText => T("Core Open Source", "Core Open Source");
    private string PageTitleText => T("Alert", "Alert");
    private string PageStatusText => T("Documentacao completa", "Complete docs");
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");

    // ─── Hero ───
    private RenderFragment HeroPreview() => @<div class="flex flex-col gap-3">
        <XFAlert Size="XFSize.Md" Tone="XFSemanticColor.Success" Variant="XFAlertVariant.Soft" Title="@T("Pagamento confirmado", "Payment confirmed")" Text="@T("NF 001.234 — R$ 12.450,00 creditado em 12/05/2026.", "INV 001.234 — R$ 12,450.00 credited on 05/12/2026.")" />
        <XFAlert Size="XFSize.Md" Tone="XFSemanticColor.Warning" Variant="XFAlertVariant.Soft" Title="@T("Estoque baixo", "Low stock")" Text="@T("Produto SKU-4521 abaixo do minimo (3 unidades restantes).", "Product SKU-4521 below minimum (3 units remaining).")" Dismissible="true" />
        <XFAlert Size="XFSize.Md" Tone="XFSemanticColor.Danger" Variant="XFAlertVariant.Solid" Title="@T("Erro de integracao", "Integration error")" Text="@T("API Sefaz retornou timeout. Tente novamente em 5 minutos.", "Sefaz API returned timeout. Try again in 5 minutes.")" Dismissible="true" />
        <XFAlert Size="XFSize.Md" Tone="XFSemanticColor.Info" Variant="XFAlertVariant.Outline" Text="@T("Nova versao do modulo fiscal disponivel (v3.2.1).", "New fiscal module version available (v3.2.1).")" />
    </div>;

    // ─── 1. Basic ───
    private RenderFragment ExBasic() => @<div class="flex flex-col gap-3">
        <XFAlert Size="XFSize.Md" Tone="XFSemanticColor.Info" Variant="XFAlertVariant.Soft" Text="@T("Esta e uma mensagem informativa padrao.", "This is a default informational message.")" />
    </div>;

    // ─── 2. Sizes ───
    private RenderFragment ExSizes() => @<div class="flex flex-col gap-4">
        <div class="flex flex-col gap-2">
            <div class="flex items-center gap-2">
                <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="Sm" />
                <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">
                    @T("Compacto — tabelas densas, dashboards com muitos KPIs.", "Compact — dense tables, dashboards with many KPIs.")
                </XFTypography>
            </div>
            <XFAlert Size="XFSize.Sm" Tone="XFSemanticColor.Info" Variant="XFAlertVariant.Soft" Text="@T("Alert pequeno para espacos compactos.", "Small alert for compact spaces.")" />
        </div>
        <div class="flex flex-col gap-2">
            <div class="flex items-center gap-2">
                <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="Md" />
                <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">
                    @T("Padrao — maioria dos cenarios ERP.", "Default — most ERP scenarios.")
                </XFTypography>
            </div>
            <XFAlert Size="XFSize.Md" Tone="XFSemanticColor.Info" Variant="XFAlertVariant.Soft" Text="@T("Alert medio, tamanho padrao.", "Medium alert, default size.")" />
        </div>
        <div class="flex flex-col gap-2">
            <div class="flex items-center gap-2">
                <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="Lg" />
                <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">
                    @T("Touch-first — tablets, kiosks, telas de ponto de venda.", "Touch-first — tablets, kiosks, POS screens.")
                </XFTypography>
            </div>
            <XFAlert Size="XFSize.Lg" Tone="XFSemanticColor.Info" Variant="XFAlertVariant.Soft" Text="@T("Alert grande para telas touch.", "Large alert for touch screens.")" />
        </div>
    </div>;

    // ─── 3. Intents ───
    private RenderFragment ExIntents() => @<div class="flex flex-col gap-3">
        <XFAlert Size="XFSize.Md" Tone="XFSemanticColor.Info" Variant="XFAlertVariant.Soft" Title="Info" Text="@T("Intent Info — informativo padrao.", "Intent Info — default informational.")" />
        <XFAlert Size="XFSize.Md" Tone="XFSemanticColor.Success" Variant="XFAlertVariant.Soft" Title="Success" Text="@T("Intent Success — operacao concluida.", "Intent Success — operation completed.")" />
        <XFAlert Size="XFSize.Md" Tone="XFSemanticColor.Warning" Variant="XFAlertVariant.Soft" Title="Warning" Text="@T("Intent Warning — atencao necessaria.", "Intent Warning — attention needed.")" />
        <XFAlert Size="XFSize.Md" Tone="XFSemanticColor.Danger" Variant="XFAlertVariant.Soft" Title="Danger" Text="@T("Intent Danger — erro ou falha critica.", "Intent Danger — critical error or failure.")" />
        <XFAlert Size="XFSize.Md" Tone="XFSemanticColor.Primary" Variant="XFAlertVariant.Soft" Title="Primary" Text="@T("Intent Primary — destaque da marca.", "Intent Primary — brand emphasis.")" />
        <XFAlert Size="XFSize.Md" Tone="XFSemanticColor.Secondary" Variant="XFAlertVariant.Soft" Title="Secondary" Text="@T("Intent Secondary — complementar.", "Intent Secondary — complementary.")" />
        <XFAlert Size="XFSize.Md" Tone="XFSemanticColor.Neutral" Variant="XFAlertVariant.Soft" Title="Neutral" Text="@T("Intent Neutral — neutro, sem cor semantica.", "Intent Neutral — neutral, no semantic color.")" />
    </div>;

    // ─── 4. Variants ───
    private RenderFragment ExVariants() => @<div class="flex flex-col gap-4">
        <div class="flex flex-col gap-2">
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="Soft" />
            <XFAlert Size="XFSize.Md" Tone="XFSemanticColor.Info" Variant="XFAlertVariant.Soft" Title="Soft" Text="@T("Variante Soft — fundo sutil, borda leve.", "Soft variant — subtle background, light border.")" />
        </div>
        <div class="flex flex-col gap-2">
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="Solid" />
            <XFAlert Size="XFSize.Md" Tone="XFSemanticColor.Info" Variant="XFAlertVariant.Solid" Title="Solid" Text="@T("Variante Solid — fundo colorido, alta visibilidade.", "Solid variant — colored background, high visibility.")" />
        </div>
        <div class="flex flex-col gap-2">
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="Outline" />
            <XFAlert Size="XFSize.Md" Tone="XFSemanticColor.Info" Variant="XFAlertVariant.Outline" Title="Outline" Text="@T("Variante Outline — borda definida, fundo transparente.", "Outline variant — defined border, transparent background.")" />
        </div>
        <div class="flex flex-col gap-2">
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="Subtle" />
            <XFAlert Size="XFSize.Md" Tone="XFSemanticColor.Info" Variant="XFAlertVariant.Subtle" Title="Subtle" Text="@T("Variante Subtle — minimalista, borda quase invisivel.", "Subtle variant — minimalist, nearly invisible border.")" />
        </div>
    </div>;

    // ─── 5. Icons ───
    private RenderFragment ExIcons() => @<div class="flex flex-col gap-4">
        <div class="flex flex-col gap-1">
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">ShowIcon=true (padrao)</XFTypography>
            <XFAlert Size="XFSize.Md" Tone="XFSemanticColor.Success" Variant="XFAlertVariant.Soft" ShowIcon="true" Text="@T("Icone de sucesso visivel.", "Success icon visible.")" />
        </div>
        <div class="flex flex-col gap-1">
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">ShowIcon=false</XFTypography>
            <XFAlert Size="XFSize.Md" Tone="XFSemanticColor.Warning" Variant="XFAlertVariant.Soft" ShowIcon="false" Text="@T("Sem icone — apenas texto.", "No icon — text only.")" />
        </div>
        <div class="flex flex-col gap-1">
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Icones padrao por intent", "Default icons by intent")</XFTypography>
            <div class="flex flex-col gap-2">
                <XFAlert Size="XFSize.Md" Tone="XFSemanticColor.Info" Variant="XFAlertVariant.Soft" Text="Info → circle-info" />
                <XFAlert Size="XFSize.Md" Tone="XFSemanticColor.Success" Variant="XFAlertVariant.Soft" Text="Success → circle-check" />
                <XFAlert Size="XFSize.Md" Tone="XFSemanticColor.Warning" Variant="XFAlertVariant.Soft" Text="Warning → triangle-exclamation" />
                <XFAlert Size="XFSize.Md" Tone="XFSemanticColor.Danger" Variant="XFAlertVariant.Soft" Text="Danger → circle-xmark" />
            </div>
        </div>
    </div>;

    // ─── 6. Dismiss ───
    private bool dismissDemoVisible = true;
    private RenderFragment ExDismiss() => @<div class="flex flex-col gap-4">
        <div class="flex flex-col gap-1">
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">Dismissible=true com OnDismiss</XFTypography>
            <XFAlert Size="XFSize.Md" Tone="XFSemanticColor.Info" Variant="XFAlertVariant.Soft" Dismissible="true" Title="@T("Clique no X para dispensar", "Click X to dismiss")" Text="@T("Este alerta pode ser fechado pelo usuario.", "This alert can be closed by the user.")" />
        </div>
        <div class="flex flex-col gap-1">
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">Dismissible=true com Visible two-way binding</XFTypography>
            <XFAlert Size="XFSize.Md" Tone="XFSemanticColor.Warning" Variant="XFAlertVariant.Soft" Dismissible="true" @bind-Visible="dismissDemoVisible" Title="@T("Alert controlado", "Controlled alert")" Text="@T("Use @bind-Visible para controle programatico.", "Use @bind-Visible for programmatic control.")" />
            @if (!dismissDemoVisible)
            {
                <XFButton Size="XFExtendedSize.Md" Variant="XFButtonVariant.Outline" Color="XFButtonColor.Primary" OnClick="() => dismissDemoVisible = true">
                    @T("Mostrar alerta novamente", "Show alert again")
                </XFButton>
            }
        </div>
    </div>;

    // ─── 7. Title ───
    private RenderFragment ExTitle() => @<div class="flex flex-col gap-3">
        <XFAlert Size="XFSize.Md" Tone="XFSemanticColor.Info" Variant="XFAlertVariant.Soft" Title="@T("Com titulo e texto", "With title and text")" Text="@T("Subtitulo descritivo abaixo do titulo.", "Descriptive subtitle below the title.")" />
        <XFAlert Size="XFSize.Md" Tone="XFSemanticColor.Success" Variant="XFAlertVariant.Soft" Text="@T("Apenas texto, sem titulo.", "Text only, no title.")" />
        <XFAlert Size="XFSize.Md" Tone="XFSemanticColor.Warning" Variant="XFAlertVariant.Soft" Title="@T("Apenas titulo", "Title only")" />
        <XFAlert Size="XFSize.Md" Tone="XFSemanticColor.Danger" Variant="XFAlertVariant.Solid" Title="@T("Titulo com variante Solid", "Title with Solid variant")" Text="@T("Solid usa fundo colorido para alta visibilidade.", "Solid uses colored background for high visibility.")" />
    </div>;

    // ─── 8. Actions ───
    private RenderFragment ExActions() => @<div class="flex flex-col gap-3">
        <XFAlert Size="XFSize.Md" Tone="XFSemanticColor.Info" Variant="XFAlertVariant.Soft" Dismissible="true"
                 Title="@T("Atualizacao disponivel", "Update available")">
            <ChildContent>@T("Uma nova versao do modulo fiscal esta disponivel.", "A new version of the fiscal module is available.")</ChildContent>
            <Actions>
                <XFButton Size="XFExtendedSize.Sm" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary">@T("Atualizar agora", "Update now")</XFButton>
                <XFButton Size="XFExtendedSize.Sm" Variant="XFButtonVariant.Ghost" Color="XFButtonColor.Secondary">@T("Depois", "Later")</XFButton>
            </Actions>
        </XFAlert>
    </div>;

    // ─── 9. Templates ───
    private RenderFragment ExTemplates() => @<div class="flex flex-col gap-3">
        <XFAlert Size="XFSize.Md" Tone="XFSemanticColor.Info" Variant="XFAlertVariant.Soft" Title="@T("Conteudo customizado", "Custom content")">
            <ChildContent>
                <div class="flex flex-col gap-2">
                    <XFTypography Variant="XFTypographyVariant.Body2">
                        @T("Use ChildContent para inserir markup complexo dentro do alert.", "Use ChildContent to insert complex markup inside the alert.")
                    </XFTypography>
                    <div class="flex gap-2">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="v3.2.1" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Estavel", "Stable")" />
                    </div>
                </div>
            </ChildContent>
        </XFAlert>
    </div>;

    // ─── 10. ARIA Live ───
    private RenderFragment ExAriaLive() => @<div class="flex flex-col gap-4">
        <div class="flex flex-col gap-1">
