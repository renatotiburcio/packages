    private string CodeAsyncSearch =>
        "<XFCombobox TItem=\"EmployeeItem\" TValue=\"int\"\n" +
        "    SearchAsync=\"@SearchEmployees\"\n" +
        "    TextSelector=\"@(i => i.Name)\"\n" +
        "    ValueSelector=\"@(i => (int?)i.Id)\"\n" +
        "    @bind-Value=\"@selectedEmployeeId\"\n" +
        "    DebounceMs=\"500\"\n" +
        "    LoadingText=\"Searching employees...\"\n" +
        "    EmptyText=\"No employees found.\"\n" +
        "    Placeholder=\"Type to search...\"\n" +
        "    Label=\"Employee\" />\n\n" +
        "@code {\n" +
        "    private async Task<IEnumerable<EmployeeItem>> SearchEmployees(\n" +
        "        string? search, CancellationToken ct)\n" +
        "    {\n" +
        "        await Task.Delay(300, ct);\n" +
        "        if (string.IsNullOrWhiteSpace(search)) return Employees;\n" +
        "        return Employees.Where(e => e.Name.Contains(\n" +
        "            search, StringComparison.OrdinalIgnoreCase));\n" +
        "    }\n" +
        "}";

