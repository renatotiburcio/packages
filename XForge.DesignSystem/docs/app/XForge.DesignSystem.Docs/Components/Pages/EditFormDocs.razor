@code {
private string ProductLabelText => T("Core Open Source", "Core Open Source");
private string PageTitleText => T("Edit Form", "Edit Form");
private string PageStatusText => T("Documentacao completa", "Complete docs");
private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);
private string CopyableCodeTitle => T("Copiar codigo", "Copy code");

private class SimpleModel
{
    [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Informe o nome.")]
    public string? Name { get; set; }
    [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Informe o email.")]
    public string? Email { get; set; }
}
private class SupplierModel
{
    [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Informe a razao social.")]
    public string? Name { get; set; }
    [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Informe o CNPJ.")]
