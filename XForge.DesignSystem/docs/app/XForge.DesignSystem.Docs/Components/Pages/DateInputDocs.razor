@page "/forms/date-input"
@using Microsoft.AspNetCore.Components.Forms
@using XForge.DesignSystem.Core.Primitives
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="Core OSS"
                 Title="Date Input"
                 Status="Complete docs"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">

        <!-- ============================== HERO ============================== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFDateInput" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Multi-cultura", "Multi-culture")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Clamp", "Clamp")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Enterprise", "Enterprise")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Entrada de data para formularios enterprise com cultura, min/max, clamp e validacao integrada.",
                               "Date entry for enterprise forms with culture, min/max, clamp and integrated validation.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("XFDateInput e um input nativo de data com estilizacao enterprise, resolucao de cultura, clamp automatico entre Min/Max, e integracao completa com EditForm e DataAnnotations.",
                               "XFDateInput is a native date input with enterprise styling, culture resolution, auto clamp between Min/Max, and full EditForm and DataAnnotations integration.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        <!-- ============================== METADATA ============================== -->
        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico. Interacoes requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderizacao.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Consideracoes", "Considerations")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor Server: eventos sao tratados via SignalR. Sem latencia adicional para componentes puramente renderizados.", "Blazor Server: events are handled via SignalR. No additional latency for purely rendered components.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor WebAssembly: eventos sao tratados diretamente no cliente. Mais responsivo.", "Blazor WebAssembly: events are handled directly on the client. More responsive.")</XFTypography>
                </XFStack>
            </XFStack>
        </div>)

        <!-- ============================== OVERVIEW / PROBLEM ============================== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 2)</div>)
        </XFStack>

        <!-- ============================== DESIGN ============================== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Hierarquia visual", "Visual Hierarchy"), @<div>@TileGrid(VisualHierarchyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ============================== 11 EXAMPLES ============================== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Basico", "1. Basic"),
                T("XFDateInput com Label e Value.", "XFDateInput with Label and Value."),
                ExBasic(), CodeBasic)

            @Example(T("2. Variantes", "2. Variants"),
                T("Outline, Filled, Soft e Ghost.", "Outline, Filled, Soft and Ghost."),
                ExVariants(), CodeVariants)

            @Example(T("3. Tamanhos", "3. Sizes"),
                T("Sm, Md e Lg.", "Sm, Md and Lg."),
                ExSizes(), CodeSizes)

            @Example(T("4. Min/Max", "4. Min/Max"),
                T("Restricoes de intervalo com Min e Max.", "Date range constraints with Min and Max."),
                ExMinMax(), CodeMinMax)

            @Example(T("5. Cultura", "5. Culture"),
                T("Formatos de data diferentes: pt-BR, en-US, de-DE.", "Different date formats: pt-BR, en-US, de-DE."),
                ExCulture(), CodeCulture)

            @Example(T("6. Tons semanticos", "6. Tone"),
                T("Cores semanticas no focus ring: Primary, Success, Warning, Danger.", "Semantic colors on focus ring: Primary, Success, Warning, Danger."),
                ExTone(), CodeTone)

            @Example(T("7. Disabled/ReadOnly", "7. Disabled/ReadOnly"),
                T("Estados desabilitado e somente leitura.", "Disabled and read-only states."),
                ExStates(), CodeStates)

            @Example(T("8. Prefixo/Sufixo", "8. Prefix/Suffix"),
                T("Adornos de prefixo e sufixo.", "Prefix and suffix adornments."),
                ExPrefixSuffix(), CodePrefixSuffix)

            @Example(T("9. Immediate", "9. Immediate"),
                T("Atualizacao em tempo real a cada tecla.", "Real-time updates on every keystroke."),
                ExImmediate(), CodeImmediate)

            @Example(T("10. EditForm Validation", "10. EditForm Validation"),
                T("Integracao com DataAnnotations: [Required] + mensagens de validacao.", "Integration with DataAnnotations: [Required] + validation messages."),
                ExValidation(), CodeValidation)

            @Example(T("11. AriaValueTextFormat", "11. AriaValueTextFormat"),
                T("Texto acessivel customizado para o valor atual.", "Custom accessible text for the current value."),
                ExAriaValueText(), CodeAriaValueText)
        </XFStack>

        <!-- ============================== VARIANTS / STATES / API / EVENTS ============================== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Variantes", "Variants"), @<div>@NameValueTable(VariantRows, T("Variante", "Variant"), T("Caso de uso", "Use case"))</div>)
            @Section(T("Estados", "States"), @<div>@NameValueTable(StateRows, T("Estado", "State"), T("Comportamento", "Behavior"))</div>)
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Metodos", "Methods"), @<div>@NameValueTable(MethodRows, T("Metodo", "Method"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <!-- ============================== A11Y / KEYBOARD / RESPONSIVE / PERF ============================== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <!-- ============================== ENTERPRISE / ANTI-PATTERNS ============================== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <!-- ============================== TOKENS / RELATED / FAQ / CHANGELOG ============================== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("Design Tokens", @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>

<XForgeDocsPageStandard ComponentName="DateInputDocs" />

@code {
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");

    // ==================== INTERACTIVE STATE ====================
    private DateOnly? _basicValue = new(2026, 6, 15);
    private DateOnly? _variantValue = new(2026, 7, 1);
    private DateOnly? _sizeValue = new(2026, 8, 20);
    private DateOnly? _minMaxValue = new(2026, 5, 15);
    private DateOnly? _cultureValue = new(2026, 12, 25);
    private DateOnly? _toneValue = new(2026, 9, 10);
    private DateOnly? _disabledValue = new(2026, 3, 1);
    private DateOnly? _readonlyValue = new(2026, 1, 15);
    private DateOnly? _prefixValue = new(2026, 6, 1);
    private DateOnly? _immediateValue;
    private string _immediateDisplay = "";
    private DateOnly? _ariaValue = new(2026, 11, 25);
    private bool _formSubmitted;

    private static readonly DateOnly MinQ2 = new(2026, 4, 1);
    private static readonly DateOnly MaxQ2 = new(2026, 6, 30);
    private static readonly DateOnly MinDefault = new(2020, 1, 1);
    private static readonly DateOnly MaxDefault = new(2030, 12, 31);

    // ==================== VALIDATION MODEL ====================
    private DateFormModel _formModel = new();
    private EditContext? _editContext;

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_formModel);
    }

    private void HandleValidSubmit()
    {
        _formSubmitted = true;
    }

    // ==================== HELPERS ====================
    private RenderFragment Section(string title, RenderFragment content) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg" AreaRestricted="false">
        <Header><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography></Header>
        <ChildContent>@content</ChildContent>
    </XFCard>;

    private RenderFragment Example(string title, string description, RenderFragment preview, string codeText) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.None" AreaRestricted="false">
        <Header>
            <div class="px-6 pt-6">
                <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@description</XFTypography>
            </div>
        </Header>
        <ChildContent>
            <div class="grid">
                <div class="border-t border-border-light p-6">@preview</div>
                <div class="border-t border-border-light bg-surface-50 p-6">
                    <XFCode Text="@codeText" Language="razor" Title="@CopyableCodeTitle" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" />
                </div>
            </div>
        </ChildContent>
    </XFCard>;

    private RenderFragment Tile(DocTile item) => @<XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
        <ChildContent>
            <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                <div class="flex items-center gap-4">
                    <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-primary/10 bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                    <div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div>
                </div>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
            </XFStack>
        </ChildContent>
    </XFCard>;

    private RenderFragment TileGrid(IReadOnlyList<DocTile> items, int columns) => @<XFGrid Cols="1" Md="@Math.Min(columns, 2)" Lg="@columns" Gap="4">
        @foreach (var item in items) { @Tile(item) }
    </XFGrid>;

    private RenderFragment WarningGrid(IReadOnlyList<DocTile> items) => @<XFGrid Cols="1" Md="2" Gap="4">
        @foreach (var item in items) {
            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
                <ChildContent>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                        <div class="flex items-center gap-4">
                            <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-danger/10 bg-danger/10 text-danger" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                            <div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div>
                        </div>
                        <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
                    </XFStack>
                </ChildContent>
            </XFCard>
        }
    </XFGrid>;

    private RenderFragment NameValueTable(IReadOnlyList<NameValueRow> rows, string nameHeader, string valueHeader) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader>
            <XFTableRow>
                <XFTableCell Header="true">@nameHeader</XFTableCell>
                <XFTableCell Header="true">@valueHeader</XFTableCell>
            </XFTableRow>
        </XFTableHeader>
        <XFTableBody>
            @foreach (var row in rows) {
                <XFTableRow>
                    <XFTableCell><XFCode Text="@row.Name" /></XFTableCell>
                    <XFTableCell>@row.Value</XFTableCell>
                </XFTableRow>
            }
        </XFTableBody>
    </XFTable>;

    private RenderFragment ApiTable(IReadOnlyList<ApiRow> rows) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader>
            <XFTableRow>
                <XFTableCell Header="true">@T("Parametro", "Parameter")</XFTableCell>
                <XFTableCell Header="true">Type</XFTableCell>
                <XFTableCell Header="true">Default</XFTableCell>
                <XFTableCell Header="true">@T("Descricao", "Description")</XFTableCell>
            </XFTableRow>
        </XFTableHeader>
        <XFTableBody>
            @foreach (var row in rows) {
                <XFTableRow>
                    <XFTableCell><XFCode Text="@row.Name" /></XFTableCell>
                    <XFTableCell>@row.Type</XFTableCell>
                    <XFTableCell><XFCode Text="@row.DefaultValue" /></XFTableCell>
                    <XFTableCell>@row.Description</XFTableCell>
                </XFTableRow>
            }
        </XFTableBody>
    </XFTable>;

    // ==================== HERO PREVIEW ====================
    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFDateInput Label="@T("Data de vencimento", "Due date")"
                     Value="@_basicValue"
                     ValueChanged="@(v => _basicValue = v)"
                     Min="MinQ2"
                     Max="MaxQ2"
                     Tone="XFSemanticColor.Primary"
                     HelperText="@T("Aceita apenas datas do trimestre atual.", "Accepts only current quarter dates.")" />
    </XFStack>;

    // ==================== 1. BASIC ====================
    private RenderFragment ExBasic() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFDateInput Label="@T("Data de nascimento", "Date of birth")"
                     Value="@_basicValue"
                     ValueChanged="@(v => _basicValue = v)"
                     HelperText="@T("Selecione uma data.", "Select a date.")" />
        <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">
            @T("Valor atual: ", "Current value: ") @(_basicValue?.ToString("yyyy-MM-dd") ?? T("nenhum", "none"))
        </XFTypography>
    </XFStack>;

    // ==================== 2. VARIANTS ====================
    private RenderFragment ExVariants() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFDateInput Variant="XFFormVariant.Outline" Label="Outline (default)" Value="@_variantValue" />
        <XFDateInput Variant="XFFormVariant.Filled" Label="Filled" Value="@_variantValue" />
        <XFDateInput Variant="XFFormVariant.Soft" Label="Soft" Value="@_variantValue" />
        <XFDateInput Variant="XFFormVariant.Ghost" Label="Ghost" Value="@_variantValue" />
    </XFStack>;

    // ==================== 3. SIZES ====================
    private RenderFragment ExSizes() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFDateInput Size="XFSize.Sm" Label="Small" Value="@_sizeValue" />
        <XFDateInput Size="XFSize.Md" Label="Medium (default)" Value="@_sizeValue" />
        <XFDateInput Size="XFSize.Lg" Label="Large" Value="@_sizeValue" />
    </XFStack>;

    // ==================== 4. MIN/MAX ====================
    private RenderFragment ExMinMax() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <div>
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Q2 2026", "Q2 2026")" />
            <div class="mt-2">
                <XFDateInput Label="@T("Data dentro do Q2 2026", "Date within Q2 2026")"
                             Value="@_minMaxValue"
                             ValueChanged="@(v => _minMaxValue = v)"
                             Min="MinQ2"
                             Max="MaxQ2"
                             Clamp="true"
                             HelperText="@T("De 2026-04-01 a 2026-06-30. Clamp=true.", "From 2026-04-01 to 2026-06-30. Clamp=true.")" />
            </div>
        </div>
        <div>
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Anos 2020-2030", "Years 2020-2030")" />
            <div class="mt-2">
                <XFDateInput Label="@T("Data entre 2020 e 2030", "Date between 2020 and 2030")"
                             Value="@_minMaxValue"
                             ValueChanged="@(v => _minMaxValue = v)"
                             Min="MinDefault"
                             Max="MaxDefault"
                             Clamp="false"
                             HelperText="@T("Clamp=false: permite valores fora do intervalo.", "Clamp=false: allows values outside the range.")" />
            </div>
        </div>
    </XFStack>;

    // ==================== 5. CULTURE ====================
    private RenderFragment ExCulture() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFDateInput Label="pt-BR (Brasil)"
                     Value="@_cultureValue"
                     ValueChanged="@(v => _cultureValue = v)"
                     CultureName="pt-BR" />
        <XFDateInput Label="en-US (United States)"
                     Value="@_cultureValue"
                     ValueChanged="@(v => _cultureValue = v)"
                     CultureName="en-US" />
        <XFDateInput Label="de-DE (Deutschland)"
                     Value="@_cultureValue"
                     ValueChanged="@(v => _cultureValue = v)"
                     CultureName="de-DE" />
        <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">
            @T("A cultura afeta o aria-valuetext e a exibicao do helper. O formato nativo do input permanece yyyy-MM-dd.",
               "Culture affects aria-valuetext and helper display. The native input format remains yyyy-MM-dd.")
        </XFTypography>
    </XFStack>;

    // ==================== 6. TONE ====================
    private RenderFragment ExTone() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFDateInput Tone="XFSemanticColor.Primary" Label="Primary" Value="@_toneValue" />
        <XFDateInput Tone="XFSemanticColor.Success" Label="Success" Value="@_toneValue" />
        <XFDateInput Tone="XFSemanticColor.Warning" Label="Warning" Value="@_toneValue" />
        <XFDateInput Tone="XFSemanticColor.Danger" Label="Danger" Value="@_toneValue" />
        <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">
            @T("O Tone altera a cor do focus ring ao interagir com o campo.", "Tone changes the focus ring color when interacting with the field.")
        </XFTypography>
    </XFStack>;

    // ==================== 7. STATES ====================
    private RenderFragment ExStates() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFDateInput Label="@T("Desabilitado", "Disabled")" Value="@_disabledValue" Disabled="true" />
        <XFDateInput Label="@T("Somente leitura", "Read only")" Value="@_readonlyValue" ReadOnly="true" />
        <XFDateInput Label="@T("Obrigatorio", "Required")" Value="@_disabledValue" Required="true" HelperText="@T("Campo obrigatorio.", "Required field.")" />
    </XFStack>;

    // ==================== 8. PREFIX/SUFFIX ====================
    private RenderFragment ExPrefixSuffix() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFDateInput Label="@T("Entrega", "Delivery")"
                     Value="@_prefixValue"
                     ValueChanged="@(v => _prefixValue = v)"
                     PrefixText="@T("A partir de", "From")"
                     HelperText="@T("Data minima de entrega.", "Minimum delivery date.")" />
        <XFDateInput Label="@T("Validade", "Expiry")"
                     Value="@_prefixValue"
                     ValueChanged="@(v => _prefixValue = v)"
                     SuffixText="@T("inclusive", "inclusive")"
                     HelperText="@T("Data limite do documento.", "Document deadline.")" />
        <XFDateInput Label="@T("Evento", "Event")"
                     Value="@_prefixValue"
                     ValueChanged="@(v => _prefixValue = v)"
                     PrefixText="📅"
                     SuffixText="@T("confirmado", "confirmed")" />
    </XFStack>;

    // ==================== 9. IMMEDIATE ====================
    private RenderFragment ExImmediate() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFDateInput Label="@T("Data com Immediate", "Date with Immediate")"
                     Value="@_immediateValue"
                     ValueChanged="@(v => { _immediateValue = v; _immediateDisplay = v?.ToString("yyyy-MM-dd") ?? ""; })"
                     Immediate="true"
                     HelperText="@T("Atualiza a cada interacao do teclado.", "Updates on every keyboard interaction.")" />
        <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">
            @T("Valor em tempo real: ", "Real-time value: ") @(_immediateDisplay ?? T("nenhum", "none"))
        </XFTypography>
    </XFStack>;

    // ==================== 10. VALIDATION ====================
    private RenderFragment ExValidation() => @<div>
        <EditForm EditContext="@_editContext" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />
            <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                <XFDateInput Label="@T("Data de inicio", "Start date")" @bind-Value="_formModel.StartDate" />
                <XFDateInput Label="@T("Data de termino", "End date")" @bind-Value="_formModel.EndDate" />
                <XFButton Type="XFButtonType.Submit" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary">@T("Enviar", "Submit")</XFButton>
                @if (_formSubmitted)
                {
                    <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Success" Text="@T("Formulario valido!", "Form valid!")" />
                }
            </XFStack>
        </EditForm>
    </div>;

