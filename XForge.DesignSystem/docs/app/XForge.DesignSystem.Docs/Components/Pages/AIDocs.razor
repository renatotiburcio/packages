@page "/components/ai-chat"
@using XForge.DesignSystem.Components.AI
@using XForge.DesignSystem.Core.Primitives
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="Core OSS"
                 Title="XFAIChat"
                 Status="Premium"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">

        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFAIChat" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="SSE Streaming" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Enterprise", "Enterprise")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Chat AI com streaming SSE, sessoes e renderizacao markdown.",
                               "AI chat with SSE streaming, sessions and markdown rendering.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("Interface completa para conversas com assistentes AI, suportando streaming via Server-Sent Events, gerenciamento de sessoes, formatacao markdown e tool calls.",
                               "Complete interface for AI assistant conversations, supporting Server-Sent Events streaming, session management, markdown formatting and tool calls.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section(T("Blazor Server e Blazor WebAssembly", "Blazor Server and Blazor WebAssembly"), @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Streaming SSE funciona via SignalR.", "SSE streaming works via SignalR.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Streaming nativo via fetch.", "Native streaming via fetch.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona em ambos os modos.", "Works in both modes.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Parcial", "Partial")" /></XFTableCell><XFTableCell>@T("Renderiza HTML estatico. Streaming requer modo interativo.", "Renders static HTML. Streaming requires interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("JS Interop", "JS Interop")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Modulo JS xf-aichat.js gerencia EventSource para SSE e renderiza markdown.", "JS module xf-aichat.js manages EventSource for SSE and renders markdown.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Basico", "1. Basic"),
                T("Chat AI simples com titulo e endpoint.", "Simple AI chat with title and endpoint."),
                ExBasic(), CodeBasic)

            @Example(T("2. Sessao persistente", "2. Persistent session"),
                T("Chat com sessao para manter historico de conversa.", "Chat with session to maintain conversation history."),
                ExSession(), CodeSession)

            @Example(T("3. Modelos e temperatura", "3. Models and temperature"),
                T("Configuracao de modelo AI, temperatura e tokens maximos.", "AI model configuration, temperature and max tokens."),
                ExModelConfig(), CodeModelConfig)

            @Example(T("4. System prompt customizado", "4. Custom system prompt"),
                T("Definindo o comportamento do assistente via SystemPrompt.", "Setting assistant behavior via SystemPrompt."),
                ExSystemPrompt(), CodeSystemPrompt)

            @Example(T("5. Eventos", "5. Events"),
                T("MessageSent, ResponseReceived e StreamingToken para integracao.", "MessageSent, ResponseReceived and StreamingToken for integration."),
                ExEvents(), CodeEvents)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>

    </XFStack>
</XForgeDocsShell>

@code {
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);
    private string CopyableCodeTitle => T("Copiar codigo", "Copy code");

    private RenderFragment HeroPreview() => @<div class="h-64">
        <XFAIChat Title="AI Assistant"
                  Endpoint="/api/ai/chat"
                  Model="gpt-4"
                  Temperature="0.7"
                  ReadOnly="true" />
    </div>;

    private IReadOnlyList<DocTile> QuickFacts => new[]
    {
        new DocTile(T("SSE Streaming", "SSE Streaming"), T("Server-Sent Events para respostas em tempo real.", "Server-Sent Events for real-time responses."), "bolt"),
        new DocTile(T("Sessoes", "Sessions"), T("Gerenciamento de sessao com historico persistente.", "Session management with persistent history."), "folder-open"),
        new DocTile(T("Markdown", "Markdown"), T("Renderizacao de markdown em respostas AI.", "Markdown rendering in AI responses."), "file-code"),
        new DocTile(T("Tool Calls", "Tool Calls"), T("Suporte a chamadas de ferramentas AI.", "Support for AI tool calls."), "wrench")
    };

    private IReadOnlyList<NameValueRow> MetadataRows => new[]
    {
        new NameValueRow("Component", "XFAIChat"),
        new NameValueRow("Namespace", "XForge.DesignSystem.Components.AI"),
        new NameValueRow("Package", "XForge.DesignSystem"),
        new NameValueRow("Category", T("AI / Chat", "AI / Chat")),
        new NameValueRow("Status", T("Estavel", "Stable")),
        new NameValueRow("Dependencies", T("JS interop (xf-aichat.js).", "JS interop (xf-aichat.js)."))
    };

    private IReadOnlyList<DocTile> OverviewItems => new[]
    {
        new DocTile(T("SSE Streaming", "SSE Streaming"), T("Respostas token a token via EventSource.", "Token-by-token responses via EventSource."), "bolt"),
        new DocTile(T("Sessoes", "Sessions"), T("SessionId para historico persistente.", "SessionId for persistent history."), "folder-open"),
        new DocTile(T("Markdown", "Markdown"), T("Renderizacao automatica de code blocks, listas e formatos.", "Automatic rendering of code blocks, lists and formats."), "file-code")
    };

    private IReadOnlyList<DocTile> PurposeItems => new[]
    {
        new DocTile(T("Assistente AI", "AI Assistant"), T("Chat completo com assistente AI.", "Full chat with AI assistant."), "robot"),
        new DocTile(T("Suporte", "Support"), T("Atendimento automatizado com AI.", "Automated support with AI."), "headset"),
        new DocTile(T("Copilot", "Copilot"), T("Assistente de codigo e produtividade.", "Code and productivity assistant."), "code")
    };

    private IReadOnlyList<DocTile> ProblemItems => new[]
    {
        new DocTile(T("Antes", "Before"), T("Integracao manual com APIs AI e SSE.", "Manual integration with AI APIs and SSE."), "xmark"),
        new DocTile(T("Depois", "After"), T("Componente unificado com streaming e sessoes.", "Unified component with streaming and sessions."), "check"),
        new DocTile(T("Acessibilidade", "Accessibility"), T("aria-live para atualizacoes de streaming.", "aria-live for streaming updates."), "universal-access")
    };

    private IReadOnlyList<DocTile> UseItems => new[]
    {
        new DocTile(T("Copilots", "Copilots"), T("Assistentes AI para desenvolvimento.", "AI assistants for development."), "robot"),
        new DocTile(T("Chatbots", "Chatbots"), T("Atendimento ao cliente automatizado.", "Automated customer service."), "headset")
    };

    private IReadOnlyList<DocTile> AvoidItems => new[]
    {
        new DocTile(T("Chat humano", "Human chat"), T("Use XFChat para comunicacao entre pessoas.", "Use XFChat for person-to-person communication."), "xmark"),
        new DocTile(T("Streaming rapido", "Fast streaming"), T("Para latencia minima use WebSocket direto.", "For minimum latency use direct WebSocket."), "triangle-exclamation")
    };

    private IReadOnlyList<DocTile> AnatomyItems => new[]
    {
        new DocTile(T("Header", "Header"), T("Titulo do chat e indicador de modelo.", "Chat title and model indicator."), "heading"),
        new DocTile(T("MessageList", "MessageList"), T("Lista de mensagens com markdown renderizado.", "Message list with rendered markdown."), "messages"),
        new DocTile(T("Composer", "Composer"), T("Area de entrada com botao de envio.", "Input area with send button."), "pen")
    };

    private IReadOnlyList<DocTile> DesignPrincipleItems => new[]
    {
        new DocTile(T("Streaming progressivo", "Progressive streaming"), T("Tokens aparecem conforme recebidos.", "Tokens appear as received."), "bolt"),
        new DocTile(T("Sessao transparente", "Transparent session"), T("Historico visivel e navegavel.", "Visible and navigable history."), "folder-open"),
        new DocTile(T("Zero config", "Zero config"), T("Funciona com endpoint padrao.", "Works with default endpoint."), "gear")
    };

    // --- Examples ---
    private RenderFragment ExBasic() => @<div class="h-72">
        <XFAIChat Title="AI Assistant"
                  Endpoint="/api/ai/chat"
                  ReadOnly="true" />
    </div>;

    private RenderFragment ExSession() => @<div class="h-72">
        <XFAIChat Title="Sessao #1"
                  SessionId="session-abc-123"
                  Endpoint="/api/ai/chat"
                  ReadOnly="true" />
    </div>;

    private RenderFragment ExModelConfig() => @<div class="h-72">
        <XFAIChat Title="GPT-4 Turbo"
                  Model="gpt-4-turbo"
                  Temperature="0.3"
                  MaxTokens="2048"
                  Endpoint="/api/ai/chat"
                  ReadOnly="true" />
    </div>;

    private RenderFragment ExSystemPrompt() => @<div class="h-72">
        <XFAIChat Title="Code Assistant"
                  SystemPrompt="Voce e um assistente de codigo C#. Responda de forma concisa."
                  Endpoint="/api/ai/chat"
                  ReadOnly="true" />
    </div>;

    private RenderFragment ExEvents() => @<div class="h-72">
        <XFAIChat Title="Eventos"
                  Endpoint="/api/ai/chat"
                  OnMessageSent="HandleMessageSent"
                  OnResponseReceived="HandleResponseReceived"
                  ReadOnly="true" />
    </div>;

    private void HandleMessageSent(string message) { }
    private void HandleResponseReceived(string response) { }

    // --- API ---
    private IReadOnlyList<ApiRow> ApiRows => new[]
    {
        new ApiRow("Title", "string?", "null", T("Titulo do chat AI.", "AI chat title.")),
        new ApiRow("SessionId", "string?", "null", T("ID da sessao para historico persistente.", "Session ID for persistent history.")),
        new ApiRow("Model", "string", "\"gpt-4\"", T("Modelo AI a ser utilizado.", "AI model to use.")),
        new ApiRow("SystemPrompt", "string?", "null", T("Prompt de sistema para comportamento do assistente.", "System prompt for assistant behavior.")),
        new ApiRow("Temperature", "double", "0.7", T("Temperatura para variabilidade (0.0-2.0).", "Temperature for variability (0.0-2.0).")),
        new ApiRow("MaxTokens", "int", "4096", T("Numero maximo de tokens na resposta.", "Maximum tokens in response.")),
        new ApiRow("Endpoint", "string", "\"/api/ai/chat\"", T("URL do endpoint da API AI.", "AI API endpoint URL.")),
        new ApiRow("ApiKey", "string?", "null", T("Chave de autenticacao da API.", "API authentication key.")),
        new ApiRow("ReadOnly", "bool", "false", T("Somente leitura.", "Read-only.")),
        new ApiRow("StreamingEnabled", "bool", "true", T("Habilitar streaming SSE.", "Enable SSE streaming.")),
        new ApiRow("MarkdownEnabled", "bool", "true", T("Habilitar renderizacao markdown.", "Enable markdown rendering."))
    };

    private IReadOnlyList<NameValueRow> EventRows => new[]
    {
        new NameValueRow("MessageSent", T("Disparado quando o usuario envia uma mensagem.", "Fired when user sends a message.")),
        new NameValueRow("ResponseReceived", T("Disparado quando a resposta completa e recebida.", "Fired when complete response is received.")),
        new NameValueRow("StreamingToken", T("Disparado para cada token recebido no streaming.", "Fired for each token received in streaming."))
    };

    private IReadOnlyList<DocTile> AccessibilityItems => new[]
    {
        new DocTile("aria-live", T("Regiao aria-live para atualizacoes de streaming.", "aria-live region for streaming updates."), "universal-access"),
        new DocTile("aria-label", T("Composer e mensagens com labels acessiveis.", "Composer and messages with accessible labels."), "tag")
    };

    private IReadOnlyList<DocTile> PerformanceItems => new[]
    {
        new DocTile(T("Streaming", "Streaming"), T("Tokens aparecem incrementalmente, sem esperar resposta completa.", "Tokens appear incrementally, without waiting for full response."), "bolt"),
        new DocTile(T("Sessao leve", "Light session"), T("Historico mantido no servidor via SessionId.", "History maintained server-side via SessionId."), "feather")
    };

    private IReadOnlyList<DocTile> ScenarioItems => new[]
    {
        new DocTile(T("Copilot de codigo", "Code copilot"), T("Assistente AI para revisao e geracao de codigo.", "AI assistant for code review and generation."), "code"),
        new DocTile(T("Atendimento", "Support"), T("Chatbot AI para suporte ao cliente.", "AI chatbot for customer support."), "headset"),
        new DocTile(T("Documentacao", "Documentation"), T("Assistente AI para gerar e revisar docs.", "AI assistant for generating and reviewing docs."), "file-lines")
    };

    private IReadOnlyList<DocTile> BestPracticeItems => new[]
    {
        new DocTile(T("SessionId persistente", "Persistent SessionId"), T("Use o mesmo SessionId para manter contexto.", "Use same SessionId to maintain context."), "folder-open"),
        new DocTile(T("Temperature baixa para factual", "Low temperature for factual"), T("Use 0.0-0.3 para respostas factuais.", "Use 0.0-0.3 for factual responses."), "thermometer-half")
    };

    private IReadOnlyList<DocTile> AntiPatternItems => new[]
    {
        new DocTile(T("ApiKey exposta", "Exposed ApiKey"), T("Nunca exponha ApiKey no codigo-fonte do cliente.", "Never expose ApiKey in client source code."), "xmark"),
        new DocTile(T("Streaming sem fallback", "Streaming without fallback"), T("Forneca fallback para browsers sem EventSource.", "Provide fallback for browsers without EventSource."), "triangle-exclamation")
    };

    private IReadOnlyList<DocTile> RelatedComponentItems => new[]
    {
        new DocTile("XFChat", T("Chat para comunicacao humana.", "Chat for human communication."), "comments"),
        new DocTile("XFMessageList", T("Lista de mensagens standalone.", "Standalone message list."), "list"),
        new DocTile("XFMarkdown", T("Renderizador markdown.", "Markdown renderer."), "file-code")
    };

    private IReadOnlyList<NameValueRow> FaqRows => new[]
    {
        new NameValueRow(T("XFAIChat ou XFChat?", "XFAIChat or XFChat?"), T("XFAIChat para AI com streaming. XFChat para chat humano.", "XFAIChat for AI with streaming. XFChat for human chat.")),
        new NameValueRow(T("Como funciona o streaming?", "How does streaming work?"), T("Via Server-Sent Events (SSE) com EventSource no browser.", "Via Server-Sent Events (SSE) with EventSource in browser.")),
        new NameValueRow(T("Precisa de API Key?", "Need API Key?"), T("Sim, configure via propriedade ApiKey ou headers customizados.", "Yes, configure via ApiKey property or custom headers."))
    };

    private IReadOnlyList<NameValueRow> ChangelogRows => new[]
    {
        new NameValueRow("2026-06-15", T("Pagina de documentacao criada com 5 exemplos e API completa.", "Documentation page created with 5 examples and full API."))
    };

    // --- Code ---
    private string CodeBasic =>
        "<XFAIChat Title=\"AI Assistant\"" + "\n" +
        "          Endpoint=\"/api/ai/chat\"" + "\n" +
        "          Model=\"gpt-4\" />";

    private string CodeSession =>
        "<XFAIChat Title=\"Sessao #1\"" + "\n" +
        "          SessionId=\"session-abc-123\"" + "\n" +
        "          Endpoint=\"/api/ai/chat\" />";

    private string CodeModelConfig =>
        "<XFAIChat Title=\"GPT-4 Turbo\"" + "\n" +
        "          Model=\"gpt-4-turbo\"" + "\n" +
        "          Temperature=\"0.3\"" + "\n" +
        "          MaxTokens=\"2048\"" + "\n" +
        "          Endpoint=\"/api/ai/chat\" />";

    private string CodeSystemPrompt =>
        "<XFAIChat Title=\"Code Assistant\"" + "\n" +
        "          SystemPrompt=\"Voce e um assistente de codigo C#.\"" + "\n" +
        "          Endpoint=\"/api/ai/chat\" />";

    private string CodeEvents =>
        "<XFAIChat Title=\"Eventos\"" + "\n" +
        "          Endpoint=\"/api/ai/chat\"" + "\n" +
        "          OnMessageSent=\"HandleMessageSent\"" + "\n" +
        "          OnResponseReceived=\"HandleResponseReceived\"" + "\n" +
        "          ReadOnly=\"true\" />";

    // --- Helpers ---
    private RenderFragment Section(string title, RenderFragment content) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
        <Header><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography></Header>
        <ChildContent>@content</ChildContent>
    </XFCard>;

    private RenderFragment Example(string title, string description, RenderFragment preview, string codeText) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.None" AreaRestricted="false">
        <Header><div class="px-6 pt-6 pb-2">
            <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@description</XFTypography>
        </div></Header>
        <ChildContent><div class="flex flex-col">
            <div class="border-t border-border-light p-6">@preview</div>
            <div class="border-t border-border-light bg-surface-50 p-6">
                <XFCode Text="@codeText" Language="razor" Title="@CopyableCodeTitle" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" />
            </div>
        </div></ChildContent>
    </XFCard>;

    private RenderFragment Tile(DocTile item) => @<XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent>
        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <div class="flex items-center gap-4">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-primary/10 bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                <div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div>
            </div>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
        </XFStack>
    </ChildContent></XFCard>;

    private RenderFragment TileGrid(IReadOnlyList<DocTile> items, int columns) => @<XFGrid Cols="1" Md="@Math.Min(columns, 2)" Lg="@columns" Gap="4">@foreach (var item in items) { @Tile(item) }</XFGrid>;

    private RenderFragment WarningGrid(IReadOnlyList<DocTile> items) => @<XFGrid Cols="1" Md="2" Gap="4">@foreach (var item in items) {
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <div class="flex items-center gap-4">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-danger/10 bg-danger/10 text-danger" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                <div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div>
            </div>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
        </XFStack></ChildContent></XFCard>
    }</XFGrid>;

    private RenderFragment NameValueTable(IReadOnlyList<NameValueRow> rows, string nameHeader, string valueHeader) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader><XFTableRow><XFTableCell Header="true">@nameHeader</XFTableCell><XFTableCell Header="true">@valueHeader</XFTableCell></XFTableRow></XFTableHeader>
        <XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Value</XFTableCell></XFTableRow> }</XFTableBody>
    </XFTable>;

    private RenderFragment ApiTable(IReadOnlyList<ApiRow> rows) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader><XFTableRow>
            <XFTableCell Header="true">@T("Parametro", "Parameter")</XFTableCell>
            <XFTableCell Header="true">Type</XFTableCell>
            <XFTableCell Header="true">Default</XFTableCell>
            <XFTableCell Header="true">@T("Descricao", "Description")</XFTableCell>
        </XFTableRow></XFTableHeader>
        <XFTableBody>@foreach (var row in rows) {
            <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Type</XFTableCell><XFTableCell><XFCode Text="@row.DefaultValue" /></XFTableCell><XFTableCell>@row.Description</XFTableCell></XFTableRow>
        }</XFTableBody>
    </XFTable>;

    // --- Records ---
    private sealed record DocTile(string Title, string Description, string Icon);
    private sealed record NameValueRow(string Name, string Value);
    private sealed record ApiRow(string Name, string Type, string DefaultValue, string Description);
}
