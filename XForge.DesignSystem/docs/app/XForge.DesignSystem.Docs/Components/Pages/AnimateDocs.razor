@page "/components/animate"
@using XForge.DesignSystem.Core.Primitives
@using Microsoft.AspNetCore.Components.Web

@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFAnimate" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Motion controlado", "Controlled motion")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="OnVisible" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="WCAG AAA" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Animacoes declarativas com respeito ao usuario.", "Declarative animations with user respect.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("23 efeitos, trigger OnVisible, KeepMounted, Duration clamp, prefers-reduced-motion e role=none.",
                               "23 effects, OnVisible trigger, KeepMounted, Duration clamp, prefers-reduced-motion and role=none.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona com JS Interop para IntersectionObserver.", "Works with JS Interop for IntersectionObserver.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona com JS Interop para IntersectionObserver.", "Works with JS Interop for IntersectionObserver.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Parcial", "Partial")" /></XFTableCell><XFTableCell>@T("Trigger OnVisible indisponivel; use Manual com Visible=true.", "OnVisible trigger unavailable; use Manual with Visible=true.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Dependencia JS", "JS Dependency")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Trigger OnVisible usa IntersectionObserver via JS Interop. Trigger Manual e 100% C#.", "Trigger OnVisible uses IntersectionObserver via JS Interop. Trigger Manual is 100% C#.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 3)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== ALL MANDATORY EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Basico", "1. Basic"),
                T("XFAnimate com efeito Fade e Visible=true.", "XFAnimate with Fade effect and Visible=true."),
                ExBasic(), CodeBasic)

            @Example(T("2. Tamanhos", "2. Sizes"),
                T("Duracoes diferentes: 100, 180, 300, 500ms.", "Different durations: 100, 180, 300, 500ms."),
                ExSizes(), CodeSizes)

            @Example(T("3. Cores", "3. Colors"),
                T("Efeitos diferentes em cards coloridos: Fade, Scale, SlideUp, Pop.", "Different effects on colored cards: Fade, Scale, SlideUp, Pop."),
                ExColors(), CodeColors)

            @Example(T("4. Formas", "4. Shapes"),
                T("Efeitos em containers de formas diferentes.", "Effects on different shaped containers."),
                ExShapes(), CodeShapes)

            @Example(T("5. Todos os efeitos", "5. All effects"),
                T("Todos os 23 efeitos XFAnimateEffect demonstrados lado a lado.", "All 23 XFAnimateEffect effects demonstrated side by side."),
                ExAllEffects(), CodeAllEffects)

            @Example(T("6. Efeitos de escala e pop", "6. Scale and pop effects"),
                T("ZoomIn, ZoomOut, Scale, ScaleSoft, Pop, SoftBounce e Pulse.", "ZoomIn, ZoomOut, Scale, ScaleSoft, Pop, SoftBounce and Pulse."),
                ExScaleEffects(), CodeScaleEffects)

            @Example(T("7. Densidade", "7. Density"),
                T("Animacoes escalonadas com delays: 0, 80, 160, 240ms.", "Staggered animations with delays: 0, 80, 160, 240ms."),
                ExDensity(), CodeDensity)

            @Example(T("8. Comportamento especial", "8. Special behavior"),
                T("KeepMounted=true com toggle mostrar/ocultar.", "KeepMounted=true with show/hide toggle."),
                ExKeepMounted(), CodeKeepMounted)

            @Example(T("9. Templates", "9. Templates"),
                T("XFAnimate envolvendo conteudo complexo: linhas de tabela e campos de formulario.", "XFAnimate wrapping complex content: table rows and form fields."),
                ExTemplates(), CodeTemplates)

            @Example(T("10. Feature toggles", "10. Feature toggles"),
                T("Controle manual de visibilidade com Visible.", "Manual visibility control with Visible."),
                ExReducedMotion(), CodeReducedMotion)

            @Example(T("11. Responsivo", "11. Responsive"),
                T("Trigger OnVisible com observacao de viewport.", "OnVisible trigger with viewport observation."),
                ExResponsive(), CodeResponsive)

            @Example(T("12. Cenario enterprise", "12. Enterprise scenario"),
                T("Dashboard ERP com KPIs escalonados, lista de notas e badges de clientes.", "ERP dashboard with staggered KPIs, invoice list and customer badges."),
                ExEnterprise(), CodeEnterprise)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string ProductLabelText => T("Core Open Source", "Core Open Source");
    private string PageTitleText => T("Animate", "Animate");
    private string PageStatusText => T("Documentacao completa", "Complete docs");
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");
    private bool keepMountedVisible = true;
    private Dictionary<string, int> replayCount = new();

    // ─── Hero ───
    private RenderFragment HeroPreview() => @<div class="flex flex-col gap-4">
        <XFGrid Cols="1" Md="3" Gap="4">
            <XFAnimate Trigger="XFAnimateTrigger.OnVisible" Effect="XFAnimateEffect.SlideUp" Duration="500">
                <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
                    <ChildContent>
                        <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Receita Mensal", "Monthly Revenue")</XFTypography>
                        <XFTypography Variant="XFTypographyVariant.H3" Weight="XFTypographyWeight.Bold">R$ 842.500</XFTypography>
                    </ChildContent>
                </XFCard>
            </XFAnimate>
            <XFAnimate Trigger="XFAnimateTrigger.OnVisible" Effect="XFAnimateEffect.Pop" Delay="120" Duration="500">
                <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
                    <ChildContent>
                        <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Pedidos Abertos", "Open Orders")</XFTypography>
                        <XFTypography Variant="XFTypographyVariant.H3" Weight="XFTypographyWeight.Bold">1.284</XFTypography>
                    </ChildContent>
                </XFCard>
            </XFAnimate>
            <XFAnimate Trigger="XFAnimateTrigger.OnVisible" Effect="XFAnimateEffect.FadeBlur" Delay="240" Duration="600">
                <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
                    <ChildContent>
                        <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Risco", "Risk")</XFTypography>
                        <XFBadge Text="@T("Baixo", "Low")" Color="XFBadgeColor.Success" />
                    </ChildContent>
                </XFCard>
            </XFAnimate>
        </XFGrid>
    </div>;

    // ─── 1. Basic ───
    private RenderFragment ExBasic() => @<div class="flex flex-col gap-4">
        <XFAnimate Trigger="XFAnimateTrigger.OnVisible" Effect="XFAnimateEffect.Fade" Duration="400">
            <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
                <ChildContent>
                    <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@T("Card basico com Fade", "Basic card with Fade")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@T("Visible=true, Effect=Fade, Duration=180ms", "Visible=true, Effect=Fade, Duration=180ms")</XFTypography>
                </ChildContent>
            </XFCard>
        </XFAnimate>
    </div>;

    // ─── 2. Sizes (Duration) ───
    private RenderFragment ExSizes() => @<div class="flex flex-col gap-5">
        @foreach (var dur in new[] { 100, 180, 300, 500 })
        {
            <div class="flex flex-col gap-2">
                <div class="flex items-center gap-2">
                    <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="@($"{dur}ms")" />
                    <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T($"Duration={dur}ms", $"Duration={dur}ms")</XFTypography>
                </div>
                <XFAnimate Trigger="XFAnimateTrigger.OnVisible" Effect="XFAnimateEffect.Fade" Duration="@dur">
                    <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
                        <ChildContent><XFTypography Variant="XFTypographyVariant.Body1">@T("Card de exemplo", "Example card") — @($"{dur}ms")</XFTypography></ChildContent>
                    </XFCard>
                </XFAnimate>
            </div>
        }
    </div>;

    // ─── 3. Colors ───
    private RenderFragment ExColors() => @<div class="flex flex-col gap-5">
        @foreach (var item in ColorEffectItems)
        {
            <div class="flex flex-col gap-2">
                <XFBadge Variant="XFBadgeVariant.Soft" Color="@item.BadgeColor" Text="@item.Label" />
                <XFAnimate Trigger="XFAnimateTrigger.OnVisible" Effect="@item.Effect" Duration="500">
                    <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg" Tone="@item.Tone">
                        <ChildContent><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Label</XFTypography></ChildContent>
                    </XFCard>
                </XFAnimate>
            </div>
        }
    </div>;

    // ─── 4. Shapes ───
    private RenderFragment ExShapes() => @<div class="flex flex-col gap-5">
        <div class="grid gap-4 md:grid-cols-2">
            <XFAnimate Trigger="XFAnimateTrigger.OnVisible" Effect="XFAnimateEffect.Pop" Duration="500">
                <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg" Shape="XFCardShape.Rounded">
                    <ChildContent><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@T("Card Rounded + Pop", "Rounded Card + Pop")</XFTypography></ChildContent>
                </XFCard>
            </XFAnimate>
            <XFAnimate Trigger="XFAnimateTrigger.OnVisible" Effect="XFAnimateEffect.Scale" Duration="500">
                <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg" Shape="XFCardShape.Square">
                    <ChildContent><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@T("Card Square + Scale", "Square Card + Scale")</XFTypography></ChildContent>
                </XFCard>
            </XFAnimate>
        </div>
        <div class="flex flex-wrap gap-3">
            <XFAnimate Trigger="XFAnimateTrigger.OnVisible" Effect="XFAnimateEffect.Rise" Duration="500">
                <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="@T("Badge + Rise", "Badge + Rise")" />
            </XFAnimate>
            <XFAnimate Trigger="XFAnimateTrigger.OnVisible" Effect="XFAnimateEffect.Fade" Duration="400">
                <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Badge + Fade", "Badge + Fade")" />
            </XFAnimate>
            <XFAnimate Trigger="XFAnimateTrigger.OnVisible" Effect="XFAnimateEffect.Pop" Duration="500">
                <XFBadge Variant="XFBadgeVariant.Outline" Color="XFBadgeColor.Warning" Text="@T("Badge + Pop", "Badge + Pop")" />
            </XFAnimate>
        </div>
    </div>;

    // ─── 5. All Effects ───
    private RenderFragment ExAllEffects() => @<div class="flex flex-col gap-6">
        <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">
            @T("Rolar a pagina para ver cada efeito. Clique no botao replay para re-animar.",
               "Scroll the page to see each effect. Click the replay button to re-animate.")
        </XFTypography>
        @foreach (var group in AllEffectGroups)
        {
            <div class="flex flex-col gap-2">
                <XFTypography Variant="XFTypographyVariant.Caption" Weight="XFTypographyWeight.Semibold"
                    Color="XFTypographyColor.Muted" Class="uppercase tracking-wider">@group.Key</XFTypography>
                <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                    @foreach (var item in group.Items)
                    {
                        var localItem = item;
                        <div @key="@(item.Name + replayCount.GetValueOrDefault(item.Name))" class="relative">
                            <XFAnimate Trigger="XFAnimateTrigger.OnVisible" Effect="@item.Effect" Duration="500">
                                <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
                                    <ChildContent>
                                        <div class="flex items-center justify-between gap-2">
                                            <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Name</XFTypography>
                                            <button type="button"
                                                class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md border border-border-light bg-bg-surface text-text-muted hover:text-text-primary hover:bg-surface-100 transition-colors"
                                                title="@T("Repetir animacao", "Replay animation")"
                                                @onclick="() => Replay(localItem.Name)">
                                                <span class="text-xs font-bold">R</span>
                                            </button>
                                        </div>
                                        <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@item.Description</XFTypography>
                                    </ChildContent>
                                </XFCard>
                            </XFAnimate>
                        </div>
                    }
                </div>
            </div>
        }
    </div>;

    // ─── 6. Scale and Pop Effects ───
    private RenderFragment ExScaleEffects() => @<div class="grid gap-3 md:grid-cols-2 lg:grid-cols-3">
        @foreach (var item in ScaleEffectItems)
        {
            var localScaleItem = item;
            <div @key="@("sc_" + item.Name + "_" + replayCount.GetValueOrDefault("scale_" + item.Name))" class="relative">
                <XFAnimate Trigger="XFAnimateTrigger.OnVisible" Effect="@item.Effect" Duration="500">
                    <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
                        <ChildContent>
                            <div class="flex items-center justify-between gap-2">
                                <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Name</XFTypography>
                                <button type="button"
                                    class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-md border border-border-light bg-bg-surface text-text-muted hover:text-text-primary hover:bg-surface-100 transition-colors"
                                    title="@T("Repetir animacao", "Replay animation")"
                                    @onclick="() => ReplayScale(localScaleItem.Name)">
                                    <span class="text-xs font-bold">R</span>
                                </button>
                            </div>
                            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@item.Description</XFTypography>
                        </ChildContent>
                    </XFCard>
                </XFAnimate>
            </div>
        }
    </div>;

    // ─── 7. Density ───
    private RenderFragment ExDensity() => @<div class="flex flex-col gap-4">
        @foreach (var d in new[] { 0, 80, 160, 240 })
        {
            <div class="flex items-center gap-3">
                <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="@($"Delay={d}ms")" />
                <XFAnimate Trigger="XFAnimateTrigger.OnVisible" Effect="XFAnimateEffect.SlideUp" Duration="400" Delay="@d">
                    <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg" Class="flex-1">
                        <ChildContent>
                            <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@T($"Card com delay {d}ms", $"Card with {d}ms delay")</XFTypography>
                            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Efeito SlideUp escalonado", "Staggered SlideUp effect")</XFTypography>
                        </ChildContent>
                    </XFCard>
                </XFAnimate>
            </div>
        }
    </div>;

    // ─── 8. KeepMounted ───
    private RenderFragment ExKeepMounted() => @<div class="flex flex-col gap-4">
        <XFButton Text="@(keepMountedVisible ? T("Ocultar", "Hide") : T("Mostrar", "Show"))" Size="XFExtendedSize.Md" OnClick="ToggleKeepMounted" />
        <XFAnimate Visible="keepMountedVisible" KeepMounted="true" Effect="XFAnimateEffect.Rise" Duration="500">
            <XFCard Variant="XFCardVariant.Outlined" Tone="XFSemanticColor.Primary" Padding="XFPadding.Lg">
                <ChildContent>
                    <XFTypography Weight="XFTypographyWeight.Semibold">@T("Resumo operacional", "Operational summary")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@T("Conteudo permanece montado (KeepMounted=true) para preservar estado do formulario.", "Content remains mounted (KeepMounted=true) to preserve form state.")</XFTypography>
                </ChildContent>
            </XFCard>
        </XFAnimate>
    </div>;

    // ─── 9. Templates ───
    private RenderFragment ExTemplates() => @<div class="flex flex-col gap-4">
        <XFAnimate Trigger="XFAnimateTrigger.OnVisible" Effect="XFAnimateEffect.SlideUp" Duration="500">
            <div class="overflow-hidden rounded-lg border border-border-light bg-bg-surface">
                <div class="grid grid-cols-[1fr_8rem_6rem] gap-2 px-5 py-2 text-[11px] font-semibold uppercase tracking-wider text-text-muted border-b border-border-light/60">
                    <span>@T("Produto", "Product")</span><span class="text-right">@T("Preco", "Price")</span><span class="text-center">@T("Estoque", "Stock")</span>
                </div>
                @foreach (var row in TemplateRows)
                {
                    <div class="grid grid-cols-[1fr_8rem_6rem] gap-2 px-5 py-2.5 text-sm items-center border-b border-border-light/30">
                        <span class="text-text-primary">@row[0]</span>
                        <span class="text-right font-mono text-sm">R$ @row[1]</span>
                        <span class="text-center">@row[2]</span>
                    </div>
                }
            </div>
        </XFAnimate>
        <XFAnimate Trigger="XFAnimateTrigger.OnVisible" Effect="XFAnimateEffect.Fade" Delay="120" Duration="400">
            <div class="grid gap-3 md:grid-cols-2">
                <div class="rounded-lg border border-border-light p-4">
                    <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Nome do cliente", "Customer name")</XFTypography>
