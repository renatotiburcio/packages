@page "/feedback/splash-screen"
@using XForge.DesignSystem.Components.Feedback.SplashScreen
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFSplashScreen" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Full screen e compact", "Full screen and compact")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Zero JS", "Zero JS")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Tela de entrada e carregamento inicial com logo, progresso e mensagem.",
                               "Entry and initial loading screen with logo, progress and message.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("Full screen ou compact, logo custom, progresso determinado, animacao, mensagem e ChildContent. Puro C# + Tailwind.",
                               "Full screen or compact, custom logo, determinate progress, animation, message and ChildContent. Pure C# + Tailwind.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico. Interacoes requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderizacao.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Basico", "1. Basic"), T("Splash screen full screen com titulo e mensagem.", "Full screen splash screen with title and message."), ExBasic(), Code1)
            @Example(T("2. Com progresso", "2. With progress"), T("Barra de progresso determinada com valor.", "Determinate progress bar with value."), ExProgress(), Code2)
            @Example(T("3. Logo custom", "3. Custom logo"), T("Logo SVG personalizado no lugar dos initials.", "Custom SVG logo in place of initials."), ExLogo(), Code3)
            @Example(T("4. Compacto", "4. Compact"), T("Modo nao full-screen para cards e secoes.", "Non-full-screen mode for cards and sections."), ExCompact(), Code4)
            @Example(T("5. ChildContent", "5. ChildContent"), T("Conteudo custom abaixo da barra de progresso.", "Custom content below progress bar."), ExChildContent(), Code5)
            @Example(T("6. Cenario enterprise", "6. Enterprise scenario"), T("Splash screen de ERP com branding e progresso.", "ERP splash screen with branding and progress."), ExEnterprise(), Code6)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string ProductLabelText => T("Core Open Source", "Core Open Source");
    private string PageTitleText => T("XFSplashScreen", "XFSplashScreen");
    private string PageStatusText => T("Documentacao completa", "Complete docs");
    private string T(string pt, string en) => LanguageService.Text(pt, en);
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");

    private RenderFragment HeroPreview() => @<div class="flex flex-col gap-4">
        <div class="relative overflow-hidden rounded-lg border border-border-light bg-bg-canvas p-8">
            <div class="grid w-full max-w-xs place-items-center gap-4">
                <div class="grid h-14 w-14 place-items-center rounded-2xl bg-primary text-primary-contrast shadow-lg">
                    <span class="text-xl font-black">XF</span>
                </div>
                <div class="grid gap-1 text-center">
                    <div class="text-lg font-semibold text-text-primary">XForge ERP</div>
                    <div class="text-sm text-text-secondary">@T("Carregando modulo fiscal...", "Loading fiscal module...")</div>
                </div>
                <div class="h-2 w-full max-w-xs overflow-hidden rounded-full bg-surface-200">
                    <div class="h-full w-2/3 rounded-full bg-primary transition-[width] duration-300"></div>
                </div>
            </div>
        </div>
    </div>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("Full screen ou compact", "Full screen or compact"), T("Fixed inset-0 ou modo inline.", "Fixed inset-0 or inline mode."), "maximize"),
        new(T("Logo custom", "Custom logo"), T("RenderFragment ou initials.", "RenderFragment or initials."), "image"),
        new(T("Zero JS", "Zero JS"), T("Nenhum JavaScript interop. Puro C# + Tailwind.", "No JavaScript interop. Pure C# + Tailwind."), "bolt")
    ];

    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFSplashScreen"),
        new("Namespace", "XForge.DesignSystem.Components.Feedback.SplashScreen"),
        new("Package", "XForge.DesignSystem"),
        new("Category", "Feedback / Splash Screen"),
        new("Status", T("Estavel", "Stable")),
        new("Accessibility", T("role=status (full screen), role=region (compact), aria-live=polite, aria-busy=true.", "role=status (full screen), role=region (compact), aria-live=polite, aria-busy=true.")),
        new("Theme support", T("Light, dark e data-brand via tokens.", "Light, dark and data-brand via tokens."))
    ];

    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("Tela de carregamento", "Loading screen"), T("Tela full screen durante carregamento inicial.", "Full screen during initial loading."), "spinner"),
        new(T("Logo e branding", "Logo and branding"), T("Logo custom ou initials com sombra e cor da marca.", "Custom logo or initials with shadow and brand color."), "image"),
        new(T("Progresso", "Progress"), T("Barra de progresso com ou sem valor.", "Progress bar with or without value."), "bars")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Boot do app", "App boot"), T("Splash durante carregamento inicial do ERP.", "Splash during ERP initial loading."), "power-off"),
        new(T("Modulos", "Modules"), T("Splash ao trocar de modulo.", "Splash when switching modules."), "puzzle-piece"),
        new(T("Branding", "Branding"), T("Reforco visual da marca durante espera.", "Brand visual reinforcement during wait."), "paintbrush")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Tela branca sem feedback durante carregamento.", "White screen without feedback during loading."), "xmark"),
        new(T("Depois", "After"), T("Splash screen com logo, mensagem e progresso.", "Splash screen with logo, message and progress."), "check"),
        new(T("Acessibilidade", "Accessibility"), T("aria-live=polite e aria-busy=true informam leitores.", "aria-live=polite and aria-busy=true inform screen readers."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Carregamento inicial", "Initial loading"), T("Boot da aplicacao WebAssembly ou Server.", "WebAssembly or Server app boot."), "power-off"),
        new(T("Carregamento de modulo", "Module loading"), T("Transicao entre modulos do ERP.", "Transition between ERP modules."), "puzzle-piece")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Splash eterno", "Eternal splash"), T("Nao deixe splash visivel indefinidamente.", "Do not leave splash visible indefinitely."), "clock"),
        new(T("Splash interno", "Internal splash"), T("Nao use dentro de dialogs ou modais.", "Do not use inside dialogs or modals."), "ban")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new("Logo", T("Icone ou imagem da marca no centro.", "Brand icon or image in center."), "image"),
        new("Title", T("Nome do app ou modulo.", "App or module name."), "font"),
        new("Progress", T("Barra de progresso determinada ou animada.", "Determinate or animated progress bar."), "bars"),
        new("Message", T("Texto descritivo do que esta carregando.", "Descriptive text of what is loading."), "tag")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(T("Imediatismo", "Immediacy"), T("Splash aparece instantaneamente no boot.", "Splash appears instantly on boot."), "bolt"),
        new(T("Branding", "Branding"), T("Reforca a identidade visual da marca.", "Reinforces brand visual identity."), "paintbrush"),
        new(T("Feedback", "Feedback"), T("Progresso visual reduz ansiedade do usuario.", "Visual progress reduces user anxiety."), "eye")
    ];

    private RenderFragment ExBasic() => @<div class="relative overflow-hidden rounded-lg border border-border-light bg-bg-canvas p-12">
        <div class="grid w-full max-w-xs place-items-center gap-4">
            <div class="grid h-16 w-16 place-items-center rounded-2xl bg-primary text-primary-contrast shadow-lg">
                <span class="text-xl font-black">XF</span>
            </div>
            <div class="grid gap-1 text-center">
                <div class="text-lg font-semibold text-text-primary">XForge ERP</div>
                <div class="text-sm text-text-secondary">@T("Carregando aplicacao...", "Loading application...")</div>
            </div>
            <div class="h-2 w-full max-w-xs overflow-hidden rounded-full bg-surface-200">
                <div class="h-full w-1/2 rounded-full bg-primary motion-safe:animate-pulse"></div>
            </div>
        </div>
    </div>;

    private RenderFragment ExProgress() => @<div class="relative overflow-hidden rounded-lg border border-border-light bg-bg-canvas p-12">
        <div class="grid w-full max-w-xs place-items-center gap-4">
            <div class="grid h-16 w-16 place-items-center rounded-2xl bg-primary text-primary-contrast shadow-lg">
                <span class="text-xl font-black">XF</span>
            </div>
            <div class="grid gap-1 text-center">
                <div class="text-lg font-semibold text-text-primary">XForge ERP</div>
                <div class="text-sm text-text-secondary">@T("Sincronizando dados...", "Syncing data...")</div>
            </div>
            <div class="w-full max-w-xs">
                <div class="h-2 overflow-hidden rounded-full bg-surface-200">
                    <div class="h-full rounded-full bg-primary transition-[width] duration-300" style="width:72%"></div>
                </div>
                <div class="mt-2 text-center text-xs font-medium text-text-secondary">72%</div>
            </div>
        </div>
    </div>;

    private RenderFragment ExLogo() => @<div class="relative overflow-hidden rounded-lg border border-border-light bg-bg-canvas p-12">
        <div class="grid w-full max-w-xs place-items-center gap-4">
            <div class="grid h-16 w-16 place-items-center rounded-2xl bg-success text-white shadow-lg">
                @((MarkupString)XFSvgIcons.MarkupWithSize("check-double", 24))
            </div>
            <div class="grid gap-1 text-center">
                <div class="text-lg font-semibold text-text-primary">Tech Solutions</div>
                <div class="text-sm text-text-secondary">@T("Inicializando...", "Initializing...")</div>
            </div>
            <div class="h-2 w-full max-w-xs overflow-hidden rounded-full bg-surface-200">
                <div class="h-full w-1/2 rounded-full bg-success motion-safe:animate-pulse"></div>
            </div>
        </div>
    </div>;

    private RenderFragment ExCompact() => @<div class="flex flex-col gap-4">
        <div class="relative overflow-hidden rounded-lg border border-border-light bg-bg-canvas p-8">
            <div class="grid w-full max-w-xs place-items-center gap-4">
                <div class="grid h-12 w-12 place-items-center rounded-xl bg-primary text-primary-contrast shadow-lg">
                    <span class="text-lg font-black">XF</span>
                </div>
                <div class="text-sm font-semibold text-text-primary">@T("Modulo fiscal", "Fiscal module")</div>
                <div class="h-2 w-full max-w-xs overflow-hidden rounded-full bg-surface-200">
                    <div class="h-full w-2/3 rounded-full bg-primary transition-[width] duration-300"></div>
                </div>
            </div>
        </div>
    </div>;

    private RenderFragment ExChildContent() => @<div class="relative overflow-hidden rounded-lg border border-border-light bg-bg-canvas p-12">
        <div class="grid w-full max-w-xs place-items-center gap-4">
            <div class="grid h-16 w-16 place-items-center rounded-2xl bg-primary text-primary-contrast shadow-lg">
                <span class="text-xl font-black">XF</span>
            </div>
            <div class="text-lg font-semibold text-text-primary">XForge ERP</div>
            <div class="h-2 w-full max-w-xs overflow-hidden rounded-full bg-surface-200">
                <div class="h-full w-1/2 rounded-full bg-primary motion-safe:animate-pulse"></div>
            </div>
            <div class="flex flex-col items-center gap-2">
                <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("v4.2.1", "v4.2.1")" />
                <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Licenca valida ate 2027", "License valid until 2027")</XFTypography>
            </div>
        </div>
    </div>;

    private RenderFragment ExEnterprise() => @<div class="relative overflow-hidden rounded-lg border border-border-light bg-bg-canvas p-12">
        <div class="grid w-full max-w-sm place-items-center gap-5">
            <div class="grid h-20 w-20 place-items-center rounded-2xl bg-primary text-primary-contrast shadow-xl">
                <span class="text-2xl font-black">XF</span>
            </div>
            <div class="grid gap-2 text-center">
                <div class="text-xl font-bold text-text-primary">XForge ERP</div>
                <div class="text-sm text-text-secondary">@T("Modulo Fiscal | v4.2.1", "Fiscal Module | v4.2.1")</div>
            </div>
            <div class="w-full max-w-xs">
                <div class="h-2.5 overflow-hidden rounded-full bg-surface-200">
                    <div class="h-full rounded-full bg-primary transition-[width] duration-300" style="width:45%"></div>
                </div>
                <div class="mt-2 flex items-center justify-between text-xs text-text-secondary">
                    <span>@T("Carregando tabelas fiscais...", "Loading tax tables...")</span>
                    <span>45%</span>
                </div>
            </div>
            <div class="flex gap-2">
                <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("NFe", "NFe")" />
                <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("CTe", "CTe")" />
                <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("MDFe", "MDFe")" />
            </div>
        </div>
    </div>;

    private const string Code1 = @"<XFSplashScreen Title=""XForge ERP"" Message=""Carregando aplicacao..."" />";
    private const string Code2 = @"<XFSplashScreen Title=""XForge ERP"" Message=""Sincronizando dados..."" Progress=""72"" ShowProgressValue=""true"" />";
    private const string Code3 = @"<XFSplashScreen Title=""Tech Solutions"" Message=""Inicializando..."">
    <Logo><span class=""text-xl font-black"">TS</span></Logo>
</XFSplashScreen>";
    private const string Code4 = @"<XFSplashScreen FullScreen=""false"" Title=""Modulo fiscal"" Progress=""66"" />";
    private const string Code5 = @"<XFSplashScreen Title=""XForge ERP"" Message=""Carregando..."">
    <div class=""flex flex-col items-center gap-2"">
        <XFBadge Variant=""XFBadgeVariant.Soft"" Color=""XFBadgeColor.Success"" Text=""v4.2.1"" />
        <p class=""text-xs text-text-secondary"">Licenca valida ate 2027</p>
    </div>
</XFSplashScreen>";
    private const string Code6 = @"<XFSplashScreen Title=""XForge ERP"" Message=""Modulo Fiscal | v4.2.1"" Progress=""45"" ShowProgressValue=""true"">
    <div class=""flex gap-2"">
        <XFBadge Variant=""XFBadgeVariant.Soft"" Color=""XFBadgeColor.Info"" Text=""NFe"" />
        <XFBadge Variant=""XFBadgeVariant.Soft"" Color=""XFBadgeColor.Success"" Text=""CTe"" />
        <XFBadge Variant=""XFBadgeVariant.Soft"" Color=""XFBadgeColor.Warning"" Text=""MDFe"" />
    </div>
</XFSplashScreen>";

    private IReadOnlyList<ApiRow> ApiRows => [
        new("Visible", "bool", "true", T("Controla visibilidade do componente.", "Controls component visibility.")),
        new("FullScreen", "bool", "true", T("Modo full screen (fixed inset-0) ou compact.", "Full screen mode (fixed inset-0) or compact.")),
        new("Title", "string?", T("\"Carregando\"", "\"Loading\""), T("Titulo do splash.", "Splash title.")),
        new("Message", "string?", "null", T("Mensagem descritiva abaixo do titulo.", "Descriptive message below title.")),
        new("Initials", "string", "\"XF\"", T("Iniciais exibidas quando nao ha Logo.", "Initials shown when no Logo.")),
        new("Progress", "double?", "null", T("Valor de progresso 0-100. Null = indeterminado.", "Progress value 0-100. Null = indeterminate.")),
        new("ShowProgressValue", "bool", "false", T("Exibe valor percentual abaixo da barra.", "Displays percentage value below bar.")),
        new("ProgressValueFormat", "string", "\"{0}%\"", T("Formato do valor de progresso.", "Progress value format.")),
        new("AriaLabel", "string?", T("\"Carregando aplicacao\"", "\"Loading application\""), T("Label de acessibilidade.", "Accessibility label.")),
        new("Logo", "RenderFragment?", "null", T("Logo custom no lugar dos initials.", "Custom logo in place of initials.")),
        new("ChildContent", "RenderFragment?", "null", T("Conteudo custom abaixo do progresso.", "Custom content below progress."))
    ];

    private IReadOnlyList<NameValueRow> EventRows => [];

    private IReadOnlyList<DocTile> AccessibilityItems => [
        new(T("role=status", "role=status"), T("Full screen usa role=status para leitores de tela.", "Full screen uses role=status for screen readers."), "universal-access"),
        new(T("aria-live=polite", "aria-live=polite"), T("Atualizacoes de progresso sao anunciadas.", "Progress updates are announced."), "volume-high"),
        new(T("aria-busy=true", "aria-busy=true"), T("Indica que a pagina esta carregando.", "Indicates page is loading."), "clock"),
        new(T("role=region", "role=region"), T("Modo compacto usa role=region.", "Compact mode uses role=region."), "square")
    ];

    private IReadOnlyList<NameValueRow> KeyboardRows => [];

