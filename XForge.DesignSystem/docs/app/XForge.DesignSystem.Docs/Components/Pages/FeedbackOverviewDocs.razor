    private static RenderFragment SkeletonPreview() => @<XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
        <ChildContent>
            <div class="grid gap-4">
                <div class="flex items-center gap-3">
                    <XFSkeleton Shape="XFSkeletonShape.Avatar" Size="XFExtendedSize.Sm" />
                    <div class="grid flex-1 gap-2">
                        <XFSkeleton Size="XFExtendedSize.Sm" />
