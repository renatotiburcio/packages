        <div class="grid gap-3 md:grid-cols-3">
            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
                <ChildContent>
                    <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">Fila critica</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">12 alertas</XFTypography>
                    <XFBadge Text="Revisar" Color="XFBadgeColor.Warning" />
                </ChildContent>
            </XFCard>
            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
                <ChildContent>
                    <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">SLA medio</XFTypography>
