        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
            <ChildContent>
                <XFAlert Title="Risco baixo" Text="Sem bloqueio para continuar o lote." Tone="XFSemanticColor.Success" Variant="XFAlertVariant.Subtle" />
