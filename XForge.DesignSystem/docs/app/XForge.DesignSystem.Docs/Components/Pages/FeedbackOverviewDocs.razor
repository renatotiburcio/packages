                    <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">Carregamento</XFTypography>
                    <div class="mt-2 grid gap-2">
                        <XFSkeleton Size="XFExtendedSize.Sm" />
                        <XFSkeleton Size="XFExtendedSize.Xs" />
                    </div>
                </ChildContent>
            </XFCard>
        </div>
    </div>;

