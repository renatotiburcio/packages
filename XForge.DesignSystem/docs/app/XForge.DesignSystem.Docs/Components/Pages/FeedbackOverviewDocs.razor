@page "/feedback/overview"
@using XForge.DesignSystem.Core.Primitives
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="Core Open Source" Title="Feedback Overview" Status="Category standard" Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <div class="grid gap-6">
                    <div class="flex flex-wrap gap-2">
                        <XFBadge Text="System states" Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" />
                        <XFBadge Text="Async UX" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" />
                        <XFBadge Text="Accessible feedback" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" />
                    </div>

                    <div class="grid gap-2">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            Feedback transforma estados do sistema em comunicacao clara, acionavel e acessivel.
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            A categoria Feedback existe para padronizar mensagens, progresso, carregamento, confirmacoes
                            e recuperacao de erro em produtos enterprise. Ela reduz incerteza, protege fluxos criticos,
                            comunica risco sem depender apenas de cor e preserva performance com renderizacoes leves,
                            sem layouts instaveis.
                        </XFTypography>
                    </div>

                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <div class="grid gap-3">
                            @foreach (var item in HeroFacts)
                            {
                                @InfoTile(item)
                            }
                        </div>
                    </div>
                </div>
            </ChildContent>
        </XFCard>

        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
            <Header><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">Blazor Server e Blazor WebAssembly</XFTypography></Header>
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                    <XFTable Striped="true" Hoverable="true" Compact="true">
                        <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                        <XFTableBody>
                            <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                            <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                            <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                            <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico. Interacoes requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                        </XFTableBody>
                    </XFTable>
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderizacao.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
                </XFStack>
            </ChildContent>
        </XFCard>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewSection Title="Overview" Description="Feedback cobre comunicacao de estado, espera, progresso e resposta a eventos sem transformar cada pagina em uma colecao de mensagens improvisadas." Items="OverviewItems" Columns="3" />
            <XForgeCategoryOverviewSection Title="Philosophy" Description="Cada mensagem deve responder o que aconteceu, o que muda para o usuario e qual proximo passo existe." Items="PhilosophyItems" />
            <XForgeCategoryOverviewSection Title="Category Objectives" Items="ObjectiveItems" Columns="3" />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewComponentTable Rows="ComponentRows" />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewSection Title="Visual Language" Items="VisualLanguageItems" Columns="3" />
            <XForgeCategoryOverviewSection Title="UX Standards" Items="UxStandardItems" Columns="3" />
            <XForgeCategoryOverviewSection Title="Accessibility Standards" Items="AccessibilityItems" />
            <XForgeCategoryOverviewSection Title="Responsiveness Standards" Items="ResponsiveItems" />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewSection Title="Theme Standards" Items="ThemeItems" />
            <XForgeCategoryOverviewNameDescriptionTable Title="Design Tokens"
                                                        NameHeader="Token Group"
                                                        DescriptionHeader="Purpose"
                                                        CodeName="true"
                                                        Rows="TokenRows" />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewSection Title="Common Patterns" Items="PatternItems" Columns="3" />
            <XForgeCategoryOverviewSection Title="Enterprise Scenarios" Items="ScenarioItems" Columns="3" />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewExampleGallery Examples="Examples" />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewSection Title="Documentation Standards" Items="DocumentationItems" Columns="3" />
            <XForgeCategoryOverviewSection Title="Anti-patterns" Items="AntiPatternItems" Columns="3" />
            <XForgeCategoryOverviewSection Title="Migration Guidance" Items="MigrationItems" Columns="3" />
            <XForgeCategoryOverviewSection Title="Best Practices" Items="BestPracticeItems" Columns="3" />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewNameDescriptionTable Title="Related Categories"
                                                        NameHeader="Category"
                                                        DescriptionHeader="Relationship"
                                                        Rows="RelatedCategories" />
        </XFStack>
    </XFStack>

    <XForgeDocsPageStandard ComponentName="FeedbackOverviewDocs" IsOverview="true" />
</XForgeDocsShell>

@code {
    private string T(string pt, string en) => LanguageService.Text(pt, en);

    private static RenderFragment HeroPreview() => @<div class="grid gap-4">
