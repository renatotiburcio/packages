                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">SLA</XFTypography>
                <div class="mt-2 flex items-center gap-3">
                    <XFProgressRing Value="76" Max="100" Color="XFProgressColor.Success" ShowValue="true" />
                    <XFBadge Text="No prazo" Color="XFBadgeColor.Success" />
