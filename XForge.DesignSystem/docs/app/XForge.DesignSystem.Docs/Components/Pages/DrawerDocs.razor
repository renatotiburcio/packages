@page "/overlays/drawer"
@page "/feedback/drawer"
@page "/components/drawer"
@using XForge.DesignSystem.Components.Overlays.Drawer
@using XForge.DesignSystem.Services
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFDrawer" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("WAI-ARIA", "WAI-ARIA")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Animações", "Animations")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Enterprise", "Enterprise")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Painel lateral ou inferior com animação, acessibilidade e modal nativos.",
                               "Side or bottom panel with native animation, accessibility and modal support.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("XFDrawer renderiza painéis contextuais em 4 posições, 5 tamanhos e 5 tons semânticos. Suporta modal, trap focus, backdrop, responsividade e serviço programático.",
                               "XFDrawer renders contextual panels in 4 positions, 5 sizes and 5 semantic tones. Supports modal, trap focus, backdrop, responsiveness and programmatic service.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="relative flex min-h-[16rem] overflow-hidden rounded-lg border border-border-light bg-surface-50">
                            <div class="flex-1 p-4">
                                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold" Class="mb-2">@T("Lista de pedidos", "Order list")</XFTypography>
                                <div class="space-y-2">
                                    <div class="h-8 rounded bg-surface-200/60"></div>
                                    <div class="h-8 rounded bg-surface-200/60"></div>
                                    <div class="h-8 rounded bg-surface-200/60"></div>
                                    <div class="h-8 rounded bg-surface-200/40"></div>
                                </div>
                            </div>
                            <XFDrawer @bind-Open="_heroOpen"
                                      Title="@T("Detalhes do pedido", "Order details")"
                                      Description="@T("Resumo operacional", "Operational summary")"
                                      Placement="XFDrawerPlacement.Right"
                                      Size="XFOverlaySize.Sm"
                                      Modal="false">
                                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">
                                    @T("Conteúdo do drawer: informações detalhadas do pedido, histórico de movimentações e ações disponíveis.",
                                       "Drawer content: detailed order info, movement history and available actions.")
                                </XFTypography>
                            </XFDrawer>
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observações", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona com prerender-safe guards.", "Works with prerender-safe guards.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona com prerender-safe guards no primeiro render.", "Works with prerender-safe guards on first render.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Parcial", "Partial")" /></XFTableCell><XFTableCell>@T("Renderiza HTML base. Focus trap e animações indisponíveis durante prerender.", "Renders base HTML. Focus trap and animations unavailable during prerender.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("JS Interop", "JS Interop")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Arquivo JS: xf-drawer.js — gerencia xfDialog.trap/release para focus trap, animações de entrada/saída e fechamento por clique externo.", "JS file: xf-drawer.js — manages xfDialog.trap/release for focus trap, enter/exit animations and outside-click close.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Quando carrega: OnAfterRenderAsync. Prerender seguro: try/catch para InvalidOperationException e JSDisconnectedException.", "When loaded: OnAfterRenderAsync. Prerender safe: try/catch for InvalidOperationException and JSDisconnectedException.")</XFTypography>
                </XFStack>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Considerações", "Considerations")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor Server: JS interop via SignalR com latência. Focus trap e animações podem ter resposta mais lenta.", "Blazor Server: JS interop via SignalR with latency. Focus trap and animations may have slower response.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor WebAssembly: JS interop direto sem latência de rede. Disponível após carregamento do WASM.", "Blazor WebAssembly: Direct JS interop with no network latency. Available after WASM load.")</XFTypography>
                </XFStack>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visão geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Propósito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando não usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Hierarquia visual", "Visual Hierarchy"), @<div>@TileGrid(VisualHierarchyItems, 3)</div>)
            @Section(T("Princípios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Básico", "1. Basic"),
                T("XFDrawer simples com Title, Description e ChildContent.", "Simple XFDrawer with Title, Description and ChildContent."),
                ExBasic(), CodeBasic)

            @Example(T("2. Posições", "2. Positions"),
                T("4 posições: Right, Left, Top e Bottom.", "4 positions: Right, Left, Top and Bottom."),
                ExPositions(), CodePositions)

            @Example(T("3. Tamanhos", "3. Sizes"),
                T("Sm, Md, Lg, Xl e Full — para cada posição.", "Sm, Md, Lg, Xl and Full — for each position."),
                ExSizes(), CodeSizes)

            @Example(T("4. Tons semânticos", "4. Semantic Tones"),
                T("5 tons: Default, Primary, Success, Warning e Danger.", "5 tones: Default, Primary, Success, Warning and Danger."),
                ExTones(), CodeTones)

            @Example(T("5. Não modal", "5. Non-modal"),
                T("Modal=false permite interação com conteúdo de fundo.", "Modal=false allows interaction with background content."),
                ExNonModal(), CodeNonModal)

            @Example(T("6. Responsivo", "6. Responsive"),
                T("ResponsiveBelow transforma drawer lateral em bottom sheet em telas menores.", "ResponsiveBelow transforms side drawer into bottom sheet on smaller screens."),
                ExResponsive(), CodeResponsive)

            @Example(T("7. Header e Footer", "7. Header & Footer"),
                T("Header template customizado com ícones e footer com ações.", "Custom header template with icons and footer with actions."),
                ExHeaderFooter(), CodeHeaderFooter)

            @Example(T("8. Eventos canceláveis", "8. Cancelable Events"),
                T("Opening e Closing podem ser Cancelados; OnClose dispara após fechar.", "Opening and Closing can be canceled; OnClose fires after close."),
                ExEvents(), CodeEvents)

            @Example(T("9. Serviço programático", "9. Programmatic Service"),
                T("XFDrawerService.ShowAsync abre drawers sem markup direto.", "XFDrawerService.ShowAsync opens drawers without direct markup."),
                ExService(), CodeServicePattern)

            @Example(T("10. Cenário enterprise", "10. Enterprise Scenario"),
                T("Drawer lateral com dados de NF-e, abas de detalhes e footer com aprovação.", "Side drawer with NF-e data, detail tabs and approval footer."),
                ExEnterprise(), CodeEnterprise)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Variantes", "Variants"), @<div>@NameValueTable(PlacementRows, T("Posição", "Position"), T("Uso", "Usage"))</div>)
            @Section(T("Estados", "States"), @<div>@NameValueTable(StateRows, T("Estado", "State"), T("Comportamento", "Behavior"))</div>)
            @Section("API — XFDrawer", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("API — XFDrawerService", "XFDrawerService API"), @<div>@ApiTable(ServiceApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenários enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padrões de composição", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas práticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padrões", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Propósito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidência", "Evidence"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Limitações conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitação", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versão", "Version"), T("Mudança", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>

@code {
    private string ProductLabelText => T("Core Open Source", "Core Open Source");
    private string PageTitleText => T("XFDrawer", "XFDrawer");
    private string PageStatusText => T("Documentação completa", "Complete docs");
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);
    private string CopyableCodeTitle => T("Código copiável", "Copyable code");

    private bool _heroOpen = true;
    private bool _basicOpen;
    private bool _nonModalOpen;
    private bool _responsiveOpen;
    private bool _hfOpen;
    private bool _enterpriseOpen;

    private List<PositionExample> PositionExamples { get; } = new[]
    {
        XFDrawerPlacement.Right, XFDrawerPlacement.Left,
        XFDrawerPlacement.Top, XFDrawerPlacement.Bottom
    }.Select(p => new PositionExample { Placement = p }).ToList();

    private List<SizeExample> SizeExamples { get; } = new[]
    {
        XFOverlaySize.Sm, XFOverlaySize.Md, XFOverlaySize.Lg,
        XFOverlaySize.Xl, XFOverlaySize.Full
    }.Select(s => new SizeExample { Size = s }).ToList();

    private List<ToneExample> ToneExamples { get; } = new[]
    {
        XFSemanticColor.Default, XFSemanticColor.Primary,
        XFSemanticColor.Success, XFSemanticColor.Warning, XFSemanticColor.Danger
    }.Select(t => new ToneExample { Tone = t }).ToList();

    private class PositionExample { public XFDrawerPlacement Placement { get; set; } public bool Open { get; set; } }
    private class SizeExample { public XFOverlaySize Size { get; set; } public bool Open { get; set; } }
    private class ToneExample { public XFSemanticColor Tone { get; set; } public bool Open { get; set; } }

    private RenderFragment HeroPreview() => @<div class="flex-1 p-4">
        <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold" Class="mb-2">@T("Lista de pedidos", "Order list")</XFTypography>
        <div class="space-y-2">
            <div class="h-8 rounded bg-surface-200/60"></div>
            <div class="h-8 rounded bg-surface-200/60"></div>
            <div class="h-8 rounded bg-surface-200/60"></div>
            <div class="h-8 rounded bg-surface-200/40"></div>
        </div>
    </div>;

    // === HERO ===
    private IReadOnlyList<DocTile> QuickFacts =>
    [
        new(T("WAI-ARIA dialog", "WAI-ARIA dialog"), T("role=dialog, aria-modal, aria-labelledby, aria-describedby, trap focus.", "role=dialog, aria-modal, aria-labelledby, aria-describedby, trap focus."), "universal-access"),
        new(T("4 posições fluidas", "4 fluid positions"), T("Right, Left, Top e Bottom com animação de entrada e saída.", "Right, Left, Top and Bottom with enter/exit animation."), "arrows-up-down"),
        new(T("Serviço programático", "Programmatic service"), T("XFDrawerService.ShowAsync abre drawers de qualquer lugar.", "XFDrawerService.ShowAsync opens drawers from anywhere."), "code")
    ];

    private IReadOnlyList<NameValueRow> MetadataRows =>
    [
        new("Component", "XFDrawer"),
        new("Namespace", "XForge.DesignSystem.Components.Overlays.Drawer"),
        new("Package", "XForge.DesignSystem"),
        new("Category", "Components / Overlays / Drawer"),
        new("Status", T("Estável", "Stable")),
        new("Accessibility", T("WAI-ARIA dialog, trap focus, aria-modal, keyboard (Escape), overlay click.", "WAI-ARIA dialog, trap focus, aria-modal, keyboard (Escape), overlay click.")),
        new("Theme support", T("Light, dark e data-brand via tokens.", "Light, dark and data-brand via tokens."))
    ];

    private IReadOnlyList<DocTile> OverviewItems =>
    [
        new(T("Painel contextual", "Contextual panel"), T("Renderiza conteúdo lateral ou inferior mantendo o contexto da página.", "Renders side or bottom content while keeping page context."), "window-restore"),
        new(T("Animação fluida", "Fluid animation"), T("Transições de entrada e saída com reduced-motion.", "Enter/exit transitions with reduced-motion."), "sparkles"),
        new(T("Serviço DI", "DI service"), T("XFDrawerService injetável para abrir drawers de qualquer camada.", "Injectable XFDrawerService to open drawers from any layer."), "code")
    ];

    private IReadOnlyList<DocTile> PurposeItems =>
    [
        new(T("Preservar contexto", "Preserve context"), T("Mostrar detalhes sem trocar de tela ou perder a posição na lista.", "Show details without changing screens or losing list position."), "eye"),
        new(T("Edição contextual", "Contextual editing"), T("Editar registro ao lado da lista principal.", "Edit record next to main list."), "file-lines"),
        new(T("Filtros e ações", "Filters and actions"), T("Painel lateral para filtros avançados ou ações de aprovação.", "Side panel for advanced filters or approval actions."), "filter")
    ];

    private IReadOnlyList<DocTile> ProblemItems =>
    [
        new(T("Antes", "Before"), T("Páginas com muitos detalhes ocupando espaço vertical, perdendo contexto da lista.", "Pages with many details taking vertical space, losing list context."), "xmark"),
        new(T("Depois", "After"), T("Drawer lateral abre ao lado da lista, preservando contexto e scroll.", "Side drawer opens next to the list, preserving context and scroll."), "check"),
        new(T("Risco reduzido", "Reduced risk"), T("Trap focus, overlay, Escape e aria-modal garantem acessibilidade.", "Trap focus, overlay, Escape and aria-modal ensure accessibility."), "shield-check")
    ];

    private IReadOnlyList<DocTile> UseItems =>
    [
        new(T("Detalhes de registro", "Record details"), T("Abrir drawer ao clicar em linha da tabela para ver detalhes.", "Open drawer on table row click to view details."), "list"),
        new(T("Formulários laterais", "Side forms"), T("Editar registro sem sair da lista principal.", "Edit record without leaving main list."), "file-lines"),
        new(T("Filtros avançados", "Advanced filters"), T("Painel de filtros complexos ao lado da grid.", "Complex filter panel next to grid."), "filter"),
        new(T("Painel de ações", "Action panel"), T("Aprovação, rejeição e comentários em contexto.", "Approval, rejection and comments in context."), "check-circle")
    ];

    private IReadOnlyList<DocTile> AvoidItems =>
    [
        new(T("Navegação principal", "Primary navigation"), T("Use Sidebar ou Rail para navegação entre apps.", "Use Sidebar or Rail for app navigation."), "route"),
        new(T("Conteúdo sempre visível", "Always visible content"), T("Use um layout regular se o conteúdo precisa estar sempre visível.", "Use a regular layout if content must always be visible."), "eye"),
        new(T("Diálogo de confirmação", "Confirmation dialog"), T("Use XFDialog para ações que precisam de confirmação explícita.", "Use XFDialog for actions needing explicit confirmation."), "square"),
        new(T("Muitos drawers empilhados", "Too many stacked drawers"), T("Não empilhe mais de 2 drawers. Use navegação interna.", "Do not stack more than 2 drawers. Use internal navigation."), "layer-group")
    ];

    private IReadOnlyList<DocTile> AnatomyItems =>
    [
        new(T("Overlay", "Overlay"), T("Fundo semi-transparente com backdrop-blur. Clicar fecha o drawer (CloseOnOverlayClick).", "Semi-transparent background with backdrop-blur. Clicking closes drawer (CloseOnOverlayClick)."), "layer-group"),
        new(T("Painel (aside)", "Panel (aside)"), T("Elemento aside com role=dialog, aria-modal, trap focus e animação.", "Aside element with role=dialog, aria-modal, trap focus and animation."), "window-restore"),
        new(T("Header", "Header"), T("Title, Description e botão de fechar. Suporta Header template.", "Title, Description and close button. Supports Header template."), "font"),
        new(T("Body", "Body"), T("ChildContent com overflow-auto para conteúdo longo.", "ChildContent with overflow-auto for long content."), "layer-group"),
        new(T("Footer", "Footer"), T("RenderFragment opcional para ações (salvar, cancelar).", "Optional RenderFragment for actions (save, cancel)."), "check-circle")
    ];

    private IReadOnlyList<DocTile> VisualHierarchyItems =>
    [
        new(T("Modal padrão", "Default modal"), T("Overlay backdrop-blur, trap focus, fecha com Escape ou clique no overlay.", "Backdrop-blur overlay, trap focus, closes on Escape or overlay click."), "lock"),
        new(T("Não modal", "Non-modal"), T("Overlay transparente, pointer-events-none. Permite interação com fundo.", "Transparent overlay, pointer-events-none. Allows background interaction."), "eye"),
        new(T("Responsivo", "Responsive"), T("Lateral vira bottom sheet em breakpoints configuráveis.", "Side becomes bottom sheet at configurable breakpoints."), "mobile-screen")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems =>
    [
        new(T("Preservar contexto", "Preserve context"), T("Drawer abre ao lado, não substitui a tela atual.", "Drawer opens alongside, does not replace current screen."), "eye"),
        new(T("Touch target AAA", "AAA touch target"), T("Botão de fechar com 44px mínimo (WCAG 2.5.8).", "Close button with 44px minimum (WCAG 2.5.8)."), "hand-pointer"),
        new(T("Animação com reduced-motion", "Animation with reduced-motion"), T("Transições CSS respeitam prefers-reduced-motion.", "CSS transitions respect prefers-reduced-motion."), "bolt"),
        new(T("Trap focus", "Trap focus"), T("Foco fica preso dentro do drawer até fechar.", "Focus stays trapped inside drawer until close."), "lock")
    ];

    // === EXAMPLES ===
    private RenderFragment ExBasic() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFButton Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Sm" OnClick="@(() => _basicOpen = !_basicOpen)">
            @(_basicOpen ? T("Fechar", "Close") : T("Abrir", "Open"))
        </XFButton>
        <XFDrawer @bind-Open="_basicOpen"
                  Title="@T("Detalhes do pedido #4821", "Order details #4821")"
                  Description="@T("Resumo operacional do pedido", "Operational order summary")"
                  Placement="XFDrawerPlacement.Right"
                  Size="XFOverlaySize.Sm"
                  Modal="false">
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">
                @T("Conteúdo do drawer: informações detalhadas do pedido, histórico de movimentações e ações disponíveis.",
                   "Drawer content: detailed order information, movement history and available actions.")
            </XFTypography>
        </XFDrawer>
    </XFStack>;

    private RenderFragment ExPositions() => @<XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
        @foreach (var item in PositionExamples)
        {
            <div>
                <div class="flex items-center gap-2 mb-2">
                    <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="@item.Placement.ToString()" />
                    <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@PositionDesc(item.Placement)</XFTypography>
                    <XFButton Variant="XFButtonVariant.Outline" Color="XFButtonColor.Primary" Size="XFExtendedSize.Sm" OnClick="@(() => item.Open = !item.Open)">
                        @(item.Open ? T("Fechar", "Close") : T("Abrir", "Open"))
                    </XFButton>
                </div>
                <XFDrawer @bind-Open="item.Open"
                          Title="@($"{T("Posição", "Position")}: {item.Placement}")"
                          Description="@PositionDesc(item.Placement)"
                          Placement="@item.Placement"
                          Size="XFOverlaySize.Sm"
                          Modal="false">
