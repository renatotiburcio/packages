    private bool _eventsDrawerOpen;
    private string _lastEvent = "";

    private RenderFragment ExEvents() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <div class="flex items-center gap-3">
            <XFButton Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Sm"
                      OnClick="@(() => _eventsDrawerOpen = true)">
                @T("Abrir drawer com eventos", "Open drawer with events")
            </XFButton>
            @if (!string.IsNullOrEmpty(_lastEvent))
            {
                <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@_lastEvent" />
            }
        </div>
        <XFDrawer @bind-Open="_eventsDrawerOpen"
                  Title="@T("Eventos canceláveis", "Cancelable events")"
                  Placement="XFDrawerPlacement.Right"
                  Size="XFOverlaySize.Sm"
                  Opening="@OnOpening"
                  Closing="@OnClosing"
                  OnClose="@(() => _lastEvent = "OnClose fired")">
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">
                @T("Feche com X, Escape ou overlay. Os eventos Opening e Closing podem cancelar a ação.",
                   "Close with X, Escape or overlay. Opening and Closing events can cancel the action.")
            </XFTypography>
        </XFDrawer>
    </XFStack>;

    private Task OnOpening(XFDrawerOpeningEventArgs args)
    {
        _lastEvent = "Opening (allowed)";
        return Task.CompletedTask;
    }

    private Task OnClosing(XFDrawerClosingEventArgs args)
    {
        _lastEvent = $"Closing ({args.Reason})";
        return Task.CompletedTask;
    }

