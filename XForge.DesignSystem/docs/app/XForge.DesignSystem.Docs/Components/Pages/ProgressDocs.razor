@page "/feedback/progress"
@using XForge.DesignSystem.Core.Primitives
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFProgress" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Determinado e indeterminado", "Determinate and indeterminate")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Barra de progresso semantica com label, valor e estados animados.",
                               "Semantic progress bar with label, value and animated states.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("Indicador visual de andamento para tarefas determinadas e indeterminadas, com 7 cores, 5 tamanhos, 3 variantes, faixas e animacao.",
                               "Visual progress indicator for determinate and indeterminate tasks, with 7 colors, 5 sizes, 3 variants, stripes and animation.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico.", "Renders as static HTML.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 3 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Determinado", "1. Determinate"), T("Barra com valor percentual e cor semantica.", "Bar with percentage value and semantic color."), ExDeterminate(), Code1)
            @Example(T("2. Indeterminado", "2. Indeterminate"), T("Animacao continua para operacoes sem tempo estimado.", "Continuous animation for operations without estimated time."), ExIndeterminate(), Code2)
            @Example(T("3. Variantes e Tamanhos", "3. Variants and Sizes"), T("Striped, animated, soft e tamanhos variados.", "Striped, animated, soft and various sizes."), ExVariants(), Code3)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string ProductLabelText => T("Core Open Source", "Core Open Source");
    private string PageTitleText => T("XFProgress", "XFProgress");
    private string PageStatusText => T("Documentacao completa", "Complete docs");
    private string T(string pt, string en) => LanguageService.Text(pt, en);
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFProgress Label="Importacao fiscal" Value="72" ShowValue="true" Color="XFProgressColor.Success" />
        <XFProgress Label="Backup" Value="45" ShowValue="true" Color="XFProgressColor.Info" />
        <XFProgress Label="Sincronizacao" Value="90" ShowValue="true" Color="XFProgressColor.Warning" />
    </XFStack>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("Determinado e indeterminado", "Determinate and indeterminate"), T("Barra com valor ou animacao continua.", "Bar with value or continuous animation."), "arrows-left-right"),
        new(T("7 cores semanticas", "7 semantic colors"), T("Primary, Secondary, Success, Warning, Danger, Info, Neutral.", "Primary, Secondary, Success, Warning, Danger, Info, Neutral."), "palette"),
        new(T("Zero JS", "Zero JS"), T("Nenhum JavaScript interop. Puro C# + Tailwind.", "No JavaScript interop. Pure C# + Tailwind."), "bolt")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFProgress"),
        new("Namespace", "XForge.DesignSystem.Components.Feedback.Progress"),
        new("Package", "XForge.DesignSystem"),
        new("Category", "Feedback / Progress"),
        new("Status", T("Estavel", "Stable")),
        new("Accessibility", T("role=progressbar, aria-valuenow, aria-valuemin, aria-valuemax, aria-valuetext, aria-label.", "role=progressbar, aria-valuenow, aria-valuemin, aria-valuemax, aria-valuetext, aria-label.")),
        new("Theme support", T("Light, dark e data-brand via tokens.", "Light, dark and data-brand via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("Barra de progresso", "Progress bar"), T("Indicador visual horizontal de andamento.", "Horizontal visual progress indicator."), "bars"),
        new(T("Valor ou indeterminado", "Value or indeterminate"), T("Mostra percentual ou animacao continua.", "Shows percentage or continuous animation."), "arrows-left-right"),
        new(T("Label e valor", "Label and value"), T("Texto descritivo e percentual opcional.", "Descriptive text and optional percentage."), "tag")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Uploads", "Uploads"), T("Mostrar progresso de upload de arquivos.", "Show file upload progress."), "upload"),
        new(T("Processamento", "Processing"), T("Indicar processamento de dados em lote.", "Indicate batch data processing."), "database"),
        new(T("Sincronizacao", "Synchronization"), T("Mostrar sincronizacao de dados.", "Show data synchronization."), "arrows-rotate")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Sem feedback visual de progresso.", "No visual progress feedback."), "xmark"),
        new(T("Depois", "After"), T("Barra semantica com cor, valor e label.", "Semantic bar with color, value and label."), "check"),
        new(T("Acessibilidade", "Accessibility"), T("role=progressbar, aria-valuetext, aria-label.", "role=progressbar, aria-valuetext, aria-label."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Operacoes longas", "Long operations"), T("Uploads, downloads, processamento.", "Uploads, downloads, processing."), "clock"),
        new(T("Indeterminado", "Indeterminate"), T("Operacoes sem tempo estimado.", "Operations without estimated time."), "spinner")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Navegacao", "Navigation"), T("Use XFSteps para etapas.", "Use XFSteps for steps."), "route"),
        new(T("Contagem regressiva", "Countdown"), T("Use XFTimeSpan para contagem.", "Use XFTimeSpan for countdown."), "clock")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new("Track", T("Fundo da barra com cor neutra.", "Bar background with neutral color."), "minus"),
        new("Fill", T("Preenchimento com cor semantica.", "Fill with semantic color."), "bars"),
        new("Label", T("Texto descritivo acima da barra.", "Descriptive text above bar."), "font"),
        new("Value", T("Percentual numerico (ShowValue).", "Numeric percentage (ShowValue)."), "percent")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(T("Feedback visual", "Visual feedback"), T("Mostra progresso imediatamente.", "Shows progress immediately."), "eye"),
        new(T("Cor = significado", "Color = meaning"), T("Success=concluido, Info=andamento, Warning=atraso.", "Success=done, Info=in-progress, Warning=delayed."), "palette"),
        new(T("Simplicidade", "Simplicity"), T("Uma barra, uma metrica. Sem sobrecarga.", "One bar, one metric. No overload."), "minimize")
    ];

    // === EXAMPLES ===
    private RenderFragment ExDeterminate() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFProgress Label="Importacao fiscal" Value="72" ShowValue="true" Color="XFProgressColor.Success" />
        <XFProgress Label="Backup" Value="45" ShowValue="true" Color="XFProgressColor.Info" />
        <XFProgress Label="Sincronizacao" Value="90" ShowValue="true" Color="XFProgressColor.Warning" />
    </XFStack>;

    private RenderFragment ExIndeterminate() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFProgress Label="Sincronizando dados" Indeterminate="true" Color="XFProgressColor.Info" />
    </XFStack>;

    private RenderFragment ExVariants() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFProgress Label="Striped + Animated" Value="60" Striped="true" Animated="true" Color="XFProgressColor.Primary" />
        <XFProgress Label="Soft variant" Value="40" Variant="XFProgressVariant.Soft" Color="XFProgressColor.Secondary" />
        <XFProgress Label="Large" Value="80" Size="XFExtendedSize.Lg" Color="XFProgressColor.Success" />
    </XFStack>;

    private const string Code1 = @"<XFProgress Label=""Importacao fiscal"" Value=""72"" ShowValue=""true"" Color=""XFProgressColor.Success"" />";
    private const string Code2 = @"<XFProgress Label=""Sincronizando dados"" Indeterminate=""true"" Color=""XFProgressColor.Info"" />";
    private const string Code3 = @"<XFProgress Label=""Striped + Animated"" Value=""60"" Striped=""true"" Animated=""true"" Color=""XFProgressColor.Primary"" />
<XFProgress Label=""Soft variant"" Value=""40"" Variant=""XFProgressVariant.Soft"" Color=""XFProgressColor.Secondary"" />
<XFProgress Label=""Large"" Value=""80"" Size=""XFExtendedSize.Lg"" Color=""XFProgressColor.Success"" />";

    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("Value", "double", "0", T("Valor atual (0-100).", "Current value (0-100).")),
        new("Min", "double", "0", T("Valor minimo.", "Minimum value.")),
        new("Max", "double", "100", T("Valor maximo.", "Maximum value.")),
        new("Label", "string?", "null", T("Texto descritivo da barra.", "Descriptive bar text.")),
        new("ShowValue", "bool", "false", T("Exibe valor percentual.", "Shows percentage value.")),
        new("Indeterminate", "bool", "false", T("Estado indeterminado (animacao continua).", "Indeterminate state (continuous animation).")),
        new("Striped", "bool", "false", T("Faixas diagonais na barra.", "Diagonal stripes on bar.")),
        new("Animated", "bool", "false", T("Animacao das faixas.", "Stripe animation.")),
        new("Color", "XFProgressColor", "Primary", T("Primary, Secondary, Success, Warning, Danger, Info, Neutral.", "Primary, Secondary, Success, Warning, Danger, Info, Neutral.")),
        new("Size", "XFExtendedSize", "Md", T("Xs, Sm, Md, Lg, Xl.", "Xs, Sm, Md, Lg, Xl.")),
        new("Variant", "XFProgressVariant", "Solid", T("Solid, Soft, Subtle.", "Solid, Soft, Subtle."))
    ];

    private IReadOnlyList<NameValueRow> EventRows => [];

    // === ACCESSIBILITY ===
    private IReadOnlyList<DocTile> AccessibilityItems => [
        new(T("role=progressbar", "role=progressbar"), T("Barra usa role=progressbar para leitores de tela.", "Bar uses role=progressbar for screen readers."), "universal-access"),
        new(T("aria-valuetext", "aria-valuetext"), T("Texto legivel do valor (ex: 72%).", "Readable value text (e.g. 72%)."), "font"),
        new(T("aria-label", "aria-label"), T("Label descritivo da operacao.", "Descriptive operation label."), "tag"),
        new(T("Indeterminado", "Indeterminate"), T("aria-valuetext=\"Carregando\" quando indeterminado.", "aria-valuetext=\"Loading\" when indeterminate."), "spinner")
    ];

    private IReadOnlyList<NameValueRow> KeyboardRows => [];

    // === RESPONSIVENESS ===
    private IReadOnlyList<DocTile> ResponsivenessItems => [
        new(T("Largura total", "Full width"), T("Barra ocupa 100% do container.", "Bar occupies 100% of container."), "maximize"),
        new(T("Tamanho responsivo", "Responsive size"), T("Sm para mobile, Md para desktop.", "Sm for mobile, Md for desktop."), "mobile-screen")
    ];

    // === PERFORMANCE ===
    private IReadOnlyList<DocTile> PerformanceItems => [
        new(T("Zero JS", "Zero JS"), T("Nenhum JavaScript interop.", "No JavaScript interop."), "bolt"),
        new(T("Render leve", "Light render"), T("Tag div nativa sem wrappers.", "Native div tag without wrappers."), "feather")
    ];

    // === SCENARIOS ===
    private IReadOnlyList<DocTile> ScenarioItems => [
        new(T("Upload ERP", "ERP upload"), T("Upload de XML de NF-e com progresso.", "NF-e XML upload with progress."), "upload"),
        new(T("Backup", "Backup"), T("Backup de banco de dados com percentual.", "Database backup with percentage."), "database"),
        new(T("Sincronizacao", "Synchronization"), T("Sincronizacao de dados entre sistemas.", "Data sync between systems."), "arrows-rotate")
    ];

    // === COMPOSITION ===
    private IReadOnlyList<DocTile> CompositionItems => [
        new(T("Progress + Label", "Progress + Label"), T("Label descritivo acima da barra.", "Descriptive label above bar."), "font"),
        new(T("Progress + Value", "Progress + Value"), T("Percentual numerico ao lado.", "Numeric percentage alongside."), "percent"),
        new(T("Progress + Card", "Progress + Card"), T("Barra dentro de XFCard para contexto.", "Bar inside XFCard for context."), "square")
    ];

    // === BEST PRACTICES ===
    private IReadOnlyList<DocTile> BestPracticeItems => [
        new(T("Label descritivo", "Descriptive label"), T("Sempre descreva a operacao.", "Always describe the operation."), "align-left"),
        new(T("Cor semantica", "Semantic color"), T("Use Success para concluido, Info para andamento.", "Use Success for done, Info for in-progress."), "palette"),
        new(T("ShowValue quando util", "ShowValue when useful"), T("Percentual ajuda em uploads longos.", "Percentage helps in long uploads."), "percent"),
        new(T("Indeterminado para loading", "Indeterminate for loading"), T("Use quando nao ha estimativa de tempo.", "Use when no time estimate available."), "spinner")
    ];

    // === ANTI-PATTERNS ===
    private IReadOnlyList<DocTile> AntiPatternItems => [
        new(T("Sem label", "No label"), T("Barra sem texto e confusa.", "Bar without text is confusing."), "xmark"),
        new(T("Muitas barras", "Too many bars"), T("Evite mais de 3 progressos simultaneos.", "Avoid more than 3 simultaneous progress bars."), "ban"),
        new(T("Cor sem significado", "Color without meaning"), T("Nao use cores aleatorias.", "Do not use random colors."), "triangle-exclamation")
    ];

    // === TOKENS ===
    private IReadOnlyList<NameValueRow> TokenRows => [
        new("track", T("h-2 rounded-full bg-surface-200.", "h-2 rounded-full bg-surface-200.")),
        new("fill", T("h-full rounded-full transition-all duration-300.", "h-full rounded-full transition-all duration-300.")),
        new("label", T("text-sm font-medium text-text-primary.", "text-sm font-medium text-text-primary."))
    ];

    // === THEMING ===
    private IReadOnlyList<DocTile> ThemeItems => [
        new("data-theme", T("Tokens light/dark via CSS variables.", "Light/dark tokens via CSS variables."), "moon"),
        new("data-brand", T("Primary acompanha marca ativa.", "Primary follows active brand."), "swatchbook")
    ];

    // === TESTING ===
    private IReadOnlyList<NameValueRow> TestingRows => [
        new("Unit", T("Testes de render, props, variants, colors, indeterminate.", "Render, props, variants, colors, indeterminate tests.")),
        new("Accessibility", T("role=progressbar, aria-valuenow, aria-valuetext, aria-label.", "role=progressbar, aria-valuenow, aria-valuetext, aria-label."))
    ];

    // === LIMITATIONS ===
    private IReadOnlyList<NameValueRow> LimitationRows => [
        new("Valor", T("Value deve estar entre Min e Max.", "Value must be between Min and Max.")),
        new("Indeterminado", T("Nao mostra valor numerico quando indeterminado.", "Does not show numeric value when indeterminate."))
    ];

    // === RELATED ===
    private IReadOnlyList<DocTile> RelatedComponentItems => [
        new("XFProgressRing", T("Progresso circular.", "Circular progress."), "circle-notch"),
        new("XFSteps", T("Etapas sequenciais.", "Sequential steps."), "list-ol"),
        new("XFSkeleton", T("Placeholder de carregamento.", "Loading placeholder."), "square")
    ];

    // === FAQ ===
    private IReadOnlyList<NameValueRow> FaqRows => [
        new(T("Progress vs ProgressRing?", "Progress vs ProgressRing?"), T("Progress = barra horizontal. ProgressRing = circular.", "Progress = horizontal bar. ProgressRing = circular.")),
        new(T("Como atualizar o valor?", "How to update value?"), T("Use @bind-Value ou ValueChanged.", "Use @bind-Value or ValueChanged.")),
        new(T("Funciona sem JS?", "Works without JS?"), T("Sim. Nenhum JavaScript interop.", "Yes. No JavaScript interop."))
    ];

    // === CHANGELOG ===
    private IReadOnlyList<NameValueRow> ChangelogRows => [
        new("2026-06-03", T("Pagina refeita no padrao enterprise com 3 exemplos renderizados.", "Page rewritten in enterprise standard with 3 rendered examples.")),
        new("2026-06-12", T("Refatorada para padrao AppShellDocs com 26 secoes.", "Refactored to AppShellDocs pattern with 26 sections."))
    ];

    // === HELPERS ===
    private RenderFragment Section(string title, RenderFragment content) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
        <Header><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography></Header>
        <ChildContent>@content</ChildContent>
    </XFCard>;

    private RenderFragment Example(string title, string description, RenderFragment preview, string codeText) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.None" AreaRestricted="false">
        <Header><div class="px-6 pt-6 pb-2">
            <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@description</XFTypography>
        </div></Header>
        <ChildContent><div class="flex flex-col">
            <div class="border-t border-border-light p-6">@preview</div>
            <div class="border-t border-border-light bg-surface-50 p-6">
                <XFCode Text="@codeText" Language="razor" Title="@CopyableCodeTitle" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" />
            </div>
        </div></ChildContent>
    </XFCard>;

    private RenderFragment Tile(DocTile item) => @<XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent>
        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <div class="flex items-center gap-4">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-primary/10 bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                <div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div>
            </div>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
        </XFStack>
    </ChildContent></XFCard>;

    private RenderFragment TileGrid(IReadOnlyList<DocTile> items, int columns) => @<XFGrid Cols="1" Md="@Math.Min(columns, 2)" Lg="@columns" Gap="4">@foreach (var item in items) { @Tile(item) }</XFGrid>;

    private RenderFragment WarningGrid(IReadOnlyList<DocTile> items) => @<XFGrid Cols="1" Md="2" Gap="4">@foreach (var item in items) {
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <div class="flex items-center gap-4">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-danger/10 bg-danger/10 text-danger" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                <div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div>
            </div>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
        </XFStack></ChildContent></XFCard>
    }</XFGrid>;

    private RenderFragment NameValueTable(IReadOnlyList<NameValueRow> rows, string nameHeader, string valueHeader) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader><XFTableRow><XFTableCell Header="true">@nameHeader</XFTableCell><XFTableCell Header="true">@valueHeader</XFTableCell></XFTableRow></XFTableHeader>
        <XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Value</XFTableCell></XFTableRow> }</XFTableBody>
    </XFTable>;

    private RenderFragment ApiTable(IReadOnlyList<ApiRow> rows) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Parametro", "Parameter")</XFTableCell><XFTableCell Header="true">Type</XFTableCell><XFTableCell Header="true">Default</XFTableCell><XFTableCell Header="true">@T("Descricao", "Description")</XFTableCell></XFTableRow></XFTableHeader>
        <XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Type</XFTableCell><XFTableCell><XFCode Text="@row.DefaultValue" /></XFTableCell><XFTableCell>@row.Description</XFTableCell></XFTableRow> }</XFTableBody>
    </XFTable>;

    // === RECORDS ===
    private sealed record DocTile(string Title, string Description, string Icon);
    private sealed record NameValueRow(string Name, string Value);
    private sealed record ApiRow(string Name, string Type, string DefaultValue, string Description);
}