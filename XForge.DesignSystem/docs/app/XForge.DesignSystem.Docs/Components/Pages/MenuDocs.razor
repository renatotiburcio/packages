@page "/navigation/menu"
@page "/components/menu"

@inject XForgeDocsLanguageService LanguageService
@using XForge.DesignSystem.Core.Primitives
@using XForge.DesignSystem.Components.Layout

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO CARD ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFMenu" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("WAI-ARIA", "WAI-ARIA")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Navegação", "Navigation")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Enterprise", "Enterprise")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Menu de Navegação acessível e data-driven.", "Accessible and data-driven navigation menu.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("7 variantes, 3 tamanhos, 3 modos de exibição, 6 tons ativos, colapsavel, aninhamento, templates, badges, seções e touch target 44px WCAG AAA.",
                               "7 variants, 3 sizes, 3 display modes, 6 active tones, collapsible, nesting, templates, badges, sections and 44px WCAG AAA touch target.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        <!-- ===== METADATA ===== -->
        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observações", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estático. Interações requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependências JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente não utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderizacao.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Consideracoes", "Considerations")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor Server: eventos sao tratados via SignalR. Sem latencia adicional para componentes puramente renderizados.", "Blazor Server: events are handled via SignalR. No additional latency for purely rendered components.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor WebAssembly: eventos sao tratados diretamente no Cliente. Mais responsivo.", "Blazor WebAssembly: events are handled directly on the client. More responsive.")</XFTypography>
                </XFStack>
            </XFStack>
        </div>)

        <!-- ===== OVERVIEW / PURPOSE / WHEN ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visão geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Propósito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando não usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
        </XFStack>

        <!-- ===== 12 MANDATORY EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Básico", "1. Basic"),
                T("Menu data-driven vertical simples com itens do ERP.", "Simple vertical data-driven menu with ERP items."),
                ExBasico(), CodeBasico)

            @Example(T("2. Tamanhos", "2. Sizes"),
                T("Sm (44px), Md (48px) e Lg (56px) — touch target otimizado.", "Sm (44px), Md (48px) and Lg (56px) — optimized touch target."),
                ExTamanhos(), CodeTamanhos)

            @Example(T("3. Variantes", "3. Variants"),
                T("7 variantes: Surface, Plain, Soft, TopNav, Dropdown, Sidebar, DarkSidebar.", "7 variants: Surface, Plain, Soft, TopNav, Dropdown, Sidebar, DarkSidebar."),
                ExVariantes(), CodeVariantes)

            @Example(T("4. Modo de exibição", "4. Display Mode"),
                T("IconAndText, IconOnly e TextOnly.", "IconAndText, IconOnly and TextOnly."),
                ExDisplayMode(), CodeDisplayMode)

            @Example(T("5. Tons ativos", "5. Active Tones"),
                T("6 tons de cor para item selecionado: Primary, Secondary, Success, Warning, Danger, Neutral.", "6 color tones for selected item: Primary, Secondary, Success, Warning, Danger, Neutral."),
                ExActiveTone(), CodeActiveTone)

            @Example(T("6. Orientação", "6. Orientation"),
                T("Vertical e Horizontal (XFOrientation).", "Vertical and Horizontal (XFOrientation)."),
                ExOrientacao(), CodeOrientacao)

            @Example(T("7. Colapsável", "7. Collapsible"),
                T("Menu lateral colapsavel com botao toggle.", "Collapsible sidebar menu with toggle button."),
                ExCollapsible(), CodeCollapsible)

            @Example(T("8. Expansão", "8. Expansion"),
                T("Modo multipla vs única expansao, itens com Children.", "Multiple vs single expansion mode, items with Children."),
                ExExpansao(), CodeExpansao)

            @Example(T("9. Templates", "9. Templates"),
                T("ItemTemplate global para renderizacao custom.", "Global ItemTemplate for custom rendering."),
                ExTemplates(), CodeTemplates)

            @Example(T("10. Badges e Seções", "10. Badges and Sections"),
                T("Badges com tons diferentes, Kind=Section e Kind=Separator.", "Badges with different tones, Kind=Section and Kind=Separator."),
                ExBadgesEseções(), CodeBadgesEseções)

            @Example(T("11. Dark Sidebar", "11. Dark Sidebar"),
                T("Variante DarkSidebar com seções, badges e Descrições.", "DarkSidebar variant with sections, badges and descriptions."),
                ExDarkSidebar(), CodeDarkSidebar)

            @Example(T("12. Cenário enterprise", "12. Enterprise Scenario"),
                T("Sidebar ERP completa com XFMenuItem: módulos, filhos, badges, Descrições e icones.", "Full ERP sidebar with XFMenuItem: modules, children, badges, descriptions and icons."),
                ExEnterprise(), CodeEnterprise)
        </XFStack>

        <!-- ===== API / EVENTS ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <!-- ===== DESIGN / RESPONSIVENESS / PERFORMANCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Princípios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 3)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 3)</div>)
        </XFStack>

        <!-- ===== ACCESSIBILITY / KEYBOARD ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <!-- ===== ENTERPRISE / COMPOSITION / BEST PRACTICES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenários enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padrões de composição", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas práticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padrões", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <!-- ===== TOKENS / THEMES / SECURITY / TESTING ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("Design Tokens", @<div>@NameValueTable(TokenRows, T("Categoria", "Category"), T("Tokens", "Tokens"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Segurança", "Security"), @<div>@TileGrid(SecurityItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestRows, T("Tipo", "Type"), T("Cobertura", "Coverage"))</div>)
        </XFStack>

        <!-- ===== LIMITATIONS / MIGRATION / RELATED / FAQ / CHANGELOG ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Limitações conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitação", "Limitation"), T("Detalhe", "Detail"))</div>)
            @Section(T("Notas de migração", "Migration Notes"), @<div>@TileGrid(MigrationItems, 2)</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versão", "Version"), T("Mudança", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>

@code {
    private string ProductLabelText => T("Core Open Source", "Core Open Source");
    private string PageTitleText => T("Menu", "Menu");
    private string PageStatusText => T("Documentacao completa", "Complete docs");
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);
    private string CopyableCodeTitle => T("Código copiável", "Copyable code");

    private RenderFragment SvgIcon(string name) => builder => builder.AddMarkupContent(0, XFSvgIcons.MarkupWithSize(name, 18).Value);

    private sealed record DocTile(string Title, string Description, string Icon);
    private sealed record NameValueRow(string Name, string Value);
    private sealed record ApiRow(string Name, string Type, string DefaultValue, string Description);

    // ─── Helpers ───
    private RenderFragment Section(string title, RenderFragment content) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
        <Header><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography></Header>
        <ChildContent>@content</ChildContent>
    </XFCard>;
    private RenderFragment Example(string title, string description, RenderFragment preview, string codeText) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.None" AreaRestricted="false">
        <Header><div class="px-6 pt-6 pb-2">
            <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@description</XFTypography>
        </div></Header>
        <ChildContent><div class="flex flex-col">
            <div class="border-t border-border-light bg-surface-50/30 p-6">@preview</div>
            <div class="border-t border-border-light bg-surface-50 p-6">
                <XFCode Text="@codeText" Language="razor" Title="@CopyableCodeTitle" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" />
            </div>
        </div></ChildContent>
    </XFCard>;
    private RenderFragment Tile(DocTile item) => @<XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent>
        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <div class="flex items-center gap-4">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-primary/10 bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                <div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div>
            </div>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
        </XFStack>
    </ChildContent></XFCard>;
    private RenderFragment TileGrid(IReadOnlyList<DocTile> items, int columns) => @<XFGrid Cols="1" Md="@Math.Min(columns, 2)" Lg="@columns" Gap="4">@foreach (var item in items) { @Tile(item) }</XFGrid>;
    private RenderFragment WarningGrid(IReadOnlyList<DocTile> items) => @<XFGrid Cols="1" Md="2" Gap="4">@foreach (var item in items) {
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <div class="flex items-center gap-4">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-danger/10 bg-danger/10 text-danger" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                <div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div>
            </div>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
        </XFStack></ChildContent></XFCard>
    }</XFGrid>;
    private RenderFragment NameValueTable(IReadOnlyList<NameValueRow> rows, string nameHeader, string valueHeader) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader><XFTableRow><XFTableCell Header="true">@nameHeader</XFTableCell><XFTableCell Header="true">@valueHeader</XFTableCell></XFTableRow></XFTableHeader>
        <XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Value</XFTableCell></XFTableRow> }</XFTableBody>
    </XFTable>;
    private RenderFragment ApiTable(IReadOnlyList<ApiRow> rows) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Parâmetro", "Parameter")</XFTableCell><XFTableCell Header="true">Type</XFTableCell><XFTableCell Header="true">Default</XFTableCell><XFTableCell Header="true">@T("Descrição", "Description")</XFTableCell></XFTableRow></XFTableHeader>
        <XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Type</XFTableCell><XFTableCell><XFCode Text="@row.DefaultValue" /></XFTableCell><XFTableCell>@row.Description</XFTableCell></XFTableRow> }</XFTableBody>
    </XFTable>;

    // ═══════════════════════════════════════════
    //  HERO
    // ═══════════════════════════════════════════
    private string? HeroSelectedId = "financeiro";

    private IReadOnlyList<XFMenuItem> HeroItems => [
        new() { Id = "fiscal", Text = T("Fiscal", "Fiscal"), Icon = SvgIcon("file-invoice"), Badge = "12", BadgeTone = XFSemanticColor.Warning },
        new() { Id = "estoque", Text = T("Estoque", "Inventory"), Icon = SvgIcon("boxes-stacked") },
        new() { Id = "financeiro", Text = T("Financeiro", "Financial"), Icon = SvgIcon("money-bill-trend-up"), Badge = "3", BadgeTone = XFSemanticColor.Danger },
        new() { Id = "Contabil", Text = T("Contabil", "Accounting"), Icon = SvgIcon("calculator") }
    ];

    private RenderFragment HeroPreview() => @<div class="flex flex-col gap-4">
        <div class="overflow-hidden rounded-lg border border-border-light bg-bg-surface">
            <div class="flex items-center justify-between border-b border-border-light bg-surface-50/80 px-5 py-3">
                <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@T("Menu ERP - Módulos", "ERP Menu - Modules")</XFTypography>
                <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Ativo", "Active")" />
            </div>
            <div class="p-3">
                <XFMenu Items="@HeroItems" Size="XFSize.Md" Variant="XFMenuVariant.Surface"
                        Orientation="XFOrientation.Vertical" DisplayMode="XFMenuDisplayMode.IconAndText"
                        ActiveTone="XFSemanticColor.Primary" SelectedId="@HeroSelectedId"
                        SelectedIdChanged="id => HeroSelectedId = id" />
            </div>
        </div>
    </div>;

    // ═══════════════════════════════════════════
    //  STATIC DATA
    // ═══════════════════════════════════════════
    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("7 variantes", "7 variants"), T("Surface, Plain, Soft, TopNav, Dropdown, Sidebar, DarkSidebar.", "Surface, Plain, Soft, TopNav, Dropdown, Sidebar, DarkSidebar."), "layer-group"),
        new(T("3 tamanhos touch", "3 touch sizes"), T("Sm=44px, Md=48px, Lg=56px — WCAG AAA.", "Sm=44px, Md=48px, Lg=56px — WCAG AAA."), "maximize"),
        new(T("6 tons ativos", "6 active tones"), T("Primary, Secondary, Success, Warning, Danger, Neutral.", "Primary, Secondary, Success, Warning, Danger, Neutral."), "palette")
    ];
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFMenu"),
        new("Namespace", "XForge.DesignSystem.Components.Navigation.Menu"),
        new("Package", "XForge.DesignSystem"),
        new("Category", "Components / Navigation / Menu"),
        new("Status", T("Estável", "Stable")),
        new("Accessibility", T("nav role=tree/menubar, aria-expanded, aria-selected, aria-level, touch target 44px AAA.", "nav role=tree/menubar, aria-expanded, aria-selected, aria-level, 44px AAA touch target.")),
        new("Theme support", T("Light, dark e data-brand via tokens.", "Light, dark and data-brand via tokens."))
    ];
    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("Data-Driven", "Data-Driven"), T("Aceita IReadOnlyList de XFMenuItem — sem child content.", "Accepts IReadOnlyList of XFMenuItem — no child content."), "database"),
        new(T("Hierarquia", "Hierarchy"), T("Filhos aninhados via Children, expansão múltipla ou única.", "Nested children via Children, multiple or single expansion."), "sitemap"),
        new(T("Templates", "Templates"), T("ItemTemplate global e Template por item.", "Global ItemTemplate and per-item Template."), "code")
    ];
    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Navegação ERP", "ERP Navigation"), T("Módulos, submódulos e telas do sistema.", "System modules, submodules and screens."), "compass"),
        new(T("Sidebar colapsável", "Collapsible Sidebar"), T("Maximizar área de conteúdo em desktop.", "Maximize content area on desktop."), "columns-3"),
        new(T("Dropdown contextual", "Contextual Dropdown"), T("Menus de ação e navegação contextual.", "Action menus and contextual navigation."), "chevron-down")
    ];
    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Menus hardcoded com HTML, sem navegação por teclado.", "Hardcoded menus with HTML, no keyboard navigation."), "xmark"),
        new(T("Depois", "After"), T("Data-driven com WAI-ARIA, templates e 7 variantes.", "Data-driven with WAI-ARIA, templates and 7 variants."), "check"),
        new(T("Risco reduzido", "Reduced risk"), T("Consistência visual entre todas as navegações do ERP.", "Visual consistency across all ERP navigations."), "shield-check")
    ];
    private IReadOnlyList<DocTile> UseItems => [
        new(T("Sidebar do ERP", "ERP Sidebar"), T("Navegação principal entre módulos e telas.", "Main navigation between modules and screens."), "sidebar"),
        new(T("Top navigation", "Top navigation"), T("Barra de navegação horizontal no topo.", "Horizontal navigation bar at the top."), "grip-horizontal"),
        new(T("Menu dropdown", "Dropdown menu"), T("Menus de ação em tabelas e cards.", "Action menus in tables and cards."), "caret-down")
    ];
    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Breadcrumb", "Breadcrumb"), T("Use XFBreadcrumb para hierarquia de rota simples.", "Use XFBreadcrumb for simple route hierarchy."), "xmark"),
        new(T("Tabs", "Tabs"), T("Use XFTabs para alternância de visões em mesma tela.", "Use XFTabs for switching views on the same screen."), "triangle-exclamation")
    ];
    private IReadOnlyList<DocTile> AnatomyItems => [
        new("nav", T("Container semântico com role=tree ou role=menubar.", "Semantic container with role=tree or role=menubar."), "code"),
        new("XFMenuItem", T("Item data-driven com Id, Text, Icon, Badge, Children.", "Data-driven item with Id, Text, Icon, Badge, Children."), "square"),
        new(T("Section", "Section"), T("Cabeçalho de agrupamento com Kind=Section.", "Group header with Kind=Section."), "heading"),
        new(T("Separator", "Separator"), T("Linha divisória com Kind=Separator.", "Dividing line with Kind=Separator."), "minus"),
        new(T("Filhos", "Children"), T("Itens aninhados com hierarquia via Children.", "Nested items with hierarchy via Children."), "sitemap"),
        new(T("Badge", "Badge"), T("Indicador numérico ou texto com BadgeTone.", "Numeric or text indicator with BadgeTone."), "tag")
    ];

    // ═══════════════════════════════════════════
    //  1. BASICO
    // ═══════════════════════════════════════════
    private string? SelectedBasicoId = "financeiro";

    private IReadOnlyList<XFMenuItem> BasicoItems => [
