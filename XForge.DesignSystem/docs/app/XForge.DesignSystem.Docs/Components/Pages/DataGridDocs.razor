@page "/display/data-grid"
@page "/display/datagrid"
@using XForge.DesignSystem.Core.Primitives
@using XForge.DesignSystem.Components.DataDisplay.DataGrid
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="Core OSS"
                 Title="Data Grid"
                 Status="@T("Documentacao completa", "Complete docs")"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                    <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFDataGrid" />
                    <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Ordenacao", "Sorting")" />
                    <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Paginacao", "Paging")" />
                    <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Enterprise", "Enterprise")" />
                </XFStack>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">@T("Grade de dados enterprise para Blazor com colunas declarativas, ordenacao, paginacao, selecao, agrupamento, virtualizacao e edicao inline.","Enterprise data grid for Blazor with declarative columns, sorting, paging, selection, grouping, virtualization and inline editing.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">@T("XFDataGrid e XFDataGridColuna exibem colecoes de dados com ordenacao interativa, paginacao, selecao single/multiple, agrupamento por propriedade, templates de detalhes e edicao inline. Ideal para telas de listagem, dashboards, relatorios e CRUDs enterprise.","XFDataGrid and XFDataGridColumn display data collections with interactive sorting, paging, single/multiple selection, grouping by property, detail templates and inline editing. Ideal for listing screens, dashboards, reports and enterprise CRUDs.")</XFTypography>
                </XFStack>
                <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                    <div class="rounded-lg border border-border-light bg-surface-50 p-5">@HeroPreview()</div>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">@foreach (var item in QuickFacts){@Tile(item)}</XFStack>
                </div>
            </XFStack></ChildContent>
        </XFCard>

        @Section(T("Metadados","Metadata"),@<div>@NameValueTable(MetadataRows,T("Campo","Field"),T("Valor","Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico. Interacoes requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderizacao.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Consideracoes", "Considerations")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor Server: eventos sao tratados via SignalR. Sem latencia adicional para componentes puramente renderizados.", "Blazor Server: events are handled via SignalR. No additional latency for purely rendered components.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor WebAssembly: eventos sao tratados diretamente no cliente. Mais responsivo.", "Blazor WebAssembly: events are handled directly on the client. More responsive.")</XFTypography>
                </XFStack>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral","Overview"),@<div>@TileGrid(OverviewItems,3)</div>)
            @Section(T("Proposito","Purpose"),@<div>@TileGrid(PurposeItems,3)</div>)
            @Section(T("Problema resolvido","Problem Solved"),@<div>@TileGrid(ProblemItems,3)</div>)
            @Section(T("Quando usar","When To Use"),@<div>@TileGrid(UseItems,2)</div>)
            @Section(T("Quando nao usar","When Not To Use"),@<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia","Anatomy"),@<div>@TileGrid(AnatomyItems,2)</div>)
            @Section(T("Principios de design","Design Principles"),@<div>@TileGrid(DesignPrincipleItems,3)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Basico","1. Basic"),T("Grade simples com 3 colunas e 5 linhas.","Simple grid with 3 columns and 5 rows."),Example1(),Code1)
            @Example(T("2. Ordenacao","2. Sorting"),T("Ordenacao interativa por colunas com AllowSorting.","Interactive column sorting with AllowSorting."),Example2(),Code2)
            @Example(T("3. Paginacao","3. Pagination"),T("Paginacao com AllowPaging, PageSize e ShowPageSize.","Pagination with AllowPaging, PageSize and ShowPageSize."),Example3(),Code3)
            @Example(T("4. Selecao","4. Selection"),T("Selecao single e multiple de linhas.","Single and multiple row selection."),Example4(),Code4)
            @Example(T("5. Striped e Hoverable","5. Striped & Hoverable"),T("Variantes visuais: linhas alternadas e hover.","Visual variants: alternating rows and hover."),Example5(),Code5)
            @Example(T("6. Seletor de colunas","6. Column Chooser"),T("ShowColumnChooser permite ocultar/mostrar colunas hideable.","ShowColumnChooser allows hiding/showing hideable columns."),Example6(),Code6)
            @Example(T("7. Edicao inline","7. Inline Editing"),T("AllowEditing com EditTemplate para edicao direta na grade.","AllowEditing with EditTemplate for direct editing in the grid."),Example7(),Code7)
            @Example(T("8. Agrupamento","8. Grouping"),T("GroupBy com GroupHeaderTemplate e GroupFooterTemplate.","GroupBy with GroupHeaderTemplate and GroupFooterTemplate."),Example8(),Code8)
            @Example(T("9. Template de detalhes","9. Detail Template"),T("Expandir linhas para mostrar detalhes com DetailTemplate.","Expand rows to show details with DetailTemplate."),Example9(),Code9)
            @Example(T("10. Templates customizados","10. Custom Templates"),T("HeaderTemplate, Template e FooterTemplate para controle total.","HeaderTemplate, Template and FooterTemplate for full control."),Example10(),Code10)
            @Example(T("11. Colunas fixas","11. Sticky Columns"),T("Colunas fixas com Sticky, StickySide e StickyOffset.","Sticky columns with Sticky, StickySide and StickyOffset."),Example11(),Code11)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API — XFDataGrid / XFDataGridColumn",@<div>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold" Class="mb-3">XFDataGrid</XFTypography>
                @ApiTable(ApiRows)
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold" Class="mt-6 mb-3">XFDataGridColumn</XFTypography>
                @ApiTable(ColumnApiRows)
            </div>)
            @Section(T("Eventos","Events"),@<div>@NameValueTable(EventRows,T("Evento","Event"),T("Comportamento","Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade","Accessibility"),@<div>@TileGrid(AccessibilityItems,2)</div>)
            @Section(T("Suporte de teclado","Keyboard Support"),@<div>@NameValueTable(KeyboardRows,T("Tecla","Key"),T("Comportamento","Behavior"))</div>)
            @Section(T("Responsividade","Responsiveness"),@<div>@TileGrid(ResponsivenessItems,2)</div>)
            @Section(T("Performance","Performance"),@<div>@TileGrid(PerformanceItems,2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise","Enterprise Scenarios"),@<div>@TileGrid(ScenarioItems,3)</div>)
            @Section(T("Padroes de composicao","Composition Patterns"),@<div>@TileGrid(CompositionItems,3)</div>)
            @Section(T("Boas praticas de UX","UX Best Practices"),@<div>@TileGrid(BestPracticeItems,2)</div>)
            @Section(T("Anti-padroes","Anti-patterns"),@<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("Design Tokens",@<div>@NameValueTable(TokenRows,"Token",T("Proposito","Purpose"))</div>)
            @Section(T("Temas","Theming"),@<div>@TileGrid(ThemeItems,2)</div>)
            @Section(T("Testes","Testing"),@<div>@NameValueTable(TestingRows,T("Cobertura","Coverage"),T("Evidencia","Evidence"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Limitacoes conhecidas","Known Limitations"),@<div>@NameValueTable(LimitationRows,T("Limitacao","Limitation"),T("Status","Status"))</div>)
            @Section(T("Componentes relacionados","Related Components"),@<div>@TileGrid(RelatedComponentItems,3)</div>)
            @Section("FAQ",@<div>@NameValueTable(FaqRows,T("Pergunta","Question"),T("Resposta","Answer"))</div>)
            @Section("Changelog",@<div>@NameValueTable(ChangelogRows,T("Versao","Version"),T("Mudanca","Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>

@code {
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);
    private string CopyableCodeTitle => T("Codigo copiavel","Copyable code");

    private sealed record EmployeeRow(int Id, string Name, string Department, string Role, decimal Salary, bool Active);
    private sealed record ProductRow(int Id, string Name, string Category, decimal Price, int Stock, string Status);

    private static readonly EmployeeRow[] Employees = [
        new(1, "Ana Silva", "Financeiro", "Analista", 8500m, true),
        new(2, "Bruno Costa", "TI", "Desenvolvedor", 12000m, true),
        new(3, "Carla Mendes", "RH", "Gerente", 15000m, true),
        new(4, "Daniel Souza", "Fiscal", "Contador", 9800m, false),
        new(5, "Elena Ferreira", "Comercial", "Vendedora", 7200m, true),
        new(6, "Felipe Santos", "TI", "DevOps", 11500m, true),
        new(7, "Gabriela Lima", "Financeiro", "Controller", 14000m, true),
        new(8, "Hugo Almeida", "Estoque", "Almoxarife", 5800m, true),
        new(9, "Isabela Rocha", "RH", "Recrutadora", 7500m, false),
        new(10, "Joao Pereira", "Comercial", "Gerente", 16500m, true)
    ];

    private static readonly ProductRow[] Products = [
        new(1, "Notebook Pro 15", "Eletronicos", 7500m, 42, "Em estoque"),
        new(2, "Monitor 27 4K", "Eletronicos", 3200m, 18, "Em estoque"),
        new(3, "Teclado Mecanico", "Perifericos", 450m, 156, "Em estoque"),
        new(4, "Mouse Ergonomico", "Perifericos", 280m, 0, "Esgotado"),
        new(5, "Cadeira Ergonomica", "Moveis", 2100m, 7, "Baixo estoque"),
        new(6, "Webcam HD", "Perifericos", 380m, 89, "Em estoque"),
        new(7, "Hub USB-C", "Perifericos", 190m, 234, "Em estoque"),
        new(8, "SSD 1TB", "Armazenamento", 520m, 63, "Em estoque")
    ];

    private EmployeeRow? SelectedEmployee { get; set; }
    private IReadOnlyList<EmployeeRow>? SelectedEmployees { get; set; }
    private EmployeeRow? EditingEmployee { get; set; }

    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFDataGrid TItem="EmployeeRow" Items="Employees.Take(5)" Striped="true" Hoverable="true" Caption="@T("Funcionarios ativos","Active employees")">
            <Columns>
                <XFDataGridColumn TItem="EmployeeRow" Title="ID" Property="Id" Width="XFDataGridColumnWidth.Xs" Align="XFDataGridAlign.Center" />
                <XFDataGridColumn TItem="EmployeeRow" Title="@T("Nome","Name")" Property="Name" />
                <XFDataGridColumn TItem="EmployeeRow" Title="@T("Departamento","Department")" Property="Department" />
                <XFDataGridColumn TItem="EmployeeRow" Title="@T("Cargo","Role")" Property="Role" />
                <XFDataGridColumn TItem="EmployeeRow" Title="@T("Salario","Salary")" Property="Salary" FormatString="C" Align="XFDataGridAlign.End" />
            </Columns>
        </XFDataGrid>
    </XFStack>;

    private RenderFragment Example1() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFDataGrid TItem="EmployeeRow" Items="Employees.Take(5)" Hoverable="true">
            <Columns>
                <XFDataGridColumn TItem="EmployeeRow" Title="ID" Property="Id" Width="XFDataGridColumnWidth.Xs" Align="XFDataGridAlign.Center" />
                <XFDataGridColumn TItem="EmployeeRow" Title="@T("Nome","Name")" Property="Name" />
                <XFDataGridColumn TItem="EmployeeRow" Title="@T("Departamento","Department")" Property="Department" />
            </Columns>
        </XFDataGrid>
    </XFStack>;

    private string Code1 => @"<XFDataGrid TItem=""EmployeeRow"" Items=""Employees"" Hoverable=""true"">
    <Columns>
        <XFDataGridColumn TItem=""EmployeeRow"" Title=""ID"" Property=""Id""
            Width=""XFDataGridColumnWidth.Xs"" Align=""XFDataGridAlign.Center"" />
        <XFDataGridColumn TItem=""EmployeeRow"" Title=""Name"" Property=""Name"" />
        <XFDataGridColumn TItem=""EmployeeRow"" Title=""Department"" Property=""Department"" />
    </Columns>
</XFDataGrid>";

    private RenderFragment Example2() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Clique nos cabecalhos para ordenar. AllowSorting=true por padrao.","Click headers to sort. AllowSorting=true by default.")</XFTypography>
        <XFDataGrid TItem="EmployeeRow" Items="Employees" Striped="true" AllowSorting="true" AllowPaging="true" PageSize="5">
            <Columns>
                <XFDataGridColumn TItem="EmployeeRow" Title="ID" Property="Id" SortKey="Id" Width="XFDataGridColumnWidth.Xs" Align="XFDataGridAlign.Center" />
                <XFDataGridColumn TItem="EmployeeRow" Title="@T("Nome","Name")" Property="Name" SortKey="Name" />
                <XFDataGridColumn TItem="EmployeeRow" Title="@T("Departamento","Department")" Property="Department" SortKey="Department" />
                <XFDataGridColumn TItem="EmployeeRow" Title="@T("Salario","Salary")" Property="Salary" SortKey="Salary" FormatString="C" Align="XFDataGridAlign.End" />
            </Columns>
        </XFDataGrid>
    </XFStack>;

    private string Code2 => @"<XFDataGrid TItem=""EmployeeRow"" Items=""Employees""
    Striped=""true"" AllowSorting=""true"" AllowPaging=""true"" PageSize=""5"">
    <Columns>
        <XFDataGridColumn TItem=""EmployeeRow"" Title=""ID"" Property=""Id""
            SortKey=""Id"" Width=""XFDataGridColumnWidth.Xs"" Align=""XFDataGridAlign.Center"" />
        <XFDataGridColumn TItem=""EmployeeRow"" Title=""Name"" Property=""Name"" SortKey=""Name"" />
        <XFDataGridColumn TItem=""EmployeeRow"" Title=""Department"" Property=""Department"" SortKey=""Department"" />
        <XFDataGridColumn TItem=""EmployeeRow"" Title=""Salary"" Property=""Salary""
            SortKey=""Salary"" FormatString=""C"" Align=""XFDataGridAlign.End"" />
    </Columns>
</XFDataGrid>";

    private RenderFragment Example3() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFDataGrid TItem="ProductRow" Items="Products" Striped="true" Hoverable="true" AllowPaging="true" PageSize="3" ShowPageSize="true" PageSizeOptions="new int[] { 3, 5, 8 }">
            <Columns>
                <XFDataGridColumn TItem="ProductRow" Title="ID" Property="Id" Width="XFDataGridColumnWidth.Xs" Align="XFDataGridAlign.Center" />
                <XFDataGridColumn TItem="ProductRow" Title="@T("Produto","Product")" Property="Name" />
                <XFDataGridColumn TItem="ProductRow" Title="@T("Categoria","Category")" Property="Category" />
                <XFDataGridColumn TItem="ProductRow" Title="@T("Preco","Price")" Property="Price" FormatString="C" Align="XFDataGridAlign.End" />
                <XFDataGridColumn TItem="ProductRow" Title="@T("Estoque","Stock")" Property="Stock" Align="XFDataGridAlign.Center" />
            </Columns>
        </XFDataGrid>
    </XFStack>;

    private string Code3 => @"<XFDataGrid TItem=""ProductRow"" Items=""Products"" Striped=""true"" Hoverable=""true""
    AllowPaging=""true"" PageSize=""3"" ShowPageSize=""true""
    PageSizeOptions=""new int[] { 3, 5, 8 }"">
    <Columns>
        <XFDataGridColumn TItem=""ProductRow"" Title=""ID"" Property=""Id"" Width=""XFDataGridColumnWidth.Xs"" />
        <XFDataGridColumn TItem=""ProductRow"" Title=""Product"" Property=""Name"" />
        <XFDataGridColumn TItem=""ProductRow"" Title=""Category"" Property=""Category"" />
        <XFDataGridColumn TItem=""ProductRow"" Title=""Price"" Property=""Price"" FormatString=""C"" />
        <XFDataGridColumn TItem=""ProductRow"" Title=""Stock"" Property=""Stock"" Align=""XFDataGridAlign.Center"" />
    </Columns>
</XFDataGrid>";

    private RenderFragment Example4() => @<XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
        <div>
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Primary" Text="Single" />
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary" Class="mt-1">@T("Clique em uma linha para selecionar.","Click a row to select.")</XFTypography>
            <div class="mt-3">
                <XFDataGrid TItem="EmployeeRow" Items="Employees.Take(5)" Hoverable="true" SelectionMode="XFDataGridSelectionMode.Single" @bind-SelectedItem="SelectedEmployee">
                    <Columns>
                        <XFDataGridColumn TItem="EmployeeRow" Title="ID" Property="Id" Width="XFDataGridColumnWidth.Xs" Align="XFDataGridAlign.Center" />
                        <XFDataGridColumn TItem="EmployeeRow" Title="@T("Nome","Name")" Property="Name" />
                        <XFDataGridColumn TItem="EmployeeRow" Title="@T("Cargo","Role")" Property="Role" />
                    </Columns>
                </XFDataGrid>
            </div>
            @if (SelectedEmployee is not null)
            {
                <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Primary" Class="mt-2">@T("Selecionado:","Selected:") @SelectedEmployee.Name</XFTypography>
            }
        </div>
        <div>
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="Multiple" />
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary" Class="mt-1">@T("Clique em varias linhas para selecionar multiplas.","Click multiple rows to select several.")</XFTypography>
            <div class="mt-3">
                <XFDataGrid TItem="EmployeeRow" Items="Employees.Take(5)" Hoverable="true" SelectionMode="XFDataGridSelectionMode.Multiple" @bind-SelectedItems="SelectedEmployees">
                    <Columns>
                        <XFDataGridColumn TItem="EmployeeRow" Title="ID" Property="Id" Width="XFDataGridColumnWidth.Xs" Align="XFDataGridAlign.Center" />
                        <XFDataGridColumn TItem="EmployeeRow" Title="@T("Nome","Name")" Property="Name" />
                        <XFDataGridColumn TItem="EmployeeRow" Title="@T("Departamento","Department")" Property="Department" />
                    </Columns>
                </XFDataGrid>
            </div>
            @if (SelectedEmployees is not null && SelectedEmployees.Count > 0)
            {
                <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Primary" Class="mt-2">@T("Selecionados:","Selected:") @string.Join(", ", SelectedEmployees.Select(e => e.Name))</XFTypography>
            }
        </div>
    </XFStack>;

    private string Code4 => @"<XFDataGrid TItem=""EmployeeRow"" Items=""Employees""
    SelectionMode=""XFDataGridSelectionMode.Single""
    @bind-SelectedItem=""SelectedEmployee"">
    <Columns>
        <XFDataGridColumn TItem=""EmployeeRow"" Title=""ID"" Property=""Id""
            Width=""XFDataGridColumnWidth.Xs"" Align=""XFDataGridAlign.Center"" />
        <XFDataGridColumn TItem=""EmployeeRow"" Title=""Name"" Property=""Name"" />
        <XFDataGridColumn TItem=""EmployeeRow"" Title=""Role"" Property=""Role"" />
    </Columns>
</XFDataGrid>

<XFDataGrid TItem=""EmployeeRow"" Items=""Employees""
    SelectionMode=""XFDataGridSelectionMode.Multiple""
    @bind-SelectedItems=""SelectedEmployees"">
    <Columns>
        <XFDataGridColumn TItem=""EmployeeRow"" Title=""ID"" Property=""Id""
            Width=""XFDataGridColumnWidth.Xs"" Align=""XFDataGridAlign.Center"" />
        <XFDataGridColumn TItem=""EmployeeRow"" Title=""Name"" Property=""Name"" />
        <XFDataGridColumn TItem=""EmployeeRow"" Title=""Department"" Property=""Department"" />
    </Columns>
</XFDataGrid>";

    private RenderFragment Example5() => @<XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
        <div>
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="Striped + Hoverable" />
            <div class="mt-3">
                <XFDataGrid TItem="EmployeeRow" Items="Employees.Take(5)" Striped="true" Hoverable="true">
                    <Columns>
                        <XFDataGridColumn TItem="EmployeeRow" Title="ID" Property="Id" Width="XFDataGridColumnWidth.Xs" Align="XFDataGridAlign.Center" />
                        <XFDataGridColumn TItem="EmployeeRow" Title="@T("Nome","Name")" Property="Name" />
                        <XFDataGridColumn TItem="EmployeeRow" Title="@T("Departamento","Department")" Property="Department" />
                        <XFDataGridColumn TItem="EmployeeRow" Title="@T("Ativo","Active")" Property="Active" Align="XFDataGridAlign.Center" />
                    </Columns>
                </XFDataGrid>
            </div>
        </div>
        <div>
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="Variant=Soft" />
            <div class="mt-3">
                <XFDataGrid TItem="EmployeeRow" Items="Employees.Take(3)" Variant="XFListVariant.Soft" Hoverable="true">
                    <Columns>
                        <XFDataGridColumn TItem="EmployeeRow" Title="ID" Property="Id" Width="XFDataGridColumnWidth.Xs" />
                        <XFDataGridColumn TItem="EmployeeRow" Title="@T("Nome","Name")" Property="Name" />
                        <XFDataGridColumn TItem="EmployeeRow" Title="@T("Cargo","Role")" Property="Role" />
                    </Columns>
                </XFDataGrid>
            </div>
        </div>
        <div>
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Danger" Text="Variant=Plain" />
