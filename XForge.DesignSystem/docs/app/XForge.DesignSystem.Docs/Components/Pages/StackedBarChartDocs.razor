@page "/components/stacked-bar-chart"
@using XForge.DesignSystem.Components.Charts
@using XForge.DesignSystem.Components.Layout
@using XForge.DesignSystem.Components.Typography
@using XForge.DesignSystem.Components.DataDisplay.Card
@using XForge.DesignSystem.Components.DataDisplay.Badge
@using XForge.DesignSystem.Components.Shared
@using XForge.DesignSystem.Docs.Shared.Contracts
@using XForge.DesignSystem.Docs.Shared.Navigation
@using XForge.DesignSystem.Docs.Shared.Components
@using XForge.DesignSystem.Core.Primitives

@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">

        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFStackedBarChart" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Multi-series", "Multi-series")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Empilhado", "Stacked")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Barras empilhadas com modo normal e 100% para comparacao de series.",
                               "Stacked bars with normal and 100% mode for series comparison.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("XFStackedBarChart exibe barras empilhadas onde cada segmento representa uma serie de dados. Suporta modo normal (valores absolutos) e modo 100% (proporcional), com legenda, grid e formatacao customizada.",
                               "XFStackedBarChart displays stacked bars where each segment represents a data series. Supports normal mode (absolute values) and 100% mode (proportional), with legend, grid and custom formatting.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        <!-- ===== METADATA ===== -->
        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        <!-- ===== OVERVIEW / PURPOSE / WHEN TO USE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
        </XFStack>

        <!-- ===== DESIGN ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Basico", "1. Basic"),
                T("Barras empilhadas com modo normal (valores absolutos).", "Stacked bars with normal mode (absolute values)."),
                ExBasic(), CodeBasic)

            @Example(T("2. Modo 100%", "2. 100% mode"),
                T("Barras empilhadas em modo 100% para comparacao proporcional.", "Stacked bars in 100% mode for proportional comparison."),
                ExFullStacked(), CodeFullStacked)

            @Example(T("3. Com grid e legenda", "3. With grid and legend"),
                T("Barras empilhadas com grid de referencia e legenda visivel.", "Stacked bars with reference grid and visible legend."),
                ExGridLegend(), CodeGridLegend)
        </XFStack>

        <!-- ===== API ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API: XFStackedBarChart", @<div>@ApiTable(ApiRows)</div>)
            @Section("API: XFStackedBarChartSeries", @<div>@ApiTable(SeriesApiRows)</div>)
        </XFStack>

        <!-- ===== STACK MODES ===== -->
        @Section(T("Modos de empilhamento", "Stack Modes"), @<div>@NameValueTable(StackModeRows, T("Modo", "Mode"), T("Descricao", "Description"))</div>)

        <!-- ===== ACCESSIBILITY ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 3)</div>)
        </XFStack>

        <!-- ===== FAQ / CHANGELOG ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>

    </XFStack>
</XForgeDocsShell>

@code {
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");
    private string ProductLabelText => "XFStackedBarChart";
    private string PageTitleText => "Stacked Bar Chart";
    private string PageStatusText => T("Stable", "Stable");

    // ==================== HERO ====================
    private RenderFragment HeroPreview() => @<div class="flex items-center justify-center rounded-lg border border-border-light bg-surface-50 p-8">
        <XFStack Orientation="XFOrientation.Vertical" Gap="4" Alignment="XFAlignment.Center">
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@T("Preview de Stacked Bar Chart", "Stacked Bar Chart preview")</XFTypography>
        </XFStack>
    </div>;

    // ==================== QUICK FACTS ====================
    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("Multi-series", "Multi-series"), T("Multiplos conjuntos de dados empilhados em cada barra.", "Multiple data sets stacked in each bar."), "layer-group"),
        new(T("2 modos", "2 modes"), T("Normal (valores absolutos) e 100% (proporcional).", "Normal (absolute values) and 100% (proportional)."), "chart-bar"),
        new(T("Legenda", "Legend"), T("Legenda interativa para ocultar/mostrar series.", "Interactive legend to hide/show series."), "layer-group"),
        new(T("Grid", "Grid"), T("Linha de referencia configuravel no eixo Y.", "Configurable reference line on Y axis."), "table-cells")
    ];

    // ==================== METADATA ====================
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFStackedBarChart"),
        new("Namespace", "XForge.Components.Charts"),
        new("Package", "XForge.DesignSystem"),
        new("Category", "Components / Charts"),
        new("Status", T("Estavel", "Stable")),
        new("Accessibility", T("role=img, aria-label, sr-only data table.", "role=img, aria-label, sr-only data table.")),
        new("Theme support", T("Light e dark via CSS variables.", "Light and dark via CSS variables."))
    ];

    // ==================== OVERVIEW ====================
    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("Barras empilhadas", "Stacked bars"), T("Barras onde segmentos representam series de dados.", "Bars where segments represent data series."), "chart-bar"),
        new(T("Modo 100%", "100% mode"), T("Normaliza valores para comparacao proporcional.", "Normalizes values for proportional comparison."), "percent"),
        new(T("Interativo", "Interactive"), T("Tooltips, legenda interativa e eventos de selecao.", "Tooltips, interactive legend and selection events."), "hand-pointer")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Composicao", "Composition"), T("Mostrar como partes contribuem para o total.", "Show how parts contribute to the total."), "layer-group"),
        new(T("Comparacao", "Comparison"), T("Comparar distribuicao de series entre categorias.", "Compare distribution of series across categories."), "scale-balanced"),
        new(T("Tendencias", "Trends"), T("Visualizar mudancas na composicao ao longo do tempo.", "Visualize changes in composition over time."), "chart-line")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Barras agrupadas dificultavam visualizar totais.", "Grouped bars made it hard to see totals."), "xmark"),
        new(T("Depois", "After"), T("Empilhamento mostra totais e composicao simultaneamente.", "Stacking shows totals and composition simultaneously."), "check"),
        new(T("Proporcional", "Proporcional"), T("Modo 100% permite comparacao relativa entre categorias.", "100% mode allows relative comparison across categories."), "percent")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Composicao de receita", "Revenue composition"), T("Fatias de receita por produto/regiao empilhadas.", "Revenue slices by product/region stacked."), "dollar-sign"),
        new(T("Composicao de custos", "Cost composition"), T("Custos fixos vs variaveis ao longo do tempo.", "Fixed vs variable costs over time."), "receipt")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Muitas series", "Too many series"), T("Mais de 6 series torna o grafico dificil de ler.", "More than 6 series makes the chart hard to read."), "xmark"),
        new(T("Valores negativos", "Negative values"), T("Barras empilhadas nao suportam valores negativos.", "Stacked bars do not support negative values."), "triangle-exclamation")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new("Eixo X", T("Categorias ou labels no eixo horizontal.", "Categories or labels on the horizontal axis."), "code"),
        new("Eixo Y", T("Valores numericos no eixo vertical.", "Numerical values on the vertical axis."), "code"),
        new("Barras empilhadas", T("Segmentos coloridos empilhados por categoria.", "Colored segments stacked by category."), "layer-group"),
        new("Legenda", T("Indicadores de cor por serie.", "Color indicators per series."), "tag"),
        new("Tooltip", T("Popup com detalhes ao passar o mouse.", "Popup with details on hover."), "comment")
    ];

    // ==================== DESIGN ====================
    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(T("Composicao visual", "Visual composition"), T("Cada segmento contribui visualmente para o total.", "Each segment visually contributes to the total."), "layer-group"),
        new(T("Cores semanticas", "Semantic colors"), T("Tons distintos para cada serie com contraste adequado.", "Distinct tones for each series with adequate contrast."), "palette"),
        new(T("Clareza", "Clarity"), T("Tooltips e grid para leitura precisa de valores.", "Tooltips and grid for precise value reading."), "eye")
    ];

    // ==================== EXAMPLES ====================
    private RenderFragment ExBasic() => @<div class="flex flex-col gap-4">
        <XFStack Orientation="XFOrientation.Vertical" Gap="2">
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Modo normal com valores absolutos", "Normal mode with absolute values")</XFTypography>
        </XFStack>
    </div>;

    private string CodeBasic => @"<XFStackedBarChart Labels=""@labels"" Series=""@series"" />

@code {
    private string[] labels = [""Jan"", ""Fev"", ""Mar"", ""Abr""];
    private XFStackedBarChartSeries[] series = [
        new() { Name = ""Produto A"", Data = [30, 40, 35, 50] },
        new() { Name = ""Produto B"", Data = [20, 25, 30, 35] },
        new() { Name = ""Produto C"", Data = [15, 20, 18, 25] }
    ];
}";

    private RenderFragment ExFullStacked() => @<div class="flex flex-col gap-4">
        <XFStack Orientation="XFOrientation.Vertical" Gap="2">
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Modo 100% para comparacao proporcional", "100% mode for proportional comparison")</XFTypography>
        </XFStack>
    </div>;

    private string CodeFullStacked => @"<XFStackedBarChart Labels=""@labels""
                   Series=""@series""
                   StackMode=""XFStackedBarChartStackMode.FullStacked"" />";

    private RenderFragment ExGridLegend() => @<div class="flex flex-col gap-4">
        <XFStack Orientation="XFOrientation.Vertical" Gap="2">
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Com grid e legenda visiveis", "With visible grid and legend")</XFTypography>
        </XFStack>
    </div>;

    private string CodeGridLegend => @"<XFStackedBarChart Labels=""@labels""
                   Series=""@series""
                   ShowGrid=""true""
                   ShowLegend=""true""
                   YMax=""200"" />";

    // ==================== API ====================
    private IReadOnlyList<ApiRow> ApiRows => [
        new("Labels", "IReadOnlyList<string>", "[]", T("Labels do eixo X.", "X axis labels.")),
        new("Series", "IReadOnlyList<XFStackedBarChartSeries>", "[]", T("Series de dados para empilhar.", "Data series to stack.")),
        new("StackMode", "XFStackedBarChartStackMode", "None", T("Modo de empilhamento: None, Stacked ou FullStacked.", "Stack mode: None, Stacked or FullStacked.")),
        new("ShowGrid", "bool", "true", T("Exibir linhas de referencia no eixo Y.", "Show reference lines on Y axis.")),
        new("ShowLegend", "bool", "true", T("Exibir legenda interativa.", "Show interactive legend.")),
        new("YMax", "double?", "null", T("Valor maximo do eixo Y. Auto-calculado se null.", "Maximum Y axis value. Auto-calculated if null.")),
        new("AriaLabel", "string?", "null", T("Label acessivel para screen readers.", "Accessible label for screen readers."))
    ];

    private IReadOnlyList<ApiRow> SeriesApiRows => [
        new("Name", "string", "-", T("Nome da serie na legenda.", "Series name in legend.")),
        new("Data", "IReadOnlyList<double>", "[]", T("Valores da serie.", "Series values.")),
        new("Color", "string?", "null", T("Cor customizada (hex). Auto-selecionada se null.", "Custom color (hex). Auto-selected if null."))
    ];

    // ==================== STACK MODES ====================
    private IReadOnlyList<NameValueRow> StackModeRows => [
        new("None", T("Barras agrupadas lado a lado, sem empilhamento.", "Bars grouped side by side, no stacking.")),
        new("Stacked", T("Barras empilhadas com valores absolutos. Altura total = soma dos valores.", "Stacked bars with absolute values. Total height = sum of values.")),
        new("FullStacked", T("Barras empilhadas normalizadas para 100%. Cada barra tem mesma altura.", "Stacked bars normalized to 100%. Each bar has same height."))
    ];

    // ==================== ACCESSIBILITY ====================
    private IReadOnlyList<DocTile> AccessibilityItems => [
        new("role=img", T("Container com role=img para screen readers.", "Container with role=img for screen readers."), "universal-access"),
        new("aria-label", T("Descricao do grafico para leitores de tela.", "Chart description for screen readers."), "tag"),
        new("sr-only table", T("Tabela acessivel com dados por serie e categoria.", "Accessible table with data per series and category."), "table"),
        new("Tooltips", T("Tooltips com detalhes de cada segmento.", "Tooltips with details of each segment."), "comment"),
        new("Legend interativa", T("Legenda clicavel para ocultar/mostrar series.", "Clickable legend to hide/show series."), "layer-group")
    ];

    // ==================== FAQ ====================
    private IReadOnlyList<NameValueRow> FaqRows => [
        new(T("Quantas series suporta?", "How many series supported?"), T("Recomendado no maximo 6 series para legibilidade.", "Recommended maximum 6 series for readability.")),
        new(T("Como mudar cores das series?", "How to change series colors?"), T("Defina a propriedade Color em cada XFStackedBarChartSeries.", "Set the Color property on each XFStackedBarChartSeries.")),
        new(T("Posso combinar com outros graficos?", "Can I combine with other charts?"), T("Sim, use XFStackedBarChart junto com XFChart em dashboards.", "Yes, use XFStackedBarChart with XFChart in dashboards."))
    ];

    // ==================== CHANGELOG ====================
    private IReadOnlyList<NameValueRow> ChangelogRows => [
        new("2026-06-30", T("Documentacao inicial do XFStackedBarChart.", "Initial XFStackedBarChart documentation."))
    ];

    // ==================== HELPERS ====================
    private RenderFragment Section(string title, RenderFragment content) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg"><Header><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography></Header><ChildContent>@content</ChildContent></XFCard>;

    private RenderFragment Example(string title, string description, RenderFragment preview, string codeText) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.None" AreaRestricted="false"><Header><div class="px-6 pt-6 pb-2"><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@description</XFTypography></div></Header><ChildContent><div class="flex flex-col"><div class="border-t border-border-light bg-surface-50/30 p-6">@preview</div><div class="border-t border-border-light bg-surface-50 p-6"><XFCode Text="@codeText" Language="razor" Title="@CopyableCodeTitle" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" /></div></div></ChildContent></XFCard>;

    private RenderFragment Tile(DocTile item) => @<XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true"><div class="flex items-center gap-4"><span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-primary/10 bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span><div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div></div><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography></XFStack></ChildContent></XFCard>;

    private RenderFragment TileGrid(IReadOnlyList<DocTile> items, int cols) => @<XFGrid Cols="1" Md="@Math.Min(cols, 2)" Lg="@cols" Gap="4">@foreach (var item in items) { @Tile(item) }</XFGrid>;

    private RenderFragment WarningGrid(IReadOnlyList<DocTile> items) => @<XFGrid Cols="1" Md="2" Gap="4">@foreach (var item in items) {
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true"><div class="flex items-center gap-4"><span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-danger/10 bg-danger/10 text-danger" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span><div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div></div><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography></XFStack></ChildContent></XFCard>
    }</XFGrid>;

    private RenderFragment NameValueTable(IReadOnlyList<NameValueRow> rows, string h1, string h2) => @<XFTable Striped="true" Hoverable="true" Compact="true"><XFTableHeader><XFTableRow><XFTableCell Header="true">@h1</XFTableCell><XFTableCell Header="true">@h2</XFTableCell></XFTableRow></XFTableHeader><XFTableBody>@foreach (var r in rows) { <XFTableRow><XFTableCell><XFCode Text="@r.Name" /></XFTableCell><XFTableCell>@r.Value</XFTableCell></XFTableRow> }</XFTableBody></XFTable>;

    private RenderFragment ApiTable(IReadOnlyList<ApiRow> rows) => @<XFTable Striped="true" Hoverable="true" Compact="true"><XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Parametro", "Parameter")</XFTableCell><XFTableCell Header="true">Type</XFTableCell><XFTableCell Header="true">Default</XFTableCell><XFTableCell Header="true">@T("Descricao", "Description")</XFTableCell></XFTableRow></XFTableHeader><XFTableBody>@foreach (var r in rows) { <XFTableRow><XFTableCell><XFCode Text="@r.Name" /></XFTableCell><XFTableCell>@r.Type</XFTableCell><XFTableCell><XFCode Text="@r.DefaultValue" /></XFTableCell><XFTableCell>@r.Description</XFTableCell></XFTableRow> }</XFTableBody></XFTable>;

    private sealed record DocTile(string Title, string Description, string Icon);
    private sealed record NameValueRow(string Name, string Value);
    private sealed record ApiRow(string Name, string Type, string DefaultValue, string Description);
}
