@page "/forms/range-slider"
@using XForge.DesignSystem.Core.Primitives
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFRangeSlider" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Selecao de intervalo", "Range selection")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Slider de intervalo numerico com dois controles, prefixo, sufixo e formato personalizavel.",
                               "Numeric range slider with two handles, prefix, suffix and custom formatting.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("Componente para selecao de faixa de valores em filtros, limites e configuracoes, com suporte a acessibilidade, temas e formatos de cultura.",
                               "Component for selecting value ranges in filters, limits and settings, with support for accessibility, themes and culture formats.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico.", "Renders as static HTML.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 4)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Basico", "1. Basic"), T("Faixa de preco com prefixo e valores visiveis.", "Price range with prefix and visible values."), ExBasic(), Code1)
            @Example(T("2. Com Step", "2. With Step"), T("Intervalo horario com incremento de 1 em 1 hora.", "Time range with 1-hour increment."), ExStep(), Code2)
            @Example(T("3. Sufixo e Formato", "3. Suffix and Format"), T("Faixa de temperatura com sufixo e formato personalizado.", "Temperature range with suffix and custom format."), ExSuffixFormat(), Code3)
            @Example(T("4. Limites visiveis", "4. Bounds Display"), T("Mostra limites minimo e maximo com RangeSeparatorText.", "Shows min and max bounds with RangeSeparatorText."), ExBounds(), Code4)
            @Example(T("5. Somente leitura", "5. Read Only"), T("Slider em modo somente leitura para exibicao.", "Slider in read-only mode for display."), ExReadOnly(), Code5)
            @Example(T("6. Tamanhos", "6. Sizes"), T("Variacoes de tamanho Sm, Md e Lg.", "Size variations Sm, Md and Lg."), ExSizes(), Code6)
        </XFStack>

        <!-- ===== API + EVENTS ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string ProductLabelText => T("Core Open Source", "Core Open Source");
    private string PageTitleText => T("XFRangeSlider", "XFRangeSlider");
    private string PageStatusText => T("Documentacao completa", "Complete docs");
    private string T(string pt, string en) => LanguageService.Text(pt, en);
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFRangeSlider Label="Faixa de preco" Min="0" Max="1000" StartValue="200" EndValue="800" ShowValue="true" PrefixText="R$ " />
        <XFRangeSlider Label="Temperatura" Min="-10" Max="40" StartValue="5" EndValue="30" ShowValue="true" SuffixText="°C" />
        <XFRangeSlider Label="Horario" Min="0" Max="24" Step="1" StartValue="8" EndValue="18" ShowValue="true" SuffixText="h" />
    </XFStack>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("Dois controles deslizantes", "Two slider handles"), T("Define inicio e fim de um intervalo numerico.", "Defines start and end of a numeric range."), "arrows-left-right"),
        new(T("Prefixo e sufixo", "Prefix and suffix"), T("Texto antes e depois dos valores.", "Text before and after values."), "tag"),
        new(T("Zero JS", "Zero JS"), T("Nenhum JavaScript interop. Puro C# + Tailwind.", "No JavaScript interop. Pure C# + Tailwind."), "bolt")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFRangeSlider"),
        new("Namespace", "XForge.DesignSystem.Components.Forms.RangeSlider"),
        new("Package", "XForge.DesignSystem"),
        new("Category", "Forms / Range Slider"),
        new("Status", T("Estavel", "Stable")),
        new("Accessibility", T("role=slider, aria-valuenow, aria-valuemin, aria-valuemax, aria-label, aria-describedby.", "role=slider, aria-valuenow, aria-valuemin, aria-valuemax, aria-label, aria-describedby.")),
        new("Theme support", T("Light, dark e data-brand via tokens.", "Light, dark and data-brand via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("Selecao de intervalo", "Range selection"), T("Dois controles para definir inicio e fim.", "Two handles to define start and end."), "arrows-left-right"),
        new(T("Valores formatados", "Formatted values"), T("Prefixo, sufixo e formato personalizavel.", "Prefix, suffix and custom format."), "tag"),
        new(T("Acessivel", "Accessible"), T("Navegacao por teclado e leitores de tela.", "Keyboard navigation and screen readers."), "universal-access")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Filtros", "Filters"), T("Filtrar por faixa de preco, data ou quantidade.", "Filter by price, date or quantity range."), "filter"),
        new(T("Limites", "Limits"), T("Definir limites minimo e maximo.", "Set minimum and maximum limits."), "sliders"),
        new(T("Configuracoes", "Settings"), T("Configurar valores de sistema como horarios.", "Configure system values like schedules."), "gear")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Inputs separados para min e max.", "Separate inputs for min and max."), "xmark"),
        new(T("Depois", "After"), T("Slider visual com dois controles.", "Visual slider with two handles."), "check"),
        new(T("Acessibilidade", "Accessibility"), T("role=slider, aria-valuenow, aria-label.", "role=slider, aria-valuenow, aria-label."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Filtros de busca", "Search filters"), T("Filtrar produtos por preco ou data.", "Filter products by price or date."), "filter"),
        new(T("Configuracoes de sistema", "System settings"), T("Definir horarios, limites e faixas.", "Set schedules, limits and ranges."), "gear")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Selecao unica", "Single selection"), T("Use XFSlider para valor unico.", "Use XFSlider for single value."), "minus"),
        new(T("Lista de opcoes", "Option list"), T("Use XFSelect para listas.", "Use XFSelect for lists."), "list")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new("Track", T("Trilho horizontal com cor neutra.", "Horizontal track with neutral color."), "minus"),
        new("Start Handle", T("Controle deslizante inicial.", "Starting slider handle."), "arrows-left-right"),
        new("End Handle", T("Controle deslizante final.", "Ending slider handle."), "arrows-left-right"),
        new("Value Display", T("Exibicao dos valores com prefixo e sufixo.", "Value display with prefix and suffix."), "tag"),
        new("Label", T("Texto descritivo acima do slider.", "Descriptive text above slider."), "font"),
        new("Helper Text", T("Texto de ajuda abaixo do slider.", "Helper text below slider."), "circle-info")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(T("Feedback visual", "Visual feedback"), T("Valores atualizados em tempo real.", "Values updated in real time."), "eye"),
        new(T("Precisao", "Precision"), T("Step control para incrementos exatos.", "Step control for exact increments."), "crosshairs"),
        new(T("Acessibilidade", "Accessibility"), T("Navegacao por teclado completa.", "Full keyboard navigation."), "universal-access")
    ];

    // === EXAMPLES ===
    private RenderFragment ExBasic() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFRangeSlider Label="Faixa de preco" Min="0" Max="1000" StartValue="200" EndValue="800" ShowValue="true" PrefixText="R$ " />
    </XFStack>;

    private RenderFragment ExStep() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFRangeSlider Label="Horario" Min="0" Max="24" Step="1" StartValue="8" EndValue="18" ShowValue="true" SuffixText="h" />
    </XFStack>;

    private RenderFragment ExSuffixFormat() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFRangeSlider Label="Temperatura" Min="-10" Max="40" StartValue="5" EndValue="30" ShowValue="true" SuffixText="°C" />
        <XFRangeSlider Label="Peso" Min="0" Max="200" Step="0.5M" StartValue="50" EndValue="90" ShowValue="true" ValueFormat="F1" SuffixText=" kg" />
    </XFStack>;

    private RenderFragment ExBounds() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFRangeSlider Label="Distancia" Min="0" Max="500" StartValue="50" EndValue="350" ShowValue="true" ShowBounds="true" SuffixText=" km" />
        <XFRangeSlider Label="Percentual" Min="0" Max="100" StartValue="20" EndValue="80" ShowValue="true" ShowBounds="true" SuffixText="%" />
    </XFStack>;

    private RenderFragment ExReadOnly() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFRangeSlider Label="Faixa aprovada" Min="0" Max="1000" StartValue="300" EndValue="700" ShowValue="true" PrefixText="R$ " ReadOnly="true" />
    </XFStack>;

    private RenderFragment ExSizes() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFRangeSlider Label="Small" Min="0" Max="100" StartValue="20" EndValue="80" ShowValue="true" Size="XFSize.Sm" />
        <XFRangeSlider Label="Medium" Min="0" Max="100" StartValue="20" EndValue="80" ShowValue="true" Size="XFSize.Md" />
        <XFRangeSlider Label="Large" Min="0" Max="100" StartValue="20" EndValue="80" ShowValue="true" Size="XFSize.Lg" />
    </XFStack>;

    private const string Code1 = @"<XFRangeSlider Label=""Faixa de preco"" Min=""0"" Max=""1000""
    StartValue=""200"" EndValue=""800""
    ShowValue=""true"" PrefixText=""R$ "" />";

    private const string Code2 = @"<XFRangeSlider Label=""Horario"" Min=""0"" Max=""24"" Step=""1""
    StartValue=""8"" EndValue=""18""
    ShowValue=""true"" SuffixText=""h"" />";

    private const string Code3 = @"<XFRangeSlider Label=""Temperatura"" Min=""-10"" Max=""40""
    StartValue=""5"" EndValue=""30""
    ShowValue=""true"" SuffixText=""°C"" />
<XFRangeSlider Label=""Peso"" Min=""0"" Max=""200"" Step=""0.5M""
    StartValue=""50"" EndValue=""90""
    ShowValue=""true"" ValueFormat=""F1"" SuffixText="" kg"" />";

    private const string Code4 = @"<XFRangeSlider Label=""Distancia"" Min=""0"" Max=""500""
    StartValue=""50"" EndValue=""350""
    ShowValue=""true"" ShowBounds=""true"" SuffixText="" km"" />
<XFRangeSlider Label=""Percentual"" Min=""0"" Max=""100""
    StartValue=""20"" EndValue=""80""
    ShowValue=""true"" ShowBounds=""true"" SuffixText=""%"" />";

    private const string Code5 = @"<XFRangeSlider Label=""Faixa aprovada"" Min=""0"" Max=""1000""
    StartValue=""300"" EndValue=""700""
    ShowValue=""true"" PrefixText=""R$ "" ReadOnly=""true"" />";

    private const string Code6 = @"<XFRangeSlider Label=""Small"" Min=""0"" Max=""100""
    StartValue=""20"" EndValue=""80""
    ShowValue=""true"" Size=""XFExtendedSize.Sm"" />
<XFRangeSlider Label=""Medium"" Min=""0"" Max=""100""
    StartValue=""20"" EndValue=""80""
    ShowValue=""true"" Size=""XFExtendedSize.Md"" />
<XFRangeSlider Label=""Large"" Min=""0"" Max=""100""
    StartValue=""20"" EndValue=""80""
    ShowValue=""true"" Size=""XFExtendedSize.Lg"" />";

    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("StartValue", "decimal?", "null", T("Valor inicial do intervalo.", "Start value of the range.")),
        new("EndValue", "decimal?", "null", T("Valor final do intervalo.", "End value of the range.")),
        new("Min", "decimal", "0", T("Valor minimo do slider.", "Minimum slider value.")),
        new("Max", "decimal", "100", T("Valor maximo do slider.", "Maximum slider value.")),
        new("Step", "decimal", "1", T("Incremento entre valores.", "Increment between values.")),
        new("ShowValue", "bool", "true", T("Exibe valores numericos nos controles.", "Shows numeric values on handles.")),
        new("ShowBounds", "bool", "true", T("Exibe valores minimo e maximo.", "Shows minimum and maximum values.")),
        new("PrefixText", "string?", "null", T("Texto antes do valor.", "Text before value.")),
        new("SuffixText", "string?", "null", T("Texto depois do valor.", "Text after value.")),
        new("ValueFormat", "string?", "null", T("Formato de exibicao do valor (ex: F1, N0).", "Value display format (e.g. F1, N0).")),
        new("RangeSeparatorText", "string", "\" - \"", T("Separador entre inicio e fim.", "Separator between start and end.")),
        new("Label", "string?", "null", T("Texto descritivo do slider.", "Descriptive slider text.")),
        new("StartAriaLabel", "string?", "null", T("Label acessivel do controle inicial.", "Accessible label for start handle.")),
        new("EndAriaLabel", "string?", "null", T("Label acessivel do controle final.", "Accessible label for end handle.")),
        new("HelperText", "string?", "null", T("Texto de ajuda abaixo do slider.", "Helper text below slider.")),
        new("Size", "XFSize", "Md", T("Tamanho do slider: Sm, Md, Lg.", "Slider size: Sm, Md, Lg.")),
        new("Tone", "XFSemanticColor", "Default", T("Tom visual: Default, Secondary, Success, Warning, Danger.", "Visual tone: Default, Secondary, Success, Warning, Danger.")),
        new("ReadOnly", "bool", "false", T("Modo somente leitura.", "Read-only mode.")),
        new("Required", "bool", "false", T("Campo obrigatorio.", "Required field.")),
        new("FullWidth", "bool", "true", T("Ocupa largura total do container.", "Occupies full container width.")),
        new("Immediate", "bool", "true", T("Atualiza valor imediatamente ao arrastar.", "Updates value immediately while dragging.")),
        new("AllowOverlap", "bool", "false", T("Permite controles se cruzarem.", "Allows handles to cross each other.")),
        new("Culture", "CultureInfo?", "null", T("Cultura para formatacao de numeros.", "Culture for number formatting."))
    ];

    private IReadOnlyList<NameValueRow> EventRows => [
        new("StartValueChanged", T("Disparado quando o valor inicial muda.", "Fired when the start value changes.")),
        new("EndValueChanged", T("Disparado quando o valor final muda.", "Fired when the end value changes.")),
        new("Change", T("Disparado quando qualquer valor do intervalo muda.", "Fired when any range value changes."))
    ];

    // === ACCESSIBILITY ===
    private IReadOnlyList<DocTile> AccessibilityItems => [
        new(T("role=slider", "role=slider"), T("Cada controle usa role=slider para leitores de tela.", "Each handle uses role=slider for screen readers."), "universal-access"),
        new(T("aria-valuenow", "aria-valuenow"), T("Valor atual de cada controle.", "Current value of each handle."), "font"),
        new(T("aria-label", "aria-label"), T("Labels distintos para inicio e fim.", "Distinct labels for start and end."), "tag"),
        new(T("aria-describedby", "aria-describedby"), T("Referencia ao HelperText.", "Reference to HelperText."), "circle-info"),
        new(T("Navegacao por teclado", "Keyboard navigation"), T("ArrowLeft, ArrowRight, Home, End para ajuste.", "ArrowLeft, ArrowRight, Home, End for adjustment."), "keyboard")
    ];

    private IReadOnlyList<NameValueRow> KeyboardRows => [
        new("ArrowRight / ArrowUp", T("Aumenta valor em Step.", "Increases value by Step.")),
