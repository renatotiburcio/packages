        new(T("Configuracao de horarios", "Schedule settings"), T("Definir horarios de funcionamento.", "Set business hours."), "clock"),
        new(T("Limites de sistema", "System limits"), T("Configurar limites de upload ou processamento.", "Configure upload or processing limits."), "gear")
