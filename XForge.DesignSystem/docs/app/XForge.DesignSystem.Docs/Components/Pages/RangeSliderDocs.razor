        new(T("RangeSlider + Label", "RangeSlider + Label"), T("Label descritivo acima do slider.", "Descriptive label above slider."), "font"),
        new(T("RangeSlider + Helper", "RangeSlider + Helper"), T("Texto de ajuda abaixo do slider.", "Helper text below slider."), "circle-info"),
        new(T("RangeSlider + Card", "RangeSlider + Card"), T("Slider dentro de XFCard para contexto.", "Slider inside XFCard for context."), "square")
