@page "/display/scheduler"
@using XForge.DesignSystem.Core.Primitives
@using XForge.DesignSystem.Components.DataDisplay.Scheduler
@using XForge.DesignSystem.Components.Overlays.Dialog
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFScheduler" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Mes, semana e dia", "Month, week and day")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Agenda corporativa com visoes de mes, semana e dia, recursos e drag-and-drop.",
                               "Corporate scheduler with month, week and day views, resources and drag-and-drop.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("Componente generico para exibicao e interacao com compromissos, com navegacao por periodo, multiplos recursos, templates customizados, movimentacao e redimensionamento.",
                               "Generic component for displaying and interacting with appointments, with period navigation, multiple resources, custom templates, move and resize.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico. Interacoes requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderizacao.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 4)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 6 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Visao Mes", "1. Month View"), T("Grade mensal com agendamentos agrupados por dia.", "Monthly grid with appointments grouped by day."), ExMonthView(), Code1)
            @Example(T("2. Visao Semana com Recursos", "2. Week View with Resources"), T("Timeline semanal com colunas por recurso (sala, equipe).", "Weekly timeline with resource columns (room, team)."), ExWeekViewResources(), Code2)
            @Example(T("3. Visao Dia", "3. Day View"), T("Timeline diaria com slots de 30 minutos.", "Daily timeline with 30-minute slots."), ExDayView(), Code3)
            @Example(T("4. Template Customizado", "4. Custom Template"), T("Appointments com icone e cor customizada via Template.", "Appointments with icon and custom color via Template."), ExCustomTemplate(), Code4)
            @Example(T("5. Slot Template", "5. Slot Template"), T("Slot customizado com acao de criar agendamento.", "Custom slot with create-appointment action."), ExSlotTemplate(), Code5)
            @Example(T("6. Navegacao e Dialog", "6. Navigation and Dialog"), T("Navegar entre datas, criar e visualizar agendamentos com XFDialogService.", "Navigate between dates, create and view appointments with XFDialogService."), ExNavigationEvents(), Code6)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string ProductLabelText => T("Core Open Source", "Core Open Source");
    private string PageTitleText => T("XFScheduler", "XFScheduler");
    private string PageStatusText => T("Documentacao completa", "Complete docs");
    private string T(string pt, string en) => LanguageService.Text(pt, en);
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");

    private sealed class EventItem
    {
        public DateTime Start { get; set; }
        public DateTime End { get; set; }
        public string Text { get; set; } = string.Empty;
        public string? ResourceId { get; set; }
    }

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFScheduler TItem="EventItem"
                     Data="@HeroData"
                     StartProperty="Start"
                     EndProperty="End"
                     TextProperty="Text"
                     ResourceProperty="ResourceId"
                     Resources="@HeroResources"
                     View="XFSchedulerView.Week"
                     StartHour="8"
                     EndHour="18"
                     SlotMinutes="60" />
    </XFStack>;

    private IReadOnlyList<EventItem> HeroData => new List<EventItem>
    {
        new EventItem { Start = DateTime.Today.AddHours(9), End = DateTime.Today.AddHours(10), Text = "Daily Standup", ResourceId = "room-a" },
        new EventItem { Start = DateTime.Today.AddHours(14), End = DateTime.Today.AddHours(15).AddMinutes(30), Text = "Sprint Review", ResourceId = "room-b" }
    };

    private IReadOnlyList<XFSchedulerResource> HeroResources => new List<XFSchedulerResource>
    {
        new XFSchedulerResource("room-a", "Sala A"),
        new XFSchedulerResource("room-b", "Sala B")
    };

    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("3 visoes", "3 views"), T("Mes, semana e dia com navegacao por periodo.", "Month, week and day with period navigation."), "calendar"),
        new(T("Recursos", "Resources"), T("Multiplos recursos com colunas na visao timeline.", "Multiple resources with columns in timeline view."), "layer-group"),
        new(T("Drag-and-drop", "Drag-and-drop"), T("Mover e redimensionar agendamentos.", "Move and resize appointments."), "arrows-up-down")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFScheduler<TItem>"),
        new("Namespace", "XForge.DesignSystem.Components.DataDisplay.Scheduler"),
        new("Package", "XForge.DesignSystem"),
        new("Category", "Data Display / Scheduler"),
        new("Status", T("Estavel", "Stable")),
        new("Generic", "TItem = tipo do item de dados"),
        new("Accessibility", T("role=grid, role=button, aria-label, aria-selected, aria-description.", "role=grid, role=button, aria-label, aria-selected, aria-description.")),
        new("Theme support", T("Light, dark e data-brand via tokens.", "Light, dark and data-brand via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("Agenda corporativa", "Corporate scheduler"), T("Exibicao de compromissos em grade e timeline.", "Appointment display in grid and timeline."), "calendar"),
        new(T("3 visoes", "3 views"), T("Mes (grade), semana (timeline), dia (timeline).", "Month (grid), week (timeline), day (timeline)."), "columns-3"),
        new(T("Recursos", "Resources"), T("Agrupamento por sala, equipe ou pessoa.", "Grouping by room, team or person."), "layer-group"),
        new(T("Drag-and-drop", "Drag-and-drop"), T("Mover e redimensionar agendamentos.", "Move and resize appointments."), "arrows-up-down"),
        new(T("Templates", "Templates"), T("Renderizacao customizada de slots e appointments.", "Custom rendering of slots and appointments."), "paintbrush"),
        new(T("Zero JS", "Zero JS"), T("Nenhum JavaScript interop. Puro C# + Tailwind.", "No JavaScript interop. Pure C# + Tailwind."), "bolt")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Reunioes", "Meetings"), T("Agendar reunioes com participantes e salas.", "Schedule meetings with attendees and rooms."), "users"),
        new(T("Alocacao", "Allocation"), T("Alocar recursos em projetos.", "Allocate resources to projects."), "layer-group"),
        new(T("Turnos", "Shifts"), T("Gerenciar escalas de trabalho.", "Manage work shifts."), "clock")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Agendamentos sem visualizacao consolidada.", "Appointments without consolidated view."), "xmark"),
        new(T("Depois", "After"), T("Grade e timeline com navegacao e interacao.", "Grid and timeline with navigation and interaction."), "check"),
        new(T("Acessibilidade", "Accessibility"), T("role=grid, aria-label, aria-selected.", "role=grid, aria-label, aria-selected."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Agendas corporativas", "Corporate calendars"), T("Calendario de reunioes e alocacao de salas.", "Meeting calendar and room allocation."), "calendar"),
        new(T("Gestao de projetos", "Project management"), T("Acompanhamento de marcos e entregas.", "Tracking milestones and deliverables."), "tasks")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Listas simples", "Simple lists"), T("Use XFTable para listas sem dimensao temporal.", "Use XFTable for lists without temporal dimension."), "list"),
        new(T("Gantt detalhado", "Detailed Gantt"), T("Para diagramas Gantt complexos, use biblioteca especializada.", "For complex Gantt charts, use a specialized library."), "chart-gantt")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new("Header", T("Navegacao por periodo, titulo e seletor de view.", "Period navigation, title and view selector."), "heading"),
        new("Month Grid", T("Grade 7x6 com dias e agendamentos.", "7x6 grid with days and appointments."), "grid"),
        new("Timeline", T("Coluna de horas com slots e agendamentos.", "Hour column with slots and appointments."), "clock"),
        new("Appointment", T("Bloco de agendamento com texto e horario.", "Appointment block with text and time."), "square"),
        new("Resource Column", T("Coluna por recurso na visao timeline.", "Per-resource column in timeline view."), "layer-group"),
        new("View Switcher", T("Toggle entre mes, semana e dia.", "Toggle between month, week and day."), "toggle-on")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(T("Visao consolidada", "Consolidated view"), T("Tudo em uma tela: agenda, recursos, navegacao.", "Everything on one screen: calendar, resources, navigation."), "eye"),
        new(T("Interacao direta", "Direct interaction"), T("Clique no slot para criar, no appointment para selecionar.", "Click slot to create, appointment to select."), "hand-pointer"),
        new(T("Navegacao periodica", "Period navigation"), T("Anterior/Proximo com botao Hoje.", "Previous/Next with Today button."), "arrows-left-right")
    ];

    // === EXAMPLES ===
    private RenderFragment ExMonthView() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFScheduler TItem="EventItem"
                     Data="@MonthData"
                     StartProperty="Start"
                     EndProperty="End"
                     TextProperty="Text"
                     View="XFSchedulerView.Month"
                     FirstDayOfWeek="DayOfWeek.Monday" />
    </XFStack>;

    private IReadOnlyList<EventItem> MonthData => new List<EventItem>
    {
        new EventItem { Start = DateTime.Today.AddDays(-2).AddHours(10), End = DateTime.Today.AddDays(-2).AddHours(11), Text = "Kickoff" },
        new EventItem { Start = DateTime.Today.AddDays(1).AddHours(14), End = DateTime.Today.AddDays(1).AddHours(15), Text = "Revisao de codigo" },
        new EventItem { Start = DateTime.Today.AddDays(1).AddHours(16), End = DateTime.Today.AddDays(1).AddHours(17), Text = "Demo" },
        new EventItem { Start = DateTime.Today.AddDays(3).AddHours(9), End = DateTime.Today.AddDays(3).AddHours(10).AddMinutes(30), Text = "Planejamento sprint" },
        new EventItem { Start = DateTime.Today.AddDays(5).AddHours(11), End = DateTime.Today.AddDays(5).AddHours(12), Text = "Retrospectiva" }
