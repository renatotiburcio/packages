@page "/components/key-code"
@using XForge.DesignSystem.Core.Primitives
@using XForge.DesignSystem.Components.Utilities.KeyCode
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFKeyCode" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Atalhos de teclado", "Keyboard shortcuts")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Captura e exibe atalhos de teclado para comandos de aplicacoes densas.",
                               "Captures and displays keyboard shortcuts for dense application commands.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("Controle de teclado acessivel com dicas visuais, modificadores Ctrl/Shift/Alt/Meta, eventos de invocacao e suporte a disabled.",
                               "Accessible keyboard control with visual hints, Ctrl/Shift/Alt/Meta modifiers, invocation events, and disabled support.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico. Eventos requerem modo interativo.", "Renders as static HTML. Events require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderizacao.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 6 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Atalhos basicos", "1. Basic Shortcuts"), T("Container com atalhos simples usando Key e Label.", "Container with simple shortcuts using Key and Label."), ExBasic(), Code1)
            @Example(T("2. Dicas visuais", "2. Visual Hints"), T("ShowHints exibe todas as teclas disponiveis automaticamente.", "ShowHints displays all available keys automatically."), ExHints(), Code2)
            @Example(T("3. Combinacoes Ctrl+Shift", "3. Ctrl+Shift Combos"), T("Atalhos com multiplos modificadores simultaneos.", "Shortcuts with multiple simultaneous modifiers."), ExCombos(), Code3)
            @Example(T("4. Prevencao de eventos", "4. Event Prevention"), T("PreventDefault e StopPropagation para controle total.", "PreventDefault and StopPropagation for full control."), ExPreventDefault(), Code4)
            @Example(T("5. Separador customizado", "5. Custom Separator"), T("ShortcutTextSeparator personaliza o delimitador entre teclas.", "ShortcutTextSeparator customizes the delimiter between keys."), ExSeparator(), Code5)
            @Example(T("6. Tratamento de eventos", "6. Event Handling"), T("ShortcutInvoked dispara callback com XFKeyCodeEventArgs.", "ShortcutInvoked fires callback with XFKeyCodeEventArgs."), ExEvents(), Code6)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string ProductLabelText => T("Core Open Source", "Core Open Source");
    private string PageTitleText => T("XFKeyCode", "XFKeyCode");
    private string PageStatusText => T("Documentacao completa", "Complete docs");
    private string T(string pt, string en) => LanguageService.Text(pt, en);
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFKeyCode ShowHints="true" Shortcuts="HeroShortcuts">
            <div class="rounded-lg border border-border-light bg-surface-50 p-4">
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Foco neste container e pressione as teclas.", "Focus this container and press the keys.")</XFTypography>
            </div>
        </XFKeyCode>
    </XFStack>;

    private IReadOnlyList<XFKeyCodeShortcut> HeroShortcuts => [
        new XFKeyCodeShortcut { Key = "s", Ctrl = true, Label = T("Salvar", "Save"), Description = T("Salvar documento", "Save document") },
        new XFKeyCodeShortcut { Key = "z", Ctrl = true, Label = T("Desfazer", "Undo"), Description = T("Desfazer acao", "Undo action") },
        new XFKeyCodeShortcut { Key = "n", Ctrl = true, Shift = true, Label = T("Novo", "New"), Description = T("Criar novo registro", "Create new record") }
    ];

    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("Atalhos de teclado", "Keyboard shortcuts"), T("Container para capturar e exibir atalhos.", "Container to capture and display shortcuts."), "keyboard"),
        new(T("Modificadores", "Modifiers"), T("Ctrl, Shift, Alt e Meta com suporte a combinacoes.", "Ctrl, Shift, Alt and Meta with combo support."), "key"),
        new(T("Zero JS", "Zero JS"), T("Nenhum JavaScript interop. Puro C# + Tailwind.", "No JavaScript interop. Pure C# + Tailwind."), "bolt")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFKeyCode"),
        new("Namespace", "XForge.DesignSystem.Components.Utilities.KeyCode"),
        new("Package", "XForge.DesignSystem"),
        new("Category", "Utilities / KeyCode"),
        new("Status", T("Estavel", "Stable")),
        new("Accessibility", T("role=group, tabindex, aria-label, aria-describedby.", "role=group, tabindex, aria-label, aria-describedby.")),
        new("Theme support", T("Light, dark e data-brand via tokens.", "Light, dark and data-brand via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("Container de atalhos", "Shortcut container"), T("Wrapper que captura eventos de teclado.", "Wrapper that captures keyboard events."), "keyboard"),
        new(T("Dicas visuais", "Visual hints"), T("ShowHints renderiza teclas disponiveis.", "ShowHints renders available keys."), "eye"),
        new(T("Eventos", "Events"), T("ShortcutInvoked dispara callback com detalhes.", "ShortcutInvoked fires callback with details."), "bolt")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("ERP densos", "Dense ERP"), T("Atalhos para telas com muitas acoes.", "Shortcuts for screens with many actions."), "database"),
        new(T("Editor de codigo", "Code editor"), T("Comandos de teclado em editores.", "Keyboard commands in editors."), "code"),
        new(T("Painel administrativo", "Admin panel"), T("Navegacao rapida por teclado.", "Quick keyboard navigation."), "gauge")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Sem atalhos ou com JS customizado.", "No shortcuts or with custom JS."), "xmark"),
        new(T("Depois", "After"), T("Container declarativo com C# puro.", "Declarative container with pure C#."), "check"),
        new(T("Acessibilidade", "Accessibility"), T("role=group, tabindex, aria-label nativos.", "role=group, tabindex, aria-label native."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Telas complexas", "Complex screens"), T("Telas com muitas acoes simultaneas.", "Screens with many simultaneous actions."), "layers"),
        new(T("Editores", "Editors"), T("Editores de texto ou codigo.", "Text or code editors."), "pen")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Navegacao simples", "Simple navigation"), T("Use links ou botoes para navegacao basica.", "Use links or buttons for basic navigation."), "route"),
        new(T("Formularios", "Forms"), T("Use XFInput para entrada de dados.", "Use XFInput for data entry."), "pen")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new("Container", T("Wrapper que recebe eventos de teclado.", "Wrapper that receives keyboard events."), "square"),
        new("ChildContent", T("Conteudo interno do container.", "Internal container content."), "folder"),
        new("Hints", T("Dicas visuais com teclas e labels.", "Visual hints with keys and labels."), "keyboard"),
        new("kbd", T("Elemento de teclado estilizado.", "Styled keyboard element."), "tag")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(T("Declarativo", "Declarative"), T("Atalhos definidos como objetos C#.", "Shortcuts defined as C# objects."), "code"),
        new(T("Acessivel", "Accessible"), T("role=group, tabindex, aria-label.", "role=group, tabindex, aria-label."), "universal-access"),
        new(T("Compostavel", "Composable"), T("Combina com qualquer conteudo interno.", "Combines with any internal content."), "puzzle")
    ];

    // === EXAMPLES ===
    private RenderFragment ExBasic() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFKeyCode Shortcuts="BasicShortcuts">
            <div class="rounded-lg border border-border-light bg-surface-50 p-4">
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Foco e pressione Ctrl+S para salvar.", "Focus and press Ctrl+S to save.")</XFTypography>
            </div>
        </XFKeyCode>
    </XFStack>;

    private RenderFragment ExHints() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFKeyCode Shortcuts="BasicShortcuts" ShowHints="true">
            <div class="rounded-lg border border-border-light bg-surface-50 p-4">
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Dicas visuais exibidas abaixo do container.", "Visual hints displayed below the container.")</XFTypography>
            </div>
        </XFKeyCode>
    </XFStack>;

    private RenderFragment ExCombos() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFKeyCode Shortcuts="ComboShortcuts" ShowHints="true">
            <div class="rounded-lg border border-border-light bg-surface-50 p-4">
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Combinacoes com multiplos modificadores.", "Combinations with multiple modifiers.")</XFTypography>
            </div>
        </XFKeyCode>
    </XFStack>;

    private RenderFragment ExPreventDefault() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFKeyCode Shortcuts="BasicShortcuts" PreventDefault="true" StopPropagation="true" ShowHints="true">
            <div class="rounded-lg border border-border-light bg-surface-50 p-4">
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("PreventDefault impede acao padrao do navegador.", "PreventDefault blocks the browser default action.")</XFTypography>
            </div>
        </XFKeyCode>
    </XFStack>;

    private RenderFragment ExSeparator() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFKeyCode Shortcuts="BasicShortcuts" ShortcutTextSeparator=" + " ShowHints="true">
            <div class="rounded-lg border border-border-light bg-surface-50 p-4">
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Separador customizado entre teclas.", "Custom delimiter between keys.")</XFTypography>
            </div>
        </XFKeyCode>
    </XFStack>;

    private RenderFragment ExEvents() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFKeyCode Shortcuts="BasicShortcuts" ShortcutInvoked="OnShortcutInvoked" ShowHints="true">
            <div class="rounded-lg border border-border-light bg-surface-50 p-4">
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Atalho invocado: ", "Shortcut invoked: ")@(_lastShortcut ?? T("nenhum", "none"))</XFTypography>
            </div>
        </XFKeyCode>
    </XFStack>;

    private string? _lastShortcut;

    private void OnShortcutInvoked(XFKeyCodeEventArgs args)
    {
        _lastShortcut = args.Shortcut.Id;
    }

    private IReadOnlyList<XFKeyCodeShortcut> BasicShortcuts => [
        new XFKeyCodeShortcut { Key = "s", Ctrl = true, Label = T("Salvar", "Save") },
        new XFKeyCodeShortcut { Key = "z", Ctrl = true, Label = T("Desfazer", "Undo") },
        new XFKeyCodeShortcut { Key = "y", Ctrl = true, Label = T("Refazer", "Redo") }
    ];

    private IReadOnlyList<XFKeyCodeShortcut> ComboShortcuts => [
        new XFKeyCodeShortcut { Key = "n", Ctrl = true, Shift = true, Label = T("Novo", "New") },
        new XFKeyCodeShortcut { Key = "d", Ctrl = true, Shift = true, Label = T("Duplicar", "Duplicate") },
        new XFKeyCodeShortcut { Key = "Delete", Ctrl = true, Alt = true, Label = T("Excluir", "Delete") }
    ];

    private const string Code1 = @"<XFKeyCode Shortcuts=""BasicShortcuts"">
    <div class=""rounded-lg border border-border-light bg-surface-50 p-4"">
        Foco e pressione Ctrl+S para salvar.
    </div>
</XFKeyCode>

