        new("Key", "string", "string.Empty", T("Tecla principal (ex: s, Delete, Space).", "Main key (e.g. s, Delete, Space).")),
        new("Label", "string?", "null", T("Texto exibido nas dicas.", "Text shown in hints.")),
        new("Description", "string?", "null", T("Descricao detalhada do atalho.", "Detailed shortcut description.")),
        new("Ctrl", "bool", "false", T("Requer modificador Ctrl.", "Requires Ctrl modifier.")),
        new("Shift", "bool", "false", T("Requer modificador Shift.", "Requires Shift modifier.")),
        new("Alt", "bool", "false", T("Requer modificador Alt.", "Requires Alt modifier.")),
