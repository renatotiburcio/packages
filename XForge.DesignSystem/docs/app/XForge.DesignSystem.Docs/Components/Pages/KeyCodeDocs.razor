    // === ACCESSIBILITY ===
    private IReadOnlyList<DocTile> AccessibilityItems => [
        new(T("role=group", "role=group"), T("Container usa role=group para leitores de tela.", "Container uses role=group for screen readers."), "universal-access"),
        new(T("tabindex", "tabindex"), T("Focusable=true adiciona tabindex=0.", "Focusable=true adds tabindex=0."), "keyboard"),
