    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("ChildContent", "RenderFragment?", "null", T("Conteudo interno do container.", "Internal container content.")),
        new("Shortcuts", "IReadOnlyList<XFKeyCodeShortcut>", "[]", T("Lista de atalhos registrados.", "List of registered shortcuts.")),
        new("ShortcutInvoked", "EventCallback<XFKeyCodeEventArgs>", "null", T("Callback ao invocar atalho.", "Callback on shortcut invocation.")),
        new("Focusable", "bool", "true", T("Container recebe foco por tab.", "Container receives focus by tab.")),
        new("ShowHints", "bool", "false", T("Exibe dicas visuais de teclas.", "Shows visual key hints.")),
        new("PreventDefault", "bool", "false", T("Impede acao padrao do navegador.", "Prevents browser default action.")),
        new("StopPropagation", "bool", "false", T("Impede propagacao do evento.", "Prevents event propagation.")),
        new("AriaLabel", "string?", "Area de atalhos de teclado", T("Label acessivel do container.", "Accessible container label.")),
        new("HintsLabel", "string", "Atalhos disponiveis", T("Label das dicas visuais.", "Visual hints label.")),
