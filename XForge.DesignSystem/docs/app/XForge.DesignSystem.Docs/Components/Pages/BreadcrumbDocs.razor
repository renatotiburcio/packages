@page "/navigation/breadcrumb"
@using XForge.DesignSystem.Core.Primitives
@using XForge.DesignSystem.Components.Navigation.Breadcrumb
@using XForge.DesignSystem.Services
@page "/components/breadcrumb"

@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true" >
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFBreadcrumb" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("WAI-ARIA", "WAI-ARIA")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Colapso", "Collapse")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Enterprise", "Enterprise")" />
                    </XFStack>

                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Trilha de navegação acessível com colapso, variantes e templates.",
                               "Accessible breadcrumb trail with collapse, variants and templates.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("XFBreadcrumb coordena itens de navegação hierárquica com colapso inteligente do meio, 3 variantes visuais, 3 tamanhos, templates por item e touch target 44px WCAG AAA.",
                               "XFBreadcrumb coordinates hierarchical navigation items with smart middle collapse, 3 visual variants, 3 sizes, per-item templates and 44px WCAG AAA touch target.")
                        </XFTypography>
                    </XFStack>

                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts)
                            {
                                @Tile(item)
                            }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observações", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estático. Interações requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependências JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente não utiliza JavaScript interop. É puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderização.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Considerações", "Considerations")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor Server: eventos são tratados via SignalR. Sem latência adicional para componentes puramente renderizados.", "Blazor Server: events are handled via SignalR. No additional latency for purely rendered components.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor WebAssembly: eventos são tratados diretamente no cliente. Mais responsivo.", "Blazor WebAssembly: events are handled directly on the client. More responsive.")</XFTypography>
                </XFStack>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visão geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Propósito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando não usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Hierarquia visual", "Visual Hierarchy"), @<div>@TileGrid(VisualHierarchyItems, 3)</div>)
            @Section(T("Princípios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Básico", "1. Basic"),
                T("Trilha de navegação ERP com itens hierárquicos.", "ERP breadcrumb trail with hierarchical items."),
                BasicPreview(),
                BasicCode)

            @Example(T("2. Variantes visuais", "2. Visual variants"),
                T("Plain, Soft e Surface para diferentes contextos.", "Plain, Soft and Surface for different contexts."),
                VariantsPreview(),
                VariantsCode)

            @Example(T("3. Colapso inteligente", "3. Smart collapse"),
                T("Trilhas longas com colapso do meio e MaxVisibleItems.", "Long trails with middle collapse and MaxVisibleItems."),
                CollapsePreview(),
                CollapseCode)

            @Example(T("4. Ícone por item", "4. Icon per item"),
                T("Itens com ícones do catálogo XFSvgIcons para contextualização visual.", "Items with XFSvgIcons catalog icons for visual contextualization."),
                IconsPreview(),
                IconsCode)

            @Example(T("5. Separador e template customizados", "5. Custom separator and template"),
                T("Separador e ItemTemplate para personalização total.", "Separator and ItemTemplate for full customization."),
                CustomPreview(),
                CustomCode)

            @Example(T("6. Tamanhos", "6. Sizes"),
                T("Sm, Md e Lg com touch target mínimo 44px.", "Sm, Md and Lg with 44px minimum touch target."),
                SizesPreview(),
                SizesCode)

            @Example(T("7. Cenário enterprise", "7. Enterprise scenario"),
                T("Breadcrumb integrado em detalhe de nota fiscal com navegação.", "Breadcrumb integrated in invoice detail with navigation."),
                EnterprisePreview(),
                EnterpriseCode)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Variantes", "Variants"), @<div>@NameValueTable(VariantRows, T("Variante", "Variant"), T("Caso de uso", "Use case"))</div>)
            @Section(T("Estados", "States"), @<div>@NameValueTable(StateRows, T("Estado", "State"), T("Comportamento", "Behavior"))</div>)
            @Section("API — XFBreadcrumb", @<div>@ApiTable(ApiRows)</div>)
            @Section("API — XFBreadcrumbItem", @<div>@ApiTable(ItemApiRows)</div>)
            @Section("API — XFBreadcrumbItemModel", @<div>@ApiTable(ModelApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenários enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padrões de composição", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas práticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padrões", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Propósito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidência", "Evidence"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Limitações conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitação", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versão", "Version"), T("Mudança", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string ProductLabelText => T("Core Open Source", "Core Open Source");
    private string PageTitleText => T("Breadcrumb", "Breadcrumb");
    private string PageStatusText => T("Documentação completa", "Complete docs");
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);

    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFBreadcrumb Items="HeroItems" Variant="XFContainerVariant.Surface" AriaLabel="@T("Trilha do ERP", "ERP trail")" />
        <XFBreadcrumb Items="HeroItems" Variant="XFContainerVariant.Soft" Size="XFSize.Sm" AriaLabel="@T("Trilha compacta", "Compact trail")" />
    </XFStack>;

    private RenderFragment BasicPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFBreadcrumb Items="BasicItems" Size="XFSize.Md" AriaLabel="@T("Navegação", "Navigation")" />
    </XFStack>;

    private RenderFragment VariantsPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <div>
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">Plain</XFTypography>
            <XFBreadcrumb Items="BasicItems" Size="XFSize.Md" Variant="XFContainerVariant.Plain" Class="mt-1" AriaLabel="Plain breadcrumb" />
        </div>
        <div>
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">Soft</XFTypography>
            <XFBreadcrumb Items="BasicItems" Size="XFSize.Md" Variant="XFContainerVariant.Soft" Class="mt-1" AriaLabel="Soft breadcrumb" />
        </div>
        <div>
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">Surface</XFTypography>
            <XFBreadcrumb Items="BasicItems" Size="XFSize.Md" Variant="XFContainerVariant.Surface" Class="mt-1" AriaLabel="Surface breadcrumb" />
        </div>
    </XFStack>;

    private RenderFragment CollapsePreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFBreadcrumb Items="LongItems" Size="XFSize.Md" MaxVisibleItems="4" CollapseMiddle="true" Variant="XFContainerVariant.Surface" AriaLabel="@T("Trilha longa", "Long trail")" />
        <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("MaxVisibleItems=4: primeiro e últimos 3 itens visíveis.", "MaxVisibleItems=4: first and last 3 items visible.")</XFTypography>
    </XFStack>;

    private RenderFragment IconsPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFBreadcrumb Items="IconItems" Size="XFSize.Md" Variant="XFContainerVariant.Soft" AriaLabel="@T("Trilha com ícones", "Trail with icons")" />
        <XFBreadcrumb Items="IconItemsCompact" Size="XFSize.Sm" Variant="XFContainerVariant.Plain" AriaLabel="@T("Trilha compacta com ícones", "Compact trail with icons")" />
    </XFStack>;

    private RenderFragment CustomPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFBreadcrumb Items="BasicItems" Size="XFSize.Md" AriaLabel="@T("Separador custom", "Custom separator")">
            <Separator>/</Separator>
        </XFBreadcrumb>
        <XFBreadcrumb Items="BasicItems" Size="XFSize.Md" ItemTemplate="CustomItemTemplate" AriaLabel="@T("Template custom", "Custom template")" />
    </XFStack>;

    private RenderFragment SizesPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <div>
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">Sm (min-h 44px)</XFTypography>
            <XFBreadcrumb Items="BasicItems" Size="XFSize.Sm" Variant="XFContainerVariant.Soft" Class="mt-1" AriaLabel="Small breadcrumb" />
        </div>
        <div>
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">Md (min-h 44px)</XFTypography>
            <XFBreadcrumb Items="BasicItems" Size="XFSize.Md" Variant="XFContainerVariant.Soft" Class="mt-1" AriaLabel="Medium breadcrumb" />
        </div>
        <div>
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">Lg (min-h 44px)</XFTypography>
            <XFBreadcrumb Items="BasicItems" Size="XFSize.Lg" Variant="XFContainerVariant.Soft" Class="mt-1" AriaLabel="Large breadcrumb" />
        </div>
    </XFStack>;

    private RenderFragment EnterprisePreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFBreadcrumb Items="EnterpriseItems" Size="XFSize.Md" Variant="XFContainerVariant.Surface" MaxVisibleItems="5" AriaLabel="@T("Trilha da nota fiscal", "Invoice trail")" />
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
            <ChildContent>
                <XFTypography Weight="XFTypographyWeight.Semibold">@T("NF-e #000.123.456.789", "Invoice #000.123.456.789")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Emitida em 26/05/2026 | R$ 18.420,00 | Status: Autorizada", "Issued on 05/26/2026 | R$ 18,420.00 | Status: Authorized")</XFTypography>
            </ChildContent>
        </XFCard>
    </XFStack>;

    private RenderFragment<XFBreadcrumbItemModel> CustomItemTemplate => item => @<span class="inline-flex min-h-[44px] items-center gap-1.5 rounded-md bg-primary/10 px-2.5 text-sm font-semibold text-primary">
        @if (item.Current) { <span class="h-2 w-2 rounded-full bg-primary" aria-hidden="true"></span> }
        @item.Text
    </span>;

    private IReadOnlyList<XFBreadcrumbItemModel> HeroItems => new[]
    {
        new XFBreadcrumbItemModel { Text = T("ERP", "ERP"), Href = "#" },
        new XFBreadcrumbItemModel { Text = T("Financeiro", "Finance"), Href = "#" },
        new XFBreadcrumbItemModel { Text = T("Conciliação", "Reconciliation"), Href = "#" },
        new XFBreadcrumbItemModel { Text = T("Lote 2048", "Batch 2048"), Current = true }
    };

    private IReadOnlyList<XFBreadcrumbItemModel> BasicItems => new[]
    {
        new XFBreadcrumbItemModel { Text = T("Início", "Home"), Href = "/" },
        new XFBreadcrumbItemModel { Text = T("Componentes", "Components"), Href = "/components" },
        new XFBreadcrumbItemModel { Text = "Breadcrumb", Current = true }
    };

    private IReadOnlyList<XFBreadcrumbItemModel> LongItems => new[]
    {
        new XFBreadcrumbItemModel { Text = T("Workspace", "Workspace"), Href = "/" },
        new XFBreadcrumbItemModel { Text = T("Operações", "Operations"), Href = "/" },
        new XFBreadcrumbItemModel { Text = T("Financeiro", "Finance"), Href = "/" },
        new XFBreadcrumbItemModel { Text = T("Relatórios", "Reports"), Href = "/" },
        new XFBreadcrumbItemModel { Text = T("Mensal", "Monthly"), Href = "/" },
        new XFBreadcrumbItemModel { Text = T("Maio 2026", "May 2026"), Current = true }
    };

    private RenderFragment IconHouse14 => @<span>@((MarkupString)XFSvgIcons.MarkupWithSize("house", 14))</span>;
    private RenderFragment IconChartLine14 => @<span>@((MarkupString)XFSvgIcons.MarkupWithSize("chart-line", 14))</span>;
    private RenderFragment IconChartBar14 => @<span>@((MarkupString)XFSvgIcons.MarkupWithSize("chart-bar", 14))</span>;
    private RenderFragment IconCalendar14 => @<span>@((MarkupString)XFSvgIcons.MarkupWithSize("calendar", 14))</span>;
    private RenderFragment IconBriefcase12 => @<span>@((MarkupString)XFSvgIcons.MarkupWithSize("briefcase", 12))</span>;
    private RenderFragment IconSliders12 => @<span>@((MarkupString)XFSvgIcons.MarkupWithSize("sliders", 12))</span>;
    private RenderFragment IconPuzzlePiece12 => @<span>@((MarkupString)XFSvgIcons.MarkupWithSize("puzzle-piece", 12))</span>;

    private IReadOnlyList<XFBreadcrumbItemModel> IconItems => new[]
    {
        new XFBreadcrumbItemModel { Text = T("Início", "Home"), Href = "/", Icon = IconHouse14 },
        new XFBreadcrumbItemModel { Text = T("Financeiro", "Finance"), Href = "/financeiro", Icon = IconChartLine14 },
        new XFBreadcrumbItemModel { Text = T("Relatórios", "Reports"), Href = "/financeiro/relatorios", Icon = IconChartBar14 },
        new XFBreadcrumbItemModel { Text = T("Maio 2026", "May 2026"), Current = true, Icon = IconCalendar14 }
    };

    private IReadOnlyList<XFBreadcrumbItemModel> IconItemsCompact => new[]
    {
        new XFBreadcrumbItemModel { Text = T("ERP", "ERP"), Href = "/", Icon = IconBriefcase12 },
        new XFBreadcrumbItemModel { Text = T("Configurações", "Settings"), Href = "/config", Icon = IconSliders12 },
        new XFBreadcrumbItemModel { Text = T("Módulo", "Module"), Current = true, Icon = IconPuzzlePiece12 }
    };

    private IReadOnlyList<XFBreadcrumbItemModel> EnterpriseItems => new[]
    {
        new XFBreadcrumbItemModel { Text = T("Fiscal", "Tax"), Href = "#" },
        new XFBreadcrumbItemModel { Text = T("NF-e", "Invoice"), Href = "#" },
        new XFBreadcrumbItemModel { Text = T("Série 1", "Series 1"), Href = "#" },
        new XFBreadcrumbItemModel { Text = T("Lote 42", "Batch 42"), Href = "#" },
        new XFBreadcrumbItemModel { Text = "000.123.456.789", Current = true }
    };
    private string CopyableCodeTitle => T("Código copiável", "Copyable code");

    private RenderFragment Section(string title, RenderFragment content) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
        <Header><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography></Header>
        <ChildContent>@content</ChildContent>
    </XFCard>;

    private RenderFragment Example(string title, string description, RenderFragment preview, string codeText) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.None" AreaRestricted="false">
        <Header>
            <div class="px-6 pt-6">
                <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@description</XFTypography>
            </div>
        </Header>
        <ChildContent>
            <div class="grid">
                <div class="border-t border-border-light p-6">@preview</div>
                <div class="border-t border-border-light bg-surface-50 p-6">
                    <XFCode Text="@codeText" Language="razor" Title="@CopyableCodeTitle" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" />
                </div>
            </div>
        </ChildContent>
    </XFCard>;

    private RenderFragment Tile(DocTile item) => @<XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
        <ChildContent>
            <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                <div class="flex items-center gap-4">
                    <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-primary/10 bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                    <div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div>
                </div>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
            </XFStack>
        </ChildContent>
    </XFCard>;

    private RenderFragment TileGrid(IReadOnlyList<DocTile> items, int columns) => @<XFGrid Cols="1" Md="@Math.Min(columns, 2)" Lg="@columns" Gap="4">
        @foreach (var item in items) { @Tile(item) }
    </XFGrid>;

    private RenderFragment WarningGrid(IReadOnlyList<DocTile> items) => @<XFGrid Cols="1" Md="2" Gap="4">
        @foreach (var item in items)
        {
            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
                <ChildContent>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                        <div class="flex items-center gap-4">
                            <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-danger/10 bg-danger/10 text-danger" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                            <div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div>
                        </div>
                        <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
                    </XFStack>
                </ChildContent>
            </XFCard>
        }
