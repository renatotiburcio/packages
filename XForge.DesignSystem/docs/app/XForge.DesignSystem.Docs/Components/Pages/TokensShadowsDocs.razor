@page "/tokens/shadows"
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@T("Core Open Source", "Core Open Source")"
                 Title="@T("Tokens de Sombras", "Shadow Tokens")"
                 Status="@T("Documentação completa", "Complete docs")"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        @* ==================== HEADER ==================== *@
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="Design Tokens" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Elevação", "Elevation")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Overlays", "Overlays")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Profundidade", "Depth")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Sistema de elevação para overlays, cards, menus e superfícies em camadas.",
                               "Elevation system for overlays, cards, menus and layered surfaces.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("Os tokens de sombra do XForge definem níveis de elevação visual usando box-shadow e Tailwind utilities. Eles organizam a hierarquia de camadas em modais, drawers, dropdowns, cards e tooltips do ERP.",
                               "XForge shadow tokens define visual elevation levels using box-shadow and Tailwind utilities. They organize layer hierarchy in ERP modals, drawers, dropdowns, cards and tooltips.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">@HeroPreview()</div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">@foreach (var item in QuickFacts) { @Tile(item) }</XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @* ==================== 1. METADATA ==================== *@
        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @* ==================== 2. BLAZOR SERVER / WASM ==================== *@
        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observações", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estático. Interações requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependências JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Tokens de sombra são CSS puro. Não utilizam JavaScript interop. Funcionam identicamente em todos os modos de renderização.", "Shadow tokens are pure CSS. They do not use JavaScript interop. They work identically in all rendering modes.")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Considerações", "Considerations")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor Server: sem latência adicional para tokens CSS.", "Blazor Server: no additional latency for CSS tokens.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor WebAssembly: aplicados diretamente pelo navegador.", "Blazor WebAssembly: applied directly by the browser.")</XFTypography>
                </XFStack>
            </XFStack>
        </div>)

        @* ==================== 3. OVERVIEW ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visão geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Propósito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando não usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 2)</div>)
        </XFStack>

        @* ==================== 4. VARIANTS & STATES ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Variantes", "Variants"), @<div>@NameValueTable(VariantRows, T("Token", "Token"), T("Uso", "Usage"))</div>)
            @Section(T("Estados", "States"), @<div>@NameValueTable(StateRows, T("Estado", "State"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        @* ==================== 5. VISUAL HIERARCHY & DESIGN ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Hierarquia visual", "Visual Hierarchy"), @<div>@TileGrid(VisualHierarchyItems, 3)</div>)
            @Section(T("Princípios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        @* ==================== 6-12. EXAMPLES ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Escala de elevação", "1. Elevation scale"),
                T("5 níveis de shadow do sutil ao extra.", "5 shadow levels from subtle to extra."),
                ShadowScalePreview(), ShadowScaleCode)

            @Example(T("2. Cards com sombra", "2. Cards with shadow"),
                T("shadow-sm para cards de superfície.", "shadow-sm for surface cards."),
                CardShadowPreview(), CardShadowCode)

            @Example(T("3. Overlays e modais", "3. Overlays and modals"),
                T("shadow-xl para modais e drawers.", "shadow-xl for modals and drawers."),
                OverlayShadowPreview(), OverlayShadowCode)

            @Example(T("4. Dropdowns e menus", "4. Dropdowns and menus"),
                T("shadow-lg para menus dropdown.", "shadow-lg for dropdown menus."),
                DropdownShadowPreview(), DropdownShadowCode)

            @Example(T("5. Tooltips", "5. Tooltips"),
                T("shadow para tooltips.", "shadow for tooltips."),
                TooltipShadowPreview(), TooltipShadowCode)

            @Example(T("6. Dark mode", "6. Dark mode"),
                T("Sombras se adaptam ao tema escuro.", "Shadows adapt to dark theme."),
                DarkModeShadowPreview(), DarkModeShadowCode)

            @Example(T("7. Hierarquia de camadas", "7. Layer hierarchy"),
                T("Combinação de sombras para pilha de overlays.", "Combined shadows for overlay stack."),
                LayerHierarchyPreview(), LayerHierarchyCode)
        </XFStack>

        @* ==================== 13. API ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        @* ==================== 14. ACCESSIBILITY & KEYBOARD ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Navegação enterprise por teclado", "Enterprise Keyboard Navigation"), @<div>@TileGrid(EnterpriseKeyboardItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        @* ==================== 15. RESPONSIVENESS & PERFORMANCE ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        @* ==================== 16. ENTERPRISE SCENARIOS & PATTERNS ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenários enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padrões de composição", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas práticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padrões", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        @* ==================== 17. TOKENS, THEMING, SECURITY, TESTING ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("Design Tokens", @<div>@NameValueTable(TokenRows, "Token", T("Propósito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Segurança", "Security Considerations"), @<div>@TileGrid(SecurityItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidência", "Evidence"))</div>)
        </XFStack>

        @* ==================== EXTRA ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Limitações conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitação", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Notas de migração", "Migration Notes"), @<div>@TileGrid(MigrationItems, 2)</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versão", "Version"), T("Mudança", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);

    private RenderFragment HeroPreview() => @<div class="grid grid-cols-2 md:grid-cols-4 gap-6 p-4">
        <div class="h-20 rounded-lg bg-bg-surface shadow-sm flex items-center justify-center"><span class="text-xs font-medium text-text-secondary">shadow-sm</span></div>
        <div class="h-20 rounded-lg bg-bg-surface shadow flex items-center justify-center"><span class="text-xs font-medium text-text-secondary">shadow</span></div>
        <div class="h-20 rounded-lg bg-bg-surface shadow-md flex items-center justify-center"><span class="text-xs font-medium text-text-secondary">shadow-md</span></div>
        <div class="h-20 rounded-lg bg-bg-surface shadow-lg flex items-center justify-center"><span class="text-xs font-medium text-text-secondary">shadow-lg</span></div>
    </div>;

    private RenderFragment ShadowScalePreview() => @<div class="grid grid-cols-2 md:grid-cols-5 gap-4 p-2">
        <div class="h-16 rounded-lg bg-bg-surface shadow-sm flex items-center justify-center"><span class="text-[10px] font-medium">sm</span></div>
        <div class="h-16 rounded-lg bg-bg-surface shadow flex items-center justify-center"><span class="text-[10px] font-medium">shadow</span></div>
        <div class="h-16 rounded-lg bg-bg-surface shadow-md flex items-center justify-center"><span class="text-[10px] font-medium">md</span></div>
        <div class="h-16 rounded-lg bg-bg-surface shadow-lg flex items-center justify-center"><span class="text-[10px] font-medium">lg</span></div>
        <div class="h-16 rounded-lg bg-bg-surface shadow-xl flex items-center justify-center"><span class="text-[10px] font-medium">xl</span></div>
    </div>;

    private RenderFragment CardShadowPreview() => @<div class="grid grid-cols-3 gap-4">
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFTypography Variant="XFTypographyVariant.Caption">Filled (shadow-sm)</XFTypography></ChildContent></XFCard>
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg"><ChildContent><XFTypography Variant="XFTypographyVariant.Caption">Outlined (none)</XFTypography></ChildContent></XFCard>
        <div class="rounded-lg bg-bg-surface shadow-lg p-4"><XFTypography Variant="XFTypographyVariant.Caption">Elevado (shadow-lg)</XFTypography></div>
    </div>;

    private RenderFragment OverlayShadowPreview() => @<div class="relative rounded-lg bg-bg-surface shadow-xl p-6">
        <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">Modal / Drawer</XFTypography>
        <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">shadow-xl</XFTypography>
    </div>;

    private RenderFragment DropdownShadowPreview() => @<div class="rounded-lg bg-bg-surface shadow-lg p-4 max-w-xs">
        <XFTypography Variant="XFTypographyVariant.Caption">Dropdown (shadow-lg)</XFTypography>
        <div class="mt-2 space-y-1"><div class="rounded px-2 py-1 text-xs text-text-secondary hover:bg-surface-50">Opção 1</div><div class="rounded px-2 py-1 text-xs text-text-secondary hover:bg-surface-50">Opção 2</div></div>
    </div>;

    private RenderFragment TooltipShadowPreview() => @<div class="rounded-lg bg-surface-900 text-white shadow p-3 max-w-[12rem]">
        <XFTypography Variant="XFTypographyVariant.Caption" Class="text-white">Tooltip (shadow)</XFTypography>
    </div>;

    private RenderFragment DarkModeShadowPreview() => @<XFStack Orientation="XFOrientation.Horizontal" Gap="4" Wrap="XFWrap.Wrap">
        <div class="rounded-lg bg-bg-surface shadow-sm p-3"><XFTypography Variant="XFTypographyVariant.Caption">Light: shadow-sm</XFTypography></div>
        <div class="rounded-lg bg-surface-800 text-white shadow-lg p-3"><XFTypography Variant="XFTypographyVariant.Caption" Class="text-white">Dark: shadow-lg</XFTypography></div>
    </XFStack>;

    private RenderFragment LayerHierarchyPreview() => @<div class="relative p-8">
        <div class="rounded-lg bg-bg-surface shadow-sm p-4 absolute top-0 left-0 w-48"><XFTypography Variant="XFTypographyVariant.Caption">Base (shadow-sm)</XFTypography></div>
        <div class="rounded-lg bg-bg-surface shadow-md p-4 absolute top-4 left-4 w-44"><XFTypography Variant="XFTypographyVariant.Caption">Card (shadow-md)</XFTypography></div>
        <div class="rounded-lg bg-bg-surface shadow-xl p-4 absolute top-8 left-8 w-40"><XFTypography Variant="XFTypographyVariant.Caption">Modal (shadow-xl)</XFTypography></div>
    </div>;

    private RenderFragment Section(string title, RenderFragment content) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg"><Header><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography></Header><ChildContent>@content</ChildContent></XFCard>;
    private string CopyableCodeTitle => T("Código copiável", "Copyable code");
    private RenderFragment Example(string title, string description, RenderFragment preview, string codeText) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.None" AreaRestricted="false"><Header><div class="px-6 pt-6"><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@description</XFTypography></div></Header><ChildContent><div class="grid"><div class="border-t border-border-light p-6">@preview</div><div class="border-t border-border-light bg-surface-50 p-6"><XFCode Text="@codeText" Language="razor" Title="@CopyableCodeTitle" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" /></div></div></ChildContent></XFCard>;
    private RenderFragment Tile(DocTile item) => @<XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true"><div class="flex items-center gap-4"><span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-primary/10 bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span><div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div></div><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography></XFStack></ChildContent></XFCard>;
    private RenderFragment TileGrid(IReadOnlyList<DocTile> items, int columns) => @<XFGrid Cols="1" Md="@Math.Min(columns, 2)" Lg="@columns" Gap="4">@foreach (var item in items) { @Tile(item) }</XFGrid>;
    private RenderFragment WarningGrid(IReadOnlyList<DocTile> items) => @<XFGrid Cols="1" Md="2" Gap="4">@foreach (var item in items) { <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true"><div class="flex items-center gap-4"><span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-danger/10 bg-danger/10 text-danger" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span><div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div></div><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography></XFStack></ChildContent></XFCard> }</XFGrid>;
    private RenderFragment NameValueTable(IReadOnlyList<NameValueRow> rows, string nameHeader, string valueHeader) => @<XFTable Striped="true" Hoverable="true" Compact="true"><XFTableHeader><XFTableRow><XFTableCell Header="true">@nameHeader</XFTableCell><XFTableCell Header="true">@valueHeader</XFTableCell></XFTableRow></XFTableHeader><XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Value</XFTableCell></XFTableRow> }</XFTableBody></XFTable>;
    private RenderFragment ApiTable(IReadOnlyList<ApiRow> rows) => @<XFTable Striped="true" Hoverable="true" Compact="true"><XFTableHeader><XFTableRow><XFTableCell Header="true">Token</XFTableCell><XFTableCell Header="true">@T("Uso", "Usage")</XFTableCell><XFTableCell Header="true">@T("Componentes", "Components")</XFTableCell></XFTableRow></XFTableHeader><XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Type</XFTableCell><XFTableCell>@row.Description</XFTableCell></XFTableRow> }</XFTableBody></XFTable>;

    private string ShadowScaleCode => @"<div class=""shadow-sm"">shadow-sm</div>
<div class=""shadow"">shadow</div>
<div class=""shadow-md"">shadow-md</div>
<div class=""shadow-lg"">shadow-lg</div>
<div class=""shadow-xl"">shadow-xl</div>";

    private string CardShadowCode => @"<XFCard Variant=""XFCardVariant.Filled"">Card suave (shadow-sm)</XFCard>
<XFCard Variant=""XFCardVariant.Outlined"">Card sem sombra</XFCard>
<div class=""shadow-lg"">Card elevado (shadow-lg)</div>";

    private string OverlayShadowCode => @"<!-- Modais e drawers usam shadow-xl internamente -->
<div class=""shadow-xl"">Modal / Drawer</div>";

    private string DropdownShadowCode => @"<div class=""shadow-lg"">
    <div>Opção 1</div>
    <div>Opção 2</div>
</div>";

    private string TooltipShadowCode => @"<div class=""bg-surface-900 text-white shadow"">
    Tooltip com shadow
</div>";

    private string DarkModeShadowCode => @"<!-- Light mode -->
<div class=""shadow-sm"">Sombra suave</div>

<!-- Dark mode: sombras mais fortes para contraste -->
<div class=""shadow-lg"">Sombra forte</div>";

    private string LayerHierarchyCode => @"<!-- Pilha de overlays com sombras crescentes -->
<div class=""shadow-sm"">Base</div>
<div class=""shadow-md"">Card</div>
<div class=""shadow-xl"">Modal</div>";

    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("5 níveis", "5 levels"), T("De shadow-sm a shadow-xl.", "From shadow-sm to shadow-xl."), "layer-group"),
        new(T("Overlays", "Overlays"), T("Modais, drawers e dropdowns.", "Modals, drawers and dropdowns."), "window-restore"),
        new(T("Dark mode", "Dark mode"), T("Sombras se adaptam ao tema.", "Shadows adapt to theme."), "moon")
    ];

    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Category", T("Design Tokens / Sombras", "Design Tokens / Shadows")),
        new("Package", "XForge.DesignSystem"),
        new("Status", T("Estável", "Stable"))
    ];

    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("Elevação", "Elevation"), T("5 níveis de profundidade visual.", "5 levels of visual depth."), "layer-group"),
        new(T("Hierarquia", "Hierarchy"), T("Sombras organizam camadas de UI.", "Shadows organize UI layers."), "table-cells"),
        new(T("Profundidade", "Depth"), T("Mais sombra = mais acima na pilha.", "More shadow = higher in the stack."), "arrow-down")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Profundidade", "Depth"), T("Indicar que um elemento está acima de outro.", "Indicate one element is above another."), "layer-group"),
        new(T("Foco modal", "Modal focus"), T("Sombra forte indica conteúdo sobreposto.", "Strong shadow indicates overlaid content."), "eye"),
        new(T("Hierarquia visual", "Visual hierarchy"), T("Ordenar camadas de sobreposição.", "Order overlay layers."), "table-cells")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Sombras hardcoded inconsistentes.", "Inconsistent hardcoded shadows."), "xmark"),
        new(T("Depois", "After"), T("Níveis padronizados de elevação.", "Standardized elevation levels."), "check")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Cards", "Cards"), T("shadow-sm para cards de superfície.", "shadow-sm for surface cards."), "square"),
        new(T("Modais", "Modals"), T("shadow-xl para modais e drawers.", "shadow-xl for modals and drawers."), "window-restore"),
        new(T("Dropdowns", "Dropdowns"), T("shadow-lg para menus dropdown.", "shadow-lg for dropdown menus."), "list-dropdown"),
        new(T("Tooltips", "Tooltips"), T("shadow para tooltips.", "shadow for tooltips."), "message")
