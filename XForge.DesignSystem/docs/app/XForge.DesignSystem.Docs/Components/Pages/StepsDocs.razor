@page "/navigation/steps"
@page "/components/steps"
@using XForge.DesignSystem.Components.Navigation.Steps
@using XForge.DesignSystem.Components.Button
@using XForge.DesignSystem.Services
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">

        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFSteps" />
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFWizard" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Orientação", "Orientation")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("5 estados", "5 states")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Acessível", "Accessible")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Indicador de progresso por etapas para onboarding, checkout e workflows guiados.",
                               "Step progress indicator for onboarding, checkout and guided workflows.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("XFSteps exibe o progresso de um fluxo sequencial com marcadores numéricos, ícones, conectores e estados visuais. XFWizard combina XFSteps com navegação entre painéis, validação e sequência livre.",
                               "XFSteps displays sequential flow progress with numeric markers, icons, connectors and visual states. XFWizard combines XFSteps with panel navigation, validation and free sequence.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts)
                            {
                                @Tile(item)
                            }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        <!-- ===== METADATA ===== -->
        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        <!-- ===== BLAZOR COMPAT ===== -->
        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observações", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições. Layout puramente CSS.", "Works without restrictions. Purely CSS layout.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições em ambos os estágios.", "Works without restrictions in both stages.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Parcial", "Partial")" /></XFTableCell><XFTableCell>@T("Renderiza HTML base. Interações do Wizard requerem modo interativo.", "Renders base HTML. Wizard interactions require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependências JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente não utiliza JavaScript interop. É puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderização.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
            </XFStack>
        </div>)

        <!-- ===== OVERVIEW / PURPOSE / WHEN TO USE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visão geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Propósito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando não usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
        </XFStack>

        <!-- ===== DESIGN ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Hierarquia visual", "Visual Hierarchy"), @<div>@TileGrid(VisualHierarchyItems, 3)</div>)
            @Section(T("Princípios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 10 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Horizontal básico", "1. Basic horizontal"),
                T("XFSteps com 4 etapas em orientação horizontal. Estados mistos: Complete, Current e Pending.",
                 "XFSteps with 4 steps in horizontal orientation. Mixed states: Complete, Current and Pending."),
                ExHorizontalBasic(), CodeHorizontalBasic)

            @Example(T("2. Vertical", "2. Vertical"),
                T("XFSteps em orientação vertical com conectores verticais entre etapas.",
                 "XFSteps in vertical orientation with vertical connectors between steps."),
                ExVertical(), CodeVertical)

            @Example(T("3. Tamanhos", "3. Sizes"),
                T("Três instâncias lado a lado com Sm, Md e Lg. O tamanho afeta marcadores, texto e espaçamento.",
                 "Three side-by-side instances with Sm, Md and Lg. Size affects markers, text and spacing."),
                ExSizes(), CodeSizes)

            @Example(T("4. Variantes de container", "4. Container variants"),
                T("Plain (sem fundo), Soft (fundo sutil) e Surface (borda + sombra) para diferentes contextos visuais.",
                 "Plain (no background), Soft (subtle background) and Surface (border + shadow) for different visual contexts."),
                ExVariants(), CodeVariants)

            @Example(T("5. Todos os estados", "5. All states"),
                T("Demonstração dos 5 estados: Pending, Current, Complete, Error e Disabled com seus visuais distintos.",
                 "Demonstration of all 5 states: Pending, Current, Complete, Error and Disabled with distinct visuals."),
                ExAllStates(), CodeAllStates)

            @Example(T("6. Ícones customizados", "6. Custom icons"),
                T("XFStepItemModel com propriedade Icon para exibir ícones SVG personalizados em vez de números.",
                 "XFStepItemModel with Icon property to display custom SVG icons instead of numbers."),
                ExCustomIcons(), CodeCustomIcons)

            @Example(T("7. Com descrição", "7. With description"),
                T("Cada etapa com Label e Description para contexto adicional abaixo do marcador.",
                 "Each step with Label and Description for additional context below the marker."),
                ExWithDescription(), CodeWithDescription)

            @Example(T("8. Wizard básico", "8. Basic wizard"),
                T("XFWizard com XFWizardStep para navegação entre painéis com botões Anterior/Próximo.",
                 "XFWizard with XFWizardStep for panel navigation with Previous/Next buttons."),
                ExWizardBasic(), CodeWizardBasic)

            @Example(T("9. Wizard com validação", "9. Wizard with validation"),
                T("XFWizard com CanChange para validação condicional antes de avançar etapas.",
                 "XFWizard with CanChange for conditional validation before advancing steps."),
                ExWizardValidation(), CodeWizardValidation)

            @Example(T("10. Wizard sequência livre", "10. Wizard free sequence"),
                T("XFWizard com Sequence=Free para navegação livre entre todas as etapas visitadas.",
                 "XFWizard with Sequence=Free for free navigation between all visited steps."),
                ExWizardFree(), CodeWizardFree)

            @Example(T("11. Steps interativo", "11. Interactive steps"),
                T("XFSteps com StepClick para navegação interativa. Clique numa etapa para ver o callback.",
                 "XFSteps with StepClick for interactive navigation. Click a step to see the callback."),
                ExInteractiveSteps(), CodeInteractiveSteps)

            @Example(T("12. Wizard com botões personalizados", "12. Wizard with custom buttons"),
                T("XFWizard com PreviousText, NextText e FinishText para customizar os botões de ação sem ActionsTemplate.",
                 "XFWizard with PreviousText, NextText and FinishText to customize action buttons without ActionsTemplate."),
                ExWizardCustomButtons(), CodeWizardCustomButtons)

            @Example(T("13. Steps com ItemTemplate", "13. Steps with ItemTemplate"),
                T("XFSteps com ItemTemplate para customizar completamente o marcador de cada etapa.",
                 "XFSteps with ItemTemplate to fully customize each step's marker."),
                ExItemTemplate(), CodeItemTemplate)
        </XFStack>

        <!-- ===== VARIANTS / STATES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Variantes", "Variants"), @<div>@NameValueTable(VariantRows, T("Variante", "Variant"), T("Descrição", "Description"))</div>)
            @Section(T("Estados", "States"), @<div>@NameValueTable(StateRows, T("Estado", "State"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <!-- ===== API ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API: XFSteps", @<div>@ApiTable(StepsApiRows)</div>)
            @Section("API: XFStepItemModel", @<div>@ApiTable(StepItemApiRows)</div>)
            @Section("API: XFWizard", @<div>@ApiTable(WizardApiRows)</div>)
            @Section("API: XFWizardStep", @<div>@ApiTable(WizardStepApiRows)</div>)
            @Section("API: XFStepClickEventArgs", @<div>@ApiTable(StepClickEventArgsApiRows)</div>)
            @Section("API: XFStepContext", @<div>@ApiTable(StepContextApiRows)</div>)
        </XFStack>

        <!-- ===== EVENTS ===== -->
        @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Descrição", "Description"))</div>)

        <!-- ===== CONNECTORS ===== -->
        @Section(T("Conectores", "Connectors"), @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">
                    @T("Conectores ligam marcadores entre si indicando progresso. A cor muda quando a etapa anterior é Complete.",
                       "Connectors link markers indicating progress. Color changes when the previous step is Complete.")
                </XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Orientação", "Orientation")</XFTableCell><XFTableCell Header="true">@T("Comportamento", "Behavior")</XFTableCell><XFTableCell Header="true">@T("Responsivo", "Responsive")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell>Horizontal</XFTableCell><XFTableCell>@T("Linha horizontal entre marcadores. Visível apenas em sm+.", "Horizontal line between markers. Visible only on sm+.")</XFTableCell><XFTableCell>@T("Oculta em mobile (hidden sm:block).", "Hidden on mobile (hidden sm:block).")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell>Vertical</XFTableCell><XFTableCell>@T("Linha vertical entre marcadores. Sempre visível.", "Vertical line between markers. Always visible.")</XFTableCell><XFTableCell>@T("Sempre visível.", "Always visible.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
            </XFStack>
        </div>)

        <!-- ===== ACCESSIBILITY ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 3)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Ação", "Action"))</div>)
        </XFStack>

        <!-- ===== RESPONSIVENESS / PERFORMANCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 3)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 3)</div>)
        </XFStack>

        <!-- ===== ENTERPRISE / COMPOSITION / BEST PRACTICES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenários enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padrões de composição", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas práticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padrões", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <!-- ===== TOKENS / THEMES / SECURITY / TESTING ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("Design Tokens", @<div>@NameValueTable(TokenRows, T("Categoria", "Category"), T("Tokens", "Tokens"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Segurança", "Security"), @<div>@TileGrid(SecurityItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestRows, T("Tipo", "Type"), T("Cobertura", "Coverage"))</div>)
        </XFStack>

        <!-- ===== LIMITATIONS / MIGRATION / RELATED / FAQ / CHANGELOG ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Limitações conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitação", "Limitation"), T("Detalhe", "Detail"))</div>)
            @Section(T("Notas de migração", "Migration Notes"), @<div>@TileGrid(MigrationItems, 2)</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, "Version", T("Mudança", "Change"))</div>)
        </XFStack>

    </XFStack>
</XForgeDocsShell>

@code {
    private string ProductLabelText => "Core OSS";
    private string PageTitleText => "Steps & Wizard";
    private string PageStatusText => "Premium";
    private string T(string pt, string en) => LanguageService.Text(pt, en);

    // ==================== HERO PREVIEW ====================
    private RenderFragment HeroPreview() => @<XFSteps Items="@HeroItems" Size="XFSize.Lg" />;

    private static readonly IReadOnlyList<XFStepItemModel> HeroItems = [
        new() { Label = "Dados", Status = XFStepStatus.Complete },
        new() { Label = "Endereço", Status = XFStepStatus.Complete },
        new() { Label = "Pagamento", Status = XFStepStatus.Current },
        new() { Label = "Confirmação", Status = XFStepStatus.Pending }
    ];

    // ==================== QUICK FACTS ====================
    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("5 estados", "5 states"), T("Pending, Current, Complete, Error e Disabled com visuais distintos.", "Pending, Current, Complete, Error and Disabled with distinct visuals."), "circle-half-stroke"),
        new(T("Orientação dupla", "Dual orientation"), T("Horizontal com conectores ou Vertical com conectores verticais.", "Horizontal with connectors or Vertical with vertical connectors."), "arrows-left-right"),
        new(T("3 tamanhos", "3 sizes"), T("Sm (28px), Md (32px) e Lg (40px) para diferentes contextos.", "Sm (28px), Md (32px) and Lg (40px) for different contexts."), "sliders"),
        new(T("Ícones custom", "Custom icons"), T("RenderFragment Icon no XFStepItemModel para SVGs personalizados.", "RenderFragment Icon on XFStepItemModel for custom SVGs."), "image"),
        new(T("Wizard integrado", "Built-in wizard"), T("XFWizard combina Steps com navegação, validação e sequência.", "XFWizard combines Steps with navigation, validation and sequence."), "wand-magic-sparkles")
    ];

    // ==================== METADATA ====================
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFSteps / XFWizard"),
        new("Namespace", "XForge.DesignSystem.Components.Navigation.Steps"),
        new("Package", "XForge.DesignSystem"),
        new("Category", "Navigation / Steps"),
        new("Status", T("Estável", "Stable")),
        new("Accessibility", T("aria-current, aria-disabled, aria-label com formato customizável.", "aria-current, aria-disabled, aria-label with customizable format.")),
        new("Theme support", T("Light e dark via CSS variables.", "Light and dark via CSS variables."))
    ];

    // ==================== OVERVIEW ====================
    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("Marcador visual", "Visual marker"), T("Círculo com número, ícone ou check que indica o estado de cada etapa.", "Circle with number, icon or check indicating each step's state."), "circle-half-stroke"),
        new(T("Conectores", "Connectors"), T("Linhas horizontais ou verticais ligam etapas indicando progresso.", "Horizontal or vertical lines connecting steps indicating progress."), "arrows-left-right"),
        new(T("Estados ricos", "Rich states"), T("5 estados visuais com cores, bordas e anéis distintos.", "5 visual states with distinct colors, borders and rings."), "palette")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Progresso sequencial", "Sequential progress"), T("Indicar em qual etapa o usuário está em um fluxo guiado.", "Indicate which step the user is in a guided flow."), "route"),
        new(T("Onboarding", "Onboarding"), T("Guiar novos usuários através de cadastros e configurações.", "Guide new users through registrations and settings."), "user-plus"),
        new(T("Checkout", "Checkout"), T("Fluxo de compra com etapas de dados, pagamento e confirmação.", "Purchase flow with data, payment and confirmation steps."), "cart-shopping")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Listas numeradas sem visuais, sem estados e sem conectores.", "Numbered lists without visuals, states or connectors."), "xmark"),
        new(T("Depois", "After"), T("Componente visual com marcadores, conectores e estados semânticos.", "Visual component with markers, connectors and semantic states."), "check"),
        new(T("Risco reduzido", "Reduced risk"), T("Estados visuais evitam confusão sobre progresso do fluxo.", "Visual states prevent confusion about flow progress."), "shield-check")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Checkout", "Checkout"), T("Fluxo de compra: Dados → Endereço → Pagamento → Confirmação.", "Purchase flow: Data → Address → Payment → Confirmation."), "cart-shopping"),
        new(T("Onboarding", "Onboarding"), T("Cadastro de usuário: Perfil → Preferências → Verificação → Confirmação.", "User registration: Profile → Preferences → Verification → Confirmation."), "user-plus"),
        new(T("Wizard", "Wizard"), T("Assistente multi-etapa com navegação, validação e botões de ação.", "Multi-step assistant with navigation, validation and action buttons."), "wand-magic-sparkles")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Fluxos paralelos", "Parallel flows"), T("XFSteps é sequencial. Para fluxos paralelos, use abas ou cards.", "XFSteps is sequential. For parallel flows, use tabs or cards."), "xmark"),
        new(T("Muitas etapas", "Too many steps"), T("Mais de 7 etapas confundem o usuário. Considere agrupar.", "More than 7 steps confuse the user. Consider grouping."), "triangle-exclamation"),
        new(T("Navegação lateral", "Side navigation"), T("Steps não substitui menus ou navegação por rota.", "Steps does not replace menus or route navigation."), "route")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new("nav", T("Elemento raiz com aria-label para leitores de tela.", "Root element with aria-label for screen readers."), "code"),
        new("ol > li", T("Lista ordenada com item por etapa. aria-current na etapa atual.", "Ordered list with one item per step. aria-current on current step."), "list-ol"),
        new(T("Marcador", "Marker"), T("Círculo com número, ícone, check ou alerta. Tamanho varia com Size.", "Circle with number, icon, check or alert. Size varies with Size."), "circle-half-stroke"),
        new(T("Conector", "Connector"), T("Linha entre marcadores. Cor muda quando etapa anterior é Complete.", "Line between markers. Color changes when previous step is Complete."), "minus"),
        new(T("Texto", "Text"), T("Label (negrito) e Description (opcional, muted) abaixo do marcador.", "Label (bold) and Description (optional, muted) below the marker."), "font"),
        new("XFWizardStep", T("Container de conteúdo do Wizard com label, ícone e ChildContent.", "Wizard content container with label, icon and ChildContent."), "wand-magic-sparkles")
    ];

    // ==================== DESIGN ====================
    private IReadOnlyList<DocTile> VisualHierarchyItems => [
        new(T("Marcador primário", "Primary marker"), T("Círculo maior com cor do estado é o elemento visual mais forte.", "Larger circle with state color is the strongest visual element."), "circle-half-stroke"),
        new(T("Conector secundário", "Secondary connector"), T("Linha fina entre marcadores indica progresso sem competir.", "Thin line between markers indicates progress without competing."), "minus"),
        new(T("Texto terciário", "Tertiary text"), T("Label e Description ficam abaixo, com peso visual menor.", "Label and Description sit below with lower visual weight."), "font")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(T("Clareza", "Clarity"), T("Estado visualmente distinto: Complete=preenchido, Current=anel, Error=perigo.", "Visually distinct state: Complete=filled, Current=ring, Error=danger."), "circle-check"),
        new(T("Consistência", "Consistency"), T("Mesmos tokens de cor e tamanho em todas as instâncias.", "Same color and size tokens across all instances."), "arrows-rotate"),
        new(T("Acessibilidade", "Accessibility"), T("aria-current, aria-disabled e aria-label garantem suporte a leitores.", "aria-current, aria-disabled and aria-label ensure screen reader support."), "universal-access")
    ];

    // ==================== EXAMPLE 1: HORIZONTAL BASIC ====================
    private static readonly IReadOnlyList<XFStepItemModel> BasicItems = [
        new() { Label = "Dados", Description = "Informações básicas", Status = XFStepStatus.Complete },
        new() { Label = "Endereço", Description = "Localização", Status = XFStepStatus.Current },
        new() { Label = "Pagamento", Description = "Financeiro", Status = XFStepStatus.Pending },
        new() { Label = "Confirmação", Description = "Revisão final", Status = XFStepStatus.Pending }
    ];

    private RenderFragment ExHorizontalBasic() => @<XFSteps Items="@BasicItems" />;

    private const string CodeHorizontalBasic = @"<XFSteps Items=""@StepItems"" />

@code {
    private static readonly IReadOnlyList<XFStepItemModel> StepItems = [
        new() { Label = ""Dados"", Description = ""Informações básicas"", Status = XFStepStatus.Complete },
        new() { Label = ""Endereço"", Description = ""Localização"", Status = XFStepStatus.Current },
        new() { Label = ""Pagamento"", Description = ""Financeiro"", Status = XFStepStatus.Pending },
        new() { Label = ""Confirmação"", Description = ""Revisão final"", Status = XFStepStatus.Pending }
    ];
}";

    // ==================== EXAMPLE 2: VERTICAL ====================
    private RenderFragment ExVertical() => @<XFSteps Items="@BasicItems" Orientation="XFOrientation.Vertical" />;

