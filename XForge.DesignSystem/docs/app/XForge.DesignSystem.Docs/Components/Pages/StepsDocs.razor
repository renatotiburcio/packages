    private static readonly IReadOnlyList<XFStepItemModel> StepItems = [
        new() { Label = ""Documentos"", Status = XFStepStatus.Complete },
        new() { Label = ""Identidade"", Status = XFStepStatus.Current },
        new() { Label = ""Pagamento"", Status = XFStepStatus.Pending },
        new() { Label = ""Confirmação"", Status = XFStepStatus.Pending }
    ];

    private RenderFragment EnterpriseMarker(XFStepContext ctx) =>
        @<span class=""inline-flex items-center justify-center"">
            @if (ctx.IsComplete)
            {
                @((MarkupString)XFSvgIcons.MarkupWithSize(""circle-check"", 16))
            }
            else if (ctx.IsCurrent)
            {
                @((MarkupString)XFSvgIcons.MarkupWithSize(""spinner"", 16))
            }
            else if (ctx.IsError)
            {
                @((MarkupString)XFSvgIcons.MarkupWithSize(""triangle-exclamation"", 16))
            }
            else
            {
                @((MarkupString)XFSvgIcons.MarkupWithSize(""circle"", 16))
            }
        </span>;

    private RenderFragment ProgressMarker(XFStepContext ctx) =>
        @<span class=""inline-flex items-center gap-1"">
            <span class=""text-xs font-mono text-text-muted"">@(ctx.Index + 1)/@(ctx.Total)</span>
            @if (ctx.IsComplete)
            {
                <span class=""inline-flex h-4 w-4 items-center justify-center rounded-full bg-primary text-[10px] font-bold text-primary-contrast"">&#10003;</span>
            }
            else if (ctx.IsCurrent)
            {
                <span class=""inline-flex h-4 w-4 items-center justify-center rounded-full border-2 border-primary text-[10px] font-bold text-primary"">@(ctx.Index + 1)</span>
            }
            else if (ctx.IsError)
            {
                <span class=""inline-flex h-4 w-4 items-center justify-center rounded-full border-2 border-danger text-[10px] font-bold text-danger"">!</span>
            }
            else
            {
                <span class=""inline-flex h-4 w-4 items-center justify-center rounded-full border border-border-light text-[10px] text-text-muted"">@(ctx.Index + 1)</span>
            }
        </span>;
}";

