            <XFTypography Variant="XFTypographyVariant.Body2" Weight="XFTypographyWeight.Semibold">@T("MarkerTemplate — ícones XFSvgIcons por status", "MarkerTemplate — XFSvgIcons icons by status")</XFTypography>
