{
  "name": "xforge-rabbitmq",
  "version": "1.0.0",
  "description": "MCP server for RabbitMQ message broker access",
  "type": "stdio",
  "command": "npx",
  "args": ["-y", "@modelcontextprotocol/server-rabbitmq"],
  "env": {
    "RABBITMQ_URL": "env:RABBITMQ_URL",
    "RABBITMQ_MANAGEMENT_URL": "env:RABBITMQ_MANAGEMENT_URL"
  },
  "capabilities": {
    "tools": [
      {
        "name": "list_queues",
        "description": "List all queues in RabbitMQ"
      },
      {
        "name": "publish_message",
        "description": "Publish a message to a queue"
      },
      {
        "name": "consume_messages",
        "description": "Consume messages from a queue"
      },
      {
        "name": "queue_status",
        "description": "Get status of a specific queue"
      }
    ]
  }
}
