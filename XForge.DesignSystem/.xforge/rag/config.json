{
  "version": "1.1.0",
  "mode": "local",
  "embedding": {
    "provider": "ollama",
    "model": "nomic-embed-text",
    "baseUrl": "http://localhost:11434",
    "dimensions": 768,
    "fallback": "cloud"
  },
  "chunk": {
    "maxLines": 40,
    "overlapLines": 5
  },
  "sources": [
    ".xforge/knowledge",
    ".xforge/engineer",
    ".kilo/commands",
    ".kilo/skills",
    ".kilo/agents",
    ".kilo/rules",
    "AGENTS.md",
    "README.md",
    ".xforge/docs/INSTALL.md"
  ],
  "excludePatterns": [
    ".git",
    ".engineer-backups",
    ".engineer-restore-temp",
    ".engineer-restore-review",
    "node_modules",
    "bin",
    "obj",
    "coverage",
    "TestResults",
    ".env",
    "secrets",
    ".pfx",
    ".pem",
    ".key",
    ".sql",
    ".bak",
    "old"
  ]
}