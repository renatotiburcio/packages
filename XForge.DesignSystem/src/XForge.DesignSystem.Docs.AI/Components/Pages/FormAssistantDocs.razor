@page "/ai/form-assistant"
@using XForge.DesignSystem.Components.AI.Forms
@using XForge.DesignSystem.Services.AI
@inject XForgeDocsLanguageService L

<XForgeDocsShell ProductLabel="AI Commercial"
                 Title="XFAiFormAssistant"
                 Status="@L.Text("Estavel", "Stable")"
                 Items="XForgeDocsCatalog.AiItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFAiFormAssistant" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Preenchimento", "Autofill")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Receita Federal", "Receita Federal")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Assistente para preenchimento, validacao e correcao de formularios complexos.",
                               "Assistant for filling, validating and correcting complex forms.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("Componente de assistencia IA para formularios de ERP com preenchimento automatico via Receita Federal, CEP, CNPJ, correcao de erros e deteccao de inconsistencias.",
                               "AI form assistant for ERP forms with automatic filling via Receita Federal, CEP, CNPJ, error correction and inconsistency detection.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        <!-- ===== METADATA ===== -->
        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        <!-- ===== BLAZOR COMPAT ===== -->
        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Assistencia completa com IA via provider.", "Full assistance with AI via provider.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona com provider compativel.", "Works with compatible provider.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Limitado", "Limited")" /></XFTableCell><XFTableCell>@T("IA indisponivel. Exibe estado vazio.", "AI unavailable. Shows empty state.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
            </XFStack>
        </div>)

        <!-- ===== CONTENT SECTIONS ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Assistente basico", "1. Basic Assistant"), T("Assistente com titulo, placeholder e header.", "Assistant with title, placeholder and header."), ExBasic(), Code1)
            @Example(T("2. Sem header", "2. Without Header"), T("Assistente compacto sem barra de cabecalho.", "Compact assistant without header bar."), ExNoHeader(), Code2)
            @Example(T("3. Com resultado customizado", "3. Custom Result"), T("Resultado de analise customizado via ResultPreview.", "Custom analysis result via ResultPreview."), ExCustomResult(), Code3)
            @Example(T("4. Conteudo vazio customizado", "4. Custom Empty Content"), T("Estado vazio customizado via EmptyContent.", "Custom empty state via EmptyContent."), ExEmpty(), Code4)
            @Example(T("5. Assistente enterprise", "5. Enterprise Assistant"), T("Assistente com titulo corporativo e placeholder detalhado.", "Assistant with corporate title and detailed placeholder."), ExEnterprise(), Code5)
        </XFStack>

        <!-- ===== API + EVENTS ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Metodos", "Methods"), @<div>@NameValueTable(MethodRows, T("Metodo", "Method"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <!-- ===== ACCESSIBILITY + PERFORMANCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <!-- ===== ENTERPRISE + COMPOSITION ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <!-- ===== TOKENS + THEMING ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("Design Tokens", @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>

<XForgeDocsPageStandard ComponentName="FormAssistantDocs" />

@code {
    private string T(string pt, string en) => L.Text(pt, en);

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiFormAssistant Title="@T("Assistente de cadastro", "Registration assistant")"
                          Placeholder="@T("O que falta para concluir este cadastro?", "What is missing to complete this registration?")"
                          ShowHeader="true" />
    </XFStack>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("Preenchimento IA", "AI Autofill"), T("Sugestoes automaticas via Receita Federal, CEP e CNPJ.", "Automatic suggestions via Receita Federal, CEP and CNPJ."), "wand-magic-sparkles"),
        new(T("Validacao", "Validation"), T("Correcao de erros e regras de preenchimento.", "Error correction and filling rules."), "shield-check"),
        new(T("Inconsistencias", "Inconsistencies"), T("Deteccao de campos contraditorios com severidade.", "Contradictory field detection with severity."), "triangle-exclamation")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFAiFormAssistant"),
        new("Namespace", "XForge.DesignSystem.Components.AI.Forms"),
        new("Package", "XForge.DesignSystem.AI"),
        new("Category", "AI / Forms"),
        new("Status", T("Estavel", "Stable")),
        new("Accessibility", "role=region, aria-label, aria-busy, aria-live=polite"),
        new("Theme support", T("Light e dark via tokens CSS.", "Light and dark via CSS tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("Assistente IA", "AI Assistant"), T("Preenchimento inteligente de formularios de ERP.", "Smart filling of ERP forms."), "wand-magic-sparkles"),
        new(T("Validacao", "Validation"), T("Correcao automatica de erros e regras de negocio.", "Automatic error correction and business rules."), "shield-check"),
        new(T("Inconsistencias", "Inconsistencies"), T("Deteccao de campos contraditorios entre si.", "Detection of contradictory fields."), "triangle-exclamation")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Automatizar preenchimento", "Automate filling"), T("Sugestoes via Receita Federal, CEP e CNPJ.", "Suggestions via Receita Federal, CEP and CNPJ."), "robot"),
        new(T("Validar dados", "Validate data"), T("Regras de validacao automatica com correcoes.", "Automatic validation rules with corrections."), "shield-check"),
        new(T("Detectar erros", "Detect errors"), T("Identificacao de inconsistencias entre campos.", "Identification of inconsistencies between fields."), "triangle-exclamation")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Preenchimento manual de formularios longos e propenso a erros.", "Manual filling of long and error-prone forms."), "xmark"),
        new(T("Depois", "After"), T("IA preenche e valida automaticamente com integracao governamental.", "AI fills and validates automatically with government integration."), "check"),
        new(T("Eficiencia", "Efficiency"), T("Reducao de tempo de preenchimento em ate 70%.", "Reduces filling time by up to 70%."), "bolt")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Cadastro de clientes", "Customer registration"), T("Preenchimento assistido de dados cadastrais.", "Assisted filling of registration data."), "user"),
        new(T("Formularios fiscais", "Tax forms"), T("Validacao de CNPJ, IE e inscricoes estaduais.", "CNPJ, IE and state registration validation."), "file-invoice")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Formularios simples", "Simple forms"), T("Use XFTextInput para campos unicos.", "Use XFTextInput for single fields."), "pen"),
        new(T("Notificacoes", "Notifications"), T("Use XFToast para alertas pontuais.", "Use XFToast for one-time alerts."), "bell")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new(T("Header", "Header"), T("Barra superior com titulo e icone de sparkles.", "Top bar with title and sparkles icon."), "bars"),
        new(T("Input", "Input"), T("Textarea com placeholder e botao de assistencia.", "Textarea with placeholder and assistance button."), "pen"),
        new(T("Resultado", "Result"), T("Area de resultado com sugestoes e correcoes.", "Result area with suggestions and corrections."), "chart-bar"),
        new(T("Erro", "Error"), T("Banner de erro com mensagem e botao dispensar.", "Error banner with message and dismiss button."), "triangle-exclamation"),
        new(T("Loading", "Loading"), T("Skeleton de carregamento durante processamento IA.", "Loading skeleton during AI processing."), "spinner"),
        new(T("Vazio", "Empty"), T("Estado vazio com icone e texto explicativo.", "Empty state with icon and explanatory text."), "inbox")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(T("Integracao governamental", "Government integration"), T("Consulta direta a Receita Federal, CEP e CNPJ.", "Direct consultation to Receita Federal, CEP and CNPJ."), "building"),
        new(T("Feedback visual", "Visual feedback"), T("Skeleton durante IA, banner de erro, estado vazio.", "Skeleton during AI, error banner, empty state."), "circle-check"),
        new(T("Extensibilidade", "Extensibility"), T("Templates para resultado, header e vazio.", "Templates for result, header and empty."), "puzzle")
    ];

    // === EXAMPLES ===
    private RenderFragment ExBasic() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiFormAssistant Title="@T("Assistente de cadastro", "Registration assistant")"
                          Placeholder="@T("O que falta para concluir este cadastro?", "What is missing to complete this registration?")"
                          ShowHeader="true" />
    </XFStack>;

    private RenderFragment ExNoHeader() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiFormAssistant Title="@T("Assistente", "Assistant")"
                          Placeholder="@T("Pergunte sobre preenchimento...", "Ask about filling...")"
                          ShowHeader="false" />
    </XFStack>;

    private RenderFragment ExCustomResult() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiFormAssistant Title="@T("Assistente customizado", "Custom assistant")"
                          Placeholder="@T("Envie dados do formulario para analise...", "Send form data for analysis...")"
                          ShowHeader="true"
                          ResultPreview="CustomResultPreview" />
    </XFStack>;

    private RenderFragment ExEmpty() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiFormAssistant Title="@T("Assistente", "Assistant")"
                          Placeholder="@T("Descreva o formulario...", "Describe the form...")"
                          ShowHeader="true"
                          EmptyContent="@CustomEmptyContent" />
    </XFStack>;

    private RenderFragment ExEnterprise() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiFormAssistant Title="@T("Assistente de Cadastro ERP", "ERP Registration Assistant")"
                          Placeholder="@T("Pergunte sobre preenchimento automatico, validacao, correcao ou importacao de dados de clientes, fornecedores e produtos.", "Ask about automatic filling, validation, correction or data import for customers, suppliers and products.")"
                          ShowHeader="true" />
    </XFStack>;

    private RenderFragment CustomResultPreview(XFAiFormInsight result) => @<div class="space-y-3">
        <div class="rounded-lg bg-primary/5 px-3 py-2.5 ring-1 ring-primary/10">
            <div class="flex items-start gap-2">
                <span class="inline-flex h-4 w-4 shrink-0 items-center justify-center text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize("sparkles", 16))</span>
                <p class="text-sm leading-5 text-text-primary">@result.AiSummary</p>
            </div>
        </div>
        @if (result.AutofillSuggestions is { Count: > 0 })
        {
            <div>
                <div class="mb-1.5 text-xs font-semibold uppercase tracking-wider text-text-muted">@T("Sugestoes", "Suggestions")</div>
                <div class="space-y-1">
                    @foreach (var s in result.AutofillSuggestions)
                    {
                        <div class="flex items-center justify-between rounded-md bg-emerald-50 px-3 py-2 text-xs ring-1 ring-emerald-200">
                            <div><span class="font-medium text-emerald-800">@s.FieldLabel</span>: <span class="text-emerald-700">@s.SuggestedValue</span></div>
                            <span class="text-emerald-600 text-[10px]">@s.Source</span>
                        </div>
                    }
                </div>
            </div>
        }
    </div>;

    private RenderFragment CustomEmptyContent => @<div class="flex flex-col items-center gap-3 py-8">
        <div class="inline-flex h-16 w-16 items-center justify-center rounded-full bg-primary/10 text-primary">
            @((MarkupString)XFSvgIcons.MarkupWithSize("wand-magic-sparkles", 32))
        </div>
        <div class="text-center">
            <div class="text-sm font-semibold text-text-primary">@T("Assistente de Formularios", "Form Assistant")</div>
            <div class="mt-1 text-xs text-text-secondary max-w-xs">@T("Pergunte sobre preenchimento automatico, validacao ou correcao de formulario.", "Ask about automatic filling, validation or form correction.")</div>
        </div>
    </div>;

    private const string Code1 = @"<XFAiFormAssistant Title=""Assistente de cadastro""
                      Placeholder=""O que falta para concluir este cadastro?""
                      ShowHeader=""true"" />";

    private const string Code2 = @"<XFAiFormAssistant Title=""Assistente""
                      Placeholder=""Pergunte sobre preenchimento...""
                      ShowHeader=""false"" />";

    private const string Code3 = @"<XFAiFormAssistant Title=""Assistente customizado""
                      Placeholder=""Envie dados do formulario para analise...""
                      ShowHeader=""true""
                      ResultPreview=""@CustomResultPreview"" />";

    private const string Code4 = @"<XFAiFormAssistant Title=""Assistente""
                      Placeholder=""Descreva o formulario...""
                      ShowHeader=""true""
                      EmptyContent=""@CustomEmptyContent"" />";

    private const string Code5 = @"<XFAiFormAssistant Title=""Assistente de Cadastro ERP""
                      Placeholder=""Pergunte sobre preenchimento automatico, validacao, correcao ou importacao de dados de clientes, fornecedores e produtos.""
                      ShowHeader=""true"" />";

    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("Provider", "IAiProvider?", "null", T("Provider IA para analise de formularios.", "AI provider for form analysis.")),
        new("Title", "string", T("'Assistente de Formularios'", "'Form Assistant'"), T("Titulo exibido no header.", "Title displayed in header.")),
        new("Placeholder", "string", T("'Pergunte sobre preenchimento...'", "'Ask about filling...'"), T("Texto do placeholder do textarea.", "Textarea placeholder text.")),
        new("ShowHeader", "bool", "true", T("Exibe barra de cabecalho.", "Shows header bar.")),
        new("Loading", "bool", "false", T("Forca estado de carregamento externo.", "Forces external loading state.")),
        new("SystemPrompt", "string?", "null", T("Prompt de sistema customizado para IA.", "Custom system prompt for AI.")),
        new("OnAnalysisComplete", "EventCallback<XFAiFormInsight>", "-", T("Dispara apos analise. Recebe resultado da analise.", "Fires after analysis. Receives analysis result.")),
        new("OnError", "EventCallback<string>", "-", T("Dispara em erro. Recebe mensagem de erro.", "Fires on error. Receives error message.")),
        new("ResultPreview", "RenderFragment<XFAiFormInsight>?", "null", T("Template customizado do resultado.", "Custom result template.")),
        new("HeaderContent", "RenderFragment?", "null", T("Conteudo customizado do cabecalho.", "Custom header content.")),
        new("EmptyContent", "RenderFragment?", "null", T("Conteudo do estado vazio.", "Empty state content."))
    ];

    private IReadOnlyList<NameValueRow> EventRows => [
        new("OnAnalysisComplete", T("Dispara quando analise e concluida. Recebe XFAiFormInsight.", "Fires when analysis is completed. Receives XFAiFormInsight.")),
        new("OnError", T("Dispara em erro de IA ou parsing. Recebe string com mensagem.", "Fires on AI or parsing error. Receives string with message."))
    ];

    private IReadOnlyList<NameValueRow> MethodRows => [
        new("AnalyzeAsync()", T("Inicia analise com o provider IA. Chamado automaticamente ao enviar.", "Starts analysis with AI provider. Called automatically on submit.")),
        new("Clear()", T("Limpa resultado, erro e query. Reseta componente.", "Clears result, error and query. Resets component."))
    ];

    // === ACCESSIBILITY ===
    private IReadOnlyList<DocTile> AccessibilityItems => [
        new(T("role=region", "role=region"), T("Container principal com aria-label descritivo.", "Main container with descriptive aria-label."), "universal-access"),
        new(T("aria-busy", "aria-busy"), T("Indica estado de analise em andamento.", "Indicates analysis in progress state."), "spinner"),
        new(T("aria-live=polite", "aria-live=polite"), T("Resultado anunciado a leitores de tela.", "Result announced to screen readers."), "volume-high"),
        new(T("aria-label", "aria-label"), T("Labels em textarea e botoes de acao.", "Labels on textarea and action buttons."), "tag")
    ];

    private IReadOnlyList<NameValueRow> KeyboardRows => [
        new("Enter", T("Inicia analise.", "Starts analysis.")),
        new("Shift+Enter", T("Insere nova linha na query.", "Inserts newline in query.")),
        new("Escape", T("Limpa query e erro.", "Clears query and error."))
    ];

    // === RESPONSIVENESS ===
    private IReadOnlyList<DocTile> ResponsivenessItems => [
        new(T("Container flex", "Flex container"), T("Largura total com overflow controlado.", "Full width with controlled overflow."), "maximize"),
        new(T("Responsivo", "Responsive"), T("Se adapta a qualquer largura de container.", "Adapts to any container width."), "mobile-screen")
    ];

    // === PERFORMANCE ===
    private IReadOnlyList<DocTile> PerformanceItems => [
        new(T("Streaming IA", "AI Streaming"), T("Respostas recebidas sob demanda via provider.", "Responses received on demand via provider."), "bolt"),
        new(T("Cancelamento", "Cancellation"), T("CancellationTokenSource para cancelar requisicoes pendentes.", "CancellationTokenSource to cancel pending requests."), "stop")
    ];

    // === SCENARIOS ===
    private IReadOnlyList<DocTile> ScenarioItems => [
        new(T("Cadastro de clientes", "Customer registration"), T("Preenchimento assistido com integracao Receita Federal.", "Assisted filling with Receita Federal integration."), "user"),
        new(T("Formulario fiscal", "Tax form"), T("Validacao de CNPJ, IE e dados tributarios.", "CNPJ, IE and tax data validation."), "file-invoice"),
        new(T("Cadastro de fornecedores", "Supplier registration"), T("Importacao e validacao de dados via CNPJ.", "Data import and validation via CNPJ."), "building")
    ];

    // === COMPOSITION ===
    private IReadOnlyList<DocTile> CompositionItems => [
        new(T("Provider + Assistant", "Provider + Assistant"), T("Conecte com Ollama, OpenAI ou Gemini para IA real.", "Connect with Ollama, OpenAI or Gemini for real AI."), "plug"),
        new(T("Assistant + ResultPreview", "Assistant + ResultPreview"), T("Customize a exibicao do resultado de analise.", "Customize the analysis result display."), "puzzle"),
        new(T("Assistant + EmptyContent", "Assistant + EmptyContent"), T("Defina estado vazio personalizado.", "Define custom empty state."), "inbox")
    ];

    // === BEST PRACTICES ===
    private IReadOnlyList<DocTile> BestPracticeItems => [
        new(T("Provider obrigatorio", "Provider required"), T("Sem provider, o componente apenas documenta a API.", "Without provider, the component only documents the API."), "plug"),
        new(T("SystemPrompt customizado", "Custom SystemPrompt"), T("Defina o formato JSON esperado para resultados consistentes.", "Define expected JSON format for consistent results."), "terminal"),
        new(T("Tratamento de erros", "Error handling"), T("Sempre trate OnError para exibir feedback ao usuario.", "Always handle OnError to display feedback to user."), "shield-check"),
        new(T("Integracao governamental", "Government integration"), T("Configure SystemPrompt para consultas a Receita Federal e CEP.", "Configure SystemPrompt for Receita Federal and CEP queries."), "building")
    ];

    // === ANTI-PATTERNS ===
