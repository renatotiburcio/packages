@page "/ai/agent-personality"
@inject XForgeDocsLanguageService L

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.AiItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFAiAgentPersonality" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@L.Text("6 tons, 9 expertises, 3 secoes", "6 tones, 9 expertises, 3 sections")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @L.Text("Configuracao de tom, papel e comportamento de agentes comerciais.",
                               "Configuration of tone, role and behavior of commercial agents.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @L.Text("Exibe identidade do agente com avatar, tom de voz, dominio de expertise, greeting e suggested prompts. Integra com XFAiAvatar para representacao visual.",
                               "Displays agent identity with avatar, voice tone, expertise domain, greeting and suggested prompts. Integrates with XFAiAvatar for visual representation.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(L.Text("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, L.Text("Campo", "Field"), L.Text("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@L.Text("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@L.Text("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@L.Text("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@L.Text("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Renderiza como HTML estatico.", "Renders as static HTML.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@L.Text("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@L.Text("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(L.Text("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(L.Text("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(L.Text("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(L.Text("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(L.Text("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(L.Text("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 3 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(L.Text("1. Personalidade completa", "1. Full Personality"), L.Text("Personalidade com avatar, tom, expertise e prompts sugeridos.", "Personality with avatar, tone, expertise and suggested prompts."), ExFull(), Code1)
            @Example(L.Text("2. Sem header", "2. Without Header"), L.Text("Personalidade minimalista sem header, apenas greeting.", "Minimalist personality without header, just greeting."), ExMinimal(), Code2)
            @Example(L.Text("3. Custom header", "3. Custom Header"), L.Text("Personalidade com header customizado via HeaderContent.", "Personality with custom header via HeaderContent."), ExCustomHeader(), Code3)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(L.Text("Eventos", "Events"), @<div>@NameValueTable(EventRows, L.Text("Evento", "Event"), L.Text("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(L.Text("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, L.Text("Tecla", "Key"), L.Text("Comportamento", "Behavior"))</div>)
            @Section(L.Text("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(L.Text("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(L.Text("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(L.Text("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(L.Text("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", L.Text("Proposito", "Purpose"))</div>)
            @Section(L.Text("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(L.Text("Testes", "Testing"), @<div>@NameValueTable(TestingRows, L.Text("Cobertura", "Coverage"), L.Text("Evidencia", "Evidence"))</div>)
            @Section(L.Text("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, L.Text("Limitacao", "Limitation"), L.Text("Status", "Status"))</div>)
            @Section(L.Text("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, L.Text("Pergunta", "Question"), L.Text("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, L.Text("Versao", "Version"), L.Text("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string ProductLabelText => L.Text("AI Commercial", "AI Commercial");
    private string PageTitleText => L.Text("XFAiAgentPersonality", "XFAiAgentPersonality");
    private string PageStatusText => L.Text("Documentacao completa", "Complete docs");
    private string CopyableCodeTitle => L.Text("Codigo copiavel", "Copyable code");

    private XFAiAgentPersonalityConfig CreateSamplePersonality() => new()
    {
        Name = "Assistente Fiscal",
        Description = "Especialista em NF-e e obrigatoriedades fiscais",
        Tone = XFAiAgentTone.Formal,
        Expertise = XFAiAgentExpertise.Fiscal,
        IconName = "shield-halved",
        AvatarColor = "bg-violet-500",
        AvatarTextColor = "text-white",
        Greeting = "Ola! Sou o assistente fiscal. Como posso ajudar com suas NF-e hoje?",
        SuggestedPrompts = ["Validar NF-e", "Consultar status", "Gerar relatorio fiscal"],
        AllowToolCalling = true,
        Temperature = 0.3
    };

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiAgentPersonality Personality="@CreateSamplePersonality()" ShowSuggestedPrompts="true" />
    </XFStack>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(L.Text("6 tons de voz", "6 voice tones"), L.Text("Formal, Friendly, Concise, Detailed, Empathetic, Custom.", "Formal, Friendly, Concise, Detailed, Empathetic, Custom."), "volume-high"),
        new(L.Text("9 dominios", "9 domains"), L.Text("General, Finance, Fiscal, Stock, HR, Legal, IT, Sales, Custom.", "General, Finance, Fiscal, Stock, HR, Legal, IT, Sales, Custom."), "building"),
        new(L.Text("Zero JS", "Zero JS"), L.Text("Nenhum JavaScript interop. Puro C# + Tailwind.", "No JavaScript interop. Pure C# + Tailwind."), "bolt")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFAiAgentPersonality"),
        new("Namespace", "XForge.DesignSystem.Components.AI.Avatars"),
        new("Package", "XForge.DesignSystem.AI"),
        new("Category", "AI / Avatars"),
        new("Status", L.Text("Estavel", "Stable")),
        new("Accessibility", L.Text("role=region, aria-label, aria-busy.", "role=region, aria-label, aria-busy.")),
        new("Theme support", L.Text("Light, dark e data-theme via tokens.", "Light, dark and data-theme via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(L.Text("Personalidade AI", "AI personality"), L.Text("Configuracao visual de tom, papel e comportamento do agente.", "Visual configuration of agent tone, role and behavior."), "robot"),
        new(L.Text("Integracao com Avatar", "Avatar integration"), L.Text("Exibe XFAiAvatar com nome, description e status.", "Displays XFAiAvatar with name, description and status."), "user"),
        new(L.Text("Suggested prompts", "Suggested prompts"), L.Text("Botoes de prompts sugeridos para guiar o usuario.", "Suggested prompt buttons to guide the user."), "message")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(L.Text("Identidade de agente", "Agent identity"), L.Text("Definir personalidade unica para cada assistente AI.", "Define unique personality for each AI assistant."), "fingerprint"),
        new(L.Text("Tom de voz", "Voice tone"), L.Text("Formal, amigavel, conciso, detalhado, empatico ou custom.", "Formal, friendly, concise, detailed, empathetic or custom."), "volume-high"),
        new(L.Text("Guided interaction", "Guided interaction"), L.Text("Prompts sugeridos reduzem fricao do usuario.", "Suggested prompts reduce user friction."), "hand-pointer")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(L.Text("Antes", "Before"), L.Text("Agentes sem personalidade definida ou consistente.", "Agents without defined or consistent personality."), "xmark"),
        new(L.Text("Depois", "After"), L.Text("Personalidade visual completa com avatar, tom e expertise.", "Complete visual personality with avatar, tone and expertise."), "check"),
        new(L.Text("Acessibilidade", "Accessibility"), L.Text("role=region, aria-label, aria-busy para leitores de tela.", "role=region, aria-label, aria-busy for screen readers."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(L.Text("Chat AI", "AI chat"), L.Text("Personalidade do assistente no header do chat.", "Assistant personality in chat header."), "comments"),
        new(L.Text("Onboarding", "Onboarding"), L.Text("Apresentacao do agente para novos usuarios.", "Agent introduction for new users."), "handshake"),
        new(L.Text("Multi-agente", "Multi-agent"), L.Text("Personalidades distintas para agentes especializados.", "Distinct personalities for specialized agents."), "users")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(L.Text("Personalidade unica", "Single personality"), L.Text("Nao use para app com apenas um agente generico.", "Do not use for app with only one generic agent."), "robot"),
        new(L.Text("Custom system prompt", "Custom system prompt"), L.Text("SystemPrompt e para configuracao avancada, nao para uso direto.", "SystemPrompt is for advanced config, not direct use."), "terminal")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new("Avatar", L.Text("XFAiAvatar com nome e status do agente.", "XFAiAvatar with agent name and status."), "user"),
        new("Details", L.Text("Badges de tom de voz e dominio de expertise.", "Voice tone and expertise domain badges."), "tags"),
        new("Greeting", L.Text("Mensagem de boas-vindas do agente.", "Agent welcome message."), "comment"),
        new("Prompts", L.Text("Botoes de prompts sugeridos.", "Suggested prompt buttons."), "message")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(L.Text("Personalidade unica", "Unique personality"), L.Text("Cada agente deve ter uma identidade visual distinta.", "Each agent should have a distinct visual identity."), "fingerprint"),
        new(L.Text("Tom consistente", "Consistent tone"), L.Text("O tom de voz reflete o dominio de expertise.", "Voice tone reflects expertise domain."), "volume-high"),
        new(L.Text("Guided UX", "Guided UX"), L.Text("Prompts sugeridos reduzem fricao e aumentam adocao.", "Suggested prompts reduce friction and increase adoption."), "hand-pointer")
    ];

    // === EXAMPLES ===
    private RenderFragment ExFull() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiAgentPersonality Personality="@CreateSamplePersonality()" ShowSuggestedPrompts="true" />
    </XFStack>;

    private RenderFragment ExMinimal() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiAgentPersonality Title="Assistente IA" ShowHeader="false" ShowDetails="false" ShowSuggestedPrompts="false">
            <div class="text-sm text-text-secondary">Pode me ajudar com qualquer duvida sobre o sistema.</div>
        </XFAiAgentPersonality>
    </XFStack>;

    private RenderFragment ExCustomHeader() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiAgentPersonality Personality="@CreateSamplePersonality()">
            <HeaderContent>
                <span class="inline-flex items-center gap-1 rounded-full bg-green-50 px-2.5 py-0.5 text-xs font-medium text-green-700 dark:bg-green-900/20 dark:text-green-300">
                    Online
                </span>
            </HeaderContent>
        </XFAiAgentPersonality>
    </XFStack>;

    private const string Code1 = @"<XFAiAgentPersonality Personality=""@personality"" ShowSuggestedPrompts=""true"" />";
    private const string Code2 = @"<XFAiAgentPersonality Title=""Assistente IA""
    ShowHeader=""false"" ShowDetails=""false"" ShowSuggestedPrompts=""false"">
    <div class=""text-sm text-text-secondary"">
        Pode me ajudar com qualquer duvida sobre o sistema.
    </div>
</XFAiAgentPersonality>";
    private const string Code3 = @"<XFAiAgentPersonality Personality=""@personality"">
    <HeaderContent>
        <span class=""inline-flex items-center gap-1 rounded-full bg-green-50 px-2.5 py-0.5 text-xs font-medium text-green-700"">
            Online
        </span>
    </HeaderContent>
</XFAiAgentPersonality>";

    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("Personality", "XFAiAgentPersonalityConfig?", "null", L.Text("Configuracao de personalidade do agente.", "Agent personality configuration.")),
        new("Title", "string", "\"Agente IA\"", L.Text("Titulo exibido quando Personality e null.", "Title shown when Personality is null.")),
        new("ShowHeader", "bool", "true", L.Text("Exibe header com avatar e nome.", "Shows header with avatar and name.")),
        new("ShowDetails", "bool", "true", L.Text("Exibe badges de tom e expertise.", "Shows tone and expertise badges.")),
        new("ShowGreeting", "bool", "true", L.Text("Exibe mensagem de boas-vindas.", "Shows welcome message.")),
        new("ShowSuggestedPrompts", "bool", "true", L.Text("Exibe botoes de prompts sugeridos.", "Shows suggested prompt buttons.")),
        new("AriaLabel", "string", "\"Personalidade do agente IA\"", L.Text("Label ARIA para leitores de tela.", "ARIA label for screen readers.")),
        new("HeaderContent", "RenderFragment?", "null", L.Text("Conteudo customizado no header.", "Custom content in header.")),
        new("ChildContent", "RenderFragment?", "null", L.Text("Conteudo customizado abaixo dos detalhes.", "Custom content below details."))
    ];

    private IReadOnlyList<NameValueRow> EventRows => [
        new("OnSuggestedPrompt", L.Text("Disparado quando um prompt sugerido e clicado.", "Fired when a suggested prompt is clicked."))
    ];

    // === ACCESSIBILITY ===
    private IReadOnlyList<DocTile> AccessibilityItems => [
        new(L.Text("role=region", "role=region"), L.Text("Componente usa role=region para leitores de tela.", "Component uses role=region for screen readers."), "universal-access"),
        new(L.Text("aria-label", "aria-label"), L.Text("Label descritivo da personalidade.", "Descriptive personality label."), "tag"),
        new(L.Text("aria-busy", "aria-busy"), L.Text("Indica estado de carregamento do agente.", "Indicates agent loading state."), "spinner"),
        new(L.Text("Botoes acessiveis", "Accessible buttons"), L.Text("Prompts sugeridos com aria-label e focus-visible.", "Suggested prompts with aria-label and focus-visible."), "keyboard")
    ];

    private IReadOnlyList<NameValueRow> KeyboardRows => [
        new("Tab", L.Text("Navega entre prompts sugeridos.", "Navigates between suggested prompts.")),
        new("Enter / Space", L.Text("Ativa o prompt sugerido clicado.", "Activates clicked suggested prompt."))
    ];

    // === RESPONSIVENESS ===
    private IReadOnlyList<DocTile> ResponsivenessItems => [
        new(L.Text("Largura total", "Full width"), L.Text("Componente ocupa 100% do container.", "Component occupies 100% of container."), "maximize"),
        new(L.Text("Prompts flexiveis", "Flexible prompts"), L.Text("Botoes de prompts fazem wrap em telas pequenas.", "Prompt buttons wrap on small screens."), "wrap")
    ];

    // === PERFORMANCE ===
    private IReadOnlyList<DocTile> PerformanceItems => [
        new(L.Text("Zero JS", "Zero JS"), L.Text("Nenhum JavaScript interop.", "No JavaScript interop."), "bolt"),
        new(L.Text("Render leve", "Light render"), L.Text("Tags div nativas sem wrappers.", "Native div tags without wrappers."), "feather")
    ];

    // === SCENARIOS ===
    private IReadOnlyList<DocTile> ScenarioItems => [
        new(L.Text("Assistente fiscal", "Fiscal assistant"), L.Text("Personalidade formal com expertise fiscal para NF-e.", "Formal personality with fiscal expertise for NF-e."), "shield-halved"),
        new(L.Text("Consultor comercial", "Sales consultant"), L.Text("Personalidade amigavel com expertise de vendas.", "Friendly personality with sales expertise."), "handshake"),
        new(L.Text("Suporte TI", "IT support"), L.Text("Personalidade concisa com expertise tecnica.", "Concise personality with technical expertise."), "wrench")
    ];

    // === COMPOSITION ===
    private IReadOnlyList<DocTile> CompositionItems => [
        new(L.Text("Personality + Chat", "Personality + Chat"), L.Text("Personalidade no header do chat AI.", "Personality in AI chat header."), "comments"),
        new(L.Text("Personality + Avatar", "Personality + Avatar"), L.Text("Avatar integrado via Personality.IconName.", "Avatar integrated via Personality.IconName."), "user"),
        new(L.Text("Personality + Sidebar", "Personality + Sidebar"), L.Text("Personalidade na barra lateral de agentes.", "Personality in agent sidebar."), "sidebar")
    ];

    // === BEST PRACTICES ===
    private IReadOnlyList<DocTile> BestPracticeItems => [
        new(L.Text("Tom = expertise", "Tone = expertise"), L.Text("Escolha tom que reflete o dominio do agente.", "Choose tone that reflects agent domain."), "volume-high"),
        new(L.Text("Prompts 3-5", "Prompts 3-5"), L.Text("Use 3-5 suggested prompts para guiar o usuario.", "Use 3-5 suggested prompts to guide user."), "message"),
        new(L.Text("Greeting personalizado", "Personalized greeting"), L.Text("Greeting unico para cada agente cria conexao.", "Unique greeting for each agent creates connection."), "comment"),
        new(L.Text("Avatar consistente", "Consistent avatar"), L.Text("Use XFAiAvatar com cores do dominio.", "Use XFAiAvatar with domain colors."), "user")
    ];

    // === ANTI-PATTERNS ===
    private IReadOnlyList<DocTile> AntiPatternItems => [
        new(L.Text("Sem personalidade", "No personality"), L.Text("Agentes genericos sem tom definido criam fricao.", "Generic agents without defined tone create friction."), "xmark"),
        new(L.Text("Muitos prompts", "Too many prompts"), L.Text("Mais de 5 prompts sugere overwhelming.", "More than 5 prompts suggests overwhelming."), "ban"),
        new(L.Text("Tom inconsistente", "Inconsistent tone"), L.Text("Tom Formal com Greeting informal confunde usuario.", "Formal tone with informal greeting confuses user."), "triangle-exclamation")
    ];

    // === TOKENS ===
    private IReadOnlyList<NameValueRow> TokenRows => [
        new("card", L.Text("rounded-lg border border-border-light bg-bg-surface shadow.", "rounded-lg border border-border-light bg-bg-surface shadow.")),
        new("badge-tone", L.Text("rounded-full bg-violet-50 px-2.5 py-0.5 text-xs.", "rounded-full bg-violet-50 px-2.5 py-0.5 text-xs.")),
        new("prompt-btn", L.Text("rounded-lg border border-border-light bg-bg-surface px-3 py-1.5 text-xs.", "rounded-lg border border-border-light bg-bg-surface px-3 py-1.5 text-xs."))
    ];

    // === THEMING ===
    private IReadOnlyList<DocTile> ThemeItems => [
        new("data-theme", L.Text("Tokens light/dark via CSS variables.", "Light/dark tokens via CSS variables."), "moon"),
        new("AvatarColor", L.Text("Cor do avatar customizavel via AvatarColor.", "Avatar color customizable via AvatarColor."), "swatchbook")
    ];

    // === TESTING ===
    private IReadOnlyList<NameValueRow> TestingRows => [
        new("Unit", L.Text("Testes de render, personality, show/hide, suggested prompts.", "Render, personality, show/hide, suggested prompts tests.")),
        new("Accessibility", L.Text("role=region, aria-label, aria-busy, keyboard navigation.", "role=region, aria-label, aria-busy, keyboard navigation."))
    ];

    // === LIMITATIONS ===
    private IReadOnlyList<NameValueRow> LimitationRows => [
        new("SystemPrompt", L.Text("SystemPrompt nao e renderizado. E apenas configuracao.", "SystemPrompt is not rendered. It is configuration only.")),
        new("Temperature", L.Text("Temperature e apenas metadata. Nao afeta renderizacao.", "Temperature is metadata only. Does not affect rendering."))
    ];

    // === RELATED ===
    private IReadOnlyList<DocTile> RelatedComponentItems => [
        new("XFAiAvatar", L.Text("Avatar visual do agente.", "Agent visual avatar."), "user"),
        new("XFAiChat", L.Text("Chat AI que usa personalidade.", "AI chat that uses personality."), "comments"),
        new("XFAiPromptBox", L.Text("Caixa de prompt integrada.", "Integrated prompt box."), "message")
    ];

    // === FAQ ===
    private IReadOnlyList<NameValueRow> FaqRows => [
        new(L.Text("Personality obrigatoria?", "Personality required?"), L.Text("Nao. Title e usado quando Personality e null.", "No. Title is used when Personality is null.")),
        new(L.Text("Como definir tom?", "How to set tone?"), L.Text("Defina Tone na XFAiAgentPersonalityConfig.", "Set Tone in XFAiAgentPersonalityConfig.")),
        new(L.Text("Funciona sem JS?", "Works without JS?"), L.Text("Sim. Nenhum JavaScript interop.", "Yes. No JavaScript interop."))
    ];

    // === CHANGELOG ===
    private IReadOnlyList<NameValueRow> ChangelogRows => [
        new("2026-06-10", L.Text("Componente criado com 6 tons e 9 expertises.", "Component created with 6 tones and 9 expertises.")),
        new("2026-06-12", L.Text("Documentacao completa no padrao AppShellDocs com 26 secoes.", "Complete docs in AppShellDocs pattern with 26 sections."))
    ];

    // === HELPERS ===
    private RenderFragment Section(string title, RenderFragment content) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
        <Header><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography></Header>
        <ChildContent>@content</ChildContent>
    </XFCard>;

    private RenderFragment Example(string title, string description, RenderFragment preview, string codeText) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.None" AreaRestricted="false">
        <Header><div class="px-6 pt-6 pb-2">
            <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@description</XFTypography>
        </div></Header>
        <ChildContent><div class="flex flex-col">
            <div class="border-t border-border-light p-6">@preview</div>
            <div class="border-t border-border-light bg-surface-50 p-6">
                <XFCode Text="@codeText" Language="razor" Title="@CopyableCodeTitle" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" />
            </div>
        </div></ChildContent>
    </XFCard>;

    private RenderFragment Tile(DocTile item) => @<XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent>
        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <div class="flex items-center gap-4">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-primary/10 bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                <div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div>
            </div>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
        </XFStack>
    </ChildContent></XFCard>;

    private RenderFragment TileGrid(IReadOnlyList<DocTile> items, int columns) => @<XFGrid Cols="1" Md="@Math.Min(columns, 2)" Lg="@columns" Gap="4">@foreach (var item in items) { @Tile(item) }</XFGrid>;

    private RenderFragment WarningGrid(IReadOnlyList<DocTile> items) => @<XFGrid Cols="1" Md="2" Gap="4">@foreach (var item in items) {
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <div class="flex items-center gap-4">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-danger/10 bg-danger/10 text-danger" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                <div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div>
            </div>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
        </XFStack></ChildContent></XFCard>
    }</XFGrid>;

    private RenderFragment NameValueTable(IReadOnlyList<NameValueRow> rows, string nameHeader, string valueHeader) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader><XFTableRow><XFTableCell Header="true">@nameHeader</XFTableCell><XFTableCell Header="true">@valueHeader</XFTableCell></XFTableRow></XFTableHeader>
        <XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Value</XFTableCell></XFTableRow> }</XFTableBody>
    </XFTable>;

    private RenderFragment ApiTable(IReadOnlyList<ApiRow> rows) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader><XFTableRow><XFTableCell Header="true">@L.Text("Parametro", "Parameter")</XFTableCell><XFTableCell Header="true">Type</XFTableCell><XFTableCell Header="true">Default</XFTableCell><XFTableCell Header="true">@L.Text("Descricao", "Description")</XFTableCell></XFTableRow></XFTableHeader>
        <XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Type</XFTableCell><XFTableCell><XFCode Text="@row.DefaultValue" /></XFTableCell><XFTableCell>@row.Description</XFTableCell></XFTableRow> }</XFTableBody>
    </XFTable>;

    // === RECORDS ===
    private sealed record DocTile(string Title, string Description, string Icon);
    private sealed record NameValueRow(string Name, string Value);
    private sealed record ApiRow(string Name, string Type, string DefaultValue, string Description);
}
