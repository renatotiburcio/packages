        new(L.Text("Render leve", "Light render"), L.Text("Atualizacoes parciais via StateHasChanged.", "Partial updates via StateHasChanged."), "feather")
    ];

    // === SCENARIOS ===
    private IReadOnlyList<DocTile> ScenarioItems => [
        new(L.Text("Estoque automatico", "Automatic stock"), L.Text("Alertas de estoque baixo e reposicao automatica.", "Low stock alerts and automatic replenishment."), "boxes-stacked"),
        new(L.Text("Aprovacoes", "Approvals"), L.Text("Regras de aprovacao baseadas em valor e categoria.", "Approval rules based on value and category."), "user-check"),
        new(L.Text("Integracao IA", "AI integration"), L.Text("Regras que chamam provedores de IA para decisao.", "Rules that call AI providers for decision."), "sparkles")
    ];

    // === COMPOSITION ===
    private IReadOnlyList<DocTile> CompositionItems => [
        new(L.Text("Rule + XFCard", "Rule + XFCard"), L.Text("Editor dentro de um card para contexto.", "Editor inside a card for context."), "square"),
        new(L.Text("Rule + Workflow", "Rule + Workflow"), L.Text("Regras que acionam workflows de automacao.", "Rules that trigger automation workflows."), "play"),
        new(L.Text("Rule + Toast", "Rule + Toast"), L.Text("Notificacoes via toast quando regra e executada.", "Notifications via toast when rule is executed."), "bell")
