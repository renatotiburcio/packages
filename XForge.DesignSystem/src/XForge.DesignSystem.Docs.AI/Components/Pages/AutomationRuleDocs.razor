@page "/ai/automation-rule"
@inject XForgeDocsLanguageService L

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.AiItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFAiAutomationRule" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@L.Text("Regras e automacao", "Rules and automation")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @L.Text("Editor visual de regras automatizadas com construtor de condicoes/acoes, suporte a IA e exibicao visual de regras para agentes e workflows.",
                                   "Visual editor for automated rules with condition/action builder, AI support and visual rule display for agents and workflows.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @L.Text("Componente de automacao com operadores condicionais, acoes tipadas, prioridade, habilitacao/desabilitacao e prompts de melhoria por IA. Puro Blazor, sem JavaScript interop.",
                                   "Automation component with conditional operators, typed actions, priority, enable/disable and AI enhancement prompts. Pure Blazor, no JavaScript interop.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(L.Text("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, L.Text("Campo", "Field"), L.Text("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@L.Text("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@L.Text("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@L.Text("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@L.Text("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Funciona sem restricoes. Renderizacao reativa.", "Works without restrictions. Reactive rendering.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Renderiza como HTML estatico.", "Renders as static HTML.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@L.Text("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@L.Text("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(L.Text("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(L.Text("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(L.Text("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(L.Text("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(L.Text("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(L.Text("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 3 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(L.Text("1. Regras ativas", "1. Active rules"), L.Text("Editor com regras ativas e condicoes complexas.", "Editor with active rules and complex conditions."), ExActiveRules(), Code1)
            @Example(L.Text("2. Sem regras", "2. No rules"), L.Text("Estado vazio com mensagem de orientacao.", "Empty state with guidance message."), ExEmpty(), Code2)
            @Example(L.Text("3. Regras com IA", "3. Rules with AI"), L.Text("Regras com prompts de melhoria por IA.", "Rules with AI enhancement prompts."), ExAiRules(), Code3)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(L.Text("Eventos", "Events"), @<div>@NameValueTable(EventRows, L.Text("Evento", "Event"), L.Text("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(L.Text("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, L.Text("Tecla", "Key"), L.Text("Comportamento", "Behavior"))</div>)
            @Section(L.Text("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(L.Text("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(L.Text("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(L.Text("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(L.Text("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", L.Text("Proposito", "Purpose"))</div>)
            @Section(L.Text("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(L.Text("Testes", "Testing"), @<div>@NameValueTable(TestingRows, L.Text("Cobertura", "Coverage"), L.Text("Evidencia", "Evidence"))</div>)
            @Section(L.Text("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, L.Text("Limitacao", "Limitation"), L.Text("Status", "Status"))</div>)
            @Section(L.Text("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, L.Text("Pergunta", "Question"), L.Text("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, L.Text("Versao", "Version"), L.Text("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string ProductLabelText => L.Text("AI Commercial", "AI Commercial");
    private string PageTitleText => L.Text("XFAiAutomationRule", "XFAiAutomationRule");
    private string PageStatusText => L.Text("Documentacao completa", "Complete docs");
    private string CopyableCodeTitle => L.Text("Codigo copiavel", "Copyable code");

    private static readonly IReadOnlyList<XFAiAutomationRuleItem> MockRules = new List<XFAiAutomationRuleItem>
    {
        new()
        {
            Name = "Alerta de estoque baixo",
            Description = "Notificar quando estoque estiver abaixo do minimo",
            Enabled = true,
            Priority = 1,
            Conditions = [new() { Field = "estoque_atual", Operator = XFAiConditionOperator.LessThan, Value = "10" }],
            LogicalOperator = XFAiLogicalOperator.And,
            Actions = [new() { Type = XFAiAutomationActionType.SendNotification, Description = "Enviar alerta para estoquista" }],
            ExecutionCount = 47
        },
        new()
        {
            Name = "Aprovacao de compras acima de R$5.000",
            Description = "Enviar para aprovacao gerencial compras de alto valor",
            Enabled = true,
            Priority = 2,
            Conditions = [
                new() { Field = "valor_total", Operator = XFAiConditionOperator.GreaterThan, Value = "5000" },
                new() { Field = "categoria", Operator = XFAiConditionOperator.Equals, Value = "compra" }
            ],
            LogicalOperator = XFAiLogicalOperator.And,
            Actions = [
                new() { Type = XFAiAutomationActionType.WaitForApproval, Description = "Aguardar aprovacao gerencial" },
                new() { Type = XFAiAutomationActionType.SendEmail, Description = "Notificar gerente por email" }
            ],
            ExecutionCount = 23
        },
        new()
        {
            Name = "Backup automatico",
            Description = "Executar backup a cada 6 horas",
            Enabled = false,
            Priority = 3,
            Conditions = [new() { Field = "hora", Operator = XFAiConditionOperator.Equals, Value = "0,6,12,18" }],
            Actions = [new() { Type = XFAiAutomationActionType.ExecuteWorkflow, Description = "Executar workflow de backup" }],
            ExecutionCount = 120,
            AiEnhancementPrompt = "Considerar intervalos adaptativos baseados em carga do sistema"
        }
    };

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiAutomationRule Rules="MockRules" Title="Regras de Automacao" />
    </XFStack>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(L.Text("SE/ENTAO visual", "SE/ENTAO visual"), L.Text("Construtor visual de condicoes e acoes.", "Visual condition and action builder."), "scale-balanced"),
        new(L.Text("11 operadores", "11 operators"), L.Text("Equals, NotEquals, Contains, GreaterThan, etc.", "Equals, NotEquals, Contains, GreaterThan, etc."), "code-branch"),
        new(L.Text("IA assistida", "AI-assisted"), L.Text("Prompts de melhoria por IA em regras.", "AI enhancement prompts in rules."), "sparkles")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFAiAutomationRule"),
        new("Namespace", "XForge.DesignSystem.Components.AI.Workflow"),
        new("Package", "XForge.DesignSystem.AI"),
        new("Category", "AI / Workflow"),
        new("Status", L.Text("Estavel", "Stable")),
        new("Accessibility", L.Text("role=region, aria-label, botoes com aria-label.", "role=region, aria-label, buttons with aria-label.")),
        new("Theme support", L.Text("Light, dark e data-theme via tokens.", "Light, dark and data-theme via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(L.Text("Regras de automacao", "Automation rules"), L.Text("Editor visual de condicoes SE/ENTAO.", "Visual SE/THEN condition editor."), "scale-balanced"),
        new(L.Text("Construtor condicional", "Conditional builder"), L.Text("Operadores logicos e comparacao.", "Logical and comparison operators."), "code-branch"),
        new(L.Text("Acoes tipadas", "Typed actions"), L.Text("8 tipos de acoes: notificacao, workflow, IA, etc.", "8 action types: notification, workflow, AI, etc."), "bolt")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(L.Text("Automacoes", "Automations"), L.Text("Criar regras para automatizar processos.", "Create rules to automate processes."), "robot"),
        new(L.Text("Validacoes", "Validations"), L.Text("Validar dados antes de processar.", "Validate data before processing."), "shield-check"),
        new(L.Text("Integracoes", "Integrations"), L.Text("Conectar sistemas via webhooks e emails.", "Connect systems via webhooks and emails."), "globe")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(L.Text("Antes", "Before"), L.Text("Logica de automacao hardcoded no codigo.", "Automation logic hardcoded in code."), "xmark"),
        new(L.Text("Depois", "After"), L.Text("Editor visual com condicoes e acoes configuraveis.", "Visual editor with configurable conditions and actions."), "check"),
        new(L.Text("Acessibilidade", "Accessibility"), L.Text("role=region, aria-label, estrutura semantica.", "role=region, aria-label, semantic structure."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(L.Text("Regras de negocio", "Business rules"), L.Text("Automacoes baseadas em condicoes de dados.", "Data-condition-based automations."), "scale-balanced"),
        new(L.Text("Integracoes", "Integrations"), L.Text("Conectar com sistemas externos.", "Connect with external systems."), "globe")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(L.Text("Logica complexa", "Complex logic"), L.Text("Para logica complexa, use workflows no backend.", "For complex logic, use backend workflows."), "server"),
        new(L.Text("Tempo real", "Real-time"), L.Text("Para eventos em tempo real, use SignalR.", "For real-time events, use SignalR."), "tower-broadcast")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new(L.Text("Header", "Header"), L.Text("Barra com titulo, contador de regras e botao Nova.", "Bar with title, rule count and New button."), "bars"),
        new(L.Text("Rule card", "Rule card"), L.Text("Cartao com nome, status, prioridade e badges IA.", "Card with name, status, priority and AI badges."), "square"),
        new(L.Text("Conditions", "Conditions"), L.Text("Visualizacao SE com operadores e valores.", "SE visualization with operators and values."), "code-branch"),
        new(L.Text("Actions", "Actions"), L.Text("Visualizacao ENTAO com icones e descricoes.", "THEN visualization with icons and descriptions."), "bolt")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(L.Text("Visual = claro", "Visual = clear"), L.Text("Condicoes e acoes visuais entendiveis.", "Conditions and actions visually understandable."), "eye"),
        new(L.Text("Prioridade", "Priority"), L.Text("Regras ordenadas por prioridade numerica.", "Rules ordered by numeric priority."), "arrow-down-wide-short"),
        new(L.Text("Flexibilidade", "Flexibility"), L.Text("11 operadores e 8 tipos de acoes.", "11 operators and 8 action types."), "sliders")
    ];

    // === EXAMPLES ===
    private RenderFragment ExActiveRules() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiAutomationRule Rules="MockRules" Title="Regras de Automacao" />
    </XFStack>;

    private RenderFragment ExEmpty() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiAutomationRule Title="Novo editor" />
    </XFStack>;

    private RenderFragment ExAiRules() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiAutomationRule Rules="AiRules" Title="Regras com IA" />
    </XFStack>;

    private static readonly IReadOnlyList<XFAiAutomationRuleItem> AiRules = new List<XFAiAutomationRuleItem>
    {
        new()
        {
            Name = "Classificacao inteligente de tickets",
            Description = "Usar IA para classificar tickets automaticamente",
            Enabled = true,
            Priority = 1,
            Conditions = [new() { Field = "tipo", Operator = XFAiConditionOperator.Equals, Value = "ticket" }],
            Actions = [new() { Type = XFAiAutomationActionType.CallAiProvider, Description = "Classificar com IA" }],
            AiEnhancementPrompt = "Usar modelo treinado com tickets historicos"
        },
        new()
        {
            Name = "Roteamento inteligente",
            Description = "Rotear para equipe correta baseado no conteudo",
            Enabled = true,
            Priority = 2,
            Conditions = [
                new() { Field = "departamento", Operator = XFAiConditionOperator.IsEmpty, Value = "" }
            ],
            Actions = [
                new() { Type = XFAiAutomationActionType.CallAiProvider, Description = "Detectar departamento" },
                new() { Type = XFAiAutomationActionType.UpdateField, Description = "Atualizar departamento" }
            ],
            AiEnhancementPrompt = "Incluir analise de sentimento para priorizacao"
        }
    };

    private const string Code1 = @"<XFAiAutomationRule Rules=""@_rules"" Title=""Regras de Automacao"" />";
    private const string Code2 = @"<XFAiAutomationRule Title=""Novo editor"" />";
    private const string Code3 = @"<XFAiAutomationRule Rules=""@_rules"" Title=""Regras com IA"" />";

    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("Rules", "IReadOnlyList<XFAiAutomationRuleItem>", "[]", L.Text("Lista de regras de automacao para exibir.", "List of automation rules to display.")),
        new("Title", "string", "\"Regras de Automacao\"", L.Text("Titulo do componente.", "Component title.")),
        new("AriaLabel", "string", "\"Regras de automacao\"", L.Text("Rotulo ARIA para acessibilidade.", "ARIA label for accessibility.")),
        new("ShowHeader", "bool", "true", L.Text("Exibe a barra de cabecalho.", "Shows the header bar.")),
        new("EmptyText", "string", "\"Nenhuma regra...\"", L.Text("Texto do estado vazio.", "Empty state text.")),
        new("EmptyContent", "RenderFragment?", "null", L.Text("Conteudo customizado para estado vazio.", "Custom empty state content."))
    ];

    private IReadOnlyList<NameValueRow> EventRows => [
        new("OnAddRule", L.Text("Disparado quando o usuario clica em Nova Regra.", "Fired when user clicks New Rule.")),
        new("OnRuleToggle", L.Text("Disparado quando uma regra e habilitada/desabilitada. Retorna XFAiAutomationRuleItem.", "Fired when a rule is enabled/disabled. Returns XFAiAutomationRuleItem.")),
        new("OnRuleEdit", L.Text("Disparado quando uma regra e selecionada para edicao. Retorna XFAiAutomationRuleItem.", "Fired when a rule is selected for editing. Returns XFAiAutomationRuleItem."))
    ];

    // === ACCESSIBILITY ===
    private IReadOnlyList<DocTile> AccessibilityItems => [
        new(L.Text("role=region", "role=region"), L.Text("Componente usa role=region para leitores de tela.", "Component uses role=region for screen readers."), "universal-access"),
        new(L.Text("aria-label", "aria-label"), L.Text("Labels descritivos em botoes e areas.", "Descriptive labels on buttons and areas."), "tag"),
        new(L.Text("Estrutura semantica", "Semantic structure"), L.Text("SE/ENTAO com labels visuais para leitores.", "SE/THEN with visual labels for readers."), "font"),
        new(L.Text("Botoes com aria-label", "Buttons with aria-label"), L.Text("Nova Regra com label descritivo.", "New Rule with descriptive label."), "keyboard")
    ];

    private IReadOnlyList<NameValueRow> KeyboardRows => [
        new("Tab", L.Text("Navega entre regras, condicoes, acoes e botoes.", "Navigates between rules, conditions, actions and buttons.")),
        new("Enter", L.Text("Ativa o botao focado ou seleciona regra.", "Activates focused button or selects rule.")),
        new("Space", L.Text("Ativa botoes de acao.", "Activates action buttons."))
    ];

    // === RESPONSIVENESS ===
    private IReadOnlyList<DocTile> ResponsivenessItems => [
        new(L.Text("Largura total", "Full width"), L.Text("Editor ocupa 100% do container.", "Editor occupies 100% of container."), "maximize"),
        new(L.Text("Condicoes flexiveis", "Flexible conditions"), L.Text("Tags de condicoes se wrapping em mobile.", "Condition tags wrap on mobile."), "mobile-screen")
    ];

