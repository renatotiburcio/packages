    private IReadOnlyList<NameValueRow> TokenRows => [
        new("rule-card", L.Text("border-l-4 px-4 py-3.", "border-l-4 px-4 py-3.")),
        new("condition-tag", L.Text("inline-flex items-center gap-1 rounded-md border px-2 py-0.5.", "inline-flex items-center gap-1 rounded-md border px-2 py-0.5.")),
        new("action-tag", L.Text("inline-flex items-center gap-1 rounded-md border px-2 py-0.5.", "inline-flex items-center gap-1 rounded-md border px-2 py-0.5."))
