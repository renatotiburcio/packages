@page "/ai/performance-monitor"
@using XForge.DesignSystem.Components.AI.Performance
@using XForge.DesignSystem.Core.Primitives
@inject XForgeDocsLanguageService L

<XForgeDocsShell ProductLabel="AI Commercial"
                 Title="@L.Text("Performance Monitor", "Performance Monitor")"
                 Status="@L.Text("Documentacao completa", "Complete docs")"
                 Items="XForgeDocsCatalog.AiItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFAiPerformanceMonitor" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@L.Text("Monitoramento em tempo real", "Real-time monitoring")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @L.Text("Monitor de performance em tempo real com metricas, sparklines, timeline e benchmarks.",
                                   "Real-time performance monitor with metrics, sparklines, timeline and benchmarks.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @L.Text("Rastreia tempo de render, exibe cards de metricas com cores de severidade, sparklines SVG, barras de timeline e resultados de benchmark contra thresholds configuraveis.",
                                   "Tracks render time, displays metric cards with severity colors, SVG sparklines, timeline bars and benchmark results against configurable thresholds.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(L.Text("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, L.Text("Campo", "Field"), L.Text("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@L.Text("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@L.Text("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@L.Text("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@L.Text("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@L.Text("Parcial", "Partial")" /></XFTableCell><XFTableCell>@L.Text("Renderiza sem interatividade.", "Renders without interactivity.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@L.Text("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@L.Text("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(L.Text("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(L.Text("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(L.Text("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(L.Text("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(L.Text("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(L.Text("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 6 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(L.Text("1. Basico", "1. Basic"), L.Text("Monitor com metricas e timeline.", "Monitor with metrics and timeline."), ExBasic(), Code1)
            @Example(L.Text("2. Sem Sparkline", "2. Without Sparkline"), L.Text("Metricas sem mini-graficos.", "Metrics without mini-charts."), ExNoSparkline(), Code2)
            @Example(L.Text("3. Apenas Timeline", "3. Timeline Only"), L.Text("Somente barras de timeline.", "Timeline bars only."), ExTimelineOnly(), Code3)
            @Example(L.Text("4. Com Benchmarks", "4. With Benchmarks"), L.Text("Resultado de benchmarks contra thresholds.", "Benchmark results against thresholds."), ExBenchmarks(), Code4)
            @Example(L.Text("5. Grid 2 Colunas", "5. Grid 2 Columns"), L.Text("Metricas em grid de 2 colunas.", "Metrics in 2-column grid."), ExGrid2Cols(), Code5)
            @Example(L.Text("6. Compacto", "6. Compact"), L.Text("Sem cabecalho, rodape ou metricas.", "Without header, footer or metrics."), ExCompact(), Code6)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(L.Text("Eventos", "Events"), @<div>@NameValueTable(EventRows, L.Text("Evento", "Event"), L.Text("Comportamento", "Behavior"))</div>)
            @Section(L.Text("Tipos", "Types"), @<div>@NameValueTable(TypeRows, L.Text("Tipo", "Type"), L.Text("Descricao", "Description"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(L.Text("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, L.Text("Tecla", "Key"), L.Text("Comportamento", "Behavior"))</div>)
            @Section(L.Text("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(L.Text("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(L.Text("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(L.Text("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(L.Text("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", L.Text("Proposito", "Purpose"))</div>)
            @Section(L.Text("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(L.Text("Testes", "Testing"), @<div>@NameValueTable(TestingRows, L.Text("Cobertura", "Coverage"), L.Text("Evidencia", "Evidence"))</div>)
            @Section(L.Text("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, L.Text("Limitacao", "Limitation"), L.Text("Status", "Status"))</div>)
            @Section(L.Text("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, L.Text("Pergunta", "Question"), L.Text("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, L.Text("Versao", "Version"), L.Text("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string T(string pt, string en) => L.Text(pt, en);
    private string CopyableCodeTitle => L.Text("Codigo copiavel", "Copyable code");

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFAiPerformanceMonitor
        Title="Performance Monitor"
        ShowHeader="true"
        ShowMetrics="true"
        ShowTimeline="true"
        ShowSparkline="true"
        ShowBenchmarks="true"
        GridCols="4"
        MaxRenderTimeMs="16" />;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(L.Text("Metricas em tempo real", "Real-time metrics"), L.Text("Cards de render time, sparklines e cores de severidade.", "Render time cards, sparklines and severity colors."), "gauge"),
        new(L.Text("Timeline visual", "Visual timeline"), L.Text("Barras de render time com cores semanticas.", "Render time bars with semantic colors."), "bars"),
        new(L.Text("Benchmarks", "Benchmarks"), L.Text("Comparacao contra thresholds configuraveis.", "Comparison against configurable thresholds."), "bullseye")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFAiPerformanceMonitor"),
        new("Namespace", "XForge.DesignSystem.Components.AI.Performance"),
        new("Package", "XForge.DesignSystem.AI"),
        new("Category", "AI / Performance"),
        new("Status", L.Text("Estavel", "Stable")),
        new("Accessibility", L.Text("role=region, aria-label, aria-live=polite.", "role=region, aria-label, aria-live=polite.")),
        new("Theme support", L.Text("Light, dark e data-brand via tokens.", "Light, dark and data-brand via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(L.Text("Monitor de performance", "Performance monitor"), L.Text("Rastreio de tempo de render em tempo real.", "Real-time render time tracking."), "gauge"),
        new(L.Text("Metricas com severidade", "Metrics with severity"), L.Text("Good, Warning e Critical com cores semanticas.", "Good, Warning and Critical with semantic colors."), "palette"),
        new(L.Text("Benchmarks", "Benchmarks"), L.Text("Comparacao contra thresholds configuraveis.", "Comparison against configurable thresholds."), "bullseye")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(L.Text("Debug de performance", "Performance debugging"), L.Text("Identificar componentes lentos em tempo real.", "Identify slow components in real time."), "bug"),
        new(L.Text("Monitoramento continuo", "Continuous monitoring"), L.Text("Rastrear regressao de performance ao longo do tempo.", "Track performance regression over time."), "eye"),
        new(L.Text("Benchmarks automatizados", "Automated benchmarks"), L.Text("Validar performance contra thresholds pre-definidos.", "Validate performance against pre-defined thresholds."), "check-double")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(L.Text("Antes", "Before"), L.Text("Sem visibilidade sobre performance de render.", "No visibility into render performance."), "xmark"),
        new(L.Text("Depois", "After"), L.Text("Metricas em tempo real com timeline e benchmarks.", "Real-time metrics with timeline and benchmarks."), "check"),
        new(L.Text("Acessibilidade", "Accessibility"), L.Text("role=region com aria-label e aria-live para updates.", "role=region with aria-label and aria-live for updates."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(L.Text("Debug de UI", "UI debugging"), L.Text("Identificar componentes que causam jank.", "Identify components causing jank."), "bug"),
        new(L.Text("Benchmarks de regressao", "Regression benchmarks"), L.Text("Validar que PRs nao degradam performance.", "Validate PRs don't degrade performance."), "check-double"),
        new(L.Text("Monitoramento de producao", "Production monitoring"), L.Text("Monitorar performance em ambientes reais.", "Monitor performance in real environments."), "eye")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(L.Text("Metricas de negocio", "Business metrics"), L.Text("Use dashboard especifico para KPIs.", "Use specific dashboard for KPIs."), "chart-line"),
        new(L.Text("Logging de erros", "Error logging"), L.Text("Use XFAiAuditTimeline para erros.", "Use XFAiAuditTimeline for errors."), "clipboard")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new("Header", L.Text("Titulo, badge de status e botao limpar.", "Title, status badge and clear button."), "heading"),
        new("Metric Cards", L.Text("Grid de cards com valor, unidade e sparkline SVG.", "Grid of cards with value, unit and SVG sparkline."), "chart-bar"),
        new("Timeline", L.Text("Barras verticais com tempo de render por snapshot.", "Vertical bars with render time per snapshot."), "bars"),
        new("Benchmarks", L.Text("Lista de resultados contra thresholds.", "List of results against thresholds."), "bullseye"),
        new("Footer", L.Text("Contagem de snapshots e modo de monitoramento.", "Snapshot count and monitoring mode."), "rectangle-list")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(L.Text("Zero JS", "Zero JS"), L.Text("Nenhum JavaScript interop. Puro C# + Tailwind.", "No JavaScript interop. Pure C# + Tailwind."), "bolt"),
        new(L.Text("Cor = severidade", "Color = severity"), L.Text("Green < 16ms, Yellow < 50ms, Red >= 50ms.", "Green < 16ms, Yellow < 50ms, Red >= 50ms."), "palette"),
        new(L.Text("Sparklines compactos", "Compact sparklines"), L.Text("Mini-graficos SVG para historico visual.", "SVG mini-charts for visual history."), "chart-line")
    ];

    // === EXAMPLES ===
    private RenderFragment ExBasic() => @<XFAiPerformanceMonitor
        Title="App Performance"
        ShowHeader="true"
        ShowMetrics="true"
        ShowTimeline="true"
        ShowSparkline="true"
        ShowBenchmarks="true"
        GridCols="4" />;

    private RenderFragment ExNoSparkline() => @<XFAiPerformanceMonitor
        Title="Sem Sparkline"
        ShowHeader="true"
        ShowMetrics="true"
        ShowTimeline="true"
        ShowSparkline="false"
        ShowBenchmarks="false"
        GridCols="3" />;

    private RenderFragment ExTimelineOnly() => @<XFAiPerformanceMonitor
        Title="Timeline"
        ShowHeader="true"
        ShowMetrics="false"
        ShowTimeline="true"
        ShowSparkline="false"
        ShowBenchmarks="false" />;

    private RenderFragment ExBenchmarks() => @<XFAiPerformanceMonitor
        Title="Benchmarks"
        ShowHeader="true"
        ShowMetrics="false"
        ShowTimeline="false"
        ShowSparkline="false"
        ShowBenchmarks="true" />;

    private RenderFragment ExGrid2Cols() => @<XFAiPerformanceMonitor
        Title="Grid 2 Colunas"
        ShowHeader="true"
        ShowMetrics="true"
        ShowTimeline="false"
        ShowSparkline="true"
        ShowBenchmarks="false"
        GridCols="2" />;

    private RenderFragment ExCompact() => @<XFAiPerformanceMonitor
        Title="Compacto"
        ShowHeader="false"
        ShowFooter="false"
        ShowMetrics="false"
        ShowTimeline="true"
        ShowSparkline="false"
        ShowBenchmarks="false" />;

    private const string Code1 = @"<XFAiPerformanceMonitor
    Title=""App Performance""
    ShowHeader=""true""
    ShowMetrics=""true""
    ShowTimeline=""true""
    ShowSparkline=""true""
    ShowBenchmarks=""true""
    GridCols=""4"" />";
    private const string Code2 = @"<XFAiPerformanceMonitor
    Title=""Sem Sparkline""
    ShowHeader=""true""
    ShowMetrics=""true""
    ShowTimeline=""true""
    ShowSparkline=""false""
    ShowBenchmarks=""false""
    GridCols=""3"" />";
    private const string Code3 = @"<XFAiPerformanceMonitor
    Title=""Timeline""
    ShowHeader=""true""
