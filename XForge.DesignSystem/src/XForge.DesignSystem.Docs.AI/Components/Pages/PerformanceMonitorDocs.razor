    ShowSparkline=""false""
    ShowBenchmarks=""true"" />";
    private const string Code5 = @"<XFAiPerformanceMonitor
    Title=""Grid 2 Colunas""
    ShowHeader=""true""
    ShowMetrics=""true""
    ShowTimeline=""false""
    ShowSparkline=""true""
    ShowBenchmarks=""false""
    GridCols=""2"" />";
    private const string Code6 = @"<XFAiPerformanceMonitor
    Title=""Compacto""
    ShowHeader=""false""
    ShowFooter=""false""
    ShowMetrics=""false""
    ShowTimeline=""true""
    ShowSparkline=""false""
    ShowBenchmarks=""false"" />";

    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("Title", "string", "\"Performance Monitor\"", L.Text("Titulo do monitor.", "Monitor title.")),
        new("AriaLabel", "string", "\"Monitor de performance em tempo real\"", L.Text("Label ARIA para acessibilidade.", "ARIA label for accessibility.")),
        new("ShowHeader", "bool", "true", L.Text("Exibe barra de cabecalho com titulo e status.", "Displays header bar with title and status.")),
        new("ShowFooter", "bool", "true", L.Text("Exibe barra de rodape com snapshots e modo.", "Displays footer bar with snapshots and mode.")),
        new("ShowMetrics", "bool", "true", L.Text("Exibe grid de cards de metricas.", "Displays metrics card grid.")),
        new("ShowTimeline", "bool", "true", L.Text("Exibe barras de timeline.", "Displays timeline bars.")),
        new("ShowSparkline", "bool", "true", L.Text("Exibe sparklines SVG nos cards de metrica.", "Displays SVG sparklines in metric cards.")),
        new("ShowBenchmarks", "bool", "true", L.Text("Exibe resultados de benchmark.", "Displays benchmark results.")),
        new("Mode", "XFAiMonitorMode", "Realtime", L.Text("Modo de monitoramento: Realtime, Summary, Detailed.", "Monitoring mode: Realtime, Summary, Detailed.")),
        new("Metrics", "IReadOnlyList<XFAiMetricDataPoint>", "[]", L.Text("Metricas iniciais para exibir.", "Initial metrics to display.")),
        new("BenchmarkTargets", "IReadOnlyList<XFAiBenchmarkTarget>", "[]", L.Text("Alvos de benchmark para avaliar.", "Benchmark targets to evaluate.")),
        new("MaxRenderTimeMs", "double", "16", L.Text("Tempo maximo de render para benchmark 60fps.", "Maximum render time for 60fps benchmark.")),
        new("GridCols", "int", "4", L.Text("Numero de colunas no grid de metricas.", "Number of columns in metrics grid.")),
        new("BarHeight", "int", "48", L.Text("Altura das barras de timeline em pixels.", "Timeline bar height in pixels."))
    ];

    private IReadOnlyList<NameValueRow> EventRows => [
        new("OnSnapshotRecorded", L.Text("Disparado quando um snapshot e registrado. Retorna XFAiRenderSnapshot.", "Fired when a snapshot is recorded. Returns XFAiRenderSnapshot."))
    ];

    private IReadOnlyList<NameValueRow> TypeRows => [
        new("XFAiMetricDataPoint", L.Text("Record com Label, Value, Unit, Severity, Timestamp.", "Record with Label, Value, Unit, Severity, Timestamp.")),
        new("XFAiRenderSnapshot", L.Text("Record com ComponentName, RenderTimeMs, ParametersChanged, ChildrenRendered, CapturedAt.", "Record with ComponentName, RenderTimeMs, ParametersChanged, ChildrenRendered, CapturedAt.")),
        new("XFAiBenchmarkTarget", L.Text("Record com Name, ThresholdMs, Operator, Unit.", "Record with Name, ThresholdMs, Operator, Unit.")),
        new("XFAiBenchmarkResult", L.Text("Record com Name, MeasuredValue, ThresholdValue, Operator, Passed, Unit.", "Record with Name, MeasuredValue, ThresholdValue, Operator, Passed, Unit.")),
        new("XFAiMonitorMode", L.Text("Enum: Realtime, Summary, Detailed.", "Enum: Realtime, Summary, Detailed.")),
        new("XFAiBenchmarkOperator", L.Text("Enum: LessThan, LessThanOrEqual, GreaterThan, GreaterThanOrEqual, Equal.", "Enum: LessThan, LessThanOrEqual, GreaterThan, GreaterThanOrEqual, Equal.")),
        new("XFSeverity", L.Text("Enum: Good, Warning, Critical.", "Enum: Good, Warning, Critical."))
    ];

    // === ACCESSIBILITY ===
    private IReadOnlyList<DocTile> AccessibilityItems => [
        new(L.Text("role=region", "role=region"), L.Text("Container principal usa role=region para leitores de tela.", "Main container uses role=region for screen readers."), "universal-access"),
        new(L.Text("aria-label", "aria-label"), L.Text("Label descritivo do monitor de performance.", "Descriptive label for performance monitor."), "tag"),
        new(L.Text("aria-live=polite", "aria-live=polite"), L.Text("Atualizacoes de metricas notificam leitores de tela.", "Metric updates notify screen readers."), "volume-high"),
        new(L.Text("Severidade visual", "Visual severity"), L.Text("Cores Good/Warning/Critical comunicam estado.", "Good/Warning/Critical colors communicate state."), "palette")
    ];

