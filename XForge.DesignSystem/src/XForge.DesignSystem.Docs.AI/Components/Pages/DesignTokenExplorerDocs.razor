@page "/ai/design-token-explorer"
@inject XForgeDocsLanguageService L

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.AiItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFDesignTokenExplorer" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("10 categorias de tokens", "10 token categories")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Explorador de tokens de design com busca, filtro, agrupamento e exportacao multi-formato.",
                               "Design token explorer with search, filter, grouping and multi-format export.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("Ferramenta comercial para auditoria e governanca visual de design tokens. Explora, filtra, agrupa, copia e exporta tokens em CSS, SCSS, JSON e TypeScript.",
                               "Commercial tool for visual audit and governance of design tokens. Explores, filters, groups, copies and exports tokens in CSS, SCSS, JSON and TypeScript.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico.", "Renders as static HTML.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 3 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Basico", "1. Basic"), T("Explorador com tokens de cores e busca habilitada.", "Explorer with color tokens and search enabled."), ExBasic(), Code1)
            @Example(T("2. Sem header e filtros", "2. No header and filters"), T("Apenas lista de tokens sem barra de busca ou filtros.", "Token list only without search bar or filters."), ExCompact(), Code2)
            @Example(T("3. Agrupado por categoria", "3. Grouped by category"), T("Tokens agrupados com headers colapsaveis.", "Tokens grouped with collapsible headers."), ExGrouped(), Code3)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>

        <XForgeDocsPageStandard ComponentName="DesignTokenExplorerDocs" />
    </XFStack>
</XForgeDocsShell>
@code {
    private string ProductLabelText => T("AI Commercial", "AI Commercial");
    private string PageTitleText => T("XFDesignTokenExplorer", "XFDesignTokenExplorer");
    private string PageStatusText => T("Documentacao completa", "Complete docs");
    private string T(string pt, string en) => L.Text(pt, en);
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFDesignTokenExplorer Title="Token Explorer"
                               ShowHeader="true"
                               ShowSearch="true"
                               ShowCategoryFilter="true"
                               ShowExport="false"
                               ShowGroupHeaders="false"
                               ShowCopyButton="false"
                               Tokens="_sampleTokens" />
    </XFStack>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("10 categorias", "10 categories"), T("Color, Typography, Spacing, Border, Shadow, Motion, Breakpoint, ZIndex, Opacity, Other.", "Color, Typography, Spacing, Border, Shadow, Motion, Breakpoint, ZIndex, Opacity, Other."), "layer-group"),
        new(T("4 formatos de export", "4 export formats"), T("CSS, SCSS, JSON e TypeScript.", "CSS, SCSS, JSON and TypeScript."), "file-export"),
        new(T("Zero JS", "Zero JS"), T("Nenhum JavaScript interop. Puro C# + Tailwind.", "No JavaScript interop. Pure C# + Tailwind."), "bolt")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFDesignTokenExplorer"),
        new("Namespace", "XForge.DesignSystem.Components.AI.Tooling"),
        new("Package", "XForge.DesignSystem.AI"),
        new("Category", "AI / Tooling"),
        new("Status", T("Estavel", "Stable")),
        new("Accessibility", T("role=region, aria-label, aria-expanded nos grupos.", "role=region, aria-label, aria-expanded on groups.")),
        new("Theme support", T("Light, dark e data-theme via tokens.", "Light, dark and data-theme via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("Explorador de tokens", "Token explorer"), T("Busca, filtro e visualizacao de design tokens.", "Search, filter and visualization of design tokens."), "magnifying-glass"),
        new(T("Export multi-formato", "Multi-format export"), T("Exporta em CSS, SCSS, JSON e TypeScript.", "Exports in CSS, SCSS, JSON and TypeScript."), "file-export"),
        new(T("Agrupamento colapsavel", "Collapsible grouping"), T("Tokens agrupados por categoria com colapso.", "Tokens grouped by category with collapse."), "layer-group")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Auditoria visual", "Visual audit"), T("Verificar consistencia de tokens no design system.", "Verify token consistency in design system."), "eye"),
        new(T("Governanca", "Governance"), T("Garantir uso correto de tokens corporativos.", "Ensure correct use of corporate tokens."), "shield-halved"),
        new(T("Documentacao", "Documentation"), T("Gerar documentacao de tokens em multiplos formatos.", "Generate token documentation in multiple formats."), "file-lines")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Tokens espalhados, dificeis de auditar.", "Scattered tokens, hard to audit."), "xmark"),
        new(T("Depois", "After"), T("Explorador centralizado com busca e filtro.", "Centralized explorer with search and filter."), "check"),
        new(T("Acessibilidade", "Accessibility"), T("role=region, aria-label, aria-expanded.", "role=region, aria-label, aria-expanded."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Auditoria de tokens", "Token audit"), T("Revisar tokens para consistencia visual.", "Review tokens for visual consistency."), "magnifying-glass"),
        new(T("Geracao de CSS", "CSS generation"), T("Exportar tokens como variaveis CSS.", "Export tokens as CSS variables."), "code")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Edicao de tokens", "Token editing"), T("Componente e read-only. Use XFThemeEditor para edicao.", "Component is read-only. Use XFThemeEditor for editing."), "ban"),
        new(T("Muitos tokens", "Too many tokens"), T("Milhares de tokens podem afetar performance.", "Thousands of tokens may affect performance."), "triangle-exclamation")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new("Header", T("Barra com titulo, contagem, busca e filtros.", "Bar with title, count, search and filters."), "heading"),
        new("GroupHeader", T("Cabecalho de grupo colapsavel.", "Collapsible group header."), "layer-group"),
        new("TokenRow", T("Linha com nome, valor, CSS variable e descricao.", "Row with name, value, CSS variable and description."), "list"),
        new("ExportPanel", T("Painel de exportacao com resultado.", "Export panel with output."), "file-export")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(T("Read-only", "Read-only"), T("Explorador apenas le e filtra, nao edita.", "Explorer only reads and filters, does not edit."), "lock"),
        new(T("Multi-formato", "Multi-format"), T("Suporta 4 formatos de exportacao.", "Supports 4 export formats."), "file-export"),
        new(T("Acessivel", "Accessible"), T("region com aria-label e grupos com aria-expanded.", "region with aria-label and groups with aria-expanded."), "universal-access")
    ];

    // === EXAMPLES ===
    private RenderFragment ExBasic() => @<XFDesignTokenExplorer Title="Design Tokens"
                                                                ShowHeader="true"
                                                                ShowSearch="true"
                                                                ShowCategoryFilter="true"
                                                                ShowExport="true"
                                                                ShowGroupHeaders="false"
                                                                ShowCopyButton="true"
                                                                Tokens="_sampleTokens" />;

    private RenderFragment ExCompact() => @<XFDesignTokenExplorer Title="Tokens"
                                                                  ShowHeader="false"
                                                                  ShowSearch="false"
                                                                  ShowCategoryFilter="false"
                                                                  ShowExport="false"
                                                                  ShowGroupHeaders="false"
                                                                  ShowCopyButton="false"
                                                                  Tokens="_compactTokens" />;

    private RenderFragment ExGrouped() => @<XFDesignTokenExplorer Title="Token Groups"
                                                                  ShowHeader="true"
                                                                  ShowSearch="false"
                                                                  ShowCategoryFilter="false"
                                                                  ShowExport="false"
                                                                  ShowGroupHeaders="true"
                                                                  ShowCopyButton="false"
                                                                  Tokens="_groupedTokens" />;

    private const string Code1 = @"<XFDesignTokenExplorer Title=""Design Tokens""
                    ShowHeader=""true""
                    ShowSearch=""true""
                    ShowCategoryFilter=""true""
                    ShowExport=""true""
                    ShowGroupHeaders=""false""
                    ShowCopyButton=""true""
                    Tokens=""_sampleTokens"" />";
    private const string Code2 = @"<XFDesignTokenExplorer Title=""Tokens""
                    ShowHeader=""false""
                    ShowSearch=""false""
                    ShowCategoryFilter=""false""
                    ShowExport=""false""
                    ShowGroupHeaders=""false""
                    ShowCopyButton=""false""
                    Tokens=""_compactTokens"" />";
    private const string Code3 = @"<XFDesignTokenExplorer Title=""Token Groups""
                    ShowHeader=""true""
                    ShowSearch=""false""
                    ShowCategoryFilter=""false""
                    ShowExport=""false""
                    ShowGroupHeaders=""true""
                    ShowCopyButton=""false""
                    Tokens=""_groupedTokens"" />";

    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("Title", "string", "\"Design Tokens\"", T("Titulo do explorador.", "Explorer title.")),
        new("AriaLabel", "string", "\"Explorador de design tokens\"", T("Label de acessibilidade.", "Accessibility label.")),
        new("ShowHeader", "bool", "true", T("Exibe barra de cabecalho.", "Shows header bar.")),
        new("ShowSearch", "bool", "true", T("Exibe campo de busca.", "Shows search input.")),
        new("ShowCategoryFilter", "bool", "true", T("Exibe filtro por categoria.", "Shows category filter.")),
        new("ShowExport", "bool", "true", T("Exibe botoes de exportacao.", "Shows export buttons.")),
        new("ShowGroupHeaders", "bool", "true", T("Exibe headers de grupo colapsaveis.", "Shows collapsible group headers.")),
        new("ShowCopyButton", "bool", "true", T("Exibe botao de copiar por token.", "Shows copy button per token.")),
        new("Tokens", "IReadOnlyList<XFDesignToken>", "[]", T("Lista de tokens para exibir.", "List of tokens to display.")),
        new("OnTokenCopied", "EventCallback<XFDesignToken>", "-", T("Disparado quando um token e copiado.", "Fired when a token is copied.")),
        new("OnExport", "EventCallback<string>", "-", T("Disparado quando tokens sao exportados.", "Fired when tokens are exported."))
    ];

    private IReadOnlyList<NameValueRow> EventRows => [
        new("OnTokenCopied", T("Disparado quando o usuario clica em copiar um token.", "Fired when user clicks to copy a token.")),
        new("OnExport", T("Disparado quando o usuario seleciona um formato de exportacao.", "Fired when user selects an export format."))
    ];

    // === ACCESSIBILITY ===
    private IReadOnlyList<DocTile> AccessibilityItems => [
        new(T("role=region", "role=region"), T("Componente usa role=region com aria-label.", "Component uses role=region with aria-label."), "universal-access"),
        new(T("aria-expanded", "aria-expanded"), T("Grupos colapsaveis usam aria-expanded.", "Collapsible groups use aria-expanded."), "chevron-down"),
        new(T("aria-label busca", "aria-label search"), T("Campo de busca com aria-label descritivo.", "Search input with descriptive aria-label."), "tag"),
        new(T("aria-label filtro", "aria-label filter"), T("Select de categoria com aria-label.", "Category select with aria-label."), "filter")
    ];

    private IReadOnlyList<NameValueRow> KeyboardRows => [
        new("Tab", T("Navega entre busca, filtro, botoes de export e tokens.", "Navigates between search, filter, export buttons and tokens.")),
        new("Enter", T("Ativa botao de copiar ou exportacao.", "Activates copy or export button.")),
        new("Escape", T("Fecha painel de exportacao.", "Closes export panel."))
    ];

    // === RESPONSIVENESS ===
    private IReadOnlyList<DocTile> ResponsivenessItems => [
        new(T("Largura total", "Full width"), T("Explorador ocupa 100% do container.", "Explorer occupies 100% of container."), "maximize"),
        new(T("Header responsivo", "Responsive header"), T("Botoes de export fazem wrap em mobile.", "Export buttons wrap on mobile."), "mobile-screen")
    ];

    // === PERFORMANCE ===
    private IReadOnlyList<DocTile> PerformanceItems => [
        new(T("Zero JS", "Zero JS"), T("Nenhum JavaScript interop.", "No JavaScript interop."), "bolt"),
        new(T("Filtro local", "Local filter"), T("Filtragem em memoria, sem chamadas de rede.", "In-memory filtering, no network calls."), "microchip")
    ];

    // === SCENARIOS ===
    private IReadOnlyList<DocTile> ScenarioItems => [
        new(T("Auditoria de design system", "Design system audit"), T("Verificar consistencia de tokens corporativos.", "Verify corporate token consistency."), "magnifying-glass"),
        new(T("Geracao de CSS", "CSS generation"), T("Exportar tokens como variaveis CSS para projetos.", "Export tokens as CSS variables for projects."), "code"),
        new(T("Documentacao de tokens", "Token documentation"), T("Gerar documentacao em JSON/TypeScript.", "Generate documentation in JSON/TypeScript."), "file-lines")
    ];

    // === COMPOSITION ===
    private IReadOnlyList<DocTile> CompositionItems => [
        new(T("TokenExplorer + ThemeEditor", "TokenExplorer + ThemeEditor"), T("Explorar tokens e editar no ThemeEditor.", "Explore tokens and edit in ThemeEditor."), "pen-to-square"),
        new(T("TokenExplorer + FigmaSync", "TokenExplorer + FigmaSync"), T("Sincronizar tokens do Figma e explorar.", "Sync tokens from Figma and explore."), "arrows-rotate"),
        new(T("TokenExplorer + Code", "TokenExplorer + Code"), T("Exportar tokens e copiar no XFCode.", "Export tokens and copy in XFCode."), "copy")
    ];

    // === BEST PRACTICES ===
    private IReadOnlyList<DocTile> BestPracticeItems => [
        new(T("ShowExport quando necessario", "ShowExport when needed"), T("Oculte exportacao se o explorador e apenas visual.", "Hide export if explorer is view-only."), "file-export"),
        new(T("Tokens descritivos", "Descriptive tokens"), T("Tokens com Description facilitam auditoria.", "Tokens with Description facilitate audit."), "font"),
        new(T("Agrupamento util", "Useful grouping"), T("Use Group para organizar tokens por dominio.", "Use Group to organize tokens by domain."), "layer-group"),
        new(T("Copiar rapido", "Quick copy"), T("ShowCopyButton para copiar valores rapidamente.", "ShowCopyButton to copy values quickly."), "clipboard")
    ];

    // === ANTI-PATTERNS ===
    private IReadOnlyList<DocTile> AntiPatternItems => [
        new(T("Edicao inline", "Inline editing"), T("Explorador nao deve editar tokens.", "Explorer should not edit tokens."), "xmark"),
        new(T("Muitos tokens sem filtro", "Too many tokens without filter"), T("Milhares de tokens sem busca sao inuteis.", "Thousands of tokens without search are unusable."), "ban"),
        new(T("Export sem validacao", "Export without validation"), T("Nao exporte tokens invalidos ou duplicados.", "Do not export invalid or duplicate tokens."), "triangle-exclamation")
    ];

    // === TOKENS ===
    private IReadOnlyList<NameValueRow> TokenRows => [
        new("root", T("rounded-lg border border-border-light bg-bg-surface shadow-sm.", "Rounded-lg border border-border-light bg-bg-surface shadow-sm.")),
        new("header", T("flex items-center justify-between border-b px-4 py-2.5.", "Flex items-center justify-between border-b px-4 py-2.5.")),
        new("groupHeader", T("flex w-full items-center justify-between px-4 py-2 text-xs uppercase.", "Flex w-full items-center justify-between px-4 py-2 text-xs uppercase.")),
        new("tokenRow", T("flex items-center gap-3 rounded px-2 py-1.5 hover:bg-surface-50.", "Flex items-center gap-3 rounded px-2 py-1.5 hover:bg-surface-50."))
    ];

    // === THEMING ===
    private IReadOnlyList<DocTile> ThemeItems => [
        new("data-theme", T("Tokens light/dark via CSS variables.", "Light/dark tokens via CSS variables."), "moon"),
        new(T("Cores semanticas", "Inline color swatches"), T("Swatches de cores inline com borda.", "Inline color swatches with border."), "palette")
    ];

    // === TESTING ===
    private IReadOnlyList<NameValueRow> TestingRows => [
        new("Unit", T("Testes de render, busca, filtro, agrupamento, copia, exportacao.", "Render, search, filter, grouping, copy, export tests.")),
        new("Accessibility", T("role=region, aria-label, aria-expanded, aria-label nos inputs.", "role=region, aria-label, aria-expanded, aria-label on inputs."))
    ];

    // === LIMITATIONS ===
    private IReadOnlyList<NameValueRow> LimitationRows => [
        new("Read-only", T("Explorador nao edita tokens. Use XFThemeEditor.", "Explorer does not edit tokens. Use XFThemeEditor.")),
        new("Performance", T("Milhares de tokens podem causar lentidao.", "Thousands of tokens may cause slowness."))
    ];

    // === RELATED ===
    private IReadOnlyList<DocTile> RelatedComponentItems => [
        new("XFThemeEditor", T("Edicao de temas e tokens.", "Theme and token editing."), "pen-to-square"),
        new("XFFigmaSync", T("Sincronizacao com Figma.", "Figma synchronization."), "arrows-rotate"),
        new("XFComponentGenerator", T("Geracao de componentes.", "Component generation."), "wand-magic-sparkles")
    ];

    // === FAQ ===
    private IReadOnlyList<NameValueRow> FaqRows => [
        new(T("Explorador vs ThemeEditor?", "Explorer vs ThemeEditor?"), T("Explorer = leitura/export. ThemeEditor = edicao.", "Explorer = read/export. ThemeEditor = edit.")),
        new(T("Quais formatos de export?", "Which export formats?"), T("CSS, SCSS, JSON e TypeScript.", "CSS, SCSS, JSON and TypeScript.")),
        new(T("Funciona sem tokens?", "Works without tokens?"), T("Sim. Mostra lista vazia.", "Yes. Shows empty list."))
    ];

    // === CHANGELOG ===
    private IReadOnlyList<NameValueRow> ChangelogRows => [
        new("2026-06-03", T("Pagina seed criada com preview e API inicial.", "Seed page created with preview and initial API.")),
        new("2026-06-12", T("Refatorada para padrao AppShellDocs com 26 secoes.", "Refactored to AppShellDocs pattern with 26 sections."))
    ];

    // === HELPERS ===
    private RenderFragment Section(string title, RenderFragment content) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
        <Header><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography></Header>
        <ChildContent>@content</ChildContent>
    </XFCard>;

    private RenderFragment Example(string title, string description, RenderFragment preview, string codeText) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.None" AreaRestricted="false">
        <Header><div class="px-6 pt-6 pb-2">
            <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@description</XFTypography>
        </div></Header>
        <ChildContent><div class="flex flex-col">
            <div class="border-t border-border-light p-6">@preview</div>
            <div class="border-t border-border-light bg-surface-50 p-6">
                <XFCode Text="@codeText" Language="razor" Title="@CopyableCodeTitle" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" />
            </div>
        </div></ChildContent>
    </XFCard>;

    private RenderFragment Tile(DocTile item) => @<XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent>
        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <div class="flex items-center gap-4">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-primary/10 bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                <div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div>
            </div>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
        </XFStack>
    </ChildContent></XFCard>;

    private RenderFragment TileGrid(IReadOnlyList<DocTile> items, int columns) => @<XFGrid Cols="1" Md="@Math.Min(columns, 2)" Lg="@columns" Gap="4">@foreach (var item in items) { @Tile(item) }</XFGrid>;

    private RenderFragment WarningGrid(IReadOnlyList<DocTile> items) => @<XFGrid Cols="1" Md="2" Gap="4">@foreach (var item in items) {
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <div class="flex items-center gap-4">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-danger/10 bg-danger/10 text-danger" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                <div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div>
            </div>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
        </XFStack></ChildContent></XFCard>
    }</XFGrid>;

    private RenderFragment NameValueTable(IReadOnlyList<NameValueRow> rows, string nameHeader, string valueHeader) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader><XFTableRow><XFTableCell Header="true">@nameHeader</XFTableCell><XFTableCell Header="true">@valueHeader</XFTableCell></XFTableRow></XFTableHeader>
        <XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Value</XFTableCell></XFTableRow> }</XFTableBody>
    </XFTable>;

    private RenderFragment ApiTable(IReadOnlyList<ApiRow> rows) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Parametro", "Parameter")</XFTableCell><XFTableCell Header="true">Type</XFTableCell><XFTableCell Header="true">Default</XFTableCell><XFTableCell Header="true">@T("Descricao", "Description")</XFTableCell></XFTableRow></XFTableHeader>
        <XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Type</XFTableCell><XFTableCell><XFCode Text="@row.DefaultValue" /></XFTableCell><XFTableCell>@row.Description</XFTableCell></XFTableRow> }</XFTableBody>
    </XFTable>;

    // === RECORDS ===
    private sealed record DocTile(string Title, string Description, string Icon);
    private sealed record NameValueRow(string Name, string Value);
    private sealed record ApiRow(string Name, string Type, string DefaultValue, string Description);

