@page "/"

<XForgeDocsShell ProductLabel="AI Commercial"
                 Title="XForge.DesignSystem.Docs.AI"
                 Status="Migration target"
                 Items="XForgeDocsCatalog.AiItems">
    <section class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_360px]">
        <XFCard>
            <Header>
                <div class="text-sm font-semibold">Preview AI</div>
            </Header>
            <ChildContent>
                <XFAiPromptBox Placeholder="Descreva uma automacao para o ERP..." />
            </ChildContent>
        </XFCard>

        <XFCard>
            <Header>
                <div class="text-sm font-semibold">Migration Queue</div>
            </Header>
            <ChildContent>
                <ul class="space-y-2 text-sm text-text-secondary">
                    @foreach (var item in XForgeDocsCatalog.AiItems)
                    {
                        <li>@item.ComponentName</li>
                    }
                </ul>
            </ChildContent>
        </XFCard>
    </section>

    <XForgeDocsPageStandard ComponentName="Home" />
</XForgeDocsShell>