@page "/ai/audit-timeline"
@using XForge.DesignSystem.Core.Primitives
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.AiItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFAiAuditTimeline" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Imutavel e rastreavel", "Immutable and traceable")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Linha do tempo imutavel para auditar decisoes humanas e acoes de IA com hash, diffs e rastreabilidade.",
                               "Immutable timeline to audit human decisions and AI actions with hash, diffs and traceability.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("Trilha de auditoria completa com antes/depois, reasoning de IA, assinatura digital e verificacao de integridade.",
                               "Complete audit trail with before/after, AI reasoning, digital signature and integrity verification.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico.", "Renders as static HTML.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 3 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Basico", "1. Basic"), T("Linha do tempo com entradas humanas e de IA.", "Timeline with human and AI entries."), ExBasic(), Code1)
            @Example(T("2. Com diffs", "2. With diffs"), T("Exibe antes/depois de mudancas de estado.", "Shows before/after state changes."), ExDiff(), Code2)
            @Example(T("3. Sem filtro", "3. Without filter"), T("Ocultando header e filtro para uso embutido.", "Hiding header and filter for embedded use."), ExEmbedded(), Code3)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string ProductLabelText => T("AI Commercial", "AI Commercial");
    private string PageTitleText => T("XFAiAuditTimeline", "XFAiAuditTimeline");
    private string PageStatusText => T("Documentacao completa", "Complete docs");
    private string T(string pt, string en) => LanguageService.Text(pt, en);
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFAiAuditTimeline Entries="SampleEntries"
                                                               Title="Trilha de auditoria"
                                                               ShowHash="true"
                                                               ShowDiff="true" />;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("Imutavel", "Immutable"), T("Entradas com hash SHA-256 e assinatura digital.", "Entries with SHA-256 hash and digital signature."), "lock"),
        new(T("Diffs antes/depois", "Before/after diffs"), T("Mostra mudancas de estado com visualizacao lado a lado.", "Shows state changes with side-by-side display."), "arrows-left-right"),
        new(T("Reasoning de IA", "AI reasoning"), T("Exibe explicacao da IA para cada acao automatizada.", "Shows AI explanation for each automated action."), "robot")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFAiAuditTimeline"),
        new("Namespace", "XForge.DesignSystem.Components.AI.Audit"),
        new("Package", "XForge.DesignSystem.AI"),
        new("Category", "AI / Audit"),
        new("Status", T("Estavel", "Stable")),
        new("Accessibility", "role=region, role=list, role=listitem, aria-label."),
        new("Theme support", T("Light, dark e data-theme via tokens.", "Light, dark and data-theme via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("Linha do tempo visual", "Visual timeline"), T("Sequencia cronologica de eventos de auditoria.", "Chronological sequence of audit events."), "clock-rotate-left"),
        new(T("Hash e assinatura", "Hash and signature"), T("Cada entrada tem hash SHA-256 e assinatura opcional.", "Each entry has SHA-256 hash and optional signature."), "lock"),
        new(T("Filtro por tipo", "Filter by type"), T("Filtra entradas por usuario, IA ou sistema.", "Filters entries by user, AI or system."), "filter")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Conformidade", "Compliance"), T("Atende LGPD, GDPR e SOX com trilha imutavel.", "Meets LGPD, GDPR and SOX with immutable trail."), "shield-check"),
        new(T("Auditoria de IA", "AI audit"), T("Registra decisoes automatizas com reasoning da IA.", "Records automated decisions with AI reasoning."), "robot"),
        new(T("Rastreabilidade", "Traceability"), T("Historico completo de alteracoes com antes/depois.", "Complete history of changes with before/after."), "list-check")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Sem registro de quem fez o que e quando.", "No record of who did what and when."), "xmark"),
        new(T("Depois", "After"), T("Timeline imutavel com hash, diffs e reasoning.", "Immutable timeline with hash, diffs and reasoning."), "check"),
        new(T("Acessibilidade", "Accessibility"), T("role=list, role=listitem, aria-label em cada entrada.", "role=list, role=listitem, aria-label on each entry."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Auditoria de IA", "AI audit"), T("Quando IA toma decisoes que afetam dados.", "When AI makes decisions affecting data."), "robot"),
        new(T("Conformidade regulatoria", "Regulatory compliance"), T("Quando leis exigem trilha imutavel de alteracoes.", "When laws require immutable change trail."), "shield-check")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Logs de sistema", "System logs"), T("Use XFAuditLogger para logs operacionais.", "Use XFAuditLogger for operational logs."), "scroll"),
        new(T("Historico de versoes", "Version history"), T("Use XFGitHistory para versionamento de codigo.", "Use XFGitHistory for code versioning."), "code-branch")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new("Header", T("Barra com titulo, contagem e filtro.", "Bar with title, count and filter."), "bars"),
        new("Dot", T("Indicador visual por tipo (usuario, IA, sistema).", "Visual indicator by type (user, AI, system)."), "circle"),
        new("Content", T("Acao, ator, timestamp, categoria e versao.", "Action, actor, timestamp, category and version."), "align-left"),
        new("AI Metadata", T("Caixa com reasoning da IA quando aplicavel.", "Box with AI reasoning when applicable."), "sparkles"),
        new("Diff Box", T("Painel antes/depois de mudancas de estado.", "Before/after panel of state changes."), "arrows-left-right"),
        new("Hash", T("Hash SHA-256 e indicador de assinatura.", "SHA-256 hash and signature indicator."), "hashtag")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(T("Imutabilidade", "Immutability"), T("Entradas nunca sao alteradas apos gravacao.", "Entries are never modified after recording."), "lock"),
        new(T("Transparencia", "Transparency"), T("Todos os dados de contexto visiveis na entrada.", "All context data visible in the entry."), "eye"),
        new(T("Zero confianca cega", "Zero blind trust"), T("Hash e assinatura garantem integridade verificavel.", "Hash and signature ensure verifiable integrity."), "shield-check")
    ];

    // === EXAMPLES ===
    private RenderFragment ExBasic() => @<XFAiAuditTimeline Entries="SampleEntries"
                                                           Title="Trilha de auditoria"
                                                           ShowHash="true"
                                                           ShowDiff="true" />;

    private RenderFragment ExDiff() => @<XFAiAuditTimeline Entries="DiffEntries"
                                                           Title="Mudancas de estado"
                                                           ShowDiff="true"
                                                           ShowHash="true" />;

    private RenderFragment ExEmbedded() => @<XFAiAuditTimeline Entries="SampleEntries"
                                                               Title="Auditoria embutida"
                                                               ShowHeader="false"
                                                               ShowFilter="false"
                                                               ShowHash="false"
                                                               ShowDiff="false" />;

    private const string Code1 = @"<XFAiAuditTimeline Entries=""@_entries""
    Title=""Trilha de auditoria""
    ShowHash=""true""
    ShowDiff=""true"" />";

    private const string Code2 = @"<XFAiAuditTimeline Entries=""@_entries""
    Title=""Mudancas de estado""
    ShowDiff=""true""
    ShowHash=""true"" />";

    private const string Code3 = @"<XFAiAuditTimeline Entries=""@_entries""
    Title=""Auditoria embutida""
    ShowHeader=""false""
    ShowFilter=""false""
    ShowHash=""false""
    ShowDiff=""false"" />";

    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("Entries", "IReadOnlyList<XFAiAuditEntry>", "[]", T("Lista de entradas de auditoria.", "List of audit entries.")),
        new("Title", "string", T("\"Auditoria\"", "\"Auditoria\""), T("Titulo da timeline.", "Timeline title.")),
        new("ShowHeader", "bool", "true", T("Exibe barra de header com titulo e contagem.", "Displays header bar with title and count.")),
        new("ShowFilter", "bool", "true", T("Exibe dropdown de filtro por tipo.", "Displays type filter dropdown.")),
        new("ShowDiff", "bool", "true", T("Exibe paineis antes/depois.", "Displays before/after panels.")),
        new("ShowHash", "bool", "true", T("Exibe hash SHA-256 e assinatura.", "Displays SHA-256 hash and signature.")),
        new("ShowIcons", "bool", "true", T("Exibe icones por tipo de ator.", "Displays icons by actor type.")),
        new("EmptyText", "string", T("\"Nenhuma entrada de auditoria.\"", "\"Nenhuma entrada de auditoria.\""), T("Texto do estado vazio.", "Empty state text.")),
        new("MaxEntries", "int", "100", T("Maximo de entradas exibidas.", "Maximum entries displayed.")),
        new("OnEntryClick", "EventCallback<XFAiAuditEntry>", "-", T("Disparado ao clicar em uma entrada.", "Fired when an entry is clicked.")),
        new("EmptyContent", "RenderFragment?", "null", T("Conteudo customizado para estado vazio.", "Custom empty state content."))
    ];

    private IReadOnlyList<NameValueRow> EventRows => [
        new("OnEntryClick", T("Disparado com a XFAiAuditEntry clicada. Use para abrir detalhes.", "Fired with the clicked XFAiAuditEntry. Use to open details."))
    ];

    // === ACCESSIBILITY ===
    private IReadOnlyList<DocTile> AccessibilityItems => [
        new("role=region", T("Container principal usa role=region com aria-label.", "Main container uses role=region with aria-label."), "universal-access"),
        new("role=list", T("Timeline usa role=list para leitores de tela.", "Timeline uses role=list for screen readers."), "list"),
        new("role=listitem", T("Cada entrada e role=listitem com aria-label descritivo.", "Each entry is role=listitem with descriptive aria-label."), "align-left"),
        new("aria-label", T("Label describe acao, ator e data de cada entrada.", "Label describes action, actor and date of each entry."), "tag")
    ];

    private IReadOnlyList<NameValueRow> KeyboardRows => [];

    // === RESPONSIVENESS ===
    private IReadOnlyList<DocTile> ResponsivenessItems => [
        new(T("Largura total", "Full width"), T("Timeline ocupa 100% do container.", "Timeline occupies 100% of container."), "maximize"),
        new(T("Diffs responsivos", "Responsive diffs"), T("Grid 2 colunas em desktop, 1 em mobile.", "2-column grid on desktop, 1 on mobile."), "mobile-screen")
    ];

    // === PERFORMANCE ===
    private IReadOnlyList<DocTile> PerformanceItems => [
        new(T("Zero JS", "Zero JS"), T("Nenhum JavaScript interop.", "No JavaScript interop."), "bolt"),
        new(T("Render leve", "Light render"), T("Lista nativa sem wrappers.", "Native list without wrappers."), "feather"),
        new(T("MaxEntries", "MaxEntries"), T("Limita entradas para evitar renderizacao excessiva.", "Limits entries to prevent excessive rendering."), "gauge")
    ];

    // === SCENARIOS ===
    private IReadOnlyList<DocTile> ScenarioItems => [
        new(T("Auditoria fiscal", "Fiscal audit"), T("Registro de alteracoes em CFOP, CST e NCM.", "Record of changes in CFOP, CST and NCM."), "file-invoice"),
        new(T("Aprovacao humana", "Human approval"), T("Registro de decisoes de aprovacao com antes/depois.", "Record of approval decisions with before/after."), "user-check"),
        new(T("Acao de IA", "AI action"), T("Classificacao fiscal sugerida com reasoning.", "Suggested fiscal classification with reasoning."), "robot")
    ];

    // === COMPOSITION ===
    private IReadOnlyList<DocTile> CompositionItems => [
        new("Timeline + Card", T("Timeline dentro de XFCard para contexto.", "Timeline inside XFCard for context."), "square"),
        new("Timeline + Filter", T("Filtro por tipo para refinar resultados.", "Filter by type to refine results."), "filter"),
        new("Timeline + Diff", T("Diffs antes/depois para mudancas de estado.", "Before/after diffs for state changes."), "arrows-left-right")
    ];

    // === BEST PRACTICES ===
    private IReadOnlyList<DocTile> BestPracticeItems => [
        new(T("Sempre com hash", "Always with hash"), T("Habilitar ShowHash para integridade verificavel.", "Enable ShowHash for verifiable integrity."), "lock"),
        new(T("Reasoning visivel", "Visible reasoning"), T("Mostrar reasoning de IA para decisoes automatizadas.", "Show AI reasoning for automated decisions."), "robot"),
        new(T("Limite de entradas", "Entry limit"), T("Usar MaxEntries para evitar listas excessivamente longas.", "Use MaxEntries to avoid overly long lists."), "gauge"),
        new(T("Empty state claro", "Clear empty state"), T("Definir EmptyText ou EmptyContent para ausencia de dados.", "Set EmptyText or EmptyContent for no data."), "inbox")
    ];

    // === ANTI-PATTERNS ===
    private IReadOnlyList<DocTile> AntiPatternItems => [
        new(T("Sem hash", "No hash"), T("Omitir ShowHash compromete verificabilidade.", "Omitting ShowHash compromises verifiability."), "xmark"),
        new(T("Dados sensiveis", "Sensitive data"), T("Nao incluir senhas ou tokens nos diffs.", "Do not include passwords or tokens in diffs."), "triangle-exclamation"),
        new(T("Sem filtro", "No filter"), T("Listas longas sem filtro sao dificeis de navegar.", "Long lists without filter are hard to navigate."), "ban")
    ];

    // === TOKENS ===
    private IReadOnlyList<NameValueRow> TokenRows => [
        new("dot", T("h-2.5 w-2.5 rounded-full ring-2 ring-bg-surface.", "h-2.5 w-2.5 rounded-full ring-2 ring-bg-surface.")),
        new("header", T("flex items-center justify-between border-b px-4 py-3.", "flex items-center justify-between border-b px-4 py-3.")),
        new("timeline", T("px-4 py-3.", "px-4 py-3."))
    ];

