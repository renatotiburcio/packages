    // === ANTI-PATTERNS ===
    private IReadOnlyList<DocTile> AntiPatternItems => [
        new(T("Sem audit trail", "No audit trail"), T("Acoes de IA sem logging sao indetectaveis.", "AI actions without logging are undetectable."), "xmark"),
        new(T("RBAC bypass", "RBAC bypass"), T("Nunca pule verificacao de permissoes no frontend.", "Never skip permission verification on the frontend."), "ban"),
