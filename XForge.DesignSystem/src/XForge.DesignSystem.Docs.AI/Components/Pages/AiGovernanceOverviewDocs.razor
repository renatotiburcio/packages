    // === LIMITATIONS ===
    private IReadOnlyList<NameValueRow> LimitationRows => [
        new(T("Filtros client-side", "Client-side filters"), T("AuditLogger filtra apenas no lado do cliente.", "AuditLogger filters only on the client side.")),
        new(T("Persistencia", "Persistence"), T("Decisoes de HumanApproval nao sao persistidas automaticamente.", "HumanApproval decisions are not persisted automatically.")),
        new(T("SSR", "SSR"), T("Botoes de interacao requerem modo interativo.", "Interaction buttons require interactive mode."))
