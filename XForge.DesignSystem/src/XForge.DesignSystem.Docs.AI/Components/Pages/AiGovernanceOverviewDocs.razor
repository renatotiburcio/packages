@page "/ai/governance/overview"
@using XForge.DesignSystem.Core.Primitives
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.AiItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="AI Governance" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("6 componentes enterprise", "6 enterprise components")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Audit, Security, Compliance", "Audit, Security, Compliance")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Governanca de IA: auditoria, seguranca, conformidade e controle de acesso para aplicacoes AI comerciais.",
                               "AI governance: audit, security, compliance and access control for commercial AI applications.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("Conjunto enterprise de componentes para human approval workflows, timeline imutavel, painel de conformidade, autenticacao SSO/OIDC, RBAC e logging de auditoria.",
                               "Enterprise set of components for human approval workflows, immutable timeline, compliance panel, SSO/OIDC authentication, RBAC and audit logging.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico. Botoes requerem interatividade.", "Renders as static HTML. Buttons require interactivity.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Todos os componentes de governanca sao puramente renderizados com C# e Tailwind CSS.", "All governance components are purely rendered with C# and Tailwind CSS.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 3 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Dashboard de governanca", "1. Governance Dashboard"), T("Combinacao de audit logger, compliance panel e human approval.", "Combination of audit logger, compliance panel and human approval."), ExDashboard(), Code1)
            @Example(T("2. Workflow de aprovacao", "2. Approval Workflow"), T("Human approval com audit timeline para rastreabilidade completa.", "Human approval with audit timeline for complete traceability."), ExApprovalWorkflow(), Code2)
            @Example(T("3. RBAC + Auth + Logger", "3. RBAC + Auth + Logger"), T("Autenticacao, controle de acesso e logging integrados.", "Authentication, access control and logging integrated."), ExFullStack(), Code3)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string ProductLabelText => T("AI Commercial", "AI Commercial");
    private string PageTitleText => T("AI Governance Overview", "AI Governance Overview");
    private string PageStatusText => T("Documentacao completa", "Complete docs");
    private string T(string pt, string en) => LanguageService.Text(pt, en);
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAuditLogger Entries="SampleAuditEntries"
                       Title="Auditoria"
                       ShowFilters="true"
                       ShowExportButton="false"
                       MaxVisible="2" />
    </XFStack>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("6 componentes", "6 components"), T("AuditLogger, AuditTimeline, CompliancePanel, AuthProvider, RBAC, HumanApproval.", "AuditLogger, AuditTimeline, CompliancePanel, AuthProvider, RBAC, HumanApproval."), "shield-check"),
        new(T("WCAG AAA", "WCAG AAA"), T("role=region, aria-live, aria-label, aria-busy em todos.", "role=region, aria-live, aria-label, aria-busy across all."), "universal-access"),
        new(T("Zero JS", "Zero JS"), T("Nenhum JavaScript interop. Puro C# + Tailwind.", "No JavaScript interop. Pure C# + Tailwind."), "bolt")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Category", "AI / Governance"),
        new("Package", "XForge.DesignSystem.AI"),
        new("Components", "XFAuditLogger, XFAiAuditTimeline, XFCompliancePanel, XFAuthProvider, XFRbacComponent, XFAiHumanApprovalCard"),
        new("Status", T("Estavel", "Stable")),
        new("Accessibility", "WCAG AAA — role=region, role=log, aria-live, aria-busy, aria-label."),
        new("Theme support", T("Light, dark e data-theme via tokens.", "Light, dark and data-theme via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new("XFAuditLogger", T("Log de auditoria operacional com filtros e exportacao.", "Operational audit log with filters and export."), "scroll"),
        new("XFAiAuditTimeline", T("Linha do tempo imutavel com hash e rastreabilidade.", "Immutable timeline with hash and traceability."), "clock-rotate-left"),
        new("XFCompliancePanel", T("Dashboard de conformidade LGPD/GDPR com politicas.", "LGPD/GDPR compliance dashboard with policies."), "clipboard-check"),
        new("XFAuthProvider", T("Autenticacao SSO/OIDC/OAuth2 com 6 estados visuais.", "SSO/OIDC/OAuth2 authentication with 6 visual states."), "door-open"),
        new("XFRbacComponent", T("Controle de acesso baseado em papeis com And/Or.", "Role-based access control with And/Or operators."), "shield"),
        new("XFAiHumanApprovalCard", T("Workflow de aprovacao humana com score de risco.", "Human approval workflow with risk score."), "user-shield")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Auditoria", "Audit"), T("Registrar todas as acoes de IA e decisoes humanas.", "Record all AI actions and human decisions."), "scroll"),
        new(T("Seguranca", "Security"), T("Autenticar e controlar acesso a recursos AI.", "Authenticate and control access to AI resources."), "shield-check"),
        new(T("Conformidade", "Compliance"), T("Atender LGPD, GDPR e CCPA com paineis visuais.", "Meet LGPD, GDPR and CCPA with visual dashboards."), "clipboard-check")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Governanca de IA fragmentada e nao padronizada.", "AI governance fragmented and non-standardized."), "xmark"),
        new(T("Depois", "After"), T("Ecossistema integrado com 6 componentes enterprise.", "Integrated ecosystem with 6 enterprise components."), "check"),
        new(T("Acessibilidade", "Accessibility"), T("WCAG AAA com roles, aria-live e aria-label.", "WCAG AAA with roles, aria-live and aria-label."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Sistemas financeiros", "Financial systems"), T("Aprovacao de pagamentos, conciliacao e NF-e.", "Payment approval, reconciliation and NF-e."), "money-bill"),
        new(T("Plataformas AI", "AI platforms"), T("Auditoria de decisoes de IA e acoes automaticas.", "Audit of AI decisions and automatic actions."), "robot"),
        new(T("Enterprise SSO", "Enterprise SSO"), T("Integracao com OIDC, OAuth2 e SAML.", "Integration with OIDC, OAuth2 and SAML."), "key")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Acoes triviais", "Trivial actions"), T("Nao use governance para acoes de baixo risco.", "Do not use governance for low-risk actions."), "ban"),
        new(T("Sistemas sem IA", "Non-AI systems"), T("Use governance apenas quando ha decisoes de IA.", "Use governance only when there are AI decisions."), "robot")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new(T("Audit Layer", "Audit Layer"), T("AuditLogger + AuditTimeline para registro e trilha.", "AuditLogger + AuditTimeline for recording and trail."), "scroll"),
        new(T("Security Layer", "Security Layer"), T("AuthProvider + RBAC para autenticacao e autorizacao.", "AuthProvider + RBAC for authentication and authorization."), "shield"),
        new(T("Compliance Layer", "Compliance Layer"), T("CompliancePanel + HumanApproval para conformidade.", "CompliancePanel + HumanApproval for compliance."), "clipboard-check")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(T("Transparencia", "Transparency"), T("Toda acao de IA e visivel e auditavel.", "Every AI action is visible and auditable."), "eye"),
        new(T("Controle humano", "Human control"), T("Humanos sempre tem a ultima decisao.", "Humans always have the final decision."), "user-shield"),
        new(T("Conformidade por padrao", "Compliance by default"), T("Componentes atendem LGPD/GDPR nativamente.", "Components meet LGPD/GDPR natively."), "clipboard-check")
    ];

    // === EXAMPLES ===
    private RenderFragment ExDashboard() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAuditLogger Entries="SampleAuditEntries"
                       Title="Auditoria"
                       ShowFilters="true"
                       ShowExportButton="false"
                       MaxVisible="2" />
    </XFStack>;

    private RenderFragment ExApprovalWorkflow() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiHumanApprovalCard Request="SampleApprovalRequest" />
    </XFStack>;

    private RenderFragment ExFullStack() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAuditLogger Entries="SampleAuditEntries"
                       Title="Log de autenticacao"
                       ShowFilters="false"
                       ShowExportButton="false"
                       MaxVisible="2" />
    </XFStack>;

    private const string Code1 = @"<XFAuditLogger Entries=""@_entries""
    Title=""Auditoria""
    ShowFilters=""true""
    ShowExportButton=""false""
    MaxVisible=""3"" />

<XFCompliancePanel Policies=""@_policies""
    ShowConsentManagement=""true"" />";

    private const string Code2 = @"<XFAiHumanApprovalCard Request=""@_request""
    OnApproved=""@HandleApproved""
    OnRejected=""@HandleRejected"" />

<XFAiAuditTimeline Entries=""@_timeline""
    ShowHash=""true""
    ShowDiff=""true"" />";

    private const string Code3 = @"<XFAuthProvider State=""@_authState""
    OnLogin=""@HandleLogin""
    OnLogout=""@HandleLogout"" />

<XFRbacComponent Roles=""@_roles""
    Permission=""admin""
    AndOr=""And"">
    <XFAuditLogger Entries=""@_entries""
        Title=""Log administrativo""
        ShowFilters=""true"" />
</XFRbacComponent>";

    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("XFAuditLogger", "Component", "—", T("Log de auditoria operacional com filtros por severidade e exportacao.", "Operational audit log with severity filters and export.")),
        new("XFAiAuditTimeline", "Component", "—", T("Linha do tempo imutavel com hash, diffs e verificacao de integridade.", "Immutable timeline with hash, diffs and integrity verification.")),
        new("XFCompliancePanel", "Component", "—", T("Dashboard de conformidade com politicas, consentimentos e solicitacoes.", "Compliance dashboard with policies, consents and requests.")),
        new("XFAuthProvider", "Component", "—", T("Autenticacao SSO/OIDC/OAuth2 com 6 estados e provedores.", "SSO/OIDC/OAuth2 authentication with 6 states and providers.")),
        new("XFRbacComponent", "Component", "—", T("Controle de acesso baseado em papeis com operadores And/Or.", "Role-based access control with And/Or operators.")),
        new("XFAiHumanApprovalCard", "Component", "—", T("Workflow de aprovacao humana com score de risco e payload.", "Human approval workflow with risk score and payload."))
    ];

    private IReadOnlyList<NameValueRow> EventRows => [
        new("XFAuditLogger.OnExport", T("Exporta entradas filtradas para auditoria externa.", "Exports filtered entries for external audit.")),
        new("XFAuditLogger.OnFilterChange", T("Notifica mudanca de filtros de severidade e acao.", "Notifies severity and action filter changes.")),
        new("XFAiAuditTimeline.OnVerify", T("Verifica integridade de hash na trilha.", "Verifies hash integrity on trail.")),
        new("XFAuthProvider.OnLogin", T("Disparado no login bem-sucedido.", "Fired on successful login.")),
        new("XFAuthProvider.OnLogout", T("Disparado no logout.", "Fired on logout.")),
        new("XFAiHumanApprovalCard.OnApproved", T("Disparado quando a acao e aprovada.", "Fired when action is approved.")),
        new("XFAiHumanApprovalCard.OnRejected", T("Disparado quando a acao e rejeitada.", "Fired when action is rejected."))
    ];

    // === ACCESSIBILITY ===
    private IReadOnlyList<DocTile> AccessibilityItems => [
        new("role=region", T("Todos os componentes usam role=region com aria-label.", "All components use role=region with aria-label."), "universal-access"),
        new("role=log", T("AuditLogger e AuditTimeline usam role=log com aria-live.", "AuditLogger and AuditTimeline use role=log with aria-live."), "scroll"),
        new("aria-busy", T("HumanApprovalCard indica processamento com aria-busy.", "HumanApprovalCard indicates processing with aria-busy."), "spinner"),
        new("aria-label", T("Todos os botoes e interacoes tem aria-label descritivo.", "All buttons and interactions have descriptive aria-label."), "tag")
    ];

    private IReadOnlyList<NameValueRow> KeyboardRows => [
        new("Tab", T("Navega entre componentes e botoes de governanca.", "Navigates between governance components and buttons.")),
        new("Enter", T("Aciona botoes de aprovacao, rejeicao e filtro.", "Triggers approve, reject and filter buttons.")),
        new("Escape", T("Cancela edicao de payload no HumanApprovalCard.", "Cancels payload edit in HumanApprovalCard."))
    ];

    // === RESPONSIVENESS ===
    private IReadOnlyList<DocTile> ResponsivenessItems => [
        new(T("Largura total", "Full width"), T("Todos os componentes ocupam 100% do container.", "All components occupy 100% of container."), "maximize"),
        new(T("Empilhamento", "Stacking"), T("Botoes e filtros se empilham em mobile.", "Buttons and filters stack on mobile."), "mobile-screen")
    ];

    // === PERFORMANCE ===
    private IReadOnlyList<DocTile> PerformanceItems => [
        new(T("Zero JS", "Zero JS"), T("Nenhum JavaScript interop em nenhum componente.", "No JavaScript interop in any component."), "bolt"),
        new(T("MaxVisible", "MaxVisible"), T("AuditLogger limita entradas renderizadas por vez.", "AuditLogger limits entries rendered per time."), "gauge"),
        new(T("Render leve", "Light render"), T("Componentes nativos sem wrappers excessivos.", "Native components without excessive wrappers."), "feather")
    ];

    // === SCENARIOS ===
    private IReadOnlyList<DocTile> ScenarioItems => [
        new(T("ERP fiscal", "Fiscal ERP"), T("Auditoria de NF-e, aprovacao de pagamentos e RBAC.", "NF-e audit, payment approval and RBAC."), "file-invoice"),
        new(T("Plataforma AI", "AI platform"), T("Logging de decisoes de IA, timeline e conformidade.", "AI decision logging, timeline and compliance."), "robot"),
        new(T("Enterprise SSO", "Enterprise SSO"), T("Autenticacao OIDC com RBAC e audit trail.", "OIDC authentication with RBAC and audit trail."), "key")
    ];

    // === COMPOSITION ===
    private IReadOnlyList<DocTile> CompositionItems => [
        new(T("Audit + Compliance", "Audit + Compliance"), T("Logger com painel de conformidade para dashboard completo.", "Logger with compliance panel for complete dashboard."), "clipboard-check"),
        new(T("Auth + RBAC", "Auth + RBAC"), T("Autenticacao com controle de acesso para protecao de rotas.", "Authentication with access control for route protection."), "shield"),
        new(T("Approval + Timeline", "Approval + Timeline"), T("Aprovacao humana com trilha imutavel para rastreabilidade.", "Human approval with immutable trail for traceability."), "clock-rotate-left")
    ];

    // === BEST PRACTICES ===
    private IReadOnlyList<DocTile> BestPracticeItems => [
        new(T("Camadas separadas", "Separate layers"), T("Use Audit para logs, Security para acesso, Compliance para politicas.", "Use Audit for logs, Security for access, Compliance for policies."), "layer-group"),
        new(T("HumanApproval para alto risco", "HumanApproval for high risk"), T("Use apenas para acoes com impacto significativo.", "Use only for actions with significant impact."), "user-shield"),
        new(T("AuditTimeline para imutabilidade", "AuditTimeline for immutability"), T("Use quando precisar de hash e verificacao de integridade.", "Use when hash and integrity verification are needed."), "lock"),
        new(T("RBAC granular", "Granular RBAC"), T("Defina permissoes por recurso e acao, nao apenas por papel.", "Define permissions by resource and action, not just by role."), "shield")
