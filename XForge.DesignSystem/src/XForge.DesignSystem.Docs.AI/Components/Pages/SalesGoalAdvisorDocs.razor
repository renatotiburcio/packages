        new(L.Text("Placeholder descritivo", "Descriptive placeholder"), L.Text("Use perguntas exemplos no placeholder.", "Use example questions in placeholder."), "font"),
        new(L.Text("Mostrar confianca", "Show confidence"), L.Text("Barra de confianca ajuda o usuario a avaliar o resultado.", "Confidence bar helps user evaluate the result."), "shield-check"),
