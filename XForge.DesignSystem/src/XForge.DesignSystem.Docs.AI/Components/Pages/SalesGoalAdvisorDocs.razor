@page "/ai/sales-goal-advisor"
@inject XForgeDocsLanguageService L

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.AiItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFAiSalesGoalAdvisor" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@L.Text("Assistente comercial AI", "AI commercial assistant")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @L.Text("Assistente inteligente para metas, rankings, comissoes, previsoes e recomendacoes de vendas.",
                                   "Intelligent assistant for goals, rankings, commissions, forecasts and sales recommendations.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @L.Text("Motor de analise comercial com IA generativa para ERP brasileiro. Ranking de vendedores, progresso de metas, comissoes e recomendacoes de mix de produtos. Puro Blazor, sem JavaScript interop.",
                                   "AI-powered commercial analysis engine for Brazilian ERP. Salesperson ranking, goal progress, commissions and product mix recommendations. Pure Blazor, no JavaScript interop.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(L.Text("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, L.Text("Campo", "Field"), L.Text("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@L.Text("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@L.Text("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@L.Text("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@L.Text("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Funciona sem restricoes. Execucao reativa.", "Works without restrictions. Reactive execution.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Renderiza como HTML estatico.", "Renders as static HTML.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@L.Text("Dependencias", "Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@L.Text("Requer IAiProvider para chamadas de IA. Sem JavaScript interop.", "Requires IAiProvider for AI calls. No JavaScript interop.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(L.Text("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(L.Text("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(L.Text("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(L.Text("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(L.Text("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(L.Text("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 3 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(L.Text("1. Com header", "1. With Header"), L.Text("Assistente com cabecalho, entrada de texto e resultado.", "Assistant with header, text input and result."), ExWithHeader(), Code1)
            @Example(L.Text("2. Sem header", "2. No Header"), L.Text("Assistente sem cabecalho para integracao em layouts.", "Assistant without header for layout integration."), ExNoHeader(), Code2)
            @Example(L.Text("3. Com placeholder customizado", "3. Custom Placeholder"), L.Text("Assistente com mensagem de entrada personalizada.", "Assistant with personalized input message."), ExCustomPlaceholder(), Code3)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(L.Text("Eventos", "Events"), @<div>@NameValueTable(EventRows, L.Text("Evento", "Event"), L.Text("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(L.Text("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, L.Text("Tecla", "Key"), L.Text("Comportamento", "Behavior"))</div>)
            @Section(L.Text("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(L.Text("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(L.Text("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(L.Text("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(L.Text("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", L.Text("Proposito", "Purpose"))</div>)
            @Section(L.Text("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(L.Text("Testes", "Testing"), @<div>@NameValueTable(TestingRows, L.Text("Cobertura", "Coverage"), L.Text("Evidencia", "Evidence"))</div>)
            @Section(L.Text("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, L.Text("Limitacao", "Limitation"), L.Text("Status", "Status"))</div>)
            @Section(L.Text("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, L.Text("Pergunta", "Question"), L.Text("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, L.Text("Versao", "Version"), L.Text("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string ProductLabelText => L.Text("AI Commercial", "AI Commercial");
    private string PageTitleText => L.Text("XFAiSalesGoalAdvisor", "XFAiSalesGoalAdvisor");
    private string PageStatusText => L.Text("Documentacao completa", "Complete docs");
    private string CopyableCodeTitle => L.Text("Codigo copiavel", "Copyable code");

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiSalesGoalAdvisor Title="Metas comerciais"
                              Placeholder="Quais vendedores precisam de plano de recuperacao?"
                              ShowHeader="true" />
    </XFStack>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(L.Text("Analise comercial AI", "AI commercial analysis"), L.Text("Ranking, metas, comissoes e previsoes de vendas.", "Ranking, goals, commissions and sales forecasts."), "bullseye"),
        new(L.Text("Ranking de vendedores", "Salesperson ranking"), L.Text("Classificacao por desempenho com badges e percentual.", "Classification by performance with badges and percentage."), "trophy"),
        new(L.Text("Zero JS", "Zero JS"), L.Text("Nenhum JavaScript interop. Puro C# + Tailwind.", "No JavaScript interop. Pure C# + Tailwind."), "bolt")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFAiSalesGoalAdvisor"),
        new("Namespace", "XForge.DesignSystem.Components.AI.Financial"),
        new("Package", "XForge.DesignSystem.AI"),
        new("Category", "AI / Financial"),
        new("Status", L.Text("Estavel", "Stable")),
        new("Accessibility", L.Text("role=region, aria-label, aria-busy, role=status, aria-live=polite.", "role=region, aria-label, aria-busy, role=status, aria-live=polite.")),
        new("Theme support", L.Text("Light, dark e data-theme via tokens.", "Light, dark and data-theme via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(L.Text("Assistente de metas", "Goal assistant"), L.Text("Interface conversacional para analise comercial com IA.", "Conversational interface for AI commercial analysis."), "bullseye"),
        new(L.Text("Ranking de vendedores", "Salesperson ranking"), L.Text("Posicao, vendas totais, alcance e badge por vendedor.", "Position, total sales, achievement and badge per salesperson."), "trophy"),
        new(L.Text("Progresso de metas", "Goal progress"), L.Text("Barras de progresso com previsao de resultado.", "Progress bars with outcome prediction."), "chart-line")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(L.Text("Ranking de vendas", "Sales ranking"), L.Text("Classificar vendedores por desempenho.", "Classify salespeople by performance."), "trophy"),
        new(L.Text("Acompanhamento de metas", "Goal tracking"), L.Text("Monitorar progresso e previsao de metas.", "Monitor goal progress and prediction."), "chart-line"),
        new(L.Text("Recomendacoes comerciais", "Commercial recommendations"), L.Text("Sugestoes de mix de produtos e planos de acao.", "Product mix suggestions and action plans."), "lightbulb")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(L.Text("Antes", "Before"), L.Text("Analise comercial manual e dispersa.", "Manual and scattered commercial analysis."), "xmark"),
        new(L.Text("Depois", "After"), L.Text("Assistente IA com ranking, metas e recomendacoes automaticas.", "AI assistant with ranking, goals and automatic recommendations."), "check"),
        new(L.Text("Acessibilidade", "Accessibility"), L.Text("role=status, aria-live=polite, aria-busy.", "role=status, aria-live=polite, aria-busy."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(L.Text("Gestao comercial", "Commercial management"), L.Text("Acompanhamento diario de metas e ranking.", "Daily goal and ranking tracking."), "bullseye"),
        new(L.Text("Reunioes de vendas", "Sales meetings"), L.Text("Dados rapidos para reunioes de resultado.", "Quick data for result meetings."), "users")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(L.Text("Sem provider IA", "No AI provider"), L.Text("Requer IAiProvider configurado.", "Requires configured IAiProvider."), "circle-xmark"),
        new(L.Text("Dados estaticos", "Static data"), L.Text("Para dados estaticos, use tabelas simples.", "For static data, use simple tables."), "table")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new(L.Text("Header", "Header"), L.Text("Barra com titulo e icone de sparkles.", "Bar with title and sparkles icon."), "bars"),
        new(L.Text("Textarea", "Textarea"), L.Text("Entrada de texto com placeholder e botao Analisar.", "Text input with placeholder and Analyze button."), "font"),
        new(L.Text("Result preview", "Result preview"), L.Text("Resumo IA, ranking, metas e barra de confianca.", "AI summary, ranking, goals and confidence bar."), "sparkles"),
        new(L.Text("Empty state", "Empty state"), L.Text("Estado vazio com mensagem e icone.", "Empty state with message and icon."), "inbox")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(L.Text("Conversacional", "Conversational"), L.Text("Interface tipo chat para perguntas comerciais.", "Chat-like interface for commercial questions."), "comments"),
        new(L.Text("Confianca visual", "Visual confidence"), L.Text("Barra de confianca com cor semantica.", "Confidence bar with semantic color."), "shield-check"),
        new(L.Text("Ranking com badges", "Ranking with badges"), L.Text("Posicoes com badges gold, silver e bronze.", "Positions with gold, silver and bronze badges."), "medal")
    ];

    // === EXAMPLES ===
    private RenderFragment ExWithHeader() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiSalesGoalAdvisor Title="Metas comerciais"
                              Placeholder="Quais vendedores precisam de plano de recuperacao?"
                              ShowHeader="true" />
    </XFStack>;

    private RenderFragment ExNoHeader() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiSalesGoalAdvisor Title="Vendas"
                              Placeholder="Analise de ranking de vendedores"
                              ShowHeader="false" />
    </XFStack>;

    private RenderFragment ExCustomPlaceholder() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiSalesGoalAdvisor Title="Analise comercial"
                              Placeholder="Quais produtos devem ser priorizados no mix de vendas?"
                              ShowHeader="true" />
    </XFStack>;

    private const string Code1 = @"<XFAiSalesGoalAdvisor Title=""Metas comerciais""
    Placeholder=""Quais vendedores precisam de plano de recuperacao?""
    ShowHeader=""true"" />";
    private const string Code2 = @"<XFAiSalesGoalAdvisor Title=""Vendas""
    Placeholder=""Analise de ranking de vendedores""
    ShowHeader=""false"" />";
    private const string Code3 = @"<XFAiSalesGoalAdvisor Title=""Analise comercial""
    Placeholder=""Quais produtos devem ser priorizados no mix de vendas?""
    ShowHeader=""true"" />";

    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("Provider", "IAiProvider?", "null", L.Text("Provedor de IA para chamadas de analise.", "AI provider for analysis calls.")),
        new("Title", "string", "\"Assistente de Metas\"", L.Text("Titulo do componente.", "Component title.")),
        new("Placeholder", "string", "\"Pergunte sobre...\"", L.Text("Texto de placeholder da entrada.", "Input placeholder text.")),
        new("ShowHeader", "bool", "true", L.Text("Exibe a barra de cabecalho.", "Shows the header bar.")),
        new("Loading", "bool", "false", L.Text("Forca estado de carregamento.", "Forces loading state.")),
        new("SystemPrompt", "string?", "null", L.Text("Prompt de sistema customizado para a IA.", "Custom system prompt for the AI.")),
        new("ResultPreview", "RenderFragment<XFAiSalesGoalInsight>?", "null", L.Text("Preview customizado do resultado.", "Custom result preview.")),
        new("HeaderContent", "RenderFragment?", "null", L.Text("Conteudo customizado do cabecalho.", "Custom header content.")),
        new("EmptyContent", "RenderFragment?", "null", L.Text("Conteudo customizado para estado vazio.", "Custom empty state content."))
    ];

    private IReadOnlyList<NameValueRow> EventRows => [
        new("OnAnalysisComplete", L.Text("Disparado quando a analise e concluida com sucesso. Retorna XFAiSalesGoalInsight.", "Fired when analysis completes successfully. Returns XFAiSalesGoalInsight.")),
        new("OnError", L.Text("Disparado quando ocorre erro na analise. Retorna mensagem de erro.", "Fired when analysis encounters an error. Returns error message."))
    ];

    // === ACCESSIBILITY ===
    private IReadOnlyList<DocTile> AccessibilityItems => [
        new(L.Text("role=region", "role=region"), L.Text("Componente usa role=region para leitores de tela.", "Component uses role=region for screen readers."), "universal-access"),
        new(L.Text("aria-busy", "aria-busy"), L.Text("Indica estado de processamento para leitores.", "Indicates processing state for readers."), "spinner"),
        new(L.Text("role=status + aria-live", "role=status + aria-live"), L.Text("Resultado announce para leitores de tela.", "Result announces for screen readers."), "volume-high"),
        new(L.Text("aria-label na textarea", "aria-label on textarea"), L.Text("Textarea com label descritivo do placeholder.", "Textarea with descriptive placeholder label."), "font")
    ];

    private IReadOnlyList<NameValueRow> KeyboardRows => [
        new("Enter", L.Text("Envia a pergunta quando nao esta em modo multitarefa.", "Sends the question when not in multiline mode.")),
        new("Shift+Enter", L.Text("Insere nova linha na entrada de texto.", "Inserts new line in text input.")),
        new("Escape", L.Text("Limpa o texto de entrada.", "Clears the input text.")),
        new("Tab", L.Text("Navega entre textarea e botao Analisar.", "Navigates between textarea and Analyze button."))
    ];

    // === RESPONSIVENESS ===
    private IReadOnlyList<DocTile> ResponsivenessItems => [
        new(L.Text("Largura total", "Full width"), L.Text("Assistente ocupa 100% do container.", "Assistant occupies 100% of container."), "maximize"),
        new(L.Text("Grid responsivo", "Ranking e metas em colunas adaptivas."), L.Text("Ranking e metas em colunas adaptivas.", "Ranking and goals in adaptive columns."), "mobile-screen")
    ];

