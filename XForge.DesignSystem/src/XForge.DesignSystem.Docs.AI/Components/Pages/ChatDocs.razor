@page "/ai/chat"
@using XForge.DesignSystem.Services.AI
@using XForge.DesignSystem.Components.AI.Chat
@inject XForgeDocsLanguageService L

<XForgeDocsShell ProductLabel="AI Commercial"
                 Title="XFAiChat"
                 Status="@L.Text("Estavel", "Stable")"
                 Items="XForgeDocsCatalog.AiItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFAiChat" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Streaming", "Streaming")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Multi-provider", "Multi-provider")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Copilot conversacional enterprise com historico, streaming, anexos, voz e citacoes.",
                               "Enterprise conversational copilot with history, streaming, attachments, voice and citations.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("Componente de chat IA completo com suporte a multiplos providers, streaming em tempo real, historico conversacional, barra de tokens, cancelamento e acessibilidade WCAG.",
                               "Complete AI chat component with multi-provider support, real-time streaming, conversational history, token bar, cancellation and WCAG accessibility.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Streaming via SSE. Experiencia completa.", "Streaming via SSE. Full experience.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona com provider compativel.", "Works with compatible provider.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Limitado", "Limited")" /></XFTableCell><XFTableCell>@T("Streaming indisponivel. Somente OnSend.", "Streaming unavailable. OnSend only.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Chat basico", "1. Basic Chat"), T("Chat com placeholder, titulo e subtítulo.", "Chat with placeholder, title and subtitle."), ExBasicChat(), Code1)
            @Example(T("2. Com streaming e tokens", "2. With Streaming and Tokens"), T("Chat com streaming ativado e contagem de tokens.", "Chat with streaming enabled and token count."), ExStreamingChat(), Code2)
            @Example(T("3. Com anexos e voz", "3. With Attachments and Voice"), T("Chat com upload de anexos e entrada de voz habilitados.", "Chat with file attachments and voice input enabled."), ExAttachmentsChat(), Code3)
            @Example(T("4. Mensagem customizada", "4. Custom Message Template"), T("Template de mensagem customizado com cores por role.", "Custom message template with colors per role."), ExCustomMessage(), Code4)
            @Example(T("5. Sem provider (manual)", "5. Without Provider (Manual)"), T("Chat sem provider IA, usando apenas OnSend para controle manual.", "Chat without AI provider, using OnSend for manual control."), ExManualChat(), Code5)
            @Example(T("6. Chat vazio customizado", "6. Custom Empty State"), T("Estado vazio com conteudo customizado via EmptyContent.", "Empty state with custom content via EmptyContent."), ExEmptyChat(), Code6)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>

<XForgeDocsPageStandard ComponentName="ChatDocs" />

@code {
    private string T(string pt, string en) => L.Text(pt, en);

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiChat Title="Assistente Fiscal"
                  Subtitle="Ambiente de demonstracao"
                  Placeholder="Pergunte sobre conciliacao fiscal..."
                  ShowTokenUsage="true"
                  Messages="Messages" />
    </XFStack>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("Conversacional", "Conversational"), T("Chat em tempo real com historico.", "Real-time chat with history."), "comments"),
        new(T("Streaming", "Streaming"), T("Respostas token a token via SSE.", "Token-by-token responses via SSE."), "bolt"),
        new(T("Multi-provider", "Multi-provider"), T("Compativel com 8+ provedores de IA.", "Compatible with 8+ AI providers."), "plug")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFAiChat"),
        new("Namespace", "XForge.DesignSystem.Components.AI.Chat"),
        new("Package", "XForge.DesignSystem.AI"),
        new("Category", "AI / Chat"),
        new("Status", T("Estavel", "Stable")),
        new("Accessibility", "role=log, aria-live=polite, aria-label, aria-busy"),
        new("Theme support", T("Light e dark via tokens CSS.", "Light and dark via CSS tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("Chat IA", "AI Chat"), T("Interface conversacional com IA.", "Conversational interface with AI."), "comments"),
        new(T("Streaming", "Streaming"), T("Exibicao token a token em tempo real.", "Token-by-token real-time display."), "bolt"),
        new(T("Historico", "History"), T("Mensagens persistem na sessao.", "Messages persist in session."), "clock-rotate-left")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Copiloto", "Copilot"), T("Assistente IA embedded na aplicacao.", "AI assistant embedded in application."), "robot"),
        new(T("Suporte", "Support"), T("Atendimento ao cliente com IA.", "Customer support with AI."), "headset"),
        new(T("Analise", "Analysis"), T("Consulta de dados via linguagem natural.", "Data querying via natural language."), "magnifying-glass-chart")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Interfaces de chat exigiam desenvolvimento complexo do zero.", "Chat interfaces required complex from-scratch development."), "xmark"),
        new(T("Depois", "After"), T("Componente reutilizavel com streaming, historico e acessibilidade.", "Reusable component with streaming, history and accessibility."), "check"),
        new(T("Acessibilidade", "Accessibility"), T("role=log, aria-live, labels e suporte de teclado.", "role=log, aria-live, labels and keyboard support."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Copiloto enterprise", "Enterprise copilot"), T("Assistente de IA em ERP, CRM e aplicacoes internas.", "AI assistant in ERP, CRM and internal apps."), "building"),
        new(T("Atendimento", "Customer support"), T("Chatbot com historico e streaming.", "Chatbot with history and streaming."), "headset")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Mensagens simples", "Simple messages"), T("Use XFToast ou XFAlert para notificacoes.", "Use XFToast or XFAlert for notifications."), "bell"),
        new(T("Formularios", "Forms"), T("Use XFInput e XFButton para formularios.", "Use XFInput and XFButton for forms."), "pen")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new(T("Header", "Header"), T("Barra superior com titulo, subtitulo e acoes.", "Top bar with title, subtitle and actions."), "bars"),
        new(T("Mensagens", "Messages"), T("Area scrollavel com bolhas de conversa.", "Scrollable area with conversation bubbles."), "comments"),
        new(T("Composer", "Composer"), T("Textarea com botoes de envio e cancelamento.", "Textarea with send and cancel buttons."), "pen"),
        new(T("Footer", "Footer"), T("Barra inferior com uso de tokens e slots customizados.", "Bottom bar with token usage and custom slots."), "grip-lines")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(T("Conversacao natural", "Natural conversation"), T("Layout familiar de chat com bolhas e avatares.", "Familiar chat layout with bubbles and avatars."), "comments"),
        new(T("Feedback visual", "Visual feedback"), T("Indicadores de streaming, loading e erro.", "Streaming, loading and error indicators."), "eye"),
        new(T("Extensibilidade", "Extensibility"), T("Templates para mensagens, header, footer e vazio.", "Templates for messages, header, footer and empty."), "puzzle")
    ];

    // === EXAMPLES ===
    private RenderFragment ExBasicChat() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiChat Title="Assistente Fiscal"
                  Subtitle="Ambiente de demonstracao"
                  Placeholder="Pergunte sobre conciliacao fiscal..."
                  ShowTokenUsage="true"
                  Messages="Messages" />
    </XFStack>;

    private RenderFragment ExStreamingChat() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiChat Title="Chat com Streaming"
                  Streaming="true"
                  ShowTimestamps="true"
                  ShowTokenUsage="true"
                  Placeholder="Digite sua pergunta..."
                  Messages="EmptyMessages" />
    </XFStack>;

    private RenderFragment ExAttachmentsChat() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiChat Title="Chat com Anexos"
                  AllowAttachments="true"
                  AllowVoice="true"
                  Placeholder="Envie um arquivo ou fale..."
                  Messages="EmptyMessages" />
    </XFStack>;

    private RenderFragment ExCustomMessage() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiChat Title="Chat Customizado"
                  Placeholder="Digite sua mensagem..."
                  MessageTemplate="CustomMessageTemplate"
                  Messages="Messages" />
    </XFStack>;

    private RenderFragment ExManualChat() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiChat Title="Chat Manual"
                  Placeholder="OnSend sera chamado ao enviar..."
                  ShowTimestamps="false"
                  ShowCopyButton="false"
                  ShowTokenUsage="false"
                  Messages="EmptyMessages" />
    </XFStack>;

    private RenderFragment ExEmptyChat() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiChat Title="Chat com Estado Vazio"
                  EmptyContent="@EmptyStateContent"
                  Messages="EmptyMessages" />
    </XFStack>;

    private RenderFragment EmptyStateContent => @<div class="flex flex-col items-center gap-3 py-8">
        <div class="inline-flex h-16 w-16 items-center justify-center rounded-full bg-primary/10 text-primary">
            @((MarkupString)XFSvgIcons.MarkupWithSize("robot", 32))
        </div>
        <div class="text-center">
            <div class="text-sm font-semibold text-text-primary">Bem-vindo ao assistente IA</div>
            <div class="mt-1 text-xs text-text-secondary max-w-xs">Envie uma mensagem para iniciar a conversa. O assistente pode ajudar com consultas fiscais e conciliacao.</div>
        </div>
    </div>;

    private RenderFragment CustomMessageTemplate(AiMessage message) => @<div class="flex gap-3 @(message.Role == AiRole.User ? "justify-end" : "justify-start")">
        <div class="max-w-[min(34rem,80%)] rounded-lg px-4 py-3 text-sm @(message.Role == AiRole.User ? "bg-primary text-primary-contrast" : "bg-surface-100 text-text-primary ring-1 ring-border-light")">
            <div class="font-medium text-xs mb-1 opacity-70">@(message.Role == AiRole.User ? "Voce" : "IA")</div>
            @message.Content
        </div>
    </div>;

    private const string Code1 = @"<XFAiChat Title=""Assistente Fiscal""
          Subtitle=""Ambiente de demonstracao""
          Placeholder=""Pergunte sobre conciliacao fiscal...""
          ShowTokenUsage=""true""
          Messages=""@messages"" />";

    private const string Code2 = @"<XFAiChat Title=""Chat com Streaming""
          Streaming=""true""
          ShowTimestamps=""true""
          ShowTokenUsage=""true""
          Placeholder=""Digite sua pergunta..."" />";

    private const string Code3 = @"<XFAiChat Title=""Chat com Anexos""
          AllowAttachments=""true""
          AllowVoice=""true""
          Placeholder=""Envie um arquivo ou fale..."" />";

    private const string Code4 = @"<XFAiChat Title=""Chat Customizado""
          Placeholder=""Digite sua mensagem...""
          MessageTemplate=""@CustomMessageTemplate""
          Messages=""@messages"" />";

    private const string Code5 = @"<XFAiChat Title=""Chat Manual""
          Placeholder=""OnSend sera chamado ao enviar...""
          ShowTimestamps=""false""
          ShowCopyButton=""false""
          ShowTokenUsage=""false""
          OnSend=""@HandleSend"" />";

    private const string Code6 = @"<XFAiChat Title=""Chat com Estado Vazio""
          EmptyContent=""@EmptyStateContent"" />";

    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("Messages", "IReadOnlyList<AiMessage>", "[]", T("Historico conversacional.", "Conversational history.")),
        new("Placeholder", "string", T("'Digite sua mensagem...'", "'Type your message...'"), T("Texto do placeholder do input.", "Input placeholder text.")),
        new("Provider", "IAiProvider?", "null", T("Provider IA para respostas automaticas.", "AI provider for automatic responses.")),
        new("Streaming", "bool", "true", T("Habilita streaming token a token.", "Enables token-by-token streaming.")),
        new("AllowAttachments", "bool", "false", T("Permite upload de anexos.", "Allows file attachments.")),
        new("AllowVoice", "bool", "false", T("Permite entrada de voz.", "Allows voice input.")),
        new("Temperature", "double?", "null", T("Temperatura do modelo.", "Model temperature.")),
        new("MaxTokens", "int?", "null", T("Limite maximo de tokens.", "Maximum token limit.")),
        new("SystemPrompt", "string?", "null", T("Prompt de sistema prepended.", "System prompt prepended.")),
        new("Model", "string?", "null", T("Identificador do modelo.", "Model identifier.")),
        new("ShowHeader", "bool", "true", T("Exibe barra de cabecalho.", "Shows header bar.")),
        new("Title", "string", T("'Assistente IA'", "'AI Assistant'"), T("Titulo do cabecalho.", "Header title.")),
        new("Subtitle", "string", "''", T("Subtitulo do cabecalho.", "Header subtitle.")),
        new("ShowTimestamps", "bool", "true", T("Exibe timestamps nas mensagens.", "Shows timestamps on messages.")),
        new("ShowCopyButton", "bool", "true", T("Exibe botao copiar nas respostas.", "Shows copy button on responses.")),
        new("ShowTokenUsage", "bool", "false", T("Exibe contagem de tokens no footer.", "Shows token count in footer.")),
        new("EmptyContent", "RenderFragment?", "null", T("Conteudo do estado vazio.", "Empty state content.")),
        new("HeaderContent", "RenderFragment?", "null", T("Conteudo customizado do cabecalho.", "Custom header content.")),
        new("MessageTemplate", "RenderFragment<AiMessage>?", "null", T("Template customizado de mensagem.", "Custom message template.")),
        new("FooterContent", "RenderFragment?", "null", T("Conteudo customizado do footer.", "Custom footer content.")),
        new("SendLabel", "string", T("'Enviar mensagem'", "'Send message'"), T("Label do botao enviar (aria-label).", "Send button aria-label.")),
        new("CancelLabel", "string", T("'Cancelar'", "'Cancel'"), T("Label do botao cancelar (aria-label).", "Cancel button aria-label.")),
        new("CopyLabel", "string", T("'Copiar mensagem'", "'Copy message'"), T("Label do botao copiar (aria-label).", "Copy button aria-label."))
    ];

