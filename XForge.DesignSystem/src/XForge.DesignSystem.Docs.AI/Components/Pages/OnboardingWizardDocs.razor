    // === ANTI-PATTERNS ===
    private IReadOnlyList<DocTile> AntiPatternItems => [
        new(L.Text("Muitas etapas", "Too many steps"), L.Text("Evite mais de 7 etapas. Divida em wizards separados.", "Avoid more than 7 steps. Split into separate wizards."), "ban"),
        new(L.Text("Sem progresso", "No progress"), L.Text("Sem indicador visual, usuario se perde.", "Without visual indicator, user gets lost."), "xmark"),
