    ];

    // === BEST PRACTICES ===
    private IReadOnlyList<DocTile> BestPracticeItems => [
        new(L.Text("Titulo claro", "Clear title"), L.Text("Descreva o objetivo de cada etapa.", "Describe the objective of each step."), "heading"),
        new(L.Text("Etapas pular", "Skip steps"), L.Text("Marque etapas nao-essenciais como CanSkip.", "Mark non-essential steps as CanSkip."), "forward"),
        new(L.Text("Progresso visivel", "Visible progress"), L.Text("Mostre barra de progresso para motivar.", "Show progress bar to motivate."), "bars"),
        new(L.Text("Feedback ao concluir", "Completion feedback"), L.Text("Use OnCompleted para persistir dados.", "Use OnCompleted to persist data."), "check")
