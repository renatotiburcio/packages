    // === TOKENS ===
    private IReadOnlyList<NameValueRow> TokenRows => [
        new("container", L.Text("rounded-lg border border-border-light bg-bg-surface shadow.", "rounded-lg border border-border-light bg-bg-surface shadow.")),
        new("header", L.Text("flex items-center justify-between border-b px-4 py-3.", "flex items-center justify-between border-b px-4 py-3.")),
        new("step-dot", L.Text("inline-flex h-7 w-7 items-center justify-center rounded-full.", "inline-flex h-7 w-7 items-center justify-center rounded-full.")),
        new("navigation", L.Text("flex items-center justify-between gap-3 pt-2.", "flex items-center justify-between gap-3 pt-2."))
    ];

    // === THEMING ===
    private IReadOnlyList<DocTile> ThemeItems => [
        new("data-theme", L.Text("Tokens light/dark via CSS variables.", "Light/dark tokens via CSS variables."), "moon"),
        new("data-brand", L.Text("Primary acompanha marca ativa.", "Primary follows active brand."), "swatchbook")
    ];

    // === TESTING ===
    private IReadOnlyList<NameValueRow> TestingRows => [
