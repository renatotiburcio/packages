@page "/ai/onboarding-wizard"
@using XForge.DesignSystem.Components.AI.Avatars
@inject XForgeDocsLanguageService L

<XForgeDocsShell ProductLabel="AI Commercial"
                 Title="@L.Text("Onboarding Wizard", "Onboarding Wizard")"
                 Status="@L.Text("Documentacao completa", "Complete docs")"
                 Items="XForgeDocsCatalog.AiItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFAiOnboardingWizard" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@L.Text("Wizard guiado por AI", "AI-driven wizard")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @L.Text("Wizard guiado por AI para configuracao inicial e descoberta de requisitos.",
                                   "AI-driven wizard for initial setup and requirements discovery.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @L.Text("Assistente interativo multi-etapas com progresso visual, navegacao, pular etapas, templates dinamicos e callback de conclusao. Ideal para onboarding de usuarios em ERP e plataformas enterprise.",
                                   "Interactive multi-step assistant with visual progress, navigation, skip support, dynamic templates, and completion callback. Ideal for user onboarding in ERP and enterprise platforms.")
                        </XFTypography>
                    </XFStack>
                    <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                        <XFAiOnboardingWizard Title="Configuracao Inicial"
                                              ShowHeader="true"
                                              ShowProgress="true"
                                              AriaLabel="Assistente de configuracao"
                                              BackLabel="Voltar"
                                              NextLabel="Proximo"
                                              SkipLabel="Pular"
                                              FinishLabel="Concluir"
                                              Steps="DemoSteps" />
                    </div>
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="3" Wrap="XFWrap.Wrap">
                        @foreach (var item in QuickFacts) { @Tile(item) }
                    </XFStack>
                </XFStack>
            </ChildContent>
        </XFCard>

        <!-- ===== 2. METADATA ===== -->
        @Section(L.Text("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, L.Text("Campo", "Field"), L.Text("Valor", "Value"))</div>)

        <!-- ===== 3. COMPATIBILITY ===== -->
        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@L.Text("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@L.Text("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@L.Text("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@L.Text("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Renderiza como HTML estatico.", "Renders as static HTML.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@L.Text("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@L.Text("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS.")</XFTypography>
            </XFStack>
        </div>)

        <!-- ===== 4-13. CORE SECTIONS ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(L.Text("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(L.Text("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(L.Text("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(L.Text("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(L.Text("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(L.Text("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 3 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(L.Text("1. Wizard basico", "1. Basic wizard"), L.Text("Wizard com 3 etapas, navegacao e pular.", "Wizard with 3 steps, navigation and skip."), ExBasic(), CodeBasic)
            @Example(L.Text("2. Etapas com template", "2. Steps with template"), L.Text("Template dinamico para renderizar conteudo por etapa.", "Dynamic template to render content per step."), ExStepTemplate(), CodeStepTemplate)
            @Example(L.Text("3. Wizard sem header", "3. Wizard without header"), L.Text("Wizard compacto sem indicador de progresso.", "Compact wizard without progress indicator."), ExCompact(), CodeCompact)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(L.Text("Eventos", "Events"), @<div>@NameValueTable(EventRows, L.Text("Evento", "Event"), L.Text("Comportamento", "Behavior"))</div>)
            @Section(L.Text("Tipos", "Types"), @<div>@NameValueTable(TypeRows, L.Text("Tipo", "Type"), L.Text("Descricao", "Description"))</div>)
        </XFStack>

        <!-- ===== A11Y + UX ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(L.Text("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, L.Text("Tecla", "Key"), L.Text("Comportamento", "Behavior"))</div>)
            @Section(L.Text("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(L.Text("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <!-- ===== ENTERPRISE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(L.Text("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(L.Text("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(L.Text("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <!-- ===== TOKENS + THEMING + TESTING ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", L.Text("Proposito", "Purpose"))</div>)
            @Section(L.Text("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(L.Text("Testes", "Testing"), @<div>@NameValueTable(TestingRows, L.Text("Cobertura", "Coverage"), L.Text("Evidencia", "Evidence"))</div>)
            @Section(L.Text("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, L.Text("Limitacao", "Limitation"), L.Text("Status", "Status"))</div>)
            @Section(L.Text("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, L.Text("Pergunta", "Question"), L.Text("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, L.Text("Versao", "Version"), L.Text("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string T(string pt, string en) => L.Text(pt, en);
    private string CopyableCodeTitle => L.Text("Codigo copiavel", "Copyable code");

    // === DEMO DATA ===
    private static readonly IReadOnlyList<XFAiOnboardingStep> DemoSteps = new[]
    {
        new XFAiOnboardingStep { Id = "welcome", Title = "Bem-vindo", Description = "Configuracao inicial do sistema", IconName = "1", CanSkip = false },
        new XFAiOnboardingStep { Id = "profile", Title = "Perfil", Description = "Preencha seus dados", IconName = "2", CanSkip = true },
        new XFAiOnboardingStep { Id = "preferences", Title = "Preferencias", Description = "Personalize sua experiencia", IconName = "3", CanSkip = true }
    };

    // === HERO ===
    private IReadOnlyList<DocTile> QuickFacts => [
        new(L.Text("Multi-etapas", "Multi-step"), L.Text("Navegacao sequencial com progresso.", "Sequential navigation with progress."), "list-ol"),
        new(L.Text("Pular etapas", "Skip steps"), L.Text("Etapas opcionais com suporte a pular.", "Optional steps with skip support."), "forward"),
        new(L.Text("Templates dinamicos", "Dynamic templates"), L.Text("StepTemplate para conteudo customizado por etapa.", "StepTemplate for custom content per step."), "puzzle")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFAiOnboardingWizard"),
        new("Namespace", "XForge.DesignSystem.Components.AI.Avatars"),
        new("Package", "XForge.DesignSystem.AI"),
        new("Category", "AI / Onboarding"),
        new("Status", L.Text("Estavel", "Stable")),
        new("Accessibility", "role=region, aria-label, aria-busy, aria-current=step."),
        new("Theme support", L.Text("Light, dark e data-brand via tokens.", "Light, dark and data-brand via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(L.Text("Wizard guiado por AI", "AI-driven wizard"), L.Text("Configuracao inicial com assistencia inteligente.", "Initial setup with intelligent assistance."), "robot"),
        new(L.Text("Multi-etapas", "Multi-step"), L.Text("Navegacao sequencial com barra de progresso.", "Sequential navigation with progress bar."), "list-ol"),
        new(L.Text("Templates dinamicos", "Dynamic templates"), L.Text("Conteudo customizavel por etapa via RenderFragment.", "Customizable content per step via RenderFragment."), "puzzle")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(L.Text("Onboarding", "Onboarding"), L.Text("Guiar novo usuario na configuracao do sistema.", "Guide new user through system setup."), "user-plus"),
        new(L.Text("Descoberta de requisitos", "Requirements discovery"), L.Text("Coletar informacoes do usuario passo a passo.", "Collect user information step by step."), "magnifying-glass"),
        new(L.Text("Configuracao de ERP", "ERP setup"), L.Text("Setup de empresa, filial, serie e parametros fiscais.", "Company, branch, series and tax parameters setup."), "gear")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(L.Text("Antes", "Before"), L.Text("Formularios longos sem orientacao.", "Long forms without guidance."), "xmark"),
        new(L.Text("Depois", "After"), L.Text("Wizard guiado com progresso e navegacao.", "Guided wizard with progress and navigation."), "check"),
        new(L.Text("Acessibilidade", "Accessibility"), L.Text("role=region, aria-label, aria-current=step.", "role=region, aria-label, aria-current=step."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(L.Text("Onboarding de usuario", "User onboarding"), L.Text("Primeira execucao do sistema.", "First system execution."), "user-plus"),
        new(L.Text("Configuracao multi-etapa", "Multi-step setup"), L.Text("Setup que requer varias decisoes.", "Setup requiring multiple decisions."), "gear")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(L.Text("Formulario simples", "Simple form"), L.Text("Use XFInput/ XFSelect para 1-2 campos.", "Use XFInput/XFSelect for 1-2 fields."), "xmark"),
        new(L.Text("Navegacao entre paginas", "Page navigation"), L.Text("Use XFSteps para etapas separadas em paginas.", "Use XFSteps for separate page steps."), "route")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new("Header", L.Text("Titulo, indice e conteudo customizado.", "Title, index and custom content."), "heading"),
        new("Progress", L.Text("Barra de indicadores com dots e linhas.", "Indicator bar with dots and lines."), "bars"),
        new("Step Content", L.Text("Conteudo da etapa atual via StepTemplate.", "Current step content via StepTemplate."), "square"),
        new("Navigation", L.Text("Botoes Voltar, Proximo, Pular e Concluir.", "Back, Next, Skip and Finish buttons."), "arrow-right")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(L.Text("Progresso visivel", "Visible progress"), L.Text("Indicador mostra posicao atual e concluidas.", "Indicator shows current and completed position."), "eye"),
        new(L.Text("Flexibilidade", "Flexibility"), L.Text("Etapas pular obrigatorias e opcionais.", "Skip mandatory and optional steps."), "forward"),
        new(L.Text("Simplicidade", "Simplicity"), L.Text("Uma etapa por vez. Sem sobrecarga cognitiva.", "One step at a time. No cognitive overload."), "minimize")
    ];

    // === EXAMPLES ===
    private RenderFragment ExBasic() => @<XFAiOnboardingWizard Title="Wizard Basico"
                                                               Steps="DemoSteps"
                                                               ShowHeader="true"
                                                               ShowProgress="true"
                                                               AriaLabel="Wizard basico" />;

    private RenderFragment ExStepTemplate() => @<XFAiOnboardingWizard Title="Com Template"
                                                                      Steps="DemoSteps"
                                                                      ShowHeader="true"
                                                                      ShowProgress="true"
                                                                      AriaLabel="Wizard com template">
        <StepTemplate>
            <div class="rounded-lg border border-border-light bg-surface-50 p-4">
                <p class="text-sm text-text-secondary">@context.Description</p>
            </div>
        </StepTemplate>
    </XFAiOnboardingWizard>;

    private RenderFragment ExCompact() => @<XFAiOnboardingWizard Title="Compacto"
                                                                  Steps="DemoSteps"
                                                                  ShowHeader="false"
                                                                  ShowProgress="false"
                                                                  AriaLabel="Wizard compacto" />;

    private const string CodeBasic = @"<XFAiOnboardingWizard Title=""Wizard Basico""
    Steps=""@Steps""
    ShowHeader=""true""
    ShowProgress=""true""
    AriaLabel=""Wizard basico"" />";

    private const string CodeStepTemplate = @"<XFAiOnboardingWizard Title=""Com Template""
    Steps=""@Steps""
    ShowHeader=""true""
    ShowProgress=""true"">
    <StepTemplate>
        <div class=""rounded-lg border border-border-light bg-surface-50 p-4"">
            <p class=""text-sm text-text-secondary"">@context.Description</p>
        </div>
    </StepTemplate>
</XFAiOnboardingWizard>";

    private const string CodeCompact = @"<XFAiOnboardingWizard Title=""Compacto""
    Steps=""@Steps""
    ShowHeader=""false""
    ShowProgress=""false""
    AriaLabel=""Wizard compacto"" />";

    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("Steps", "IReadOnlyList<XFAiOnboardingStep>", "[]", L.Text("Lista de etapas do wizard.", "List of wizard steps.")),
        new("Title", "string", "\"Configuracao Inicial\"", L.Text("Titulo exibido no header.", "Title displayed in header.")),
        new("ShowHeader", "bool", "true", L.Text("Exibe o header com titulo e indice.", "Shows header with title and index.")),
        new("ShowProgress", "bool", "true", L.Text("Exibe barra de progresso com dots.", "Shows progress bar with dots.")),
        new("BackLabel", "string", "\"Voltar\"", L.Text("Label do botao voltar.", "Back button label.")),
        new("NextLabel", "string", "\"Proximo\"", L.Text("Label do botao proximo.", "Next button label.")),
        new("SkipLabel", "string", "\"Pular\"", L.Text("Label do botao pular.", "Skip button label.")),
        new("FinishLabel", "string", "\"Concluir\"", L.Text("Label do botao concluir.", "Finish button label.")),
        new("AriaLabel", "string", "\"Assistente de configuracao\"", L.Text("Label ARIA para o wizard.", "ARIA label for the wizard.")),
        new("StepTemplate", "RenderFragment<XFAiOnboardingStep>?", "null", L.Text("Template customizado para cada etapa.", "Custom template for each step.")),
        new("ChildContent", "RenderFragment?", "null", L.Text("Conteudo padrao quando StepTemplate e nulo.", "Default content when StepTemplate is null."))
    ];

    private IReadOnlyList<NameValueRow> EventRows => [
        new("OnStepChanged", L.Text("Disparado ao mudar de etapa. Retorna XFAiOnboardingStepChangedEventArgs com PreviousStep, CurrentStep, WasSkipped.", "Fired on step change. Returns XFAiOnboardingStepChangedEventArgs with PreviousStep, CurrentStep, WasSkipped.")),
        new("OnCompleted", L.Text("Disparado ao concluir o wizard. Retorna XFAiOnboardingCompletedEventArgs com StepsCompleted, StepsSkipped, Duration.", "Fired on wizard completion. Returns XFAiOnboardingCompletedEventArgs with StepsCompleted, StepsSkipped, Duration.")),
        new("OnStepSkipped", L.Text("Disparado ao pular uma etapa. Retorna a XFAiOnboardingStep pulada.", "Fired when a step is skipped. Returns the skipped XFAiOnboardingStep."))
    ];

    private IReadOnlyList<NameValueRow> TypeRows => [
        new("XFAiOnboardingStep", L.Text("Record com Id, Title, Description, IconName, State, CanSkip, IsAiDriven, AiPrompt, ContentKey.", "Record with Id, Title, Description, IconName, State, CanSkip, IsAiDriven, AiPrompt, ContentKey.")),
        new("XFAiOnboardingStepState", L.Text("Enum: Pending, Active, Completed, Skipped.", "Enum: Pending, Active, Completed, Skipped.")),
        new("XFAiOnboardingStepChangedEventArgs", L.Text("Record com PreviousStep, CurrentStep, WasSkipped, Timestamp.", "Record with PreviousStep, CurrentStep, WasSkipped, Timestamp.")),
        new("XFAiOnboardingCompletedEventArgs", L.Text("Record com StepsCompleted, StepsSkipped, Duration, Timestamp.", "Record with StepsCompleted, StepsSkipped, Duration, Timestamp."))
    ];

    // === ACCESSIBILITY ===
    private IReadOnlyList<DocTile> AccessibilityItems => [
        new("role=region", L.Text("Container principal usa role=region.", "Main container uses role=region."), "universal-access"),
        new("aria-label", L.Text("Label descritivo do wizard.", "Descriptive wizard label."), "tag"),
        new("aria-current=step", L.Text("Dot ativo indica etapa atual.", "Active dot indicates current step."), "circle"),
        new("aria-busy", L.Text("Indica estado de processamento.", "Indicates processing state."), "spinner")
    ];

    private IReadOnlyList<NameValueRow> KeyboardRows => [
        new("Tab", L.Text("Navega entre botoes de etapa e navegacao.", "Navigates between step and navigation buttons.")),
        new("Enter/Space", L.Text("Ativa botao de etapa ou navegacao.", "Activates step or navigation button.")),
        new("Esc", L.Text("Nao fecha o wizard (obrigatorio concluir ou pular).", "Does not close wizard (must complete or skip)."))
    ];

    // === RESPONSIVENESS ===
    private IReadOnlyList<DocTile> ResponsivenessItems => [
        new(L.Text("Largura total", "Full width"), L.Text("Wizard ocupa 100% do container.", "Wizard occupies 100% of container."), "maximize"),
        new(L.Text("Botoes responsivos", "Responsive buttons"), L.Text("Botoes empilham em mobile.", "Buttons stack on mobile."), "mobile-screen")
    ];

    // === PERFORMANCE ===
    private IReadOnlyList<DocTile> PerformanceItems => [
        new(L.Text("Zero JS", "Zero JS"), L.Text("Nenhum JavaScript interop.", "No JavaScript interop."), "bolt"),
        new(L.Text("Render leve", "Light render"), L.Text("Componente leve sem wrappers desnecessarios.", "Light component without unnecessary wrappers."), "feather")
    ];

    // === SCENARIOS ===
    private IReadOnlyList<DocTile> ScenarioItems => [
        new(L.Text("Setup de empresa", "Company setup"), L.Text("CNPJ, inscricao estadual, endereco, regime tributario.", "CNPJ, state registration, address, tax regime."), "building"),
        new(L.Text("Configuracao fiscal", "Tax setup"), L.Text("Serie, modelo de NF-e, certificado digital, ambientes.", "Series, NF-e model, digital certificate, environments."), "file-invoice"),
        new(L.Text("Onboarding de usuario", "User onboarding"), L.Text("Perfil, preferencias, permissoes, notificacoes.", "Profile, preferences, permissions, notifications."), "user-plus")
    ];

    // === COMPOSITION ===
    private IReadOnlyList<DocTile> CompositionItems => [
        new(L.Text("Wizard + XFInput", "Wizard + XFInput"), L.Text("Campos de formulario dentro do StepTemplate.", "Form fields inside StepTemplate."), "text-input"),
        new(L.Text("Wizard + XFSelect", "Wizard + XFSelect"), L.Text("Selecao de opcoes por etapa.", "Option selection per step."), "list"),
