        new(T("Insights", "Insights"), T("Lista de insights com icones, confianca e acoes.", "Insight list with icons, confidence and actions."), "lightbulb"),
        new(T("Confidence", "Confidence"), T("Barra de confianca por insight com cor por tipo.", "Confidence bar per insight with color by type."), "chart-bar")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(T("Analise assistida", "Assisted analysis"), T("IA sugere, usuario decide.", "AI suggests, user decides."), "brain"),
        new(T("Cores por tipo", "Colors by type"), T("Cada tipo de insight tem cor visual distinta.", "Each insight type has distinct visual color."), "palette"),
        new(T("Confianca visivel", "Visible confidence"), T("Barra de confianca em cada insight.", "Confidence bar on each insight."), "chart-bar")
    ];

    // === EXAMPLES ===
    private RenderFragment ExBasic() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiDataGridAssistant Title="Assistente de pedidos"
                               Columns="Columns"
                               Data="Rows"
                               Placeholder="Quais pedidos estao fora do SLA?"
                               MaxResults="3" />
