          MaxResults=""2""
          Placeholder=""Quais sao os KPIs principais?"" />";

    private const string Code4 = @"<XFAiDataGridAssistant Title=""Template customizado""
          Columns=""@columns""
          Data=""@rows""
          InsightTemplate=""@CustomInsightTemplate""
          Placeholder=""Analise seus dados..."" />";

    private const string Code5 = @"<XFAiDataGridAssistant Title=""Estado vazio""
          Columns=""@columns""
          EmptyContent=""@EmptyCustomContent""
          EmptyText=""Nenhum dado analisado ainda."" />";

    private const string Code6 = @"<XFAiDataGridAssistant Title=""Sem provider""
          Columns=""@columns""
          Data=""@rows""
          Placeholder=""Apenas callbacks serao chamados...""
          OnQueryGenerated=""@HandleQuery""
          OnInsightFound=""@HandleInsight"" />";

    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("Provider", "IAiProvider?", "null", T("Provider IA para analise de dados.", "AI provider for data analysis.")),
        new("Data", "IEnumerable<object>?", "null", T("Dados do grid para contexto.", "Grid data for context.")),
        new("Columns", "IReadOnlyList<string>?", "null", T("Nomes das colunas para contexto.", "Column names for context.")),
        new("Placeholder", "string", T("'Pergunte sobre seus dados...'", "'Ask about your data...'"), T("Texto do placeholder do input.", "Input placeholder text.")),
