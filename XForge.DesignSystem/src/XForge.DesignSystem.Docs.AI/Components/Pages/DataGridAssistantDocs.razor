                               Placeholder="Analise os pedidos e encontre anomalias..."
                               MaxResults="5" />
    </XFStack>;

    private RenderFragment ExLimited() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiDataGridAssistant Title="Limite de 2 insights"
                               Columns="Columns"
                               Data="Rows"
                               MaxResults="2"
                               Placeholder="Quais sao os KPIs principais?" />
    </XFStack>;

    private RenderFragment ExCustomInsight() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
