        <XFAiDataGridAssistant Title="Sem provider"
                               Columns="Columns"
                               Data="Rows"
                               Placeholder="Apenas callbacks serao chamados..." />
    </XFStack>;

    private RenderFragment EmptyCustomContent => @<div class="flex flex-col items-center gap-3 py-8">
        <div class="inline-flex h-16 w-16 items-center justify-center rounded-full bg-primary/10 text-primary">
            @((MarkupString)XFSvgIcons.MarkupWithSize("brain", 32))
        </div>
        <div class="text-center">
            <div class="text-sm font-semibold text-text-primary">Pronto para analisar</div>
            <div class="mt-1 text-xs text-text-secondary max-w-xs">Envie uma pergunta sobre seus dados e receba insights automaticos.</div>
        </div>
