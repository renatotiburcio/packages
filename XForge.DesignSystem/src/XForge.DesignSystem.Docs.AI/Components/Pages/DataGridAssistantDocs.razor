        new(T("Acessibilidade", "Accessibility"), T("role=complementary, aria-label, role=list.", "role=complementary, aria-label, role=list."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Dashboards", "Dashboards"), T("Enriquecimento de grids com insights IA.", "Grid enrichment with AI insights."), "chart-bar"),
        new(T("ERP", "ERP"), T("Analise de dados operacionais via linguagem natural.", "Operational data analysis via natural language."), "building")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Operacoes em massa", "Bulk operations"), T("Use ETL para transformacao de dados em massa.", "Use ETL for bulk data transformation."), "arrows-left-right"),
        new(T("Substituicao de BI", "BI replacement"), T("Complementa BI, nao substitui dashboards complexos.", "Complements BI, does not replace complex dashboards."), "chart-pie")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
