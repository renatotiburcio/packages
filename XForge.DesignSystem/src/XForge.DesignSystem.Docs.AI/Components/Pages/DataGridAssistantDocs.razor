            <div class="text-sm font-semibold text-text-primary">@insight.Title</div>
            <div class="text-xs text-text-secondary">@insight.Description</div>
        </div>
    </div>;

    private const string Code1 = @"<XFAiDataGridAssistant Title=""Assistente de pedidos""
          Columns=""@columns""
          Data=""@rows""
          Placeholder=""Quais pedidos estao fora do SLA?""
          MaxResults=""3"" />";

    private const string Code2 = @"<XFAiDataGridAssistant Title=""Analise com IA""
