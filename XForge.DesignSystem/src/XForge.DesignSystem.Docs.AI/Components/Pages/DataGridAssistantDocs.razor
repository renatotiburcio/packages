        <XFAiDataGridAssistant Title="Assistente de pedidos"
                               Columns="Columns"
                               Data="Rows"
                               Placeholder="Quais pedidos estao fora do SLA?"
                               MaxResults="3" />
    </XFStack>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("Analise IA", "AI analysis"), T("Insights automaticos de dados.", "Automatic data insights."), "brain"),
        new(T("6 tipos", "6 types"), T("Pattern, Anomaly, KPI, Trend, Summary, Recommendation.", "Pattern, Anomaly, KPI, Trend, Summary, Recommendation."), "layer-group"),
        new(T("Filtros NL", "NL filters"), T("Filtros, ordenacao e agrupamento em linguagem natural.", "Filters, sorting and grouping in natural language."), "filter")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFAiDataGridAssistant"),
        new("Namespace", "XForge.DesignSystem.Components.AI.DataGrid"),
        new("Package", "XForge.DesignSystem.AI"),
        new("Category", "AI / DataGrid"),
        new("Status", T("Estavel", "Stable")),
        new("Accessibility", "role=complementary, aria-label, aria-busy, role=progressbar, role=list"),
        new("Theme support", T("Light e dark via tokens CSS.", "Light and dark via CSS tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
