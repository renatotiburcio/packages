        new(T("Insights", "Insights"), T("Padroes, anomalias, KPIs e recomendacoes.", "Patterns, anomalies, KPIs and recommendations."), "lightbulb"),
        new(T("Filtros NL", "NL filters"), T("Consulta de dados via linguagem natural.", "Data querying via natural language."), "filter")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Analise de pedidos", "Order analysis"), T("Filtros e insights de pedidos em tempo real.", "Real-time order filters and insights."), "cart-shopping"),
        new(T("Monitoramento KPI", "KPI monitoring"), T("Extracao automatica de indicadores.", "Automatic indicator extraction."), "gauge"),
        new(T("Deteccao de anomalias", "Anomaly detection"), T("Identificacao automatica de outliers.", "Automatic outlier identification."), "triangle-exclamation")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Analise de dados exigia SQL ou ferramentas BI complexas.", "Data analysis required SQL or complex BI tools."), "xmark"),
