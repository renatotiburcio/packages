    // === RELATED ===
    private IReadOnlyList<DocTile> RelatedComponentItems => [
        new("XFAiVideoAnalyzer", T("Analise de video por frames.", "Video analysis by frames."), "video"),
        new("XFAiDocumentReader", T("Leitura de documentos AI.", "AI document reading."), "file-lines"),
        new("XFAiMultiModalChat", T("Chat multimodal com imagens.", "Multimodal chat with images."), "comment-dots")
    ];

    // === FAQ ===
    private IReadOnlyList<NameValueRow> FaqRows => [
        new(T("Qual a diferenca entre OCR e ReadDocument?", "What is the difference between OCR and ReadDocument?"), T("OCR extrai qualquer texto. ReadDocument e otimizado para documentos fiscais/comerciais.", "OCR extracts any text. ReadDocument is optimized for fiscal/commercial documents.")),
