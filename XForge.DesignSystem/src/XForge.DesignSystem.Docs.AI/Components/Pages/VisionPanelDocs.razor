    // === TOKENS ===
    private IReadOnlyList<NameValueRow> TokenRows => [
        new("xf-ai-vision-panel", T("Container principal com role=region.", "Main container with role=region.")),
        new("border-dashed", T("Area de upload com borda tracejada.", "Upload area with dashed border.")),
        new("bg-indigo-600", T("Botao Analisar com cor primaria.", "Analyze button with primary color.")),
