@page "/ai/vision-panel"
@inject XForgeDocsLanguageService L

<XForgeDocsShell ProductLabel="AI Commercial"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.AiItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFAiVisionPanel" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("6 modos de analise", "6 analysis modes")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Provider via DI", "Provider via DI")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Painel de analise visual AI com upload, OCR, deteccao de objetos e comparacao.",
                               "AI vision analysis panel with upload, OCR, object detection and comparison.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("Componente enterprise para analise multimodal de imagens via IAiVisionProvider. Suporta 6 modos de analise, upload multiplo, barra de confianca e resultado estruturado.",
                               "Enterprise component for multimodal image analysis via IAiVisionProvider. Supports 6 analysis modes, multiple uploads, confidence bar and structured results.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona com IAiVisionProvider via DI.", "Works with IAiVisionProvider via DI.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona com IAiVisionProvider via DI.", "Works with IAiVisionProvider via DI.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Limitado", "Limited")" /></XFTableCell><XFTableCell>@T("Upload e analise requerem interatividade.", "Upload and analysis require interactivity.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Dependencia JS", "JS Dependency")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop para renderizacao. O upload de arquivos requer JS interop em producao.", "This component does not use JavaScript interop for rendering. File upload requires JS interop in production.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 3 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Analise basica", "1. Basic Analysis"), T("Painel com seletor de tipo e upload de imagem.", "Panel with type selector and image upload."), ExBasic(), Code1)
            @Example(T("2. OCR de documento", "2. Document OCR"), T("Extração de texto de documentos fiscais.", "Text extraction from fiscal documents."), ExOcr(), Code2)
            @Example(T("3. Comparacao de imagens", "3. Image Comparison"), T("Comparacao lado a lado de duas imagens.", "Side-by-side comparison of two images."), ExCompare(), Code3)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Metodos", "Methods"), @<div>@NameValueTable(MethodRows, T("Metodo", "Method"), T("Descricao", "Description"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string PageTitleText => T("XFVisionPanel", "XFVisionPanel");
    private string PageStatusText => T("Documentacao completa", "Complete docs");
    private string T(string pt, string en) => L.Text(pt, en);
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiVisionPanel Title="Analise de comprovante"
                         Placeholder="Descreva o que deve ser validado na imagem..."
                         MaxImages="3"
                         ShowAnalysisTypeSelector="true" />
    </XFStack>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("6 modos de analise", "6 analysis modes"), T("Describe, OCR, DetectObjects, AnalyzeChart, ReadDocument, Compare.", "Describe, OCR, DetectObjects, AnalyzeChart, ReadDocument, Compare."), "eye"),
        new(T("Upload multiplo", "Multiple uploads"), T("MaxImages controla o limite. Drag-and-drop e preview.", "MaxImages controls the limit. Drag-and-drop and preview."), "upload"),
        new(T("Barra de confianca", "Confidence bar"), T("Visualiza o score de confianca da analise AI.", "Visualizes the AI analysis confidence score."), "chart-simple")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFAiVisionPanel"),
        new("Namespace", "XForge.DesignSystem.Components.AI.Vision"),
        new("Package", "XForge.DesignSystem.AI"),
        new("Category", "AI / Vision"),
        new("Status", T("Estavel", "Stable")),
        new("Accessibility", T("role=region, aria-label, aria-busy, aria-live, role=radiogroup, aria-checked.", "role=region, aria-label, aria-busy, aria-live, role=radiogroup, aria-checked.")),
        new("Theme support", T("Light e dark via Tailwind CSS.", "Light and dark via Tailwind CSS."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("Analise visual AI", "AI vision analysis"), T("Upload de imagens e analise via IAiVisionProvider.", "Image upload and analysis via IAiVisionProvider."), "eye"),
        new(T("6 modos", "6 modes"), T("Describe, OCR, Objects, Chart, Document, Compare.", "Describe, OCR, Objects, Chart, Document, Compare."), "list-check"),
        new(T("Resultado estruturado", "Structured result"), T("Texto, dados JSON e score de confianca.", "Text, JSON data and confidence score."), "brackets-curly")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("OCR de notas", "Invoice OCR"), T("Extrair texto de notas fiscais e cupons.", "Extract text from invoices and receipts."), "file-invoice"),
        new(T("Deteccao de objetos", "Object detection"), T("Identificar e classificar objetos em imagens.", "Identify and classify objects in images."), "cubes"),
        new(T("Comparacao", "Comparison"), T("Comparar duas ou mais imagens lado a lado.", "Compare two or more images side by side."), "scale-balanced")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Analise manual de documentos e imagens.", "Manual analysis of documents and images."), "xmark"),
        new(T("Depois", "After"), T("Analise automatica com 6 modos e confianca.", "Automatic analysis with 6 modes and confidence."), "check"),
        new(T("Acessibilidade", "Accessibility"), T("role=region, aria-busy, aria-live para resultados.", "role=region, aria-busy, aria-live for results."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Conciliacao fiscal", "Fiscal reconciliation"), T("OCR automatico de NF-e, CT-e e MDF-e.", "Automatic OCR of NF-e, CT-e and MDF-e."), "file-invoice"),
        new(T("Controle de qualidade", "Quality control"), T("Deteccao de defeitos em imagens de produtos.", "Defect detection in product images."), "magnifying-glass")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Analise de video", "Video analysis"), T("Use XFAiVideoAnalyzer para frames de video.", "Use XFAiVideoAnalyzer for video frames."), "video"),
        new(T("Aprovacao de acoes", "Action approval"), T("Use XFAiHumanApprovalCard para decisoes humanas.", "Use XFAiHumanApprovalCard for human decisions."), "user-shield")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new(T("Header", "Header"), T("Titulo, icone e conteudo customizavel via HeaderContent.", "Title, icon and customizable content via HeaderContent."), "heading"),
        new(T("Seletor de tipo", "Type selector"), T("6 botoes radiogroup para modo de analise.", "6 radiogroup buttons for analysis mode."), "radiobutton"),
        new(T("Area de upload", "Upload area"), T("Drag-and-drop com preview de imagens.", "Drag-and-drop with image previews."), "upload"),
        new(T("Prompt", "Prompt"), T("Textarea para instrucao de analise.", "Textarea for analysis instruction."), "comment"),
        new(T("Botao Analisar", "Analyze button"), T("Aciona a analise via IAiVisionProvider.", "Triggers analysis via IAiVisionProvider."), "play"),
        new(T("Resultado", "Result"), T("Texto, confianca e dados estruturados.", "Text, confidence and structured data."), "clipboard-check")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(T("Modos semanticos", "Semantic modes"), T("6 modos otimizados para tarefas comuns.", "6 modes optimized for common tasks."), "list-check"),
        new(T("Feedback visual", "Visual feedback"), T("Barra de confianca colorida por faixa.", "Confidence bar colored by range."), "chart-simple"),
        new(T("Provider abstrato", "Abstract provider"), T("IAiVisionProvider permite qualquer backend.", "IAiVisionProvider allows any backend."), "plug")
    ];

    // === EXAMPLES ===
    private RenderFragment ExBasic() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiVisionPanel Title="Analise de comprovante"
                         Placeholder="Descreva o que deve ser validado na imagem..."
                         MaxImages="3"
                         ShowAnalysisTypeSelector="true" />
    </XFStack>;

    private RenderFragment ExOcr() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiVisionPanel Title="OCR de documento fiscal"
                         Placeholder="Extraia os dados da nota fiscal..."
                         ShowAnalysisTypeSelector="false"
                         MaxImages="1"
                         DropText="Arraste a imagem da NF-e aqui" />
    </XFStack>;

    private RenderFragment ExCompare() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiVisionPanel Title="Comparacao de imagens"
                         Placeholder="Compare as duas imagens fornecidas..."
                         MaxImages="2"
                         ShowAnalysisTypeSelector="false" />
    </XFStack>;

    private const string Code1 = @"<XFAiVisionPanel Title=""Analise de comprovante""
                     Placeholder=""Descreva o que deve ser validado na imagem...""
                     MaxImages=""3""
                     ShowAnalysisTypeSelector=""true"" />";
    private const string Code2 = @"<XFAiVisionPanel Title=""OCR de documento fiscal""
                     Placeholder=""Extraia os dados da nota fiscal...""
                     ShowAnalysisTypeSelector=""false""
                     MaxImages=""1""
                     DropText=""Arraste a imagem da NF-e aqui"" />";
    private const string Code3 = @"<XFAiVisionPanel Title=""Comparacao de imagens""
                     Placeholder=""Compare as duas imagens fornecidas...""
                     MaxImages=""2""
                     ShowAnalysisTypeSelector=""false"" />";

    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("Title", "string?", "null", T("Titulo exibido no cabecalho.", "Title displayed in the header.")),
        new("ShowHeader", "bool", "true", T("Exibe o cabecalho do painel.", "Displays the panel header.")),
        new("ShowAnalysisTypeSelector", "bool", "true", T("Exibe o seletor de tipo de analise.", "Displays the analysis type selector.")),
        new("Placeholder", "string?", "null", T("Texto placeholder do prompt.", "Prompt placeholder text.")),
        new("AnalyzeText", "string?", "null", T("Texto do botao de analise.", "Analyze button text.")),
        new("LoadingText", "string?", "null", T("Texto exibido durante o carregamento.", "Text shown during loading.")),
        new("DropText", "string?", "null", T("Texto da area de drag-and-drop.", "Drag-and-drop area text.")),
        new("MaxImages", "int", "5", T("Numero maximo de imagens.", "Maximum number of images.")),
        new("AriaLabel", "string", "Painel de analise visual AI", T("Label ARIA do painel.", "Panel ARIA label."))
    ];

    private IReadOnlyList<NameValueRow> EventRows => [
        new("OnAnalysisComplete", T("EventCallback<XFAiVisionResult> — disparado quando a analise conclui com sucesso.", "EventCallback<XFAiVisionResult> — fired when analysis completes successfully.")),
        new("OnError", T("EventCallback<string> — disparado quando ocorre um erro na analise.", "EventCallback<string> — fired when an error occurs during analysis."))
    ];

    private IReadOnlyList<NameValueRow> MethodRows => [
        new("AddImage(string, string?)", T("Adiciona uma imagem (base64) a fila de analise.", "Adds an image (base64) to the analysis queue.")),
        new("Clear()", T("Limpa todas as imagens e resultados.", "Clears all images and results."))
    ];

    // === ACCESSIBILITY ===
    private IReadOnlyList<DocTile> AccessibilityItems => [
        new(T("role=region", "role=region"), T("Painel usa role=region com aria-label descritivo.", "Panel uses role=region with descriptive aria-label."), "universal-access"),
        new(T("aria-busy", "aria-busy"), T("Indica estado de carregamento para leitores de tela.", "Indicates loading state for screen readers."), "spinner"),
        new(T("role=radiogroup", "role=radiogroup"), T("Seletor de tipo usa radiogroup com aria-checked.", "Type selector uses radiogroup with aria-checked."), "radiobutton"),
        new(T("aria-live=polite", "aria-live=polite"), T("Resultados anunciados para leitores de tela.", "Results announced for screen readers."), "megaphone")
    ];

    private IReadOnlyList<NameValueRow> KeyboardRows => [
        new("Tab", T("Navega entre botoes de tipo, area de upload, prompt e botao Analisar.", "Navigates between type buttons, upload area, prompt and Analyze button.")),
        new("Enter / Space", T("Seleciona tipo de analise ou aciona botao.", "Selects analysis type or triggers button.")),
        new("Escape", T("Fecha resultados ou erros expandidos.", "Closes expanded results or errors."))
    ];

    // === RESPONSIVENESS ===
    private IReadOnlyList<DocTile> ResponsivenessItems => [
        new(T("Largura total", "Full width"), T("Painel ocupa 100% do container.", "Panel occupies 100% of container."), "maximize"),
        new(T("Upload responsivo", "Responsive upload"), T("Grid de preview se adapta ao tamanho da tela.", "Preview grid adapts to screen size."), "mobile-screen")
    ];

    // === PERFORMANCE ===
    private IReadOnlyList<DocTile> PerformanceItems => [
        new(T("Lazy analysis", "Lazy analysis"), T("Analise so inicia ao clicar em Analisar.", "Analysis only starts when clicking Analyze."), "clock"),
        new(T("Preview local", "Local preview"), T("Previews sao gerados localmente sem chamada de API.", "Previews are generated locally without API calls."), "bolt")
    ];

    // === SCENARIOS ===
    private IReadOnlyList<DocTile> ScenarioItems => [
        new(T("NF-e Scanner", "NF-e Scanner"), T("OCR automatico de notas fiscais eletronicas.", "Automatic electronic invoice OCR."), "file-invoice"),
        new(T("Conciliacao bancaria", "Bank reconciliation"), T("Comparacao de comprovantes de pagamento.", "Payment receipt comparison."), "scale-balanced"),
        new(T("Controle de estoque", "Inventory control"), T("Deteccao de produtos em imagens de prateleira.", "Product detection in shelf images."), "boxes-stacked")
    ];

    // === COMPOSITION ===
    private IReadOnlyList<DocTile> CompositionItems => [
        new(T("VisionPanel + XFCard", "VisionPanel + XFCard"), T("Painel dentro de um card para contexto.", "Panel inside a card for context."), "square"),
        new(T("VisionPanel + XFGrid", "VisionPanel + XFGrid"), T("Grid com multiplos paineis lado a lado.", "Grid with multiple panels side by side."), "table-cells"),
        new(T("VisionPanel + XFBadge", "VisionPanel + XFBadge"), T("Badges no resultado indicam tipo e confianca.", "Badges on result indicate type and confidence."), "tag")
    ];

    // === BEST PRACTICES ===
    private IReadOnlyList<DocTile> BestPracticeItems => [
        new(T("Limitar MaxImages", "Limit MaxImages"), T("Defina um limite adequado para o caso de uso.", "Set an appropriate limit for the use case."), "sliders"),
        new(T("Placeholder descritivo", "Descriptive placeholder"), T("Orient o usuario sobre o tipo de imagem esperado.", "Guide the user on the expected image type."), "comment"),
        new(T("Provider configurado", "Provider configured"), T("Certifique-se de que IAiVisionProvider esta registrado no DI.", "Ensure IAiVisionProvider is registered in DI."), "plug"),
        new(T("Tratar OnError", "Handle OnError"), T("Sempre trate erros para feedback ao usuario.", "Always handle errors for user feedback."), "triangle-exclamation")
