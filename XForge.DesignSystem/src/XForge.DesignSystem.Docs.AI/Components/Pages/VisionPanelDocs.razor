        new(T("MaxImages ilimitado", "Unlimited MaxImages"), T("Evite permitir upload ilimitado de imagens.", "Avoid allowing unlimited image uploads."), "ban"),
        new(T("Ignorar erros", "Ignore errors"), T("Nao ignore OnError — sempre informe o usuario.", "Do not ignore OnError — always inform the user."), "triangle-exclamation")
