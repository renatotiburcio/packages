@page "/ai/agents/overview"
@using XForge.DesignSystem.Core.Primitives
@using XForge.DesignSystem.Components.DataDisplay.Badge
@using XForge.DesignSystem.Components.DataDisplay.Card
@using XForge.DesignSystem.Components.DataDisplay.Table
@using XForge.DesignSystem.Components.DataDisplay.Code
@using XForge.DesignSystem.Components.DataDisplay.List
@using XForge.DesignSystem.Components.Button
@using XForge.DesignSystem.Components.Typography
@using XForge.DesignSystem.Docs.Shared.Contracts
@using XForge.DesignSystem.Docs.Shared.Navigation
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="AI Commercial" Title="@PageTitleText" Status="@PageStatusText" Items="XForgeDocsCatalog.AiItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <div class="grid gap-6">
                    <div class="flex flex-wrap gap-2">
                        <XFBadge Text="AI Agents" Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" />
                        <XFBadge Text="Orchestration" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" />
                        <XFBadge Text="WAI-ARIA" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" />
                    </div>

                    <div class="grid gap-2">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Agentes AI orquestram conversas, personalidade, contexto e orientacao para fluxos enterprise.",
                               "AI agents orchestrate conversation, personality, context and guidance for enterprise workflows.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("A categoria AI Agents fornece componentes para monitorar, personalizar e orientar interacoes com agentes AI. Console de observacao, identidade visual, contexto conversacional, onboarding guiado e insights proativos permitem integrar IA generativa em produtos enterprise com transparencia, acessibilidade e controle.",
                               "The AI Agents category provides components to monitor, personalize and guide AI agent interactions. Observation console, visual identity, conversational context, guided onboarding and proactive insights enable integrating generative AI into enterprise products with transparency, accessibility and control.")
                        </XFTypography>
                    </div>

                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <div class="grid gap-3">
                            @foreach (var item in HeroFacts)
                            {
                                @InfoTile(item)
                            }
                        </div>
                    </div>
                </div>
            </ChildContent>
        </XFCard>

        <!-- ===== COMPATIBILITY ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
            <Header><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">Blazor Server e Blazor WebAssembly</XFTypography></Header>
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                    <XFTable Striped="true" Hoverable="true" Compact="true">
                        <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                        <XFTableBody>
                            <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                            <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                            <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                            <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico. Interacoes requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                        </XFTableBody>
                    </XFTable>
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Estes componentes nao utilizam JavaScript interop. Sao puramente renderizados com C# e Tailwind CSS. Funcionam identicamente em todos os modos de renderizacao.", "These components do not use JavaScript interop. They are purely rendered with C# and Tailwind CSS. They work identically in all rendering modes.")</XFTypography>
                </XFStack>
            </ChildContent>
        </XFCard>

        <!-- ===== OVERVIEW SECTIONS ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewSection Title="@T("Visao geral", "Overview")" Description="@T("AI Agents padroniza como apps enterprise expõem, monitoram e orientam interacoes com agentes de IA generativa.", "AI Agents standardizes how enterprise apps expose, monitor and guide generative AI agent interactions.")" Items="OverviewItems" Columns="3" />
            <XForgeCategoryOverviewSection Title="@T("Filosofia", "Philosophy")" Description="@T("Cada agente AI deve ser observavel, explicavel e orientado a acao do usuario.", "Every AI agent must be observable, explainable and action-oriented for the user.")" Items="PhilosophyItems" />
            <XForgeCategoryOverviewSection Title="@T("Objetivos da categoria", "Category Objectives")" Items="ObjectiveItems" Columns="3" />
        </XFStack>

        <!-- ===== COMPONENT TABLE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewComponentTable Rows="ComponentRows" />
        </XFStack>

        <!-- ===== STANDARDS ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewSection Title="@T("Linguagem visual", "Visual Language")" Items="VisualLanguageItems" Columns="3" />
            <XForgeCategoryOverviewSection Title="@T("Padroes de UX", "UX Standards")" Items="UxStandardItems" Columns="3" />
            <XForgeCategoryOverviewSection Title="@T("Padroes de acessibilidade", "Accessibility Standards")" Items="AccessibilityItems" />
            <XForgeCategoryOverviewSection Title="@T("Padroes de responsividade", "Responsiveness Standards")" Items="ResponsiveItems" />
        </XFStack>

        <!-- ===== THEME & TOKENS ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewSection Title="@T("Padroes de tema", "Theme Standards")" Items="ThemeItems" />
            <XForgeCategoryOverviewNameDescriptionTable Title="@T("Design Tokens", "Design Tokens")"
                                                        NameHeader="@T("Grupo de tokens", "Token Group")"
                                                        DescriptionHeader="@T("Proposito", "Purpose")"
                                                        CodeName="true"
                                                        Rows="TokenRows" />
        </XFStack>

        <!-- ===== PATTERNS & SCENARIOS ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewSection Title="@T("Padroes comuns", "Common Patterns")" Items="PatternItems" Columns="3" />
            <XForgeCategoryOverviewSection Title="@T("Cenarios enterprise", "Enterprise Scenarios")" Items="ScenarioItems" Columns="3" />
        </XFStack>

        <!-- ===== EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewExampleGallery Examples="Examples" />
        </XFStack>

        <!-- ===== DOCS, ANTI, MIGRATION, BEST PRACTICES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewSection Title="@T("Padroes de documentacao", "Documentation Standards")" Items="DocumentationItems" Columns="3" />
            <XForgeCategoryOverviewSection Title="@T("Anti-padroes", "Anti-patterns")" Items="AntiPatternItems" Columns="3" />
            <XForgeCategoryOverviewSection Title="@T("Orientacao de migracao", "Migration Guidance")" Items="MigrationItems" Columns="3" />
            <XForgeCategoryOverviewSection Title="@T("Melhores praticas", "Best Practices")" Items="BestPracticeItems" Columns="3" />
        </XFStack>

        <!-- ===== RELATED ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewNameDescriptionTable Title="@T("Categorias relacionadas", "Related Categories")"
                                                        NameHeader="@T("Categoria", "Category")"
                                                        DescriptionHeader="@T("Relacionamento", "Relationship")"
                                                        Rows="RelatedCategories" />
        </XFStack>
    </XFStack>

    <XForgeDocsPageStandard ComponentName="AiAgentsOverviewDocs" IsOverview="true" />
</XForgeDocsShell>

@code {
    private string PageTitleText => T("AI Agents Overview", "AI Agents Overview");
    private string PageStatusText => T("Documentacao completa", "Complete docs");
    private string T(string pt, string en) => LanguageService.Text(pt, en);

    private RenderFragment HeroPreview() => @<div class="grid gap-4">
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
            <ChildContent>
                <div class="flex items-center gap-3 mb-3">
                    <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize("robot", 18))</span>
                    <div>
                        <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">XFAiAgentConsole</XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">Monitoramento multi-agente</XFTypography>
                    </div>
                </div>
                <div class="grid gap-2 md:grid-cols-2">
                    <div class="rounded-md bg-surface-100 p-3">
                        <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Agente", "Agent")</XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body2" Weight="XFTypographyWeight.Semibold">Fiscal Analyzer</XFTypography>
                        <XFBadge Text="@T("Ativo", "Active")" Color="XFBadgeColor.Success" Variant="XFBadgeVariant.Soft" />
                    </div>
                    <div class="rounded-md bg-surface-100 p-3">
                        <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Log", "Log")</XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">NF-e validada com sucesso</XFTypography>
                    </div>
                </div>
            </ChildContent>
        </XFCard>
    </div>;

    private RenderFragment InfoTile(XForgeCategoryOverviewItem item) => @<XForgeCategoryOverviewTile Item="item" />;

    private IReadOnlyList<XForgeCategoryOverviewExample> Examples => [
        new(
            @T("Console basico com agentes e logs", "Basic console with agents and logs"),
            @T("XFAiAgentConsole exibe agentes ativos e logs de execucao em tempo real.", "XFAiAgentConsole displays active agents and execution logs in real time."),
            AgentConsolePreview(),
            AgentConsoleCode
        ),
        new(
            @T("Personalidade do agente", "Agent personality"),
            @T("XFAiAgentPersonality define identidade visual, tom e prompts sugeridos.", "XFAiAgentPersonality defines visual identity, tone and suggested prompts."),
            PersonalityPreview(),
            PersonalityCode
        ),
        new(
            @T("Contexto conversacional", "Conversational context"),
            @T("XFAiConversationContext mostra historico, fontes e metadata da conversa.", "XFAiConversationContext shows history, sources and conversation metadata."),
            ContextPreview(),
            ContextCode
        )
    ];

    private IReadOnlyList<XForgeCategoryOverviewItem> HeroFacts => [
        new(@T("Orquestracao", "Orchestration"), @T("Console, identidade e contexto para agentes AI enterprise.", "Console, identity and context for enterprise AI agents."), "robot"),
        new(@T("Acessibilidade", "Accessibility"), @T("Roles ARIA, contraste AA e navegracao por teclado.", "ARIA roles, AA contrast and keyboard navigation."), "universal-access"),
        new(@T("Performance", "Performance"), @T("Render leve sem JavaScript interop, suporte a SSR.", "Light render without JavaScript interop, SSR support."), "bolt")
    ];

    private static RenderFragment AgentConsolePreview() => @<XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
        <ChildContent>
            <div class="flex items-center gap-3 mb-2">
                <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize("robot", 16))</span>
                <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">XFAiAgentConsole</XFTypography>
            </div>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">Exemplo de console com agentes e logs.</XFTypography>
        </ChildContent>
    </XFCard>;

    private static RenderFragment PersonalityPreview() => @<XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
        <ChildContent>
            <div class="flex items-center gap-3 mb-2">
                <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-info/10 text-info" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize("face-smile", 16))</span>
                <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">XFAiAgentPersonality</XFTypography>
            </div>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">Personalidade e identidade do agente.</XFTypography>
        </ChildContent>
    </XFCard>;

    private static RenderFragment ContextPreview() => @<XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
        <ChildContent>
            <div class="flex items-center gap-3 mb-2">
                <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-success/10 text-success" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize("comment-dots", 16))</span>
                <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">XFAiConversationContext</XFTypography>
            </div>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">Contexto e historico da conversa.</XFTypography>
        </ChildContent>
    </XFCard>;

    private const string AgentConsoleCode = """
    <XFAiAgentConsole Agents="@agents" Logs="@logs" Title="Operacao multi-agente" />
    """;

    private const string PersonalityCode = """
    <XFAiAgentPersonality Personality="@personality" ShowSuggestedPrompts="true" />
    """;

    private const string ContextCode = """
    <XFAiConversationContext Title="Contexto da Conversa" Messages="@messages" />
    """;

    private IReadOnlyList<XForgeCategoryOverviewItem> OverviewItems => [
        new(@T("Console de observacao", "Observation console"), @T("Monitora agentes ativos, logs e custos em tempo real.", "Monitors active agents, logs and costs in real time."), "desktop"),
        new(@T("Identidade do agente", "Agent identity"), @T("Define personalidade, tom e prompts sugeridos para cada agente.", "Defines personality, tone and suggested prompts for each agent."), "face-smile"),
        new(@T("Contexto conversacional", "Conversational context"), @T("Exibe historico, fontes e metadata da interacao com o agente.", "Shows history, sources and metadata of agent interaction."), "comment-dots"),
        new(@T("Onboarding guiado", "Guided onboarding"), @T("Wizard passo-a-passo para configurar e启动ar agentes AI.", "Step-by-step wizard to configure and launch AI agents."), "wand-magic-sparkles"),
        new(@T("Insights proativos", "Proactive insights"), @T("Notificacoes inteligentes baseadas em dados e comportamento.", "Smart notifications based on data and behavior."), "lightbulb"),
        new(@T("Acessibilidade", "Accessibility"), @T("Roles ARIA, labels, contraste e navegacao por teclado.", "ARIA roles, labels, contrast and keyboard navigation."), "universal-access")
    ];

    private IReadOnlyList<XForgeCategoryOverviewItem> PhilosophyItems => [
        new(@T("Observabilidade", "Observability"), @T("Agentes devem ser visiveis, rastreaveis e auditaveis em qualquer momento.", "Agents must be visible, trackable and auditable at all times."), "eye"),
        new(@T("Transparencia", "Transparency"), @T("O usuario deve saber quando esta interagindo com AI e qual a fonte da resposta.", "The user must know when interacting with AI and what the source of the answer is."), "circle-info"),
        new(@T("Orientacao a acao", "Action-oriented"), @T("Cada interacao com agente deve levar a um proximo passo concreto.", "Every agent interaction must lead to a concrete next step."), "arrow-right"),
        new(@T("Controle humano", "Human control"), @T("AI sugere, humano decide. Aprovacao e revisao sao parte do fluxo.", "AI suggests, human decides. Approval and review are part of the workflow."), "hand")
    ];

    private IReadOnlyList<XForgeCategoryOverviewItem> ObjectiveItems => [
        new(@T("Padronizacao", "Standardization"), @T("Unificar console, personalidade, contexto, onboarding e insights em componentes reutilizaveis.", "Unify console, personality, context, onboarding and insights in reusable components."), "check"),
        new(@T("Observabilidade", "Observability"), @T("Expor estado, logs e custos de agentes sem depender de ferramentas externas.", "Expose agent state, logs and costs without relying on external tools."), "eye"),
        new(@T("Confianca", "Trust"), @T("Construir confianca do usuario atraves de transparencia e controle.", "Build user trust through transparency and control."), "shield-check"),
        new(@T("A11y by default", "A11y by default"), @T("Todos os componentes usam roles e aria compatveis com leitores de tela.", "All components use roles and aria compatible with screen readers."), "universal-access"),
        new(@T("Performance", "Performance"), @T("Render leve sem JS interop, suporte a SSR e carregamento progressivo.", "Light render without JS interop, SSR support and progressive loading."), "bolt"),
        new(@T("Composicao", "Composition"), @T("Componentes podem ser combinados para criar fluxos completos de AI.", "Components can be combined to create complete AI workflows."), "puzzle-piece")
    ];

    private IReadOnlyList<XForgeCategoryOverviewComponentRow> ComponentRows => [
        new("XFAiAgentConsole", @T("Console de monitoramento multi-agente.", "Multi-agent monitoring console."), @T("Observar agentes ativos e logs.", "Observe active agents and logs."), @T("Dashboard de operacoes AI com custos e status.", "AI operations dashboard with costs and status."), "High", "High"),
        new("XFAiAgentPersonality", @T("Identidade e personalidade do agente.", "Agent identity and personality."), @T("Definir tom, avatar e prompts sugeridos.", "Set tone, avatar and suggested prompts."), @T("Assistentes com personalidade distinta por dominio.", "Assistants with distinct personality per domain."), "High", "Medium"),
        new("XFAiConversationContext", @T("Contexto e historico da conversa.", "Conversation context and history."), @T("Exibir fontes, metadata e historico.", "Display sources, metadata and history."), @T("Auditoria de conversas AI com trilha completa.", "AI conversation audit with full trail."), "High", "Medium"),
        new("XFAiOnboardingWizard", @T("Wizard de configuracao de agentes.", "Agent configuration wizard."), @T("Guiar setup inicial de agentes AI.", "Guide initial AI agent setup."), @T("Onboarding de novos usuarios com IA ativada.", "New user onboarding with AI enabled."), "Medium", "Medium"),
        new("XFAiProactiveInsight", @T("Insights proativos baseados em dados.", "Data-driven proactive insights."), @T("Notificar oportunidades e riscos automaticamente.", "Automatically notify opportunities and risks."), @T("Alertas inteligentes em dashboards e paineis.", "Smart alerts in dashboards and panels."), "Medium", "Low")
    ];

    private IReadOnlyList<XForgeCategoryOverviewItem> VisualLanguageItems => [
        new(@T("Icone do agente", "Agent icon"), @T("Cada agente tem um icone identificavel que reforca dominio e funcao.", "Each agent has an identifiable icon that reinforces domain and function."), "robot"),
        new(@T("Cor do status", "Status color"), @T("Sucesso=verde, processando=azul, erro=vermelho, aviso=amarelo.", "Success=green, processing=blue, error=red, warning=yellow."), "palette"),
        new(@T("Hierarquia de logs", "Log hierarchy"), @T("Logs usam tipografia e cor para distinguir INFO, WARN e ERROR.", "Logs use typography and color to distinguish INFO, WARN and ERROR."), "list-ul"),
        new(@T("Identidade visual", "Visual identity"), @T("Personalidade se manifesta em avatar, tom e prompts.", "Personality manifests in avatar, tone and prompts."), "face-smile"),
        new(@T("Espacamento consistente", "Consistent spacing"), @T("Gaps e padding seguem grid do Design System para coesao visual.", "Gaps and padding follow the Design System grid for visual cohesion."), "-arrows-minimize"),
        new(@T("Motion sutil", "Subtle motion"), @T("Animacoes de status e transicoes devem ser discretas e funcionais.", "Status animations and transitions must be discreet and functional."), "bolt")
    ];

    private IReadOnlyList<XForgeCategoryOverviewItem> UxStandardItems => [
        new(@T("Transparencia de AI", "AI transparency"), @T("Sempre indicar quando o conteudo vem de um agente AI.", "Always indicate when content comes from an AI agent."), "circle-info"),
        new(@T("Fonte rastreavel", "Traceable source"), @T("Cada resposta deve permitir rastrear a origem e o raciocinio.", "Each answer must allow tracing the origin and reasoning."), "link"),
        new(@T("Acao imediata", "Immediate action"), @T("Insights e conversas devem oferecer proximos passos claros.", "Insights and conversations must offer clear next steps."), "arrow-right"),
        new(@T("Onboarding progressivo", "Progressive onboarding"), @T("Introduzir funcionalidades AI gradualmente, sem sobrecarregar.", "Introduce AI features gradually, without overloading."), "wand-magic-sparkles"),
        new(@T("Controle de confianca", "Trust control"), @T("Permitir ao usuario revisar, aprovar ou rejeitar sugestoes AI.", "Allow the user to review, approve or reject AI suggestions."), "hand"),
        new(@T("Status visivel", "Visible status"), @T("Mostrar estado do agente (idle, processing, error) sempre.", "Show agent state (idle, processing, error) always."), "activity")
    ];

    private IReadOnlyList<XForgeCategoryOverviewItem> AccessibilityItems => [
        new(@T("Roles ARIA", "ARIA roles"), @T("Console, personalidade e contexto usam roles semanticos para leitores de tela.", "Console, personality and context use semantic roles for screen readers."), "universal-access"),
        new(@T("Labels e describedby", "Labels and describedby"), @T("Cada regiao AI tem label acessivel e descricao associada.", "Each AI region has accessible label and associated description."), "tag"),
        new(@T("Contraste AA", "AA contrast"), @T("Cores de status e texto passam WCAG 2.1 AA em claro e escuro.", "Status colors and text pass WCAG 2.1 AA in light and dark."), "eye"),
        new(@T("Teclado", "Keyboard"), @T("Tab, Enter, Escape e setas navegam todos os componentes AI.", "Tab, Enter, Escape and arrows navigate all AI components."), "keyboard"),
        new(@T("Motion reduce", "Motion reduce"), @T("Animacoes de status respeitam prefers-reduced-motion.", "Status animations respect prefers-reduced-motion."), "gauge-high"),
        new(@T("Live regions", "Live regions"), @T("Logs e insights atualizados usam aria-live para anunciar mudancas.", "Updated logs and insights use aria-live to announce changes."), "speaker")
    ];

    private IReadOnlyList<XForgeCategoryOverviewItem> ResponsiveItems => [
        new(@T("Console responsivo", "Responsive console"), @T("Agentes e logs se adaptam a viewport sem perder legibilidade.", "Agents and logs adapt to viewport without losing readability."), "mobile-screen"),
        new(@T("Wizard compacto", "Compact wizard"), @T("Onboarding funciona em mobile com etapas empilhadas.", "Onboarding works on mobile with stacked steps."), "arrows-maximize"),
        new(@T("Contexto colapsavel", "Collapsible context"), @T("Historico e fontes podem colapsar em telas pequenas.", "History and sources can collapse on small screens."), "arrows-minimize"),
        new(@T("Touch targets", "Touch targets"), @T("Acoes de agente mantem alvo minimo de 44px em dispositivos moveis.", "Agent actions maintain minimum 44px target on mobile devices."), "hand-pointer")
    ];

    private IReadOnlyList<XForgeCategoryOverviewItem> ThemeItems => [
        new(@T("Tokens de tema", "Theme tokens"), @T("Cores, espacamento e tipografia herdam do tema ativo.", "Colors, spacing and typography inherit from the active theme."), "swatchbook"),
        new(@T("Dark mode", "Dark mode"), @T("Status e contraste funcionam em claro e escuro sem hex fixo.", "Status and contrast work in light and dark without fixed hex."), "moon"),
        new(@T("Brand safety", "Brand safety"), @T("Primary comunica identidade do produto, nao risco de AI.", "Primary communicates product identity, not AI risk."), "paintbrush"),
        new(@T("High contrast", "High contrast"), @T("Severidade combina texto, icone e cor para acessibilidade maxima.", "Severity combines text, icon and color for maximum accessibility."), "shield-check")
