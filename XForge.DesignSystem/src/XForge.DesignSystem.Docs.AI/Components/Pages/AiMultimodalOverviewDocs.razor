@page "/ai/multimodal/overview"
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="AI Commercial"
                 Title="@T("Visao Multimodal AI","AI Multimodal Overview")"
                 Status="@T("Guia completo","Complete guide")"
                 Items="XForgeDocsCatalog.AiItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">

        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="Multimodal AI" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="4 Components" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Vision, Voice, Video, Chat","Vision, Voice, Video, Chat")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Chat multimodal, visao por imagem, analise de video e assistente de voz em componentes enterprise.",
                               "Multimodal chat, image vision, video analysis and voice assistant in enterprise components.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("A categoria Multimodal AI oferece quatro componentes complementares para interacoes com IA que vao alem do texto: chat com anexos de imagem/audio/video, analise de imagens via OCR e deteccao de objetos, extracao de frames de video com resumo inteligente, e assistente de voz com transcricao e sintese.",
                               "The Multimodal AI category offers four complementary components for AI interactions beyond text: chat with image/audio/video attachments, image analysis via OCR and object detection, video frame extraction with intelligent summarization, and voice assistant with transcription and synthesis.")
                        </XFTypography>
                    </XFStack>
                    <XFGrid Cols="1" Md="2" Lg="4" Gap="4">
                        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent>
                            <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@T("XFAiMultiModalChat","XFAiMultiModalChat")</XFTypography>
                            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Chat com texto, imagem, audio e video.","Chat with text, image, audio and video.")</XFTypography>
                        </ChildContent></XFCard>
                        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent>
                            <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@T("XFAiVisionPanel","XFAiVisionPanel")</XFTypography>
                            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Analise de imagens com OCR, objetos e graficos.","Image analysis with OCR, objects and charts.")</XFTypography>
                        </ChildContent></XFCard>
                        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent>
                            <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@T("XFAiVideoAnalyzer","XFAiVideoAnalyzer")</XFTypography>
                            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Extracao de frames e resumo de video.","Video frame extraction and summarization.")</XFTypography>
                        </ChildContent></XFCard>
                        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent>
                            <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@T("XFAiVoiceAssistant","XFAiVoiceAssistant")</XFTypography>
                            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("STT, TTS e transcricao em tempo real.","STT, TTS and real-time transcription.")</XFTypography>
                        </ChildContent></XFCard>
                    </XFGrid>
                </XFStack>
            </ChildContent>
        </XFCard>

        <!-- ===== SECTION 1: Metadata ===== -->
        @Section(T("Metadados","Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo","Field"), T("Valor","Value"))</div>)

        <!-- ===== SECTION 2: Overview ===== -->
        @Section(T("Visao geral da Categoria","Category Overview"), @<div>
            <XFGrid Cols="1" Md="2" Lg="3" Gap="4">
                @foreach (var item in OverviewItems) { @Tile(item) }
            </XFGrid>
        </div>)

        <!-- ===== SECTION 3: Purpose ===== -->
        @Section(T("Proposito","Purpose"), @<div>
            <XFGrid Cols="1" Md="3" Gap="4">
                @foreach (var item in PurposeItems) { @Tile(item) }
            </XFGrid>
        </div>)

        <!-- ===== SECTION 4: Problem Solved ===== -->
        @Section(T("Problema resolvido","Problem Solved"), @<div>
            <XFGrid Cols="1" Md="3" Gap="4">
                @foreach (var item in ProblemItems) { @Tile(item) }
            </XFGrid>
        </div>)

        <!-- ===== SECTION 5: When To Use ===== -->
        @Section(T("Quando usar","When to Use"), @<div>
            <XFGrid Cols="1" Md="2" Gap="4">
                @foreach (var item in UseItems) { @Tile(item) }
            </XFGrid>
        </div>)

        <!-- ===== SECTION 6: When Not To Use ===== -->
        @Section(T("Quando nao usar","When Not to Use"), @<div>
            <XFGrid Cols="1" Md="2" Gap="4">
                @foreach (var item in AvoidItems) { @WarningTile(item) }
            </XFGrid>
        </div>)

        <!-- ===== SECTION 7: Architecture ===== -->
        @Section(T("Arquitetura Multimodal","Multimodal Architecture"), @<div>
            <XFGrid Cols="1" Md="3" Gap="4">
                @foreach (var item in ArchitectureItems) { @Tile(item) }
            </XFGrid>
        </div>)

        <!-- ===== SECTION 8: Design Principles ===== -->
        @Section(T("Principios de Design","Design Principles"), @<div>
            <XFGrid Cols="1" Md="3" Gap="4">
                @foreach (var item in DesignPrincipleItems) { @Tile(item) }
            </XFGrid>
        </div>)

        <!-- ===== SECTION 9: Component Table ===== -->
        @Section(T("Tabela de Componentes","Component Table"), @<div>
            <XFTable Striped="true" Hoverable="true" Compact="true" Class="text-sm">
                <XFTableHeader><XFTableRow>
                    <XFTableCell Header="true">Componente</XFTableCell>
                    <XFTableCell Header="true">@T("Descricao","Description")</XFTableCell>
                    <XFTableCell Header="true">@T("Uso ideal","Ideal Use")</XFTableCell>
                    <XFTableCell Header="true">@T("Provider","Provider")</XFTableCell>
                </XFTableRow></XFTableHeader>
                <XFTableBody>
                    <XFTableRow><XFTableCell><XFCode Text="XFAiMultiModalChat" /></XFTableCell><XFTableCell>@T("Chat enterprise com anexos de imagem, audio e video.","Enterprise chat with image, audio and video attachments.")</XFTableCell><XFTableCell>@T("Atendimento, copilotos, suporte multicanal.","Service, copilots, omnichannel support.")</XFTableCell><XFTableCell>IAiProvider + IAiVisionProvider</XFTableCell></XFTableRow>
                    <XFTableRow><XFTableCell><XFCode Text="XFAiVisionPanel" /></XFTableCell><XFTableCell>@T("Painel de analise visual com OCR, deteccao de objetos e graficos.","Visual analysis panel with OCR, object detection and charts.")</XFTableCell><XFTableCell>@T("Leitura de NF-e, comprovantes, graficos.","NF-e reading, receipts, charts.")</XFTableCell><XFTableCell>IAiVisionProvider</XFTableCell></XFTableRow>
                    <XFTableRow><XFTableCell><XFCode Text="XFAiVideoAnalyzer" /></XFTableCell><XFTableCell>@T("Analise de video por extracao de frames com resumo inteligente.","Video analysis via frame extraction with intelligent summary.")</XFTableCell><XFTableCell>@T("Entrega, monitoramento, seguranca.","Delivery, monitoring, security.")</XFTableCell><XFTableCell>IAiVisionProvider</XFTableCell></XFTableRow>
                    <XFTableRow><XFTableCell><XFCode Text="XFAiVoiceAssistant" /></XFTableCell><XFTableCell>@T("Assistente de voz com transcricao, TTS e streaming de audio.","Voice assistant with transcription, TTS and audio streaming.")</XFTableCell><XFTableCell>@T("Comandos por voz, dictation, acessibilidade.","Voice commands, dictation, accessibility.")</XFTableCell><XFTableCell>IAiAudioProvider</XFTableCell></XFTableRow>
                </XFTableBody>
            </XFTable>
        </div>)

        <!-- ===== SECTION 10: Component Detail - XFAiMultiModalChat ===== -->
        @Section("XFAiMultiModalChat", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Chat enterprise multimodal com suporte a texto, imagem, audio e video. Integra IAiProvider para respostas e IAiVisionProvider para analise de anexos visuais. Suporta envio multiplo de anexos e streaming de resposta.","Enterprise multimodal chat with text, image, audio and video support. Integrates IAiProvider for responses and IAiVisionProvider for visual attachment analysis. Supports multiple attachment sending and response streaming.")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow>
                        <XFTableCell Header="true">@T("Parametro","Parameter")</XFTableCell>
                        <XFTableCell Header="true">Type</XFTableCell>
                        <XFTableCell Header="true">Default</XFTableCell>
                        <XFTableCell Header="true">@T("Descricao","Description")</XFTableCell>
                    </XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="Title" /></XFTableCell><XFTableCell>string?</XFTableCell><XFTableCell>null</XFTableCell><XFTableCell>@T("Titulo exibido no cabecalho.","Title displayed in header.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="ShowHeader" /></XFTableCell><XFTableCell>bool</XFTableCell><XFTableCell>true</XFTableCell><XFTableCell>@T("Exibe o cabecalho do chat.","Shows the chat header.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Placeholder" /></XFTableCell><XFTableCell>string?</XFTableCell><XFTableCell>null</XFTableCell><XFTableCell>@T("Texto placeholder do input.","Input placeholder text.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="MaxMessages" /></XFTableCell><XFTableCell>int</XFTableCell><XFTableCell>100</XFTableCell><XFTableCell>@T("Numero maximo de mensagens exibidas.","Maximum number of displayed messages.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="AriaLabel" /></XFTableCell><XFTableCell>string</XFTableCell><XFTableCell>"Chat multi-modal AI"</XFTableCell><XFTableCell>@T("Label ARIA para acessibilidade.","ARIA label for accessibility.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="OnMessageSent" /></XFTableCell><XFTableCell>EventCallback&lt;XFAiMultiModalMessage&gt;</XFTableCell><XFTableCell>null</XFTableCell><XFTableCell>@T("Dispara quando mensagem e enviada.","Fires when message is sent.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="OnResponseReceived" /></XFTableCell><XFTableCell>EventCallback&lt;XFAiMultiModalMessage&gt;</XFTableCell><XFTableCell>null</XFTableCell><XFTableCell>@T("Dispara quando resposta e recebida.","Fires when response is received.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="OnError" /></XFTableCell><XFTableCell>EventCallback&lt;string&gt;</XFTableCell><XFTableCell>null</XFTableCell><XFTableCell>@T("Dispara quando erro ocorre.","Fires when error occurs.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFCode Text="@MultiModalChatCode" Language="razor" Title="XFAiMultiModalChat" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" />
            </XFStack>
        </div>)

        <!-- ===== SECTION 11: Component Detail - XFAiVisionPanel ===== -->
        @Section("XFAiVisionPanel", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Painel de analise visual com upload de imagens, selecao de tipo de analise (OCR, objetos, graficos, documentos, comparacao) e resultado detalhado com niveis de confianca. Integra com IAiVisionProvider para todas as operacoes de visao.","Visual analysis panel with image upload, analysis type selection (OCR, objects, charts, documents, comparison) and detailed results with confidence levels. Integrates with IAiVisionProvider for all vision operations.")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow>
                        <XFTableCell Header="true">@T("Parametro","Parameter")</XFTableCell>
                        <XFTableCell Header="true">Type</XFTableCell>
                        <XFTableCell Header="true">Default</XFTableCell>
                        <XFTableCell Header="true">@T("Descricao","Description")</XFTableCell>
                    </XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="Title" /></XFTableCell><XFTableCell>string?</XFTableCell><XFTableCell>null</XFTableCell><XFTableCell>@T("Titulo exibido no cabecalho.","Title displayed in header.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="ShowHeader" /></XFTableCell><XFTableCell>bool</XFTableCell><XFTableCell>true</XFTableCell><XFTableCell>@T("Exibe o cabecalho do painel.","Shows the panel header.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="ShowAnalysisTypeSelector" /></XFTableCell><XFTableCell>bool</XFTableCell><XFTableCell>true</XFTableCell><XFTableCell>@T("Exibe o seletor de tipo de analise.","Shows the analysis type selector.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="MaxImages" /></XFTableCell><XFTableCell>int</XFTableCell><XFTableCell>5</XFTableCell><XFTableCell>@T("Numero maximo de imagens para upload.","Maximum number of upload images.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="AnalyzeText" /></XFTableCell><XFTableCell>string?</XFTableCell><XFTableCell>null</XFTableCell><XFTableCell>@T("Texto do botao de analise.","Analyze button text.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="AriaLabel" /></XFTableCell><XFTableCell>string</XFTableCell><XFTableCell>"Painel de analise visual AI"</XFTableCell><XFTableCell>@T("Label ARIA para acessibilidade.","ARIA label for accessibility.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="OnAnalysisComplete" /></XFTableCell><XFTableCell>EventCallback&lt;XFAiVisionResult&gt;</XFTableCell><XFTableCell>null</XFTableCell><XFTableCell>@T("Dispara quando analise completa.","Fires when analysis completes.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="OnError" /></XFTableCell><XFTableCell>EventCallback&lt;string&gt;</XFTableCell><XFTableCell>null</XFTableCell><XFTableCell>@T("Dispara quando erro ocorre.","Fires when error occurs.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFCode Text="@VisionPanelCode" Language="razor" Title="XFAiVisionPanel" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" />
            </XFStack>
        </div>)

        <!-- ===== SECTION 12: Component Detail - XFAiVideoAnalyzer ===== -->
        @Section("XFAiVideoAnalyzer", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Analise de video por extracao de frames configuravel. Envia frames extraidos para IAiVisionProvider e gera resumo consolidado com resultados por frame. Ideal para monitoramento, validacao de entrega e inspecao de seguranca.","Video analysis via configurable frame extraction. Sends extracted frames to IAiVisionProvider and generates consolidated summary with per-frame results. Ideal for monitoring, delivery validation and security inspection.")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow>
                        <XFTableCell Header="true">@T("Parametro","Parameter")</XFTableCell>
                        <XFTableCell Header="true">Type</XFTableCell>
                        <XFTableCell Header="true">Default</XFTableCell>
                        <XFTableCell Header="true">@T("Descricao","Description")</XFTableCell>
                    </XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="Title" /></XFTableCell><XFTableCell>string?</XFTableCell><XFTableCell>null</XFTableCell><XFTableCell>@T("Titulo exibido no cabecalho.","Title displayed in header.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="ShowHeader" /></XFTableCell><XFTableCell>bool</XFTableCell><XFTableCell>true</XFTableCell><XFTableCell>@T("Exibe o cabecalho do analisador.","Shows the analyzer header.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="ShowFrameSelector" /></XFTableCell><XFTableCell>bool</XFTableCell><XFTableCell>true</XFTableCell><XFTableCell>@T("Exibe o seletor de quantidade de frames.","Shows the frame count selector.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="AnalyzeText" /></XFTableCell><XFTableCell>string</XFTableCell><XFTableCell>"Analisar"</XFTableCell><XFTableCell>@T("Texto do botao de analise.","Analyze button text.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="AriaLabel" /></XFTableCell><XFTableCell>string</XFTableCell><XFTableCell>"Analisador de video AI"</XFTableCell><XFTableCell>@T("Label ARIA para acessibilidade.","ARIA label for accessibility.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="OnAnalysisComplete" /></XFTableCell><XFTableCell>EventCallback&lt;IReadOnlyList&lt;XFAiVisionResult&gt;&gt;</XFTableCell><XFTableCell>null</XFTableCell><XFTableCell>@T("Dispara quando analise completa.","Fires when analysis completes.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="OnError" /></XFTableCell><XFTableCell>EventCallback&lt;string&gt;</XFTableCell><XFTableCell>null</XFTableCell><XFTableCell>@T("Dispara quando erro ocorre.","Fires when error occurs.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFCode Text="@VideoAnalyzerCode" Language="razor" Title="XFAiVideoAnalyzer" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" />
            </XFStack>
        </div>)

        <!-- ===== SECTION 13: Component Detail - XFAiVoiceAssistant ===== -->
        @Section("XFAiVoiceAssistant", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Assistente de voz enterprise com transcricao de fala em texto (STT), sintese de texto em fala (TTS) e estados controlados (Idle, Listening, Processing, Speaking, Error). Suporta idiomas configuraveis e streaming de transcricao em tempo real via IAiAudioProvider.","Enterprise voice assistant with speech-to-text (STT), text-to-speech (TTS) and controlled states (Idle, Listening, Processing, Speaking, Error). Supports configurable languages and real-time transcription streaming via IAiAudioProvider.")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow>
                        <XFTableCell Header="true">@T("Parametro","Parameter")</XFTableCell>
                        <XFTableCell Header="true">Type</XFTableCell>
                        <XFTableCell Header="true">Default</XFTableCell>
                        <XFTableCell Header="true">@T("Descricao","Description")</XFTableCell>
                    </XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="Title" /></XFTableCell><XFTableCell>string?</XFTableCell><XFTableCell>null</XFTableCell><XFTableCell>@T("Titulo exibido no cabecalho.","Title displayed in header.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="ShowHeader" /></XFTableCell><XFTableCell>bool</XFTableCell><XFTableCell>true</XFTableCell><XFTableCell>@T("Exibe o cabecalho do assistente.","Shows the assistant header.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="ShowTextToSpeech" /></XFTableCell><XFTableCell>bool</XFTableCell><XFTableCell>true</XFTableCell><XFTableCell>@T("Exibe a secao de sintese de fala.","Shows the text-to-speech section.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Language" /></XFTableCell><XFTableCell>string?</XFTableCell><XFTableCell>null</XFTableCell><XFTableCell>@T("Dica de idioma para transcricao (ex: pt-BR).","Language hint for transcription (e.g. pt-BR).")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="AriaLabel" /></XFTableCell><XFTableCell>string</XFTableCell><XFTableCell>"Assistente de voz AI"</XFTableCell><XFTableCell>@T("Label ARIA para acessibilidade.","ARIA label for accessibility.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="OnTranscriptionComplete" /></XFTableCell><XFTableCell>EventCallback&lt;XFAiTranscriptionResult&gt;</XFTableCell><XFTableCell>null</XFTableCell><XFTableCell>@T("Dispara quando transcricao completa.","Fires when transcription completes.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="OnStateChanged" /></XFTableCell><XFTableCell>EventCallback&lt;XFAiVoiceState&gt;</XFTableCell><XFTableCell>null</XFTableCell><XFTableCell>@T("Dispara quando estado muda.","Fires when state changes.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="OnError" /></XFTableCell><XFTableCell>EventCallback&lt;string&gt;</XFTableCell><XFTableCell>null</XFTableCell><XFTableCell>@T("Dispara quando erro ocorre.","Fires when error occurs.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFCode Text="@VoiceAssistantCode" Language="razor" Title="XFAiVoiceAssistant" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" />
            </XFStack>
        </div>)

        <!-- ===== SECTION 14: Providers & Integration ===== -->
        @Section(T("Providers e Integracao","Providers & Integration"), @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTable Striped="true" Hoverable="true" Compact="true" Class="text-sm">
                    <XFTableHeader><XFTableRow>
                        <XFTableCell Header="true">Provider</XFTableCell>
                        <XFTableCell Header="true">@T("Interface","Interface")</XFTableCell>
                        <XFTableCell Header="true">@T("Uso","Usage")</XFTableCell>
                        <XFTableCell Header="true">@T("Metodos","Methods")</XFTableCell>
                    </XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="IAiProvider" /></XFTableCell><XFTableCell>@T("Chat e completions","Chat & completions")</XFTableCell><XFTableCell>XFAiMultiModalChat</XFTableCell><XFTableCell>CompleteAsync, StreamAsync</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="IAiVisionProvider" /></XFTableCell><XFTableCell>@T("Visao por imagem","Image vision")</XFTableCell><XFTableCell>MultiModalChat, VisionPanel, VideoAnalyzer</XFTableCell><XFTableCell>AnalyzeImageAsync, DescribeAsync</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="IAiAudioProvider" /></XFTableCell><XFTableCell>@T("Audio e transcricao","Audio & transcription")</XFTableCell><XFTableCell>XFAiVoiceAssistant</XFTableCell><XFTableCell>TranscribeAsync, SynthesizeAsync</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFCode Text="@ProviderRegistrationCode" Language="csharp" Title="Program.cs" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" />
            </XFStack>
        </div>)

        <!-- ===== SECTION 15: Streaming & Performance ===== -->
        @Section(T("Streaming e Performance","Streaming & Performance"), @<div>
            <XFGrid Cols="1" Md="2" Gap="4">
                @foreach (var item in StreamingItems) { @Tile(item) }
            </XFGrid>
        </div>)

        <!-- ===== SECTION 16: Accessibility ===== -->
        @Section(T("Acessibilidade","Accessibility"), @<div>
            <XFGrid Cols="1" Md="2" Gap="4">
                @foreach (var item in AccessibilityItems) { @Tile(item) }
            </XFGrid>
        </div>)

