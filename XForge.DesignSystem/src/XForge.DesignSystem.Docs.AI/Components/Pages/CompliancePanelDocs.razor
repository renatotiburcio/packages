        new(T("Politicas de retencao", "Retention policies"), T("Politicas por categoria com periodo e base legal.", "Policies by category with period and legal basis."), "clock"),
        new(T("Consentimentos por categoria", "Consent by category"), T("Barras de progresso por tipo de dado.", "Progress bars by data type."), "chart-bar")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Conformidade", "Compliance"), T("Atender LGPD, GDPR e CCPA com dashboard centralizado.", "Meet LGPD, GDPR and CCPA with centralized dashboard."), "shield-check"),
        new(T("Gestao de dados", "Data management"), T("Gerenciar exclusoes e retencao de dados pessoais.", "Manage personal data deletion and retention."), "database"),
        new(T("Transparencia", "Transparency"), T("Mostrar status de consentimentos e politicas para usuarios.", "Show consent status and policies to users."), "eye")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Conformidade manual com planilhas e processos ad hoc.", "Manual compliance with spreadsheets and ad hoc processes."), "xmark"),
        new(T("Depois", "After"), T("Dashboard automatizado com politicas, consentimentos e exclusoes.", "Automated dashboard with policies, consents and deletions."), "check"),
        new(T("Acessibilidade", "Accessibility"), T("role=region com aria-label e botoes com aria-label.", "role=region with aria-label and buttons with aria-label."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Compliance officer", "Compliance officer"), T("Dashboard para gestores de conformidade.", "Dashboard for compliance managers."), "user-shield"),
        new(T("DPO", "DPO"), T("Exclusao de dados e gestao de consentimentos.", "Data deletion and consent management."), "user-minus")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Auditoria imutavel", "Immutable audit"), T("Use XFAiAuditTimeline para trilha com hash.", "Use XFAiAuditTimeline for trail with hash."), "lock"),
        new(T("Log operacional", "Operational log"), T("Use XFAuditLogger para logs de sistema.", "Use XFAuditLogger for system logs."), "scroll")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new("Header", T("Titulo e badges de regulacao.", "Title and regulation badges."), "bars"),
        new("Summary Cards", T("Cards com metricas: usuarios, consentimentos, exclusoes.", "Cards with metrics: users, consents, deletions."), "chart-bar"),
        new("Deletion Requests", T("Lista de solicitacoes com status e acoes.", "Request list with status and actions."), "trash"),
        new("Retention Policies", T("Politicas por categoria com periodo e base legal.", "Policies by category with period and legal basis."), "clock"),
        new("Consent by Category", T("Barras de progresso por tipo de dado.", "Progress bars by data type."), "chart-simple"),
        new("Empty State", T("Mensagem quando nao ha dados.", "Message when no data available."), "inbox")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(T("Visibilidade", "Visibility"), T("Todas as metricas e politicas visiveis de imediato.", "All metrics and policies visible immediately."), "eye"),
        new(T("Acao rapida", "Quick action"), T("Botoes de aprovar/rejeitar inline para exclusoes.", "Inline approve/reject buttons for deletions."), "bolt"),
        new(T("Regulacao clara", "Clear regulation"), T("Badges identificam quais regulacoes se aplicam.", "Badges identify which regulations apply."), "shield-check")
    ];

    // === EXAMPLES ===
    private RenderFragment ExFull() => @<XFCompliancePanel Report="SampleReport"
                                                           DeletionRequests="SampleDeletions"
                                                           Title="Conformidade"
                                                           ShowRefreshButton="false"
                                                           ShowActionButtons="true"
                                                           MaxVisibleRequests="2" />;

    private RenderFragment ExReadOnly() => @<XFCompliancePanel Report="SampleReport"
                                                               DeletionRequests="SampleDeletions"
                                                               Title="Conformidade (somente leitura)"
                                                               ShowRefreshButton="false"
                                                               ShowActionButtons="false"
                                                               MaxVisibleRequests="2" />;

    private RenderFragment ExMinimal() => @<XFCompliancePanel Report="MinimalReport"
                                                              DeletionRequests="SampleDeletions"
                                                              Title="Resumo"
                                                              ShowRefreshButton="false"
                                                              ShowActionButtons="false"
                                                              MaxVisibleRequests="2" />;

    private const string Code1 = @"<XFCompliancePanel Report=""@_report""
    DeletionRequests=""@_deletions""
    Title=""Conformidade""
    ShowRefreshButton=""false""
    ShowActionButtons=""true""
    MaxVisibleRequests=""2"" />";

    private const string Code2 = @"<XFCompliancePanel Report=""@_report""
    DeletionRequests=""@_deletions""
    Title=""Conformidade (somente leitura)""
    ShowRefreshButton=""false""
    ShowActionButtons=""false""
