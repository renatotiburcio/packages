        new(T("Consentimentos", "Consents"), T("Gestao de consentimentos por categoria com barras de progresso.", "Consent management by category with progress bars."), "check-double"),
        new(T("Exclusao", "Deletion"), T("Solicitacoes de exclusao com aprovar/rejeitar.", "Deletion requests with approve/reject."), "trash")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFCompliancePanel"),
        new("Namespace", "XForge.DesignSystem.Components.AI.Enterprise"),
        new("Package", "XForge.DesignSystem.AI"),
        new("Category", "AI / Enterprise"),
        new("Status", T("Estavel", "Stable")),
        new("Accessibility", "role=region, aria-label, aria-hidden em icones."),
        new("Theme support", T("Light, dark e data-theme via tokens.", "Light, dark and data-theme via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
