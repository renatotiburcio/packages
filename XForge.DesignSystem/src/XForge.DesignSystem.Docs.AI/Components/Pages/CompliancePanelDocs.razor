    private const string Code3 = @"<XFCompliancePanel Report=""@_report""
    DeletionRequests=""@_deletions""
    Title=""Resumo""
    ShowRefreshButton=""false""
    ShowActionButtons=""false""
    MaxVisibleRequests=""2"" />";

    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("Report", "XFComplianceReport?", "null", T("Dados do relatorio de conformidade.", "Compliance report data.")),
        new("DeletionRequests", "IReadOnlyList<XFDeletionRequest>", "[]", T("Solicitacoes de exclusao pendentes.", "Pending deletion requests.")),
        new("Title", "string", "\"Conformidade\"", T("Titulo do componente.", "Component title.")),
        new("ShowRefreshButton", "bool", "true", T("Exibe botao de atualizacao.", "Displays refresh button.")),
