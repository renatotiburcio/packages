        new("ActiveConsentsLabel", "string", "\"Consentimentos ativos\"", T("Label de Consentimentos ativos.", "Active consents label.")),
        new("RevokedConsentsLabel", "string", "\"Revogados\"", T("Label de Revogados.", "Revoked label.")),
        new("PendingDeletionsLabel", "string", "\"Exclusoes pendentes\"", T("Label de Exclusoes pendentes.", "Pending deletions label.")),
        new("DeletionRequestsLabel", "string", "\"Solicitacoes de exclusao\"", T("Label da secao de solicitacoes.", "Requests section label.")),
        new("RetentionPoliciesLabel", "string", "\"Politicas de retencao\"", T("Label da secao de politicas.", "Policies section label.")),
        new("ConsentByCategoryLabel", "string", "\"Consentimentos por categoria\"", T("Label da secao de consentimentos.", "Consents section label.")),
        new("ApproveLabel", "string", "\"Aprovar\"", T("Label do botao Aprovar.", "Approve button label.")),
        new("RejectLabel", "string", "\"Rejeitar\"", T("Label do botao Rejeitar.", "Reject button label."))
    ];

    private IReadOnlyList<NameValueRow> EventRows => [
        new("OnApproveDeletion", T("Disparado ao aprovar uma solicitacao de exclusao.", "Fired when approving a deletion request.")),
        new("OnRejectDeletion", T("Disparado ao rejeitar uma solicitacao de exclusao.", "Fired when rejecting a deletion request.")),
        new("OnRefresh", T("Disparado ao clicar no botao de atualizacao.", "Fired when refresh button is clicked."))
    ];

    // === ACCESSIBILITY ===
    private IReadOnlyList<DocTile> AccessibilityItems => [
        new("role=region", T("Container principal usa role=region.", "Main container uses role=region."), "universal-access"),
        new("aria-label", T("Botoes e container tem aria-label descritivo.", "Buttons and container have descriptive aria-label."), "tag"),
        new("aria-hidden", T("Icones decorativos marcados com aria-hidden.", "Decorative icons marked with aria-hidden."), "eye-slash"),
        new("Contraste", T("Cores de status atendem WCAG AAA.", "Status colors meet WCAG AAA."), "palette")
