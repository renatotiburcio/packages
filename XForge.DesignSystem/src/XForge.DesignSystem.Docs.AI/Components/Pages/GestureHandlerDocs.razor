        new("touch-none", T("Impede scroll nativo no container.", "Prevents native scroll on container.")),
        new("select-none", T("Impede selecao de texto.", "Prevents text selection.")),
        new("pointer-events-none", T("Desabilita interacoes quando Disabled.", "Disables interactions when Disabled."))
    ];

    // === THEMING ===
    private IReadOnlyList<DocTile> ThemeItems => [
        new("data-theme", T("Tokens light/dark via CSS variables.", "Light/dark tokens via CSS variables."), "moon"),
        new("data-brand", T("Primary acompanha marca ativa.", "Primary follows active brand."), "swatchbook")
    ];

    // === TESTING ===
    private IReadOnlyList<NameValueRow> TestingRows => [
        new("Unit", T("Render, Options, Disabled, callbacks, JS interop mock.", "Render, Options, Disabled, callbacks, JS interop mock.")),
        new("Integration", T("Simulacao de pointer events via JS interop.", "Pointer event simulation via JS interop."))
    ];

    // === LIMITATIONS ===
    private IReadOnlyList<NameValueRow> LimitationRows => [
        new("Static SSR", T("JS interop requer modo interativo.", "JS interop requires interactive mode.")),
        new("Pinch", T("Pinch requer suporte a pointer events do navegador.", "Pinch requires browser pointer events support.")),
        new("Rotate", T("Rotate desabilitado por padrao. Habilite via Options.EnableRotate.", "Rotate disabled by default. Enable via Options.EnableRotate."))
    ];

