@page "/ai/gesture-handler"
@inject XForgeDocsLanguageService L

<XForgeDocsShell ProductLabel="AI Commercial"
                 Title="XFGestureHandler"
                 Status="@L.Text("Estavel", "Stable")"
                 Items="XForgeDocsCatalog.AiItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFGestureHandler" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Touch", "Touch")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Pinch & Swipe", "Pinch & Swipe")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Captura de gestos para experiencias touch, mobile e superficies interativas.",
                               "Gesture capture for touch, mobile and interactive surface experiences.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("Handler completo de gestos com JS interop para tap, double-tap, long-press, swipe, pinch e rotate. Configuravel por thresholds e callbacks especificos.",
                               "Complete gesture handler with JS interop for tap, double-tap, long-press, swipe, pinch and rotate. Configurable via thresholds and specific callbacks.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("JS interop completo para todos os gestos.", "Full JS interop for all gestures.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("JS interop completo para todos os gestos.", "Full JS interop for all gestures.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Danger" Text="@T("Nao", "No")" /></XFTableCell><XFTableCell>@T("JS interop requer modo interativo.", "JS interop requires interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Dependencia JS", "JS Dependency")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Utiliza xf-gesture-handler.js via IJSRuntime para inicializar listeners de pointer events.", "Uses xf-gesture-handler.js via IJSRuntime to initialize pointer event listeners.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 3 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Swipe basico", "1. Basic Swipe"), T("Captura de swipe com callbacks direcionais.", "Swipe capture with directional callbacks."), ExSwipeBasic(), Code1)
            @Example(T("2. Long press e double tap", "2. Long Press and Double Tap"), T("Deteccao de pressao prolongada e duplo toque.", "Long press and double tap detection."), ExLongPressDoubleTap(), Code2)
            @Example(T("3. Configuracao customizada", "3. Custom Configuration"), T("Thresholds e gestures habilitados/desabilitados.", "Thresholds and enabled/disabled gestures."), ExCustomConfig(), Code3)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string T(string pt, string en) => L.Text(pt, en);
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFGestureHandler OnTap="() => { }">
            <ChildContent>
                <div class="flex items-center justify-center rounded-lg border border-dashed border-border-light bg-surface-50 p-8 text-sm text-text-secondary">
                    @T("Toque ou deslize aqui", "Tap or swipe here")
                </div>
            </ChildContent>
        </XFGestureHandler>
    </XFStack>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("10 tipos de gesto", "10 gesture types"), T("Tap, double-tap, long-press, swipe x4, pinch x2, rotate.", "Tap, double-tap, long-press, swipe x4, pinch x2, rotate."), "hand-pointer"),
        new(T("Configuravel", "Configurable"), T("Thresholds, velocity e duracao ajustaveis.", "Adjustable thresholds, velocity and duration."), "sliders"),
        new(T("JS interop", "JS interop"), T("Inicializacao via xf-gesture-handler.js.", "Initialization via xf-gesture-handler.js."), "javascript")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFGestureHandler"),
        new("Namespace", "XForge.DesignSystem.Components.CrossPlatform"),
        new("Package", "XForge.DesignSystem"),
        new("Category", "CrossPlatform / Gesture"),
        new("Status", T("Estavel", "Stable")),
        new("Accessibility", T("pointer-events e touch-action configurados automaticamente.", "pointer-events and touch-action configured automatically.")),
        new("JS Module", "xf-gesture-handler.js"),
        new("Theme support", T("Light, dark e data-brand via tokens.", "Light, dark and data-brand via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("10 gestos", "10 gestures"), T("Tap, double-tap, long-press, 4 direcoes de swipe, 2 direcoes de pinch.", "Tap, double-tap, long-press, 4 swipe directions, 2 pinch directions."), "hand-pointer"),
        new(T("XFGestureEvent", "XFGestureEvent"), T("Registro com tipo, estado, coordenadas, escala, rotacao e duracao.", "Record with type, state, coordinates, scale, rotation and duration."), "database"),
        new(T("Callbacks especificos", "Specific callbacks"), T("OnSwipeLeft, OnTap, OnLongPress, OnPinch e mais.", "OnSwipeLeft, OnTap, OnLongPress, OnPinch and more."), "bolt")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Navegacao por gesto", "Gesture navigation"), T("Swipe para navegar entre telas.", "Swipe to navigate between screens."), "route"),
        new(T("Zoom interativo", "Interactive zoom"), T("Pinch para zoom em imagens e mapas.", "Pinch to zoom on images and maps."), "magnifying-glass"),
        new(T("Acoes contextuais", "Context actions"), T("Long press para menu contextual.", "Long press for context menu."), "ellipsis-vertical")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Implementacao manual de pointer events por plataforma.", "Manual implementation of pointer events per platform."), "xmark"),
        new(T("Depois", "After"), T("Handler unificado com callbacks tipados.", "Unified handler with typed callbacks."), "check"),
        new(T("Configuracao", "Configuration"), T("Thresholds ajustaveis por caso de uso.", "Thresholds adjustable per use case."), "sliders")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Mobile/tablet", "Mobile/tablet"), T("Experiencias touch nativas.", "Native touch experiences."), "mobile-screen"),
        new(T("Superficies interativas", "Interactive surfaces"), T("Kiosks, touch screens e tables digitais.", "Kiosks, touch screens and digital tables."), "display")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Desktop puro", "Pure desktop"), T("Nao e necessario para hover/click em desktop.", "Not needed for hover/click on desktop."), "laptop"),
        new(T("Gestos simples", "Simple gestures"), T("Para click/hover, use eventos HTML nativos.", "For click/hover, use native HTML events."), "pointer")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new("ChildContent", T("Render fragment com XFGestureContext.", "Render fragment with XFGestureContext."), "puzzle"),
        new("XFGestureContext", T("Registro com LastGesture e State.", "Record with LastGesture and State."), "database"),
        new("XFGestureOptions", T("Configuracao de thresholds e gestos habilitados.", "Threshold and enabled gestures configuration."), "sliders")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(T("Configuracao flexivel", "Flexible configuration"), T("10 gestos configuraveis por thresholds.", "10 gestures configurable by thresholds."), "sliders"),
        new(T("Callbacks granulares", "Granular callbacks"), T("Callbacks especificos por tipo de gesto.", "Specific callbacks per gesture type."), "bolt"),
        new(T("Limpeza automatica", "Auto cleanup"), T("DisposeAsync remove listeners JS automaticamente.", "DisposeAsync removes JS listeners automatically."), "broom")
    ];

    // === EXAMPLES ===
    private RenderFragment ExSwipeBasic() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFGestureHandler OnSwipeLeft="() => { }" OnSwipeRight="() => { }" OnSwipeUp="() => { }" OnSwipeDown="() => { }">
            <ChildContent>
                <div class="flex items-center justify-center rounded-lg border border-dashed border-border-light bg-surface-50 p-8 text-sm text-text-secondary">
                    @T("Deslize em qualquer direcao", "Swipe in any direction")
                </div>
            </ChildContent>
        </XFGestureHandler>
    </XFStack>;

    private RenderFragment ExLongPressDoubleTap() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFGestureHandler OnLongPress="() => { }" OnDoubleTap="() => { }">
            <ChildContent>
                <div class="flex items-center justify-center rounded-lg border border-dashed border-border-light bg-surface-50 p-8 text-sm text-text-secondary">
                    @T("Pressione longe ou toque duas vezes", "Long press or double tap")
                </div>
            </ChildContent>
        </XFGestureHandler>
    </XFStack>;

    private RenderFragment ExCustomConfig() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFGestureHandler Options="new XFGestureOptions { SwipeThreshold = 100, LongPressDurationMs = 800, EnablePinch = false }" OnTap="() => { }">
            <ChildContent>
                <div class="flex items-center justify-center rounded-lg border border-dashed border-border-light bg-surface-50 p-8 text-sm text-text-secondary">
                    @T("Swipe 100px, long press 800ms, sem pinch", "Swipe 100px, long press 800ms, no pinch")
                </div>
            </ChildContent>
        </XFGestureHandler>
    </XFStack>;

    private const string Code1 = @"<XFGestureHandler OnSwipeLeft=""@(() => HandleSwipe(""left""))""
               OnSwipeRight=""@(() => HandleSwipe(""right""))""
               OnSwipeUp=""@(() => HandleSwipe(""up""))""
               OnSwipeDown=""@(() => HandleSwipe(""down""))"">
    <ChildContent>
        <div>Deslize em qualquer direcao</div>
    </ChildContent>
</XFGestureHandler>";

    private const string Code2 = @"<XFGestureHandler OnLongPress=""@HandleLongPress""
               OnDoubleTap=""@HandleDoubleTap"">
    <ChildContent>
        <div>Pressione longe ou toque duas vezes</div>
    </ChildContent>
</XFGestureHandler>";

    private const string Code3 = @"<XFGestureHandler Options=""@new XFGestureOptions { SwipeThreshold = 100, LongPressDurationMs = 800, EnablePinch = false }""
               OnTap=""@HandleTap"">
    <ChildContent>
        <div>Swipe 100px, long press 800ms, sem pinch</div>
    </ChildContent>
</XFGestureHandler>";

    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("ChildContent", "RenderFragment<XFGestureContext>?", "null", T("Conteudo com contexto do gesto.", "Content with gesture context.")),
        new("Options", "XFGestureOptions", "new()", T("Configuracao de thresholds e gestos.", "Threshold and gesture configuration.")),
        new("Disabled", "bool", "false", T("Desabilita captura de gestos.", "Disables gesture capture.")),
        new("OnGesture", "EventCallback<XFGestureEvent>", "EventCallback", T("Callback para qualquer gesto detectado.", "Callback for any detected gesture.")),
        new("OnSwipeLeft", "EventCallback<XFGestureEvent>", "EventCallback", T("Callback para swipe para esquerda.", "Callback for left swipe.")),
        new("OnSwipeRight", "EventCallback<XFGestureEvent>", "EventCallback", T("Callback para swipe para direita.", "Callback for right swipe.")),
        new("OnSwipeUp", "EventCallback<XFGestureEvent>", "EventCallback", T("Callback para swipe para cima.", "Callback for upward swipe.")),
        new("OnSwipeDown", "EventCallback<XFGestureEvent>", "EventCallback", T("Callback para swipe para baixo.", "Callback for downward swipe.")),
        new("OnTap", "EventCallback<XFGestureEvent>", "EventCallback", T("Callback para tap simples.", "Callback for simple tap.")),
        new("OnDoubleTap", "EventCallback<XFGestureEvent>", "EventCallback", T("Callback para duplo toque.", "Callback for double tap.")),
        new("OnLongPress", "EventCallback<XFGestureEvent>", "EventCallback", T("Callback para pressao prolongada.", "Callback for long press.")),
        new("OnPinch", "EventCallback<XFGestureEvent>", "EventCallback", T("Callback para pinch in/out.", "Callback for pinch in/out.")),
        new("Class", "string?", "null", T("Classes CSS adicionais.", "Additional CSS classes.")),
        new("Style", "string?", "null", T("Estilos inline.", "Inline styles."))
    ];

    private IReadOnlyList<NameValueRow> EventRows => [
        new("OnGesture", T("Dispara em qualquer gesto. Recebe XFGestureEvent completo.", "Fires on any gesture. Receives full XFGestureEvent.")),
        new("OnSwipeLeft/Right/Up/Down", T("Callbacks direcionais para swipe.", "Directional callbacks for swipe.")),
        new("OnTap", T("Dispara em tap simples.", "Fires on simple tap.")),
        new("OnDoubleTap", T("Dispara em duplo toque.", "Fires on double tap.")),
        new("OnLongPress", T("Dispara apos duracao configurada.", "Fires after configured duration.")),
        new("OnPinch", T("Dispara em pinch in e pinch out.", "Fires on pinch in and pinch out."))
    ];

    // === XFGestureOptions ===
    private IReadOnlyList<ApiRow> OptionsApiRows => [
        new("SwipeThreshold", "double", "50.0", T("Distancia minima em pixels para swipe.", "Minimum distance in pixels for swipe.")),
        new("SwipeVelocityThreshold", "double", "0.3", T("Velocidade minima para swipe.", "Minimum velocity for swipe.")),
        new("LongPressDurationMs", "long", "500", T("Duracao em ms para long press.", "Duration in ms for long press.")),
        new("DoubleTapWindowMs", "long", "300", T("Janela em ms entre taps.", "Window in ms between taps.")),
        new("EnableSwipe", "bool", "true", T("Habilita deteccao de swipe.", "Enables swipe detection.")),
        new("EnablePinch", "bool", "true", T("Habilita deteccao de pinch.", "Enables pinch detection.")),
        new("EnableLongPress", "bool", "true", T("Habilita deteccao de long press.", "Enables long press detection.")),
        new("EnableDoubleTap", "bool", "true", T("Habilita deteccao de double tap.", "Enables double tap detection.")),
        new("EnableRotate", "bool", "false", T("Habilita deteccao de rotacao.", "Enables rotation detection."))
    ];

    // === ACCESSIBILITY ===
    private IReadOnlyList<DocTile> AccessibilityItems => [
        new(T("touch-none", "touch-none"), T("Impede scroll natural do browser no container.", "Prevents natural browser scroll on container."), "hand-pointer"),
        new(T("select-none", "select-none"), T("Impede selecao de texto durante gesto.", "Prevents text selection during gesture."), "text-slash"),
        new(T("pointer-events-none", "pointer-events-none"), T("Desabilita interacoes quando Disabled=true.", "Disables interactions when Disabled=true."), "ban")
    ];

    private IReadOnlyList<NameValueRow> KeyboardRows => [];

    // === RESPONSIVENESS ===
    private IReadOnlyList<DocTile> ResponsivenessItems => [
        new(T("Touch optimized", "Touch optimized"), T("Projetado para telas touch com 44px de alvo minimo.", "Designed for touch screens with 44px minimum target."), "mobile-screen"),
        new(T("Multi-pointer", "Multi-pointer"), T("Suporta multiplos pontos de toque para pinch/rotate.", "Supports multiple touch points for pinch/rotate."), "arrows-maximize")
    ];

    // === PERFORMANCE ===
    private IReadOnlyList<DocTile> PerformanceItems => [
        new(T("Pointer events", "Pointer events"), T("Usa pointer events nativos em vez de touch events.", "Uses native pointer events instead of touch events."), "bolt"),
        new(T("Debounce automatico", "Auto debounce"), T("Thresholds configuraveis evitam gestos acidentais.", "Configurable thresholds prevent accidental gestures."), "clock")
    ];

    // === SCENARIOS ===
    private IReadOnlyList<DocTile> ScenarioItems => [
        new(T("Navegacao mobile", "Mobile navigation"), T("Swipe para voltar/avancar em telas.", "Swipe to go back/forward on screens."), "route"),
        new(T("Galeria de imagens", "Image gallery"), T("Pinch para zoom, swipe para proxima imagem.", "Pinch to zoom, swipe for next image."), "image"),
        new(T("Kiosk interativo", "Interactive kiosk"), T("Gestos em telas de autoatendimento.", "Gestos em kiosk touch screens."), "display")
    ];

    // === COMPOSITION ===
    private IReadOnlyList<DocTile> CompositionItems => [
        new(T("Gesture + Bridge", "Gesture + Bridge"), T("Combinar com XFDeviceBridge para contexto.", "Combine with XFDeviceBridge for context."), "laptop"),
        new(T("Gesture + Responsive", "Gesture + Responsive"), T("Combinar com XFResponsiveContainer.", "Combine with XFResponsiveContainer."), "arrows-maximize"),
        new(T("Gesture + Card", "Gesture + Card"), T("Wrapper em XFCard para areas interativas.", "Wrapper in XFCard for interactive areas."), "square")
    ];

    // === BEST PRACTICES ===
    private IReadOnlyList<DocTile> BestPracticeItems => [
        new(T("Thresholds adequados", "Adequate thresholds"), T("Ajuste SwipeThreshold para seu caso de uso.", "Adjust SwipeThreshold for your use case."), "sliders"),
        new(T("Callbacks granulares", "Granular callbacks"), T("Use OnTap/OnSwipeLeft ao inves de OnGesture generico.", "Use OnTap/OnSwipeLeft instead of generic OnGesture."), "bolt"),
        new(T("Desabilitar quando nao necessario", "Disable when not needed"), T("Defina Disabled=true quando gestos nao sao necessarios.", "Set Disabled=true when gestures are not needed."), "ban")
    ];

    // === ANTI-PATTERNS ===
    private IReadOnlyList<DocTile> AntiPatternItems => [
        new(T("Sem limpeza", "No cleanup"), T("O componente faz dispose automatico do modulo JS.", "The component auto-disposes the JS module."), "xmark"),
        new(T("Thresholds muito baixos", "Too low thresholds"), T("Causa gestos acidentais frequentes.", "Causes frequent accidental gestures."), "triangle-exclamation"),
        new(T("Ignorar Disabled", "Ignore Disabled"), T("Nao capture gestos quando Disabled=true.", "Do not capture gestures when Disabled=true."), "ban")
    ];

    // === TOKENS ===
    private IReadOnlyList<NameValueRow> TokenRows => [
