@page "/ai/conversation-context"
@using XForge.DesignSystem.Components.AI.Avatars
@inject XForgeDocsLanguageService L

<XForgeDocsShell ProductLabel="AI Commercial"
                 Title="@L.Text("Conversation Context", "Conversation Context")"
                 Status="@L.Text("Documentacao completa", "Complete docs")"
                 Items="XForgeDocsCatalog.AiItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFAiConversationContext" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@L.Text("Memoria contextual", "Context memory")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @L.Text("Resumo e memoria contextual para conversas assistidas por AI.",
                                   "Summary and contextual memory for AI-assisted conversations.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @L.Text("Gerenciador de contexto conversacional que armazena preferencias, fatos, acoes, decisoes e feedback do usuario. Suporta filtragem por tipo, fixacao de itens relevantes, barras de relevancia e resumo de sessao.",
                                   "Conversational context manager that stores user preferences, facts, actions, decisions, and feedback. Supports filtering by type, pinning relevant items, relevance bars, and session summary.")
                        </XFTypography>
                    </XFStack>
                    <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                        <XFAiConversationContext Title="Contexto da Conversa"
                                                 ShowHeader="true"
                                                 ShowFilters="true"
                                                 ShowRelevance="true"
                                                 ShowSummary="true"
                                                 AriaLabel="Contexto da conversa"
                                                 Entries="DemoEntries" />
                    </div>
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="3" Wrap="XFWrap.Wrap">
                        @foreach (var item in QuickFacts) { @Tile(item) }
                    </XFStack>
                </XFStack>
            </ChildContent>
        </XFCard>

        <!-- ===== 2. METADATA ===== -->
        @Section(L.Text("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, L.Text("Campo", "Field"), L.Text("Valor", "Value"))</div>)

        <!-- ===== 3. COMPATIBILITY ===== -->
        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@L.Text("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@L.Text("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@L.Text("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@L.Text("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Renderiza como HTML estatico.", "Renders as static HTML.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@L.Text("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@L.Text("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS.")</XFTypography>
            </XFStack>
        </div>)

        <!-- ===== 4-13. CORE SECTIONS ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(L.Text("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(L.Text("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(L.Text("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(L.Text("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(L.Text("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(L.Text("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 3 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(L.Text("1. Contexto completo", "1. Full context"), L.Text("Filtros, relevancia e resumo.", "Filters, relevance and summary."), ExFull(), CodeFull)
            @Example(L.Text("2. Sem filtros", "2. Without filters"), L.Text("Lista simples de contexto.", "Simple context list."), ExNoFilters(), CodeNoFilters)
            @Example(L.Text("3. Compacto", "3. Compact"), L.Text("Sem header, sem resumo, sem filtros.", "No header, no summary, no filters."), ExCompact(), CodeCompact)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(L.Text("Eventos", "Events"), @<div>@NameValueTable(EventRows, L.Text("Evento", "Event"), L.Text("Comportamento", "Behavior"))</div>)
            @Section(L.Text("Tipos", "Types"), @<div>@NameValueTable(TypeRows, L.Text("Tipo", "Type"), L.Text("Descricao", "Description"))</div>)
        </XFStack>

        <!-- ===== A11Y + UX ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(L.Text("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, L.Text("Tecla", "Key"), L.Text("Comportamento", "Behavior"))</div>)
            @Section(L.Text("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(L.Text("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <!-- ===== ENTERPRISE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(L.Text("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(L.Text("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(L.Text("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <!-- ===== TOKENS + THEMING + TESTING ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", L.Text("Proposito", "Purpose"))</div>)
            @Section(L.Text("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(L.Text("Testes", "Testing"), @<div>@NameValueTable(TestingRows, L.Text("Cobertura", "Coverage"), L.Text("Evidencia", "Evidence"))</div>)
            @Section(L.Text("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, L.Text("Limitacao", "Limitation"), L.Text("Status", "Status"))</div>)
            @Section(L.Text("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, L.Text("Pergunta", "Question"), L.Text("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, L.Text("Versao", "Version"), L.Text("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string T(string pt, string en) => L.Text(pt, en);
    private string CopyableCodeTitle => L.Text("Codigo copiavel", "Copyable code");

    // === DEMO DATA ===
    private static readonly IReadOnlyList<XFAiContextEntry> DemoEntries = new[]
    {
        new XFAiContextEntry { Type = XFAiContextEntryType.Preference, Content = "Usuario prefere nota fiscal modelo 55", Source = "ai", Relevance = 0.95, IsPinned = true, Tags = new[] { "nfe", "modelo" } },
        new XFAiContextEntry { Type = XFAiContextEntryType.Fact, Content = "Empresa ABC LTDA - CNPJ 12.345.678/0001-90", Source = "user", Relevance = 0.90, Tags = new[] { "empresa" } },
        new XFAiContextEntry { Type = XFAiContextEntryType.Action, Content = "Nota fiscal #1234 emitida com sucesso", Source = "system", Relevance = 0.80 },
        new XFAiContextEntry { Type = XFAiContextEntryType.Decision, Content = "Regime tributario: Lucro Presumido", Source = "user", Relevance = 0.85, Tags = new[] { "fiscal" } },
        new XFAiContextEntry { Type = XFAiContextEntryType.Feedback, Content = "Resposta anterior foi uteis", Source = "user", Relevance = 0.70 }
    };

    // === HERO ===
    private IReadOnlyList<DocTile> QuickFacts => [
        new(L.Text("Memoria contextual", "Context memory"), L.Text("Armazena preferencias, fatos e decisoes.", "Stores preferences, facts and decisions."), "brain"),
        new(L.Text("Filtragem por tipo", "Filter by type"), L.Text("Filtros para Preference, Fact, Action, Decision, Feedback, System.", "Filters for Preference, Fact, Action, Decision, Feedback, System."), "filter"),
        new(L.Text("Relevancia", "Relevance"), L.Text("Barras de relevancia com cores semanticas.", "Relevance bars with semantic colors."), "chart-bar")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFAiConversationContext"),
        new("Namespace", "XForge.DesignSystem.Components.AI.Avatars"),
        new("Package", "XForge.DesignSystem.AI"),
        new("Category", "AI / Context"),
        new("Status", L.Text("Estavel", "Stable")),
        new("Accessibility", "role=region, aria-label, aria-busy, aria-live."),
        new("Theme support", L.Text("Light, dark e data-brand via tokens.", "Light, dark and data-brand via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(L.Text("Contexto conversacional", "Conversational context"), L.Text("Armazena informacoes relevantes da conversa.", "Stores relevant conversation information."), "brain"),
        new(L.Text("Filtragem e fixacao", "Filtering and pinning"), L.Text("Filtros por tipo e fixacao de itens.", "Type filters and item pinning."), "filter"),
        new(L.Text("Resumo de sessao", "Session summary"), L.Text("Contagem de contexto, fixados e duracao.", "Context count, pinned and duration."), "chart-bar")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(L.Text("Memoria de AI", "AI memory"), L.Text("Manter contexto entre mensagens de conversa.", "Maintain context between conversation messages."), "brain"),
        new(L.Text("Preferencias do usuario", "User preferences"), L.Text("Aprender e lembrar preferencias do usuario.", "Learn and remember user preferences."), "gear"),
        new(L.Text("Auditoria conversacional", "Conversational audit"), L.Text("Registro de decisoes e acoes durante a conversa.", "Record of decisions and actions during conversation."), "clipboard")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(L.Text("Antes", "Before"), L.Text("AI perde contexto entre mensagens.", "AI loses context between messages."), "xmark"),
        new(L.Text("Depois", "After"), L.Text("Contexto persistente com filtragem e fixacao.", "Persistent context with filtering and pinning."), "check"),
        new(L.Text("Acessibilidade", "Accessibility"), L.Text("Filtros acessiveis via teclado, aria-live para atualizacoes.", "Keyboard-accessible filters, aria-live for updates."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(L.Text("Chatbots enterprise", "Enterprise chatbots"), L.Text("Manter contexto em conversas longas.", "Maintain context in long conversations."), "comments"),
        new(L.Text("Assistentes de AI", "AI assistants"), L.Text("Memoria de preferencias do usuario.", "User preference memory."), "robot")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(L.Text("Estado global", "Global state"), L.Text("Use servico de backend para persistencia.", "Use backend service for persistence."), "xmark"),
        new(L.Text("Dados sensiveis", "Sensitive data"), L.Text("Nao armazene dados sensiveis no contexto.", "Do not store sensitive data in context."), "ban")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new("Header", L.Text("Titulo, contagem e botao limpar.", "Title, count and clear button."), "heading"),
        new("Filter chips", L.Text("Filtros por tipo de contexto.", "Context type filters."), "filter"),
        new("Entry list", L.Text("Lista de contextos com tipo, conteudo, fonte e relevancia.", "Context list with type, content, source and relevance."), "list"),
        new("Summary footer", L.Text("Total de contexto e fixados.", "Total context and pinned."), "chart-bar")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(L.Text("Transparencia", "Transparency"), L.Text("Mostra o que a AI lembra do usuario.", "Shows what the AI remembers about the user."), "eye"),
        new(L.Text("Controle do usuario", "User control"), L.Text("Usuario pode filtrar, fixar e remover contextos.", "User can filter, pin and remove contexts."), "gear"),
        new(L.Text("Relevancia visual", "Visual relevance"), L.Text("Barras de cores indicam importancia.", "Color bars indicate importance."), "chart-bar")
    ];

    // === EXAMPLES ===
    private RenderFragment ExFull() => @<XFAiConversationContext Title="Contexto Completo"
                                                                 ShowHeader="true"
                                                                 ShowFilters="true"
                                                                 ShowRelevance="true"
                                                                 ShowSummary="true"
                                                                 AriaLabel="Contexto completo"
                                                                 Entries="DemoEntries" />;

    private RenderFragment ExNoFilters() => @<XFAiConversationContext Title="Sem Filtros"
                                                                      ShowHeader="true"
                                                                      ShowFilters="false"
                                                                      ShowRelevance="true"
                                                                      ShowSummary="true"
                                                                      AriaLabel="Sem filtros"
                                                                      Entries="DemoEntries" />;

    private RenderFragment ExCompact() => @<XFAiConversationContext Title="Compacto"
                                                                    ShowHeader="false"
                                                                    ShowFilters="false"
                                                                    ShowRelevance="false"
                                                                    ShowSummary="false"
                                                                    AriaLabel="Compacto"
                                                                    Entries="DemoEntries" />;

    private const string CodeFull = @"<XFAiConversationContext Title=""Contexto Completo""
    ShowHeader=""true""
    ShowFilters=""true""
    ShowRelevance=""true""
    ShowSummary=""true""
    AriaLabel=""Contexto completo""
    Entries=""@Entries"" />";

    private const string CodeNoFilters = @"<XFAiConversationContext Title=""Sem Filtros""
    ShowHeader=""true""
    ShowFilters=""false""
    ShowRelevance=""true""
    ShowSummary=""true""
    AriaLabel=""Sem filtros""
    Entries=""@Entries"" />";

    private const string CodeCompact = @"<XFAiConversationContext Title=""Compacto""
    ShowHeader=""false""
    ShowFilters=""false""
    ShowRelevance=""false""
    ShowSummary=""false""
    AriaLabel=""Compacto""
    Entries=""@Entries"" />";

    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("Title", "string", "\"Contexto da Conversa\"", L.Text("Titulo exibido no header.", "Title displayed in header.")),
        new("ShowHeader", "bool", "true", L.Text("Exibe header com titulo e botao limpar.", "Shows header with title and clear button.")),
        new("ShowFilters", "bool", "true", L.Text("Exibe chips de filtro por tipo.", "Shows type filter chips.")),
        new("ShowRelevance", "bool", "true", L.Text("Exibe barras de relevancia.", "Shows relevance bars.")),
        new("ShowSummary", "bool", "true", L.Text("Exibe rodape com resumo.", "Shows footer with summary.")),
        new("EmptyText", "string", "\"Nenhum contexto capturado ainda.\"", L.Text("Texto exibido quando vazio.", "Text displayed when empty.")),
        new("ClearLabel", "string", "\"Limpar\"", L.Text("Label do botao limpar.", "Clear button label.")),
        new("AriaLabel", "string", "\"Contexto da conversa\"", L.Text("Label ARIA para o componente.", "ARIA label for the component.")),
        new("Entries", "IReadOnlyList<XFAiContextEntry>", "[]", L.Text("Entradas de contexto externas.", "External context entries."))
    ];

    private IReadOnlyList<NameValueRow> EventRows => [
        new("EntriesChanged", L.Text("Disparado quando entradas mudam. Retorna lista de XFAiContextEntry.", "Fired when entries change. Returns list of XFAiContextEntry.")),
        new("OnEntryRemoved", L.Text("Disparado quando uma entrada e removida. Retorna XFAiContextEntry removida.", "Fired when an entry is removed. Returns removed XFAiContextEntry.")),
        new("OnClear", L.Text("Disparado quando todas as entradas sao limpas.", "Fired when all entries are cleared."))
    ];

    private IReadOnlyList<NameValueRow> TypeRows => [
        new("XFAiContextEntry", L.Text("Record com Id, Type, Content, Source, Relevance, Tags, Timestamp, IsPinned.", "Record with Id, Type, Content, Source, Relevance, Tags, Timestamp, IsPinned.")),
        new("XFAiContextEntryType", L.Text("Enum: Preference, Fact, Action, Decision, Feedback, System.", "Enum: Preference, Fact, Action, Decision, Feedback, System.")),
        new("XFAiConversationSummary", L.Text("Record com ContextEntryCount, PinnedCount, SessionStarted, LastActivity, Duration.", "Record with ContextEntryCount, PinnedCount, SessionStarted, LastActivity, Duration."))
    ];

    // === ACCESSIBILITY ===
    private IReadOnlyList<DocTile> AccessibilityItems => [
        new("role=region", L.Text("Container principal usa role=region.", "Main container uses role=region."), "universal-access"),
        new("aria-label", L.Text("Label descritivo do componente.", "Descriptive component label."), "tag"),
        new("aria-busy", L.Text("Indica estado de processamento.", "Indicates processing state."), "spinner"),
        new("aria-live=polite", L.Text("Atualizacoes anunciadas para leitores de tela.", "Updates announced for screen readers."), "volume-high")
    ];

    private IReadOnlyList<NameValueRow> KeyboardRows => [
        new("Tab", L.Text("Navega entre filtros, entradas e botoes.", "Navigates between filters, entries and buttons.")),
        new("Enter/Space", L.Text("Ativa filtro ou botao de acao.", "Activates filter or action button.")),
        new("Delete", L.Text("Remove entrada selecionada.", "Removes selected entry."))
    ];

    // === RESPONSIVENESS ===
    private IReadOnlyList<DocTile> ResponsivenessItems => [
        new(L.Text("Largura total", "Full width"), L.Text("Componente ocupa 100% do container.", "Component occupies 100% of container."), "maximize"),
        new(L.Text("Filtros responsivos", "Responsive filters"), L.Text("Chips de filtro embrulham em mobile.", "Filter chips wrap on mobile."), "mobile-screen")
    ];

    // === PERFORMANCE ===
    private IReadOnlyList<DocTile> PerformanceItems => [
        new(L.Text("Zero JS", "Zero JS"), L.Text("Nenhum JavaScript interop.", "No JavaScript interop."), "bolt"),
        new(L.Text("Render leve", "Light render"), L.Text("Lista virtualizada para muitos contextos.", "Virtualized list for many contexts."), "feather")
    ];

    // === SCENARIOS ===
    private IReadOnlyList<DocTile> ScenarioItems => [
        new(L.Text("Chatbot fiscal", "Tax chatbot"), L.Text("Memoria de preferencias fiscais do usuario.", "User tax preference memory."), "file-invoice"),
        new(L.Text("Assistente de compras", "Shopping assistant"), L.Text("Lembra preferencias de produto e fornecedor.", "Remembers product and supplier preferences."), "cart"),
        new(L.Text("Suporte tecnico", "Technical support"), L.Text("Registro de problemas e solucoes discutidas.", "Record of discussed issues and solutions."), "wrench")
    ];

    // === COMPOSITION ===
    private IReadOnlyList<DocTile> CompositionItems => [
        new(L.Text("Context + Chat", "Context + Chat"), L.Text("Integracao com XFAiChat para contexto automatico.", "Integration with XFAiChat for automatic context."), "comments"),
        new(L.Text("Context + Prompt", "Context + Prompt"), L.Text("Enriquecimento de prompts com contexto.", "Prompt enrichment with context."), "text-input"),
        new(L.Text("Context + Avatar", "Context + Avatar"), L.Text("Exibicao de contexto ao lado do avatar do AI.", "Context display alongside AI avatar."), "user")
    ];

    // === BEST PRACTICES ===
    private IReadOnlyList<DocTile> BestPracticeItems => [
        new(L.Text("Fixar contexto importante", "Pin important context"), L.Text("Use IsPinned=true para contexto sempre incluido.", "Use IsPinned=true for always-included context."), "thumbtack"),
        new(L.Text("Limpar periodicamente", "Clear periodically"), L.Text("Limpe contextos antigos para manter performance.", "Clear old contexts to maintain performance."), "eraser"),
        new(L.Text("Fonte clara", "Clear source"), L.Text("Indique se contexto vem de user, ai ou system.", "Indicate if context comes from user, ai or system."), "tag"),
        new(L.Text("Relevancia precisa", "Accurate relevance"), L.Text("Atualize scores de relevancia conforme conversa evolui.", "Update relevance scores as conversation evolves."), "chart-bar")
    ];

    // === ANTI-PATTERNS ===
    private IReadOnlyList<DocTile> AntiPatternItems => [
        new(L.Text("Sem fonte", "No source"), L.Text("Contexto sem indicar origem e confuso.", "Context without source indication is confusing."), "xmark"),
        new(L.Text("Muitos fixados", "Too many pinned"), L.Text("Nao fixe mais de 5 itens. Use relevancia.", "Do not pin more than 5 items. Use relevance."), "ban"),
        new(L.Text("Relevancia estatica", "Static relevance"), L.Text("Scores devem mudar ao longo da conversa.", "Scores should change throughout conversation."), "triangle-exclamation")
    ];

    // === TOKENS ===
    private IReadOnlyList<NameValueRow> TokenRows => [
        new("container", L.Text("rounded-lg border border-border-light bg-bg-surface.", "rounded-lg border border-border-light bg-bg-surface.")),
        new("filter-chip", L.Text("rounded-full bg-surface-100 px-2.5 py-0.5 text-xs.", "rounded-full bg-surface-100 px-2.5 py-0.5 text-xs.")),
        new("entry-row", L.Text("flex items-start gap-3 border-b px-4 py-3.", "flex items-start gap-3 border-b px-4 py-3.")),
        new("relevance-bar", L.Text("h-1.5 w-12 overflow-hidden rounded-full bg-surface-200.", "h-1.5 w-12 overflow-hidden rounded-full bg-surface-200."))
    ];

    // === THEMING ===
    private IReadOnlyList<DocTile> ThemeItems => [
        new("data-theme", L.Text("Tokens light/dark via CSS variables.", "Light/dark tokens via CSS variables."), "moon"),
        new("data-brand", L.Text("Cores de tipo acompanham tema.", "Type colors follow theme."), "swatchbook")
    ];

    // === TESTING ===
    private IReadOnlyList<NameValueRow> TestingRows => [
        new("Unit", L.Text("Testes de render, filtros, adicionar, remover, limpar.", "Render, filter, add, remove, clear tests.")),
        new("Accessibility", L.Text("role=region, aria-label, aria-busy, aria-live.", "role=region, aria-label, aria-busy, aria-live."))
    ];

    // === LIMITATIONS ===
    private IReadOnlyList<NameValueRow> LimitationRows => [
        new(L.Text("Persistencia", "Persistence"), L.Text("Componente e stateful. Use EntriesChanged para persistir.", "Component is stateful. Use EntriesChanged to persist.")),
        new(L.Text("Performance", "Performance"), L.Text("Para >100 entradas, considere paginacao ou virtualizacao.", "For >100 entries, consider pagination or virtualization."))
    ];

    // === RELATED ===
