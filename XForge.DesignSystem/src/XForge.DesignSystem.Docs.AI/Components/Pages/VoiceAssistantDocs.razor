        new("XFAiCommandPalette", L.Text("Comandos por teclado.", "Keyboard commands."), "keyboard"),
        new("XFAiPromptBox", L.Text("Entrada de prompts para AI.", "AI prompt input."), "text-input")
    ];

    // === FAQ ===
    private IReadOnlyList<NameValueRow> FaqRows => [
        new(L.Text("Precisa de JS interop?", "Needs JS interop?"), L.Text("Sim, para gravacao (MediaRecorder) e reproducao (AudioContext).", "Yes, for recording (MediaRecorder) and playback (AudioContext).")),
