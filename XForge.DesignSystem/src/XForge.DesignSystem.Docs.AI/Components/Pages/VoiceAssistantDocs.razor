@page "/ai/voice-assistant"
@using XForge.DesignSystem.Components.AI.Audio
@inject XForgeDocsLanguageService L

<XForgeDocsShell ProductLabel="AI Commercial"
                 Title="@L.Text("Voice Assistant", "Voice Assistant")"
                 Status="@L.Text("Documentacao completa", "Complete docs")"
                 Items="XForgeDocsCatalog.AiItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFAiVoiceAssistant" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@L.Text("Speech-to-text + Text-to-speech", "Speech-to-text + Text-to-speech")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @L.Text("Assistente de voz para transcricao, comandos falados e resposta por audio em fluxos comerciais.",
                                   "Voice assistant for transcription, spoken commands, and audio response in commercial workflows.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @L.Text("Componente enterprise com gravacao de audio, transcricao em tempo real, sintese de fala (TTS), indicadores de confianca e suporte a multiplos idiomas. Integra com IAiAudioProvider para processamento de audio.",
                                   "Enterprise component with audio recording, real-time transcription, text-to-speech (TTS), confidence indicators, and multi-language support. Integrates with IAiAudioProvider for audio processing.")
                        </XFTypography>
                    </XFStack>
                    <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                        <XFAiVoiceAssistant Title="Comando por voz"
                                            Language="pt-BR"
                                            ShowTextToSpeech="true"
                                            ShowHeader="true"
                                            AriaLabel="Assistente de voz para comandos ERP" />
                    </div>
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="3" Wrap="XFWrap.Wrap">
                        @foreach (var item in QuickFacts) { @Tile(item) }
                    </XFStack>
                </XFStack>
            </ChildContent>
        </XFCard>

        <!-- ===== 2. METADATA ===== -->
        @Section(L.Text("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, L.Text("Campo", "Field"), L.Text("Valor", "Value"))</div>)

        <!-- ===== 3. COMPATIBILITY ===== -->
        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@L.Text("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@L.Text("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@L.Text("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@L.Text("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Funciona com IAiAudioProvider via DI.", "Works with IAiAudioProvider via DI.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@L.Text("Parcial", "Partial")" /></XFTableCell><XFTableCell>@L.Text("Requer JS interop para MediaRecorder.", "Requires JS interop for MediaRecorder.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Danger" Text="@L.Text("Nao", "No")" /></XFTableCell><XFTableCell>@L.Text("Gravacao de audio requer interatividade.", "Audio recording requires interactivity.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@L.Text("Dependencias", "Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@L.Text("Requer IAiAudioProvider registrado no DI para transcricao e sintese de fala. Em producao, requer JS interop para MediaRecorder (gravacao) e AudioContext (reproducao).", "Requires IAiAudioProvider registered in DI for transcription and speech synthesis. In production, requires JS interop for MediaRecorder (recording) and AudioContext (playback).")</XFTypography>
            </XFStack>
        </div>)

        <!-- ===== 4-13. CORE SECTIONS ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(L.Text("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(L.Text("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(L.Text("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(L.Text("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(L.Text("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(L.Text("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 3 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(L.Text("1. Assistente basico", "1. Basic assistant"), L.Text("Microfone com transcricao e TTS.", "Microphone with transcription and TTS."), ExBasic(), CodeBasic)
            @Example(L.Text("2. Sem TTS", "2. Without TTS"), L.Text("Apenas gravacao e transcricao.", "Recording and transcription only."), ExNoTts(), CodeNoTts)
            @Example(L.Text("3. Idioma customizado", "3. Custom language"), L.Text("Assistente configurado para ingles.", "Assistant configured for English."), ExCustomLang(), CodeCustomLang)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(L.Text("Eventos", "Events"), @<div>@NameValueTable(EventRows, L.Text("Evento", "Event"), L.Text("Comportamento", "Behavior"))</div>)
            @Section(L.Text("Tipos", "Types"), @<div>@NameValueTable(TypeRows, L.Text("Tipo", "Type"), L.Text("Descricao", "Description"))</div>)
        </XFStack>

        <!-- ===== A11Y + UX ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(L.Text("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, L.Text("Tecla", "Key"), L.Text("Comportamento", "Behavior"))</div>)
            @Section(L.Text("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(L.Text("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <!-- ===== ENTERPRISE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(L.Text("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(L.Text("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(L.Text("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <!-- ===== TOKENS + THEMING + TESTING ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", L.Text("Proposito", "Purpose"))</div>)
            @Section(L.Text("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(L.Text("Testes", "Testing"), @<div>@NameValueTable(TestingRows, L.Text("Cobertura", "Coverage"), L.Text("Evidencia", "Evidence"))</div>)
            @Section(L.Text("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, L.Text("Limitacao", "Limitation"), L.Text("Status", "Status"))</div>)
            @Section(L.Text("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, L.Text("Pergunta", "Question"), L.Text("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, L.Text("Versao", "Version"), L.Text("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string T(string pt, string en) => L.Text(pt, en);
    private string CopyableCodeTitle => L.Text("Codigo copiavel", "Copyable code");

    // === HERO ===
    private IReadOnlyList<DocTile> QuickFacts => [
        new(L.Text("Speech-to-text", "Speech-to-text"), L.Text("Gravacao e transcricao de audio.", "Audio recording and transcription."), "microphone"),
        new(L.Text("Text-to-speech", "Text-to-speech"), L.Text("Sintese de fala a partir de texto.", "Speech synthesis from text."), "volume-high"),
        new(L.Text("Multi-idioma", "Multi-language"), L.Text("Suporte a pt-BR, en-US e outros.", "Support for pt-BR, en-US and others."), "globe")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFAiVoiceAssistant"),
        new("Namespace", "XForge.DesignSystem.Components.AI.Audio"),
        new("Package", "XForge.DesignSystem.AI"),
        new("Category", "AI / Audio"),
        new("Status", L.Text("Estavel", "Stable")),
        new("Accessibility", "role=region, aria-label, aria-busy, aria-live=polite."),
        new("Theme support", L.Text("Light e dark via tokens CSS.", "Light and dark via CSS tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(L.Text("Gravacao de audio", "Audio recording"), L.Text("Botao de microfone com estados visuais.", "Microphone button with visual states."), "microphone"),
        new(L.Text("Transcricao", "Transcription"), L.Text("Texto transcrito com timestamps e confianca.", "Transcribed text with timestamps and confidence."), "text"),
        new(L.Text("Sintese de fala", "Speech synthesis"), L.Text("Conversao de texto em audio via TTS.", "Text to audio conversion via TTS."), "volume-high")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(L.Text("Comandos por voz", "Voice commands"), L.Text("Entrada de dados via fala em ERP.", "Data input via speech in ERP."), "microphone"),
        new(L.Text("Transcricao de reunioes", "Meeting transcription"), L.Text("Registro automatico de reunioes.", "Automatic meeting recording."), "calendar"),
        new(L.Text("Atendimento ao cliente", "Customer service"), L.Text("Respostas por audio em chatbots.", "Audio responses in chatbots."), "headset")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(L.Text("Antes", "Before"), L.Text("Digitacao manual de dados falados.", "Manual typing of spoken data."), "xmark"),
        new(L.Text("Depois", "After"), L.Text("Transcricao automatica com confianca.", "Automatic transcription with confidence."), "check"),
        new(L.Text("Acessibilidade", "Accessibility"), L.Text("Alternativa de entrada para usuarios com deficiencia motor.", "Input alternative for users with motor disabilities."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(L.Text("ERP mobile", "Mobile ERP"), L.Text("Entrada de dados em campo via voz.", "Field data input via voice."), "mobile"),
        new(L.Text("Assistente virtual", "Virtual assistant"), L.Text("Integracao com chatbots voice-enabled.", "Integration with voice-enabled chatbots."), "robot")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(L.Text("Ambiente ruidoso", "Noisy environment"), L.Text("Transcricao pode ser imprecisa.", "Transcription may be inaccurate."), "xmark"),
        new(L.Text("Dados sensiveis", "Sensitive data"), L.Text("Audio pode conter informacoes confidenciais.", "Audio may contain confidential information."), "ban")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new("Header", L.Text("Titulo e conteudo customizado.", "Title and custom content."), "heading"),
        new("Microphone", L.Text("Botao circular com estados e animacao.", "Circular button with states and animation."), "microphone"),
        new("Transcription log", L.Text("Lista de transcricoes com timestamps.", "List of transcriptions with timestamps."), "text"),
        new("TTS input", L.Text("Campo de texto para sintese de fala.", "Text field for speech synthesis."), "keyboard")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(L.Text("Feedback visual", "Visual feedback"), L.Text("Estados claro: Idle, Listening, Processing, Speaking.", "Clear states: Idle, Listening, Processing, Speaking."), "eye"),
        new(L.Text("Seguranca", "Safety"), L.Text("Confirmacao antes de acoes criticas via voz.", "Confirmation before critical actions via voice."), "shield"),
        new(L.Text("Simplicidade", "Simplicity"), L.Text("Um botao principal. Sem complexidade desnecessaria.", "One main button. No unnecessary complexity."), "minimize")
    ];

    // === EXAMPLES ===
    private RenderFragment ExBasic() => @<XFAiVoiceAssistant Title="Comando por voz"
                                                              Language="pt-BR"
                                                              ShowHeader="true"
                                                              ShowTextToSpeech="true"
                                                              AriaLabel="Assistente de voz basico" />;

    private RenderFragment ExNoTts() => @<XFAiVoiceAssistant Title="Apenas transcricao"
                                                             Language="pt-BR"
                                                             ShowHeader="true"
                                                             ShowTextToSpeech="false"
                                                             AriaLabel="Assistente sem TTS" />;

    private RenderFragment ExCustomLang() => @<XFAiVoiceAssistant Title="English Assistant"
                                                                   Language="en-US"
                                                                   ShowHeader="true"
                                                                   ShowTextToSpeech="true"
                                                                   AriaLabel="English voice assistant" />;

    private const string CodeBasic = @"<XFAiVoiceAssistant Title=""Comando por voz""
    Language=""pt-BR""
    ShowHeader=""true""
    ShowTextToSpeech=""true""
    AriaLabel=""Assistente de voz basico"" />";

    private const string CodeNoTts = @"<XFAiVoiceAssistant Title=""Apenas transcricao""
    Language=""pt-BR""
    ShowHeader=""true""
    ShowTextToSpeech=""false""
    AriaLabel=""Assistente sem TTS"" />";

    private const string CodeCustomLang = @"<XFAiVoiceAssistant Title=""English Assistant""
    Language=""en-US""
    ShowHeader=""true""
    ShowTextToSpeech=""true""
    AriaLabel=""English voice assistant"" />";

    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("Title", "string?", "null", L.Text("Titulo exibido no header.", "Title displayed in header.")),
        new("ShowHeader", "bool", "true", L.Text("Exibe o header com titulo.", "Shows header with title.")),
        new("ShowTextToSpeech", "bool", "true", L.Text("Exibe secao de sintese de fala.", "Shows text-to-speech section.")),
        new("Language", "string?", "\"pt-BR\"", L.Text("Idioma para transcricao e TTS.", "Language for transcription and TTS.")),
        new("AriaLabel", "string", "\"Assistente de voz AI\"", L.Text("Label ARIA para o assistente.", "ARIA label for the assistant.")),
        new("Disabled", "bool", "false", L.Text("Desabilita interacoes.", "Disables interactions."))
    ];

    private IReadOnlyList<NameValueRow> EventRows => [
        new("OnTranscriptionComplete", L.Text("Disparado quando transcricao e concluida. Retorna XFAiTranscriptionResult com Text, Language, DurationSeconds, Confidence.", "Fired when transcription completes. Returns XFAiTranscriptionResult with Text, Language, DurationSeconds, Confidence.")),
        new("OnStateChanged", L.Text("Disparado ao mudar estado. Retorna XFAiVoiceState (Idle, Listening, Processing, Speaking, Error).", "Fired on state change. Returns XFAiVoiceState (Idle, Listening, Processing, Speaking, Error).")),
        new("OnError", L.Text("Disparado em erros de transcricao ou sintese. Retorna mensagem de erro.", "Fired on transcription or synthesis errors. Returns error message."))
    ];

    private IReadOnlyList<NameValueRow> TypeRows => [
        new("XFAiVoiceState", L.Text("Enum: Idle, Listening, Processing, Speaking, Error.", "Enum: Idle, Listening, Processing, Speaking, Error.")),
        new("XFAiTranscriptionResult", L.Text("Record com Text, Language, DurationSeconds, Confidence, IsPartial, Timestamp.", "Record with Text, Language, DurationSeconds, Confidence, IsPartial, Timestamp."))
    ];

    // === ACCESSIBILITY ===
    private IReadOnlyList<DocTile> AccessibilityItems => [
        new("role=region", L.Text("Container principal usa role=region.", "Main container uses role=region."), "universal-access"),
        new("aria-label", L.Text("Label descritivo do assistente.", "Descriptive assistant label."), "tag"),
        new("aria-busy", L.Text("Indica estado de processamento.", "Indicates processing state."), "spinner"),
        new("aria-live=polite", L.Text("Transcricoes anunciadas para leitores de tela.", "Transcriptions announced for screen readers."), "volume-high")
    ];

    private IReadOnlyList<NameValueRow> KeyboardRows => [
        new("Tab", L.Text("Navega entre microfone, campo TTS e botoes.", "Navigates between microphone, TTS field and buttons.")),
        new("Enter/Space", L.Text("Ativa microfone ou botao TTS.", "Activates microphone or TTS button.")),
        new("Esc", L.Text("Para gravacao ou reproducao.", "Stops recording or playback."))
    ];

    // === RESPONSIVENESS ===
    private IReadOnlyList<DocTile> ResponsivenessItems => [
        new(L.Text("Botao responsivo", "Responsive button"), L.Text("Botao de microfone 80x80px, adequado para mobile.", "80x80px microphone button, suitable for mobile."), "mobile-screen"),
        new(L.Text("Layout adaptivo", "Adaptive layout"), L.Text("TTS input empilha em telas estreitas.", "TTS input stacks on narrow screens."), "maximize")
    ];

    // === PERFORMANCE ===
    private IReadOnlyList<DocTile> PerformanceItems => [
        new(L.Text("Streaming", "Streaming"), L.Text("Transcricao em tempo real via IAiAudioProvider.", "Real-time transcription via IAiAudioProvider."), "bolt"),
        new(L.Text("Lazy loading", "Lazy loading"), L.Text("Audio processado sob demanda.", "Audio processed on demand."), "feather")
    ];

    // === SCENARIOS ===
    private IReadOnlyList<DocTile> ScenarioItems => [
        new(L.Text("Comando ERP", "ERP command"), L.Text("\"Criar nota fiscal para cliente X\" via voz.", "\"Create invoice for client X\" via voice."), "file-invoice"),
        new(L.Text("Transcricao de reuniao", "Meeting transcription"), L.Text("Gravacao e transcricao automatica de reunioes.", "Automatic meeting recording and transcription."), "calendar"),
        new(L.Text("Atendimento", "Customer service"), L.Text("Respostas por audio em call centers.", "Audio responses in call centers."), "headset")
    ];

    // === COMPOSITION ===
    private IReadOnlyList<DocTile> CompositionItems => [
        new(L.Text("Voice + Chat", "Voice + Chat"), L.Text("Integracao com XFAiChat para entrada mista.", "Integration with XFAiChat for mixed input."), "comments"),
        new(L.Text("Voice + Form", "Voice + Form"), L.Text("Preenchimento de formularios por voz.", "Form filling via voice."), "text-input"),
        new(L.Text("Voice + Command", "Voice + Command"), L.Text("Execucao de comandos ERP por voz.", "ERP command execution via voice."), "terminal")
    ];

    // === BEST PRACTICES ===
    private IReadOnlyList<DocTile> BestPracticeItems => [
        new(L.Text("Confirmacao de acao", "Action confirmation"), L.Text("Confirme acoes criticas antes de executar.", "Confirm critical actions before executing."), "shield"),
        new(L.Text("Feedback sonoro", "Audio feedback"), L.Text("Use TTS para confirmar comandos executados.", "Use TTS to confirm executed commands."), "volume-high"),
        new(L.Text("Fallback visual", "Visual fallback"), L.Text("Sempre ofereca alternativa de texto.", "Always provide text alternative."), "keyboard"),
        new(L.Text("Idioma correto", "Correct language"), L.Text("Configure Language para o idioma do usuario.", "Configure Language for user's language."), "globe")
    ];

    // === ANTI-PATTERNS ===
    private IReadOnlyList<DocTile> AntiPatternItems => [
        new(L.Text("Sem fallback", "No fallback"), L.Text("Nao ofereca apenas entrada por voz.", "Do not offer only voice input."), "xmark"),
        new(L.Text("Gravacao sem aviso", "Recording without notice"), L.Text("Sempre indique quando esta gravando.", "Always indicate when recording."), "ban"),
        new(L.Text("Idioma errado", "Wrong language"), L.Text("Nao configure idioma diferente do usuario.", "Do not configure language different from user's."), "triangle-exclamation")
    ];

    // === TOKENS ===
    private IReadOnlyList<NameValueRow> TokenRows => [
        new("microphone-btn", L.Text("relative w-20 h-20 rounded-full flex items-center justify-center.", "relative w-20 h-20 rounded-full flex items-center justify-center.")),
        new("pulse", L.Text("absolute inset-0 rounded-full bg-emerald-400 opacity-20 animate-ping.", "absolute inset-0 rounded-full bg-emerald-400 opacity-20 animate-ping.")),
        new("transcription-log", L.Text("bg-gray-50 dark:bg-gray-800/50 rounded-lg p-3.", "bg-gray-50 dark:bg-gray-800/50 rounded-lg p-3."))
