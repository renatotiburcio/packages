@page "/ai/workflow-executor"
@inject XForgeDocsLanguageService L

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.AiItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFAiWorkflowExecutor" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@L.Text("Execucao e progresso", "Execution and progress")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @L.Text("Executor visual para acompanhar progresso, status, logs e cancelamento de workflows de IA em tempo real.",
                                   "Visual executor to track progress, status, logs and cancellation of AI workflows in real time.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @L.Text("Motor de execucao de workflows com progresso passo a passo, filtragem de logs, suporte a cancelamento e estados semanticos. Puro Blazor, sem JavaScript interop.",
                                   "Workflow execution engine with step-by-step progression, log filtering, cancel support and semantic states. Pure Blazor, no JavaScript interop.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(L.Text("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, L.Text("Campo", "Field"), L.Text("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@L.Text("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@L.Text("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@L.Text("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@L.Text("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Funciona sem restricoes. Execucao reativa.", "Works without restrictions. Reactive execution.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Renderiza como HTML estatico.", "Renders as static HTML.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@L.Text("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@L.Text("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(L.Text("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(L.Text("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(L.Text("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(L.Text("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(L.Text("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(L.Text("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 3 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(L.Text("1. Execucao em andamento", "1. Running Execution"), L.Text("Executor com progresso, logs e status de execucao ativa.", "Executor with progress, logs and active execution status."), ExRunning(), Code1)
            @Example(L.Text("2. Sem execucao", "2. No Execution"), L.Text("Estado vazio com mensagem de configuracao.", "Empty state with configuration message."), ExEmpty(), Code2)
            @Example(L.Text("3. Execucao concluida", "3. Completed Execution"), L.Text("Executor com execucao finalizada e logs completos.", "Executor with finished execution and complete logs."), ExCompleted(), Code3)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(L.Text("Eventos", "Events"), @<div>@NameValueTable(EventRows, L.Text("Evento", "Event"), L.Text("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(L.Text("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, L.Text("Tecla", "Key"), L.Text("Comportamento", "Behavior"))</div>)
            @Section(L.Text("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(L.Text("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(L.Text("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(L.Text("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(L.Text("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", L.Text("Proposito", "Purpose"))</div>)
            @Section(L.Text("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(L.Text("Testes", "Testing"), @<div>@NameValueTable(TestingRows, L.Text("Cobertura", "Coverage"), L.Text("Evidencia", "Evidence"))</div>)
            @Section(L.Text("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, L.Text("Limitacao", "Limitation"), L.Text("Status", "Status"))</div>)
            @Section(L.Text("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, L.Text("Pergunta", "Question"), L.Text("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, L.Text("Versao", "Version"), L.Text("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string ProductLabelText => L.Text("AI Commercial", "AI Commercial");
    private string PageTitleText => L.Text("XFAiWorkflowExecutor", "XFAiWorkflowExecutor");
    private string PageStatusText => L.Text("Documentacao completa", "Complete docs");
    private string CopyableCodeTitle => L.Text("Codigo copiavel", "Copyable code");

    private static readonly XFAiWfExecutionState MockExecution = new()
    {
        WorkflowName = "Conciliacao fiscal",
        Status = XFAiWfExecutionStatus.Running,
        TotalNodes = 4,
        CompletedNodes = 2,
        CurrentNodeId = "approval",
        Logs =
        [
            new() { NodeId = "start", NodeLabel = "Inicio", Level = XFAiWfLogLevel.Success, Message = "Workflow iniciado", DurationMs = 120 },
            new() { NodeId = "ai", NodeLabel = "Analise IA", Level = XFAiWfLogLevel.Info, Message = "Classificacao fiscal concluida", DurationMs = 920 },
            new() { NodeId = "approval", NodeLabel = "Aprovacao", Level = XFAiWfLogLevel.Warning, Message = "Aguardando aprovacao humana" }
        ]
    };

    private static readonly XFAiWfExecutionState CompletedExecution = new()
    {
        WorkflowName = "Importacao de notas fiscais",
        Status = XFAiWfExecutionStatus.Completed,
        TotalNodes = 3,
        CompletedNodes = 3,
        Logs =
        [
            new() { NodeId = "parse", NodeLabel = "Parse XML", Level = XFAiWfLogLevel.Success, Message = "XML parseado com sucesso", DurationMs = 340 },
            new() { NodeId = "validate", NodeLabel = "Validacao", Level = XFAiWfLogLevel.Success, Message = "Validacao concluida", DurationMs = 180 },
            new() { NodeId = "store", NodeLabel = "Armazenamento", Level = XFAiWfLogLevel.Success, Message = "Dados gravados no banco", DurationMs = 90 }
        ]
    };

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiWorkflowExecutor Execution="MockExecution" Title="Conciliacao fiscal" />
    </XFStack>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(L.Text("Execucao visual", "Visual execution"), L.Text("Progresso passo a passo com barras e contadores.", "Step-by-step progress with bars and counters."), "play"),
        new(L.Text("Filtragem de logs", "Log filtering"), L.Text("Filtros por nivel: todos, erros, avisos.", "Filters by level: all, errors, warnings."), "filter"),
        new(L.Text("Zero JS", "Zero JS"), L.Text("Nenhum JavaScript interop. Puro C# + Tailwind.", "No JavaScript interop. Pure C# + Tailwind."), "bolt")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFAiWorkflowExecutor"),
        new("Namespace", "XForge.DesignSystem.Components.AI.Workflow"),
        new("Package", "XForge.DesignSystem.AI"),
        new("Category", "AI / Workflow"),
        new("Status", L.Text("Estavel", "Stable")),
        new("Accessibility", L.Text("role=region, aria-label, role=progressbar, aria-live=polite.", "role=region, aria-label, role=progressbar, aria-live=polite.")),
        new("Theme support", L.Text("Light, dark e data-theme via tokens.", "Light, dark and data-theme via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(L.Text("Executor de workflows", "Workflow executor"), L.Text("Motor visual de execucao com progresso e logs.", "Visual execution engine with progress and logs."), "play"),
        new(L.Text("6 estados de execucao", "6 execution states"), L.Text("Pending, Running, Completed, Failed, Cancelled, WaitingApproval.", "Pending, Running, Completed, Failed, Cancelled, WaitingApproval."), "circle-dot"),
        new(L.Text("Filtragem de logs", "Log filtering"), L.Text("Filtros por nivel com cores semanticas.", "Filters by level with semantic colors."), "filter")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(L.Text("Workflows IA", "AI workflows"), L.Text("Acompanhar execucao de workflows de IA em tempo real.", "Track AI workflow execution in real time."), "sparkles"),
        new(L.Text("Aprovacao humana", "Human approval"), L.Text("Suporte a estados de espera por aprovacao.", "Support for waiting approval states."), "user-check"),
        new(L.Text("Cancelamento", "Cancellation"), L.Text("Botao de parar durante execucao ativa.", "Stop button during active execution."), "stop")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(L.Text("Antes", "Before"), L.Text("Execucoes de IA sem visibilidade do progresso.", "AI executions without progress visibility."), "xmark"),
        new(L.Text("Depois", "After"), L.Text("Executor com progresso, logs e status em tempo real.", "Executor with progress, logs and real-time status."), "check"),
        new(L.Text("Acessibilidade", "Accessibility"), L.Text("role=progressbar, aria-live=polite, aria-label.", "role=progressbar, aria-live=polite, aria-label."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(L.Text("Workflows longos", "Long workflows"), L.Text("Workflows com multiplos nos e etapas.", "Workflows with multiple nodes and steps."), "clock"),
        new(L.Text("Aprovacoes", "Approvals"), L.Text("Workflows que exigem intervencao humana.", "Workflows requiring human intervention."), "user-check")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(L.Text("Tarefas simples", "Simple tasks"), L.Text("Para tarefas unicas, use notificacoes.", "For single tasks, use notifications."), "bell"),
        new(L.Text("Processamento offline", "Offline processing"), L.Text("Para processamento sem UI, use XFAiBatchProcessor.", "For processing without UI, use XFAiBatchProcessor."), "server")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new(L.Text("Header", "Header"), L.Text("Barra com titulo, status badge e botoes de acao.", "Bar with title, status badge and action buttons."), "bars"),
        new(L.Text("Progress bar", "Progress bar"), L.Text("Barra de progresso com percentual e contadores.", "Progress bar with percentage and counters."), "arrows-left-right"),
        new(L.Text("Log panel", "Log panel"), L.Text("Painel de logs com filtros por nivel de severidade.", "Log panel with filters by severity level."), "file-lines"),
        new(L.Text("Empty state", "Empty state"), L.Text("Estado vazio com mensagem e icone.", "Empty state with message and icon."), "inbox")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(L.Text("Visibilidade total", "Full visibility"), L.Text("Progresso, logs e status sempre visive.", "Progress, logs and status always visible."), "eye"),
        new(L.Text("Controle do usuario", "User control"), L.Text("Iniciar, parar e filtrar com facilidade.", "Start, stop and filter with ease."), "hand-pointer"),
        new(L.Text("Cores semanticas", "Semantic colors"), L.Text("Success=verde, Error=vermelho, Warning=amarelo.", "Success=green, Error=red, Warning=yellow."), "palette")
    ];

    // === EXAMPLES ===
    private RenderFragment ExRunning() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiWorkflowExecutor Execution="MockExecution" Title="Conciliacao fiscal" />
    </XFStack>;

    private RenderFragment ExEmpty() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiWorkflowExecutor Title="Novo workflow" />
    </XFStack>;

    private RenderFragment ExCompleted() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiWorkflowExecutor Execution="CompletedExecution" Title="Importacao de notas fiscais" ShowHeader="true" />
    </XFStack>;

    private const string Code1 = @"<XFAiWorkflowExecutor Execution=""@_execution"" Title=""Conciliacao fiscal"" />";
    private const string Code2 = @"<XFAiWorkflowExecutor Title=""Novo workflow"" />";
    private const string Code3 = @"<XFAiWorkflowExecutor Execution=""@_execution"" Title=""Importacao de notas fiscais"" ShowHeader=""true"" />";

    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("Execution", "XFAiWfExecutionState?", "null", L.Text("Estado completo de execucao do workflow.", "Complete workflow execution state.")),
        new("Title", "string", "\"Executor de Workflow\"", L.Text("Titulo do componente.", "Component title.")),
        new("AriaLabel", "string", "\"Executor de workflow\"", L.Text("Rotulo ARIA para acessibilidade.", "ARIA label for accessibility.")),
        new("ShowHeader", "bool", "true", L.Text("Exibe a barra de cabecalho.", "Shows the header bar.")),
        new("EmptyText", "string", "\"Configure um workflow...\"", L.Text("Texto do estado vazio.", "Empty state text.")),
        new("EmptyContent", "RenderFragment?", "null", L.Text("Conteudo customizado para estado vazio.", "Custom empty state content."))
    ];

    private IReadOnlyList<NameValueRow> EventRows => [
        new("OnStart", L.Text("Disparado quando o usuario solicita iniciar a execucao.", "Fired when user requests execution start.")),
        new("OnCancel", L.Text("Disparado quando o usuario solicita cancelar a execucao.", "Fired when user requests execution cancel."))
    ];

    // === ACCESSIBILITY ===
    private IReadOnlyList<DocTile> AccessibilityItems => [
        new(L.Text("role=region", "role=region"), L.Text("Componente usa role=region para leitores de tela.", "Component uses role=region for screen readers."), "universal-access"),
        new(L.Text("role=progressbar", "role=progressbar"), L.Text("Barra de progresso com aria-valuenow e aria-valuemax.", "Progress bar with aria-valuenow and aria-valuemax."), "arrows-left-right"),
        new(L.Text("aria-live=polite", "aria-live=polite"), L.Text("Log de execucao anuncia mudancas para leitores.", "Execution log announces changes for readers."), "volume-high"),
        new(L.Text("Botoes com aria-label", "Buttons with aria-label"), L.Text("Executar e Cancelar com labels descritivos.", "Start and Cancel with descriptive labels."), "keyboard")
    ];

    private IReadOnlyList<NameValueRow> KeyboardRows => [
        new("Tab", L.Text("Navega entre botoes Executar/Parar e filtros de log.", "Navigates between Start/Stop buttons and log filters.")),
        new("Enter", L.Text("Ativa o botao focado.", "Activates the focused button.")),
        new("Space", L.Text("Ativa o botao focado.", "Activates the focused button."))
    ];

    // === RESPONSIVENESS ===
    private IReadOnlyList<DocTile> ResponsivenessItems => [
        new(L.Text("Largura total", "Full width"), L.Text("Executor ocupa 100% do container.", "Executor occupies 100% of container."), "maximize"),
        new(L.Text("Grid responsivo", "Responsive grid"), L.Text("Contadores de 2 colunas em mobile, 4 em desktop.", "Counters in 2 columns on mobile, 4 on desktop."), "mobile-screen")
    ];

    // === PERFORMANCE ===
    private IReadOnlyList<DocTile> PerformanceItems => [
        new(L.Text("Zero JS", "Zero JS"), L.Text("Nenhum JavaScript interop.", "No JavaScript interop."), "bolt"),
        new(L.Text("Render leve", "Light render"), L.Text("Atualizacoes parciais via StateHasChanged.", "Partial updates via StateHasChanged."), "feather")
    ];

    // === SCENARIOS ===
    private IReadOnlyList<DocTile> ScenarioItems => [
        new(L.Text("Conciliacao fiscal", "Tax reconciliation"), L.Text("Workflow multi-etapa com aprovacao humana.", "Multi-step workflow with human approval."), "scale-balanced"),
        new(L.Text("Importacao de XML", "XML import"), L.Text("Importacao de notas fiscais com validacao.", "Invoice import with validation."), "file-import"),
        new(L.Text("Treinamento de IA", "AI training"), L.Text("Treinamento de modelos com progresso granular.", "Model training with granular progress."), "brain")
    ];

    // === COMPOSITION ===
    private IReadOnlyList<DocTile> CompositionItems => [
        new(L.Text("Executor + XFCard", "Executor + XFCard"), L.Text("Executor dentro de um card para contexto.", "Executor inside a card for context."), "square"),
        new(L.Text("Executor + TOC", "Executor + TOC"), L.Text("Executor com navegacao por secoes.", "Executor with section navigation."), "list"),
        new(L.Text("Executor + Alert", "Executor + Alert"), L.Text("Alerta de erro acima do executor em caso de falha.", "Error alert above executor on failure."), "triangle-exclamation")
    ];

    // === BEST PRACTICES ===
    private IReadOnlyList<DocTile> BestPracticeItems => [
        new(L.Text("Sempre mostrar progresso", "Always show progress"), L.Text("Barra de progresso ajuda o usuario a entender o andamento.", "Progress bar helps user understand advancement."), "arrows-left-right"),
        new(L.Text("Filtrar logs por nivel", "Filter logs by level"), L.Text("Fornecer filtros para erros e avisos rapidamente.", "Provide filters for errors and warnings quickly."), "filter"),
        new(L.Text("Confirmar cancelamento", "Confirm cancellation"), L.Text("Exigir confirmacao antes de cancelar workflows.", "Require confirmation before cancelling workflows."), "circle-check"),
        new(L.Text("Mostrar tempo decorrido", "Show elapsed time"), L.Text("Tempo ajuda o usuario a estimar duracao.", "Time helps user estimate duration."), "clock")
    ];

    // === ANTI-PATTERNS ===
    private IReadOnlyList<DocTile> AntiPatternItems => [
        new(L.Text("Sem logs", "No logs"), L.Text("Executor sem logs e dificil de depurar.", "Executor without logs is hard to debug."), "xmark"),
        new(L.Text("Cancelamento sem aviso", "Cancel without warning"), L.Text("Cancelar sem avisar pode perder dados.", "Cancelling without warning can lose data."), "triangle-exclamation"),
        new(L.Text("Muitos nos simultaneos", "Too many simultaneous nodes"), L.Text("Evite mais de 20 nos visiveis ao mesmo tempo.", "Avoid more than 20 nodes visible at once."), "ban")
    ];

    // === TOKENS ===
    private IReadOnlyList<NameValueRow> TokenRows => [
        new("progress-bar", L.Text("h-2 rounded-full transition-all duration-300.", "h-2 rounded-full transition-all duration-300.")),
        new("status-badge", L.Text("rounded-full px-2 py-0.5 text-[10px] font-bold.", "rounded-full px-2 py-0.5 text-[10px] font-bold.")),
        new("log-entry", L.Text("flex items-start gap-2 rounded px-2 py-1 text-xs.", "flex items-start gap-2 rounded px-2 py-1 text-xs."))
    ];

    // === THEMING ===
    private IReadOnlyList<DocTile> ThemeItems => [
        new("data-theme", L.Text("Tokens light/dark via CSS variables.", "Light/dark tokens via CSS variables."), "moon"),
        new("Cores semanticas", L.Text("Status com cores: verde=sucesso, vermelho=erro, amarelo=aviso.", "Status with colors: green=success, red=error, yellow=warning."), "palette")
    ];

    // === TESTING ===
    private IReadOnlyList<NameValueRow> TestingRows => [
        new("Unit", L.Text("Testes de render, props, estados, eventos, logs.", "Render, props, states, events, logs tests.")),
        new("Accessibility", L.Text("role=region, role=progressbar, aria-live, aria-label.", "role=region, role=progressbar, aria-live, aria-label."))
    ];

    // === LIMITATIONS ===
    private IReadOnlyList<NameValueRow> LimitationRows => [
        new("Progress", L.Text("Progresso e calculado automaticamente baseado em TotalNodes e CompletedNodes.", "Progress is automatically calculated based on TotalNodes and CompletedNodes.")),
        new("Logs", L.Text("Logs sao renderizados estaticamente. Para logs dinamicos, use SignalR.", "Logs are rendered statically. For dynamic logs, use SignalR."))
    ];

    // === RELATED ===
    private IReadOnlyList<DocTile> RelatedComponentItems => [
        new("XFAiScheduler", L.Text("Agendamento de workflows.", "Workflow scheduling."), "clock"),
        new("XFAiAutomationRule", L.Text("Regras de automacao para workflows.", "Automation rules for workflows."), "scale-balanced"),
        new("XFAiBatchProcessor", L.Text("Processamento em lote.", "Batch processing."), "layer-group")
    ];

    // === FAQ ===
    private IReadOnlyList<NameValueRow> FaqRows => [
        new(L.Text("Como atualizar o progresso?", "How to update progress?"), L.Text("Atualize o objeto XFAiWfExecutionState. O componente re-renderiza automaticamente.", "Update the XFAiWfExecutionState object. The component re-renders automatically.")),
        new(L.Text("Posso personalizar o estado vazio?", "Can I customize the empty state?"), L.Text("Sim, use EmptyContent para customizar ou EmptyText para alterar o texto.", "Yes, use EmptyContent to customize or EmptyText to change the text.")),
        new(L.Text("Funciona sem JS?", "Works without JS?"), L.Text("Sim. Nenhum JavaScript interop necessario.", "Yes. No JavaScript interop required."))
    ];

    // === CHANGELOG ===
    private IReadOnlyList<NameValueRow> ChangelogRows => [
        new("2026-06-12", L.Text("Pagina refeita no padrao AppShellDocs com 26 secoes.", "Page rewritten in AppShellDocs standard with 26 sections."))
    ];

    // === HELPERS ===
    private RenderFragment Section(string title, RenderFragment content) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
        <Header><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography></Header>
        <ChildContent>@content</ChildContent>
    </XFCard>;

    private RenderFragment Example(string title, string description, RenderFragment preview, string codeText) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.None" AreaRestricted="false">
        <Header><div class="px-6 pt-6 pb-2">
            <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@description</XFTypography>
        </div></Header>
        <ChildContent><div class="flex flex-col">
            <div class="border-t border-border-light p-6">@preview</div>
            <div class="border-t border-border-light bg-surface-50 p-6">
                <XFCode Text="@codeText" Language="razor" Title="@CopyableCodeTitle" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" />
            </div>
        </div></ChildContent>
    </XFCard>;

    private RenderFragment Tile(DocTile item) => @<XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent>
        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <div class="flex items-center gap-4">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-primary/10 bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                <div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div>
            </div>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
        </XFStack>
    </ChildContent></XFCard>;

    private RenderFragment TileGrid(IReadOnlyList<DocTile> items, int columns) => @<XFGrid Cols="1" Md="@Math.Min(columns, 2)" Lg="@columns" Gap="4">@foreach (var item in items) { @Tile(item) }</XFGrid>;

    private RenderFragment WarningGrid(IReadOnlyList<DocTile> items) => @<XFGrid Cols="1" Md="2" Gap="4">@foreach (var item in items) {
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <div class="flex items-center gap-4">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-danger/10 bg-danger/10 text-danger" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                <div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div>
            </div>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
        </XFStack></ChildContent></XFCard>
    }</XFGrid>;

    private RenderFragment NameValueTable(IReadOnlyList<NameValueRow> rows, string nameHeader, string valueHeader) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader><XFTableRow><XFTableCell Header="true">@nameHeader</XFTableCell><XFTableCell Header="true">@valueHeader</XFTableCell></XFTableRow></XFTableHeader>
        <XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Value</XFTableCell></XFTableRow> }</XFTableBody>
    </XFTable>;

    private RenderFragment ApiTable(IReadOnlyList<ApiRow> rows) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader><XFTableRow><XFTableCell Header="true">@L.Text("Parametro", "Parameter")</XFTableCell><XFTableCell Header="true">Type</XFTableCell><XFTableCell Header="true">Default</XFTableCell><XFTableCell Header="true">@L.Text("Descricao", "Description")</XFTableCell></XFTableRow></XFTableHeader>
        <XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Type</XFTableCell><XFTableCell><XFCode Text="@row.DefaultValue" /></XFTableCell><XFTableCell>@row.Description</XFTableCell></XFTableRow> }</XFTableBody>
    </XFTable>;

    // === RECORDS ===
    private sealed record DocTile(string Title, string Description, string Icon);
    private sealed record NameValueRow(string Name, string Value);
    private sealed record ApiRow(string Name, string Type, string DefaultValue, string Description);
}