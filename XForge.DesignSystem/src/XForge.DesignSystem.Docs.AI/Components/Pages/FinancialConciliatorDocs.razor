    // === COMPOSITION ===
    private IReadOnlyList<DocTile> CompositionItems => [
        new(T("Provider + Conciliator", "Provider + Reconciler"), T("Conecte com Ollama, OpenAI ou Gemini para IA real.", "Connect with Ollama, OpenAI or Gemini for real AI."), "plug"),
        new(T("Conciliator + ResultPreview", "Reconciler + ResultPreview"), T("Customize a exibicao do resultado de conciliacao.", "Customize the reconciliation result display."), "puzzle"),
        new(T("Conciliator + EmptyContent", "Reconciler + EmptyContent"), T("Defina estado vazio personalizado.", "Define custom empty state."), "inbox")
