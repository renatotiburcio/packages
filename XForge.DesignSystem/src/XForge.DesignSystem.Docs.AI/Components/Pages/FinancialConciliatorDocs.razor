        new(T("Auditoria fiscal", "Tax audit"), T("Deteccao de divergencias em notas fiscais e pagamentos.", "Detection of discrepancies in invoices and payments."), "file-invoice"),
        new(T("Controle financeiro", "Financial control"), T("Monitoramento de fluxo de caixa com indicadores de fraude.", "Cash flow monitoring with fraud indicators."), "chart-line-up")
