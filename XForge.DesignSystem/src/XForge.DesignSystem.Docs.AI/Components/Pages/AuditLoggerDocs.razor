@page "/ai/audit-logger"
@using XForge.DesignSystem.Core.Primitives
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.AiItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFAuditLogger" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Filtravel e exportavel", "Filterable and exportable")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Registro de eventos, decisoes e evidencias para governanca de IA.",
                               "Event, decision and evidence recording for AI governance.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("Log de auditoria operacional com filtros por severidade, acao e busca textual, indicadores visuais e exportacao.",
                               "Operational audit log with severity, action and text search filters, visual indicators and export.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico.", "Renders as static HTML.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 3 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Basico", "1. Basic"), T("Logger com entradas variadas de severidade.", "Logger with varied severity entries."), ExBasic(), Code1)
            @Example(T("2. Filtrado", "2. Filtered"), T("Logger com filtros de severidade e acao.", "Logger with severity and action filters."), ExFiltered(), Code2)
            @Example(T("3. Sem filtros", "3. Without filters"), T("Logger embutido sem controles de filtro.", "Embedded logger without filter controls."), ExEmbedded(), Code3)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string ProductLabelText => T("AI Commercial", "AI Commercial");
    private string PageTitleText => T("XFAuditLogger", "XFAuditLogger");
    private string PageStatusText => T("Documentacao completa", "Complete docs");
    private string T(string pt, string en) => LanguageService.Text(pt, en);
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFAuditLogger Entries="SampleEntries"
                                                            Title="Auditoria"
                                                            ShowFilters="true"
                                                            ShowExportButton="false"
                                                            MaxVisible="3" />;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("Severidade", "Severity"), T("Info, Warning, Error e Critical com cores semanticas.", "Info, Warning, Error and Critical with semantic colors."), "signal"),
        new(T("Filtros", "Filters"), T("Por severidade, acao e busca textual.", "By severity, action and text search."), "filter"),
        new(T("Exportacao", "Export"), T("Botao para exportar registros filtrados.", "Button to export filtered records."), "download")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFAuditLogger"),
        new("Namespace", "XForge.DesignSystem.Components.AI.Enterprise"),
        new("Package", "XForge.DesignSystem.AI"),
        new("Category", "AI / Enterprise"),
        new("Status", T("Estavel", "Stable")),
        new("Accessibility", "role=region, role=log, aria-live=polite, aria-label."),
        new("Theme support", T("Light, dark e data-theme via tokens.", "Light, dark and data-theme via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("Log de auditoria", "Audit log"), T("Registro cronologico de eventos com severidade.", "Chronological event record with severity."), "scroll"),
        new(T("Filtros", "Filters"), T("Filtro por severidade, acao e busca textual.", "Filter by severity, action and text search."), "filter"),
        new(T("Exportacao", "Export"), T("Exportar registros filtrados para auditoria externa.", "Export filtered records for external audit."), "download")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Governanca de IA", "AI governance"), T("Registrar acoes automatizas e decisoes de IA.", "Record automated actions and AI decisions."), "robot"),
        new(T("Seguranca", "Security"), T("Monitorar acessos, logins e operacoes sensibles.", "Monitor access, logins and sensitive operations."), "shield-check"),
        new(T("Conformidade", "Compliance"), T("Atender requisitos de auditoria de sistemas.", "Meet system audit requirements."), "clipboard-check")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Logs dispersos sem padronizacao ou filtros.", "Scattered logs without standardization or filters."), "xmark"),
        new(T("Depois", "After"), T("Logger centralizado com severidade, filtros e exportacao.", "Centralized logger with severity, filters and export."), "check"),
        new(T("Acessibilidade", "Accessibility"), T("role=log com aria-live para atualizacoes em tempo real.", "role=log with aria-live for real-time updates."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Monitoramento", "Monitoring"), T("Acompanhar acoes de usuarios e IA em tempo real.", "Track user and AI actions in real time."), "eye"),
        new(T("Auditoria", "Audit"), T("Exportar logs para revisao de conformidade.", "Export logs for compliance review."), "scroll")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Auditoria imutavel", "Immutable audit"), T("Use XFAiAuditTimeline para trilha com hash.", "Use XFAiAuditTimeline for trail with hash."), "lock"),
        new(T("Dashboard de BI", "BI dashboard"), T("Use XFAiDashboardInsight para metricas agregadas.", "Use XFAiDashboardInsight for aggregated metrics."), "chart-bar")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new("Header", T("Titulo, contagem e botao de exportacao.", "Title, count and export button."), "bars"),
        new("Filters", T("Dropdowns de severidade e acao, campo de busca.", "Severity and action dropdowns, search field."), "filter"),
        new("Entry", T("Linha com icone, acao, recurso, detalhes e timestamp.", "Row with icon, action, resource, details and timestamp."), "list"),
        new("Empty State", T("Mensagem amigavel quando nao ha registros.", "Friendly message when no records."), "inbox"),
        new("Load More", T("Botao para carregar registros adicionais.", "Button to load additional records."), "plus")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(T("Visibilidade", "Visibility"), T("Todos os eventos sao visiveis e filtraveis.", "All events are visible and filterable."), "eye"),
        new(T("Severidade visual", "Visual severity"), T("Cores e icones comunicam nivel de criticidade.", "Colors and icons communicate criticality level."), "signal"),
        new(T("Performance", "Performance"), T("MaxVisible evita renderizacao excessiva.", "MaxVisible prevents excessive rendering."), "gauge")
    ];

    // === EXAMPLES ===
    private RenderFragment ExBasic() => @<XFAuditLogger Entries="SampleEntries"
                                                       Title="Auditoria"
                                                       ShowFilters="true"
                                                       ShowExportButton="false"
                                                       MaxVisible="3" />;

    private RenderFragment ExFiltered() => @<XFAuditLogger Entries="SampleEntries"
                                                           Title="Auditoria filtrada"
                                                           ShowFilters="true"
                                                           ShowExportButton="true"
                                                           MaxVisible="3" />;

    private RenderFragment ExEmbedded() => @<XFAuditLogger Entries="SampleEntries"
                                                           Title="Auditoria embutida"
                                                           ShowFilters="false"
                                                           ShowExportButton="false"
                                                           MaxVisible="3" />;

    private const string Code1 = @"<XFAuditLogger Entries=""@_entries""
    Title=""Auditoria""
    ShowFilters=""true""
    ShowExportButton=""false""
    MaxVisible=""3"" />";

    private const string Code2 = @"<XFAuditLogger Entries=""@_entries""
    Title=""Auditoria filtrada""
    ShowFilters=""true""
    ShowExportButton=""true""
    MaxVisible=""3"" />";

    private const string Code3 = @"<XFAuditLogger Entries=""@_entries""
    Title=""Auditoria embutida""
    ShowFilters=""false""
    ShowExportButton=""false""
    MaxVisible=""3"" />";

    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("Entries", "IReadOnlyList<XFAuditEntry>", "[]", T("Lista de entradas de auditoria.", "List of audit entries.")),
        new("Title", "string", "\"Auditoria\"", T("Titulo do componente.", "Component title.")),
        new("ShowFilters", "bool", "true", T("Exibe controles de filtro.", "Displays filter controls.")),
        new("ShowExportButton", "bool", "true", T("Exibe botao de exportacao.", "Displays export button.")),
        new("MaxVisible", "int", "50", T("Maximo de entradas visiveis antes de Load More.", "Maximum visible entries before Load More.")),
        new("ExportLabel", "string", "\"Exportar\"", T("Label do botao de exportacao.", "Export button label.")),
        new("AllSeveritiesLabel", "string", "\"Todas as severidades\"", T("Label da opcao Todas no filtro de severidade.", "Label of All option in severity filter.")),
        new("AllActionsLabel", "string", "\"Todas as acoes\"", T("Label da opcao Todas no filtro de acao.", "Label of All option in action filter.")),
        new("SearchPlaceholder", "string", "\"Pesquisar...\"", T("Placeholder do campo de busca.", "Search input placeholder.")),
        new("EmptyLabel", "string", "\"Nenhum registro de auditoria\"", T("Label do estado vazio.", "Empty state label.")),
        new("LoadMoreLabel", "string", "\"Carregar mais\"", T("Label do botao Load More.", "Load More button label.")),
        new("RemainingLabel", "string", "\"restantes\"", T("Label de restantes no Load More.", "Remaining label in Load More."))
    ];

    private IReadOnlyList<NameValueRow> EventRows => [
        new("OnExport", T("Disparado com a lista filtrada de entradas para exportacao.", "Fired with filtered entry list for export.")),
        new("OnFilterChange", T("Disparado quando filtros mudam. Retorna XFAuditFilter.", "Fired when filters change. Returns XFAuditFilter.")),
        new("OnLoadMore", T("Disparado ao clicar em Carregar mais.", "Fired when Load More is clicked."))
    ];

    // === ACCESSIBILITY ===
    private IReadOnlyList<DocTile> AccessibilityItems => [
        new("role=region", T("Container principal usa role=region.", "Main container uses role=region."), "universal-access"),
        new("role=log", T("Lista de entradas usa role=log com aria-live=polite.", "Entry list uses role=log with aria-live=polite."), "scroll"),
        new("aria-label", T("Filtros e botoes tem aria-label descritivo.", "Filters and buttons have descriptive aria-label."), "tag"),
        new("aria-hidden", T("Icones decorativos marcadoss com aria-hidden.", "Decorative icons marked with aria-hidden."), "eye-slash")
    ];

    private IReadOnlyList<NameValueRow> KeyboardRows => [];

    // === RESPONSIVENESS ===
    private IReadOnlyList<DocTile> ResponsivenessItems => [
        new(T("Largura total", "Full width"), T("Logger ocupa 100% do container.", "Logger occupies 100% of container."), "maximize"),
        new(T("Filtros flex", "Flex filters"), T("Filtros se empilham em mobile.", "Filters stack on mobile."), "mobile-screen")
    ];

    // === PERFORMANCE ===
    private IReadOnlyList<DocTile> PerformanceItems => [
        new(T("MaxVisible", "MaxVisible"), T("Limita entradas renderizadas por vez.", "Limits entries rendered per time."), "gauge"),
        new(T("Overflow scroll", "Overflow scroll"), T("Lista com max-h e overflow-y-auto.", "List with max-h and overflow-y-auto."), "arrows-up-down"),
        new(T("Zero JS", "Zero JS"), T("Nenhum JavaScript interop.", "No JavaScript interop."), "bolt")
    ];

    // === SCENARIOS ===
    private IReadOnlyList<DocTile> ScenarioItems => [
        new(T("Log de acessos", "Access log"), T("Registro de logins, logouts e tentativas.", "Record of logins, logouts and attempts."), "door-open"),
        new(T("Operacoes CRUD", "CRUD operations"), T("Registro de criar, ler, atualizar e excluir.", "Record of create, read, update and delete."), "database"),
        new(T("Exportacao de auditoria", "Audit export"), T("Exportar CSV para revisao externa.", "Export CSV for external review."), "file-export")
    ];

    // === COMPOSITION ===
    private IReadOnlyList<DocTile> CompositionItems => [
        new("Logger + Card", T("Logger dentro de XFCard para contexto.", "Logger inside XFCard for context."), "square"),
        new("Logger + Filters", T("Filtros de severidade e acao para refinar.", "Severity and action filters to refine."), "filter"),
        new("Logger + Timeline", T("Combinar com AuditTimeline para trilha completa.", "Combine with AuditTimeline for complete trail."), "clock-rotate-left")
    ];

    // === BEST PRACTICES ===
    private IReadOnlyList<DocTile> BestPracticeItems => [
        new(T("Severidade apropriada", "Appropriate severity"), T("Usar Error/Critical apenas para falhas reais.", "Use Error/Critical only for real failures."), "signal"),
        new(T("Detalhes descritivos", "Descriptive details"), T("Incluir contexto suficiente para auditoria.", "Include sufficient context for audit."), "align-left"),
        new(T("Load More", "Load More"), T("Limitar entradas visiveis para performance.", "Limit visible entries for performance."), "plus"),
        new(T("Exportacao", "Export"), T("Oferecer exportacao para conformidade.", "Offer export for compliance."), "download")
    ];

    // === ANTI-PATTERNS ===
    private IReadOnlyList<DocTile> AntiPatternItems => [
        new(T("Sem filtro", "No filter"), T("Listas longas sem filtro sao ilegiveis.", "Long lists without filter are unreadable."), "xmark"),
        new(T("Verbose", "Verbose"), T("Detalhes excessivos tornam logs dificeis de ler.", "Excessive details make logs hard to read."), "ban"),
        new(T("Sem MaxVisible", "No MaxVisible"), T("Renderizar 1000+ entradas causa lentidao.", "Rendering 1000+ entries causes slowness."), "triangle-exclamation")
    ];

    // === TOKENS ===
    private IReadOnlyList<NameValueRow> TokenRows => [
        new("entry", T("flex items-start gap-2 p-2 rounded hover:bg-gray-50.", "flex items-start gap-2 p-2 rounded hover:bg-gray-50.")),
        new("header", T("flex items-center justify-between mb-3.", "flex items-center justify-between mb-3.")),
        new("filter", T("px-2 py-1 text-xs rounded border.", "px-2 py-1 text-xs rounded border."))
    ];

    // === THEMING ===
    private IReadOnlyList<DocTile> ThemeItems => [
        new("data-theme", T("Tokens light/dark via CSS variables.", "Light/dark tokens via CSS variables."), "moon"),
        new("data-brand", T("Bordas de severidade seguem marca ativa.", "Severity borders follow active brand."), "swatchbook")
    ];

    // === TESTING ===
    private IReadOnlyList<NameValueRow> TestingRows => [
        new("Unit", T("Testes de render, props, filtros, vazio, MaxVisible.", "Render, props, filters, empty, MaxVisible tests.")),
        new("Accessibility", T("role=region, role=log, aria-live, aria-label.", "role=region, role=log, aria-live, aria-label."))
    ];

    // === LIMITATIONS ===
    private IReadOnlyList<NameValueRow> LimitationRows => [
        new("Filtros client-side", T("Filtros funcionam apenas no lado do cliente.", "Filters work only on the client side.")),
        new("MaxVisible", T("Load More e manual; nao ha scroll infinito.", "Load More is manual; no infinite scroll."))
    ];

    // === RELATED ===
    private IReadOnlyList<DocTile> RelatedComponentItems => [
        new("XFAiAuditTimeline", T("Timeline imutavel com hash.", "Immutable timeline with hash."), "clock-rotate-left"),
        new("XFRbacComponent", T("Controle de acesso baseado em papéis.", "Role-based access control."), "shield"),
        new("XFAuthProvider", T("Provedor de autenticacao.", "Authentication provider."), "door-open")
    ];

    // === FAQ ===
    private IReadOnlyList<NameValueRow> FaqRows => [
        new(T("AuditLogger vs AuditTimeline?", "AuditLogger vs AuditTimeline?"), T("Logger = operacional, filtravel. Timeline = imutavel, com hash.", "Logger = operational, filterable. Timeline = immutable, with hash.")),
        new(T("Como exportar?", "How to export?"), T("Use OnExport para obter a lista filtrada e gerar CSV.", "Use OnExport to get filtered list and generate CSV.")),
        new(T("Funciona com SSR?", "Works with SSR?"), T("Sim. Renderiza como HTML estatico.", "Yes. Renders as static HTML."))
    ];

    // === CHANGELOG ===
    private IReadOnlyList<NameValueRow> ChangelogRows => [
        new("2026-06-10", T("Pagina refeita no padrao enterprise com 3 exemplos renderizados.", "Page rewritten in enterprise standard with 3 rendered examples.")),
        new("2026-06-12", T("Refatorada para padrao AppShellDocs com 26 secoes.", "Refactored to AppShellDocs pattern with 26 sections."))
    ];

    // === SAMPLE DATA ===
    private static readonly IReadOnlyList<XFAuditEntry> SampleEntries =
    [
        new()
        {
            Action = XFAuditAction.Login,
            Severity = XFAuditSeverity.Info,
