    private const string HealthCheckCode = "public class AiHealthBackgroundService : BackgroundService\n{\n    private readonly IEnumerable&lt;IAiProvider&gt; _providers;\n\n    public AiHealthBackgroundService(IEnumerable&lt;IAiProvider&gt; providers)\n        =&gt; _providers = providers;\n\n    protected override async Task ExecuteAsync(CancellationToken ct)\n    {\n        while (!ct.IsCancellationRequested)\n        {\n            foreach (var provider in _providers)\n            {\n                if (provider is AiProviderBase baseProvider)\n                {\n                    var health = await baseProvider.CheckHealthAsync(ct);\n                    if (!health.IsHealthy)\n                        Log.Warning(\"Provider {Provider} unhealthy\", provider.ProviderId);\n                }\n            }\n            await Task.Delay(TimeSpan.FromMinutes(5), ct);\n        }\n    }\n}";

