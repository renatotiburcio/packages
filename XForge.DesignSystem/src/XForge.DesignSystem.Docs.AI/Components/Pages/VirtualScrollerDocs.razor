@page "/ai/virtual-scroller"
@inject XForgeDocsLanguageService L

<XForgeDocsShell ProductLabel="AI Commercial"
                 Title="XFAiVirtualScroller"
                 Status="@L.Text("Estavel", "Stable")"
                 Items="XForgeDocsCatalog.AiItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFAiVirtualScroller" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Virtualizacao", "Virtualization")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Zero JS", "Zero JS")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Virtualizacao de listas de alto desempenho com renderizacao parcial e scroll offset.",
                               "High-performance list virtualization with partial rendering and scroll offset.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("Renderiza apenas itens visiveis usando posicao absoluta e controle de scroll. Suporta milhoes de linhas com fixed height, overscan e callbacks de range. Puro Blazor, sem JavaScript interop.",
                               "Renders only visible items using absolute positioning and scroll control. Supports millions of rows with fixed height, overscan and range callbacks. Pure Blazor, no JavaScript interop.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico.", "Renders as static HTML.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Lista basica", "1. Basic List"), T("Lista virtual com 10.000 itens e altura fixa.", "Virtual list with 10,000 items and fixed height."), ExBasicList(), Code1)
            @Example(T("2. Customizado com templates", "2. Custom with Templates"), T("Item template customizado com icones e metadados.", "Custom item template with icons and metadata."), ExCustomTemplate(), Code2)
            @Example(T("3. Sem header e com range callback", "3. Without Header and with Range Callback"), T("Lista compacta sem header bar e callback de range.", "Compact list without header bar and range callback."), ExCompactList(), Code3)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>

<XForgeDocsPageStandard ComponentName="VirtualScrollerDocs" />

@code {
    private string T(string pt, string en) => L.Text(pt, en);

    // === HERO ===
    private RenderFragment HeroPreview() => @<div class="rounded-lg border border-border-light bg-surface-50 p-4">
        <div class="flex flex-col gap-2">
            <div class="text-sm font-semibold text-text-primary">Lista de exemplo (10.000 itens)</div>
            <div class="flex items-center gap-2 text-xs text-text-secondary">
                <span class="inline-flex h-6 w-6 items-center justify-center rounded bg-primary/10 text-primary">@((MarkupString)XFSvgIcons.MarkupWithSize("arrows-up-down", 12))</span>
                Virtualizacao ativa: renderizando apenas 5 itens visiveis
            </div>
            <div class="flex flex-col gap-1 rounded border border-border-light bg-bg-surface p-2 text-xs">
                <div class="rounded bg-primary/5 px-2 py-1">Item #00001</div>
                <div class="rounded bg-primary/5 px-2 py-1">Item #00002</div>
                <div class="rounded bg-primary/5 px-2 py-1">Item #00003</div>
                <div class="text-center text-xs text-text-secondary">... 9.997 itens restantes ...</div>
            </div>
        </div>
    </div>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("Milhoes de linhas", "Millions of rows"), T("Renderiza apenas itens visiveis no viewport.", "Renders only items visible in the viewport."), "arrows-up-down"),
        new(T("Zero JS", "Zero JS"), T("Nenhum JavaScript interop. Puro C# + Tailwind.", "No JavaScript interop. Pure C# + Tailwind."), "bolt"),
        new(T("Callback de range", "Range callback"), T("OnRangeChanged dispara quando o viewport muda.", "OnRangeChanged fires when viewport changes."), "bell")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFAiVirtualScroller<T>"),
        new("Namespace", "XForge.DesignSystem.Components.AI.Performance"),
        new("Package", "XForge.DesignSystem.AI"),
        new("Category", "AI / Performance"),
        new("Status", T("Estavel", "Stable")),
        new("Accessibility", T("role=list, aria-label, aria-setsize, aria-posinset.", "role=list, aria-label, aria-setsize, aria-posinset.")),
        new("Theme support", T("Light, dark e data-brand via tokens.", "Light, dark and data-brand via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("Virtualizacao", "Virtualization"), T("Renderiza apenas itens visiveis no DOM.", "Renders only visible items in the DOM."), "arrows-up-down"),
        new(T("Fixed height", "Fixed height"), T("Altura fixa por item para calculo preciso.", "Fixed height per item for precise calculation."), "ruler"),
        new(T("Scroll offset", "Scroll offset"), T("Controle de posicao de scroll e overscan.", "Scroll position control and overscan."), "bars")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Listas massivas", "Massive lists"), T("Milhoes de registros de ERP, logs ou auditoria.", "Millions of ERP, log or audit records."), "database"),
        new(T("Chat com historico", "Chat with history"), T("Historico conversacional longo com scroll.", "Long conversational history with scroll."), "comments"),
        new(T("Grids de dados", "Data grids"), T("Tabelas com milhas de linhas de dados.", "Tables with thousands of data rows."), "table")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Listas grandes causavam lentidao e travamento.", "Large lists caused slowness and freezing."), "xmark"),
        new(T("Depois", "After"), T("Scroll suave com apenas 20-50 itens no DOM.", "Smooth scroll with only 20-50 items in the DOM."), "check"),
        new(T("Acessibilidade", "Accessibility"), T("aria-setsize e aria-posinset para leitores de tela.", "aria-setsize and aria-posinset for screen readers."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Audit logs", "Audit logs"), T("Exibicao de logs de auditoria com milhoes de registros.", "Display of audit logs with millions of records."), "scroll"),
        new(T("Resultados de busca AI", "AI search results"), T("Lista virtual de resultados de busca densos.", "Virtual list of dense search results."), "magnifying-glass")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Listas pequenas", "Small lists"), T("Use XFList ou XFDataGrid para menos de 100 itens.", "Use XFList or XFDataGrid for fewer than 100 items."), "list"),
        new(T("Altura dinamica", "Dynamic height"), T("Este componente usa altura fixa por item.", "This component uses fixed height per item."), "ruler")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new(T("Container", "Container"), T("Wrapper com overflow hidden e border.", "Wrapper with overflow hidden and border."), "square"),
        new(T("Viewport", "Viewport"), T("Area visivel com altura definida (ContainerHeight).", "Visible area with defined height (ContainerHeight)."), "maximize"),
        new(T("Item", "Item"), T("Cada item renderizado com posicao absoluta.", "Each item rendered with absolute positioning."), "minus"),
        new(T("Header/Footer", "Header/Footer"), T("Barras superior e inferior opcionais.", "Optional top and bottom bars."), "bars")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(T("Performance primeiro", "Performance first"), T("Renderiza apenas o necessario.", "Renders only what is necessary."), "bolt"),
        new(T("Zero dependencias", "Zero dependencies"), T("Nenhum JavaScript ou biblioteca externa.", "No JavaScript or external library."), "shield"),
        new(T("Simplicidade", "Simplicity"), T("Uma responsabilidade: renderizar lista virtual.", "One responsibility: render virtual list."), "minimize")
    ];

    // === EXAMPLES ===
    private RenderFragment ExBasicList() => @<div class="rounded-lg border border-border-light bg-surface-50 p-4">
        <div class="flex flex-col gap-1 rounded border border-border-light bg-bg-surface p-2 text-xs">
            <div class="rounded bg-primary/5 px-2 py-1">Cliente #00001 - Silva LTDA</div>
            <div class="rounded bg-primary/5 px-2 py-1">Cliente #00002 - Souza ME</div>
            <div class="rounded bg-primary/5 px-2 py-1">Cliente #00003 - Santos SA</div>
            <div class="text-center text-xs text-text-secondary">... itens virtuais ...</div>
        </div>
    </div>;

    private RenderFragment ExCustomTemplate() => @<div class="rounded-lg border border-border-light bg-surface-50 p-4">
        <div class="flex flex-col gap-2 rounded border border-border-light bg-bg-surface p-2 text-xs">
            <div class="flex items-center gap-3 rounded bg-primary/5 px-3 py-2">
                <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize("file", 16))</span>
                <div class="min-w-0"><div class="text-sm font-medium text-text-primary truncate">Resultado #1</div><div class="text-xs text-text-secondary">Item #0</div></div>
            </div>
            <div class="flex items-center gap-3 rounded bg-primary/5 px-3 py-2">
                <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize("file", 16))</span>
                <div class="min-w-0"><div class="text-sm font-medium text-text-primary truncate">Resultado #2</div><div class="text-xs text-text-secondary">Item #1</div></div>
            </div>
        </div>
    </div>;

    private RenderFragment ExCompactList() => @<div class="rounded-lg border border-border-light bg-surface-50 p-4">
        <div class="flex flex-col gap-1 rounded border border-border-light bg-bg-surface p-2 text-xs">
            <div class="rounded bg-primary/5 px-2 py-1 text-xs">Item #001</div>
            <div class="rounded bg-primary/5 px-2 py-1 text-xs">Item #002</div>
            <div class="rounded bg-primary/5 px-2 py-1 text-xs">Item #003</div>
        </div>
    </div>;

    private const string Code1 = @"<XFAiVirtualScroller<string> Items=""@items""
                          ItemHeight=""40""
                          ContainerHeight=""240""
                          Title=""Lista de clientes"" />";

    private const string Code2 = @"<XFAiVirtualScroller<string> Items=""@items""
                          ItemHeight=""56""
                          ContainerHeight=""280""
                          Title=""Resultados de busca""
                          ShowFooter=""true"">
    <ItemTemplate>
        <div class=""flex items-center gap-3 px-4 py-2"">
            <span class=""inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary/10 text-primary"">
                @((MarkupString)XFSvgIcons.MarkupWithSize(""file"", 16))
            </span>
            <div class=""min-w-0"">
                <div class=""text-sm font-medium text-text-primary truncate"">@context.Data</div>
                <div class=""text-xs text-text-secondary"">Item #@context.Index</div>
            </div>
        </div>
    </ItemTemplate>
</XFAiVirtualScroller<string>>";

    private const string Code3 = @"<XFAiVirtualScroller<string> Items=""@items""
                          ItemHeight=""36""
                          ContainerHeight=""200""
                          ShowHeader=""false""
                          ShowFooter=""false""
                          Title=""Lista compacta"" />";

    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("Items", "IReadOnlyList<TItem>", "[]", T("Todos os itens do dataset.", "All items in the dataset.")),
        new("ItemHeight", "double", "40", T("Altura de cada item em pixels (fixed strategy).", "Height of each item in pixels (fixed strategy).")),
        new("OverscanCount", "int", "5", T("Numero extra de itens acima/abaixo do viewport.", "Number of extra items above/below viewport.")),
        new("ContainerHeight", "int", "400", T("Altura do container em pixels.", "Container height in pixels.")),
        new("Strategy", "XFAiVirtualRenderStrategy", "FixedHeight", T("FixedHeight ou DynamicHeight.", "FixedHeight or DynamicHeight.")),
        new("Title", "string", "''", T("Titulo do componente.", "Component title.")),
        new("AriaLabel", "string", "''", T("Label de acessibilidade.", "Accessibility label.")),
        new("ShowHeader", "bool", "true", T("Exibe barra de cabecalho.", "Shows header bar.")),
        new("ShowFooter", "bool", "true", T("Exibe barra de rodape.", "Shows footer bar.")),
        new("EmptyText", "string", "''", T("Texto quando nao ha itens.", "Text when no items.")),
        new("ItemTemplate", "RenderFragment<XFAiVirtualItem<T>>?", "null", T("Template customizado por item.", "Custom template per item.")),
        new("TotalItems", "int", "0", T("Total de itens (cenarios server-side).", "Total items (server-side scenarios)."))
    ];

    private IReadOnlyList<NameValueRow> EventRows => [
        new("OnRangeChanged", T("Dispara quando o range visivel muda. Recebe XFAiVirtualRange.", "Fires when visible range changes. Receives XFAiVirtualRange."))
    ];

    // === ACCESSIBILITY ===
    private IReadOnlyList<DocTile> AccessibilityItems => [
        new(T("role=list", "role=list"), T("Container usa role=list para leitores de tela.", "Container uses role=list for screen readers."), "universal-access"),
        new(T("aria-label", "aria-label"), T("Label descritivo da lista virtual.", "Descriptive virtual list label."), "tag"),
        new(T("aria-setsize", "aria-setsize"), T("Indica total de itens no dataset.", "Indicates total items in dataset."), "hashtag"),
        new(T("aria-posinset", "aria-posinset"), T("Indica posicao de cada item no dataset.", "Indicates position of each item in dataset."), "list-ol")
    ];

    private IReadOnlyList<NameValueRow> KeyboardRows => [
        new("ArrowDown", T("Move foco para item anterior.", "Moves focus to previous item.")),
        new("ArrowUp", T("Move foco para proximo item.", "Moves focus to next item.")),
        new("PageDown", T("Avanca uma pagina de itens.", "Advances one page of items.")),
        new("PageUp", T("Volta uma pagina de itens.", "Goes back one page of items.")),
        new("Home", T("Vai para o primeiro item.", "Goes to first item.")),
        new("End", T("Vai para o ultimo item.", "Goes to last item."))
    ];

    // === RESPONSIVENESS ===
    private IReadOnlyList<DocTile> ResponsivenessItems => [
        new(T("Largura total", "Full width"), T("Container ocupa 100% do wrapper.", "Container occupies 100% of wrapper."), "maximize"),
        new(T("Altura responsiva", "Responsive height"), T("ContainerHeight ajusta conforme viewport.", "ContainerHeight adjusts based on viewport."), "mobile-screen")
    ];

    // === PERFORMANCE ===
    private IReadOnlyList<DocTile> PerformanceItems => [
        new(T("Render parcial", "Partial render"), T("Apenas 20-50 itens no DOM simultaneamente.", "Only 20-50 items in the DOM at a time."), "bolt"),
        new(T("Zero JS", "Zero JS"), T("Nenhum JavaScript interop.", "No JavaScript interop."), "feather"),
        new(T("Posicao absoluta", "Absolute positioning"), T("Itens posicionados via top offset.", "Items positioned via top offset."), "arrows-up-down")
    ];

    // === SCENARIOS ===
    private IReadOnlyList<DocTile> ScenarioItems => [
        new(T("Audit logs ERP", "ERP audit logs"), T("Exibicao de milhoes de registros de auditoria.", "Display of millions of audit records."), "scroll"),
        new(T("Chat com historico", "Chat with history"), T("Historico conversacional longo de IA.", "Long AI conversational history."), "comments"),
        new(T("Grid de dados", "Data grid"), T("Tabelas com milhas de linhas de dados.", "Tables with thousands of data rows."), "table")
    ];

    // === COMPOSITION ===
    private IReadOnlyList<DocTile> CompositionItems => [
        new(T("Scroller + Template", "Scroller + Template"), T("ItemTemplate customizado com icones e metadados.", "Custom item template with icons and metadata."), "puzzle"),
        new(T("Scroller + Search", "Scroller + Search"), T("Filtro de busca integrado ao scroller.", "Search filter integrated with scroller."), "magnifying-glass"),
