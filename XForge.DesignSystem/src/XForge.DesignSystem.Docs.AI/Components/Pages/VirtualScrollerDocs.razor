        new(T("Muitos itens no DOM", "Too many DOM items"), T("Nao aumente OverscanCount excessivamente.", "Do not increase OverscanCount excessively."), "ban"),
        new(T("Sem labels", "No labels"), T("Sempre defina Title e AriaLabel.", "Always set Title and AriaLabel."), "triangle-exclamation")
    ];

    // === TOKENS ===
    private IReadOnlyList<NameValueRow> TokenRows => [
        new("xf-ai-virtual-scroller", T("Container principal com overflow hidden.", "Main container with overflow hidden.")),
        new("border-border-light", T("Borda do container.", "Container border.")),
        new("bg-bg-surface", T("Fundo da superficie do container.", "Container surface background.")),
        new("shadow-sm", T("Sombra sutil para profundidade.", "Subtle shadow for depth."))
    ];

    // === THEMING ===
    private IReadOnlyList<DocTile> ThemeItems => [
        new("data-theme", T("Tokens light/dark via CSS variables.", "Light/dark tokens via CSS variables."), "moon"),
        new("data-brand", T("Primary acompanha marca ativa.", "Primary follows active brand."), "swatchbook")
    ];

    // === TESTING ===
    private IReadOnlyList<NameValueRow> TestingRows => [
        new("Unit", T("Render, props, virtualizacao, range, templates.", "Render, props, virtualization, range, templates.")),
        new("Accessibility", T("role=list, aria-label, aria-setsize, aria-posinset.", "role=list, aria-label, aria-setsize, aria-posinset."))
    ];

    // === LIMITATIONS ===
