@page "/ai/command-palette"
@inject XForgeDocsLanguageService L

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.AiItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFAiCommandPalette" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@L.Text("Fuzzy search e slash commands", "Fuzzy search and slash commands")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @L.Text("Paleta de comandos AI estilo VSCode/Copilot com busca fuzzy, navegacao por teclado, slash commands e acoes recentes.",
                                   "VSCode/Copilot-style AI command palette with fuzzy search, keyboard navigation, slash commands and recent actions.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @L.Text("Superficie de comandos AI para workflows, com deteccao de slash, busca por categorias, atalhos de teclado e historico de acoes recentes.",
                                   "AI command surface for workflows, with slash detection, category search, keyboard shortcuts and recent action history.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(L.Text("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, L.Text("Campo", "Field"), L.Text("Valor", "Value"))</div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("Blazor Server e Blazor WebAssembly", @<div>
                <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@L.Text("Compatibilidade", "Compatibility")</XFTypography>
                    <XFTable Striped="true" Hoverable="true" Compact="true">
                        <XFTableHeader><XFTableRow><XFTableCell Header="true">@L.Text("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@L.Text("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@L.Text("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                        <XFTableBody>
                            <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                            <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                            <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@L.Text("Limitado", "Limited")" /></XFTableCell><XFTableCell>@L.Text("Renderiza como HTML estatico. Sem eventos.", "Renders as static HTML. No events.")</XFTableCell></XFTableRow>
                        </XFTableBody>
                    </XFTable>
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@L.Text("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@L.Text("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS.")</XFTypography>
                </XFStack>
            </div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(L.Text("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(L.Text("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(L.Text("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(L.Text("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(L.Text("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(L.Text("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 6 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(L.Text("1. Basico", "1. Basic"), L.Text("Paleta basica com comandos e busca.", "Basic palette with commands and search."), ExBasic(), Code1)
            @Example(L.Text("2. Com slash commands", "2. With slash commands"), L.Text("Comandos ativados por prefixo slash.", "Commands activated by slash prefix."), ExSlashCommands(), Code2)
            @Example(L.Text("3. Acoes recentes", "3. Recent actions"), L.Text("Secao de acoes recentes no fluxo do usuario.", "Recent actions section in user flow."), ExRecentActions(), Code3)
            @Example(L.Text("4. MaxResults", "4. Max results"), L.Text("Limite de resultados visiveis.", "Visible results limit."), ExMaxResults(), Code4)
            @Example(L.Text("5. Sem recentes", "5. No recent"), L.Text("Ocultar secao de acoes recentes.", "Hide recent actions section."), ExNoRecent(), Code5)
            @Example(L.Text("6. Template customizado", "6. Custom template"), L.Text("Template customizado para renderizacao de comandos.", "Custom template for command rendering."), ExCustomTemplate(), Code6)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(L.Text("Eventos", "Events"), @<div>@NameValueTable(EventRows, L.Text("Evento", "Event"), L.Text("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(L.Text("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, L.Text("Tecla", "Key"), L.Text("Comportamento", "Behavior"))</div>)
            @Section(L.Text("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(L.Text("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(L.Text("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(L.Text("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(L.Text("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", L.Text("Proposito", "Purpose"))</div>)
            @Section(L.Text("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(L.Text("Testes", "Testing"), @<div>@NameValueTable(TestingRows, L.Text("Cobertura", "Coverage"), L.Text("Evidencia", "Evidence"))</div>)
            @Section(L.Text("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, L.Text("Limitacao", "Limitation"), L.Text("Status", "Status"))</div>)
            @Section(L.Text("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, L.Text("Pergunta", "Question"), L.Text("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, L.Text("Versao", "Version"), L.Text("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>

    <XForgeDocsPageStandard ComponentName="CommandPaletteDocs" />
</XForgeDocsShell>
@code {
    private string ProductLabelText => L.Text("AI Commercial", "AI Commercial");
    private string PageTitleText => L.Text("XFAiCommandPalette", "XFAiCommandPalette");
    private string PageStatusText => L.Text("Documentacao completa", "Complete docs");
    private string CopyableCodeTitle => L.Text("Codigo copiavel", "Copyable code");

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiCommandPalette Visible="true"
                            Commands="Commands"
                            Placeholder="Pesquisar comandos de IA..." />
    </XFStack>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(L.Text("Paleta de comandos", "Command palette"), L.Text("VSCode/Copilot-style com busca fuzzy.", "VSCode/Copilot-style with fuzzy search."), "magnifying-glass"),
        new(L.Text("Slash commands", "Slash commands"), L.Text("Deteccao automatica de prefixo /.", "Automatic slash prefix detection."), "terminal"),
        new(L.Text("Acoes recentes", "Recent actions"), L.Text("Historico de comandos executados recentemente.", "History of recently executed commands."), "clock-rotate-left")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFAiCommandPalette"),
        new("Namespace", "XForge.DesignSystem.Components.AI.Prompting"),
        new("Package", "XForge.DesignSystem.AI"),
        new("Category", "AI / Prompting"),
        new("Status", L.Text("Estavel", "Stable")),
        new("Accessibility", L.Text("role=dialog, role=listbox, role=combobox, aria-modal, aria-activedescendant.", "role=dialog, role=listbox, role=combobox, aria-modal, aria-activedescendant.")),
        new("Theme support", L.Text("Light, dark e data-theme via tokens.", "Light, dark and data-theme via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(L.Text("Paleta de comandos AI", "AI command palette"), L.Text("Superficie modal para comandos com busca fuzzy.", "Modal surface for commands with fuzzy search."), "magnifying-glass"),
        new(L.Text("Slash commands", "Slash commands"), L.Text("Deteccao automatica de comandos por prefixo /.", "Automatic command detection by slash prefix."), "terminal"),
        new(L.Text("Acoes recentes", "Recent actions"), L.Text("Historico de comandos executados recentemente.", "History of recently executed commands."), "clock-rotate-left")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(L.Text("Comandos AI", "AI commands"), L.Text("Execucao rapida de comandos AI por teclado.", "Quick execution of AI commands via keyboard."), "bolt"),
        new(L.Text("Navegacao", "Navigation"), L.Text("Navegacao rapida entre funcionalidades do sistema.", "Quick navigation between system features."), "route"),
        new(L.Text("Automacoes", "Automations"), L.Text("Atalhos para automacoes e workflows AI.", "Shortcuts for AI automations and workflows."), "robot")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(L.Text("Antes", "Before"), L.Text("Comandos dispersos em menus e botoes.", "Commands scattered across menus and buttons."), "xmark"),
        new(L.Text("Depois", "After"), L.Text("Paleta unica com busca, slash e recentes.", "Single palette with search, slash and recent."), "check"),
        new(L.Text("Acessibilidade", "Accessibility"), L.Text("role=dialog, role=combobox, aria-modal para leitores de tela.", "role=dialog, role=combobox, aria-modal for screen readers."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(L.Text("Comandos AI", "AI commands"), L.Text("Execucao de comandos por teclado em workflows AI.", "Command execution via keyboard in AI workflows."), "bolt"),
        new(L.Text("Navegacao rapida", "Quick navigation"), L.Text("Acesso rapido a funcionalidades do sistema.", "Quick access to system features."), "route")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(L.Text("Menus simples", "Simple menus"), L.Text("Use XFMenu para menus basicos sem busca.", "Use XFMenu for basic menus without search."), "bars"),
        new(L.Text("Navegacao principal", "Main navigation"), L.Text("Use rail/sidebar para navegacao principal.", "Use rail/sidebar for main navigation."), "compass")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new("Overlay", L.Text("Fundo semi-transparente com blur.", "Semi-transparent blurred backdrop."), "square"),
        new("Search Input", L.Text("Campo de busca com placeholder.", "Search field with placeholder."), "magnifying-glass"),
        new("Commands List", L.Text("Lista de comandos filtrados.", "List of filtered commands."), "list"),
        new("Footer Hints", L.Text("Dicas de atalhos de teclado.", "Keyboard shortcut hints."), "keyboard")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(L.Text("Busca instantanea", "Instant search"), L.Text("Filtragem fuzzy em tempo real.", "Real-time fuzzy filtering."), "bolt"),
        new(L.Text("Navegacao por teclado", "Keyboard navigation"), L.Text("Complete toda operacao sem mouse.", "Complete all operations without mouse."), "keyboard"),
        new(L.Text("Contexto visual", "Visual context"), L.Text("Categorias, atalhos e icones para cada comando.", "Categories, shortcuts and icons for each command."), "eye")
    ];

    // === EXAMPLES ===
    private RenderFragment ExBasic() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiCommandPalette Visible="true"
                            Commands="Commands"
                            Placeholder="Pesquisar comandos..." />
    </XFStack>;

    private RenderFragment ExSlashCommands() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiCommandPalette Visible="true"
                            Commands="SlashCommands"
                            Placeholder="Digite / para comandos..." />
    </XFStack>;

    private RenderFragment ExRecentActions() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiCommandPalette Visible="true"
                            Commands="Commands"
                            ShowRecentActions="true"
                            RecentActionsLabel="Recentes" />
    </XFStack>;

    private RenderFragment ExMaxResults() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiCommandPalette Visible="true"
                            Commands="Commands"
                            MaxResults="3" />
    </XFStack>;

    private RenderFragment ExNoRecent() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiCommandPalette Visible="true"
                            Commands="Commands"
                            ShowRecentActions="false" />
    </XFStack>;

    private RenderFragment ExCustomTemplate() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiCommandPalette Visible="true"
                            Commands="Commands"
                            Placeholder="Busca customizada..." />
    </XFStack>;

    private const string Code1 = @"<XFAiCommandPalette Visible=""true""
                            Commands=""Commands""
                            Placeholder=""Pesquisar comandos..."" />";
    private const string Code2 = @"<XFAiCommandPalette Visible=""true""
                            Commands=""SlashCommands""
                            Placeholder=""Digite / para comandos..."" />";
    private const string Code3 = @"<XFAiCommandPalette Visible=""true""
                            Commands=""Commands""
                            ShowRecentActions=""true""
                            RecentActionsLabel=""Recentes"" />";
    private const string Code4 = @"<XFAiCommandPalette Visible=""true""
                            Commands=""Commands""
                            MaxResults=""3"" />";
    private const string Code5 = @"<XFAiCommandPalette Visible=""true""
                            Commands=""Commands""
                            ShowRecentActions=""false"" />";
    private const string Code6 = @"<XFAiCommandPalette Visible=""true""
                            Commands=""Commands""
                            Placeholder=""Busca customizada..."" />";

    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("Visible", "bool", "false", L.Text("Controle de visibilidade (two-way bindable).", "Visibility control (two-way bindable).")),
        new("Commands", "IReadOnlyList<XFAiCommandItem>", "[]", L.Text("Lista de comandos disponiveis.", "List of available commands.")),
        new("Placeholder", "string", "\"Pesquisar...\"", L.Text("Texto placeholder do campo de busca.", "Search field placeholder text.")),
        new("MaxResults", "int", "10", L.Text("Numero maximo de resultados visiveis.", "Maximum number of visible results.")),
        new("ShowRecentActions", "bool", "true", L.Text("Exibe secao de acoes recentes.", "Shows recent actions section.")),
        new("RecentActionsLabel", "string", "\"Recentes\"", L.Text("Label da secao de acoes recentes.", "Recent actions section label.")),
        new("CommandsLabel", "string", "\"Comandos\"", L.Text("Label da secao de comandos.", "Commands section label.")),
        new("NoResultsText", "string", "\"Nenhum resultado\"", L.Text("Texto quando nenhum resultado e encontrado.", "Text when no results found."))
    ];

    private IReadOnlyList<NameValueRow> EventRows => [
        new("OnCommandExecute", L.Text("Disparado quando um comando e executado.", "Fired when a command is executed.")),
        new("OnSearch", L.Text("Disparado quando o texto de busca muda.", "Fired when search text changes.")),
        new("VisibleChanged", L.Text("Disparado quando a visibilidade muda.", "Fired when visibility changes."))
    ];

    // === ACCESSIBILITY ===
    private IReadOnlyList<DocTile> AccessibilityItems => [
        new(L.Text("role=dialog", "role=dialog"), L.Text("Paleta usa role=dialog com aria-modal.", "Palette uses role=dialog with aria-modal."), "window-maximize"),
        new(L.Text("role=combobox", "role=combobox"), L.Text("Campo de busca usa role=combobox.", "Search field uses role=combobox."), "magnifying-glass"),
        new(L.Text("aria-activedescendant", "aria-activedescendant"), L.Text("Indica opcao ativa na lista.", "Indicates active option in list."), "arrows-left-right"),
        new(L.Text("Focus trap", "Focus trap"), L.Text("Foco preso dentro da paleta modal.", "Focus trapped inside modal palette."), "lock")
    ];

    private IReadOnlyList<NameValueRow> KeyboardRows => [
        new("Arrow Down / Up", L.Text("Navega entre comandos na lista.", "Navigate between commands in list.")),
        new("Enter", L.Text("Executa o comando selecionado.", "Executes the selected command.")),
        new("Escape", L.Text("Fecha a paleta de comandos.", "Closes the command palette.")),
        new("/", L.Text("Ativa modo slash command.", "Activates slash command mode.")),
        new("Tab", L.Text("Move foco entre elementos do dialogo.", "Moves focus between dialog elements."))
    ];

    // === RESPONSIVENESS ===
    private IReadOnlyList<DocTile> ResponsivenessItems => [
        new(L.Text("Largura maxima", "Max width"), L.Text("Paleta limitada a max-w-xl.", "Palette limited to max-w-xl."), "maximize"),
        new(L.Text("Posicao responsiva", "Responsive position"), L.Text("Centralizada com padding-top responsivo.", "Centered with responsive padding-top."), "mobile-screen")
    ];

    // === PERFORMANCE ===
    private IReadOnlyList<DocTile> PerformanceItems => [
        new(L.Text("Zero JS", "Zero JS"), L.Text("Nenhum JavaScript interop.", "No JavaScript interop."), "bolt"),
        new(L.Text("Busca leve", "Light search"), L.Text("Filtragem fuzzy local sem chamadas de rede.", "Local fuzzy filtering without network calls."), "feather")
    ];

    // === SCENARIOS ===
    private IReadOnlyList<DocTile> ScenarioItems => [
        new(L.Text("Comandos fiscais", "Fiscal commands"), L.Text("Execucao rapida de comandos de analise fiscal.", "Quick execution of fiscal analysis commands."), "file-invoice"),
        new(L.Text("Automacoes", "Automations"), L.Text("Atalhos para workflows automatizados.", "Shortcuts for automated workflows."), "robot"),
        new(L.Text("Navegacao de modulos", "Module navigation"), L.Text("Acesso rapido a modulos do sistema ERP.", "Quick access to ERP system modules."), "route")
    ];

    // === COMPOSITION ===
    private IReadOnlyList<DocTile> CompositionItems => [
        new(L.Text("CommandPalette + Slash", "CommandPalette + Slash"), L.Text("Slash commands para comandos frequentes.", "Slash commands for frequent commands."), "terminal"),
        new(L.Text("CommandPalette + Recent", "CommandPalette + Recent"), L.Text("Acoes recentes para produtividade.", "Recent actions for productivity."), "clock-rotate-left"),
        new(L.Text("CommandPalette + Overlay", "CommandPalette + Overlay"), L.Text("Overlay com blur para foco no dialogo.", "Overlay with blur for dialog focus."), "square")
    ];

    // === BEST PRACTICES ===
    private IReadOnlyList<DocTile> BestPracticeItems => [
        new(L.Text("Categorias claras", "Clear categories"), L.Text("Agrupe comandos por categoria para navegacao.", "Group commands by category for navigation."), "layer-group"),
        new(L.Text("Atalhos de teclado", "Keyboard shortcuts"), L.Text("Defina shortcuts para comandos frequentes.", "Set shortcuts for frequent commands."), "keyboard"),
        new(L.Text("MaxResults adequado", "Adequate MaxResults"), L.Text("Limite a 5-10 para performance e legibilidade.", "Limit to 5-10 for performance and readability."), "bars"),
        new(L.Text("Placeholder orientador", "Guiding placeholder"), L.Text("Use placeholder para orientar o usuario.", "Use placeholder to guide the user."), "align-left")
    ];

    // === ANTI-PATTERNS ===
    private IReadOnlyList<DocTile> AntiPatternItems => [
        new(L.Text("Muitos comandos", "Too many commands"), L.Text("Lista longa sem categorias e dificil de navegar.", "Long list without categories is hard to navigate."), "xmark"),
        new(L.Text("Sem categorias", "No categories"), L.Text("Comandos sem agrupamento visual.", "Commands without visual grouping."), "ban"),
        new(L.Text("Sem atalhos", "No shortcuts"), L.Text("Comandos sem atalhos de teclado perdem produtividade.", "Commands without keyboard shortcuts lose productivity."), "triangle-exclamation")
    ];

    // === TOKENS ===
    private IReadOnlyList<NameValueRow> TokenRows => [
        new("overlay", L.Text("fixed inset-0 z-50 bg-surface-950/40 backdrop-blur-sm.", "fixed inset-0 z-50 bg-surface-950/40 backdrop-blur-sm.")),
        new("palette", L.Text("w-full max-w-xl rounded-xl border border-border-light bg-bg-surface shadow.", "w-full max-w-xl rounded-xl border border-border-light bg-bg-surface shadow.")),
        new("search", L.Text("flex items-center gap-3 border-b border-border-light px-4 py-3.", "flex items-center gap-3 border-b border-border-light px-4 py-3."))
    ];

    // === THEMING ===
    private IReadOnlyList<DocTile> ThemeItems => [
        new("data-theme", L.Text("Tokens light/dark via CSS variables.", "Light/dark tokens via CSS variables."), "moon"),
        new("data-brand", L.Text("Primary acompanha marca ativa.", "Primary follows active brand."), "swatchbook")
    ];

    // === TESTING ===
    private IReadOnlyList<NameValueRow> TestingRows => [
        new("Unit", L.Text("Testes de render, busca, navegacao, executacao, slash.", "Render, search, navigation, execution, slash tests.")),
        new("Accessibility", L.Text("role=dialog, role=combobox, aria-modal, aria-activedescendant.", "role=dialog, role=combobox, aria-modal, aria-activedescendant."))
    ];

    // === LIMITATIONS ===
    private IReadOnlyList<NameValueRow> LimitationRows => [
        new("Static SSR", L.Text("Eventos de teclado e busca nao funcionam em SSR estatico.", "Keyboard and search events do not work in static SSR.")),
        new("MaxResults", L.Text("Lista muito longa pode afetar performance.", "Very long list may affect performance."))
    ];

    // === RELATED ===
    private IReadOnlyList<DocTile> RelatedComponentItems => [
