@page "/ai/theme-editor"
@using XForge.DesignSystem.Components.AI.Tooling
@inject XForgeDocsLanguageService L

<XForgeDocsShell ProductLabel="AI Commercial"
                 Title="XFThemeEditor"
                 Status="@L.Text("Estavel", "Stable")"
                 Items="XForgeDocsCatalog.AiItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFThemeEditor" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@L.Text("Cores, tipografia e espacamento", "Colors, typography and spacing")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@L.Text("Export CSS/JSON", "Export CSS/JSON")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @L.Text("Editor visual de temas com cores, tipografia, espacamento, preview ao vivo, presets e exportacao CSS/JSON.",
                                "Visual theme editor with colors, typography, spacing, live preview, presets and CSS/JSON export.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @L.Text("Painel completo para customizacao de tokens de design, com abas para cores, tipografia, espacamento, preview ao vivo de botoes e cards, seletor de presets, toggle dark mode e exportacao em CSS ou JSON. Puro Blazor, sem JavaScript interop.",
                                "Complete panel for design token customization, with tabs for colors, typography, spacing, live preview of buttons and cards, preset selector, dark mode toggle and CSS or JSON export. Pure Blazor, no JavaScript interop.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(L.Text("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, L.Text("Campo", "Field"), L.Text("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@L.Text("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@L.Text("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@L.Text("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@L.Text("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Funciona sem restricoes. Preview ao vivo reativo.", "Works without restrictions. Reactive live preview.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Renderiza como HTML estatico.", "Renders as static HTML.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@L.Text("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@L.Text("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(L.Text("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(L.Text("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(L.Text("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(L.Text("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(L.Text("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(L.Text("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 3 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(L.Text("1. Editor padrao", "1. Default Editor"), L.Text("Editor com abas de cores, tipografia e espacamento.", "Editor with color, typography and spacing tabs."), ExDefault(), Code1)
            @Example(L.Text("2. Sem header e exportacao", "2. Without Header and Export"), L.Text("Editor compacto sem cabecalho e painel de exportacao.", "Compact editor without header and export panel."), ExCompact(), Code2)
            @Example(L.Text("3. Com presets e dark mode", "3. With Presets and Dark Mode"), L.Text("Editor com seletor de presets e toggle de dark mode habilitados.", "Editor with preset selector and dark mode toggle enabled."), ExWithPresets(), Code3)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(L.Text("Eventos", "Events"), @<div>@NameValueTable(EventRows, L.Text("Evento", "Event"), L.Text("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(L.Text("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, L.Text("Tecla", "Key"), L.Text("Comportamento", "Behavior"))</div>)
            @Section(L.Text("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(L.Text("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(L.Text("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(L.Text("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(L.Text("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", L.Text("Proposito", "Purpose"))</div>)
            @Section(L.Text("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(L.Text("Testes", "Testing"), @<div>@NameValueTable(TestingRows, L.Text("Cobertura", "Coverage"), L.Text("Evidencia", "Evidence"))</div>)
            @Section(L.Text("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, L.Text("Limitacao", "Limitation"), L.Text("Status", "Status"))</div>)
            @Section(L.Text("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, L.Text("Pergunta", "Question"), L.Text("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, L.Text("Versao", "Version"), L.Text("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string CopyableCodeTitle => L.Text("Codigo copiavel", "Copyable code");

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFThemeEditor Title="Theme Editor" ShowHeader="true" ShowExportPanel="false" />
    </XFStack>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(L.Text("Editor visual de temas", "Visual theme editor"), L.Text("Cores, tipografia, espacamento e preview ao vivo.", "Colors, typography, spacing and live preview."), "palette"),
        new(L.Text("Export CSS/JSON", "Export CSS/JSON"), L.Text("Exporta tokens como custom properties ou JSON.", "Exports tokens as custom properties or JSON."), "file-export"),
        new(L.Text("Zero JS", "Zero JS"), L.Text("Nenhum JavaScript interop. Puro C# + Tailwind.", "No JavaScript interop. Pure C# + Tailwind."), "bolt")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFThemeEditor"),
        new("Namespace", "XForge.DesignSystem.Components.AI.Tooling"),
        new("Package", "XForge.DesignSystem.AI"),
        new("Category", "AI / Tooling / Theme Editor"),
        new("Status", L.Text("Estavel", "Stable")),
        new("Accessibility", L.Text("role=region, aria-label, aria-selected em abas.", "role=region, aria-label, aria-selected on tabs.")),
        new("Theme support", L.Text("Light, dark e data-theme via tokens.", "Light, dark and data-theme via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(L.Text("Editor de temas", "Theme editor"), L.Text("Painel visual para customizacao de tokens.", "Visual panel for token customization."), "palette"),
        new(L.Text("4 abas", "4 tabs"), L.Text("Cores, Tipografia, Espacamento e Preview.", "Colors, Typography, Spacing and Preview."), "layer-group"),
        new(L.Text("Exportacao", "Export"), L.Text("CSS custom properties ou JSON formatado.", "CSS custom properties or formatted JSON."), "file-export")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(L.Text("Customizacao de marca", "Brand customization"), L.Text("Ajustar cores, fontes e espacamento para a marca.", "Adjust colors, fonts and spacing for the brand."), "swatchbook"),
        new(L.Text("Prototipagem rapida", "Rapid prototyping"), L.Text("Testar temas diferentes visualmente.", "Visually test different themes."), "flask"),
        new(L.Text("Exportacao de tokens", "Token export"), L.Text("Gerar CSS ou JSON para uso em projetos.", "Generate CSS or JSON for use in projects."), "download")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(L.Text("Antes", "Before"), L.Text("Edicao manual de CSS variables.", "Manual editing of CSS variables."), "xmark"),
        new(L.Text("Depois", "After"), L.Text("Editor visual com preview ao vivo e exportacao.", "Visual editor with live preview and export."), "check"),
        new(L.Text("Acessibilidade", "Accessibility"), L.Text("role=region, aria-label, navegacao por abas.", "role=region, aria-label, tab navigation."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(L.Text("Personalizacao de tema", "Theme customization"), L.Text("Ajustar tokens para projetos ou marcas.", "Adjust tokens for projects or brands."), "swatchbook"),
        new(L.Text("Exportacao de tokens", "Token export"), L.Text("Gerar CSS/JSON para CI/CD ou outros projetos.", "Generate CSS/JSON for CI/CD or other projects."), "download")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(L.Text("Edicao de layout", "Layout editing"), L.Text("Use XFGrid ou XFStack para layouts.", "Use XFGrid or XFStack for layouts."), "maximize"),
        new(L.Text("Geracao de componentes", "Component generation"), L.Text("Use XFComponentGenerator.", "Use XFComponentGenerator."), "code")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new(L.Text("Header", "Header"), L.Text("Barra superior com titulo, badge de aba ativa e controles.", "Top bar with title, active tab badge and controls."), "bars"),
        new(L.Text("Tab bar", "Tab bar"), L.Text("Navegacao entre Cores, Tipografia, Espacamento e Preview.", "Navigation between Colors, Typography, Spacing and Preview."), "layer-group"),
        new(L.Text("Tab content", "Tab content"), L.Text("Painel de edicao com inputs especificos para cada aba.", "Editing panel with specific inputs for each tab."), "pencil"),
        new(L.Text("Export panel", "Export panel"), L.Text("Botoes CSS/JSON e saida formatada.", "CSS/JSON buttons and formatted output."), "file-export")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(L.Text("Preview ao vivo", "Live preview"), L.Text("Mudancas refletidas imediatamente no Preview.", "Changes reflected immediately in Preview."), "eye"),
        new(L.Text("CSS variables", "CSS variables"), L.Text("Tokens exportados como custom properties padrao.", "Tokens exported as standard custom properties."), "code"),
        new(L.Text("Simplicidade", "Simplicity"), L.Text("Uma aba por categoria. Sem sobrecarga visual.", "One tab per category. No visual overload."), "minimize")
    ];

    // === EXAMPLES ===
    private RenderFragment ExDefault() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFThemeEditor Title="Theme Editor" ShowHeader="true" />
    </XFStack>;

    private RenderFragment ExCompact() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFThemeEditor Title="Compact" ShowHeader="false" ShowExportPanel="false" />
    </XFStack>;

    private RenderFragment ExWithPresets() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFThemeEditor Title="With Presets" ShowPresetSelector="true" ShowDarkModeToggle="true" ShowExportPanel="true" />
    </XFStack>;

    private const string Code1 = @"<XFThemeEditor Title=""Theme Editor"" ShowHeader=""true"" />";
    private const string Code2 = @"<XFThemeEditor Title=""Compact"" ShowHeader=""false"" ShowExportPanel=""false"" />";
    private const string Code3 = @"<XFThemeEditor Title=""With Presets""
              ShowPresetSelector=""true""
              ShowDarkModeToggle=""true""
              ShowExportPanel=""true"" />";

    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("Title", "string", "\"Theme Editor\"", L.Text("Titulo do componente.", "Component title.")),
        new("AriaLabel", "string", "\"Editor de temas\"", L.Text("Rotulo ARIA para acessibilidade.", "ARIA label for accessibility.")),
        new("ShowHeader", "bool", "true", L.Text("Exibe a barra de cabecalho.", "Shows the header bar.")),
        new("ShowPresetSelector", "bool", "true", L.Text("Exibe o seletor de presets.", "Shows the preset selector.")),
        new("ShowDarkModeToggle", "bool", "true", L.Text("Exibe o toggle de dark mode.", "Shows the dark mode toggle.")),
        new("ShowExportPanel", "bool", "true", L.Text("Exibe o painel de exportacao CSS/JSON.", "Shows the CSS/JSON export panel.")),
        new("Presets", "IReadOnlyList<XFThemePreset>", "[]", L.Text("Lista de presets disponiveis.", "Available preset list.")),
        new("InitialColors", "IReadOnlyList<XFThemeColor>?", "null", L.Text("Cores iniciais do editor.", "Initial editor colors.")),
        new("InitialTypography", "IReadOnlyList<XFThemeTypography>?", "null", L.Text("Tipografia inicial do editor.", "Initial editor typography.")),
        new("InitialSpacing", "IReadOnlyList<XFThemeSpacing>?", "null", L.Text("Espacamento inicial do editor.", "Initial editor spacing."))
    ];

    private IReadOnlyList<NameValueRow> EventRows => [
        new("OnThemeChanged", L.Text("Disparado quando qualquer valor do tema muda.", "Fired when any theme value changes."))
    ];

    // === ACCESSIBILITY ===
    private IReadOnlyList<DocTile> AccessibilityItems => [
        new(L.Text("role=region", "role=region"), L.Text("Componente usa role=region para leitores de tela.", "Component uses role=region for screen readers."), "universal-access"),
        new(L.Text("aria-label", "aria-label"), L.Text("Rotulo descritivo do editor.", "Descriptive editor label."), "tag"),
        new(L.Text("Navegacao por abas", "Tab navigation"), L.Text("role=tab com aria-selected para cada aba.", "role=tab with aria-selected for each tab."), "keyboard"),
        new(L.Text("Inputs com label", "Inputs with label"), L.Text("Cada input de cor e espacamento tem label associado.", "Each color and spacing input has associated label."), "font")
    ];

    private IReadOnlyList<NameValueRow> KeyboardRows => [
        new("Tab", L.Text("Navega entre abas e controles do editor.", "Navigates between tabs and editor controls.")),
        new("Enter", L.Text("Ativa aba ou botao selecionado.", "Activates selected tab or button.")),
        new("Space", L.Text("Ativa toggle de dark mode.", "Activates dark mode toggle."))
    ];

    // === RESPONSIVENESS ===
    private IReadOnlyList<DocTile> ResponsivenessItems => [
        new(L.Text("Largura total", "Full width"), L.Text("Editor ocupa 100% do container.", "Editor occupies 100% of container."), "maximize"),
        new(L.Text("Layout responsivo", "Responsive layout"), L.Text("Abas e inputs se adaptam a tela.", "Tabs and inputs adapt to screen size."), "mobile-screen")
    ];

    // === PERFORMANCE ===
    private IReadOnlyList<DocTile> PerformanceItems => [
        new(L.Text("Zero JS", "Zero JS"), L.Text("Nenhum JavaScript interop.", "No JavaScript interop."), "bolt"),
        new(L.Text("Render leve", "Light render"), L.Text("Tag div nativa sem wrappers.", "Native div tag without wrappers."), "feather")
    ];

    // === SCENARIOS ===
    private IReadOnlyList<DocTile> ScenarioItems => [
        new(L.Text("Personalizacao de marca", "Brand customization"), L.Text("Ajustar tokens para identidade visual da empresa.", "Adjust tokens for company visual identity."), "swatchbook"),
        new(L.Text("Multi-tema", "Multi-theme"), L.Text("Gerenciar temas claros e escuros para o mesmo app.", "Manage light and dark themes for the same app."), "moon"),
        new(L.Text("Exportacao CI/CD", "CI/CD export"), L.Text("Gerar CSS tokens para pipeline de build.", "Generate CSS tokens for build pipeline."), "gear")
    ];

    // === COMPOSITION ===
    private IReadOnlyList<DocTile> CompositionItems => [
        new(L.Text("Editor + XFCard", "Editor + XFCard"), L.Text("Editor dentro de um card para contexto.", "Editor inside a card for context."), "square"),
        new(L.Text("Editor + Tabs", "Editor + Tabs"), L.Text("Navegacao por abas para categorias de tokens.", "Tab navigation for token categories."), "layer-group"),
        new(L.Text("Editor + Preview", "Editor + Preview"), L.Text("Preview ao vivo de botoes e cards customizados.", "Live preview of customized buttons and cards."), "eye")
    ];

    // === BEST PRACTICES ===
    private IReadOnlyList<DocTile> BestPracticeItems => [
        new(L.Text("Preview ao vivo", "Live preview"), L.Text("Sempre mostre preview para mudancas de tema.", "Always show preview for theme changes."), "eye"),
        new(L.Text("Exportacao em dois formatos", "Export in two formats"), L.Text("Suporte CSS e JSON para flexibilidade.", "Support CSS and JSON for flexibility."), "file-export"),
        new(L.Text("Presets pre-configurados", "Pre-configured presets"), L.Text("Forneça presets para rapido comeco.", "Provide presets for quick start."), "wand-magic-sparkles"),
        new(L.Text("Dark mode toggle", "Dark mode toggle"), L.Text("Permita alternancia entre temas claro e escuro.", "Allow switching between light and dark themes."), "moon")
    ];

    // === ANTI-PATTERNS ===
    private IReadOnlyList<DocTile> AntiPatternItems => [
        new(L.Text("Sem preview", "No preview"), L.Text("Editor sem preview ao vivo e confuso.", "Editor without live preview is confusing."), "xmark"),
        new(L.Text("Muitas abas", "Too many tabs"), L.Text("Evite mais de 4 categorias de tokens.", "Avoid more than 4 token categories."), "ban"),
        new(L.Text("Export apenas CSS", "Export CSS only"), L.Text("JSON e necessario para integracoes programaticas.", "JSON is needed for programmatic integrations."), "triangle-exclamation")
    ];

    // === TOKENS ===
    private IReadOnlyList<NameValueRow> TokenRows => [
        new("xf-theme-editor", L.Text("Container principal com borda arredondada.", "Main container with rounded border.")),
        new("color-input", L.Text("Input de cor com preview hex.", "Color input with hex preview.")),
        new("tab-bar", L.Text("Barra de navegacao entre abas.", "Navigation bar between tabs.")),
        new("export-panel", L.Text("Painel de exportacao CSS/JSON.", "CSS/JSON export panel."))
    ];

    // === THEMING ===
    private IReadOnlyList<DocTile> ThemeItems => [
        new("data-theme", L.Text("Tokens light/dark via CSS variables.", "Light/dark tokens via CSS variables."), "moon"),
        new("data-brand", L.Text("Primary acompanha marca ativa.", "Primary follows active brand."), "swatchbook")
    ];

    // === TESTING ===
    private IReadOnlyList<NameValueRow> TestingRows => [
        new("Unit", L.Text("Testes de render, props, tabs, colors, export.", "Render, props, tabs, colors, export tests.")),
