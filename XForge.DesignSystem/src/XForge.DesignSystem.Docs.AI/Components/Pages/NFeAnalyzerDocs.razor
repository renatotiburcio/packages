@page "/ai/nfe-analyzer"
@using XForge.DesignSystem.Components.AI.Fiscal
@using XForge.DesignSystem.Services.AI
@inject XForgeDocsLanguageService L

<XForgeDocsShell ProductLabel="AI Commercial"
                 Title="@L.Text("NF-e Analyzer", "NF-e Analyzer")"
                 Status="@L.Text("Documentacao completa", "Complete docs")"
                 Items="XForgeDocsCatalog.AiItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFAiNFeAnalyzer" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@L.Text("Analise fiscal com IA", "AI-powered fiscal analysis")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @L.Text("Analisador inteligente de NF-e com IA para validacao fiscal, CFOP, CST, NCM, SPED e risco.",
                                   "Intelligent NF-e analyzer with AI for fiscal validation, CFOP, CST, NCM, SPED and risk.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @L.Text("Componente enterprise que analisa XML de NF-e, valida codigos fiscais, detecta inconsistencias, verifica SPED, avalia CBS/IBS e gera relatorio de risco com IA generativa.",
                                   "Enterprise component that analyzes NF-e XML, validates fiscal codes, detects inconsistencies, checks SPED, evaluates CBS/IBS and generates AI-powered risk reports.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(L.Text("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, L.Text("Campo", "Field"), L.Text("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@L.Text("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@L.Text("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@L.Text("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@L.Text("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Funciona com IA via backend.", "Works with AI via backend.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Requer provider de IA no cliente.", "Requires AI provider on client.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@L.Text("Parcial", "Partial")" /></XFTableCell><XFTableCell>@L.Text("Renderiza sem analise interativa.", "Renders without interactive analysis.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@L.Text("Dependencias", "Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@L.Text("Requer IAiProvider injetado. Parsing de JSON interno sem dependencia JS externa.", "Requires injected IAiProvider. JSON parsing internal without external JS dependency.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(L.Text("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(L.Text("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(L.Text("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(L.Text("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(L.Text("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(L.Text("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 6 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(L.Text("1. Basico", "1. Basic"), L.Text("Analise minima com titulo e placeholder.", "Minimal analysis with title and placeholder."), ExBasic(), Code1)
            @Example(L.Text("2. Com Provider", "2. With Provider"), L.Text("Provider de IA injetado para analise real.", "Injected AI provider for real analysis."), ExWithProvider(), Code2)
            @Example(L.Text("3. Sem Header", "3. Without Header"), L.Text("Analise compacta sem cabecalho.", "Compact analysis without header."), ExNoHeader(), Code3)
            @Example(L.Text("4. Custom Prompt", "5. Custom Prompt"), L.Text("System prompt customizado para regras especificas.", "Custom system prompt for specific rules."), ExCustomPrompt(), Code4)
            @Example(L.Text("5. Custom Result", "6. Custom Result"), L.Text("Template de resultado customizado com ResultPreview.", "Custom result template with ResultPreview."), ExCustomResult(), Code5)
            @Example(L.Text("6. Loading Externo", "7. External Loading"), L.Text("Estado de loading controlado externamente.", "Externally controlled loading state."), ExExternalLoading(), Code6)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(L.Text("Eventos", "Events"), @<div>@NameValueTable(EventRows, L.Text("Evento", "Event"), L.Text("Comportamento", "Behavior"))</div>)
            @Section(L.Text("Tipos", "Types"), @<div>@NameValueTable(TypeRows, L.Text("Tipo", "Type"), L.Text("Descricao", "Description"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(L.Text("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, L.Text("Tecla", "Key"), L.Text("Comportamento", "Behavior"))</div>)
            @Section(L.Text("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(L.Text("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(L.Text("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(L.Text("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(L.Text("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", L.Text("Proposito", "Purpose"))</div>)
            @Section(L.Text("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(L.Text("Testes", "Testing"), @<div>@NameValueTable(TestingRows, L.Text("Cobertura", "Coverage"), L.Text("Evidencia", "Evidence"))</div>)
            @Section(L.Text("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, L.Text("Limitacao", "Limitation"), L.Text("Status", "Status"))</div>)
            @Section(L.Text("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, L.Text("Pergunta", "Question"), L.Text("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, L.Text("Versao", "Version"), L.Text("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string T(string pt, string en) => L.Text(pt, en);
    private string CopyableCodeTitle => L.Text("Codigo copiavel", "Copyable code");

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFAiNFeAnalyzer Title="@L.Text("Analise NF-e", "NF-e Analysis")"
                                                              Placeholder="@L.Text("Cole o XML da NF-e para revisar riscos fiscais...", "Paste NF-e XML to review fiscal risks...")"
                                                              ShowHeader="true" />;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(L.Text("Analise fiscal com IA", "AI fiscal analysis"), L.Text("Validacao de CFOP, CST, NCM e SPED via IA.", "CFOP, CST, NCM and SPED validation via AI."), "sparkles"),
        new(L.Text("Deteccao de riscos", "Risk detection"), L.Text("Niveis de risco: Low, Medium, High, Critical.", "Risk levels: Low, Medium, High, Critical."), "shield"),
        new(L.Text("Zero JS interop", "Zero JS interop"), L.Text("Parsing de JSON interno. Sem dependencia JS.", "Internal JSON parsing. No JS dependency."), "bolt")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFAiNFeAnalyzer"),
        new("Namespace", "XForge.DesignSystem.Components.AI.Fiscal"),
        new("Package", "XForge.DesignSystem.AI"),
        new("Category", "AI / Fiscal"),
        new("Status", L.Text("Estavel", "Stable")),
        new("Accessibility", L.Text("role=region, aria-label, aria-busy, aria-live=polite.", "role=region, aria-label, aria-busy, aria-live=polite.")),
        new("Theme support", L.Text("Light, dark e data-brand via tokens.", "Light, dark and data-brand via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(L.Text("Analise de NF-e", "NF-e analysis"), L.Text("Componente AI para analise fiscal de notas fiscais eletronicas.", "AI component for electronic invoice fiscal analysis."), "file-invoice"),
        new(L.Text("Validacao codigos", "Code validation"), L.Text("CFOP, CST, NCM com base de dados atualizada.", "CFOP, CST, NCM with up-to-date database."), "check-double"),
        new(L.Text("Relatorio de risco", "Risk report"), L.Text("Niveis de risco, inconsistencias e sugestoes da IA.", "Risk levels, inconsistencies and AI suggestions."), "chart-line")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(L.Text("Auditoria fiscal", "Fiscal audit"), L.Text("Automatizar revisao de NF-e com IA generativa.", "Automate NF-e review with generative AI."), "magnifying-glass-chart"),
        new(L.Text("Compliance", "Compliance"), L.Text("Validar conformidade com SPED e legisacao tributaria.", "Validate compliance with SPED and tax legislation."), "shield-check"),
        new(L.Text("Reducao de custo", "Cost reduction"), L.Text("Reduzir erros manuais na analise de notas.", "Reduce manual errors in invoice analysis."), "coins")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(L.Text("Antes", "Before"), L.Text("Analise manual lenta e sujeita a erros.", "Slow manual analysis prone to errors."), "xmark"),
        new(L.Text("Depois", "After"), L.Text("Analise automatica com IA, risco e sugestoes.", "Automatic analysis with AI, risk and suggestions."), "check"),
        new(L.Text("Acessibilidade", "Accessibility"), L.Text("aria-live anuncia resultados para leitores de tela.", "aria-live announces results for screen readers."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(L.Text("Auditoria de NF-e", "NF-e audit"), L.Text("Revisao automatizada de notas fiscais.", "Automated invoice review."), "file-invoice"),
        new(L.Text("Compliance tributario", "Tax compliance"), L.Text("Validacao SPED e codigos fiscais.", "SPED and fiscal code validation."), "shield-check")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(L.Text("Notas nao estruturadas", "Unstructured invoices"), L.Text("Use XFAiDocumentReader para PDFs.", "Use XFAiDocumentReader for PDFs."), "file-lines"),
        new(L.Text("Analise de texto livre", "Free text analysis"), L.Text("Use XFAiChat para conversacao.", "Use XFAiChat for conversation."), "comments")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new("Header", L.Text("Titulo, icone sparkles e status de loading.", "Title, sparkles icon and loading status."), "heading"),
        new("Input Area", L.Text("Textarea com placeholder e botao Analisar.", "Textarea with placeholder and Analyze button."), "text-input"),
        new("Error Banner", L.Text("Banner de erro com icone e botao dispensar.", "Error banner with icon and dismiss button."), "triangle-exclamation"),
        new("Loading Skeleton", L.Text("Skeleton animado durante analise.", "Animated skeleton during analysis."), "spinner"),
        new("Result Preview", L.Text("Cards de resultado com risco, SPED, CFOP e inconsistencias.", "Result cards with risk, SPED, CFOP and inconsistencies."), "clipboard-check"),
        new("Empty State", L.Text("Estado vazio com icone e texto guia.", "Empty state with icon and guide text."), "circle")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(L.Text("Feedback imediato", "Immediate feedback"), L.Text("Loading skeleton, erros inline e aria-live.", "Loading skeleton, inline errors and aria-live."), "eye"),
        new(L.Text("IA transparente", "Transparent AI"), L.Text("Resumo IA com badge de confianca.", "AI summary with confidence badge."), "sparkles"),
        new(L.Text("Gradacao de risco", "Risk gradation"), L.Text("4 niveis de risco com cores semanticas.", "4 risk levels with semantic colors."), "palette")
    ];

    // === EXAMPLES ===
    private RenderFragment ExBasic() => @<XFAiNFeAnalyzer Title="@L.Text("Analise NF-e", "NF-e Analysis")"
                                                          Placeholder="@L.Text("Cole o XML da NF-e...", "Paste NF-e XML...")"
                                                          ShowHeader="true" />;

    private RenderFragment ExWithProvider() => @<XFAiNFeAnalyzer Title="@L.Text("Analise com Provider", "Analysis with Provider")"
                                                                 ShowHeader="true" />;

    private RenderFragment ExNoHeader() => @<XFAiNFeAnalyzer ShowHeader="false"
                                                             Placeholder="@L.Text("Analise rapida...", "Quick analysis...")" />;

    private RenderFragment ExCustomPrompt() => @<XFAiNFeAnalyzer Title="@L.Text("Validador CBS/IBS", "CBS/IBS Validator")"
                                                                 SystemPrompt="Voce e um validador especializado em CBS/IBS. Analise a NF-e e retorne JSON com cbsReadiness, ibsReadiness e impactoFiscal."
                                                                 ShowHeader="true" />;

    private RenderFragment ExCustomResult() => @<XFAiNFeAnalyzer Title="@L.Text("Resultado Custom", "Custom Result")"
                                                                 ShowHeader="true">
        <ResultPreview>
            <div class="rounded-lg border border-border-light bg-surface-50 p-4">
                <div class="text-sm font-semibold">@L.Text("Chave:", "Key:") @context.NFeKey</div>
                <div class="text-sm text-text-secondary">@L.Text("Risco:", "Risk:") @context.RiskLevel</div>
                <div class="text-sm text-text-secondary">@L.Text("Confianca:", "Confidence:") @((context.Confidence * 100).ToString("F0"))%</div>
            </div>
        </ResultPreview>
    </XFAiNFeAnalyzer>;

    private RenderFragment ExExternalLoading() => @<XFAiNFeAnalyzer Loading="true"
                                                                     Title="@L.Text("Carregando...", "Loading...")"
                                                                     ShowHeader="true" />;

    private const string Code1 = @"<XFAiNFeAnalyzer Title=""Analise NF-e""
                          Placeholder=""Cole o XML da NF-e...""
                          ShowHeader=""true"" />";
    private const string Code2 = @"<XFAiNFeAnalyzer Title=""Analise com Provider""
                          ShowHeader=""true"" />";
    private const string Code3 = @"<XFAiNFeAnalyzer ShowHeader=""false""
                          Placeholder=""Analise rapida..."" />";
    private const string Code4 = @"<XFAiNFeAnalyzer Title=""Validador CBS/IBS""
                          SystemPrompt=""Voce e um validador especializado em CBS/IBS. Analise a NF-e e retorne JSON com cbsReadiness, ibsReadiness e impactoFiscal.""
                          ShowHeader=""true"" />";
    private const string Code5 = @"<XFAiNFeAnalyzer Title=""Resultado Custom"" ShowHeader=""true"">
    <ResultPreview>
        <div class=""rounded-lg border border-border-light bg-surface-50 p-4"">
            <div class=""text-sm font-semibold"">Chave: @context.NFeKey</div>
            <div class=""text-sm text-text-secondary"">Risco: @context.RiskLevel</div>
            <div class=""text-sm text-text-secondary"">Confianca: @((context.Confidence * 100).ToString(""F0""))%</div>
        </div>
    </ResultPreview>
</XFAiNFeAnalyzer>";
    private const string Code6 = @"<XFAiNFeAnalyzer Loading=""true""
                          Title=""Carregando...""
                          ShowHeader=""true"" />";

    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("Provider", "IAiProvider?", "null", L.Text("Provedor de IA para analise fiscal.", "AI provider for fiscal analysis.")),
        new("Title", "string", "\"Analisador de NF-e\"", L.Text("Titulo exibido no header.", "Title displayed in header.")),
        new("Placeholder", "string", "\"Cole o XML...\"", L.Text("Texto placeholder da area de entrada.", "Input area placeholder text.")),
        new("ShowHeader", "bool", "true", L.Text("Exibe o cabecalho do componente.", "Displays the component header.")),
        new("Loading", "bool", "false", L.Text("Estado de loading controlado externamente.", "Externally controlled loading state.")),
        new("SystemPrompt", "string?", "null", L.Text("Prompt do sistema customizado para o provider IA.", "Custom system prompt for the AI provider.")),
        new("Disabled", "bool", "false", L.Text("Desabilita entrada e botoes.", "Disables input and buttons."))
    ];

    private IReadOnlyList<NameValueRow> EventRows => [
        new("OnAnalysisComplete", L.Text("Disparado quando analise completa com sucesso. Retorna XFAiNFeAnalysisResult.", "Fired when analysis completes successfully. Returns XFAiNFeAnalysisResult.")),
        new("OnError", L.Text("Disparado quando erro ocorre durante analise. Retorna string com mensagem.", "Fired when error occurs during analysis. Returns string with message."))
    ];

    private IReadOnlyList<NameValueRow> TypeRows => [
        new("XFAiNFeAnalysisResult", L.Text("Resultado completo com NFeKey, IssuerName, TotalValue, TaxSummary, Inconsistencies, RiskLevel, SpedStatus, Confidence.", "Complete result with NFeKey, IssuerName, TotalValue, TaxSummary, Inconsistencies, RiskLevel, SpedStatus, Confidence.")),
        new("XFAiNFeRiskLevel", L.Text("Enum: Low, Medium, High, Critical.", "Enum: Low, Medium, High, Critical.")),
        new("XFAiNFeSpedStatus", L.Text("Enum: NotValidated, Valid, WithWarnings, Invalid.", "Enum: NotValidated, Valid, WithWarnings, Invalid.")),
        new("XFAiNFeInconsistency", L.Text("Registro com Severity, Code, Message, Field, Suggestion.", "Record with Severity, Code, Message, Field, Suggestion."))
    ];

    // === ACCESSIBILITY ===
    private IReadOnlyList<DocTile> AccessibilityItems => [
        new(L.Text("role=region", "role=region"), L.Text("Container principal usa role=region.", "Main container uses role=region."), "universal-access"),
        new(L.Text("aria-label", "aria-label"), L.Text("Label descritivo do componente.", "Descriptive component label."), "tag"),
        new(L.Text("aria-busy", "aria-busy"), L.Text("Indica estado de analise em andamento.", "Indicates analysis in progress state."), "spinner"),
        new(L.Text("aria-live=polite", "aria-live=polite"), L.Text("Resultado anunciado para leitores de tela.", "Result announced for screen readers."), "volume-high")
    ];

    private IReadOnlyList<NameValueRow> KeyboardRows => [
        new("Enter", L.Text("Envia analise quando nao esta busy.", "Sends analysis when not busy.")),
        new("Escape", L.Text("Limpa campo de entrada e erro.", "Clears input field and error.")),
        new("Shift+Enter", L.Text("Nova linha sem enviar.", "New line without sending."))
    ];

    // === RESPONSIVENESS ===
    private IReadOnlyList<DocTile> ResponsivenessItems => [
        new(L.Text("Largura total", "Full width"), L.Text("Componente ocupa 100% do container.", "Component occupies 100% of container."), "maximize"),
        new(L.Text("Responsivo", "Responsive"), L.Text("Grid de resultado responsivo em mobile.", "Responsive result grid on mobile."), "mobile-screen")
    ];

    // === PERFORMANCE ===
    private IReadOnlyList<DocTile> PerformanceItems => [
        new(L.Text("Parse interno", "Internal parse"), L.Text("JSON parsing com System.Text.Json.", "JSON parsing with System.Text.Json."), "bolt"),
        new(L.Text("Cancellation", "Cancellation"), L.Text("CancellationTokenSource para cancelar analise.", "CancellationTokenSource to cancel analysis."), "xmark")
    ];

    // === SCENARIOS ===
    private IReadOnlyList<DocTile> ScenarioItems => [
        new(L.Text("Auditoria SPED", "SPED audit"), L.Text("Validacao de notas para entrega ao SPED.", "Invoice validation for SPED submission."), "file-invoice"),
        new(L.Text("Compliance CBS/IBS", "CBS/IBS compliance"), L.Text("Verificacao de impacto da reforma tributaria.", "Tax reform impact verification."), "shield-check"),
        new(L.Text("Risco fiscal", "Fiscal risk"), L.Text("Deteccao de inconsistencias criticas em lote.", "Critical inconsistency detection in batch."), "triangle-exclamation")
    ];

    // === COMPOSITION ===
    private IReadOnlyList<DocTile> CompositionItems => [
        new(L.Text("NFe + XFCard", "NFe + XFCard"), L.Text("Envolver em XFCard para contexto.", "Wrap in XFCard for context."), "square"),
        new(L.Text("NFe + XFGrid", "NFe + XFGrid"), L.Text("Grid de analises multiplos.", "Multiple analysis grid."), "table-cells"),
        new(L.Text("NFe + Dashboard", "NFe + Dashboard"), L.Text("Integrar com XFDashboardInsight.", "Integrate with XFDashboardInsight."), "chart-line")
    ];

    // === BEST PRACTICES ===
    private IReadOnlyList<DocTile> BestPracticeItems => [
        new(L.Text("Provider obrigatorio", "Required provider"), L.Text("Sempre injetar IAiProvider para funcionalidade.", "Always inject IAiProvider for functionality."), "gear"),
        new(L.Text("Custom prompt com cautela", "Custom prompt with care"), L.Text("Prompt customizado deve manter formato JSON.", "Custom prompt must maintain JSON format."), "text-input"),
        new(L.Text("Tratar OnError", "Handle OnError"), L.Text("Sempre tratar erros de IA para UX.", "Always handle AI errors for UX."), "circle-exclamation"),
        new(L.Text("Loading externo", "External loading"), L.Text("Usar Loading para controlar estado.", "Use Loading to control state."), "spinner")
    ];

    // === ANTI-PATTERNS ===
    private IReadOnlyList<DocTile> AntiPatternItems => [
        new(L.Text("Sem Provider", "Without Provider"), L.Text("Componente nao funciona sem IAiProvider.", "Component does not work without IAiProvider."), "xmark"),
        new(L.Text("Prompt gigante", "Huge prompt"), L.Text("Prompts muito longos aumentam latencia.", "Very long prompts increase latency."), "ban"),
        new(L.Text("Sem tratamento de erro", "No error handling"), L.Text("Erros de IA ficam silenciosos.", "AI errors go silent."), "triangle-exclamation")
    ];

    // === TOKENS ===
    private IReadOnlyList<NameValueRow> TokenRows => [
