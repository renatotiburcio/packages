@page "/ai/lazy-component"
@inject XForgeDocsLanguageService L

<XForgeDocsShell ProductLabel="AI Commercial"
                 Title="XFAiLazyComponent"
                 Status="@L.Text("Estavel", "Stable")"
                 Items="XForgeDocsCatalog.AiItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFAiLazyComponent" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Lazy load", "Lazy load")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Retry e timeout", "Retry and timeout")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Carregamento sob demanda com progresso, retry, timeout e estados de erro.",
                               "On-demand loading with progress, retry, timeout and error states.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("Wrapper lazy-load para componentes pesados. Atrasa renderizacao ate ser acionado, com barra de progresso, retry automatico, timeout configuravel e estados visuais. Puro Blazor, sem JavaScript interop.",
                               "Lazy-load wrapper for heavy components. Defers rendering until triggered, with progress bar, automatic retry, configurable timeout and visual states. Pure Blazor, no JavaScript interop.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico.", "Renders as static HTML.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Lazy load basico", "1. Basic Lazy Load"), T("Componente com carregamento sob demanda e progresso.", "Component with on-demand loading and progress."), ExBasicLazy(), Code1)
            @Example(T("2. Auto load com delay", "2. Auto Load with Delay"), T("Carregamento automatico apos 2 segundos de delay.", "Automatic loading after 2 seconds delay."), ExAutoLoad(), Code2)
            @Example(T("3. Com retry e timeout", "3. With Retry and Timeout"), T("Configuracao com retry maximo e timeout de 10s.", "Configuration with max retry and 10s timeout."), ExRetryConfig(), Code3)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>

<XForgeDocsPageStandard ComponentName="LazyComponentDocs" />

@code {
    private string T(string pt, string en) => L.Text(pt, en);

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiLazyComponent Title="Relatorio Fiscal" PlaceholderText="Carregue o relatorio fiscal..." ShowProgress="true" />
    </XFStack>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("Lazy load", "Lazy load"), T("Renderizacao atrasada ate acionamento manual.", "Deferred rendering until manual trigger."), "clock"),
        new(T("Progresso", "Progress"), T("Barra de progresso com percentual durante carregamento.", "Progress bar with percentage during loading."), "bars"),
        new(T("Retry + Timeout", "Retry + Timeout"), T("Retry automatico e timeout configuravel.", "Automatic retry and configurable timeout."), "rotate")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFAiLazyComponent"),
        new("Namespace", "XForge.DesignSystem.Components.AI.Performance"),
        new("Package", "XForge.DesignSystem.AI"),
        new("Category", "AI / Performance"),
        new("Status", T("Estavel", "Stable")),
        new("Accessibility", "aria-label, aria-busy, role=status"),
        new("Theme support", T("Light, dark e data-brand via tokens.", "Light, dark and data-brand via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("Lazy load", "Lazy load"), T("Renderiza conteudo apenas quando necessario.", "Renders content only when needed."), "clock"),
        new(T("Progresso", "Progress"), T("Barra visual de progresso com percentual.", "Visual progress bar with percentage."), "bars"),
        new(T("Retry", "Retry"), T("Tentativas automaticas apos falha.", "Automatic attempts after failure."), "rotate")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Componentes pesados", "Heavy components"), T("Atrasar carregamento de graficos, dashboards ou relatorios.", "Delay loading of charts, dashboards or reports."), "chart-bar"),
        new(T("Modulos sob demanda", "On-demand modules"), T("Carregar modulos apenas quando o usuario acessa.", "Load modules only when user accesses them."), "puzzle"),
        new(T("Reducao de carga", "Load reduction"), T("Reduzir tempo inicial de carregamento da pagina.", "Reduce initial page load time."), "feather")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Todos os componentes carregavam na montagem da pagina.", "All components loaded on page mount."), "xmark"),
        new(T("Depois", "After"), T("Componentes pesados carregam sob demanda com feedback visual.", "Heavy components load on-demand with visual feedback."), "check"),
        new(T("Acessibilidade", "Accessibility"), T("aria-busy durante carregamento e aria-label descritivo.", "aria-busy during loading and descriptive aria-label."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Dashboards", "Dashboards"), T("Atrasar carregamento de paineis pesados.", "Delay loading of heavy panels."), "chart-bar"),
        new(T("Relatorios", "Reports"), T("Carregar relatorios PDF ou dados sob demanda.", "Load PDF reports or data on demand."), "file")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Conteudo critico", "Critical content"), T("Nao use para conteudo que o usuario precisa imediatamente.", "Do not use for content user needs immediately."), "exclamation"),
        new(T("Componentes leves", "Light components"), T("Nao use para componentes que ja sao rapidos.", "Do not use for components that are already fast."), "feather")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new(T("Placeholder", "Placeholder"), T("Estado anterior ao carregamento com icone e texto.", "Pre-loading state with icon and text."), "inbox"),
        new(T("Progress", "Progress"), T("Barra de progresso durante carregamento.", "Progress bar during loading."), "bars"),
        new(T("Loaded", "Loaded"), T("Conteudo final apos carregamento concluido.", "Final content after loading complete."), "check"),
        new(T("Error", "Error"), T("Estado de erro com retry disponivel.", "Error state with retry available."), "exclamation")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(T("Feedback visual", "Visual feedback"), T("Usuario sempre sabe o que esta acontecendo.", "User always knows what is happening."), "eye"),
        new(T("Recuperacao", "Recovery"), T("Retry e timeout evitam estados indefinidos.", "Retry and timeout prevent indefinite states."), "rotate"),
        new(T("Simplicidade", "Simplicity"), T("Wrapper transparente que nao afeta o layout.", "Transparent wrapper that does not affect layout."), "minimize")
    ];

    // === EXAMPLES ===
    private RenderFragment ExBasicLazy() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiLazyComponent Title="Relatorio Fiscal" PlaceholderText="Clique para carregar o relatorio..." ShowProgress="true" />
    </XFStack>;

    private RenderFragment ExAutoLoad() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiLazyComponent Title="Dashboard" AutoLoad="true" DelayMs="2000" PlaceholderText="Dashboard sera carregado automaticamente..." ShowProgress="true" />
    </XFStack>;

    private RenderFragment ExRetryConfig() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiLazyComponent Title="Modulo Pesado" TimeoutMs="10000" MaxRetries="3" ShowProgress="true" PlaceholderText="Modulo com retry e timeout configurados..." />
    </XFStack>;

    private const string Code1 = @"<XFAiLazyComponent Title=""Relatorio Fiscal""
                   PlaceholderText=""Clique para carregar o relatorio...""
                   ShowProgress=""true"">
    <ChildContent>
        <!-- Conteudo pesado aqui -->
    </ChildContent>
</XFAiLazyComponent>";

    private const string Code2 = @"<XFAiLazyComponent Title=""Dashboard""
                   AutoLoad=""true""
                   DelayMs=""2000""
                   PlaceholderText=""Dashboard sera carregado automaticamente...""
                   ShowProgress=""true"">
    <ChildContent>
        <!-- Dashboard content -->
    </ChildContent>
</XFAiLazyComponent>";

    private const string Code3 = @"<XFAiLazyComponent Title=""Modulo Pesado""
                   TimeoutMs=""10000""
                   MaxRetries=""3""
                   ShowProgress=""true""
                   PlaceholderText=""Modulo com retry e timeout configurados..."">
    <ChildContent>
        <!-- Heavy module content -->
    </ChildContent>
</XFAiLazyComponent>";

    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("Title", "string", "''", T("Titulo do componente.", "Component title.")),
        new("AriaLabel", "string", "''", T("Label de acessibilidade.", "Accessibility label.")),
        new("ShowHeader", "bool", "true", T("Exibe barra de cabecalho.", "Shows header bar.")),
        new("ShowFooter", "bool", "true", T("Exibe barra de rodape.", "Shows footer bar.")),
        new("PlaceholderText", "string", "''", T("Texto do placeholder antes do carregamento.", "Placeholder text before loading.")),
        new("PlaceholderIcon", "string?", "null", T("Icone do placeholder (emoji ou texto).", "Placeholder icon (emoji or text).")),
        new("LoadingText", "string", "''", T("Texto durante carregamento.", "Text during loading.")),
        new("AutoLoad", "bool", "false", T("Carrega automaticamente no primeiro render.", "Loads automatically on first render.")),
        new("ShowProgress", "bool", "true", T("Exibe barra de progresso.", "Shows progress bar.")),
        new("TimeoutMs", "int", "30000", T("Timeout em milissegundos.", "Timeout in milliseconds.")),
        new("MaxRetries", "int", "3", T("Maximo de tentativas de retry.", "Maximum retry attempts.")),
        new("DelayMs", "int", "0", T("Atraso antes do auto-load (ms).", "Delay before auto-load (ms).")),
        new("ChildContent", "RenderFragment?", "null", T("Conteudo lazy-loaded.", "Lazy-loaded content.")),
        new("LoadedContent", "RenderFragment?", "null", T("Conteudo alternativo apos carregamento.", "Alternative content after loading."))
    ];

    private IReadOnlyList<NameValueRow> EventRows => [
        new("OnLoadStart", T("Dispara quando o carregamento inicia.", "Fires when loading starts.")),
        new("OnLoadComplete", T("Dispara quando o carregamento conclui. Recebe tempo em ms.", "Fires when loading completes. Receives time in ms.")),
        new("OnLoadError", T("Dispara em erro. Recebe string com mensagem.", "Fires on error. Receives string with message."))
    ];

    // === ACCESSIBILITY ===
    private IReadOnlyList<DocTile> AccessibilityItems => [
        new(T("aria-busy", "aria-busy"), T("Indica estado de carregamento para leitores de tela.", "Indicates loading state for screen readers."), "spinner"),
        new(T("aria-label", "aria-label"), T("Label descritivo do componente.", "Descriptive component label."), "tag"),
        new(T("role=status", "role=status"), T("Placeholder e progresso anunciam mudancas.", "Placeholder and progress announce changes."), "volume-high"),
        new(T("Feedback sonoro", "Audio feedback"), T("OnLoadComplete e OnLoadError para feedback nao visual.", "OnLoadComplete and OnLoadError for non-visual feedback."), "bell")
    ];

    private IReadOnlyList<NameValueRow> KeyboardRows => [
        new("Enter", T("Ativa o carregamento se nao estiver automatico.", "Triggers loading if not automatic.")),
        new("Escape", T("Cancela o carregamento em andamento.", "Cancels loading in progress."))
    ];

    // === RESPONSIVENESS ===
    private IReadOnlyList<DocTile> ResponsivenessItems => [
        new(T("Largura total", "Full width"), T("Container ocupa 100% do wrapper.", "Container occupies 100% of wrapper."), "maximize"),
        new(T("Responsivo", "Responsive"), T("Layout se adapta a diferentes tamanhos de tela.", "Layout adapts to different screen sizes."), "mobile-screen")
    ];

    // === PERFORMANCE ===
    private IReadOnlyList<DocTile> PerformanceItems => [
        new(T("Reducao de carga", "Load reduction"), T("Componente so renderiza quando acionado.", "Component only renders when triggered."), "feather"),
        new(T("Zero JS", "Zero JS"), T("Nenhum JavaScript interop.", "No JavaScript interop."), "bolt"),
        new(T("Timeout", "Timeout"), T("Evita carregamentos indefinidos.", "Prevents indefinite loads."), "clock")
    ];

    // === SCENARIOS ===
    private IReadOnlyList<DocTile> ScenarioItems => [
        new(T("Dashboard ERP", "ERP dashboard"), T("Painel de indicadores carregado sob demanda.", "Indicator panel loaded on demand."), "chart-bar"),
        new(T("Relatorio fiscal", "Fiscal report"), T("Relatorio PDF carregado sob demanda.", "PDF report loaded on demand."), "file-invoice"),
        new(T("Modulo de IA", "AI module"), T("Modulo de IA pesado carregado apenas quando necessario.", "Heavy AI module loaded only when needed."), "robot")
    ];

    // === COMPOSITION ===
    private IReadOnlyList<DocTile> CompositionItems => [
        new(T("Lazy + Progress", "Lazy + Progress"), T("Barra de progresso durante carregamento.", "Progress bar during loading."), "bars"),
        new(T("Lazy + Retry", "Lazy + Retry"), T("Retry automatico apos falha.", "Automatic retry after failure."), "rotate"),
        new(T("Lazy + Timeout", "Lazy + Timeout"), T("Timeout configuravel para evitar espera infinita.", "Configurable timeout to prevent infinite wait."), "clock")
    ];

    // === BEST PRACTICES ===
    private IReadOnlyList<DocTile> BestPracticeItems => [
        new(T("Timeout adequado", "Adequate timeout"), T("Defina um timeout que equilibre espera e responsividade.", "Set a timeout balancing wait and responsiveness."), "clock"),
        new(T("Retry limitado", "Limited retry"), T("MaxRetries entre 1-5 para evitar ciclos infinitos.", "MaxRetries between 1-5 to avoid infinite loops."), "rotate"),
        new(T("Feedback visual", "Visual feedback"), T("Sempre mostre progresso ou placeholder.", "Always show progress or placeholder."), "eye"),
        new(T("AutoLoad quando util", "AutoLoad when useful"), T("Use para conteudo esperado, nao para sobrecarregar.", "Use for expected content, not to overload."), "clock")
    ];

    // === ANTI-PATTERNS ===
    private IReadOnlyList<DocTile> AntiPatternItems => [
        new(T("Sem progresso", "No progress"), T("Carregamento sem feedback visual e confuso.", "Loading without visual feedback is confusing."), "xmark"),
        new(T("Timeout muito curto", "Timeout too short"), T("Timeout < 1s pode causar falhas falsas.", "Timeout < 1s may cause false failures."), "ban"),
        new(T("Muitos retries", "Too many retries"), T("MaxRetries > 5 pode causar sobrecarga.", "MaxRetries > 5 may cause overload."), "triangle-exclamation")
    ];

    // === TOKENS ===
    private IReadOnlyList<NameValueRow> TokenRows => [
        new("xf-ai-lazy-component", T("Container principal do lazy load.", "Main lazy load container.")),
        new("border-border-light", T("Borda do container.", "Container border.")),
        new("bg-bg-surface", T("Fundo da superficie.", "Surface background.")),
        new("shadow-sm", T("Sombra sutil para profundidade.", "Subtle shadow for depth."))
    ];

    // === THEMING ===
    private IReadOnlyList<DocTile> ThemeItems => [
        new("data-theme", T("Tokens light/dark via CSS variables.", "Light/dark tokens via CSS variables."), "moon"),
        new("data-brand", T("Primary acompanha marca ativa.", "Primary follows active brand."), "swatchbook")
    ];

    // === TESTING ===
    private IReadOnlyList<NameValueRow> TestingRows => [
        new("Unit", T("Render, props, load, retry, timeout, error, reset.", "Render, props, load, retry, timeout, error, reset.")),
        new("Accessibility", T("aria-busy, aria-label, role=status.", "aria-busy, aria-label, role=status."))
    ];

    // === LIMITATIONS ===
    private IReadOnlyList<NameValueRow> LimitationRows => [
        new("Timeout", T("Timeout muito curto pode causar falhas falsas.", "Timeout too short may cause false failures.")),
        new("Retry", T("MaxRetries deve ser limitado para evitar ciclos.", "MaxRetries should be limited to prevent loops.")),
        new("Estado", T("Apenas um estado ativo por vez (NotLoaded, Loading, Loaded, Error, Timeout).", "Only one active state at a time (NotLoaded, Loading, Loaded, Error, Timeout)."))
    ];

    // === RELATED ===
    private IReadOnlyList<DocTile> RelatedComponentItems => [
        new("XFAiVirtualScroller", T("Virtualizacao de listas.", "List virtualization."), "arrows-up-down"),
        new("XFSkeleton", T("Placeholder de carregamento.", "Loading placeholder."), "square"),
        new("XFProgress", T("Barra de progresso standalone.", "Standalone progress bar."), "bars")
    ];

    // === FAQ ===
    private IReadOnlyList<NameValueRow> FaqRows => [
        new(T("Manual vs AutoLoad?", "Manual vs AutoLoad?"), T("Manual: usuario clica para carregar. AutoLoad: carrega automaticamente.", "Manual: user clicks to load. AutoLoad: loads automatically.")),
        new(T("Como resetar?", "How to reset?"), T("Chame Reset() via Reference para voltar ao estado inicial.", "Call Reset() via Reference to return to initial state.")),
        new(T("Precisa de JS interop?", "Needs JS interop?"), T("Nao. Puro Blazor com estados gerenciados internamente.", "No. Pure Blazor with internally managed states."))
    ];

    // === CHANGELOG ===
    private IReadOnlyList<NameValueRow> ChangelogRows => [
        new("2026-06-01", T("Componente criado com lazy load, progresso, retry e timeout.", "Component created with lazy load, progress, retry and timeout.")),
        new("2026-06-12", T("Documentacao completa no padrao AppShellDocs com 3 exemplos.", "Full documentation in AppShellDocs pattern with 3 examples."))
    ];

    // === HELPERS ===
    private RenderFragment Section(string title, RenderFragment content) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
        <Header><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography></Header>
        <ChildContent>@content</ChildContent>
    </XFCard>;

    private RenderFragment Example(string title, string description, RenderFragment preview, string codeText) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.None" AreaRestricted="false">
        <Header><div class="px-6 pt-6 pb-2">
            <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@description</XFTypography>
        </div></Header>
        <ChildContent><div class="flex flex-col">
            <div class="border-t border-border-light p-6">@preview</div>
            <div class="border-t border-border-light bg-surface-50 p-6">
                <XFCode Text="@codeText" Language="razor" Title="@T("Codigo copiavel", "Copyable code")" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" />
            </div>
        </div></ChildContent>
    </XFCard>;

    private RenderFragment Tile(DocTile item) => @<XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent>
        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <div class="flex items-center gap-4">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-primary/10 bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                <div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div>
            </div>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
        </XFStack>
    </ChildContent></XFCard>;

    private RenderFragment TileGrid(IReadOnlyList<DocTile> items, int columns) => @<XFGrid Cols="1" Md="@Math.Min(columns, 2)" Lg="@columns" Gap="4">@foreach (var item in items) { @Tile(item) }</XFGrid>;

    private RenderFragment WarningGrid(IReadOnlyList<DocTile> items) => @<XFGrid Cols="1" Md="2" Gap="4">@foreach (var item in items) {
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <div class="flex items-center gap-4">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-danger/10 bg-danger/10 text-danger" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                <div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div>
            </div>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
        </XFStack></ChildContent></XFCard>
    }</XFGrid>;

    private RenderFragment NameValueTable(IReadOnlyList<NameValueRow> rows, string nameHeader, string valueHeader) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader><XFTableRow><XFTableCell Header="true">@nameHeader</XFTableCell><XFTableCell Header="true">@valueHeader</XFTableCell></XFTableRow></XFTableHeader>
        <XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Value</XFTableCell></XFTableRow> }</XFTableBody>
    </XFTable>;

    private RenderFragment ApiTable(IReadOnlyList<ApiRow> rows) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Parametro", "Parameter")</XFTableCell><XFTableCell Header="true">Type</XFTableCell><XFTableCell Header="true">Default</XFTableCell><XFTableCell Header="true">@T("Descricao", "Description")</XFTableCell></XFTableRow></XFTableHeader>
        <XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Type</XFTableCell><XFTableCell><XFCode Text="@row.DefaultValue" /></XFTableCell><XFTableCell>@row.Description</XFTableCell></XFTableRow> }</XFTableBody>
    </XFTable>;

    // === RECORDS ===
    private sealed record DocTile(string Title, string Description, string Icon);
    private sealed record NameValueRow(string Name, string Value);
    private sealed record ApiRow(string Name, string Type, string DefaultValue, string Description);
}
