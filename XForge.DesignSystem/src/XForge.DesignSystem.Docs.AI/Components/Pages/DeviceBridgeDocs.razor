@page "/ai/device-bridge"
@inject XForgeDocsLanguageService L

<XForgeDocsShell ProductLabel="AI Commercial"
                 Title="XFDeviceBridge"
                 Status="@L.Text("Estavel", "Stable")"
                 Items="XForgeDocsCatalog.AiItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFDeviceBridge" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Plataforma", "Platform")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Form Factor", "Form Factor")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Ponte entre UI Blazor, capacidades do dispositivo e fluxos assistidos por AI.",
                               "Bridge between Blazor UI, device capabilities and AI-assisted flows.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("Detecta plataforma, fator de forma, recursos nativos e status online do dispositivo, fornecendo contexto para decisoes adaptativas em Web, MAUI e hibridos.",
                               "Detects platform, form factor, native features and device online status, providing context for adaptive decisions in Web, MAUI and hybrids.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Deteccao completa via BreakpointService.", "Full detection via BreakpointService.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Deteccao via navigator.userAgent.", "Detection via navigator.userAgent.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Limitado", "Limited")" /></XFTableCell><XFTableCell>@T("Deteccao pos-render com padrao Web/Desktop.", "Post-render detection with Web/Desktop default.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 3 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Deteccao de plataforma", "1. Platform Detection"), T("Renderiza conteudo condicional baseado na plataforma detectada.", "Renders conditional content based on detected platform."), ExPlatformDetection(), Code1)
            @Example(T("2. Forcar plataforma e fator de forma", "2. Force Platform and Form Factor"), T("Override automatico para testes ou MAUI.", "Automatic override for testing or MAUI."), ExForcePlatform(), Code2)
            @Example(T("3. Status online e features", "3. Online Status and Features"), T("Adaptar UI baseado em conectividade e recursos.", "Adapt UI based on connectivity and features."), ExOnlineFeatures(), Code3)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string T(string pt, string en) => L.Text(pt, en);
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFDeviceBridge>
            <ChildContent>
                @foreach (var p in Enum.GetValues<XFDevicePlatform>())
                {
                    <div class="flex items-center gap-3 rounded-lg border border-border-light bg-surface-50 px-4 py-2 text-sm">
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@p.ToString()" />
                        <span class="text-text-secondary">@p</span>
                    </div>
                }
            </ChildContent>
        </XFDeviceBridge>
    </XFStack>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("6 plataformas", "6 platforms"), T("Web, iOS, Android, Windows, macOS, Linux.", "Web, iOS, Android, Windows, macOS, Linux."), "laptop"),
        new(T("5 fatores de forma", "5 form factors"), T("Phone, Tablet, Desktop, Tv, Watch.", "Phone, Tablet, Desktop, Tv, Watch."), "mobile-screen"),
        new(T("Zero JS", "Zero JS"), T("Nenhum JavaScript interop. Puro C# + Tailwind.", "No JavaScript interop. Pure C# + Tailwind."), "bolt")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFDeviceBridge"),
        new("Namespace", "XForge.DesignSystem.Components.CrossPlatform"),
        new("Package", "XForge.DesignSystem"),
        new("Category", "CrossPlatform / Device"),
        new("Status", T("Estavel", "Stable")),
        new("Accessibility", T("data-platform, data-form-factor para testes e analytics.", "data-platform, data-form-factor for tests and analytics.")),
        new("Theme support", T("Light, dark e data-brand via tokens.", "Light, dark and data-brand via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("Deteccao de plataforma", "Platform detection"), T("Identifica Web, iOS, Android, Windows, macOS e Linux.", "Identifies Web, iOS, Android, Windows, macOS and Linux."), "laptop"),
        new(T("Fator de forma", "Form factor"), T("Phone, Tablet, Desktop, Tv e Watch.", "Phone, Tablet, Desktop, Tv and Watch."), "mobile-screen"),
        new(T("Recursos do dispositivo", "Device features"), T("12 features nativas com status de permissao.", "12 native features with permission status."), "microchip")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Adaptacao de UI", "UI adaptation"), T("Conteudo adaptado por plataforma e fator de forma.", "Content adapted by platform and form factor."), "arrows-maximize"),
        new(T("Habilitar features", "Enable features"), T("Camera, geolocalizacao, biometria, haptics e mais.", "Camera, geolocation, biometrics, haptics and more."), "microchip"),
        new(T("Gestao offline", "Offline management"), T("Deteccao de status online/offline para fallbacks.", "Online/offline status detection for fallbacks."), "wifi")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Codigos duplicados por plataforma e deteccao manual.", "Duplicated code per platform and manual detection."), "xmark"),
        new(T("Depois", "After"), T("Contexto unico via ChildContent render fragment.", "Single context via ChildContent render fragment."), "check"),
        new(T("Flexibilidade", "Flexibility"), T("ForcePlatform para MAUI, auto-deteccao para Web.", "ForcePlatform for MAUI, auto-detection for Web."), "sliders")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Apps hibridos", "Hybrid apps"), T("Blazor Hybrid com MAUI.", "Blazor Hybrid with MAUI."), "code"),
        new(T("Responsive AI", "Responsive AI"), T("Adaptar comportamento de AI por dispositivo.", "Adapt AI behavior by device."), "robot")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("CSS media queries", "CSS media queries"), T("Use CSS breakpoints para layout visual.", "Use CSS breakpoints for visual layout."), "css3"),
        new(T("Deteccao pura JS", "Pure JS detection"), T("Use navigator.userAgent direto se so precisa de CSS.", "Use navigator.userAgent directly if only CSS is needed."), "javascript")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new("ChildContent", T("Render fragment com XFDeviceContext.", "Render fragment with XFDeviceContext."), "puzzle"),
        new("XFDeviceContext", T("Registro com Platform, FormFactor, Features, IsOnline.", "Record with Platform, FormFactor, Features, IsOnline."), "database"),
        new("data-platform", T("Atributo HTML para CSS e analytics.", "HTML attribute for CSS and analytics."), "tag")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(T("Contexto adaptativo", "Adaptive context"), T("Fornece dados para decisoes de UI.", "Provides data for UI decisions."), "arrows-maximize"),
        new(T("Zero overhead", "Zero overhead"), T("Deteccao leve sem JS interop.", "Light detection without JS interop."), "feather"),
        new(T("Override explicito", "Explicit override"), T("ForcePlatform para testes e MAUI.", "ForcePlatform for testing and MAUI."), "sliders")
    ];

    // === EXAMPLES ===
    private RenderFragment ExPlatformDetection() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFDeviceBridge>
            <ChildContent>
                @if (context is not null)
                {
                    <div class="rounded-lg border border-border-light bg-surface-50 p-4 text-sm">
                        <div class="font-semibold mb-2">Plataforma detectada: @context.Platform</div>
                        <div class="text-text-secondary">Fator de forma: @context.FormFactor</div>
                    </div>
                }
            </ChildContent>
        </XFDeviceBridge>
    </XFStack>;

    private RenderFragment ExForcePlatform() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFDeviceBridge ForcePlatform="XFDevicePlatform.Android" ForceFormFactor="XFDeviceFormFactor.Phone">
            <ChildContent>
                @if (context is not null)
                {
                    <div class="rounded-lg border border-border-light bg-surface-50 p-4 text-sm">
                        <div class="font-semibold mb-2">Forcado: @context.Platform / @context.FormFactor</div>
                    </div>
                }
            </ChildContent>
        </XFDeviceBridge>
    </XFStack>;

    private RenderFragment ExOnlineFeatures() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFDeviceBridge>
            <ChildContent>
                @if (context is not null)
                {
                    <div class="grid grid-cols-2 gap-2 text-xs">
                        <div class="rounded border border-border-light p-2 @(context.IsOnline ? "bg-success/10 text-success" : "bg-danger/10 text-danger")">
                            @T("Online: ", "Online: ")@(context.IsOnline ? "Sim" : "Nao")
                        </div>
                        <div class="rounded border border-border-light p-2">
                            @T("Camera: ", "Camera: ")@(context.HasFeature(XFDeviceFeature.Camera) ? "Sim" : "Nao")
                        </div>
                        <div class="rounded border border-border-light p-2">
                            @T("Geoloc: ", "Geoloc: ")@(context.HasFeature(XFDeviceFeature.Geolocation) ? "Sim" : "Nao")
                        </div>
                        <div class="rounded border border-border-light p-2">
                            @T("Haptics: ", "Haptics: ")@(context.HasFeature(XFDeviceFeature.Haptics) ? "Sim" : "Nao")
                        </div>
                    </div>
                }
            </ChildContent>
        </XFDeviceBridge>
    </XFStack>;

    private const string Code1 = @"<XFDeviceBridge>
    <ChildContent>
        @if (context is not null)
        {
            <div>Plataforma: @context.Platform</div>
            <div>Fator de forma: @context.FormFactor</div>
        }
    </ChildContent>
</XFDeviceBridge>";

    private const string Code2 = @"<XFDeviceBridge ForcePlatform=""XFDevicePlatform.Android""
              ForceFormFactor=""XFDeviceFormFactor.Phone"">
    <ChildContent>
        @if (context is not null)
        {
            <div>Forcado: @context.Platform / @context.FormFactor</div>
        }
    </ChildContent>
</XFDeviceBridge>";

    private const string Code3 = @"<XFDeviceBridge>
    <ChildContent>
        @if (context is not null)
        {
            <div>Online: @context.IsOnline</div>
            <div>Camera: @context.HasFeature(XFDeviceFeature.Camera)</div>
            <div>Geoloc: @context.HasFeature(XFDeviceFeature.Geolocation)</div>
        }
    </ChildContent>
</XFDeviceBridge>";

    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("ChildContent", "RenderFragment<XFDeviceContext>?", "null", T("Conteudo com contexto do dispositivo.", "Content with device context.")),
        new("ForcePlatform", "XFDevicePlatform?", "null", T("Forca deteccao de plataforma.", "Forces platform detection.")),
        new("ForceFormFactor", "XFDeviceFormFactor?", "null", T("Forca deteccao de fator de forma.", "Forces form factor detection.")),
        new("OnOnlineStatusChanged", "EventCallback<bool>", "EventCallback", T("Dispara quando status online muda.", "Fires when online status changes.")),
        new("OnPlatformDetected", "EventCallback<XFDevicePlatform>", "EventCallback", T("Dispara quando plataforma e detectada.", "Fires when platform is detected.")),
        new("Class", "string?", "null", T("Classes CSS adicionais.", "Additional CSS classes.")),
        new("Style", "string?", "null", T("Estilos inline.", "Inline styles."))
    ];

    private IReadOnlyList<NameValueRow> EventRows => [
        new("OnOnlineStatusChanged", T("Dispara quando status online/offline muda. Recebe bool.", "Fires when online/offline status changes. Receives bool.")),
        new("OnPlatformDetected", T("Dispara quando plataforma e detectada. Recebe XFDevicePlatform.", "Fires when platform is detected. Receives XFDevicePlatform."))
    ];

    // === ACCESSIBILITY ===
    private IReadOnlyList<DocTile> AccessibilityItems => [
        new(T("data-platform", "data-platform"), T("Atributo HTML para testes automatizados e analytics.", "HTML attribute for automated tests and analytics."), "tag"),
        new(T("data-form-factor", "data-form-factor"), T("Atributo HTML para CSS e testes por fator de forma.", "HTML attribute for CSS and tests by form factor."), "mobile-screen"),
        new(T("Render fragment", "Render fragment"), T("Acesso programatico a XFDeviceContext via ChildContent.", "Programmatic access to XFDeviceContext via ChildContent."), "puzzle")
    ];

    private IReadOnlyList<NameValueRow> KeyboardRows => [];

    // === RESPONSIVENESS ===
    private IReadOnlyList<DocTile> ResponsivenessItems => [
        new(T("Deteccao automatica", "Auto detection"), T("Detecta plataforma e fator de forma automaticamente.", "Detects platform and form factor automatically."), "arrows-maximize"),
        new(T("Override manual", "Manual override"), T("ForcePlatform e ForceFormFactor para controle total.", "ForcePlatform and ForceFormFactor for full control."), "sliders")
    ];

    // === PERFORMANCE ===
    private IReadOnlyList<DocTile> PerformanceItems => [
        new(T("Zero JS", "Zero JS"), T("Nenhum JavaScript interop.", "No JavaScript interop."), "bolt"),
        new(T("Deteccao leve", "Light detection"), T("Enum lookup e condicoes simples.", "Enum lookup and simple conditions."), "feather")
    ];

    // === SCENARIOS ===
    private IReadOnlyList<DocTile> ScenarioItems => [
        new(T("ERP Mobile", "ERP Mobile"), T("Adaptar telas de ERP para tablets e phones.", "Adapt ERP screens for tablets and phones."), "mobile-screen"),
        new(T("AI Adaptativa", "Adaptive AI"), T("Comportamento de AI por plataforma.", "AI behavior per platform."), "robot"),
        new(T("Hibrido MAUI", "MAUI Hybrid"), T("Bridge entre Blazor e MAUI.", "Bridge between Blazor and MAUI."), "code")
    ];

    // === COMPOSITION ===
    private IReadOnlyList<DocTile> CompositionItems => [
        new(T("Bridge + Responsive", "Bridge + Responsive"), T("Combinar com XFResponsiveContainer.", "Combine with XFResponsiveContainer."), "arrows-maximize"),
        new(T("Bridge + Offline", "Bridge + Offline"), T("Combinar com XFOfflineStorage.", "Combine with XFOfflineStorage."), "wifi"),
        new(T("Bridge + Gesture", "Bridge + Gesture"), T("Combinar com XFGestureHandler.", "Combine with XFGestureHandler."), "hand-pointer")
    ];

    // === BEST PRACTICES ===
    private IReadOnlyList<DocTile> BestPracticeItems => [
        new(T("ForcePlatform em MAUI", "ForcePlatform in MAUI"), T("Defina ForcePlatform em aplicacoes MAUI.", "Set ForcePlatform in MAUI applications."), "code"),
        new(T("Verificar HasFeature", "Check HasFeature"), T("Sempre verifique antes de usar feature nativa.", "Always check before using native feature."), "check"),
        new(T("Fallback graceful", "Graceful fallback"), T("Forneca alternativa quando feature indisponivel.", "Provide alternative when feature unavailable."), "shield")
    ];

    // === ANTI-PATTERNS ===
    private IReadOnlyList<DocTile> AntiPatternItems => [
        new(T("Sem fallback", "No fallback"), T("Nao assuma que features nativas existem.", "Do not assume native features exist."), "xmark"),
        new(T("JS interop desnecessario", "Unnecessary JS interop"), T("Use XFDeviceBridge ao inves de JS manual.", "Use XFDeviceBridge instead of manual JS."), "ban"),
        new(T("Hardcode de plataforma", "Platform hardcoding"), T("Nunca hardcode - use ForcePlatform ou deteccao.", "Never hardcode - use ForcePlatform or detection."), "triangle-exclamation")
    ];

    // === TOKENS ===
    private IReadOnlyList<NameValueRow> TokenRows => [
        new("xf-device-bridge", T("Container principal do bridge.", "Main bridge container.")),
        new("xf-device-online", T("Classe quando online.", "Class when online.")),
        new("xf-device-offline", T("Classe quando offline.", "Class when offline.")),
        new("data-platform", T("Atributo com plataforma detectada.", "Attribute with detected platform.")),
        new("data-form-factor", T("Atributo com fator de forma.", "Attribute with form factor."))
    ];

    // === THEMING ===
    private IReadOnlyList<DocTile> ThemeItems => [
        new("data-theme", T("Tokens light/dark via CSS variables.", "Light/dark tokens via CSS variables."), "moon"),
        new("data-brand", T("Primary acompanha marca ativa.", "Primary follows active brand."), "swatchbook")
    ];

    // === TESTING ===
    private IReadOnlyList<NameValueRow> TestingRows => [
        new("Unit", T("Render, ForcePlatform, ForceFormFactor, HasFeature, SetOnlineStatus.", "Render, ForcePlatform, ForceFormFactor, HasFeature, SetOnlineStatus.")),
        new("Extended", T("Deteccao de todas as 6 plataformas e 5 fatores de forma.", "Detection of all 6 platforms and 5 form factors."))
    ];

    // === LIMITATIONS ===
    private IReadOnlyList<NameValueRow> LimitationRows => [
        new("Deteccao Web", T("Em Web, sempre detecta como Web/Desktop por padrao.", "In Web, always detects as Web/Desktop by default.")),
        new("Biometria", T("Requer MAUI ou WebAuthn para biometria real.", "Requires MAUI or WebAuthn for real biometrics.")),
        new("Static SSR", T("Deteccao completa so apos render no cliente.", "Full detection only after client render."))
    ];

    // === RELATED ===
    private IReadOnlyList<DocTile> RelatedComponentItems => [
        new("XFResponsiveContainer", T("Deteccao de breakpoint responsivo.", "Responsive breakpoint detection."), "arrows-maximize"),
        new("XFGestureHandler", T("Captura de gestos touch.", "Touch gesture capture."), "hand-pointer"),
        new("XFOfflineStorage", T("Persistencia offline com sync.", "Offline persistence with sync."), "database")
    ];

    // === FAQ ===
    private IReadOnlyList<NameValueRow> FaqRows => [
        new(T("Precisa de JS?", "Needs JS?"), T("Nao. Deteccao e puramente C# com enumeracoes.", "No. Detection is purely C# with enumerations.")),
        new(T("Funciona no MAUI?", "Works on MAUI?"), T("Sim. Use ForcePlatform para sobrescrever deteccao.", "Yes. Use ForcePlatform to override detection.")),
        new(T("Como testar?", "How to test?"), T("Use ForcePlatform e ForceFormFactor para simular.", "Use ForcePlatform and ForceFormFactor to simulate."))
    ];

    // === CHANGELOG ===
    private IReadOnlyList<NameValueRow> ChangelogRows => [
        new("2026-06-03", T("Componente criado com deteccao de plataforma e fator de forma.", "Component created with platform and form factor detection.")),
        new("2026-06-12", T("Documentacao completa no padrao AppShellDocs com 3 exemplos.", "Full documentation in AppShellDocs pattern with 3 examples."))
    ];

    // === HELPERS ===
    private RenderFragment Section(string title, RenderFragment content) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
        <Header><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography></Header>
        <ChildContent>@content</ChildContent>
    </XFCard>;

    private RenderFragment Example(string title, string description, RenderFragment preview, string codeText) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.None" AreaRestricted="false">
        <Header><div class="px-6 pt-6 pb-2">
            <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@description</XFTypography>
        </div></Header>
        <ChildContent><div class="flex flex-col">
            <div class="border-t border-border-light p-6">@preview</div>
            <div class="border-t border-border-light bg-surface-50 p-6">
                <XFCode Text="@codeText" Language="razor" Title="@CopyableCodeTitle" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" />
            </div>
        </div></ChildContent>
    </XFCard>;

    private RenderFragment Tile(DocTile item) => @<XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent>
        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <div class="flex items-center gap-4">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-primary/10 bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                <div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div>
            </div>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
        </XFStack>
    </ChildContent></XFCard>;

    private RenderFragment TileGrid(IReadOnlyList<DocTile> items, int columns) => @<XFGrid Cols="1" Md="@Math.Min(columns, 2)" Lg="@columns" Gap="4">@foreach (var item in items) { @Tile(item) }</XFGrid>;

    private RenderFragment WarningGrid(IReadOnlyList<DocTile> items) => @<XFGrid Cols="1" Md="2" Gap="4">@foreach (var item in items) {
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <div class="flex items-center gap-4">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-danger/10 bg-danger/10 text-danger" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                <div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div>
            </div>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
        </XFStack></ChildContent></XFCard>
    }</XFGrid>;

    private RenderFragment NameValueTable(IReadOnlyList<NameValueRow> rows, string nameHeader, string valueHeader) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader><XFTableRow><XFTableCell Header="true">@nameHeader</XFTableCell><XFTableCell Header="true">@valueHeader</XFTableCell></XFTableRow></XFTableHeader>
        <XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Value</XFTableCell></XFTableRow> }</XFTableBody>
    </XFTable>;

    private RenderFragment ApiTable(IReadOnlyList<ApiRow> rows) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Parametro", "Parameter")</XFTableCell><XFTableCell Header="true">Type</XFTableCell><XFTableCell Header="true">Default</XFTableCell><XFTableCell Header="true">@T("Descricao", "Description")</XFTableCell></XFTableRow></XFTableHeader>
        <XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Type</XFTableCell><XFTableCell><XFCode Text="@row.DefaultValue" /></XFTableCell><XFTableCell>@row.Description</XFTableCell></XFTableRow> }</XFTableBody>
    </XFTable>;

    // === RECORDS ===
    private sealed record DocTile(string Title, string Description, string Icon);
    private sealed record NameValueRow(string Name, string Value);
    private sealed record ApiRow(string Name, string Type, string DefaultValue, string Description);
}
