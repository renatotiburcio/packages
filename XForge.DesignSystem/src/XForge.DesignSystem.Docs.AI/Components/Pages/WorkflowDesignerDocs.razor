    private static readonly IReadOnlyList<XFAiWfConnection> DemoConnections = [
        new() { Id = "c1", SourceNodeId = "start", TargetNodeId = "ai", IsActive = true },
        new() { Id = "c2", SourceNodeId = "ai", TargetNodeId = "approval", Label = "score > 80" },
        new() { Id = "c3", SourceNodeId = "approval", TargetNodeId = "end" }
    ];

    private static readonly IReadOnlyList<XFAiWfNode> MultiBranchNodes = [
        new() { Id = "start", Label = "Inicio", Type = XFAiWfNodeType.Start, X = 30, Y = 120 },
        new() { Id = "ai", Label = "Analise IA", Type = XFAiWfNodeType.AiProcessor, X = 220, Y = 120 },
        new() { Id = "rule", Label = "Regra", Type = XFAiWfNodeType.Rule, X = 420, Y = 60 },
        new() { Id = "approval", Label = "Aprovacao", Type = XFAiWfNodeType.Approval, X = 420, Y = 200 },
        new() { Id = "end", Label = "Fim", Type = XFAiWfNodeType.End, X = 640, Y = 120 }
    ];

    private static readonly IReadOnlyList<XFAiWfConnection> MultiBranchConnections = [
        new() { Id = "c1", SourceNodeId = "start", TargetNodeId = "ai", IsActive = true },
        new() { Id = "c2", SourceNodeId = "ai", TargetNodeId = "rule", Label = "automatico", IsActive = true },
        new() { Id = "c3", SourceNodeId = "ai", TargetNodeId = "approval", Label = "manual" },
        new() { Id = "c4", SourceNodeId = "rule", TargetNodeId = "end", IsActive = true },
        new() { Id = "c5", SourceNodeId = "approval", TargetNodeId = "end" }
    ];

    private static readonly IReadOnlyList<XFAiWfNode> VariedStatusNodes = [
        new() { Id = "s1", Label = "Inicio", Type = XFAiWfNodeType.Start, X = 30, Y = 80, IsCompleted = true },
        new() { Id = "s2", Label = "Processando", Type = XFAiWfNodeType.AiProcessor, X = 240, Y = 80, IsActive = true },
        new() { Id = "s3", Label = "Aguardando", Type = XFAiWfNodeType.Approval, X = 450, Y = 80 },
        new() { Id = "s4", Label = "Desabilitado", Type = XFAiWfNodeType.HttpCall, X = 660, Y = 80, IsDisabled = true }
    ];

    private static readonly IReadOnlyList<XFAiWfConnection> VariedStatusConnections = [
        new() { Id = "sc1", SourceNodeId = "s1", TargetNodeId = "s2", IsActive = true },
        new() { Id = "sc2", SourceNodeId = "s2", TargetNodeId = "s3" },
        new() { Id = "sc3", SourceNodeId = "s3", TargetNodeId = "s4" }
    ];

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFAiWorkflowDesigner Nodes="DemoNodes"
                                                                  Connections="DemoConnections"
                                                                  Title="@L.Text("Aprovacao de compras", "Purchase approval")"
                                                                  ShowPalette="true" />;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(L.Text("15 tipos de nos", "15 node types"), L.Text("Start, End, AiProcessor, Rule, Approval, Trigger e mais.", "Start, End, AiProcessor, Rule, Approval, Trigger and more."), "diagram-project"),
        new(L.Text("Conexoes Bezier", "Bezier connections"), L.Text("SVG com Bezier curves e cores semanticas.", "SVG with Bezier curves and semantic colors."), "bezier-curve"),
        new(L.Text("Zoom in/out", "Zoom in/out"), L.Text("Controle de zoom com reset para 100%.", "Zoom control with reset to 100%."), "magnifying-glass-plus")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFAiWorkflowDesigner"),
        new("Namespace", "XForge.DesignSystem.Components.AI.Workflow"),
        new("Package", "XForge.DesignSystem.AI"),
        new("Category", "AI / Workflow"),
        new("Status", L.Text("Estavel", "Stable")),
        new("Accessibility", L.Text("role=region, role=button, role=application, aria-label.", "role=region, role=button, role=application, aria-label.")),
        new("Theme support", L.Text("Light, dark e data-brand via tokens.", "Light, dark and data-brand via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(L.Text("Designer visual", "Visual designer"), L.Text("Canvas interativo com nos arrastaveis e conexoes SVG.", "Interactive canvas with draggable nodes and SVG connections."), "diagram-project"),
        new(L.Text("15 tipos de nos", "15 node types"), L.Text("Start, End, AiProcessor, Rule, Approval, Trigger, Event, Schedule.", "Start, End, AiProcessor, Rule, Approval, Trigger, Event, Schedule."), "sitemap"),
        new(L.Text("Zoom e paleta", "Zoom and palette"), L.Text("Zoom 30%-200%, paleta de arrastar.", "Zoom 30%-200%, drag palette."), "magnifying-glass-plus")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(L.Text("Orquestracao IA", "AI orchestration"), L.Text("Visualizar e orquestrar fluxos de agentes IA.", "Visualize and orchestrate AI agent flows."), "network-wired"),
        new(L.Text("Aprovacoes", "Approvals"), L.Text("Workflows com nos de aprovacao humana.", "Workflows with human approval nodes."), "clipboard-check"),
        new(L.Text("Automacao", "Automation"), L.Text("Fluxos automatizados com triggers e agendamentos.", "Automated flows with triggers and schedules."), "bolt")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(L.Text("Antes", "Before"), L.Text("Fluxos de IA sem visualizacao.", "AI flows without visualization."), "xmark"),
        new(L.Text("Depois", "After"), L.Text("Canvas visual com nos coloridos e conexoes.", "Visual canvas with colored nodes and connections."), "check"),
        new(L.Text("Acessibilidade", "Accessibility"), L.Text("role=button, role=application, aria-label para todos os nos.", "role=button, role=application, aria-label for all nodes."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(L.Text("Pipelines de IA", "AI pipelines"), L.Text("Visualizar fluxos de processamento.", "Visualize processing flows."), "diagram-project"),
        new(L.Text("Workflows de aprovacao", "Approval workflows"), L.Text("Fluxos com decisao humana.", "Flows with human decision."), "clipboard-check")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(L.Text("Diagramas estaticos", "Static diagrams"), L.Text("Use imagens ou SVGs estaticos.", "Use static images or SVGs."), "image"),
        new(L.Text("Fluxos simples", "Simple flows"), L.Text("Use XFSteps para sequencias lineares.", "Use XFSteps for linear sequences."), "list-ol")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new("Header", L.Text("Titulo, contagem de nos/arestas e botoes de zoom.", "Title, node/edge count and zoom buttons."), "heading"),
        new("Palette", L.Text("Paleta de tipos de nos arrastraveis.", "Draggable node type palette."), "palette"),
        new("Canvas", L.Text("Area de trabalho com SVG e nos posicionados.", "Workspace with SVG and positioned nodes."), "maximize"),
        new("SVG Connections", L.Text("Conexoes Bezier entre nos com cores semanticas.", "Bezier connections between nodes with semantic colors."), "bezier-curve"),
        new("Node Cards", L.Text("Cards coloridos com icone, label, descricao e status.", "Colored cards with icon, label, description and status."), "square")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(L.Text("Cor = tipo", "Color = type"), L.Text("Cada tipo de no tem cor unica e semantica.", "Each node type has a unique semantic color."), "palette"),
        new(L.Text("Status visual", "Visual status"), L.Text("Ativo = pulsante, Completo = check, Desabilitado = opaco.", "Active = pulsing, Completed = check, Disabled = opaque."), "eye"),
        new(L.Text("Zoom fluido", "Fluid zoom"), L.Text("Zoom 30%-200% com transform CSS.", "Zoom 30%-200% with CSS transform."), "magnifying-glass-plus")
    ];

    // === EXAMPLES ===
    private RenderFragment ExBasic() => @<XFAiWorkflowDesigner Nodes="DemoNodes"
                                                              Connections="DemoConnections"
                                                              Title="@L.Text("Workflow Basico", "Basic Workflow")"
                                                              ShowPalette="false" />;

    private RenderFragment ExWithPalette() => @<XFAiWorkflowDesigner Nodes="DemoNodes"
                                                                   Connections="DemoConnections"
                                                                   Title="@L.Text("Com Paleta", "With Palette")"
                                                                   ShowPalette="true" />;

    private RenderFragment ExNoPalette() => @<XFAiWorkflowDesigner Nodes="DemoNodes"
                                                                 Connections="DemoConnections"
                                                                 Title="@L.Text("Sem Paleta", "Without Palette")"
                                                                 ShowPalette="false"
                                                                 ShowHeader="false" />;

    private RenderFragment ExMultiBranch() => @<XFAiWorkflowDesigner Nodes="MultiBranchNodes"
                                                                     Connections="MultiBranchConnections"
                                                                     Title="Ramo Multi-branch"
                                                                     ShowPalette="false" />;

    private RenderFragment ExVariedStatus() => @<XFAiWorkflowDesigner Nodes="VariedStatusNodes"
                                                                     Connections="VariedStatusConnections"
                                                                     Title="Status Variados"
                                                                     ShowPalette="false" />;

    private RenderFragment ExCustomCanvas() => @<XFAiWorkflowDesigner Nodes="DemoNodes"
                                                                    Connections="DemoConnections"
                                                                    Title="@L.Text("Canvas Grande", "Large Canvas")"
                                                                    CanvasWidth="1200"
                                                                    CanvasHeight="600"
                                                                    ShowPalette="false" />;

    private const string Code1 = @"<XFAiWorkflowDesigner Nodes=""@Nodes"" Connections=""@Connections""
                              Title=""Workflow Basico""
                              ShowPalette=""false"" />";
    private const string Code2 = @"<XFAiWorkflowDesigner Nodes=""@Nodes"" Connections=""@Connections""
                              Title=""Com Paleta""
                              ShowPalette=""true"" />";
    private const string Code3 = @"<XFAiWorkflowDesigner Nodes=""@Nodes"" Connections=""@Connections""
                              Title=""Sem Paleta""
                              ShowPalette=""false""
                              ShowHeader=""false"" />";
    private const string Code4 = @"<XFAiWorkflowDesigner Nodes=""@Nodes"" Connections=""@Connections""
                              Title=""Ramo Multi-branch""
                              ShowPalette=""false"" />";
    private const string Code5 = @"<XFAiWorkflowDesigner Nodes=""@Nodes"" Connections=""@Connections""
                              Title=""Status Variados""
                              ShowPalette=""false"" />";
    private const string Code6 = @"<XFAiWorkflowDesigner Nodes=""@Nodes"" Connections=""@Connections""
                              Title=""Canvas Grande""
                              CanvasWidth=""1200""
                              CanvasHeight=""600""
                              ShowPalette=""false"" />";

    // === API ===
