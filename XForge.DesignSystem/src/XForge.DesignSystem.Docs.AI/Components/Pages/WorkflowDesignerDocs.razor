        new("Nodes", "IReadOnlyList<XFAiWfNode>", "[]", L.Text("Nos do workflow no canvas.", "Workflow nodes on canvas.")),
        new("Connections", "IReadOnlyList<XFAiWfConnection>", "[]", L.Text("Conexoes entre nos.", "Connections between nodes.")),
        new("Title", "string", "\"Workflow Designer\"", L.Text("Titulo do designer.", "Designer title.")),
