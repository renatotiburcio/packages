        new("CanvasWidth", "int", "900", L.Text("Largura do canvas em pixels.", "Canvas width in pixels.")),
        new("CanvasHeight", "int", "500", L.Text("Altura do canvas em pixels.", "Canvas height in pixels.")),
        new("EmptyText", "string", "\"Arraste nos da paleta...\"", L.Text("Texto de estado vazio.", "Empty state text."))
