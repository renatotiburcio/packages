@page "/ai/providers"
@using XForge.DesignSystem.Services.AI
@inject XForgeDocsLanguageService L

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.AiItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFAiProviderConfig" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="IAiProvider" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Configuracao multi-provider", "Multi-provider config")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Configuracao de provedores AI com selecao de provider, modelo e status de conexao.",
                               "AI provider configuration with provider selection, model selection and connection status.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("Componente comercial para configurar provedores de IA (Ollama, OpenAI, Azure, Anthropic, Gemini). Inclui selecao de provider, modelo, exibicao de capacidades e status de conexao.",
                               "Commercial component for configuring AI providers (Ollama, OpenAI, Azure, Anthropic, Gemini). Includes provider selection, model display, capabilities and connection status.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Requer IAiProvider injetado via DI.", "Requires IAiProvider injected via DI.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Requer IAiProvider injetado via DI.", "Requires IAiProvider injected via DI.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Parcial", "Partial")" /></XFTableCell><XFTableCell>@T("Renderiza UI mas sem chamadas de provider.", "Renders UI but no provider calls.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Dependencias", "Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Requer IAiProvider injetado via DI (IEnumerable<IAiProvider>). Renderizado com C# e Tailwind CSS. Sem JavaScript interop.", "Requires IAiProvider injected via DI (IEnumerable<IAiProvider>). Rendered with C# and Tailwind CSS. No JavaScript interop.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 3 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Basico", "1. Basic"), T("Configuracao completa com header, seletores e capacidades.", "Full configuration with header, selectors and capabilities."), ExBasic(), Code1)
            @Example(T("2. Sem header", "2. No header"), T("Apenas seletores de provider e modelo.", "Provider and model selectors only."), ExNoHeader(), Code2)
            @Example(T("3. Com ChildContent", "3. With ChildContent"), T("Conteudo customizado abaixo da configuracao.", "Custom content below the configuration."), ExWithChildContent(), Code3)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>

        <XForgeDocsPageStandard ComponentName="ProvidersDocs" />
    </XFStack>
</XForgeDocsShell>
@code {
    private string ProductLabelText => T("AI Commercial", "AI Commercial");
    private string PageTitleText => T("XFAiProviderConfig", "XFAiProviderConfig");
    private string PageStatusText => T("Documentacao completa", "Complete docs");
    private string T(string pt, string en) => L.Text(pt, en);
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");

    // === HERO ===
    private RenderFragment HeroPreview() => @<div class="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 shadow-sm overflow-hidden">
        <div class="flex items-center justify-between px-4 py-3 border-b border-gray-200 dark:border-gray-700">
            <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <h3 class="text-sm font-semibold text-gray-900 dark:text-gray-100">Provider IA</h3>
            </div>
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400">
                Conectado (Ollama)
            </span>
        </div>
        <div class="p-4 space-y-4">
            <div>
                <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Provider</label>
                <div class="w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-900 dark:text-gray-100">Ollama</div>
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">Modelo</label>
                <div class="w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-900 dark:text-gray-100">llama3:8b</div>
            </div>
            <div class="flex flex-wrap gap-2">
                <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full text-xs bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400">Streaming</span>
                <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full text-xs bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400">Tool Calling</span>
                <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full text-xs bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-400">ID: ollama</span>
            </div>
        </div>
    </div>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("Multi-provider", "Multi-provider"), T("Ollama, OpenAI, Azure, Anthropic, Gemini e mais.", "Ollama, OpenAI, Azure, Anthropic, Gemini and more."), "arrows-rotate"),
        new(T("Capacidades", "Capabilities"), T("Streaming, Tool Calling e lista de modelos.", "Streaming, Tool Calling and model list."), "bolt"),
        new(T("Status de conexao", "Connection status"), T("Badge verde quando conectado, cinza quando desconectado.", "Green badge when connected, gray when disconnected."), "circle-check")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFAiProviderConfig"),
        new("Namespace", "XForge.DesignSystem.Components.AI.Common"),
        new("Package", "XForge.DesignSystem.AI"),
        new("Category", "AI / Common"),
        new("Interface", "IAiProvider"),
        new("Status", T("Estavel", "Stable")),
        new("Accessibility", T("aria-label nos selects, label descritivo.", "aria-label on selects, descriptive label.")),
        new("Theme support", T("Light, dark e data-theme via tokens.", "Light, dark and data-theme via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("Configuracao de provider", "Provider config"), T("Selecione e configure provedores de IA.", "Select and configure AI providers."), "gear"),
        new(T("Selecao de modelo", "Model selection"), T("Lista modelos disponiveis por provider.", "Lists models available per provider."), "list"),
        new(T("Status de conexao", "Connection status"), T("Badge com status de conexao em tempo real.", "Badge with real-time connection status."), "circle-check")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Setup inicial", "Initial setup"), T("Configurar provider de IA no primeiro acesso.", "Configure AI provider on first access."), "rocket"),
        new(T("Troca de provider", "Provider switching"), T("Alternar entre providers sem restart.", "Switch between providers without restart."), "arrows-rotate"),
        new(T("Diagnostico", "Diagnostics"), T("Verificar capacidades e status de conexao.", "Verify capabilities and connection status."), "magnifying-glass")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Configuracao de provider hardcoded no codigo.", "Provider configuration hardcoded in code."), "xmark"),
        new(T("Depois", "After"), T("Configuracao dinamica com UI amigavel.", "Dynamic configuration with friendly UI."), "check"),
        new(T("Acessibilidade", "Accessibility"), T("Labels descritivos, aria-label nos selects.", "Descriptive labels, aria-label on selects."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Multi-provider", "Multi-provider"), T("Apps que suportam multiplos provedores.", "Apps that support multiple providers."), "arrows-rotate"),
        new(T("Diagnostico", "Diagnostics"), T("Verificar se o provider esta funcional.", "Verify if provider is functional."), "magnifying-glass")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Provider unico", "Single provider"), T("Se so usa um provider, configure direto no DI.", "If using only one provider, configure directly in DI."), "ban"),
        new(T("Producao sem DI", "Production without DI"), T("Nao hardcode provider em apps de producao.", "Do not hardcode provider in production apps."), "triangle-exclamation")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new("Header", T("Cabecalho com titulo e badge de status.", "Header with title and status badge."), "heading"),
        new("ProviderSelect", T("Dropdown de selecao de provider.", "Provider selection dropdown."), "arrows-rotate"),
        new("ModelSelect", T("Dropdown de selecao de modelo.", "Model selection dropdown."), "list"),
        new("Capabilities", T("Badges de capacidades (Streaming, Tool Calling).", "Capability badges (Streaming, Tool Calling)."), "bolt"),
        new("StatusBadge", T("Badge de status de conexao.", "Connection status badge."), "circle-check")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(T("DI-first", "DI-first"), T("Providers injetados via IEnumerable<IAiProvider>.", "Providers injected via IEnumerable<IAiProvider>."), "plug"),
        new(T("Status visivel", "Visible status"), T("Badge verde/cinza mostra conexao.", "Green/gray badge shows connection."), "circle-check"),
        new(T("Capacidades claras", "Clear capabilities"), T("Badges mostram Streaming e Tool Calling.", "Badges show Streaming and Tool Calling."), "bolt")
    ];

    // === EXAMPLES ===
    private RenderFragment ExBasic() => @<XFAiProviderConfig Title="Configuracao do Provedor IA"
                                                              ShowHeader="true"
                                                              ShowStatus="true"
                                                              ShowCapabilities="true"
                                                              ProviderLabel="Provedor"
                                                              ModelLabel="Modelo" />;

    private RenderFragment ExNoHeader() => @<XFAiProviderConfig ShowHeader="false"
                                                                ShowStatus="false"
                                                                ShowCapabilities="false"
                                                                ProviderLabel="Provider"
                                                                ModelLabel="Model" />;

    private RenderFragment ExWithChildContent() => @<XFAiProviderConfig Title="Selecao de Provider"
                                                                       ShowHeader="true"
                                                                       ShowStatus="true"
                                                                       ShowCapabilities="true">
        <div class="mt-4 rounded-lg border border-border-light bg-surface-50 p-4">
            <p class="text-sm text-text-secondary">Apos selecionar o provider, os modelos serao carregados automaticamente.</p>
        </div>
    </XFAiProviderConfig>;

    private const string Code1 = @"<XFAiProviderConfig Title=""Configuracao do Provedor IA""
                    ShowHeader=""true""
                    ShowStatus=""true""
                    ShowCapabilities=""true""
                    ProviderLabel=""Provedor""
                    ModelLabel=""Modelo"" />";
    private const string Code2 = @"<XFAiProviderConfig ShowHeader=""false""
                    ShowStatus=""false""
                    ShowCapabilities=""false""
                    ProviderLabel=""Provider""
                    ModelLabel=""Model"" />";
    private const string Code3 = @"<XFAiProviderConfig Title=""Selecao de Provider""
                    ShowHeader=""true""
                    ShowStatus=""true""
                    ShowCapabilities=""true"">
    <div class=""mt-4 rounded-lg border border-border-light bg-surface-50 p-4"">
        <p class=""text-sm text-text-secondary"">Apos selecionar o provider, os modelos serao carregados automaticamente.</p>
    </div>
</XFAiProviderConfig>";

    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("Title", "string", "\"Configuracao do Provedor IA\"", T("Titulo do componente.", "Component title.")),
        new("ProviderLabel", "string", "\"Provedor\"", T("Label do seletor de provider.", "Provider selector label.")),
        new("ModelLabel", "string", "\"Modelo\"", T("Label do seletor de modelo.", "Model selector label.")),
        new("ShowHeader", "bool", "true", T("Exibe cabecalho com titulo e status.", "Shows header with title and status.")),
        new("ShowStatus", "bool", "true", T("Exibe badge de status de conexao.", "Shows connection status badge.")),
        new("ShowCapabilities", "bool", "true", T("Exibe badges de capacidades.", "Shows capability badges.")),
        new("HeaderContent", "RenderFragment?", "null", T("Conteudo customizado no cabecalho.", "Custom header content.")),
        new("ChildContent", "RenderFragment?", "null", T("Conteudo abaixo da configuracao.", "Content below configuration.")),
        new("OnProviderChange", "EventCallback<IAiProvider>", "-", T("Disparado quando o provider muda.", "Fired when provider changes.")),
        new("OnModelChange", "EventCallback<string>", "-", T("Disparado quando o modelo muda.", "Fired when model changes.")),
        new("SelectedProviderId", "string", "\"inmemory\"", T("ID do provider selecionado (two-way bindable).", "Selected provider ID (two-way bindable).")),
        new("SelectedModel", "string?", "null", T("Modelo selecionado (two-way bindable).", "Selected model (two-way bindable)."))
    ];

    private IReadOnlyList<NameValueRow> EventRows => [
        new("OnProviderChange", T("Disparado quando o usuario seleciona um provider diferente.", "Fired when user selects a different provider.")),
        new("OnModelChange", T("Disparado quando o usuario seleciona um modelo diferente.", "Fired when user selects a different model."))
    ];

    // === ACCESSIBILITY ===
    private IReadOnlyList<DocTile> AccessibilityItems => [
        new(T("aria-label selects", "aria-label selects"), T("Selects de provider e modelo com aria-label.", "Provider and model selects with aria-label."), "universal-access"),
        new(T("Label descritivo", "Descriptive label"), T("Cada select tem label visivel acima.", "Each select has visible label above."), "tag"),
        new(T("Status badge", "Status badge"), T("Badge com aria-label do status.", "Badge with status aria-label."), "circle-check"),
        new(T("Capacidades", "Capabilities"), T("Badges informativos sem interacao.", "Informational badges without interaction."), "bolt")
    ];

    private IReadOnlyList<NameValueRow> KeyboardRows => [
        new("Tab", T("Navega entre selects e botoes.", "Navigates between selects and buttons.")),
        new("Enter", T("Abre ou confirma selecao no select.", "Opens or confirms selection in select.")),
        new("ArrowDown/Up", T("Navega opcoes do select aberto.", "Navigates options in open select.")),
        new("Escape", T("Fecha select aberto.", "Closes open select."))
    ];

    // === RESPONSIVENESS ===
    private IReadOnlyList<DocTile> ResponsivenessItems => [
        new(T("Largura total", "Full width"), T("Selects ocupam 100% do container.", "Selects occupy 100% of container."), "maximize"),
        new(T("Capacidades wrap", "Capabilities wrap"), T("Badges fazem wrap em telas estreitas.", "Badges wrap on narrow screens."), "mobile-screen")
    ];

    // === PERFORMANCE ===
    private IReadOnlyList<DocTile> PerformanceItems => [
        new(T("Lazy model loading", "Lazy model loading"), T("Modelos carregados apenas apos selecao do provider.", "Models loaded only after provider selection."), "bolt"),
        new(T("Zero JS", "Zero JS"), T("Nenhum JavaScript interop.", "No JavaScript interop."), "feather")
    ];

    // === SCENARIOS ===
    private IReadOnlyList<DocTile> ScenarioItems => [
        new(T("Setup inicial", "Initial setup"), T("Configurar provider de IA no primeiro acesso.", "Configure AI provider on first access."), "rocket"),
        new(T("Multi-provider", "Multi-provider"), T("Alternar entre Ollama e OpenAI conforme necessidade.", "Switch between Ollama and OpenAI as needed."), "arrows-rotate"),
        new(T("Diagnostico", "Diagnostics"), T("Verificar se o provider esta conectado.", "Verify if provider is connected."), "magnifying-glass")
    ];

    // === COMPOSITION ===
    private IReadOnlyList<DocTile> CompositionItems => [
        new(T("ProviderConfig + Chat", "ProviderConfig + Chat"), T("Configurar provider antes de usar o chat.", "Configure provider before using chat."), "comments"),
        new(T("ProviderConfig + PromptBox", "ProviderConfig + PromptBox"), T("Provider configurado alimenta o PromptBox.", "Configured provider feeds PromptBox."), "pen-to-square"),
        new(T("ProviderConfig + Workflow", "ProviderConfig + Workflow"), T("Provider para executar workflows AI.", "Provider to execute AI workflows."), "diagram-project")
    ];

    // === BEST PRACTICES ===
    private IReadOnlyList<DocTile> BestPracticeItems => [
        new(T("DI injection", "DI injection"), T("Registre providers via DI, nao hardcoded.", "Register providers via DI, not hardcoded."), "plug"),
        new(T("ShowStatus", "ShowStatus"), T("Exiba status de conexao para debugging.", "Show connection status for debugging."), "circle-check"),
        new(T("ShowCapabilities", "ShowCapabilities"), T("Capacidades ajudam a escolher o provider certo.", "Capabilities help choose the right provider."), "bolt"),
        new(T("OnProviderChange", "OnProviderChange"), T("Use OnProviderChange para reconfigurar fluxos.", "Use OnProviderChange to reconfigure flows."), "arrows-rotate")
    ];

    // === ANTI-PATTERNS ===
    private IReadOnlyList<DocTile> AntiPatternItems => [
        new(T("Hardcoded provider", "Hardcoded provider"), T("Nao defina provider fixo no codigo.", "Do not set provider fixed in code."), "xmark"),
        new(T("Sem DI", "Without DI"), T("Nao crie providers manualmente sem DI.", "Do not create providers manually without DI."), "ban"),
        new(T("Provider unico", "Single provider"), T("Se so usa um, configure no Program.cs.", "If using only one, configure in Program.cs."), "triangle-exclamation")
    ];

    // === TOKENS ===
    private IReadOnlyList<NameValueRow> TokenRows => [
        new("container", T("rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 shadow-sm.", "Rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 shadow-sm.")),
        new("header", T("flex items-center justify-between px-4 py-3 border-b.", "Flex items-center justify-between px-4 py-3 border-b.")),
