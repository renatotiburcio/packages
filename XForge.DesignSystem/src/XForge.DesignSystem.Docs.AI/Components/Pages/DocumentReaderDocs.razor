@page "/ai/document-reader"
@using XForge.DesignSystem.Components.AI.Common
@using XForge.DesignSystem.Components.AI.Documents
@using XForge.DesignSystem.Services.AI
@inject XForgeDocsLanguageService L

<XForgeDocsShell ProductLabel="AI Commercial"
                 Title="@L.Text("Document Reader","Document Reader")"
                 Status="@L.Text("Documentacao completa","Complete docs")"
                 Items="XForgeDocsCatalog.AiItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFAiDocumentReader" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@L.Text("Resumo e chunks","Summary and chunks")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @L.Text("Leitor inteligente para extrair, resumir e dividir documentos em chunks semanticos.",
                                   "Intelligent reader to extract, summarize and split documents into semantic chunks.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @L.Text("Componente AI que processa documentos de ate 8 formatos, gera resumo por IA, divide em chunks com posicao e relevancia, e fornece metadata de processamento.",
                                   "AI component that processes documents in up to 8 formats, generates AI summary, splits into chunks with position and relevance, and provides processing metadata.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(L.Text("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, L.Text("Campo", "Field"), L.Text("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@L.Text("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@L.Text("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@L.Text("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@L.Text("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Funciona com provider configurado.", "Works with configured provider.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@L.Text("Limitado", "Limited")" /></XFTableCell><XFTableCell>@L.Text("Renderiza como HTML estatico, sem processamento IA.", "Renders as static HTML, no AI processing.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(L.Text("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(L.Text("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(L.Text("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(L.Text("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(L.Text("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(L.Text("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 6 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(L.Text("1. Documento TXT", "1. TXT Document"), L.Text("Leitura basica de documento de texto.", "Basic text document reading."), ExTxtDocument(), Code1)
            @Example(L.Text("2. Com resumo", "2. With summary"), L.Text("Documento com resumo IA habilitado.", "Document with AI summary enabled."), ExWithSummary(), Code2)
            @Example(L.Text("3. Com chunks", "3. With chunks"), L.Text("Exibicao de chunks com posicoes.", "Display chunks with positions."), ExWithChunks(), Code3)
            @Example(L.Text("4. Documento XML", "4. XML document"), L.Text("Leitura de documento XML com tipo detectado.", "XML document reading with detected type."), ExXmlDocument(), Code4)
            @Example(L.Text("5. Tamanho de chunk", "5. Chunk size"), L.Text("Configuracao do tamanho dos chunks.", "Chunk size configuration."), ExChunkSize(), Code5)
            @Example(L.Text("6. Customizacao de template", "6. Template customization"), L.Text("Template customizado para chunks.", "Custom template for chunks."), ExCustomTemplate(), Code6)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(L.Text("Eventos", "Events"), @<div>@NameValueTable(EventRows, L.Text("Evento", "Event"), L.Text("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(L.Text("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, L.Text("Tecla", "Key"), L.Text("Comportamento", "Behavior"))</div>)
            @Section(L.Text("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(L.Text("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(L.Text("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(L.Text("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(L.Text("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", L.Text("Proposito", "Purpose"))</div>)
            @Section(L.Text("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(L.Text("Testes", "Testing"), @<div>@NameValueTable(TestingRows, L.Text("Cobertura", "Coverage"), L.Text("Evidencia", "Evidence"))</div>)
            @Section(L.Text("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, L.Text("Limitacao", "Limitation"), L.Text("Status", "Status"))</div>)
            @Section(L.Text("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, L.Text("Pergunta", "Question"), L.Text("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, L.Text("Versao", "Version"), L.Text("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string T(string pt, string en) => L.Text(pt, en);
    private string CopyableCodeTitle => L.Text("Codigo copiavel", "Copyable code");

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiDocumentReader DocumentName="contrato-fiscal.txt"
                           DocumentType="XFAiDocumentType.Txt"
                           DocumentContent="Contrato com clausulas fiscais, prazos de pagamento e regras de aprovacao."
                           ShowChunks="true" />
    </XFStack>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(L.Text("8 formatos", "8 formats"), L.Text("PDF, DOCX, XLSX, XML, TXT, CSV, JPG, PNG.", "PDF, DOCX, XLSX, XML, TXT, CSV, JPG, PNG."), "file-lines"),
        new(L.Text("Resumo IA", "AI summary"), L.Text("Resumo automatico gerado por IA.", "Automatic AI-generated summary."), "sparkles"),
        new(L.Text("Chunks semanticos", "Semantic chunks"), L.Text("Divisao em blocos com posicao e relevancia.", "Split into blocks with position and relevance."), "puzzle-piece")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFAiDocumentReader"),
        new("Namespace", "XForge.DesignSystem.Components.AI.Documents"),
        new("Package", "XForge.DesignSystem.AI"),
        new("Category", "AI / Documents"),
        new("Status", L.Text("Estavel", "Stable")),
        new("Accessibility", "role=region, aria-label, aria-busy, aria-live, aria-expanded."),
        new("Theme support", L.Text("Light, dark e data-brand via tokens.", "Light, dark and data-brand via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(L.Text("Leitura inteligente", "Smart reading"), L.Text("Extrai e resume documentos por IA.", "Extracts and summarizes documents via AI."), "file-lines"),
        new(L.Text("8 formatos", "8 formats"), L.Text("PDF, DOCX, XLSX, XML, TXT, CSV, JPG, PNG.", "PDF, DOCX, XLSX, XML, TXT, CSV, JPG, PNG."), "file-lines"),
        new(L.Text("Chunks", "Chunks"), L.Text("Divisao em blocos com posicao e relevancia.", "Split into blocks with position and relevance."), "puzzle-piece")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(L.Text("Extracao de dados", "Data extraction"), L.Text("Extrair informacoes de documentos.", "Extract information from documents."), "database"),
        new(L.Text("Resumo automatico", "Auto-summary"), L.Text("Gerar resumos por IA.", "Generate AI summaries."), "sparkles"),
        new(L.Text("Busca semantica", "Semantic search"), L.Text("Indexar chunks para busca por similaridade.", "Index chunks for similarity search."), "magnifying-glass")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(L.Text("Antes", "Before"), L.Text("Leitura manual de documentos longos.", "Manual reading of long documents."), "xmark"),
        new(L.Text("Depois", "After"), L.Text("Resumo automatico e chunks indexados.", "Automatic summary and indexed chunks."), "check"),
        new(L.Text("Formatos", "Formats"), L.Text("8 formatos suportados nativamente.", "8 natively supported formats."), "file-lines")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(L.Text("Contratos", "Contracts"), L.Text("Extrair clausulas e prazos.", "Extract clauses and deadlines."), "file-contract"),
        new(L.Text("Documentos juridicos", "Legal documents"), L.Text("Resumir peticoes e pareceres.", "Summarize petitions and opinions."), "scale-balanced")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(L.Text("Documentos muito curtos", "Very short documents"), L.Text("Para textos curtos, use XFCard.", "For short texts, use XFCard."), "minus"),
        new(L.Text("Imagens complexas", "Complex images"), L.Text("Use XFAiVision para analise de imagens.", "Use XFAiVision for image analysis."), "image")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new(L.Text("Header", "Header"), L.Text("Barra com nome e tipo do documento.", "Bar with document name and type."), "heading"),
        new(L.Text("Info Bar", "Info Bar"), L.Text("Metricas: caracteres, chunks, duracao.", "Metrics: characters, chunks, duration."), "chart-bar"),
        new(L.Text("Summary", "Summary"), L.Text("Resumo IA expansivel.", "Expandable AI summary."), "sparkles"),
        new(L.Text("Chunks List", "Chunks Lista"), L.Text("Lista de blocos com posicao e relevancia.", "Block list with position and relevance."), "puzzle-piece")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(L.Text("Formato auto-detect", "Format auto-detect"), L.Text("Detecta formato pela extensao do arquivo.", "Detects format by file extension."), "magnifying-glass"),
        new(L.Text("Resumo expansivel", "Expandable summary"), L.Text("Resumo IA pode ser colapsado.", "AI summary can be collapsed."), "chevron-down"),
        new(L.Text("Chunks paginados", "Paginated chunks"), L.Text("MaxChunks limita exibicao.", "MaxChunks limits display."), "list")
    ];

    // === EXAMPLES ===
    private RenderFragment ExTxtDocument() => @<div class="rounded-lg border border-border-light p-4">
        <XFAiDocumentReader DocumentName="contrato-fiscal.txt"
                           DocumentType="XFAiDocumentType.Txt"
                           DocumentContent="Contrato com clausulas fiscais, prazos de pagamento e regras de aprovacao." />
    </div>;

    private RenderFragment ExWithSummary() => @<div class="rounded-lg border border-border-light p-4">
        <XFAiDocumentReader DocumentName="relatorio-anual.pdf"
                           DocumentType="XFAiDocumentType.Pdf"
                           DocumentContent="Relatorio anual com resultados financeiros, metas atingidas e projetos em andamento."
                           ShowSummary="true" />
    </div>;

    private RenderFragment ExWithChunks() => @<div class="rounded-lg border border-border-light p-4">
        <XFAiDocumentReader DocumentName="contrato-fiscal.txt"
                           DocumentType="XFAiDocumentType.Txt"
                           DocumentContent="Contrato com clausulas fiscais, prazos de pagamento e regras de aprovacao."
                           ShowChunks="true" />
    </div>;

    private RenderFragment ExXmlDocument() => @<div class="rounded-lg border border-border-light p-4">
        <XFAiDocumentReader DocumentName="nota-fiscal.xml"
                           DocumentType="XFAiDocumentType.Xml"
                           DocumentContent="XML de NF-e com dados do emitente, destinatario e itens." />
    </div>;

    private RenderFragment ExChunkSize() => @<div class="rounded-lg border border-border-light p-4">
        <XFAiDocumentReader DocumentName="documento-grande.txt"
                           DocumentType="XFAiDocumentType.Txt"
                           DocumentContent="Conteudo extenso do documento com multiplos paragrafos e secoes."
                           ChunkSize="200"
                           MaxChunks="5"
                           ShowChunks="true" />
    </div>;

    private RenderFragment ExCustomTemplate() => @<div class="rounded-lg border border-border-light p-4">
        <XFAiDocumentReader DocumentName="contrato.txt"
                           DocumentType="XFAiDocumentType.Txt"
                           DocumentContent="Contrato com clausulas e prazos."
                           ShowChunks="true" />
    </div>;

    private const string Code1 = @"<XFAiDocumentReader DocumentName=""contrato-fiscal.txt""
    DocumentType=""@XFAiDocumentType.Txt""
    DocumentContent=""Contrato com clausulas fiscais..."" />";
    private const string Code2 = @"<XFAiDocumentReader DocumentName=""relatorio-anual.pdf""
    DocumentType=""@XFAiDocumentType.Pdf""
    DocumentContent=""Relatorio anual com resultados...""
    ShowSummary=""true"" />";
    private const string Code3 = @"<XFAiDocumentReader DocumentName=""contrato-fiscal.txt""
    DocumentType=""@XFAiDocumentType.Txt""
    DocumentContent=""Contrato com clausulas fiscais...""
    ShowChunks=""true"" />";
    private const string Code4 = @"<XFAiDocumentReader DocumentName=""nota-fiscal.xml""
    DocumentType=""@XFAiDocumentType.Xml""
    DocumentContent=""XML de NF-e com dados do emitente..."" />";
    private const string Code5 = @"<XFAiDocumentReader DocumentName=""documento-grande.txt""
    DocumentType=""@XFAiDocumentType.Txt""
    DocumentContent=""Conteudo extenso do documento...""
    ChunkSize=""200""
    MaxChunks=""5""
    ShowChunks=""true"" />";
    private const string Code6 = @"<XFAiDocumentReader DocumentName=""contrato.txt""
    DocumentType=""@XFAiDocumentType.Txt""
    DocumentContent=""Contrato com clausulas e prazos...""
    ShowChunks=""true"">
    <ChunkTemplate Context=""chunk"">
        <div class=""flex items-center gap-2"">
            <span class=""text-xs font-bold text-primary"">#@chunk.Index</span>
            <span class=""text-sm text-text-secondary"">@chunk.Content</span>
        </div>
    </ChunkTemplate>
</XFAiDocumentReader>";

    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("Provider", "IAiProvider?", "null", L.Text("Provedor de IA para resumo e extracao.", "AI provider for summary and extraction.")),
        new("DocumentContent", "string?", "null", L.Text("Conteudo bruto do documento.", "Raw document content.")),
        new("DocumentName", "string?", "null", L.Text("Nome do arquivo para contexto.", "Filename for context.")),
        new("DocumentType", "XFAiDocumentType?", "null", L.Text("Tipo do formato do documento.", "Document format type.")),
        new("Title", "string", "Leitor de Documentos", L.Text("Texto do titulo do cabecalho.", "Header title text.")),
        new("ShowHeader", "bool", "true", L.Text("Exibir barra de cabecalho.", "Show header bar.")),
        new("ShowSummary", "bool", "true", L.Text("Exibir secao de resumo IA.", "Show AI summary section.")),
        new("ShowChunks", "bool", "false", L.Text("Exibir lista de chunks.", "Show chunks list.")),
        new("MaxChunks", "int", "10", L.Text("Maximo de chunks exibidos.", "Maximum chunks displayed.")),
        new("ChunkSize", "int", "500", L.Text("Caracteres por chunk.", "Characters per chunk.")),
        new("Loading", "bool", "false", L.Text("Estado de carregamento externo.", "External loading state.")),
        new("EmptyText", "string", "Envie um documento...", L.Text("Texto do estado vazio.", "Empty state text.")),
        new("SystemPrompt", "string?", "null", L.Text("Prompt do sistema para resumo.", "System prompt for summary.")),
        new("OnDocumentProcessed", "EventCallback<XFAiDocumentResult>", "-", L.Text("Disparado apos processamento completo.", "Fired after full processing.")),
        new("OnSummaryGenerated", "EventCallback<string>", "-", L.Text("Disparado quando resumo e gerado.", "Fired when summary is generated.")),
        new("OnError", "EventCallback<string>", "-", L.Text("Disparado quando ocorre erro.", "Fired when error occurs.")),
        new("DocumentPreview", "RenderFragment<XFAiDocumentResult>?", "null", L.Text("Template de visualizacao do documento.", "Document preview template.")),
        new("ChunkTemplate", "RenderFragment<XFAiDocumentChunk>?", "null", L.Text("Template customizado para chunks.", "Custom chunk template.")),
        new("HeaderContent", "RenderFragment?", "null", L.Text("Conteudo customizado do cabecalho.", "Custom header content.")),
        new("EmptyContent", "RenderFragment?", "null", L.Text("Conteudo do estado vazio.", "Empty state content."))
    ];

    private IReadOnlyList<NameValueRow> EventRows => [
        new("OnDocumentProcessed", L.Text("Retorna XFAiDocumentResult com chunks, resumo, metadata e duracao.", "Returns XFAiDocumentResult with chunks, summary, metadata and duration.")),
        new("OnSummaryGenerated", L.Text("Retorna string com o resumo gerado pela IA.", "Returns string with AI-generated summary.")),
        new("OnError", L.Text("Retorna string com mensagem de erro do provider ou processamento.", "Returns string with error message from provider or processing."))
    ];

    // === ACCESSIBILITY ===
    private IReadOnlyList<DocTile> AccessibilityItems => [
        new("role=region", L.Text("Secao principal usa role=region.", "Main section uses role=region."), "universal-access"),
        new("aria-busy", L.Text("Indica estado de processamento.", "Indicates processing state."), "spinner"),
        new("aria-live", L.Text("Resumo e chunks atualizam com aria-live.", "Summary and chunks update with aria-live."), "volume-high"),
        new("aria-expanded", L.Text("Resumo expansivel com aria-expanded.", "Expandable summary with aria-expanded."), "chevron-down")
    ];

    private IReadOnlyList<NameValueRow> KeyboardRows => [
        new("Tab", L.Text("Navega entre header, info bar, summary e chunks.", "Navigates between header, info bar, summary and chunks.")),
        new("Enter", L.Text("Expande/colapsa o resumo.", "Expands/collapses the summary.")),
        new("Space", L.Text("Atalho para expandir/colapsar resumo.", "Shortcut to expand/collapse summary."))
    ];

    // === RESPONSIVENESS ===
    private IReadOnlyList<DocTile> ResponsivenessItems => [
        new(L.Text("Largura total", "Full width"), L.Text("Componente ocupa 100% do container.", "Component occupies 100% of container."), "maximize"),
        new(L.Text("Info bar flexivel", "Flexible info bar"), L.Text("Itens se reorganizam em telas pequenas.", "Items reorganize on small screens."), "mobile-screen")
    ];

    // === PERFORMANCE ===
    private IReadOnlyList<DocTile> PerformanceItems => [
        new(L.Text("Chunking local", "Local chunking"), L.Text("Divisao em chunks e feita localmente, sem chamada de API.", "Chunk splitting is done locally, no API call."), "bolt"),
        new(L.Text("Truncamento", "Truncation"), L.Text("Conteudo truncado em 4000 chars para resumo IA.", "Content truncated to 4000 chars for AI summary."), "scissors")
    ];

    // === SCENARIOS ===
    private IReadOnlyList<DocTile> ScenarioItems => [
        new(L.Text("Contratos ERP", "ERP Contracts"), L.Text("Extrair clausulas de contratos fiscais.", "Extract clauses from fiscal contracts."), "file-contract"),
        new(L.Text("NF-e XML", "NF-e XML"), L.Text("Processar notas fiscais eletronicas.", "Process electronic invoices."), "file-code"),
        new(L.Text("Relatorios PDF", "PDF Reports"), L.Text("Resumir relatorios financeiros longos.", "Summarize long financial reports."), "file-pdf")
    ];

    // === COMPOSITION ===
    private IReadOnlyList<DocTile> CompositionItems => [
        new(L.Text("Reader + Summary", "Reader + Summary"), L.Text("ShowSummary para resumo automatico.", "ShowSummary for automatic summary."), "sparkles"),
        new(L.Text("Reader + Chunks", "Reader + Chunks"), L.Text("ShowChunks para visualizacao de blocos.", "ShowChunks for block visualization."), "puzzle-piece"),
        new(L.Text("Reader + Template", "Reader + Template"), L.Text("ChunkTemplate para formato customizado.", "ChunkTemplate for custom format."), "paintbrush")
    ];

    // === BEST PRACTICES ===
    private IReadOnlyList<DocTile> BestPracticeItems => [
        new(L.Text("Defina DocumentType", "Set DocumentType"), L.Text("Melhora deteccao e formatacao.", "Improves detection and formatting."), "tag"),
        new(L.Text("ChunkSize adequado", "Adequate ChunkSize"), L.Text("500 para docs normais, 200 para granular.", "500 for normal docs, 200 for granularity."), "ruler"),
        new(L.Text("MaxChunks para performance", "MaxChunks for performance"), L.Text("Limite chunks exibidos em documentos grandes.", "Limit chunks in large documents."), "gauge"),
        new(L.Text("Tratamento de erros", "Error handling"), L.Text("Use OnError para feedback ao usuario.", "Use OnError for user feedback."), "circle-exclamation")
    ];

    // === ANTI-PATTERNS ===
    private IReadOnlyList<DocTile> AntiPatternItems => [
        new(L.Text("Sem Provider", "No Provider"), L.Text("Sem provider, resumo IA nao e gerado.", "Without provider, AI summary is not generated."), "xmark"),
        new(L.Text("Sem DocumentContent", "No DocumentContent"), L.Text("Componente exibe estado vazio.", "Component displays empty state."), "ban"),
        new(L.Text("Chunks excessivos", "Excessive chunks"), L.Text("Nao defina ChunkSize muito pequeno.", "Do not set ChunkSize too small."), "triangle-exclamation")
    ];

    // === TOKENS ===
