    private IReadOnlyList<NameValueRow> FaqRows => [
        new(L.Text("Generator vs criar manualmente?", "Generator vs create manually?"), L.Text("Generator garante padrao e velocidade. Manual permite customizacao total.", "Generator ensures standard and speed. Manual allows full customization.")),
        new(L.Text("Como incluir testes?", "How to include tests?"), L.Text("Marque a checkbox Incluir testes no formulario.", "Check the Include tests checkbox in the form.")),
