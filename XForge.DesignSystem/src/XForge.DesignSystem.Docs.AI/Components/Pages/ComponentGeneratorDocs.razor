    // === RELATED ===
    private IReadOnlyList<DocTile> RelatedComponentItems => [
        new("XFThemeEditor", L.Text("Editor visual de temas.", "Visual theme editor."), "palette"),
        new("XFFigmaSync", L.Text("Sincronizacao com Figma.", "Figma synchronization."), "arrows-rotate"),
