@page "/ai/component-generator"
@using XForge.DesignSystem.Components.AI.Tooling
@inject XForgeDocsLanguageService L

<XForgeDocsShell ProductLabel="AI Commercial"
                 Title="XFComponentGenerator"
                 Status="@L.Text("Estavel", "Stable")"
                 Items="XForgeDocsCatalog.AiItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFComponentGenerator" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@L.Text("Razor, code-behind, testes e docs", "Razor, code-behind, tests and docs")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@L.Text("Configuracao flexivel", "Flexible configuration")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @L.Text("Gerador assistido de componentes Blazor com scaffolding de Razor, code-behind, testes e documentacao.",
                                "Assisted Blazor component generator with Razor, code-behind, tests and documentation scaffolding.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @L.Text("Painel de configuracao para gerar componentes Blazor completos a partir de nome, namespace, tipo, parametros e opcoes. Gera arquivos Razor, code-behind com C#, testes unitarios e documentacao. Puro Blazor, sem JavaScript interop.",
                                "Configuration panel to generate complete Blazor components from name, namespace, type, parameters and options. Generates Razor files, C# code-behind, unit tests and documentation. Pure Blazor, no JavaScript interop.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(L.Text("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, L.Text("Campo", "Field"), L.Text("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@L.Text("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@L.Text("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@L.Text("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@L.Text("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Funciona sem restricoes. Geracao reativa.", "Works without restrictions. Reactive generation.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Renderiza como HTML estatico.", "Renders as static HTML.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@L.Text("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@L.Text("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(L.Text("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(L.Text("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(L.Text("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(L.Text("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(L.Text("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(L.Text("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 3 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(L.Text("1. Gerador padrao", "1. Default Generator"), L.Text("Gerador com formulario de configuracao completo.", "Generator with complete configuration form."), ExDefault(), Code1)
            @Example(L.Text("2. Componente simples", "2. Simple Component"), L.Text("Geracao de componente simples com nome e tipo.", "Generation of simple component with name and type."), ExSimple(), Code2)
            @Example(L.Text("3. Com testes e docs", "3. With Tests and Docs"), L.Text("Geracao completa com testes unitarios e documentacao.", "Full generation with unit tests and documentation."), ExFull(), Code3)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(L.Text("Eventos", "Events"), @<div>@NameValueTable(EventRows, L.Text("Evento", "Event"), L.Text("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(L.Text("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, L.Text("Tecla", "Key"), L.Text("Comportamento", "Behavior"))</div>)
            @Section(L.Text("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(L.Text("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(L.Text("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(L.Text("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(L.Text("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", L.Text("Proposito", "Purpose"))</div>)
            @Section(L.Text("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(L.Text("Testes", "Testing"), @<div>@NameValueTable(TestingRows, L.Text("Cobertura", "Coverage"), L.Text("Evidencia", "Evidence"))</div>)
            @Section(L.Text("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, L.Text("Limitacao", "Limitation"), L.Text("Status", "Status"))</div>)
            @Section(L.Text("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, L.Text("Pergunta", "Question"), L.Text("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, L.Text("Versao", "Version"), L.Text("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string CopyableCodeTitle => L.Text("Codigo copiavel", "Copyable code");

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFComponentGenerator Title="Component Generator" ShowHeader="true" />
    </XFStack>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(L.Text("Gerador de componentes", "Component generator"), L.Text("Scaffolding de Razor, code-behind, testes e docs.", "Razor, code-behind, tests and docs scaffolding."), "code"),
        new(L.Text("4 tipos de saida", "4 output types"), L.Text("Component, Service, Page e Layout.", "Component, Service, Page and Layout."), "file"),
        new(L.Text("Zero JS", "Zero JS"), L.Text("Nenhum JavaScript interop. Puro C# + Tailwind.", "No JavaScript interop. Pure C# + Tailwind."), "bolt")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFComponentGenerator"),
        new("Namespace", "XForge.DesignSystem.Components.AI.Tooling"),
        new("Package", "XForge.DesignSystem.AI"),
        new("Category", "AI / Tooling / Component Generator"),
        new("Status", L.Text("Estavel", "Stable")),
        new("Accessibility", L.Text("role=region, aria-label, botoes com aria-label.", "role=region, aria-label, buttons with aria-label.")),
        new("Theme support", L.Text("Light, dark e data-theme via tokens.", "Light, dark and data-theme via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(L.Text("Gerador de componentes", "Component generator"), L.Text("Formulario de configuracao para scaffolding.", "Configuration form for scaffolding."), "code"),
        new(L.Text("4 tipos de saida", "4 output types"), L.Text("Component, Service, Page e Layout.", "Component, Service, Page and Layout."), "file"),
        new(L.Text("Saida formatada", "Formatted output"), L.Text("Codigo gerado com syntax highlighting e copia.", "Generated code with syntax highlighting and copy."), "clipboard")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(L.Text("Scaffolding rapido", "Rapid scaffolding"), L.Text("Gerar estrutura base de componentes em segundos.", "Generate base component structure in seconds."), "bolt"),
        new(L.Text("Padronizacao", "Standardization"), L.Text("Garantir consistencia em nomes, namespaces e padroes.", "Ensure consistency in names, namespaces and patterns."), "shield-check"),
        new(L.Text("Testes e docs", "Tests and docs"), L.Text("Gerar testes unitarios e documentacao automaticamente.", "Generate unit tests and documentation automatically."), "file-lines")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(L.Text("Antes", "Before"), L.Text("Copiar e colar de componentes existentes.", "Copy and paste from existing components."), "xmark"),
        new(L.Text("Depois", "After"), L.Text("Formulario com configuracao e saida formatada.", "Form with configuration and formatted output."), "check"),
        new(L.Text("Acessibilidade", "Accessibility"), L.Text("Botoes com aria-label, formulario acessivel.", "Buttons with aria-label, accessible form."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(L.Text("Novos componentes", "New components"), L.Text("Scaffold rapido para componentes novos.", "Quick scaffold for new components."), "plus"),
        new(L.Text("Refatoracao", "Refactoring"), L.Text("Re-gerar estrutura padrao para componentes existentes.", "Re-generate standard structure for existing components."), "arrows-rotate")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(L.Text("Edicao visual", "Visual editing"), L.Text("Use XFThemeEditor para customizacao visual.", "Use XFThemeEditor for visual customization."), "palette"),
        new(L.Text("Sincronizacao Figma", "Figma sync"), L.Text("Use XFFigmaSync para sincronizacao.", "Use XFFigmaSync for synchronization."), "arrows-rotate")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new(L.Text("Header", "Header"), L.Text("Barra superior com titulo e badge de arquivos gerados.", "Top bar with title and generated files badge."), "bars"),
        new(L.Text("Config form", "Config form"), L.Text("Inputs para nome, namespace, tipo, base class e parametros.", "Inputs for name, namespace, type, base class and parameters."), "pencil"),
        new(L.Text("Options panel", "Options panel"), L.Text("Checkboxes para testes, docs, Tailwind, dark/light, IDisposable.", "Checkboxes for tests, docs, Tailwind, dark/light, IDisposable."), "cog"),
        new(L.Text("Output panel", "Output panel"), L.Text("Arquivos gerados com syntax highlighting e botao copiar.", "Generated files with syntax highlighting and copy button."), "file-code")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(L.Text("Configuracao flexivel", "Flexible config"), L.Text("Opcoes granulares para cada aspecto do componente.", "Granular options for each aspect of the component."), "sliders"),
        new(L.Text("Saida imediata", "Immediate output"), L.Text("Codigo gerado instantaneamente ao clicar Gerar.", "Code generated instantly when clicking Generate."), "bolt"),
        new(L.Text("Copiar com um clique", "Copy with one click"), L.Text("Cada arquivo gerado tem botao de copia.", "Each generated file has a copy button."), "clipboard")
    ];

    // === EXAMPLES ===
    private RenderFragment ExDefault() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFComponentGenerator Title="Component Generator" ShowHeader="true" />
    </XFStack>;

    private RenderFragment ExSimple() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFComponentGenerator Title="Simple" ShowHeader="true"
                             InitialConfig="@SimpleConfig" />
    </XFStack>;

    private RenderFragment ExFull() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFComponentGenerator Title="Full" ShowHeader="true"
                             InitialConfig="@FullConfig" />
    </XFStack>;

    private static XFGeneratorConfig SimpleConfig => new()
    {
        ComponentName = "XFAlert",
        Namespace = "XForge.DesignSystem.Components.Feedback.Alert",
        OutputType = XFGeneratorOutputType.Component,
        TailwindFirst = true,
        SupportDarkLight = true,
        ImplementDisposable = true
    };

    private static XFGeneratorConfig FullConfig => new()
    {
        ComponentName = "XFDataTable",
        Namespace = "XForge.DesignSystem.Components.Data.Table",
        OutputType = XFGeneratorOutputType.Component,
        IncludeTests = true,
        IncludeDocs = true,
        TailwindFirst = true,
        SupportDarkLight = true,
        ImplementAsyncDisposable = true,
        BaseClass = "XForgeComponentBase",
        Parameters = new[] { "string Title", "bool Disabled" }
    };

    private const string Code1 = @"<XFComponentGenerator Title=""Component Generator"" ShowHeader=""true"" />";
    private const string Code2 = @"<XFComponentGenerator Title=""Simple""
              ShowHeader=""true""
              InitialConfig=""@config"" />";
    private const string Code3 = @"<XFComponentGenerator Title=""Full""
              ShowHeader=""true""
              InitialConfig=""@config""
              OnGenerated=""@HandleGenerated"" />";

    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("Title", "string", "\"Component Generator\"", L.Text("Titulo do componente.", "Component title.")),
        new("AriaLabel", "string", "\"Gerador de componentes\"", L.Text("Rotulo ARIA para acessibilidade.", "ARIA label for accessibility.")),
        new("ShowHeader", "bool", "true", L.Text("Exibe a barra de cabecalho.", "Shows the header bar.")),
        new("InitialConfig", "XFGeneratorConfig?", "null", L.Text("Configuracao inicial do gerador.", "Initial generator configuration.")),
        new("OnGenerated", "EventCallback<IReadOnlyList<XFGeneratorOutput>>", "-", L.Text("Disparado quando a geracao termina.", "Fired when generation completes.")),
        new("OnCopied", "EventCallback<XFGeneratorOutput>", "-", L.Text("Disparado quando uma saida e copiada.", "Fired when output is copied."))
    ];

    private IReadOnlyList<NameValueRow> EventRows => [
        new("OnGenerated", L.Text("Disparado quando a geracao termina. Retorna lista de arquivos gerados.", "Fired when generation completes. Returns list of generated files.")),
        new("OnCopied", L.Text("Disparado quando um arquivo gerado e copiado. Retorna XFGeneratorOutput.", "Fired when a generated file is copied. Returns XFGeneratorOutput."))
    ];

    // === ACCESSIBILITY ===
    private IReadOnlyList<DocTile> AccessibilityItems => [
        new(L.Text("role=region", "role=region"), L.Text("Componente usa role=region para leitores de tela.", "Component uses role=region for screen readers."), "universal-access"),
        new(L.Text("aria-label", "aria-label"), L.Text("Rotulo descritivo do gerador.", "Descriptive generator label."), "tag"),
        new(L.Text("Formularios com label", "Forms with label"), L.Text("Cada input tem label associado para acessibilidade.", "Each input has associated label for accessibility."), "font"),
        new(L.Text("Botoes com aria-label", "Buttons with aria-label"), L.Text("Copiar, Gerar e outros botoes com labels.", "Copy, Generate and other buttons with labels."), "keyboard")
    ];

    private IReadOnlyList<NameValueRow> KeyboardRows => [
        new("Tab", L.Text("Navega entre campos do formulario e botoes.", "Navigates between form fields and buttons.")),
        new("Enter", L.Text("Submete formulario ou ativa botao Gerar.", "Submits form or activates Generate button.")),
        new("Space", L.Text("Ativa checkboxes de opcoes.", "Activates option checkboxes."))
    ];

    // === RESPONSIVENESS ===
    private IReadOnlyList<DocTile> ResponsivenessItems => [
        new(L.Text("Largura total", "Full width"), L.Text("Gerador ocupa 100% do container.", "Generator occupies 100% of container."), "maximize"),
        new(L.Text("Layout split", "Split layout"), L.Text("Formulario a esquerda, saida a direita em desktop.", "Form on left, output on right on desktop."), "desktop")
    ];

    // === PERFORMANCE ===
    private IReadOnlyList<DocTile> PerformanceItems => [
        new(L.Text("Zero JS", "Zero JS"), L.Text("Nenhum JavaScript interop.", "No JavaScript interop."), "bolt"),
        new(L.Text("Geracao local", "Local generation"), L.Text("Codigo gerado em memoria, sem chamadas de rede.", "Code generated in memory, no network calls."), "feather")
    ];

    // === SCENARIOS ===
    private IReadOnlyList<DocTile> ScenarioItems => [
        new(L.Text("Novos componentes", "New components"), L.Text("Scaffold rapido para novo componente do design system.", "Quick scaffold for new design system component."), "plus"),
        new(L.Text("Padronizacao enterprise", "Enterprise standardization"), L.Text("Garantir consistencia em nomes, namespaces e padroes.", "Ensure consistency in names, namespaces and patterns."), "shield-check"),
        new(L.Text("Onboarding", "Onboarding"), L.Text("Auxiliar novos devs a criar componentes padrao.", "Help new devs create standard components."), "users")
    ];

    // === COMPOSITION ===
    private IReadOnlyList<DocTile> CompositionItems => [
        new(L.Text("Generator + XFCard", "Generator + XFCard"), L.Text("Gerador dentro de um card para contexto.", "Generator inside a card for context."), "square"),
        new(L.Text("Generator + Output", "Generator + Output"), L.Text("Formulario a esquerda, saida formatada a direita.", "Form on left, formatted output on right."), "code"),
        new(L.Text("Generator + Copy", "Generator + Copy"), L.Text("Cada arquivo gerado com botao de copia.", "Each generated file with copy button."), "clipboard")
    ];

    // === BEST PRACTICES ===
    private IReadOnlyList<DocTile> BestPracticeItems => [
        new(L.Text("Nome descritivo", "Descriptive name"), L.Text("Use prefixo XF e nome descritivo.", "Use XF prefix and descriptive name."), "font"),
        new(L.Text("Namespace padrao", "Standard namespace"), L.Text("Siga o padrao XForge.DesignSystem.Components.Category.", "Follow XForge.DesignSystem.Components.Category pattern."), "folder"),
        new(L.Text("Incluir testes", "Include tests"), L.Text("Sempre marque IncludeTests para cobertura.", "Always check IncludeTests for coverage."), "check-double"),
        new(L.Text("Tailwind-first", "Tailwind-first"), L.Text("Mantenha TailwindFirst=true para consistencia.", "Keep TailwindFirst=true for consistency."), "paintbrush")
    ];

    // === ANTI-PATTERNS ===
    private IReadOnlyList<DocTile> AntiPatternItems => [
        new(L.Text("Nome generico", "Generic name"), L.Text("Nao use nomes como XFMyComponent.", "Do not use names like XFMyComponent."), "xmark"),
        new(L.Text("Sem testes", "No tests"), L.Text("Nao gere componentes sem testes unitarios.", "Do not generate components without unit tests."), "ban"),
        new(L.Text("Namespace incorreto", "Wrong namespace"), L.Text("Nao misture categorias no namespace.", "Do not mix categories in the namespace."), "triangle-exclamation")
    ];

    // === TOKENS ===
    private IReadOnlyList<NameValueRow> TokenRows => [
        new("xf-component-generator", L.Text("Container principal com layout split.", "Main container with split layout.")),
        new("config-form", L.Text("Formulario de configuracao com inputs e checkboxes.", "Configuration form with inputs and checkboxes.")),
        new("output-panel", L.Text("Painel de saida com arquivos gerados.", "Output panel with generated files.")),
        new("output-badge", L.Text("Badge colorido por tipo de arquivo.", "Colored badge per file type."))
    ];

    // === THEMING ===
    private IReadOnlyList<DocTile> ThemeItems => [
        new("data-theme", L.Text("Tokens light/dark via CSS variables.", "Light/dark tokens via CSS variables."), "moon"),
        new("data-brand", L.Text("Primary acompanha marca ativa.", "Primary follows active brand."), "swatchbook")
