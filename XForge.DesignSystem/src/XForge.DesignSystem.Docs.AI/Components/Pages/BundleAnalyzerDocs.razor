    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("Title", "string", "\"Bundle Analyzer\"", L.Text("Titulo do analisador.", "Analyzer title.")),
        new("AriaLabel", "string", "\"Analisador de tamanho do bundle\"", L.Text("Label ARIA para acessibilidade.", "ARIA label for accessibility.")),
        new("ShowHeader", "bool", "true", L.Text("Exibe barra de cabecalho com titulo e tamanho total.", "Displays header bar with title and total size.")),
        new("ShowFooter", "bool", "true", L.Text("Exibe barra de rodape com tree-shake e compressao.", "Displays footer bar with tree-shake and compression.")),
        new("ShowSummary", "bool", "true", L.Text("Exibe cards de resumo (Total, Gzip, Modulos).", "Displays summary cards (Total, Gzip, Modules).")),
        new("ShowBreakdown", "bool", "true", L.Text("Exibe breakdown por categoria.", "Displays category breakdown.")),
        new("ShowModuleList", "bool", "true", L.Text("Exibe tabela de modulos.", "Displays module table.")),
        new("MaxVisibleModules", "int", "50", L.Text("Maximo de modulos visiveis na tabela.", "Maximum modules visible in table.")),
        new("BundleData", "XFAiBundleSummary?", "null", L.Text("Dados de analise de bundle para exibir.", "Bundle analysis data to display."))
    ];

    private IReadOnlyList<NameValueRow> EventRows => [
        new("OnAnalyze", L.Text("Disparado quando a analise e solicitada.", "Fired when analysis is requested."))
    ];

    private IReadOnlyList<NameValueRow> TypeRows => [
        new("XFAiBundleSummary", L.Text("Record com TotalSizeBytes, TotalGzipSizeBytes, ModuleCount, TreeShakeableCount, Modules, Breakdown.", "Record with TotalSizeBytes, TotalGzipSizeBytes, ModuleCount, TreeShakeableCount, Modules, Breakdown.")),
        new("XFAiBundleModule", L.Text("Record com Name, Path, SizeBytes, GzipSizeBytes, Category, IsTreeShakeable, Percentage.", "Record with Name, Path, SizeBytes, GzipSizeBytes, Category, IsTreeShakeable, Percentage.")),
