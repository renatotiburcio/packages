@page "/ai/bundle-analyzer"
@using XForge.DesignSystem.Components.AI.Performance
@inject XForgeDocsLanguageService L

<XForgeDocsShell ProductLabel="AI Commercial"
                 Title="@L.Text("Bundle Analyzer", "Bundle Analyzer")"
                 Status="@L.Text("Documentacao completa", "Complete docs")"
                 Items="XForgeDocsCatalog.AiItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFAiBundleAnalyzer" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@L.Text("Analise de bundles", "Bundle analysis")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @L.Text("Analisador de tamanho de bundle com resumo, breakdown por categoria, lista de modulos e analise de tree-shake.",
                                   "Bundle size analyzer with summary, category breakdown, module list and tree-shake analysis.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @L.Text("Exibe tamanho total, compressao Gzip, contagem de modulos, breakdown por categorias (Components, Styles, Scripts, etc), tabela de modulos com tree-shake status e ratio de compressao.",
                                   "Displays total size, Gzip compression, module count, breakdown by categories (Components, Styles, Scripts, etc), module table with tree-shake status and compression ratio.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(L.Text("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, L.Text("Campo", "Field"), L.Text("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@L.Text("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@L.Text("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@L.Text("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@L.Text("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@L.Text("Parcial", "Partial")" /></XFTableCell><XFTableCell>@L.Text("Renderiza sem dados de bundle.", "Renders without bundle data.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@L.Text("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@L.Text("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(L.Text("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(L.Text("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(L.Text("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(L.Text("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(L.Text("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(L.Text("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 6 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(L.Text("1. Basico", "1. Basic"), L.Text("Analise completa com resumo, breakdown e modulos.", "Full analysis with summary, breakdown and modules."), ExBasic(), Code1)
            @Example(L.Text("2. Sem Breakdown", "2. Without Breakdown"), L.Text("Apenas resumo e lista de modulos.", "Summary and module list only."), ExNoBreakdown(), Code2)
            @Example(L.Text("3. Sem Modulos", "3. Without Modules"), L.Text("Apenas resumo e breakdown por categoria.", "Summary and category breakdown only."), ExNoModules(), Code3)
            @Example(L.Text("4. MaxVisibleModules=5", "4. MaxVisibleModules=5"), L.Text("Limita tabela a 5 modulos.", "Limits table to 5 modules."), ExMaxModules(), Code4)
            @Example(L.Text("5. Compacto", "5. Compact"), L.Text("Apenas resumo sem breakdown ou modulos.", "Summary only without breakdown or modules."), ExCompact(), Code5)
            @Example(L.Text("6. Sem Cabecalho", "6. No Header"), L.Text("Sem barra de cabecalho ou rodape.", "Without header or footer bars."), ExNoHeader(), Code6)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(L.Text("Eventos", "Events"), @<div>@NameValueTable(EventRows, L.Text("Evento", "Event"), L.Text("Comportamento", "Behavior"))</div>)
            @Section(L.Text("Tipos", "Types"), @<div>@NameValueTable(TypeRows, L.Text("Tipo", "Type"), L.Text("Descricao", "Description"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(L.Text("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, L.Text("Tecla", "Key"), L.Text("Comportamento", "Behavior"))</div>)
            @Section(L.Text("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(L.Text("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(L.Text("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(L.Text("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(L.Text("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", L.Text("Proposito", "Purpose"))</div>)
            @Section(L.Text("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(L.Text("Testes", "Testing"), @<div>@NameValueTable(TestingRows, L.Text("Cobertura", "Coverage"), L.Text("Evidencia", "Evidence"))</div>)
            @Section(L.Text("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, L.Text("Limitacao", "Limitation"), L.Text("Status", "Status"))</div>)
            @Section(L.Text("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, L.Text("Pergunta", "Question"), L.Text("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, L.Text("Versao", "Version"), L.Text("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string T(string pt, string en) => L.Text(pt, en);
    private string CopyableCodeTitle => L.Text("Codigo copiavel", "Copyable code");

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFAiBundleAnalyzer
        Title="Bundle Analyzer"
        ShowHeader="true"
        ShowSummary="true"
        ShowBreakdown="true"
        ShowModuleList="true"
        MaxVisibleModules="50" />;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(L.Text("Resumo de tamanho", "Size summary"), L.Text("Total, Gzip e contagem de modulos em tiles.", "Total, Gzip and module count in tiles."), "box-open"),
        new(L.Text("Breakdown por categoria", "Category breakdown"), L.Text("Barras por Components, Styles, Scripts, etc.", "Bars by Components, Styles, Scripts, etc."), "layer-group"),
        new(L.Text("Tree-shake analysis", "Tree-shake analysis"), L.Text("Indicador de tree-shake por modulo na tabela.", "Per-module tree-shake indicator in table."), "check-double")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFAiBundleAnalyzer"),
        new("Namespace", "XForge.DesignSystem.Components.AI.Performance"),
        new("Package", "XForge.DesignSystem.AI"),
        new("Category", "AI / Performance"),
        new("Status", L.Text("Estavel", "Stable")),
        new("Accessibility", L.Text("role=region, aria-label.", "role=region, aria-label.")),
        new("Theme support", L.Text("Light, dark e data-brand via tokens.", "Light, dark and data-brand via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(L.Text("Analise de bundle", "Bundle analysis"), L.Text("Tamanho total, Gzip e contagem de modulos.", "Total size, Gzip and module count."), "box-open"),
        new(L.Text("Breakdown visual", "Visual breakdown"), L.Text("Barras por categoria com percentuais.", "Bars by category with percentages."), "chart-bar"),
        new(L.Text("Tree-shake status", "Tree-shake status"), L.Text("Indicador verde/vermelho por modulo.", "Green/red indicator per module."), "check-double")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(L.Text("Otimizacao de bundle", "Bundle optimization"), L.Text("Identificar modulos grandes para otimizar.", "Identify large modules to optimize."), "gauge"),
        new(L.Text("Monitoramento de tamanho", "Size monitoring"), L.Text("Rastrear crescimento de bundle ao longo do tempo.", "Track bundle growth over time."), "eye"),
        new(L.Text("Validacao de tree-shake", "Tree-shake validation"), L.Text("Verificar se modulos sao tree-shakeables.", "Verify if modules are tree-shakeable."), "check-double")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(L.Text("Antes", "Before"), L.Text("Sem visibilidade sobre tamanho de bundles.", "No visibility into bundle sizes."), "xmark"),
        new(L.Text("Depois", "After"), L.Text("Resumo, breakdown, modulos e tree-shake em um painel.", "Summary, breakdown, modules and tree-shake in one panel."), "check"),
        new(L.Text("Acessibilidade", "Accessibility"), L.Text("role=region com aria-label para o analisador.", "role=region with aria-label for the analyzer."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(L.Text("Otimizacao de payload", "Payload optimization"), L.Text("Identificar modulos que mais pesam no bundle.", "Identify modules that weigh most in the bundle."), "weight-hanging"),
        new(L.Text("Validacao de CI", "CI validation"), L.Text("Verificar se bundles nao excedem limites.", "Verify bundles don't exceed limits."), "check-double"),
        new(L.Text("Auditoria de dependencias", "Dependency audit"), L.Text("Listar todos os modulos e seus tamanhos.", "List all modules and their sizes."), "list")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(L.Text("Analise de runtime", "Runtime analysis"), L.Text("Use XFAiPerformanceMonitor para metricas de runtime.", "Use XFAiPerformanceMonitor for runtime metrics."), "gauge"),
        new(L.Text("Memoria", "Memory"), L.Text("Use XFAiMemoryProfiler para uso de memoria.", "Use XFAiMemoryProfiler for memory usage."), "memory")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new("Header", L.Text("Titulo, badge de tamanho total e contagem de modulos.", "Title, total size badge and module count."), "heading"),
        new("Summary Cards", L.Text("3 tiles: Total, Gzip e Modulos.", "3 tiles: Total, Gzip and Modules."), "chart-bar"),
        new("Breakdown", L.Text("Barras por categoria com labels, tamanho e percentual.", "Bars by category with labels, size and percentage."), "layer-group"),
        new("Module Table", L.Text("Tabela com nome, tamanho, Gzip e tree-shake por modulo.", "Table with name, size, Gzip and tree-shake per module."), "table"),
        new("Footer", L.Text("Tree-shakeable count e ratio de compressao.", "Tree-shakeable count and compression ratio."), "rectangle-list")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(L.Text("Zero JS", "Zero JS"), L.Text("Nenhum JavaScript interop. Puro C# + Tailwind.", "No JavaScript interop. Pure C# + Tailwind."), "bolt"),
        new(L.Text("Cor = categoria", "Color = category"), L.Text("Cada categoria tem cor unica para identificacao visual.", "Each category has unique color for visual identification."), "palette"),
        new(L.Text("Formato legivel", "Readable format"), L.Text("Bytes, KB e MB formatados automaticamente.", "Bytes, KB and MB formatted automatically."), "font")
    ];

    // === EXAMPLES ===
    private RenderFragment ExBasic() => @<XFAiBundleAnalyzer
        Title="App Bundle"
        ShowHeader="true"
        ShowSummary="true"
        ShowBreakdown="true"
        ShowModuleList="true"
        MaxVisibleModules="50" />;

    private RenderFragment ExNoBreakdown() => @<XFAiBundleAnalyzer
        Title="Sem Breakdown"
        ShowHeader="true"
        ShowSummary="true"
        ShowBreakdown="false"
        ShowModuleList="true"
        MaxVisibleModules="50" />;

    private RenderFragment ExNoModules() => @<XFAiBundleAnalyzer
        Title="Sem Modulos"
        ShowHeader="true"
        ShowSummary="true"
        ShowBreakdown="true"
        ShowModuleList="false" />;

    private RenderFragment ExMaxModules() => @<XFAiBundleAnalyzer
        Title="5 Modulos"
        ShowHeader="true"
        ShowSummary="true"
        ShowBreakdown="true"
        ShowModuleList="true"
        MaxVisibleModules="5" />;

    private RenderFragment ExCompact() => @<XFAiBundleAnalyzer
        Title="Compacto"
        ShowHeader="true"
        ShowSummary="true"
        ShowBreakdown="false"
        ShowModuleList="false"
        ShowFooter="false" />;

    private RenderFragment ExNoHeader() => @<XFAiBundleAnalyzer
        Title="Sem Cabecalho"
