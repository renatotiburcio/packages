        MaxVisibleModules="10" />;

    private const string Code1 = @"<XFAiBundleAnalyzer
    Title=""App Bundle""
    ShowHeader=""true""
    ShowSummary=""true""
    ShowBreakdown=""true""
    ShowModuleList=""true""
    MaxVisibleModules=""50"" />";
    private const string Code2 = @"<XFAiBundleAnalyzer
    Title=""Sem Breakdown""
    ShowHeader=""true""
