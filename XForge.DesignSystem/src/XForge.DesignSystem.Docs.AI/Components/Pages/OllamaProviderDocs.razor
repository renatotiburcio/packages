@page "/ai/providers/ollama"
@using XForge.DesignSystem.Services.AI
@using XForge.DesignSystem.Components.AI.Chat
@inject XForgeDocsLanguageService L

<XForgeDocsShell ProductLabel="AI Commercial"
                 Title="Ollama Provider"
                 Status="@L.Text("Estavel","Stable")"
                 Items="XForgeDocsCatalog.AiItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                    <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="Ollama" />
                    <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Local","Local")" />
                    <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Streaming","Streaming")" />
                    <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Sem API Key","No API Key")" />
                </XFStack>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">@T("Provedor Ollama para modelos locais","Ollama Provider for Local Models")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">@T("Execute modelos de IA localmente com Ollama. Sem custo de API, sem latencia de rede, total privacidade. Suporta llama3, mistral, codellama, phi3, gemma e centenas de modelos.","Run AI models locally with Ollama. No API cost, no network latency, total privacy. Supports llama3, mistral, codellama, phi3, gemma, and hundreds of models.")</XFTypography>
                </XFStack>
                <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                    <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                        @HeroPreview()
                    </div>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                        @foreach (var item in QuickFacts) { @Tile(item) }
                    </XFStack>
                </div>
            </XFStack></ChildContent>
        </XFCard>

        <!-- ===== METADATA + COMPAT ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Metadados","Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo","Field"), T("Valor","Value"))</div>)

            @Section("Blazor Server e Blazor WebAssembly", @<div>
                <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade","Compatibility")</XFTypography>
                    <XFTable Striped="true" Hoverable="true" Compact="true">
                        <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo","Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte","Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes","Notes")</XFTableCell></XFTableRow></XFTableHeader>
                        <XFTableBody>
                            <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim","Yes")" /></XFTableCell><XFTableCell>@T("Requer Ollama instalado no servidor.","Requires Ollama installed on server.")</XFTableCell></XFTableRow>
                            <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim","Yes")" /></XFTableCell><XFTableCell>@T("Requer CORS configurado no Ollama.","Requires CORS configured on Ollama.")</XFTableCell></XFTableRow>
                            <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Danger" Text="@T("Nao","No")" /></XFTableCell><XFTableCell>@T("Nao suportado para provedores AI.","Not supported for AI providers.")</XFTableCell></XFTableRow>
                        </XFTableBody>
                    </XFTable>
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS","No JS Dependencies")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este provedor nao utiliza JavaScript interop. Comunicacao via HTTP com Ollama local.","This provider does not use JavaScript interop. Communication via HTTP with local Ollama.")</XFTypography>
                </XFStack>
            </div>)
        </XFStack>

        <!-- ===== CONCEPT SECTIONS ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral","Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito","Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido","Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar","When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar","When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia","Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
        </XFStack>

        <!-- ===== EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Chat Completo","1. Complete Chat"), T("Requisicao completa via CompleteAsync.","Full request via CompleteAsync."), ExChatComplete(), Code1)
            @Example(T("2. Streaming","2. Streaming"), T("Resposta em tempo real com StreamAsync.","Real-time response with StreamAsync."), ExStreaming(), Code2)
            @Example(T("3. Embeddings","3. Embeddings"), T("Vetores de similaridade com EmbedAsync.","Similarity vectors with EmbedAsync."), ExEmbeddings(), Code3)
        </XFStack>

        <!-- ===== CONFIG ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Pre-requisitos","Prerequisites"), @<div>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Instale o Ollama e baixe os modelos desejados:","Install Ollama and download desired models:")</XFTypography>
                <div class="mt-3">
                    <XFCode Text="@OllamaCommands" Language="bash" Title="Terminal" Variant="XFCodeVariant.Block" Copyable="true" />
                </div>
            </div>)

            @Section(T("Configuracao","Configuration"), @<div>
                <XFCode Text="@OllamaDiCode" Language="csharp" Title="Program.cs" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" />
            </div>)

            @Section(T("Modelos recomendados","Recommended Models"), @<div>
                <XFGrid Cols="1" Md="2" Gap="4">
                    <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent>
                        <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">llama3:8b</XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Melhor custo/beneficio para uso geral. 4.7 GB.","Best cost/benefit for general use. 4.7 GB.")</XFTypography>
                    </ChildContent></XFCard>
                    <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent>
                        <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">mistral:7b</XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Excelente para portugues e raciocinio. 4.1 GB.","Excellent for Portuguese and reasoning. 4.1 GB.")</XFTypography>
                    </ChildContent></XFCard>
                    <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent>
                        <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">codellama:13b</XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Especializado em geracao de codigo. 7.4 GB.","Specialized in code generation. 7.4 GB.")</XFTypography>
                    </ChildContent></XFCard>
                    <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent>
                        <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">phi3:3.8b</XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Modelo leve da Microsoft. Ideal para CPU. 2.3 GB.","Lightweight Microsoft model. Ideal for CPU. 2.3 GB.")</XFTypography>
                    </ChildContent></XFCard>
                </XFGrid>
            </div>)

            @Section(T("GPU vs CPU","GPU vs CPU"), @<div>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Ollama detecta automaticamente GPU NVIDIA, AMD ou Apple Silicon. Para forcar CPU:","Ollama auto-detects NVIDIA, AMD, or Apple Silicon GPU. To force CPU:")</XFTypography>
                <div class="mt-3">
                    <XFCode Text="OLLAMA_NUM_GPU=0 ollama serve" Language="bash" Title="Force CPU" Variant="XFCodeVariant.Block" Copyable="true" />
                </div>
            </div>)
        </XFStack>

        <!-- ===== API + EVENTS ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos","Events"), @<div>@NameValueTable(EventRows, T("Evento","Event"), T("Comportamento","Behavior"))</div>)
        </XFStack>

        <!-- ===== ACCESSIBILITY + PERFORMANCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade","Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Responsividade","Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance","Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <!-- ===== ENTERPRISE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise","Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao","Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX","UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes","Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <!-- ===== TOKENS + TESTING + CHANGELOG ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens","Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito","Purpose"))</div>)
            @Section(T("Temas","Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes","Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura","Coverage"), T("Evidencia","Evidence"))</div>)
            @Section(T("Limitacoes conhecidas","Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao","Limitation"), T("Status","Status"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao","Version"), T("Mudanca","Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>

<XForgeDocsPageStandard ComponentName="OllamaProviderDocs" />

@code {
    private string T(string pt, string en) => L.Text(pt, en);
    private string CopyableCodeTitle => T("Codigo copiavel","Copyable code");

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFTypography Variant="XFTypographyVariant.Body2" Weight="XFTypographyWeight.Semibold">@T("Modelos locais ativos:","Active local models:")</XFTypography>
        <XFCode Text="llama3:8b  mistral:7b  nomic-embed-text" Language="bash" Title="ollama list" Variant="XFCodeVariant.Block" Copyable="false" />
    </XFStack>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("Execucao local","Local execution"), T("Sem custo de API. Roda na sua maquina.","No API cost. Runs on your machine."), "server"),
        new(T("Streaming nativo","Native streaming"), T("Resposta token a token via IAsyncEnumerable.","Token-by-token response via IAsyncEnumerable."), "bolt"),
        new(T("Centenas de modelos","Hundreds of models"), T("llama3, mistral, codellama, phi3, gemma e mais.","llama3, mistral, codellama, phi3, gemma and more."), "cubes")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Provider", "OllamaProvider"),
        new("Namespace", "XForge.DesignSystem.Services.AI.Ollama"),
        new("Package", "XForge.DesignSystem"),
        new("Category", "AI / Provider"),
        new("Status", T("Estavel","Stable")),
        new("Endpoint", "http://localhost:11434"),
        new("Accessibility", T("Sem efeito visual direto. Acessibilidade e responsabilidade do componente consumidor.","No direct visual effect. Accessibility is the consumer component's responsibility.")),
        new("Theme support", T("N/A. Provedor de backend.","N/A. Backend provider."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("Provedor local","Local provider"), T("Comunicacao HTTP direta com Ollama.","Direct HTTP communication with Ollama."), "server"),
        new(T("Chat, streaming e embeddings","Chat, streaming and embeddings"), T("CompleteAsync, StreamAsync e EmbedAsync.","CompleteAsync, StreamAsync and EmbedAsync."), "message"),
        new(T("Sem dependencia externa","No external dependency"), T("Nao requer API key ou servico cloud.","Does not require API key or cloud service."), "lock")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Desenvolvimento","Development"), T("Prototipacao rapida sem custo de API.","Rapid prototyping without API cost."), "code"),
        new(T("Privacidade","Privacy"), T("Dados nunca saem da maquina local.","Data never leaves local machine."), "shield"),
        new(T("Offline","Offline"), T("Funciona sem internet. Totalmente local.","Works without internet. Fully local."), "wifi-slash")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes","Before"), T("Dependencia de APIs cloud com custo e latencia.","Cloud API dependency with cost and latency."), "xmark"),
        new(T("Depois","After"), T("Mesmo poder de IA, rodando localmente.","Same AI power, running locally."), "check"),
        new(T("Custo","Cost"), T("$0 por chamada. Hardware e o unico custo.","$0 per call. Hardware is the only cost."), "dollar-sign")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Prototipacao","Prototyping"), T("Teste modelos antes de investir em APIs.","Test models before investing in APIs."), "flask"),
        new(T("Privacidade","Privacy"), T("Dados sensiveis que nao podem sair do servidor.","Sensitive data that cannot leave the server."), "shield")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Producao em alta escala","High-scale production"), T("Ollama nao foi feito para alto throughput.","Ollama was not designed for high throughput."), "server"),
        new(T("Modelos de ultima geracao","Latest-gen models"), T("Modelos como GPT-4o nao estao disponiveis localmente.","Models like GPT-4o are not available locally."), "brain")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new("OllamaProvider", T("Classe principal que implementa IAiProvider.","Main class implementing IAiProvider."), "box"),
        new("HttpClient", T("Cliente HTTP para comunicacao com Ollama.","HTTP client for communication with Ollama."), "globe"),
        new("/api/chat", T("Endpoint para chat e streaming.","Endpoint for chat and streaming."), "message"),
        new("/api/embed", T("Endpoint para geracao de embeddings.","Endpoint for embedding generation."), "vector")
    ];

    // === EXAMPLES ===
    private RenderFragment ExChatComplete() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFCode Text="@Code1" Language="csharp" Title="@CopyableCodeTitle" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" />
    </XFStack>;

    private RenderFragment ExStreaming() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFCode Text="@Code2" Language="csharp" Title="@CopyableCodeTitle" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" />
    </XFStack>;

    private RenderFragment ExEmbeddings() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFCode Text="@Code3" Language="csharp" Title="@CopyableCodeTitle" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" />
    </XFStack>;

    private const string Code1 = @"var provider = sp.GetRequiredService&lt;IAiProvider&gt;();
var response = await provider.CompleteAsync(new AiChatRequest
{
    Model = ""llama3:8b"",
    Messages = new[]
    {
        new AiMessage { Role = ""user"", Content = ""Explique SOLID em 3 frases"" }
    }
});
Console.WriteLine(response.Content);";

    private const string Code2 = @"var provider = sp.GetRequiredService&lt;IAiProvider&gt;();
var request = new AiChatRequest
{
    Model = ""llama3:8b"",
    Messages = new[]
    {
        new AiMessage { Role = ""user"", Content = ""Escreva um haiku"" }
    }
};
await foreach (var chunk in provider.StreamAsync(request))
{
    Console.Write(chunk.Delta);
}";

    private const string Code3 = @"var provider = sp.GetRequiredService&lt;IAiProvider&gt;();
var embedding = await provider.EmbedAsync(
    ""nomic-embed-text"",
    ""Ollama roda modelos de IA localmente."");
Console.WriteLine($""Vector: {embedding.Vector.Length} dims"");";

    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("CompleteAsync", "Task<AiChatResponse>", "-", T("Chat completo via /api/chat","Complete chat via /api/chat")),
        new("StreamAsync", "IAsyncEnumerable<AiStreamChunk>", "-", T("Streaming via /api/chat com stream: true","Streaming via /api/chat with stream: true")),
        new("EmbedAsync", "Task<AiEmbeddingResponse>", "-", T("Embeddings via /api/embed (nomic-embed-text)","Embeddings via /api/embed (nomic-embed-text)")),
        new("ListModelsAsync", "Task<IReadOnlyList<string>>", "-", T("Lista modelos locais via /api/tags","Lists local models via /api/tags"))
    ];

    private IReadOnlyList<NameValueRow> EventRows => [
        new("OnStreamChunk", T("Evento disparado a cada chunk do streaming.","Fired at each streaming chunk.")),
        new("OnError", T("Evento disparado em caso de falha na conexao.","Fired on connection failure."))
    ];

    // === ACCESSIBILITY ===
    private IReadOnlyList<DocTile> AccessibilityItems => [
        new(T("Backend only","Backend only"), T("Provedor nao renderiza UI. Acessibilidade e do componente consumidor.","Provider does not render UI. Accessibility is the consumer component's responsibility."), "universal-access"),
        new(T("Sem ARIA","No ARIA"), T("Sem efeitos visuais. Sem necessidade de atributos ARIA.","No visual effects. No ARIA attributes needed."), "tag")
    ];

    // === RESPONSIVENESS ===
    private IReadOnlyList<DocTile> ResponsivenessItems => [
        new(T("Independente de viewport","Viewport independent"), T("Provedor de backend. Sem efeito na responsividade.","Backend provider. No effect on responsiveness."), "mobile-screen"),
        new(T("Timeout configuravel","Configurable timeout"), T("Ajuste HttpClient.Timeout para requests lentos.","Adjust HttpClient.Timeout for slow requests."), "clock")
    ];

    // === PERFORMANCE ===
    private IReadOnlyList<DocTile> PerformanceItems => [
        new(T("Latencia local","Local latency"), T("10-50ms para respostas locais.","10-50ms for local responses."), "bolt"),
        new(T("Sem overhead de rede","No network overhead"), T("Comunicacao via localhost. Sem latencia de rede.","Communication via localhost. No network latency."), "gauge")
    ];

    // === SCENARIOS ===
    private IReadOnlyList<DocTile> ScenarioItems => [
        new(T("Assistente ERP","ERP assistant"), T("Chatbot local para consulta de dados fiscais.","Local chatbot for tax data queries."), "robot"),
        new(T("Revisao de codigo","Code review"), T("Analisador de codigo offline com codellama.","Offline code analyzer with codellama."), "code"),
        new(T("Resumo de documentos","Document summary"), T("Resumo automatico de XMLs de NF-e.","Automatic summary of NF-e XMLs."), "file-lines")
    ];

    // === COMPOSITION ===
    private IReadOnlyList<DocTile> CompositionItems => [
        new(T("Ollama + ChatDocs","Ollama + ChatDocs"), T("Use OllamaProvider como backend doXFChat.","Use OllamaProvider as XFChat backend."), "message"),
        new(T("Ollama + DI","Ollama + DI"), T("Registre via AddHttpClient no container DI.","Register via AddHttpClient in DI container."), "link"),
        new(T("Ollama + Config","Ollama + Config"), T("BaseUrl via appsettings.json para flexibilidade.","BaseUrl via appsettings.json for flexibility."), "gear")
    ];

    // === BEST PRACTICES ===
    private IReadOnlyList<DocTile> BestPracticeItems => [
        new(T("Modelo adequado","Right model"), T("Escolha modelo baseado no caso de uso.","Choose model based on use case."), "check"),
        new(T("Tratar erros","Handle errors"), T("Ollama pode estar offline. Trate HttpRequestException.","Ollama may be offline. Handle HttpRequestException."), "shield"),
        new(T("Timeouts","Timeouts"), T("Configure timeouts para evitar blocos infinitos.","Configure timeouts to prevent infinite blocks."), "clock")
    ];

    // === ANTI-PATTERNS ===
    private IReadOnlyList<DocTile> AntiPatternItems => [
        new(T("Producao em escala","Production at scale"), T("Ollama nao suporta alto throughput. Use APIs cloud.","Ollama does not support high throughput. Use cloud APIs."), "ban"),
        new(T("Sem retry","No retry"), T("Nao tratar falhas de conexao. Sem retry policy.","Not handling connection failures. No retry policy."), "triangle-exclamation"),
        new(T("Modelo gigante","Giant model"), T("Rodar modelos 70B+ sem GPU suficiente.","Running 70B+ models without sufficient GPU."), "xmark")
    ];

    // === TOKENS ===
    private IReadOnlyList<NameValueRow> TokenRows => [
        new("HttpClient", T("Cliente HTTP para comunicacao com Ollama.","HTTP client for Ollama communication.")),
        new("BaseUrl", T("URL base do servidor Ollama (default: localhost:11434).","Ollama server base URL (default: localhost:11434).")),
        new("Model", T("Nome do modelo Ollama (ex: llama3:8b).","Ollama model name (e.g. llama3:8b)."))
    ];

    // === THEMING ===
    private IReadOnlyList<DocTile> ThemeItems => [
        new("N/A", T("Provedor de backend. Sem componente visual.","Backend provider. No visual component."), "server"),
        new("appsettings.json", T("Configuracao via arquivo de configuracao.","Configuration via settings file."), "gear")
    ];

    // === TESTING ===
    private IReadOnlyList<NameValueRow> TestingRows => [
        new("Unit", T("Testes de integracao com Ollama mockado.","Integration tests with mocked Ollama.")),
        new("Integration", T("Testes com Ollama real em ambiente de dev.","Tests with real Ollama in dev environment."))
    ];

    // === LIMITATIONS ===
    private IReadOnlyList<NameValueRow> LimitationRows => [
        new(T("Modelos locais","Local models"), T("Requer Ollama instalado e modelos baixados.","Requires Ollama installed and models downloaded.")),
        new(T("GPU","GPU"), T("Performance depende de hardware local.","Performance depends on local hardware.")),
        new(T("API Key","API Key"), T("Nao requer API key, mas modelos precisam ser baixados.","No API key needed, but models must be downloaded."))
    ];

    // === CHANGELOG ===
    private IReadOnlyList<NameValueRow> ChangelogRows => [
        new("v1.0.0", T("Provedor Ollama inicial com chat e streaming.","Initial Ollama provider with chat and streaming.")),
        new("v1.1.0", T("Adicionado retry policy e health checks.","Added retry policy and health checks.")),
        new("v1.2.0", T("Suporte a embeddings via nomic-embed-text.","Embedding support via nomic-embed-text."))
    ];

    // === HELPERS ===
    private RenderFragment Section(string title, RenderFragment content) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg"><Header><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography></Header><ChildContent>@content</ChildContent></XFCard>;

    private RenderFragment Example(string title, string description, RenderFragment preview, string codeText) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.None" AreaRestricted="false">
        <Header><div class="px-6 pt-6 pb-2">
            <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@description</XFTypography>
        </div></Header>
        <ChildContent><div class="flex flex-col">
            <div class="border-t border-border-light p-6">@preview</div>
            <div class="border-t border-border-light bg-surface-50 p-6">
                <XFCode Text="@codeText" Language="razor" Title="@CopyableCodeTitle" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" />
            </div>
        </div></ChildContent>
    </XFCard>;

    private RenderFragment Tile(DocTile item) => @<XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent>
        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <div class="flex items-center gap-4">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-primary/10 bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                <div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div>
            </div>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
        </XFStack>
    </ChildContent></XFCard>;

    private RenderFragment TileGrid(IReadOnlyList<DocTile> items, int columns) => @<XFGrid Cols="1" Md="@Math.Min(columns, 2)" Lg="@columns" Gap="4">@foreach (var item in items) { @Tile(item) }</XFGrid>;

    private RenderFragment WarningGrid(IReadOnlyList<DocTile> items) => @<XFGrid Cols="1" Md="2" Gap="4">@foreach (var item in items) {
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <div class="flex items-center gap-4">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-danger/10 bg-danger/10 text-danger" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                <div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div>
            </div>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
        </XFStack></ChildContent></XFCard>
    }</XFGrid>;

    private RenderFragment NameValueTable(IReadOnlyList<NameValueRow> rows, string nameHeader, string valueHeader) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader><XFTableRow><XFTableCell Header="true">@nameHeader</XFTableCell><XFTableCell Header="true">@valueHeader</XFTableCell></XFTableRow></XFTableHeader>
        <XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Value</XFTableCell></XFTableRow> }</XFTableBody>
    </XFTable>;

    private RenderFragment ApiTable(IReadOnlyList<ApiRow> rows) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Metodo","Method")</XFTableCell><XFTableCell Header="true">Type</XFTableCell><XFTableCell Header="true">Endpoint</XFTableCell><XFTableCell Header="true">@T("Descricao","Description")</XFTableCell></XFTableRow></XFTableHeader>
        <XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell><XFCode Text="@row.Type" /></XFTableCell><XFTableCell><XFCode Text="@row.Endpoint" /></XFTableCell><XFTableCell>@row.Description</XFTableCell></XFTableRow> }</XFTableBody>
    </XFTable>;

    // === RECORDS ===
    private sealed record DocTile(string Title, string Description, string Icon);
    private sealed record NameValueRow(string Name, string Value);
    private sealed record ApiRow(string Name, string Type, string Endpoint, string Description);

    // === COMMANDS ===
