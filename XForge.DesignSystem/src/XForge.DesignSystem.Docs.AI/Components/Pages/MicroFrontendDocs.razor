@page "/ai/micro-frontend"
@inject XForgeDocsLanguageService L

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.AiItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFMicroFrontend" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@L.Text("5 estados, module federation", "5 states, module federation")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @L.Text("Composicao de modulos comerciais para distribuicao e extensibilidade do ecossistema AI.",
                                   "Commercial module composition for distribution and extensibility of the AI ecosystem.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @L.Text("Container de micro-frontends com carregamento remoto, gestao de estados, error boundaries, timeout e retry para padroes de module federation.",
                                   "Micro-frontend container with remote loading, state management, error boundaries, timeout and retry for module federation patterns.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(L.Text("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, L.Text("Campo", "Field"), L.Text("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@L.Text("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@L.Text("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@L.Text("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@L.Text("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@L.Text("Parcial", "Partial")" /></XFTableCell><XFTableCell>@L.Text("Renderiza container mas modulo nao carrega.", "Renders container but module does not load.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@L.Text("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@L.Text("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(L.Text("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(L.Text("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(L.Text("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(L.Text("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(L.Text("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(L.Text("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 3 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(L.Text("1. Modulo carregado", "1. Module loaded"), L.Text("Modulo carregado com conteudo, versao e dependencias.", "Module loaded with content, version and dependencies."), ExLoaded(), Code1)
            @Example(L.Text("2. Carregando e erro", "2. Loading and error"), L.Text("Estados de carregamento e erro com retry.", "Loading and error states with retry."), ExLoadingError(), Code2)
            @Example(L.Text("3. Timeout e idle", "3. Timeout and idle"), L.Text("Tempo esgotado e estado ocioso com botao de carregar.", "Timeout and idle state with load button."), ExTimeoutIdle(), Code3)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(L.Text("Eventos", "Events"), @<div>@NameValueTable(EventRows, L.Text("Evento", "Event"), L.Text("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(L.Text("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, L.Text("Tecla", "Key"), L.Text("Comportamento", "Behavior"))</div>)
            @Section(L.Text("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(L.Text("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(L.Text("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(L.Text("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(L.Text("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", L.Text("Proposito", "Purpose"))</div>)
            @Section(L.Text("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(L.Text("Testes", "Testing"), @<div>@NameValueTable(TestingRows, L.Text("Cobertura", "Coverage"), L.Text("Evidencia", "Evidence"))</div>)
            @Section(L.Text("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, L.Text("Limitacao", "Limitation"), L.Text("Status", "Status"))</div>)
            @Section(L.Text("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, L.Text("Pergunta", "Question"), L.Text("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, L.Text("Versao", "Version"), L.Text("Mudanca", "Change"))</div>)
        </XFStack>

        <XForgeDocsPageStandard ComponentName="MicroFrontendDocs" />
    </XFStack>
</XForgeDocsShell>
@code {
    private string ProductLabelText => L.Text("AI Commercial", "AI Commercial");
    private string PageTitleText => L.Text("XFMicroFrontend", "XFMicroFrontend");
    private string PageStatusText => L.Text("Documentacao completa", "Complete docs");
    private string CopyableCodeTitle => L.Text("Codigo copiavel", "Copyable code");

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFMicroFrontend Module="@(new XFMicroFrontendModule { Name = "XFAiChatModule", Version = "2.1.0", Scope = "ai-core", Dependencies = new[] { "XFAiProvider", "XFDesignTokens" } })"
                                                              CurrentState="XFMicroFrontendState.Loaded"
                                                              ShowLoadButton="true"
                                                              ShowRetryButton="true" />;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(L.Text("5 estados", "5 states"), L.Text("Idle, Loading, Loaded, Error, Timeout.", "Idle, Loading, Loaded, Error, Timeout."), "signal"),
        new(L.Text("Module federation", "Module federation"), L.Text("Carregamento remoto com URL, versao, escopo e dependencias.", "Remote loading with URL, version, scope and dependencies."), "puzzle-piece"),
        new(L.Text("Zero JS", "Zero JS"), L.Text("Nenhum JavaScript interop. Puro C# + Tailwind.", "No JavaScript interop. Pure C# + Tailwind."), "bolt")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFMicroFrontend"),
        new("Namespace", "XForge.DesignSystem.Components.AI.Enterprise"),
        new("Package", "XForge.DesignSystem.AI"),
        new("Category", "AI / Enterprise"),
        new("Status", L.Text("Estavel", "Stable")),
        new("Accessibility", L.Text("role=region, aria-label, aria-busy, aria-live=polite.", "role=region, aria-label, aria-busy, aria-live=polite.")),
        new("Theme support", L.Text("Light, dark e data-theme via tokens.", "Light, dark and data-theme via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(L.Text("Container de modulo", "Module container"), L.Text("Carrega e renderiza modulos remotos.", "Loads and renders remote modules."), "puzzle-piece"),
        new(L.Text("5 estados", "5 states"), L.Text("Idle, Loading, Loaded, Error, Timeout.", "Idle, Loading, Loaded, Error, Timeout."), "signal"),
        new(L.Text("Error boundary", "Error boundary"), L.Text("Tratamento de erros com retry e fallback.", "Error handling with retry and fallback."), "shield-halved")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(L.Text("Module federation", "Module federation"), L.Text("Distribuicao de modulos AI entre aplicacoes.", "Distribution of AI modules across applications."), "puzzle-piece"),
        new(L.Text("Plugins", "Plugins"), L.Text("Carregamento dinamico de plugins AI.", "Dynamic loading of AI plugins."), "plug"),
        new(L.Text("Extensibilidade", "Extensibility"), L.Text("Permitir que parceiros estendam a plataforma.", "Allow partners to extend the platform."), "arrows-expand")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(L.Text("Antes", "Before"), L.Text("Modulos AI acoplados e impossivel distribuir.", "Coupled AI modules impossible to distribute."), "xmark"),
        new(L.Text("Depois", "After"), L.Text("Container com 5 estados, retry e fallback.", "Container with 5 states, retry and fallback."), "check"),
        new(L.Text("Acessibilidade", "Accessibility"), L.Text("aria-busy, aria-live, role=region.", "aria-busy, aria-live, role=region."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(L.Text("Distribuicao", "Distribution"), L.Text("Distribuir modulos AI entre aplicacoes.", "Distribute AI modules across applications."), "puzzle-piece"),
        new(L.Text("Plugins", "Plugins"), L.Text("Carregar plugins de terceiros dinamicamente.", "Load third-party plugins dynamically."), "plug")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(L.Text("Conteudo estatico", "Static content"), L.Text("Use ChildContent direto para conteudo fixo.", "Use direct ChildContent for static content."), "lock"),
        new(L.Text("Iframe", "Iframe"), L.Text("Nao use iframe para micro-frontends. Use o componente.", "Do not use iframe for micro-frontends. Use the component."), "ban")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new("Module", L.Text("Definicao do modulo (Name, URL, Version, Scope).", "Module definition (Name, URL, Version, Scope)."), "puzzle-piece"),
        new("State", L.Text("Estado atual: Idle, Loading, Loaded, Error, Timeout.", "Current state: Idle, Loading, Loaded, Error, Timeout."), "signal"),
        new("Content", L.Text("Conteudo renderizado do modulo (ModuleContent).", "Module rendered content (ModuleContent)."), "align-left"),
        new("Fallback", L.Text("Conteudo de fallback em caso de erro.", "Fallback content on error."), "shield-halved"),
        new("Retry", L.Text("Botao de retry em estado de erro.", "Retry button in error state."), "arrows-rotate"),
        new("Load", L.Text("Botao de carregamento em estado idle.", "Load button in idle state."), "download")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(L.Text("Estado claro", "Clear state"), L.Text("5 estados visuais distintos para cada situacao.", "5 distinct visual states for each situation."), "eye"),
        new(L.Text("Error boundary", "Error boundary"), L.Text("Tratamento Graceful de erros e timeouts.", "Graceful error and timeout handling."), "shield-halved"),
        new(L.Text("Retry automatico", "Auto retry"), L.Text("Botao de retry para recuperacao de erros.", "Retry button for error recovery."), "arrows-rotate")
    ];

    // === EXAMPLES ===
    private RenderFragment ExLoaded() => @<XFMicroFrontend Module="@(new XFMicroFrontendModule { Name = "XFAiChatModule", Version = "2.1.0", Scope = "ai-core", Dependencies = new[] { "XFAiProvider", "XFDesignTokens" } })"
                                                            CurrentState="XFMicroFrontendState.Loaded"
                                                            ShowLoadButton="true"
                                                            ShowRetryButton="true" />;

    private RenderFragment ExLoadingError() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFMicroFrontend Module="@(new XFMicroFrontendModule { Name = "XFAiVisionModule", Version = "1.0.0" })"
                         CurrentState="XFMicroFrontendState.Loading" />
        <XFMicroFrontend Module="@(new XFMicroFrontendModule { Name = "XFAiVisionModule", Version = "1.0.0" })"
                         CurrentState="XFMicroFrontendState.Error"
                         ErrorMessage="Modulo indisponivel. Verifique a URL remota."
                         ShowRetryButton="true" />
    </XFStack>;

    private RenderFragment ExTimeoutIdle() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFMicroFrontend Module="@(new XFMicroFrontendModule { Name = "XFAiAudioModule" })"
                         CurrentState="XFMicroFrontendState.Timeout" />
        <XFMicroFrontend Module="@(new XFMicroFrontendModule { Name = "XFAiWorkflowModule", Version = "3.0.0" })"
                         CurrentState="XFMicroFrontendState.Idle"
                         ShowLoadButton="true" />
    </XFStack>;

    private const string Code1 = @"<XFMicroFrontend Module=""@(new XFMicroFrontendModule { Name = ""XFAiChatModule"", Version = ""2.1.0"", Scope = ""ai-core"", Dependencies = new[] { ""XFAiProvider"", ""XFDesignTokens"" } })""
                       CurrentState=""XFMicroFrontendState.Loaded""
                       ShowLoadButton=""true""
                       ShowRetryButton=""true"" />";
    private const string Code2 = @"<XFMicroFrontend Module=""@(new XFMicroFrontendModule { Name = ""XFAiVisionModule"", Version = ""1.0.0"" })""
                       CurrentState=""XFMicroFrontendState.Loading"" />
<XFMicroFrontend Module=""@(new XFMicroFrontendModule { Name = ""XFAiVisionModule"", Version = ""1.0.0"" })""
                       CurrentState=""XFMicroFrontendState.Error""
                       ErrorMessage=""Modulo indisponivel. Verifique a URL remota.""
                       ShowRetryButton=""true"" />";
    private const string Code3 = @"<XFMicroFrontend Module=""@(new XFMicroFrontendModule { Name = ""XFAiAudioModule"" })""
                       CurrentState=""XFMicroFrontendState.Timeout"" />
<XFMicroFrontend Module=""@(new XFMicroFrontendModule { Name = ""XFAiWorkflowModule"", Version = ""3.0.0"" })""
                       CurrentState=""XFMicroFrontendState.Idle""
                       ShowLoadButton=""true"" />";

    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("Module", "XFMicroFrontendModule?", "null", L.Text("Definicao do modulo a carregar (Name, URL, Version, Scope, Dependencies).", "Module definition to load (Name, URL, Version, Scope, Dependencies).")),
        new("CurrentState", "XFMicroFrontendState", "Idle", L.Text("Estado atual: Idle, Loading, Loaded, Error, Timeout.", "Current state: Idle, Loading, Loaded, Error, Timeout.")),
        new("ErrorMessage", "string?", "null", L.Text("Mensagem de erro no estado Error.", "Error message in Error state.")),
        new("ShowLoadButton", "bool", "true", L.Text("Exibe botao de carregar no estado Idle.", "Shows load button in Idle state.")),
        new("ShowRetryButton", "bool", "true", L.Text("Exibe botao de retry no estado Error.", "Shows retry button in Error state.")),
        new("TimeoutSeconds", "int", "30", L.Text("Timeout de carregamento em segundos.", "Load timeout in seconds.")),
        new("EmptyLabel", "string", "\"Nenhum modulo configurado\"", L.Text("Label quando nenhum modulo configurado.", "Label when no module configured.")),
        new("LoadingLabel", "string", "\"Carregando\"", L.Text("Label durante carregamento.", "Label during loading.")),
        new("ErrorLabel", "string", "\"Erro ao carregar modulo\"", L.Text("Label do estado de erro.", "Error state label."))
    ];

    private IReadOnlyList<NameValueRow> EventRows => [
        new("OnModuleLoad", L.Text("Disparado quando o carregamento do modulo e solicitado.", "Fired when module load is requested.")),
        new("OnModuleLoaded", L.Text("Disparado quando o modulo e carregado com sucesso.", "Fired when module loads successfully.")),
        new("OnModuleError", L.Text("Disparado quando o carregamento do modulo falha.", "Fired when module load fails.")),
        new("OnRetry", L.Text("Disparado quando o retry e solicitado.", "Fired when retry is requested."))
    ];

    // === ACCESSIBILITY ===
    private IReadOnlyList<DocTile> AccessibilityItems => [
        new(L.Text("role=region", "role=region"), L.Text("Componente usa role=region para leitores de tela.", "Component uses role=region for screen readers."), "universal-access"),
        new(L.Text("aria-label", "aria-label"), L.Text("Label descritivo Micro-Frontend Container.", "Descriptive label Micro-Frontend Container."), "tag"),
        new(L.Text("aria-busy", "aria-busy"), L.Text("Indica estado de carregamento do modulo.", "Indicates module loading state."), "spinner"),
        new(L.Text("aria-live=polite", "aria-live=polite"), L.Text("Notifica mudancas de estado do modulo.", "Notifies module state changes."), "volume-high")
    ];

    private IReadOnlyList<NameValueRow> KeyboardRows => [
        new("Tab", L.Text("Navega para botao de carregar/retry.", "Navigates to load/retry button.")),
        new("Enter / Space", L.Text("Ativa carregamento ou retry do modulo.", "Activates module load or retry."))
    ];

    // === RESPONSIVENESS ===
    private IReadOnlyList<DocTile> ResponsivenessItems => [
        new(L.Text("Largura total", "Full width"), L.Text("Container ocupa 100% do container pai.", "Container occupies 100% of parent container."), "maximize"),
        new(L.Text("Conteudo responsivo", "Responsive content"), L.Text("Modulo carregado se adapta ao container.", "Loaded module adapts to container."), "mobile-screen")
    ];

    // === PERFORMANCE ===
    private IReadOnlyList<DocTile> PerformanceItems => [
        new(L.Text("Lazy loading", "Lazy loading"), L.Text("Modulo so e carregado quando solicitado.", "Module is loaded only when requested."), "bolt"),
        new(L.Text("Timeout", "Timeout"), L.Text("Timeout configuravel para evitar loading infinito.", "Configurable timeout to prevent infinite loading."), "clock"),
        new(L.Text("Retry", "Retry"), L.Text("Retry com backoff para recuperacao de erros.", "Retry with backoff for error recovery."), "arrows-rotate")
    ];

    // === SCENARIOS ===
    private IReadOnlyList<DocTile> ScenarioItems => [
        new(L.Text("Module federation", "Module federation"), L.Text("Distribuir modulos AI entre micro-servicos.", "Distribute AI modules across micro-services."), "puzzle-piece"),
        new(L.Text("Plugins AI", "AI plugins"), L.Text("Carregar plugins de parceiros dinamicamente.", "Load partner plugins dynamically."), "plug"),
        new(L.Text("Lazy features", "Lazy features"), L.Text("Funcionalidades AI carregadas sob demanda.", "AI features loaded on demand."), "download")
    ];

    // === COMPOSITION ===
    private IReadOnlyList<DocTile> CompositionItems => [
        new(L.Text("MicroFrontend + Auth", "MicroFrontend + Auth"), L.Text("Autenticar antes de carregar modulo.", "Authenticate before loading module."), "shield-halved"),
        new(L.Text("MicroFrontend + RBAC", "MicroFrontend + RBAC"), L.Text("Proteger modulo com controle de acesso.", "Protect module with access control."), "lock"),
        new(L.Text("MicroFrontend + Grid", "MicroFrontend + Grid"), L.Text("Multiplos modulos em XFGrid.", "Multiple modules in XFGrid."), "table-cells")
    ];

    // === BEST PRACTICES ===
    private IReadOnlyList<DocTile> BestPracticeItems => [
        new(L.Text("Module definido", "Module defined"), L.Text("Sempre defina Module antes de setar estado.", "Always define Module before setting state."), "puzzle-piece"),
        new(L.Text("Timeout adequado", "Adequate timeout"), L.Text("Ajuste TimeoutSeconds conforme a rede.", "Adjust TimeoutSeconds based on network."), "clock"),
        new(L.Text("Fallback content", "Fallback content"), L.Text("Forneca FallbackContent para erros gracefully.", "Provide FallbackContent for graceful errors."), "shield-halved")
    ];

    // === ANTI-PATTERNS ===
    private IReadOnlyList<DocTile> AntiPatternItems => [
        new(L.Text("Sem Module", "No Module"), L.Text("Estado Loaded sem Module definido.", "Loaded state without defined Module."), "xmark"),
        new(L.Text("Timeout zero", "Zero timeout"), L.Text("TimeoutSeconds=0 causa carregamento infinito.", "TimeoutSeconds=0 causes infinite loading."), "ban"),
        new(L.Text("Muitos modulos", "Too many modules"), L.Text("Evite mais de 5 micro-frontends simultaneos.", "Avoid more than 5 simultaneous micro-frontends."), "triangle-exclamation")
    ];

    // === TOKENS ===
    private IReadOnlyList<NameValueRow> TokenRows => [
        new("container", L.Text("flex flex-col items-center justify-center p-6 rounded-lg border.", "Flex flex-col items-center justify-center p-6 rounded-lg border.")),
        new("module-info", L.Text("flex items-center gap-2 mb-2.", "Flex items-center gap-2 mb-2.")),
        new("dependencies", L.Text("flex flex-wrap gap-1.", "Flex flex-wrap gap-1."))
    ];

    // === THEMING ===
    private IReadOnlyList<DocTile> ThemeItems => [
        new("data-theme", L.Text("Tokens light/dark via CSS variables.", "Light/dark tokens via CSS variables."), "moon"),
        new("State colors", L.Text("Loading=blue, Error=red, Timeout=amber, Loaded=green, Idle=gray.", "Loading=blue, Error=red, Timeout=amber, Loaded=green, Idle=gray."), "palette")
    ];

    // === TESTING ===
    private IReadOnlyList<NameValueRow> TestingRows => [
        new("Unit", L.Text("Testes de render, estados, module, timeout, retry, eventos.", "Render, states, module, timeout, retry, events tests.")),
        new("Accessibility", L.Text("role=region, aria-label, aria-busy, aria-live.", "role=region, aria-label, aria-busy, aria-live."))
    ];

    // === LIMITATIONS ===
    private IReadOnlyList<NameValueRow> LimitationRows => [
        new("Static SSR", L.Text("Container renderiza mas modulo nao carrega em SSR.", "Container renders but module does not load in SSR.")),
        new("Timeout", L.Text("TimeoutSeconds minimo recomendado: 5 segundos.", "Minimum recommended TimeoutSeconds: 5 seconds."))
    ];

    // === RELATED ===
    private IReadOnlyList<DocTile> RelatedComponentItems => [
        new("XFAuthProvider", L.Text("Autenticacao antes de modulo.", "Authentication before module."), "shield-halved"),
        new("XFRbacComponent", L.Text("Controle de acesso ao modulo.", "Module access control."), "lock"),
        new("XFAiChat", L.Text("Modulo de chat AI comum.", "Common AI chat module."), "comments")
    ];

    // === FAQ ===
