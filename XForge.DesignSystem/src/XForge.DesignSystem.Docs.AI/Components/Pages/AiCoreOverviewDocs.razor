        new(T("Code Copilot", "Code Copilot"), T("Assistente de codigo com XFAiChat + tool calling.", "Code assistant with XFAiChat + tool calling."), "code"),
        new(T("Data Explorer", "Data Explorer"), T("Navegacao por comandos para queries SQL.", "Command navigation for SQL queries."), "database"),
