@page "/ai/core/overview"
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.AiItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="AI Core" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="5 Components" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Provider abstraction", "Provider abstraction")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Infraestrutura base para todos os componentes AI: abstracao de providers, chat, prompt, command palette, suggestions e configuracao.",
                               "Base infrastructure for all AI components: provider abstraction, chat, prompt, command palette, suggestions and configuration.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("O modulo AI Core do XForge.DesignSystem fornece os componentes fundamentais para construir experiencias IA conversacionais, com suporte a 8 providers, streaming, tools e acessibilidade WCAG.",
                               "The XForge.DesignSystem AI Core module provides the fundamental components for building conversational AI experiences, with support for 8 providers, streaming, tools and WCAG accessibility.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        <!-- ===== 1. Metadata ===== -->
        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        <!-- ===== 2. Blazor Server e Blazor WebAssembly ===== -->
        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico.", "Renders as static HTML.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Streaming via SignalR", "Streaming via SignalR")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Componentes AI usam StreamingHub para SSE via SignalR em Blazor Server. No WebAssembly, streaming e feito via HttpClient direto.", "AI components use StreamingHub for SSE via SignalR in Blazor Server. In WebAssembly, streaming is done via direct HttpClient.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <!-- ===== 3. Overview ===== -->
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            <!-- ===== 4. Purpose ===== -->
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            <!-- ===== 5. Problem Solved ===== -->
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            <!-- ===== 6. When To Use ===== -->
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            <!-- ===== 7. When Not To Use ===== -->
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            <!-- ===== 8. Architecture ===== -->
            @Section(T("Arquitetura", "Architecture"), @<div>@TileGrid(ArchitectureItems, 3)</div>)
            <!-- ===== 9. Design Principles ===== -->
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 10-13. COMPONENT PAGES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Componentes AI Core", "AI Core Components"), @<div>
                <XFGrid Cols="1" Md="2" Lg="3" Gap="4">
                    @foreach (var item in ComponentItems) { @ComponentCard(item) }
                </XFGrid>
            </div>)
        </XFStack>

        <!-- ===== 14. API ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <!-- ===== 13. Eventos ===== -->
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
            <!-- ===== 14. Suporte de teclado ===== -->
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            <!-- ===== 15. Acessibilidade ===== -->
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            <!-- ===== 16. Responsividade ===== -->
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            <!-- ===== 17. Performance ===== -->
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <!-- ===== 18. Cenarios enterprise ===== -->
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            <!-- ===== 19. Padroes de composicao ===== -->
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            <!-- ===== 20. Boas praticas de UX ===== -->
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            <!-- ===== 21. Anti-padroes ===== -->
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <!-- ===== 22. Design Tokens ===== -->
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            <!-- ===== 23. Temas ===== -->
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            <!-- ===== 24. Testes ===== -->
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            <!-- ===== 25. Limitacoes conhecidas ===== -->
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            <!-- ===== 26. Componentes relacionados ===== -->
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string ProductLabelText => T("Commercial AI", "Commercial AI");
    private string PageTitleText => T("AI Core Overview", "AI Core Overview");
    private string PageStatusText => T("Documentacao completa", "Complete docs");
    private string T(string pt, string en) => LanguageService.Text(pt, en);
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
            <XFStack Orientation="XFOrientation.Horizontal" Gap="3" Wrap="XFWrap.Wrap">
                <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFAiChat" />
                <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Info" Text="XFAiPromptBox" />
                <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Warning" Text="XFAiCommandPalette" />
            </XFStack>
            <XFStack Orientation="XFOrientation.Horizontal" Gap="3" Wrap="XFWrap.Wrap" Class="mt-2">
                <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Success" Text="XFAiSuggestionPanel" />
                <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Secondary" Text="XFAiProviderConfig" />
            </XFStack>
        </div>
    </XFStack>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("5 componentes AI Core", "5 AI Core components"), T("Chat, PromptBox, CommandPalette, SuggestionPanel, ProviderConfig.", "Chat, PromptBox, CommandPalette, SuggestionPanel, ProviderConfig."), "cubes"),
        new(T("8 providers suportados", "8 providers supported"), T("OpenAI, Ollama, Gemini, Azure, Anthropic, LocalLlm, OpenRouter, Generic.", "OpenAI, Ollama, Gemini, Azure, Anthropic, LocalLlm, OpenRouter, Generic."), "plug"),
        new(T("Streaming SSE", "Streaming SSE"), T("Server-Sent Events em tempo real para todos os providers.", "Real-time Server-Sent Events for all providers."), "bolt")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Module", "AI Core"),
        new("Namespace", "XForge.DesignSystem.Components.AI"),
        new("Package", "XForge.DesignSystem"),
        new("Category", "AI / Core"),
        new("Status", T("Estavel", "Stable")),
        new("Components", "5 (XFAiChat, XFAiPromptBox, XFAiCommandPalette, XFAiSuggestionPanel, XFAiProviderConfig)"),
        new("Providers", "8 (OpenAI, Ollama, Gemini, Azure, Anthropic, LocalLlm, OpenRouter, Generic)"),
        new("Theme support", T("Light, dark e data-brand via tokens.", "Light, dark and data-brand via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new("XFAiChat", T("Copilot conversacional com streaming, historico e anexos.", "Conversational copilot with streaming, history and attachments."), "comments"),
        new("XFAiPromptBox", T("Caixa de prompt com autocompletar e variaveis.", "Prompt box with autocomplete and variables."), "terminal"),
        new("XFAiCommandPalette", T("Paleta de comandos com busca fuzzy.", "Command palette with fuzzy search."), "magnifying-glass"),
        new("XFAiSuggestionPanel", T("Painel de sugestoes contextuais AI.", "AI contextual suggestions panel."), "lightbulb"),
        new("XFAiProviderConfig", T("Configuracao visual de providers AI.", "Visual AI provider configuration."), "gear"),
        new("IAiProvider", T("Interface unificada para 8 providers.", "Unified interface for 8 providers."), "plug")
    ];

    // === PURPOSE ===
    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Chat conversacional", "Conversational chat"), T("Interacoes IA com streaming e historico.", "AI interactions with streaming and history."), "comments"),
        new(T("Prompt engineering", "Prompt engineering"), T("Construcao e gerenciamento de prompts.", "Prompt construction and management."), "pen"),
        new(T("Navegacao por comandos", "Command navigation"), T("Acesso rapido a funcoes AI via paleta.", "Quick access to AI functions via palette."), "keyboard")
    ];

    // === PROBLEM SOLVED ===
    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Cada integracao AI era feita do zero.", "Each AI integration was built from scratch."), "xmark"),
        new(T("Depois", "After"), T("Componentes reutilizaveis com provider abstraction.", "Reusable components with provider abstraction."), "check"),
        new(T("Acessibilidade", "Accessibility"), T("WCAG AAA em todos os componentes AI.", "WCAG AAA across all AI components."), "universal-access")
    ];

    // === WHEN TO USE ===
    private IReadOnlyList<DocTile> UseItems => [
        new(T("Copilots", "Copilots"), T("Chatbots para suporte, atendimento e product tour.", "Chatbots for support, service and product tour."), "robot"),
        new(T("Assistentes", "Assistants"), T("Assistentes de codigo, dados e financa.", "Code, data and finance assistants."), "wand-magic-sparkles"),
        new(T("Navegacao AI", "AI Navigation"), T("Command palettes para acesso rapido a acoes AI.", "Command palettes for quick access to AI actions."), "terminal"),
        new(T("Sugestoes", "Suggestions"), T("Paineis de sugestoes contextuais em forms e grids.", "Contextual suggestion panels in forms and grids."), "lightbulb")
    ];

    // === WHEN NOT TO USE ===
    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Conteudo estatico", "Static content"), T("Use XFCard para conteudo que nao muda.", "Use XFCard for content that doesn't change."), "file"),
        new(T("Formularios simples", "Simple forms"), T("Use XFField + XFInput para inputs diretos.", "Use XFField + XFInput for direct inputs."), "pen-to-square")
    ];

    // === ARCHITECTURE ===
    private IReadOnlyList<DocTile> ArchitectureItems => [
        new("IAiProvider", T("Interface com CompleteAsync, StreamAsync, EmbedAsync.", "Interface with CompleteAsync, StreamAsync, EmbedAsync."), "plug"),
        new("StreamingHub", T("SignalR hub para SSE em Blazor Server.", "SignalR hub for SSE in Blazor Server."), "tower-broadcast"),
        new("AiProviderBase", T("Classe abstrata com retry, circuit breaker e logging.", "Abstract class with retry, circuit breaker and logging."), "shield")
    ];

    // === DESIGN PRINCIPLES ===
    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(T("Component-first", "Component-first"), T("Cada feature AI e um componente Blazor reutilizavel.", "Each AI feature is a reusable Blazor component."), "cubes"),
        new(T("Provider-agnostic", "Provider-agnostic"), T("Mesmos componentes para 8 providers diferentes.", "Same components for 8 different providers."), "plug"),
        new(T("Streaming-first", "Streaming-first"), T("Respostas em tempo real para melhor UX.", "Real-time responses for better UX."), "bolt")
    ];

    // === COMPONENT PAGES ===
    private IReadOnlyList<ComponentPage> ComponentItems => [
        new("XFAiChat", T("Copilot conversacional enterprise com streaming, historico, anexos, voz e citacoes.", "Enterprise conversational copilot with streaming, history, attachments, voice and citations."), "/ai/chat", "comments", "XFBadgeColor.Primary"),
        new("XFAiPromptBox", T("Caixa de prompt com autocomplete, variaveis, templates e validacao de tokens.", "Prompt box with autocomplete, variables, templates and token validation."), "/ai/prompt-box", "terminal", "XFBadgeColor.Info"),
        new("XFAiCommandPalette", T("Paleta de comandos com busca fuzzy, categorias e execucao de acoes AI.", "Command palette with fuzzy search, categories and AI action execution."), "/ai/command-palette", "magnifying-glass", "XFBadgeColor.Warning"),
        new("XFAiSuggestionPanel", T("Painel de sugestoes contextuais com scoring, filtros e acoes rapidas.", "Contextual suggestions panel with scoring, filters and quick actions."), "/ai/suggestion-panel", "lightbulb", "XFBadgeColor.Success"),
        new("XFAiProviderConfig", T("Configuracao visual de providers com health check, testes e fallback.", "Visual provider configuration with health check, tests and fallback."), "/ai/providers", "gear", "XFBadgeColor.Secondary")
    ];

    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("XFAiChat", "Component", "-", T("Copilot conversacional com streaming e historico.", "Conversational copilot with streaming and history.")),
        new("XFAiPromptBox", "Component", "-", T("Caixa de prompt com autocomplete e variaveis.", "Prompt box with autocomplete and variables.")),
        new("XFAiCommandPalette", "Component", "-", T("Paleta de comandos com busca fuzzy.", "Command palette with fuzzy search.")),
        new("XFAiSuggestionPanel", "Component", "-", T("Painel de sugestoes contextuais.", "Contextual suggestions panel.")),
        new("XFAiProviderConfig", "Component", "-", T("Configuracao de providers AI.", "AI provider configuration.")),
        new("IAiProvider", "Interface", "-", T("Interface unificada para todos os providers.", "Unified interface for all providers.")),
        new("AiProviderBase", "Abstract", "-", T("Classe base com retry e health check.", "Base class with retry and health check."))
    ];

    // === EVENTS ===
    private IReadOnlyList<NameValueRow> EventRows => [
        new(T("MessageSent", "MessageSent"), T("Disparado quando uma mensagem e enviada.","Fired when a message is sent.")),
        new(T("StreamChunk", "StreamChunk"), T("Disparado para cada chunk de streaming.","Fired for each streaming chunk."))
    ];

    // === KEYBOARD ===
    private IReadOnlyList<NameValueRow> KeyboardRows => [
        new("Enter", T("Enviar mensagem.","Send message.")),
        new("Escape", T("Fechar dropdown.","Close dropdown.")),
        new("Tab", T("Navegar entre campos.","Navigate between fields."))
    ];

    // === ACCESSIBILITY ===
    private IReadOnlyList<DocTile> AccessibilityItems => [
        new(T("WCAG AAA", "WCAG AAA"), T("Todos os componentes seguem WCAG 2.1 nivel AAA.", "All components follow WCAG 2.1 level AAA."), "universal-access"),
        new(T("role=chat", "role=chat"), T("XFAiChat usa role=chat para leitores de tela.", "XFAiChat uses role=chat for screen readers."), "comments"),
        new(T("aria-live", "aria-live"), T("Respostas AI usam aria-live para anuncios.", "AI responses use aria-live for announcements."), "volume-high"),
        new(T("Navegacao por teclado", "Keyboard navigation"), T("Tab, Enter, Escape em todos os componentes AI.", "Tab, Enter, Escape across all AI components."), "keyboard")
    ];

    // === RESPONSIVENESS ===
    private IReadOnlyList<DocTile> ResponsivenessItems => [
        new(T("Layout adaptativo", "Adaptive layout"), T("Colapsa para empilhado em mobile.", "Collapses to stacked on mobile."), "mobile-screen"),
        new(T("Touch targets", "Touch targets"), T("Minimo 44px para todos os controles interativos.", "Minimum 44px for all interactive controls."), "hand-pointer")
