                             ReadOnly="true" />
    </XFStack>;

    private RenderFragment ExCustomPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiSqlQueryBuilder Title="Preview customizado"
                             Schema="tabela pedidos(id, cliente, total, status)"
                             ReadOnly="true" />
    </XFStack>;

    private const string Code1 = @"<XFAiSqlQueryBuilder Title=""Consulta segura""
          Schema=""tabela pedidos(id, cliente, total, status)""
          MaxRows=""100""
          ReadOnly=""true"" />";

    private const string Code2 = @"<XFAiSqlQueryBuilder Title=""Schema completo""
          Schema=""pedidos(id, cliente_id, total, status, criado_em), clientes(id, nome, cnpj, cidade)""
          MaxRows=""50""
          ReadOnly=""true"" />";

    private const string Code3 = @"<XFAiSqlQueryBuilder Title=""Com aprovacao""
