                             MaxRows="100"
                             ReadOnly="true" />
    </XFStack>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("Linguagem natural", "Natural language"), T("Describe em portugues e receba SQL.", "Describe in Portuguese and get SQL."), "language"),
        new(T("Bloqueio DML", "DML blocking"), T("Bloqueia DELETE, DROP, ALTER, INSERT e UPDATE.", "Blocks DELETE, DROP, ALTER, INSERT and UPDATE."), "shield"),
        new(T("Aprovacao humana", "Human approval"), T("Exige aprovacao para operacoes nao-leitura.", "Requires approval for non-read operations."), "user-check")
    ];

    // === METADATA ===
