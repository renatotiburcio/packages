        new(T("Transparencia", "Transparency"), T("Explicacao e otimizacao visiveis para o usuario.", "Explanation and optimization visible to user."), "eye"),
        new(T("Aprovacao", "Approval"), T("Operacoes perigosas exigem aprovacao humana.", "Dangerous operations require human approval."), "user-check")
    ];

    // === EXAMPLES ===
    private RenderFragment ExReadOnly() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiSqlQueryBuilder Title="Consulta segura"
                             Schema="tabela pedidos(id, cliente, total, status)"
