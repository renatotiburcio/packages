        <XFAiSqlQueryBuilder Title="Schema completo"
                             Schema="pedidos(id, cliente_id, total, status, criado_em), clientes(id, nome, cnpj, cidade)"
                             MaxRows="50"
                             ReadOnly="true" />
    </XFStack>;

    private RenderFragment ExApproval() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
