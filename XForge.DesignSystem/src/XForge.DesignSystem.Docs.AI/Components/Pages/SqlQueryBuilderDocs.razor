        new(T("Aprovacao", "Approval"), T("Workflow de aprovacao para DML.", "Approval workflow for DML."), "user-check")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Analise de dados", "Data analysis"), T("Consultas seguras por usuarios nao-tecnicos.", "Safe queries by non-technical users."), "chart-bar"),
        new(T("BI self-service", "Self-service BI"), T("Dashboards com consultas sob demanda.", "Dashboards with on-demand queries."), "chart-pie"),
