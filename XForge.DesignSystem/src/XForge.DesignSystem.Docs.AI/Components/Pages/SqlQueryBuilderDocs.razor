        new(T("SQL Preview", "SQL Preview"), T("Bloco de codigo com SQL gerado e botao copiar.", "Code block with generated SQL and copy button."), "code"),
        new(T("Validacao", "Validation"), T("Barra de status de validacao e confianca.", "Validation status and confidence bar."), "shield-check")
