@page "/ai/suggestion-panel"
@inject XForgeDocsLanguageService L

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.AiItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFAiSuggestionPanel" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@L.Text("4 tipos, confianca, dismiss", "4 types, confidence, dismiss")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @L.Text("Lista de sugestoes acionaveis geradas por AI, com tipo semantico, score de confianca, dismiss e callbacks de selecao.",
                                   "List of actionable AI-generated suggestions with semantic type, confidence score, dismiss and selection callbacks.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @L.Text("Painel de insights AI para workflows, com 4 tipos visuais (Action, Insight, Warning, Recommendation), barra de confianca, estados de loading e vazio, e suporte a templates customizados.",
                                   "AI insight panel for workflows, with 4 visual types (Action, Insight, Warning, Recommendation), confidence bar, loading and empty states, and custom template support.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(L.Text("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, L.Text("Campo", "Field"), L.Text("Valor", "Value"))</div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("Blazor Server e Blazor WebAssembly", @<div>
                <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@L.Text("Compatibilidade", "Compatibility")</XFTypography>
                    <XFTable Striped="true" Hoverable="true" Compact="true">
                        <XFTableHeader><XFTableRow><XFTableCell Header="true">@L.Text("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@L.Text("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@L.Text("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                        <XFTableBody>
                            <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                            <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                            <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@L.Text("Limitado", "Limited")" /></XFTableCell><XFTableCell>@L.Text("Renderiza como HTML estatico. Sem eventos.", "Renders as static HTML. No events.")</XFTableCell></XFTableRow>
                        </XFTableBody>
                    </XFTable>
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@L.Text("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@L.Text("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS.")</XFTypography>
                </XFStack>
            </div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(L.Text("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(L.Text("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(L.Text("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(L.Text("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(L.Text("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(L.Text("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 6 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(L.Text("1. Basico", "1. Basic"), L.Text("Sugestoes com tipos e confianca.", "Suggestions with types and confidence."), ExBasic(), Code1)
            @Example(L.Text("2. Com dismiss", "2. With dismiss"), L.Text("Botoes de dismiss para dispensar sugestoes.", "Dismiss buttons to dismiss suggestions."), ExWithDismiss(), Code2)
            @Example(L.Text("3. Loading", "3. Loading"), L.Text("Estado de carregamento com skeleton.", "Loading state with skeleton."), ExLoading(), Code3)
            @Example(L.Text("4. Vazio", "4. Empty"), L.Text("Estado vazio quando nao ha sugestoes.", "Empty state when no suggestions."), ExEmpty(), Code4)
            @Example(L.Text("5. Sem confianca", "5. No confidence"), L.Text("Ocultar barra de confianca.", "Hide confidence bar."), ExNoConfidence(), Code5)
            @Example(L.Text("6. MaxSuggestions", "6. Max suggestions"), L.Text("Limite de sugestoes visiveis.", "Visible suggestions limit."), ExMaxSuggestions(), Code6)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(L.Text("Eventos", "Events"), @<div>@NameValueTable(EventRows, L.Text("Evento", "Event"), L.Text("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(L.Text("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, L.Text("Tecla", "Key"), L.Text("Comportamento", "Behavior"))</div>)
            @Section(L.Text("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(L.Text("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(L.Text("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(L.Text("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(L.Text("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", L.Text("Proposito", "Purpose"))</div>)
            @Section(L.Text("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(L.Text("Testes", "Testing"), @<div>@NameValueTable(TestingRows, L.Text("Cobertura", "Coverage"), L.Text("Evidencia", "Evidence"))</div>)
            @Section(L.Text("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, L.Text("Limitacao", "Limitation"), L.Text("Status", "Status"))</div>)
            @Section(L.Text("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, L.Text("Pergunta", "Question"), L.Text("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, L.Text("Versao", "Version"), L.Text("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>

    <XForgeDocsPageStandard ComponentName="SuggestionPanelDocs" />
</XForgeDocsShell>
@code {
    private string ProductLabelText => L.Text("AI Commercial", "AI Commercial");
    private string PageTitleText => L.Text("XFAiSuggestionPanel", "XFAiSuggestionPanel");
    private string PageStatusText => L.Text("Documentacao completa", "Complete docs");
    private string CopyableCodeTitle => L.Text("Codigo copiavel", "Copyable code");

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiSuggestionPanel Suggestions="Suggestions"
                             ShowConfidence="true"
                             ShowDismiss="false" />
    </XFStack>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(L.Text("4 tipos visuais", "4 visual types"), L.Text("Action (azul), Insight (roxo), Warning (amber), Recommendation (verde).", "Action (blue), Insight (purple), Warning (amber), Recommendation (green)."), "palette"),
        new(L.Text("Score de confianca", "Confidence score"), L.Text("Barra de progresso com percentual de confianca AI.", "Progress bar with AI confidence percentage."), "chart-line"),
        new(L.Text("Loading e vazio", "Loading and empty"), L.Text("Estados de carregamento e lista vazia.", "Loading and empty list states."), "spinner")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFAiSuggestionPanel"),
        new("Namespace", "XForge.DesignSystem.Components.AI.Insights"),
        new("Package", "XForge.DesignSystem.AI"),
        new("Category", "AI / Insights"),
        new("Status", L.Text("Estavel", "Stable")),
        new("Accessibility", L.Text("role=complementary, role=list, role=listitem, aria-label, aria-busy, aria-live=polite.", "role=complementary, role=list, role=listitem, aria-label, aria-busy, aria-live=polite.")),
        new("Theme support", L.Text("Light, dark e data-theme via tokens.", "Light, dark and data-theme via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(L.Text("Painel de sugestoes AI", "AI suggestion panel"), L.Text("Lista de sugestoes acionaveis com tipos semanticos.", "List of actionable suggestions with semantic types."), "lightbulb"),
        new(L.Text("4 tipos visuais", "4 visual types"), L.Text("Action, Insight, Warning, Recommendation com cores.", "Action, Insight, Warning, Recommendation with colors."), "palette"),
        new(L.Text("Confianca AI", "AI confidence"), L.Text("Barra de progresso com score de confianca.", "Progress bar with confidence score."), "chart-line")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(L.Text("Insights AI", "AI insights"), L.Text("Exibicao de insights gerados por modelos AI.", "Display of insights generated by AI models."), "brain"),
        new(L.Text("Recomendacoes", "Recommendations"), L.Text("Sugestoes de acao baseadas em dados.", "Data-driven action suggestions."), "circle-check"),
        new(L.Text("Alertas", "Alerts"), L.Text("Avisos e warnings com prioridade visual.", "Warnings with visual priority."), "triangle-exclamation")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(L.Text("Antes", "Before"), L.Text("Insights AI sem apresentacao padronizada.", "AI insights without standardized presentation."), "xmark"),
        new(L.Text("Depois", "After"), L.Text("Painel com 4 tipos, confianca e dismiss.", "Panel with 4 types, confidence and dismiss."), "check"),
        new(L.Text("Acessibilidade", "Accessibility"), L.Text("role=complementary, role=list, aria-live para leitores de tela.", "role=complementary, role=list, aria-live for screen readers."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(L.Text("Dashboard AI", "AI dashboard"), L.Text("Exibicao de insights em dashboards AI.", "Display insights in AI dashboards."), "chart-line"),
        new(L.Text("Workflows", "Workflows"), L.Text("Sugestoes contextuais em fluxos de trabalho.", "Contextual suggestions in workflows."), "arrows-rotate")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(L.Text("Notificacoes", "Notifications"), L.Text("Use XFToast para notificacoes.", "Use XFToast for notifications."), "bell"),
        new(L.Text("Listas estaticas", "Static lists"), L.Text("Use XFTable para dados estaticos.", "Use XFTable for static data."), "table")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new("Header", L.Text("Titulo e acoes do painel.", "Panel title and actions."), "heading"),
        new("Suggestion Item", L.Text("Cada sugestao com icone, titulo, descricao e confianca.", "Each suggestion with icon, title, description and confidence."), "lightbulb"),
        new("Icon Container", L.Text("Container colorido por tipo.", "Color container by type."), "palette"),
        new("Confidence Bar", L.Text("Barra de progresso com percentual.", "Progress bar with percentage."), "chart-line"),
        new("Dismiss Button", L.Text("Botao para dispensar sugestao.", "Button to dismiss suggestion."), "xmark")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(L.Text("Tipo = cor", "Type = color"), L.Text("Cada tipo tem uma cor semantica.", "Each type has a semantic color."), "palette"),
        new(L.Text("Confianca transparente", "Transparent confidence"), L.Text("Score de confianca visivel para o usuario.", "Visible confidence score for the user."), "chart-line"),
        new(L.Text("Acao possivel", "Possible action"), L.Text("Cada sugestao e clicavel e acionavel.", "Each suggestion is clickable and actionable."), "bolt")
    ];

    // === EXAMPLES ===
    private RenderFragment ExBasic() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiSuggestionPanel Suggestions="Suggestions"
                             ShowConfidence="true"
                             ShowDismiss="false" />
    </XFStack>;

    private RenderFragment ExWithDismiss() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiSuggestionPanel Suggestions="Suggestions"
                             ShowConfidence="true"
                             ShowDismiss="true" />
    </XFStack>;

    private RenderFragment ExLoading() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiSuggestionPanel Loading="true"
                             LoadingText="Analisando dados..." />
    </XFStack>;

    private RenderFragment ExEmpty() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiSuggestionPanel EmptyText="Nenhuma sugestao no momento." />
    </XFStack>;

    private RenderFragment ExNoConfidence() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiSuggestionPanel Suggestions="Suggestions"
                             ShowConfidence="false"
                             ShowDismiss="false" />
    </XFStack>;

    private RenderFragment ExMaxSuggestions() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFAiSuggestionPanel Suggestions="Suggestions"
                             MaxSuggestions="2"
                             ShowConfidence="true"
                             ShowDismiss="true" />
    </XFStack>;

    private const string Code1 = @"<XFAiSuggestionPanel Suggestions=""Suggestions""
                             ShowConfidence=""true""
                             ShowDismiss=""false"" />";
    private const string Code2 = @"<XFAiSuggestionPanel Suggestions=""Suggestions""
                             ShowConfidence=""true""
                             ShowDismiss=""true"" />";
    private const string Code3 = @"<XFAiSuggestionPanel Loading=""true""
                             LoadingText=""Analisando dados..."" />";
    private const string Code4 = @"<XFAiSuggestionPanel EmptyText=""Nenhuma sugestao no momento."" />";
    private const string Code5 = @"<XFAiSuggestionPanel Suggestions=""Suggestions""
                             ShowConfidence=""false""
                             ShowDismiss=""false"" />";
    private const string Code6 = @"<XFAiSuggestionPanel Suggestions=""Suggestions""
                             MaxSuggestions=""2""
                             ShowConfidence=""true""
                             ShowDismiss=""true"" />";

    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("Suggestions", "IReadOnlyList<XFAiSuggestion>", "[]", L.Text("Lista de sugestoes AI.", "List of AI suggestions.")),
        new("Title", "string", "\"Sugestoes\"", L.Text("Titulo do painel.", "Panel title.")),
        new("ShowTitle", "bool", "true", L.Text("Exibe titulo do painel.", "Shows panel title.")),
        new("ShowIcons", "bool", "true", L.Text("Exibe icones por tipo.", "Shows icons by type.")),
        new("ShowDismiss", "bool", "true", L.Text("Exibe botao de dismiss.", "Shows dismiss button.")),
        new("ShowConfidence", "bool", "false", L.Text("Exibe barra de confianca.", "Shows confidence bar.")),
        new("MaxSuggestions", "int", "5", L.Text("Numero maximo de sugestoes visiveis.", "Maximum visible suggestions.")),
        new("Loading", "bool", "false", L.Text("Estado de carregamento.", "Loading state.")),
        new("EmptyText", "string", "\"Nenhuma sugestao\"", L.Text("Texto do estado vazio.", "Empty state text.")),
        new("LoadingText", "string", "\"Analisando...\"", L.Text("Texto do estado de loading.", "Loading state text."))
    ];

    private IReadOnlyList<NameValueRow> EventRows => [
        new("OnSuggestionClick", L.Text("Disparado quando uma sugestao e clicada.", "Fired when a suggestion is clicked.")),
        new("OnDismiss", L.Text("Disparado quando uma sugestao e dispensada.", "Fired when a suggestion is dismissed.")),
        new("SuggestionsChanged", L.Text("Disparado quando a lista de sugestoes muda.", "Fired when the suggestion list changes."))
    ];

    // === ACCESSIBILITY ===
    private IReadOnlyList<DocTile> AccessibilityItems => [
        new(L.Text("role=complementary", "role=complementary"), L.Text("Painel usa role=complementary para leitores de tela.", "Panel uses role=complementary for screen readers."), "universal-access"),
        new(L.Text("role=list + listitem", "role=list + listitem"), L.Text("Lista semantica de sugestoes.", "Semantic list of suggestions."), "list"),
        new(L.Text("aria-label", "aria-label"), L.Text("Label descritivo em cada sugestao com confianca.", "Descriptive label on each suggestion with confidence."), "tag"),
        new(L.Text("aria-live=polite", "aria-live=polite"), L.Text("Notifica mudancas de sugestoes.", "Notifies suggestion changes."), "volume-high")
    ];

    private IReadOnlyList<NameValueRow> KeyboardRows => [
        new("Enter / Space", L.Text("Ativa a sugestao selecionada.", "Activates the selected suggestion.")),
        new("Delete / Backspace", L.Text("Dispensa a sugestao (quando ShowDismiss=true).", "Dismisses the suggestion (when ShowDismiss=true).")),
        new("Tab", L.Text("Move foco entre sugestoes.", "Moves focus between suggestions."))
    ];

    // === RESPONSIVENESS ===
    private IReadOnlyList<DocTile> ResponsivenessItems => [
        new(L.Text("Largura total", "Full width"), L.Text("Painel ocupa 100% do container.", "Panel occupies 100% of container."), "maximize"),
        new(L.Text("Layout responsivo", "Responsive layout"), L.Text("Sugestoes empilham em mobile.", "Suggestions stack on mobile."), "mobile-screen")
    ];

    // === PERFORMANCE ===
    private IReadOnlyList<DocTile> PerformanceItems => [
        new(L.Text("Zero JS", "Zero JS"), L.Text("Nenhum JavaScript interop.", "No JavaScript interop."), "bolt"),
        new(L.Text("Render leve", "Light render"), L.Text("Tags ul/li nativas sem wrappers.", "Native ul/li tags without wrappers."), "feather")
    ];

    // === SCENARIOS ===
    private IReadOnlyList<DocTile> ScenarioItems => [
        new(L.Text("Dashboard fiscal", "Fiscal dashboard"), L.Text("Insights de analise fiscal com confianca.", "Fiscal analysis insights with confidence."), "file-invoice"),
        new(L.Text("Assistente AI", "AI assistant"), L.Text("Sugestoes contextuais para assistentes.", "Contextual suggestions for assistants."), "headset"),
        new(L.Text("Revisao de dados", "Data review"), L.Text("Warnings e recomendacoes durante revisao.", "Warnings and recommendations during review."), "magnifying-glass")
    ];

    // === COMPOSITION ===
    private IReadOnlyList<DocTile> CompositionItems => [
        new(L.Text("SuggestionPanel + Confidence", "SuggestionPanel + Confidence"), L.Text("Barra de confianca para decisoes criticas.", "Confidence bar for critical decisions."), "chart-line"),
        new(L.Text("SuggestionPanel + Dismiss", "SuggestionPanel + Dismiss"), L.Text("Dismiss para controle do usuario.", "Dismiss for user control."), "xmark"),
        new(L.Text("SuggestionPanel + Card", "SuggestionPanel + Card"), L.Text("Dentro de XFCard para contexto.", "Inside XFCard for context."), "square")
    ];

    // === BEST PRACTICES ===
    private IReadOnlyList<DocTile> BestPracticeItems => [
        new(L.Text("Tipos semanticos", "Semantic types"), L.Text("Use o tipo correto para cada situacao.", "Use the correct type for each situation."), "palette"),
        new(L.Text("Confianca quando util", "Confidence when useful"), L.Text("Mostre confianca em decisoes criticas.", "Show confidence in critical decisions."), "chart-line"),
        new(L.Text("MaxSuggestions adequado", "Adequate MaxSuggestions"), L.Text("Limite a 3-5 para performance.", "Limit to 3-5 for performance."), "bars"),
        new(L.Text("EmptyText descritivo", "Descriptive EmptyText"), L.Text("Descreva por que nao ha sugestoes.", "Describe why there are no suggestions."), "align-left")
    ];

    // === ANTI-PATTERNS ===
    private IReadOnlyList<DocTile> AntiPatternItems => [
        new(L.Text("Sem tipo", "No type"), L.Text("Sugestoes sem tipo perdem contexto visual.", "Suggestions without type lose visual context."), "xmark"),
        new(L.Text("Muitas sugestoes", "Too many suggestions"), L.Text("Lista longa sem MaxScreens e sobrecarregada.", "Long list without MaxSuggestions is overwhelming."), "ban"),
        new(L.Text("Sem dismiss", "No dismiss"), L.Text("Usuario nao pode dispensar sugestoes irrelevantes.", "User cannot dismiss irrelevant suggestions."), "triangle-exclamation")
    ];

    // === TOKENS ===
    private IReadOnlyList<NameValueRow> TokenRows => [
        new("panel", L.Text("overflow-hidden rounded-xl border border-border-light bg-bg-surface shadow.", "overflow-hidden rounded-xl border border-border-light bg-bg-surface shadow.")),
        new("header", L.Text("flex items-center justify-between gap-2 border-b border-border-light px-4 py-3.", "flex items-center justify-between gap-2 border-b border-border-light px-4 py-3.")),
        new("suggestion", L.Text("group relative flex items-start gap-3 px-4 py-3.", "group relative flex items-start gap-3 px-4 py-3.")),
        new("confidence", L.Text("h-1 w-16 overflow-hidden rounded-full bg-surface-200.", "h-1 w-16 overflow-hidden rounded-full bg-surface-200."))
    ];

    // === THEMING ===
    private IReadOnlyList<DocTile> ThemeItems => [
        new("data-theme", L.Text("Tokens light/dark via CSS variables.", "Light/dark tokens via CSS variables."), "moon"),
        new("data-brand", L.Text("Cores de tipo acompanham marca ativa.", "Type colors follow active brand."), "swatchbook")
    ];

    // === TESTING ===
    private IReadOnlyList<NameValueRow> TestingRows => [
        new("Unit", L.Text("Testes de render, tipos, confianca, dismiss, loading, vazio.", "Render, types, confidence, dismiss, loading, empty tests.")),
        new("Accessibility", L.Text("role=complementary, role=list, aria-label, aria-live.", "role=complementary, role=list, aria-label, aria-live."))
    ];

    // === LIMITATIONS ===
    private IReadOnlyList<NameValueRow> LimitationRows => [
        new("Static SSR", L.Text("Eventos de clique e dismiss nao funcionam em SSR estatico.", "Click and dismiss events do not work in static SSR.")),
        new("MaxSuggestions", L.Text(" Lista muito longa pode afetar performance.", "Very long list may affect performance."))
    ];

    // === RELATED ===
    private IReadOnlyList<DocTile> RelatedComponentItems => [
