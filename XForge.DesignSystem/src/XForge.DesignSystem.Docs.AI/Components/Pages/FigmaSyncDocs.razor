        new(L.Text("Sync + Card", "Sync + Card"), L.Text("Painel dentro de XFCard para contexto.", "Panel inside XFCard for context."), "square"),
        new(L.Text("Sync + Status", "Sync + Status"), L.Text("Cards de status para visibilidade do time.", "Status cards for team visibility."), "chart-bar")
    ];

    // === BEST PRACTICES ===
    private IReadOnlyList<DocTile> BestPracticeItems => [
