        new(L.Text("Limitar tokens visiveis", "Limit visible tokens"), L.Text("Use MaxVisibleTokens para performance.", "Use MaxVisibleTokens for performance."), "maximize"),
        new(L.Text("Tratar conflitos", "Handle conflicts"), L.Text("Identifique e resolva conflitos antes de exportar.", "Identify and resolve conflicts before export."), "triangle-exclamation"),
        new(L.Text("Botoes com labels", "Buttons with labels"), L.Text("Sempre adicione aria-label em botoes de acao.", "Always add aria-label on action buttons."), "tag")
