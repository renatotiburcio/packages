        new(L.Text("CI/CD pipeline", "CI/CD pipeline"), L.Text("Sincronizacao automatica em builds.", "Automatic sync in builds."), "gear"),
        new(L.Text("Multi-projeto", "Multi-project"), L.Text("Sincronizar tokens entre multiplos projetos.", "Sync tokens across multiple projects."), "sitemap")
    ];

    // === COMPOSITION ===
    private IReadOnlyList<DocTile> CompositionItems => [
