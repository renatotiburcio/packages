@page "/ai/figma-sync"
@using XForge.DesignSystem.Components.AI.Tooling
@inject XForgeDocsLanguageService L

<XForgeDocsShell ProductLabel="AI Commercial"
                 Title="XFFigmaSync"
                 Status="@L.Text("Estavel", "Stable")"
                 Items="XForgeDocsCatalog.AiItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFFigmaSync" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@L.Text("Import/Export/Bidirecional", "Import/Export/Bidirectional")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@L.Text("Deteccao de conflitos", "Conflict detection")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @L.Text("Sincronizacao de design tokens entre Figma e componentes implementados com direcao, conflitos e status.",
                                "Design token synchronization between Figma and implemented components with direction, conflicts and status.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @L.Text("Painel completo para sincronizacao com Figma, incluindo conexao/desconexao, importacao, exportacao, sincronizacao bidirecional, deteccao de conflitos, lista de tokens sincronizados e status de sincronizacao. Puro Blazor, sem JavaScript interop.",
                                "Complete panel for Figma synchronization, including connect/disconnect, import, export, bidirectional sync, conflict detection, synchronized token list and sync status. Pure Blazor, no JavaScript interop.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(L.Text("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, L.Text("Campo", "Field"), L.Text("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@L.Text("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@L.Text("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@L.Text("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@L.Text("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Funciona sem restricoes. Sincronizacao simulada.", "Works without restrictions. Simulated sync.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@L.Text("Sim", "Yes")" /></XFTableCell><XFTableCell>@L.Text("Renderiza como HTML estatico.", "Renders as static HTML.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@L.Text("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@L.Text("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(L.Text("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(L.Text("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(L.Text("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(L.Text("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(L.Text("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(L.Text("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 3 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(L.Text("1. Desconectado", "1. Disconnected"), L.Text("Painel com formulario de conexao.", "Panel with connection form."), ExDisconnected(), Code1)
            @Example(L.Text("2. Conectado com tokens", "2. Connected with Tokens"), L.Text("Painel conectado com tokens sincronizados.", "Connected panel with synchronized tokens."), ExConnected(), Code2)
            @Example(L.Text("3. Sem header e tokens", "3. Without Header and Tokens"), L.Text("Painel compacto sem cabecalho e com tokens.", "Compact panel without header and with tokens."), ExCompact(), Code3)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(L.Text("Eventos", "Events"), @<div>@NameValueTable(EventRows, L.Text("Evento", "Event"), L.Text("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(L.Text("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, L.Text("Tecla", "Key"), L.Text("Comportamento", "Behavior"))</div>)
            @Section(L.Text("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(L.Text("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(L.Text("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(L.Text("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(L.Text("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(L.Text("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", L.Text("Proposito", "Purpose"))</div>)
            @Section(L.Text("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(L.Text("Testes", "Testing"), @<div>@NameValueTable(TestingRows, L.Text("Cobertura", "Coverage"), L.Text("Evidencia", "Evidence"))</div>)
            @Section(L.Text("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, L.Text("Limitacao", "Limitation"), L.Text("Status", "Status"))</div>)
            @Section(L.Text("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, L.Text("Pergunta", "Question"), L.Text("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, L.Text("Versao", "Version"), L.Text("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string CopyableCodeTitle => L.Text("Codigo copiavel", "Copyable code");

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFFigmaSync Title="Figma Sync" ShowHeader="true" />
    </XFStack>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(L.Text("Sincronizacao Figma", "Figma sync"), L.Text("Import, export e bidirecional com deteccao de conflitos.", "Import, export and bidirectional with conflict detection."), "arrows-rotate"),
        new(L.Text("6 status", "6 statuses"), L.Text("Disconnected, Connected, Syncing, Synced, Error, Conflict.", "Disconnected, Connected, Syncing, Synced, Error, Conflict."), "signal"),
        new(L.Text("Zero JS", "Zero JS"), L.Text("Nenhum JavaScript interop. Puro C# + Tailwind.", "No JavaScript interop. Pure C# + Tailwind."), "bolt")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFFigmaSync"),
        new("Namespace", "XForge.DesignSystem.Components.AI.Tooling"),
        new("Package", "XForge.DesignSystem.AI"),
        new("Category", "AI / Tooling / Figma Sync"),
        new("Status", L.Text("Estavel", "Stable")),
        new("Accessibility", L.Text("role=region, aria-label, botoes com aria-label.", "role=region, aria-label, buttons with aria-label.")),
        new("Theme support", L.Text("Light, dark e data-theme via tokens.", "Light, dark and data-theme via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(L.Text("Sincronizacao com Figma", "Figma synchronization"), L.Text("Painel para conectar e sincronizar tokens.", "Panel to connect and sync tokens."), "arrows-rotate"),
        new(L.Text("3 direcoes", "3 directions"), L.Text("Import, Export e Bidirecional.", "Import, Export and Bidirectional."), "arrows-left-right"),
        new(L.Text("Status em tempo real", "Real-time status"), L.Text("6 estados com badges visuais.", "6 states with visual badges."), "signal")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(L.Text("Sincronizacao de tokens", "Token sync"), L.Text("Manter tokens de design entre Figma e codigo.", "Keep design tokens between Figma and code."), "arrows-rotate"),
        new(L.Text("Deteccao de conflitos", "Conflict detection"), L.Text("Identificar tokens divergentes entre fontes.", "Identify divergent tokens between sources."), "triangle-exclamation"),
        new(L.Text("Gerenciamento de acesso", "Access management"), L.Text("Conectar e desconectar com token de acesso.", "Connect and disconnect with access token."), "key")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(L.Text("Antes", "Before"), L.Text("Sincronizacao manual e propensa a erros.", "Manual synchronization prone to errors."), "xmark"),
        new(L.Text("Depois", "After"), L.Text("Painel com status, tokens e conflitos visiveis.", "Panel with status, tokens and visible conflicts."), "check"),
        new(L.Text("Acessibilidade", "Accessibility"), L.Text("Botoes com aria-label, status legivel.", "Buttons with aria-label, readable status."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(L.Text("Times de design", "Design teams"), L.Text("Sincronizar tokens entre designers e devs.", "Sync tokens between designers and devs."), "users"),
        new(L.Text("CI/CD", "CI/CD"), L.Text("Integrar sincronizacao em pipelines de build.", "Integrate sync into build pipelines."), "gear")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(L.Text("Edicao de tokens", "Token editing"), L.Text("Use XFThemeEditor para edicao visual.", "Use XFThemeEditor for visual editing."), "palette"),
        new(L.Text("Geracao de componentes", "Component generation"), L.Text("Use XFComponentGenerator.", "Use XFComponentGenerator."), "code")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new(L.Text("Header", "Header"), L.Text("Barra superior com titulo, badge de status e botoes de acao.", "Top bar with title, status badge and action buttons."), "bars"),
        new(L.Text("Connect form", "Connect form"), L.Text("Inputs para token de acesso e file key quando desconectado.", "Inputs for access token and file key when disconnected."), "key"),
        new(L.Text("Status panel", "Status panel"), L.Text("Cards com contadores de importados, exportados e conflitos.", "Cards with import, export and conflict counters."), "chart-bar"),
        new(L.Text("Token list", "Token list"), L.Text("Tabela de tokens sincronizados com status.", "Table of synchronized tokens with status."), "list")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(L.Text("Status visivel", "Visible status"), L.Text("Badge colorido para cada estado de sincronizacao.", "Colored badge for each sync state."), "eye"),
        new(L.Text("Direcao clara", "Clear direction"), L.Text("Selecao de Import, Export ou Bidirecional.", "Selection of Import, Export or Bidirectional."), "arrows-left-right"),
        new(L.Text("Feedback imediato", "Immediate feedback"), L.Text("Status atualizado apos cada acao de sincronizacao.", "Status updated after each sync action."), "bolt")
    ];

    // === EXAMPLES ===
    private RenderFragment ExDisconnected() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFFigmaSync Title="Figma Sync" ShowHeader="true" />
    </XFStack>;

    private RenderFragment ExConnected() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFFigmaSync Title="Figma Sync" ShowHeader="true" ShowStatusPanel="true" ShowTokenList="true"
                     DesignTokens="@SampleTokens" />
    </XFStack>;

    private RenderFragment ExCompact() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFFigmaSync Title="Compact Sync" ShowHeader="false" ShowStatusPanel="false" ShowTokenList="true"
                     DesignTokens="@SampleTokensSingle" />
    </XFStack>;

    private static IReadOnlyList<XFDesignToken> SampleTokens => new List<XFDesignToken>
    {
        new() { Name = "Primary", Value = "#6366f1", Category = XFDesignTokenCategory.Color },
        new() { Name = "Body Font", Value = "Inter, sans-serif", Category = XFDesignTokenCategory.Typography },
        new() { Name = "Md Spacing", Value = "1rem", Category = XFDesignTokenCategory.Spacing }
    };

    private static IReadOnlyList<XFDesignToken> SampleTokensSingle => new List<XFDesignToken>
    {
        new() { Name = "Primary", Value = "#6366f1", Category = XFDesignTokenCategory.Color }
    };

    private const string Code1 = @"<XFFigmaSync Title=""Figma Sync"" ShowHeader=""true"" />";
    private const string Code2 = @"<XFFigmaSync Title=""Figma Sync""
              ShowHeader=""true""
              ShowStatusPanel=""true""
              ShowTokenList=""true""
              DesignTokens=""@tokens"" />";
    private const string Code3 = @"<XFFigmaSync Title=""Compact Sync""
              ShowHeader=""false""
              ShowStatusPanel=""false""
              ShowTokenList=""true"" />";

    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("Title", "string", "\"Figma Sync\"", L.Text("Titulo do componente.", "Component title.")),
        new("AriaLabel", "string", "\"Sincronizacao com Figma\"", L.Text("Rotulo ARIA para acessibilidade.", "ARIA label for accessibility.")),
        new("ShowHeader", "bool", "true", L.Text("Exibe a barra de cabecalho.", "Shows the header bar.")),
        new("ShowStatusPanel", "bool", "true", L.Text("Exibe os cards de status.", "Shows the status cards.")),
        new("ShowTokenList", "bool", "true", L.Text("Exibe a tabela de tokens.", "Shows the token table.")),
        new("MaxVisibleTokens", "int", "50", L.Text("Numero maximo de tokens visiveis na lista.", "Maximum visible tokens in the list.")),
        new("DesignTokens", "IReadOnlyList<XFDesignToken>?", "null", L.Text("Tokens de design para sincronizar.", "Design tokens to sync.")),
        new("FigmaTokens", "IReadOnlyList<XFFigmaToken>?", "null", L.Text("Tokens Figma de sincronizacao anterior.", "Figma tokens from previous sync."))
    ];

    private IReadOnlyList<NameValueRow> EventRows => [
        new("OnConnected", L.Text("Disparado quando a conexao e estabelecida.", "Fired when connection is established.")),
        new("OnSyncComplete", L.Text("Disparado quando a sincronizacao termina. Retorna XFFigmaSyncResult.", "Fired when sync completes. Returns XFFigmaSyncResult.")),
        new("OnDisconnected", L.Text("Disparado quando a desconexao e solicitada.", "Fired when disconnect is requested."))
    ];

    // === ACCESSIBILITY ===
    private IReadOnlyList<DocTile> AccessibilityItems => [
        new(L.Text("role=region", "role=region"), L.Text("Componente usa role=region para leitores de tela.", "Component uses role=region for screen readers."), "universal-access"),
        new(L.Text("aria-label", "aria-label"), L.Text("Rotulo descritivo do painel de sincronizacao.", "Descriptive sync panel label."), "tag"),
        new(L.Text("Botoes com aria-label", "Buttons with aria-label"), L.Text("Conectar, Desconectar e Sincronizar com labels.", "Connect, Disconnect and Sync with labels."), "keyboard"),
        new(L.Text("Status legivel", "Readable status"), L.Text("Badge de status com texto alternativo.", "Status badge with alternative text."), "font")
    ];

    private IReadOnlyList<NameValueRow> KeyboardRows => [
        new("Tab", L.Text("Navega entre campos de entrada e botoes.", "Navigates between input fields and buttons.")),
        new("Enter", L.Text("Submete formulario ou ativa botao.", "Submits form or activates button.")),
        new("Space", L.Text("Ativa botoes de acao.", "Activates action buttons."))
    ];

    // === RESPONSIVENESS ===
    private IReadOnlyList<DocTile> ResponsivenessItems => [
        new(L.Text("Largura total", "Full width"), L.Text("Painel ocupa 100% do container.", "Panel occupies 100% of container."), "maximize"),
        new(L.Text("Layout responsivo", "Responsive layout"), L.Text("Cards de status em grid responsivo.", "Status cards in responsive grid."), "mobile-screen")
    ];

    // === PERFORMANCE ===
    private IReadOnlyList<DocTile> PerformanceItems => [
        new(L.Text("Zero JS", "Zero JS"), L.Text("Nenhum JavaScript interop.", "No JavaScript interop."), "bolt"),
        new(L.Text("Lista virtualizada", "Virtualized list"), L.Text("MaxVisibleTokens limita renderizacao da tabela.", "MaxVisibleTokens limits table rendering."), "feather")
    ];

