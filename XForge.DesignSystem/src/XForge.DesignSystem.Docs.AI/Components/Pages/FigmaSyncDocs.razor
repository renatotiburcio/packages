        new(L.Text("Muitos tokens sem limite", "Too many tokens without limit"), L.Text("Use MaxVisibleTokens para evitar listas longas.", "Use MaxVisibleTokens to avoid long lists."), "ban"),
        new(L.Text("Ignorar conflitos", "Ignore conflicts"), L.Text("Nunca exporte tokens com conflitos.", "Never export tokens with conflicts."), "triangle-exclamation")
