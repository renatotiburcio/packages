@page "/ai/validation-summary"
@inject XForgeDocsLanguageService L

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.AiItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFAiValidationSummary" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Diagnostico IA, severidade, fix", "AI diagnostics, severity, fix")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Resumo de validacoes com diagnostico IA, explicacao e sugestao de correcao.",
                               "Validation summary with AI diagnostics, explanation and fix suggestion.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("Painel enterprise para exibir itens de validacao com severidade, diagnostico automatico por IA, explicacao do erro e sugestao de correcao. Suporta provider IA, resolved state e empty state.",
                               "Enterprise panel to display validation items with severity, AI-powered diagnostics, error explanation and fix suggestion. Supports AI provider, resolved state and empty state.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Requer IAiProvider para diagnostico IA.", "Requires IAiProvider for AI diagnostics.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Requer IAiProvider para diagnostico IA.", "Requires IAiProvider for AI diagnostics.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Parcial", "Partial")" /></XFTableCell><XFTableCell>@T("Renderiza itens mas sem diagnostico IA.", "Renders items but no AI diagnostics.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Dependencias", "Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Requer IAiProvider injetado para diagnostico automatico. Renderizado com C# e Tailwind CSS. Sem JavaScript interop.", "Requires injected IAiProvider for automatic diagnostics. Rendered with C# and Tailwind CSS. No JavaScript interop.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 3 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Itens com severidade", "1. Items with severity"), T("Painel com itens de Error e Warning.", "Panel with Error and Warning items."), ExSeverity(), Code1)
            @Example(T("2. Com diagnostico IA", "2. With AI diagnostics"), T("Painel com explicacao e sugestao de correcao IA.", "Panel with AI explanation and fix suggestion."), ExDiagnosed(), Code2)
            @Example(T("3. Empty state", "3. Empty state"), T("Estado vazio quando nao ha validacoes pendentes.", "Empty state when no validations are pending."), ExEmpty(), Code3)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>

        <XForgeDocsPageStandard ComponentName="ValidationSummaryDocs" />
    </XFStack>
</XForgeDocsShell>
@code {
    private string ProductLabelText => T("AI Commercial", "AI Commercial");
    private string PageTitleText => T("XFAiValidationSummary", "XFAiValidationSummary");
    private string PageStatusText => T("Documentacao completa", "Complete docs");
    private string T(string pt, string en) => L.Text(pt, en);
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFAiValidationSummary Items="SampleItems" Title="@T("Validacoes fiscais", "Fiscal validations")" ShowHeader="true" />;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("4 severidades", "4 severities"), T("Info, Warning, Error e Critical com cores semanticas.", "Info, Warning, Error and Critical with semantic colors."), "triangle-exclamation"),
        new(T("Diagnostico IA", "AI diagnostics"), T("Provider IA gera explicacoes e sugestoes de correcao.", "AI provider generates explanations and fix suggestions."), "wand-magic-sparkles"),
        new(T("Zero JS", "Zero JS"), T("Nenhum JavaScript interop. Puro C# + Tailwind.", "No JavaScript interop. Pure C# + Tailwind."), "bolt")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFAiValidationSummary"),
        new("Namespace", "XForge.DesignSystem.Components.AI.Utility"),
        new("Package", "XForge.DesignSystem.AI"),
        new("Category", "AI / Utility"),
        new("Status", T("Estavel", "Stable")),
        new("Accessibility", T("role=region, aria-label, aria-busy, aria-live=polite.", "role=region, aria-label, aria-busy, aria-live=polite.")),
        new("Theme support", T("Light, dark e data-theme via tokens.", "Light, dark and data-theme via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("Resumo de validacao", "Validation summary"), T("Lista de itens com severidade, campo e mensagem.", "List of items with severity, field and message."), "list-check"),
        new(T("Diagnostico IA", "AI diagnostics"), T("Provider IA analisa e retorna explicacoes e fix suggestions.", "AI provider analyzes and returns explanations and fix suggestions."), "wand-magic-sparkles"),
        new(T("Resolved state", "Resolved state"), T("Itens podem ser marcados como resolvidos individualmente.", "Items can be marked as resolved individually."), "circle-check")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Formularios ERP", "ERP forms"), T("Exibir erros de validacao de campos de formulario.", "Display form field validation errors."), "pen-to-square"),
        new(T("Fiscal", "Fiscal"), T("Validacoes de CFOP, CST, NCM e regras fiscais.", "CFOP, CST, NCM and fiscal rule validations."), "file-invoice"),
        new(T("Conciliacao", "Reconciliation"), T("Erros de conciliacao bancaria e contabil.", "Bank and accounting reconciliation errors."), "scale-balanced")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Erros sem contexto, sem explicacao, sem fix suggestion.", "Errors without context, no explanation, no fix suggestion."), "xmark"),
        new(T("Depois", "After"), T("Painel com severidade, explicacao IA e sugestao de correcao.", "Panel with severity, AI explanation and fix suggestion."), "check"),
        new(T("Acessibilidade", "Accessibility"), T("role=region, aria-live, aria-busy para leitores de tela.", "role=region, aria-live, aria-busy for screen readers."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Validacoes de formulario", "Form validations"), T("Erros de campos obrigatorios, formatos e regras.", "Required fields, format and rule errors."), "pen-to-square"),
        new(T("Regras fiscais", "Fiscal rules"), T("CFOP incompativel, CST invalido, NCM divergente.", "Incompatible CFOP, invalid CST, divergent NCM."), "file-invoice")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Alertas simples", "Simple alerts"), T("Use XFAlert para mensagens pontuais.", "Use XFAlert for single messages."), "bell"),
        new(T("Notificacoes", "Notifications"), T("Use XFToast para feedback temporario.", "Use XFToast for temporary feedback."), "bell")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new("Header", T("Barra com titulo e badge de contagem.", "Bar with title and count badge."), "heading"),
        new("Item", T("Linha com icone de severidade, campo e mensagem.", "Row with severity icon, field and message."), "list-check"),
        new("Explanation", T("Area expansivel com explicacao IA.", "Expandable area with AI explanation."), "comment"),
        new("FixSuggestion", T("Sugestao de correcao com badge.", "Fix suggestion with badge."), "wrench"),
        new("Dismiss", T("Botao para marcar item como resolvido.", "Button to mark item as resolved."), "circle-check"),
        new("Empty", T("Estado vazio quando nao ha itens.", "Empty state when no items exist."), "inbox")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(T("Severidade visual", "Visual severity"), T("Cor e icone comunicam gravidade imediatamente.", "Color and icon communicate severity immediately."), "eye"),
        new(T("Contexto IA", "AI context"), T("Explicacao e fix suggestion adicionam valor.", "Explanation and fix suggestion add value."), "wand-magic-sparkles"),
        new(T("Acessivel", "Accessible"), T("aria-live notifica mudancas. aria-busy indica loading.", "aria-live notifies changes. aria-busy indicates loading."), "universal-access")
    ];

    // === EXAMPLES ===
    private RenderFragment ExSeverity() => @<XFAiValidationSummary Items="SampleItems" Title="@T("Validacoes fiscais", "Fiscal validations")" ShowHeader="true" />;

    private RenderFragment ExDiagnosed() => @<XFAiValidationSummary Items="DiagnosedItems" Title="@T("Com diagnostico IA", "With AI diagnostics")" ShowHeader="true" />;

    private RenderFragment ExEmpty() => @<XFAiValidationSummary Items="Array.Empty<XFAiValidationItem>()" Title="@T("Validacoes", "Validations")" ShowHeader="true" />;

    private const string Code1 = @"<XFAiValidationSummary Items=""@ValidationItems""
                     Title=""Validacoes fiscais""
                     ShowHeader=""true"" />";
    private const string Code2 = @"<XFAiValidationSummary Items=""@ValidationItems""
                     Title=""Com diagnostico IA""
                     ShowHeader=""true""
                     Provider=""@AiProvider"" />";
    private const string Code3 = @"<XFAiValidationSummary Items=""@Array.Empty<XFAiValidationItem>()""
                     Title=""Validacoes""
                     ShowHeader=""true"" />";

    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("Items", "IReadOnlyList<XFAiValidationItem>", "[]", T("Itens de validacao para exibir.", "Validation items to display.")),
        new("Title", "string", "\"Validacao\"", T("Titulo do painel.", "Panel title.")),
        new("ShowHeader", "bool", "true", T("Exibe barra de cabecalho.", "Shows header bar.")),
        new("ShowDismiss", "bool", "true", T("Exibe botoes de dismiss/resolve.", "Shows dismiss/resolve buttons.")),
        new("EmptyText", "string", "\"Nenhuma validacao pendente.\"", T("Texto do estado vazio.", "Empty state text.")),
        new("Provider", "IAiProvider?", "null", T("Provider IA para diagnosticos automaticos.", "AI provider for automatic diagnostics.")),
        new("SystemPrompt", "string?", "null", T("Override do prompt do sistema.", "System prompt override.")),
        new("Loading", "bool", "false", T("Estado de loading externo.", "External loading state.")),
        new("EmptyContent", "RenderFragment?", "null", T("Conteudo customizado do estado vazio.", "Custom empty state content."))
    ];

    private IReadOnlyList<NameValueRow> EventRows => [
        new("ItemsChanged", T("Disparado quando itens sao atualizados.", "Fired when items are updated.")),
        new("OnDiagnosed", T("Disparado quando diagnostico IA e concluido.", "Fired when AI diagnostics complete.")),
        new("OnResolved", T("Disparado quando um item e resolvido.", "Fired when an item is resolved.")),
        new("OnError", T("Disparado quando ocorre um erro.", "Fired when an error occurs."))
    ];

    // === ACCESSIBILITY ===
    private IReadOnlyList<DocTile> AccessibilityItems => [
        new(T("role=region", "role=region"), T("Painel usa role=region para leitores de tela.", "Panel uses role=region for screen readers."), "universal-access"),
        new(T("aria-label", "aria-label"), T("Label descritivo do painel de validacao.", "Descriptive label of validation panel."), "tag"),
        new(T("aria-busy", "aria-busy"), T("Indica estado de carregamento do diagnostico IA.", "Indicates AI diagnostics loading state."), "spinner"),
        new(T("aria-live=polite", "aria-live=polite"), T("Notifica mudancas no numero de itens.", "Notifies changes in item count."), "volume-high")
    ];

    private IReadOnlyList<NameValueRow> KeyboardRows => [
        new("Tab", T("Navega entre itens de validacao.", "Navigates between validation items.")),
        new("Enter", T("Resolve item selecionado.", "Resolves selected item.")),
        new("Escape", T("Fecha painel de explicacao.", "Closes explanation panel."))
    ];

    // === RESPONSIVENESS ===
    private IReadOnlyList<DocTile> ResponsivenessItems => [
        new(T("Largura total", "Full width"), T("Painel ocupa 100% do container.", "Panel occupies 100% of container."), "maximize"),
        new(T("Itens empilhados", "Stacked items"), T("Itens empilhados verticalmente em qualquer largura.", "Items stacked vertically at any width."), "mobile-screen")
    ];

    // === PERFORMANCE ===
    private IReadOnlyList<DocTile> PerformanceItems => [
        new(T("Lazy IA", "Lazy AI"), T("Diagnostico IA so apos clique do usuario.", "AI diagnostics only after user click."), "bolt"),
        new(T("CancellationToken", "CancellationToken"), T("Cancela chamadas anteriores automaticamente.", "Automatically cancels previous calls."), "ban"),
        new(T("Render leve", "Light render"), T("Itens renderizados sem layout shift.", "Items rendered without layout shift."), "feather")
    ];

    // === SCENARIOS ===
    private IReadOnlyList<DocTile> ScenarioItems => [
        new(T("NFe fiscal", "Fiscal NFe"), T("Validacoes de CFOP, CST, NCM em XML de NF-e.", "CFOP, CST, NCM validations in NF-e XML."), "file-invoice"),
        new(T("Conciliacao bancaria", "Bank reconciliation"), T("Erros de conciliacao com explicacao IA.", "Reconciliation errors with AI explanation."), "scale-balanced"),
        new(T("Formulario cadastro", "Registration form"), T("Validacoes de campos obrigatorios e formatos.", "Required field and format validations."), "pen-to-square")
    ];

    // === COMPOSITION ===
    private IReadOnlyList<DocTile> CompositionItems => [
        new(T("Summary + Card", "Summary + Card"), T("Painel dentro de XFCard para contexto.", "Panel inside XFCard for context."), "square"),
        new(T("Summary + Tabs", "Summary + Tabs"), T("Abas para filtrar por severidade.", "Tabs to filter by severity."), "layer-group"),
        new(T("Summary + Badge", "Summary + Badge"), T("Badge de contagem no cabecalho.", "Count badge in header."), "tag")
    ];

    // === BEST PRACTICES ===
    private IReadOnlyList<DocTile> BestPracticeItems => [
        new(T("Provider obrigatorio", "Required provider"), T("IAiProvider habilita diagnostico automatico.", "IAiProvider enables automatic diagnostics."), "key"),
        new(T("Severidade correta", "Correct severity"), T("Atribua Error, Warning ou Critical adequadamente.", "Assign Error, Warning or Critical appropriately."), "triangle-exclamation"),
        new(T("Empty state", "Empty state"), T("Forneça EmptyText ou EmptyContent para lista vazia.", "Provide EmptyText or EmptyContent for empty list."), "inbox"),
        new(T("Resolved state", "Resolved state"), T("Permita ao usuario marcar itens como resolvidos.", "Allow users to mark items as resolved."), "circle-check")
    ];

    // === ANTI-PATTERNS ===
    private IReadOnlyList<DocTile> AntiPatternItems => [
        new(T("Sem provider", "No provider"), T("Diagnostico IA indisponivel sem IAiProvider.", "AI diagnostics unavailable without IAiProvider."), "xmark"),
        new(T("Muitos itens", "Too many items"), T("Evite mais de 20 itens visiveis simultaneamente.", "Avoid more than 20 items visible simultaneously."), "ban"),
        new(T("Sem titulo", "No title"), T("Painel sem titulo e confuso para o usuario.", "Panel without title is confusing for the user."), "triangle-exclamation")
    ];

    // === TOKENS ===
    private IReadOnlyList<NameValueRow> TokenRows => [
        new("root", T("overflow-hidden rounded-lg border border-border-light bg-bg-surface.", "Overflow-hidden rounded-lg border border-border-light bg-bg-surface.")),
        new("header", T("flex items-center justify-between gap-3 border-b border-border-light.", "Flex items-center justify-between gap-3 border-b border-border-light.")),
        new("item", T("border-l-[3px] px-4 py-3.", "Border-l-[3px] px-4 py-3.")),
        new("dismiss", T("inline-flex h-6 w-6 items-center justify-center rounded-md.", "Inline-flex h-6 w-6 items-center justify-center rounded-md."))
    ];

    // === THEMING ===
    private IReadOnlyList<DocTile> ThemeItems => [
        new("data-theme", T("Tokens light/dark via CSS variables.", "Light/dark tokens via CSS variables."), "moon"),
        new("Severity colors", T("Error=orange, Warning=amber, Critical=red, Info=blue.", "Error=orange, Warning=amber, Critical=red, Info=blue."), "palette")
    ];

    // === TESTING ===
    private IReadOnlyList<NameValueRow> TestingRows => [
        new("Unit", T("Testes de render, props, severidades, diagnostico, resolve, empty.", "Render, props, severities, diagnostics, resolve, empty tests.")),
        new("Accessibility", T("role=region, aria-label, aria-busy, aria-live.", "role=region, aria-label, aria-busy, aria-live."))
    ];

    // === LIMITATIONS ===
    private IReadOnlyList<NameValueRow> LimitationRows => [
        new("Provider", T("Requer IAiProvider injetado. Sem provider, diagnostico desabilitado.", "Requires injected IAiProvider. Without provider, diagnostics disabled.")),
        new("Static SSR", T("Renderiza itens mas sem chamada IA.", "Renders items but no AI call."))
    ];

    // === RELATED ===
    private IReadOnlyList<DocTile> RelatedComponentItems => [
        new("XFAiExplainButton", T("Explicacao contextual de campos.", "Contextual field explanation."), "wand-magic-sparkles"),
        new("XFAiRiskBadge", T("Badge de risco com IA.", "AI risk badge."), "shield-halved"),
        new("XFAlert", T("Alerta simples sem IA.", "Simple alert without AI."), "bell")
    ];

    // === FAQ ===
    private IReadOnlyList<NameValueRow> FaqRows => [
        new(T("ValidationSummary vs Alert?", "ValidationSummary vs Alert?"), T("Summary = lista de itens com diagnostico. Alert = mensagem pontual.", "Summary = item list with diagnostics. Alert = single message.")),
        new(T("Como ativar diagnostico IA?", "How to enable AI diagnostics?"), T("Injete IAiProvider e passe no parametro Provider.", "Inject IAiProvider and pass to Provider parameter.")),
        new(T("Itens podem ser resolvidos?", "Can items be resolved?"), T("Sim. Clique no botao dismiss para marcar como resolvido.", "Yes. Click dismiss button to mark as resolved."))
    ];

    // === CHANGELOG ===
    private IReadOnlyList<NameValueRow> ChangelogRows => [
        new("2026-06-03", T("Pagina seed criada com preview e API inicial.", "Seed page created with preview and initial API.")),
        new("2026-06-12", T("Refatorada para padrao AppShellDocs com 26 secoes.", "Refactored to AppShellDocs pattern with 26 sections."))
    ];

    // === MOCK DATA ===
    private static readonly IReadOnlyList<XFAiValidationItem> SampleItems = [
        new() { FieldName = "CFOP", Message = "CFOP incompativel com CST.", Severity = XFAiValidationSeverity.Error, AiExplanation = "A operacao informada exige outro enquadramento fiscal.", AiFixSuggestion = "Revise CFOP conforme tipo de saida." },
        new() { FieldName = "Valor", Message = "Valor acima da politica.", Severity = XFAiValidationSeverity.Warning, AiFixSuggestion = "Solicite aprovacao humana." },
        new() { FieldName = "NCM", Message = "NCM nao encontrado na tabela.", Severity = XFAiValidationSeverity.Critical, AiExplanation = "O codigo NCM informado nao existe na tabela vigente.", AiFixSuggestion = "Consulte a tabela NCM atualizada." }
    ];

    private static readonly IReadOnlyList<XFAiValidationItem> DiagnosedItems = [
        new() { FieldName = "CFOP", Message = "CFOP incompativel com CST.", Severity = XFAiValidationSeverity.Error, AiExplanation = "O CFOP 5102 e invalido para a operacao com CST 00. A saida de mercadoria com ST exige CFOP 5405.", AiFixSuggestion = "Altere o CFOP para 5405 conforme a operacao com substituicao tributaria." },
        new() { FieldName = "BC ICMS", Message = "Base de calculo divergente.", Severity = XFAiValidationSeverity.Warning, AiExplanation = "A base de calculo do ICMS esta 12% acima do valor da NF-e.", AiFixSuggestion = "Verifique se o frete e seguro foram incluidos na base de calculo." }
    ];

    // === HELPERS ===
    private RenderFragment Section(string title, RenderFragment content) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
        <Header><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography></Header>
        <ChildContent>@content</ChildContent>
    </XFCard>;

    private RenderFragment Example(string title, string description, RenderFragment preview, string codeText) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.None" AreaRestricted="false">
        <Header><div class="px-6 pt-6 pb-2">
            <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@description</XFTypography>
        </div></Header>
        <ChildContent><div class="flex flex-col">
            <div class="border-t border-border-light p-6">@preview</div>
            <div class="border-t border-border-light bg-surface-50 p-6">
                <XFCode Text="@codeText" Language="razor" Title="@CopyableCodeTitle" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" />
            </div>
        </div></ChildContent>
    </XFCard>;

    private RenderFragment Tile(DocTile item) => @<XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent>
        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <div class="flex items-center gap-4">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-primary/10 bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                <div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div>
            </div>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
        </XFStack>
    </ChildContent></XFCard>;

    private RenderFragment TileGrid(IReadOnlyList<DocTile> items, int columns) => @<XFGrid Cols="1" Md="@Math.Min(columns, 2)" Lg="@columns" Gap="4">@foreach (var item in items) { @Tile(item) }</XFGrid>;

    private RenderFragment WarningGrid(IReadOnlyList<DocTile> items) => @<XFGrid Cols="1" Md="2" Gap="4">@foreach (var item in items) {
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <div class="flex items-center gap-4">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-danger/10 bg-danger/10 text-danger" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                <div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div>
            </div>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
        </XFStack></ChildContent></XFCard>
    }</XFGrid>;

    private RenderFragment NameValueTable(IReadOnlyList<NameValueRow> rows, string nameHeader, string valueHeader) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader><XFTableRow><XFTableCell Header="true">@nameHeader</XFTableCell><XFTableCell Header="true">@valueHeader</XFTableCell></XFTableRow></XFTableHeader>
        <XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Value</XFTableCell></XFTableRow> }</XFTableBody>
    </XFTable>;

    private RenderFragment ApiTable(IReadOnlyList<ApiRow> rows) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Parametro", "Parameter")</XFTableCell><XFTableCell Header="true">Type</XFTableCell><XFTableCell Header="true">Default</XFTableCell><XFTableCell Header="true">@T("Descricao", "Description")</XFTableCell></XFTableRow></XFTableHeader>
        <XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Type</XFTableCell><XFTableCell><XFCode Text="@row.DefaultValue" /></XFTableCell><XFTableCell>@row.Description</XFTableCell></XFTableRow> }</XFTableBody>
    </XFTable>;

    // === RECORDS ===
    private sealed record DocTile(string Title, string Description, string Icon);
    private sealed record NameValueRow(string Name, string Value);
    private sealed record ApiRow(string Name, string Type, string DefaultValue, string Description);
}
