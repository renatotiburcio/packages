<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>XForge.DesignSystem.Docs.AI</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\XForge.DesignSystem\XForge.DesignSystem.csproj" />
    <ProjectReference Include="..\XForge.DesignSystem.AI\XForge.DesignSystem.AI.csproj" />
    <ProjectReference Include="..\XForge.DesignSystem.Docs.Shared\XForge.DesignSystem.Docs.Shared.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="BuildTailwindCSS" BeforeTargets="Build">
    <Exec Command="npm run build:css" WorkingDirectory="$(MSBuildProjectDirectory)" Condition="Exists('$(MSBuildProjectDirectory)\package.json')" ContinueOnError="true" IgnoreExitCode="true" />
  </Target>

</Project>
