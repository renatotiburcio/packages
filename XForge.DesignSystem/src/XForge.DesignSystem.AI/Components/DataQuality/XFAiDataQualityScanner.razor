@namespace XForge.DesignSystem.AI.Components
<div class="xf-ai-dqscanner" data-issues="@Issues.Count">
  <h3>Data Quality Report</h3>
  <div class="xf-ai-dq-overall">Score: @Math.Round(OverallScore,1)/100</div>
  @foreach (var i in Issues) { <div class="xf-ai-dq-issue" data-severity="@i.Severity">@i.Field: @i.Message</div> }
</div>
@code {
  public record DqIssue(string Field, string Message, string Severity, string? SuggestedFix = null);
  [Parameter] public IReadOnlyList<DqIssue> Issues { get; set; } = new List<DqIssue>();
  [Parameter] public double OverallScore { get; set; } = 100.0;
  [Parameter] public EventCallback<DqIssue> OnIssueFix { get; set; }
}