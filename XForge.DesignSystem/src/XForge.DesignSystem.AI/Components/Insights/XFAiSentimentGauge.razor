@namespace XForge.DesignSystem.AI.Components
<div class="xf-ai-sentiment" data-sentiment="@CurrentSentiment" data-confidence="@(Confidence*100)">
  <div class="xf-ai-sentiment-bar">
    <div class="xf-ai-sentiment-negative" style="width:@(Negative*100)%"></div>
    <div class="xf-ai-sentiment-neutral" style="width:@(Neutral*100)%"></div>
    <div class="xf-ai-sentiment-positive" style="width:@(Positive*100)%"></div>
  </div>
  <div class="xf-ai-sentiment-label">@CurrentSentiment (@Math.Round(Confidence*100,1)%)</div>
</div>
@code {
  [Parameter] public double Positive { get; set; } = 0.5;
  [Parameter] public double Neutral { get; set; } = 0.3;
  [Parameter] public double Negative { get; set; } = 0.2;
  public string CurrentSentiment => Positive > Negative && Positive > Neutral ? "Positive" : Negative > Positive && Negative > Neutral ? "Negative" : "Neutral";
  [Parameter] public double Confidence { get; set; } = 0.8;
  [Parameter] public EventCallback<string> OnSentimentChanged { get; set; }
}