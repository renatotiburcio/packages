@namespace XForge.DesignSystem.AI.Components
<div class="xf-ai-latency-monitor" data-providers="@Providers.Count">
  <h3>AI Provider Latency</h3>
  @foreach (var p in Providers) { <div class="xf-ai-lm-provider" data-status="@p.Status"><span>@p.Name</span><span>@p.P50Ms ms (P50)</span><span>@p.P95Ms ms (P95)</span><span>@p.P99Ms ms (P99)</span><span>@p.Uptime% uptime</span></div> }
</div>
@code {
  public record ProviderLatency(string Name, int P50Ms, int P95Ms, int P99Ms, double Uptime, string Status);
  [Parameter] public IReadOnlyList<ProviderLatency> Providers { get; set; } = new List<ProviderLatency>();
  [Parameter] public bool AutoRefresh { get; set; } = true;
  [Parameter] public int RefreshIntervalMs { get; set; } = 5000;
  [Parameter] public EventCallback<ProviderLatency> OnProviderAlert { get; set; }
}