@namespace XForge.DesignSystem.AI.Components
<div class="xf-ai-kb" data-docs="@Documents.Count" data-vectors="@VectorCount">
  <input type="text" placeholder="Query knowledge base..." @bind="Query" @onkeyup="OnSubmit" />
  <button @onclick="OnSubmit">Search</button>
  <div class="xf-ai-kb-results">@foreach (var r in Results) { <div class="xf-ai-kb-result" data-score="@r.Score">@r.Title - @r.Snippet</div> }</div>
</div>
@code {
  public record KbDocument(string Id, string Title, string Content, IReadOnlyList<float>? Embedding = null, IReadOnlyDictionary<string,object>? Metadata = null);
  public record KbResult(string DocId, string Title, string Snippet, double Score, IReadOnlyDictionary<string,object>? Metadata = null);
  [Parameter] public IReadOnlyList<KbDocument> Documents { get; set; } = new List<KbDocument>();
  [Parameter] public int VectorCount { get; set; }
  [Parameter] public string EmbeddingModel { get; set; } = "text-embedding-3-small";
  [Parameter] public EventCallback<string> OnQuery { get; set; }
  string Query { get; set; } = "";
  IReadOnlyList<KbResult> Results { get; set; } = new List<KbResult>();
  async Task OnSubmit() { await OnQuery.InvokeAsync(Query); }
}