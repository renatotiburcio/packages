@namespace XForge.DesignSystem.AI.Components
@inherits XForgeComponentBase

<div class="xf-ai-prompt-library" data-prompts="@Prompts.Count">
  <input type="text" placeholder="Search prompts..." @bind="Filter" />
  @foreach (var p in Filtered) { <div class="xf-ai-prompt" @onclick="() => OnSelect.InvokeAsync(p)"><h4>@p.Title</h4><p>@p.Description</p><span class="xf-ai-prompt-tags">@string.Join(",",p.Tags)</span></div> }
</div>

@code {
  public record PromptTemplate(string Id, string Title, string Description, string Body, IReadOnlyList<string> Tags, string? Category = null);
}
