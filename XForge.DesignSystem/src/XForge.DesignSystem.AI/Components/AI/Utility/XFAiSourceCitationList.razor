@inherits XForgeComponentBase

<section @attributes="AdditionalAttributes"
         id="@Id"
         class="@RootClass"
         style="@Style"
         role="region"
         aria-label="@Title">

    @* ── Header ─────────────────────────────────────────────────────────── *@
    @if (ShowHeader)
    {
        <div class="@HeaderClass">
            <div class="flex items-center gap-2">
                <span class="inline-flex h-4 w-4 items-center justify-center text-text-muted" aria-hidden="true">
                    @XFSvgIcons.Markup("book-open")
                </span>
                <span class="text-sm font-semibold text-text-primary">@Title</span>
                @if (Citations.Count > 0)
                {
                    <span class="@CountBadgeClass">@Citations.Count</span>
                }
            </div>
        </div>
    }

    @* ── Citation List ──────────────────────────────────────────────────── *@
    @if (SortedCitations.Count > 0)
    {
        <ol class="@ListClass" role="list" aria-label="Fontes citadas">
            @foreach (var citation in SortedCitations)
            {
                <li class="@ItemClass" role="listitem"
                    aria-label="@($"#{citation.Rank} {citation.Title}, confianca {(citation.Confidence * 100):F0}%")">

                    @if (CitationTemplate is not null)
                    {
                        @CitationTemplate(citation)
                    }
                    else
                    {
                        @* -- Rank *@
                        <div class="@RankClass">@citation.Rank</div>

                        @* -- Content *@
                        <div class="min-w-0 flex-1">
                            <div class="flex items-start justify-between gap-2">
                                <div class="min-w-0">
                                    @if (!string.IsNullOrWhiteSpace(citation.Url))
                                    {
                                        <a href="@citation.Url" target="_blank" rel="noopener noreferrer"
                                           class="@TitleLinkClass">
                                            @citation.Title
                                            <span class="inline-flex h-3 w-3 shrink-0 items-center justify-center opacity-50" aria-hidden="true">
                                                @XFSvgIcons.Markup("arrow-up-right-from-square")
                                            </span>
                                        </a>
                                    }
                                    else
                                    {
                                        <p class="@TitleClass">@citation.Title</p>
                                    }

                                    @* -- Metadata *@
                                    <div class="mt-0.5 flex flex-wrap items-center gap-x-2 gap-y-0.5 text-[11px] text-text-muted">
                                        @if (!string.IsNullOrWhiteSpace(citation.SourceType))
                                        {
                                            <span class="@SourceTypeBadgeClass">@citation.SourceType</span>
                                        }
                                        @if (citation.PublishedDate.HasValue)
                                        {
                                            <span>@citation.PublishedDate.Value.ToString("dd/MM/yyyy")</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(citation.PageReference))
                                        {
                                            <span>p. @citation.PageReference</span>
                                        }
                                    </div>
                                </div>

                                @* -- Confidence *@
                                @if (ShowConfidence)
                                {
                                    <div class="flex items-center gap-1.5">
                                        <div class="@ConfidenceTrackClass" role="progressbar"
                                             aria-valuenow="@((int)(citation.Confidence * 100))" aria-valuemin="0" aria-valuemax="100"
                                             aria-label="Confianca">
                                            <div class="@ConfidenceFillClass" style="width: @((int)(citation.Confidence * 100))%"></div>
                                        </div>
                                        <span class="text-[10px] font-medium tabular-nums text-text-muted">@((int)(citation.Confidence * 100))%</span>
                                    </div>
                                }
                            </div>

                            @* -- Snippet *@
                            @if (ShowSnippets && !string.IsNullOrWhiteSpace(citation.Snippet))
                            {
                                <div class="@SnippetClass">
                                    <span class="inline-flex h-3 w-3 shrink-0 items-center justify-center text-text-muted" aria-hidden="true">
                                        @XFSvgIcons.Markup("quote-left")
                                    </span>
                                    <span class="line-clamp-3">@citation.Snippet</span>
                                </div>
                            }
                        </div>
                    }
                </li>
            }
        </ol>
    }
    else
    {
        @* ── Empty State *@
        <div class="@EmptyClass">
            @if (EmptyContent is not null)
            {
                @EmptyContent
            }
            else
            {
                <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-surface-100 text-text-muted" aria-hidden="true">
                    @XFSvgIcons.Markup("book-open")
                </span>
                <p class="@EmptyTextClass">@EmptyText</p>
            }
        </div>
    }
</section>
