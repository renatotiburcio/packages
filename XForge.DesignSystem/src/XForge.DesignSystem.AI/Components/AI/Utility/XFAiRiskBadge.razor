@inherits XForgeComponentBase

<span @attributes="AdditionalAttributes"
      id="@Id"
      class="@RootClass"
      style="@Style"
      role="status"
      aria-label="@($"{LevelLabel} — {ContextLabel}")"
      data-risk="@Level.ToString().ToLowerInvariant()"
      data-context="@Context.ToString().ToLowerInvariant()">

    @if (BadgeTemplate is not null)
    {
        @BadgeTemplate(new XFAiRiskBadgeContext { Level = Level, Context = Context, Label = ComputedLabel })
    }
    else
    {
        <span class="@DotClass" aria-hidden="true"></span>
        <span class="@LabelClass">@ComputedLabel</span>
        @if (ShowScore && Score.HasValue)
        {
            <span class="@ScoreClass">@($"{Score.Value:P0}")</span>
        }
    }
</span>
