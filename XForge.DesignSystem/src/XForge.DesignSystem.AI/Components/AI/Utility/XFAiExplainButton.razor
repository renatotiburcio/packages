@using XForge.DesignSystem.Components.AI.Common
@using XForge.DesignSystem.Services.AI
@inherits XForgeComponentBase

<div @attributes="AdditionalAttributes"
     id="@Id"
     class="@RootClass"
     style="@Style"
     role="region"
     aria-label="@AriaLabel"
     aria-busy="@AriaBusyValue">

    @* ── Trigger Button ─────────────────────────────────────────────────── *@
    @if (!_isExpanded)
    {
        <button type="button"
                class="@ButtonClass"
                disabled="@(!CanExplain)"
                aria-label="@AriaLabel"
                title="@Title"
                @onclick="ExplainAsync">
            <span class="inline-flex h-4 w-4 items-center justify-center" aria-hidden="true">
                @XFSvgIcons.Markup("circle-question")
            </span>
            @if (ShowLabel)
            {
                <span>@ButtonLabel</span>
            }
        </button>
    }

    @* ── Expanded Explanation Panel ──────────────────────────────────────── *@
    @if (_isExpanded)
    {
        <div class="@PanelClass" aria-live="polite">
            @* -- Header *@
            <div class="@PanelHeaderClass">
                <div class="flex items-center gap-2">
                    <span class="inline-flex h-4 w-4 items-center justify-center text-primary" aria-hidden="true">
                        @XFSvgIcons.Markup("sparkles")
                    </span>
                    <span class="text-sm font-semibold text-text-primary">@Title</span>
                </div>
                <button type="button"
                        class="@CloseButtonClass"
                        aria-label="Fechar explicacao"
                        @onclick="CollapseAsync">
                    <span class="inline-flex h-3.5 w-3.5 items-center justify-center" aria-hidden="true">
                        @XFSvgIcons.Markup("xmark")
                    </span>
                </button>
            </div>

            @* -- Loading *@
            @if (_isLoading)
            {
                <div class="@LoadingClass" role="status" aria-label="Gerando explicacao...">
                    <span class="sr-only">Gerando explicacao...</span>
                    <div class="space-y-2">
                        <div class="h-3 w-3/4 rounded bg-surface-200"></div>
                        <div class="h-3 w-1/2 rounded bg-surface-200"></div>
                    </div>
                </div>
            }
            else if (_result is not null)
            {
                @if (ExplainTemplate is not null)
                {
                    @ExplainTemplate(_result)
                }
                else
                {
                    <div class="@ContentClass">
                        <p class="text-sm leading-6 text-text-primary">@_result.Explanation</p>

                        @if (_result.Details.Count > 0)
                        {
                            <div class="mt-3 space-y-1.5">
                                @foreach (var detail in _result.Details)
                                {
                                    <div class="flex items-start gap-2 rounded-md bg-surface-50 px-3 py-2 text-xs ring-1 ring-border-light">
                                        @if (!string.IsNullOrEmpty(detail.Icon))
                                        {
                                            <span class="inline-flex h-3.5 w-3.5 shrink-0 items-center justify-center text-text-muted" aria-hidden="true">
                                                @XFSvgIcons.Markup(detail.Icon)
                                            </span>
                                        }
                                        <span class="font-medium text-text-secondary">@detail.Label:</span>
                                        <span class="text-text-primary">@detail.Value</span>
                                    </div>
                                }
                            </div>
                        }

                        @if (_result.Confidence > 0)
                        {
                            <div class="mt-3 flex items-center gap-2">
                                <span class="text-xs text-text-muted">Confianca:</span>
                                <div class="@ConfidenceTrackClass" role="progressbar" aria-valuenow="@((int)(_result.Confidence * 100))" aria-valuemin="0" aria-valuemax="100">
                                    <div class="@ConfidenceFillClass" style="width: @((int)(_result.Confidence * 100))%"></div>
                                </div>
                                <span class="text-xs font-medium tabular-nums">@((_result.Confidence * 100).ToString("F0"))%</span>
                            </div>
                        }
                    </div>
                }
            }
            else if (!string.IsNullOrWhiteSpace(_errorText))
            {
                <div class="@ErrorClass" role="alert">
                    <span class="inline-flex h-4 w-4 shrink-0 items-center justify-center" aria-hidden="true">
                        @XFSvgIcons.Markup("circle-exclamation")
                    </span>
                    <span>@_errorText</span>
                </div>
            }
        </div>
    }
</div>
