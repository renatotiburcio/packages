@using XForge.DesignSystem.Components.AI.Common
@using XForge.DesignSystem.Services.AI
@inherits XForgeComponentBase

<section @attributes="AdditionalAttributes"
         id="@Id"
         class="@RootClass"
         style="@Style"
         role="region"
         aria-label="@Title"
         aria-busy="@AriaBusyValue">

    @* ── Header ─────────────────────────────────────────────────────────── *@
    @if (ShowHeader)
    {
        <div class="@HeaderClass">
            <div class="flex items-center gap-2">
                <span class="inline-flex h-4 w-4 items-center justify-center text-text-muted" aria-hidden="true">
                    @XFSvgIcons.Markup("shield-check")
                </span>
                <span class="text-sm font-semibold text-text-primary">@Title</span>
                @if (Items.Count > 0)
                {
                    <span class="@CountBadgeClass">@Items.Count</span>
                }
            </div>
            @if (Items.Count > 0 && Provider is not null)
            {
                <button type="button"
                        class="@DiagnoseButtonClass"
                        disabled="@IsBusy"
                        aria-label="Diagnostico IA"
                        @onclick="DiagnoseAsync">
                    @if (_isDiagnosing)
                    {
                        <span class="inline-flex h-3.5 w-3.5 animate-spin items-center justify-center" aria-hidden="true">
                            @XFSvgIcons.Markup("spinner")
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex h-3.5 w-3.5 items-center justify-center" aria-hidden="true">
                            @XFSvgIcons.Markup("sparkles")
                        </span>
                    }
                    <span>Diagnosticar</span>
                </button>
            }
        </div>
    }

    @* ── Loading ────────────────────────────────────────────────────────── *@
    @if (_isDiagnosing)
    {
        <div class="@LoadingClass" role="status" aria-label="Diagnosticando...">
            <span class="sr-only">Diagnosticando validacoes...</span>
            <div class="space-y-2">
                <div class="h-3 w-3/4 rounded bg-surface-200"></div>
                <div class="h-3 w-1/2 rounded bg-surface-200"></div>
            </div>
        </div>
    }

    @* ── Validation Items ───────────────────────────────────────────────── *@
    @if (Items.Count > 0)
    {
        <ul class="@ListClass" role="list">
            @foreach (var item in SortedItems)
            {
                <li class="@ItemClass(item)" role="listitem" aria-label="@($"{item.FieldName}: {item.Message}")">
                    <div class="flex items-start gap-2.5">
                        @* -- Severity Icon *@
                        <span class="@SeverityIconClass(item.Severity)" aria-hidden="true">
                            @XFSvgIcons.Markup(GetSeverityIcon(item.Severity))
                        </span>

                        @* -- Content *@
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium text-text-primary">@item.FieldName</span>
                                <span class="@SeverityBadgeClass(item.Severity)">@GetSeverityLabel(item.Severity)</span>
                                @if (item.IsResolved)
                                {
                                    <span class="inline-flex items-center rounded-full bg-emerald-50 px-1.5 py-0.5 text-[10px] font-semibold text-emerald-700 ring-1 ring-emerald-200">Resolvido</span>
                                }
                            </div>
                            <p class="mt-0.5 text-xs text-text-secondary">@item.Message</p>

                            @* -- AI Explanation *@
                            @if (!string.IsNullOrWhiteSpace(item.AiExplanation))
                            {
                                <div class="mt-2 rounded-md bg-primary/5 px-2.5 py-2 text-xs text-primary ring-1 ring-primary/10">
                                    <div class="flex items-start gap-1.5">
                                        <span class="inline-flex h-3 w-3 shrink-0 items-center justify-center" aria-hidden="true">
                                            @XFSvgIcons.Markup("sparkles")
                                        </span>
                                        <span>@item.AiExplanation</span>
                                    </div>
                                </div>
                            }

                            @* -- AI Fix Suggestion *@
                            @if (!string.IsNullOrWhiteSpace(item.AiFixSuggestion))
                            {
                                <div class="mt-1.5 rounded-md bg-emerald-50 px-2.5 py-2 text-xs text-emerald-700 ring-1 ring-emerald-200">
                                    <div class="flex items-start gap-1.5">
                                        <span class="inline-flex h-3 w-3 shrink-0 items-center justify-center" aria-hidden="true">
                                            @XFSvgIcons.Markup("lightbulb")
                                        </span>
                                        <span>@item.AiFixSuggestion</span>
                                    </div>
                                </div>
                            }
                        </div>

                        @* -- Dismiss *@
                        @if (ShowDismiss && !item.IsResolved)
                        {
                            <button type="button"
                                    class="@DismissButtonClass"
                                    aria-label="@($"Resolver: {item.FieldName}")"
                                    @onclick="() => ResolveItemAsync(item)">
                                <span class="inline-flex h-3 w-3 items-center justify-center" aria-hidden="true">
                                    @XFSvgIcons.Markup("check")
                                </span>
                            </button>
                        }
                    </div>
                </li>
            }
        </ul>
    }
    else if (!_isDiagnosing)
    {
        @* ── Empty State ─────────────────────────────────────────────────── *@
        <div class="@EmptyClass">
            @if (EmptyContent is not null)
            {
                @EmptyContent
            }
            else
            {
                <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-emerald-50 text-emerald-500" aria-hidden="true">
                    @XFSvgIcons.Markup("circle-check")
                </span>
                <p class="@EmptyTextClass">@EmptyText</p>
            }
        </div>
    }
</section>
