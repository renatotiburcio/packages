@using XForge.DesignSystem.Components.AI.Common
@using XForge.DesignSystem.Services.AI
@inherits XForgeComponentBase

<div @attributes="AdditionalAttributes"
     id="@Id"
     class="@RootClass"
     style="@Style"
     role="region"
     aria-label="@Title"
     aria-busy="@AriaBusyValue">

    @* ── Trigger Area ───────────────────────────────────────────────────── *@
    @if (!_isExpanded)
    {
        <div class="@TriggerClass">
            @if (ChildContent is not null)
            {
                @ChildContent
            }
            <div class="@ModeBarClass">
                @foreach (var mode in AvailableModes)
                {
                    <button type="button"
                            class="@ModeButtonClass(mode)"
                            disabled="@(!CanRewrite)"
                            aria-label="@GetModeLabel(mode)"
                            title="@GetModeLabel(mode)"
                            @onclick="() => RewriteAsync(mode)">
                        <span class="inline-flex h-3.5 w-3.5 items-center justify-center" aria-hidden="true">
                            @XFSvgIcons.Markup(GetModeIcon(mode))
                        </span>
                        <span>@GetModeLabel(mode)</span>
                    </button>
                }
            </div>
        </div>
    }

    @* ── Result Panel ───────────────────────────────────────────────────── *@
    @if (_isExpanded)
    {
        <div class="@PanelClass" aria-live="polite">
            @* -- Header *@
            <div class="@PanelHeaderClass">
                <div class="flex items-center gap-2">
                    <span class="inline-flex h-4 w-4 items-center justify-center text-primary" aria-hidden="true">
                        @XFSvgIcons.Markup("wand-magic-sparkles")
                    </span>
                    <span class="text-sm font-semibold text-text-primary">@Title</span>
                    @if (_result is not null)
                    {
                        <span class="@ModeBadgeClass">@GetModeLabel(_result.Mode)</span>
                    }
                </div>
                <div class="flex items-center gap-1">
                    @if (_result is not null && OnApply.HasDelegate)
                    {
                        <button type="button"
                                class="@ApplyButtonClass"
                                aria-label="Aplicar texto reescrito"
                                @onclick="ApplyAsync">
                            <span class="inline-flex h-3.5 w-3.5 items-center justify-center" aria-hidden="true">
                                @XFSvgIcons.Markup("check")
                            </span>
                            <span>Aplicar</span>
                        </button>
                    }
                    <button type="button"
                            class="@CloseButtonClass"
                            aria-label="Fechar reescrita"
                            @onclick="CollapseAsync">
                        <span class="inline-flex h-3.5 w-3.5 items-center justify-center" aria-hidden="true">
                            @XFSvgIcons.Markup("xmark")
                        </span>
                    </button>
                </div>
            </div>

            @* -- Loading *@
            @if (_isLoading)
            {
                <div class="@LoadingClass" role="status" aria-label="Reescrevendo texto...">
                    <span class="sr-only">Reescrevendo texto...</span>
                    <div class="space-y-2">
                        <div class="h-3 w-full rounded bg-surface-200"></div>
                        <div class="h-3 w-5/6 rounded bg-surface-200"></div>
                        <div class="h-3 w-2/3 rounded bg-surface-200"></div>
                    </div>
                </div>
            }
            else if (_result is not null)
            {
                @if (RewriteTemplate is not null)
                {
                    @RewriteTemplate(_result)
                }
                else
                {
                    <div class="@ContentClass">
                        @if (!string.IsNullOrWhiteSpace(_result.ChangeDescription))
                        {
                            <div class="mb-3 rounded-md bg-primary/5 px-3 py-2 text-xs text-primary ring-1 ring-primary/10">
                                @_result.ChangeDescription
                            </div>
                        }
                        <div class="rounded-md bg-surface-50 px-3 py-2.5 text-sm leading-6 text-text-primary ring-1 ring-border-light">
                            @_result.RewrittenText
                        </div>
                        @if (_result.Confidence > 0)
                        {
                            <div class="mt-2.5 flex items-center gap-2">
                                <span class="text-xs text-text-muted">Confianca:</span>
                                <div class="@ConfidenceTrackClass" role="progressbar" aria-valuenow="@((int)(_result.Confidence * 100))" aria-valuemin="0" aria-valuemax="100">
                                    <div class="@ConfidenceFillClass" style="width: @((int)(_result.Confidence * 100))%"></div>
                                </div>
                                <span class="text-xs font-medium tabular-nums">@((_result.Confidence * 100).ToString("F0"))%</span>
                            </div>
                        }
                    </div>
                }
            }
            else if (!string.IsNullOrWhiteSpace(_errorText))
            {
                <div class="@ErrorClass" role="alert">
                    <span class="inline-flex h-4 w-4 shrink-0 items-center justify-center" aria-hidden="true">
                        @XFSvgIcons.Markup("circle-exclamation")
                    </span>
                    <span>@_errorText</span>
                </div>
            }
        </div>
    }
</div>
