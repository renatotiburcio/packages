@inherits XForgeComponentBase

<div @attributes="AdditionalAttributes"
     id="@Id"
     class="@GetComponentClass()"
     style="@Style"
     role="complementary"
     aria-label="@Title"
     aria-busy="@(IsLoading ? "true" : "false")"
     aria-live="polite">

    @* ── Header ─────────────────────────────────────────────────────────── *@
    @if (HeaderContent is not null)
    {
        <div class="@HeaderClass">
            @HeaderContent
        </div>
    }
    else if (ShowTitle)
    {
        <div class="@HeaderClass">
            <h3 class="@TitleClass">@Title</h3>
            @if (HasInsights)
            {
                <span class="@CountBadgeClass">@VisibleInsights.Count</span>
            }
        </div>
    }

    @* ── Loading State ──────────────────────────────────────────────────── *@
    @if (IsLoading)
    {
        <div class="@LoadingSkeletonClass" role="status" aria-label="@LoadingText">
            <span class="sr-only">@LoadingText</span>
            @for (var i = 0; i < Math.Min(3, MaxInsights); i++)
            {
                <div class="@SkeletonItemClass">
                    <div class="@SkeletonIconClass"></div>
                    <div class="flex-1 space-y-2 py-0.5">
                        <div class="@SkeletonLineClass w-3/4"></div>
                        <div class="@SkeletonLineClass w-1/2"></div>
                    </div>
                </div>
            }
        </div>
    }
    else if (!HasInsights)
    {
        @* ── Empty State ─────────────────────────────────────────────────── *@
        @if (EmptyContent is not null)
        {
            <div class="@EmptyClass">
                @EmptyContent
            </div>
        }
        else
        {
            <div class="@EmptyClass">
                <svg class="@EmptyIconClass" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
                     stroke-linejoin="round" aria-hidden="true">
                    <path d="M3 3v18h18" />
                    <path d="M7 16l4-8 4 4 4-6" />
                </svg>
                <p class="@EmptyTextClass">@EmptyText</p>
            </div>
        }
    }
    else
    {
        @* ── Insight List ─────────────────────────────────────────────────── *@
        <ul class="@ListClass" role="list">
            @foreach (var insight in VisibleInsights)
            {
                <li role="listitem"
                    class="@($"{InsightBaseClass} {InsightDisabledClass} {TypeBorderClass(insight.Type)}")"
                    tabindex="0"
                    aria-label="@($"{insight.Title}{(insight.Confidence.HasValue ? $", confianca {ConfidencePercent(insight.Confidence)}" : "")}")"
                    @onclick="@(() => HandleInsightClickAsync(insight))"
                    @onkeydown="@((KeyboardEventArgs args) => HandleInsightKeyDownAsync(args, insight))">

                    @if (InsightTemplate is not null)
                    {
                        @InsightTemplate(insight)
                    }
                    else
                    {
                        @* ── Icon *@
                        @if (ShowIcons)
                        {
                            <div class="@IconContainerClass(insight.Type, insight.Severity)" aria-hidden="true">
                                <span class="@IconClass(insight.Type)">
                                    @XFSvgIcons.Markup(SeverityIcon(insight.Severity))
                                </span>
                            </div>
                        }

                        @* ── Content *@
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <p class="@InsightTitleClass">@insight.Title</p>
                                @if (!string.IsNullOrWhiteSpace(insight.RelatedKpi))
                                {
                                    <span class="@KpiBadgeClass">@insight.RelatedKpi</span>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(insight.Description))
                            {
                                <p class="@InsightDescriptionClass">@insight.Description</p>
                            }

                            @if (insight.ChangePercent.HasValue)
                            {
                                <span class="@ChangePercentClass(insight.ChangePercent.Value)">
                                    @ChangePercentText(insight.ChangePercent.Value)
                                </span>
                            }

                            @if (!string.IsNullOrWhiteSpace(insight.Recommendation))
                            {
                                <p class="@RecommendationClass">@insight.Recommendation</p>
                            }

                            @if (insight.Confidence.HasValue)
                            {
                                <div class="@ConfidenceBarContainerClass">
                                    <div class="@ConfidenceBarTrackClass"
                                         role="progressbar"
                                         aria-valuenow="@((int)(insight.Confidence.Value * 100))"
                                         aria-valuemin="0"
                                         aria-valuemax="100"
                                         aria-label="Confianca">
                                        <div class="@ConfidenceBarFillClass(insight.Type)"
                                             style="width: @ConfidenceWidth(insight.Confidence)%"></div>
                                    </div>
                                    <span class="@ConfidenceLabelClass">@ConfidencePercent(insight.Confidence)</span>
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(insight.ActionLabel))
                            {
                                <button type="button"
                                        class="@ActionButtonClass"
                                        @onclick="@(() => HandleInsightClickAsync(insight))"
                                        @onclick:stopPropagation="true">
                                    @insight.ActionLabel
                                </button>
                            }
                        </div>

                        @* ── Dismiss Button *@
                        @if (ShowDismiss)
                        {
                            <button type="button"
                                    class="@DismissButtonClass"
                                    aria-label="@($"Dispensar insight: {insight.Title}")"
                                    @onclick="@((MouseEventArgs e) => HandleDismissAsync(insight, e))"
                                    @onclick:stopPropagation="true">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2"
                                     stroke-linecap="round" stroke-linejoin="round"
                                     class="h-3.5 w-3.5" aria-hidden="true">
                                    <line x1="18" y1="6" x2="6" y2="18" />
                                    <line x1="6" y1="6" x2="18" y2="18" />
                                </svg>
                            </button>
                        }
                    }
                </li>
            }
        </ul>
    }
</div>
