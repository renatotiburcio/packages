@using XForge.DesignSystem.Components.AI.Common
@using XForge.DesignSystem.Services.AI
@inherits XForgeComponentBase

<div @attributes="AdditionalAttributes"
     id="@Id"
     class="@RootClass"
     style="@Style"
     role="complementary"
     aria-label="@Title"
     aria-busy="@(_isBusy ? "true" : "false")"
     data-theme>

    @* ── Header ─────────────────────────────────────────────────────────── *@
    @if (ShowHeader)
    {
        @if (HeaderContent is not null)
        {
            <div class="@HeaderClass">
                @HeaderContent
            </div>
        }
        else
        {
            <div class="@HeaderClass">
                <div class="min-w-0">
                    <div class="@HeaderTitleClass">
                        <span class="inline-flex h-5 w-5 items-center justify-center text-text-muted" aria-hidden="true">
                            @XFSvgIcons.Markup("sparkles")
                        </span>
                        @Title
                    </div>
                </div>
            </div>
        }
    }

    @* ── Query Input ────────────────────────────────────────────────────── *@
    <div class="@ComposerClass">
        <div class="relative flex-1">
            <span class="@SearchIconClass" aria-hidden="true">
                @XFSvgIcons.Markup("magnifying-glass")
            </span>
            <input type="text"
                   class="@InputClass"
                   value="@_queryText"
                   placeholder="@Placeholder"
                   disabled="@(_isBusy || Disabled)"
                   aria-label="@Placeholder"
                   @oninput="HandleInput"
                   @onkeydown="HandleKeyDownAsync" />
        </div>

        @if (_isBusy)
        {
            <button type="button"
                    class="@CancelButtonClass"
                    aria-label="Cancelar consulta"
                    title="Cancelar consulta"
                    @onclick="CancelAsync">
                <span class="inline-flex h-4 w-4 items-center justify-center" aria-hidden="true">
                    @XFSvgIcons.Markup("stop")
                </span>
            </button>
        }
        else
        {
            <button type="button"
                    class="@SubmitButtonClass"
                    disabled="@(!CanSubmit)"
                    aria-label="Enviar consulta"
                    title="Enviar consulta"
                    @onclick="SubmitQueryAsync">
                <span class="inline-flex h-4 w-4 items-center justify-center" aria-hidden="true">
                    @XFSvgIcons.Markup("paper-plane")
                </span>
            </button>
        }
    </div>

    @* ── Error Banner ───────────────────────────────────────────────────── *@
    @if (!string.IsNullOrWhiteSpace(_errorText))
    {
        <div class="@ErrorBannerClass" role="alert">
            <span class="inline-flex h-4 w-4 items-center justify-center shrink-0" aria-hidden="true">
                @XFSvgIcons.Markup("circle-exclamation")
            </span>
            <span>@_errorText</span>
            <button type="button"
                    class="ml-auto inline-flex h-5 w-5 items-center justify-center rounded text-danger opacity-70 hover:opacity-100 focus-visible:ring-2 focus-visible:ring-border-focus"
                    aria-label="Dispensar erro"
                    @onclick="DismissError">
                <span class="inline-flex h-3 w-3 items-center justify-center" aria-hidden="true">
                    @XFSvgIcons.Markup("xmark")
                </span>
            </button>
        </div>
    }

    @* ── Loading State ──────────────────────────────────────────────────── *@
    @if (_isBusy && _insights.Count == 0)
    {
        <div class="@LoadingClass" role="status" aria-label="Analisando dados...">
            <span class="sr-only">Analisando dados...</span>
            @for (var i = 0; i < 3; i++)
            {
                <div class="@SkeletonItemClass">
                    <div class="@SkeletonCircleClass"></div>
                    <div class="flex-1 space-y-2 py-0.5">
                        <div class="@SkeletonLineClass w-3/4"></div>
                        <div class="@SkeletonLineClass w-1/2"></div>
                    </div>
                </div>
            }
        </div>
    }
    @* ── Empty State ────────────────────────────────────────────────────── *@
    else if (_insights.Count == 0 && !_isBusy)
    {
        @if (EmptyContent is not null)
        {
            <div class="@EmptyClass">
                @EmptyContent
            </div>
        }
        else
        {
            <div class="@EmptyClass">
                <svg class="@EmptyIconClass" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
                     stroke-linejoin="round" aria-hidden="true">
                    <path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                </svg>
                <p class="@EmptyTextClass">@EmptyText</p>
            </div>
        }
    }
    @* ── Insights List ─────────────────────────────────────────────────── *@
    else
    {
        <div class="@ResultsContainerClass"
             role="region"
             aria-label="Resultados da analise"
             aria-live="polite">

            @* ── Query Summary ── *@
            @if (_currentQuery is not null && !string.IsNullOrWhiteSpace(_currentQuery.Summary))
            {
                <div class="@QuerySummaryClass">
                    <span class="inline-flex h-4 w-4 items-center justify-center text-text-muted shrink-0" aria-hidden="true">
                        @XFSvgIcons.Markup("circle-info")
                    </span>
                    <span class="text-text-secondary">@_currentQuery.Summary</span>
                    @if (_currentQuery.Confidence > 0)
                    {
                        <span class="@ConfidenceBadgeClass">@ConfidencePercent(_currentQuery.Confidence)</span>
                    }
                </div>
            }

            @* ── Insight Items ── *@
            <ul class="@ListClass" role="list">
                @foreach (var insight in VisibleInsights)
                {
                    <li role="listitem"
                        class="@InsightItemClass(insight)"
                        tabindex="0"
                        aria-label="@($"{insight.Title}{(insight.Confidence.HasValue ? $", confianca {ConfidencePercent(insight.Confidence)}" : "")}")"
                        @onclick="@(() => HandleInsightClickAsync(insight))"
                        @onkeydown="@((KeyboardEventArgs args) => HandleInsightKeyDownAsync(args, insight))">

                        @if (InsightTemplate is not null)
                        {
                            @InsightTemplate(insight)
                        }
                        else
                        {
                            @* ── Icon *@
                            <div class="@IconContainerClass(insight.Type)" aria-hidden="true">
                                <span class="@IconClass(insight.Type)">
                                    @XFSvgIcons.Markup(DefaultIconForType(insight.Type))
                                </span>
                            </div>

                            @* ── Content *@
                            <div class="min-w-0 flex-1">
                                <p class="@InsightTitleClass">@insight.Title</p>

                                @if (!string.IsNullOrWhiteSpace(insight.Description))
                                {
                                    <p class="@InsightDescriptionClass">@insight.Description</p>
                                }

                                @if (insight.Confidence.HasValue)
                                {
                                    <div class="@ConfidenceBarContainerClass">
                                        <div class="@ConfidenceBarTrackClass"
                                             role="progressbar"
                                             aria-valuenow="@((int)(insight.Confidence.Value * 100))"
                                             aria-valuemin="0"
                                             aria-valuemax="100"
                                             aria-label="Confianca">
                                            <div class="@ConfidenceBarFillClass(insight.Type)"
                                                 style="width: @ConfidenceWidth(insight.Confidence)%"></div>
                                        </div>
                                        <span class="@ConfidenceLabelClass">@ConfidencePercent(insight.Confidence)</span>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(insight.ActionLabel))
                                {
                                    <button type="button"
                                            class="@ActionButtonClass"
                                            @onclick="@(() => HandleInsightActionAsync(insight))"
                                            @onclick:stopPropagation="true">
                                        @insight.ActionLabel
                                    </button>
                                }
                            </div>
                        }
                    </li>
                }
            </ul>
        </div>
    }
</div>