@inherits XForgeComponentBase
@implements IDisposable

<div id="@Id"
     class="@RootClass"
     style="@Style"
     role="region"
     aria-label="Role-Based Access Control"
     data-theme="true"
     @attributes="AdditionalAttributes">

    @if (IsAllowed)
    {
        @ChildContent
    }
    else if (DeniedContent is not null)
    {
        @DeniedContent
    }
    else if (ShowDeniedIndicator)
    {
        <div class="flex items-center gap-2 p-2 rounded border border-dashed border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-800/50"
             role="alert"
             aria-label="Acesso restrito">
            <svg class="w-4 h-4 text-gray-400 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636" />
            </svg>
            <span class="text-xs text-gray-500 dark:text-gray-400">@DeniedLabel</span>
        </div>
    }
</div>
