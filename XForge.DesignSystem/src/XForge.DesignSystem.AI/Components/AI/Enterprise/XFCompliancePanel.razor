@inherits XForgeComponentBase
@implements IDisposable

<div id="@Id"
     class="@RootClass"
     style="@Style"
     role="region"
     aria-label="Painel de Conformidade"
     data-theme="true"
     @attributes="AdditionalAttributes">

    @* Header *@
    <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-gray-500 dark:text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <h3 class="text-sm font-semibold text-gray-900 dark:text-gray-100">@Title</h3>
            @foreach (var reg in Report?.Regulations ?? Array.Empty<XFComplianceRegulation>())
            {
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-medium bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300">@GetRegulationLabel(reg)</span>
            }
        </div>
        @if (ShowRefreshButton)
        {
            <button type="button"
                    class="p-1.5 rounded border border-gray-300 dark:border-gray-600 text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500"
                    @onclick="HandleRefreshAsync"
                    aria-label="Atualizar relatorio">
                <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
            </button>
        }
    </div>

    @if (Report is null)
    {
        <div class="flex flex-col items-center justify-center py-8 text-center">
            <svg class="w-10 h-10 text-gray-300 dark:text-gray-600 mb-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <p class="text-sm text-gray-500 dark:text-gray-400">@EmptyLabel</p>
        </div>
    }
    else
    {
        @* Summary Cards *@
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-4">
            <div class="p-3 rounded-lg bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800">
                <p class="text-[10px] uppercase tracking-wider text-blue-600 dark:text-blue-400 font-medium">@UsersLabel</p>
                <p class="text-xl font-bold text-blue-900 dark:text-blue-100">@Report.TotalUsers</p>
            </div>
            <div class="p-3 rounded-lg bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800">
                <p class="text-[10px] uppercase tracking-wider text-green-600 dark:text-green-400 font-medium">@ActiveConsentsLabel</p>
                <p class="text-xl font-bold text-green-900 dark:text-green-100">@Report.ActiveConsents</p>
            </div>
            <div class="p-3 rounded-lg bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800">
                <p class="text-[10px] uppercase tracking-wider text-amber-600 dark:text-amber-400 font-medium">@RevokedConsentsLabel</p>
                <p class="text-xl font-bold text-amber-900 dark:text-amber-100">@Report.RevokedConsents</p>
            </div>
            <div class="p-3 rounded-lg bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800">
                <p class="text-[10px] uppercase tracking-wider text-red-600 dark:text-red-400 font-medium">@PendingDeletionsLabel</p>
                <p class="text-xl font-bold text-red-900 dark:text-red-100">@Report.PendingDeletions</p>
            </div>
        </div>

        @* Deletion Requests *@
        @if (DeletionRequests.Count > 0)
        {
            <div class="mb-4">
                <h4 class="text-xs font-semibold text-gray-700 dark:text-gray-300 mb-2 uppercase tracking-wider">@DeletionRequestsLabel</h4>
                <div class="space-y-2">
                    @foreach (var req in DeletionRequests.Take(MaxVisibleRequests))
                    {
                        <div class="flex items-center justify-between p-2 rounded border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800">
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2">
                                    @GetDeletionStatusBadge(req.Status)
                                    <span class="text-xs font-medium text-gray-900 dark:text-gray-100">@req.UserId</span>
                                </div>
                                @if (!string.IsNullOrEmpty(req.Reason))
                                {
                                    <p class="text-[11px] text-gray-500 dark:text-gray-400 mt-0.5 truncate">@req.Reason</p>
                                }
                                <span class="text-[10px] text-gray-400 dark:text-gray-500">@FormatTimestamp(req.RequestedAt)</span>
                            </div>
                            @if (req.Status == XFDeletionRequestStatus.Pending && ShowActionButtons)
                            {
                                <div class="flex gap-1 ml-2">
                                    <button type="button"
                                            class="px-2 py-1 text-[10px] font-medium rounded bg-green-500 text-white hover:bg-green-600 transition-colors focus:outline-none focus:ring-2 focus:ring-green-500"
                                            @onclick="() => HandleApproveDeletionAsync(req)"
                                            aria-label="Aprovar exclusao">
                                        @ApproveLabel
                                    </button>
                                    <button type="button"
                                            class="px-2 py-1 text-[10px] font-medium rounded bg-red-500 text-white hover:bg-red-600 transition-colors focus:outline-none focus:ring-2 focus:ring-red-500"
                                            @onclick="() => HandleRejectDeletionAsync(req)"
                                            aria-label="Rejeitar exclusao">
                                        @RejectLabel
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        @* Retention Policies *@
        @if (Report.RetentionPolicies.Count > 0)
        {
            <div class="mb-4">
                <h4 class="text-xs font-semibold text-gray-700 dark:text-gray-300 mb-2 uppercase tracking-wider">@RetentionPoliciesLabel</h4>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                    @foreach (var policy in Report.RetentionPolicies)
                    {
                        <div class="flex items-center justify-between p-2 rounded border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800">
                            <div>
                                <span class="text-xs font-medium text-gray-900 dark:text-gray-100">@GetCategoryLabel(policy.Category)</span>
                                <span class="text-[10px] text-gray-500 dark:text-gray-400 ml-2">@policy.RetentionDays @DaysLabel</span>
                            </div>
                            <div class="flex items-center gap-2">
                                @if (policy.AutoDelete)
                                {
                                    <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300">Auto</span>
                                }
                                <span class="text-[10px] text-gray-400 dark:text-gray-500">@GetLegalBasisLabel(policy.LegalBasis)</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @* Consent by Category *@
        @if (Report.ConsentsByCategory.Count > 0)
        {
            <div>
                <h4 class="text-xs font-semibold text-gray-700 dark:text-gray-300 mb-2 uppercase tracking-wider">@ConsentByCategoryLabel</h4>
                <div class="space-y-1.5">
                    @foreach (var (category, count) in Report.ConsentsByCategory)
                    {
                        var total = Report.ActiveConsents + Report.RevokedConsents;
                        var pct = total > 0 ? (count * 100.0 / total) : 0;
                        <div>
                            <div class="flex items-center justify-between mb-0.5">
                                <span class="text-[11px] text-gray-700 dark:text-gray-300">@GetCategoryLabel(category)</span>
                                <span class="text-[10px] text-gray-500 dark:text-gray-400">@count</span>
                            </div>
                            <div class="w-full h-1.5 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden">
                                <div class="h-full bg-blue-500 dark:bg-blue-400 rounded-full transition-all" style="width: @pct.ToString("F0")%"></div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>
