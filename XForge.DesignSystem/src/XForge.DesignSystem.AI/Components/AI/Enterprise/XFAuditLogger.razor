@inherits XForgeComponentBase
@implements IDisposable

<div id="@Id"
     class="@RootClass"
     style="@Style"
     role="region"
     aria-label="Audit Logger"
     data-theme="true"
     @attributes="AdditionalAttributes">

    @* Header *@
    <div class="flex items-center justify-between mb-3">
        <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-gray-500 dark:text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
            </svg>
            <h3 class="text-sm font-semibold text-gray-900 dark:text-gray-100">@Title</h3>
            @if (FilteredEntries.Count > 0)
            {
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300">@FilteredEntries.Count</span>
            }
        </div>
        @if (ShowExportButton)
        {
            <button type="button"
                    class="px-3 py-1 text-xs font-medium rounded border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500"
                    @onclick="HandleExportAsync"
                    aria-label="Exportar logs">
                @ExportLabel
            </button>
        }
    </div>

    @* Filters *@
    @if (ShowFilters)
    {
        <div class="flex flex-wrap gap-2 mb-3">
            <select class="px-2 py-1 text-xs rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
                    @onchange="HandleSeverityFilter" aria-label="Filtrar por severidade">
                <option value="">@AllSeveritiesLabel</option>
                <option value="Info">Info</option>
                <option value="Warning">Warning</option>
                <option value="Error">Error</option>
                <option value="Critical">Critical</option>
            </select>
            <select class="px-2 py-1 text-xs rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
                    @onchange="HandleActionFilter" aria-label="Filtrar por acao">
                <option value="">@AllActionsLabel</option>
                @foreach (var action in Enum.GetValues<XFAuditAction>())
                {
                    <option value="@action">@GetActionLabel(action)</option>
                }
            </select>
            <input type="text"
                   placeholder="@SearchPlaceholder"
                   class="flex-1 min-w-[120px] px-2 py-1 text-xs rounded border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 placeholder-gray-400 dark:placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
                   @oninput="HandleSearchInput"
                   aria-label="Pesquisar nos logs" />
        </div>
    }

    @* Entries *@
    @if (FilteredEntries.Count == 0)
    {
        <div class="flex flex-col items-center justify-center py-8 text-center">
            <svg class="w-10 h-10 text-gray-300 dark:text-gray-600 mb-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m5.231 13.481L15 17.25m-4.5-15H5.625c-.621 0-1.125.504-1.125 1.125v16.5c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
            </svg>
            <p class="text-sm text-gray-500 dark:text-gray-400">@EmptyLabel</p>
        </div>
    }
    else
    {
        <div class="space-y-1 max-h-96 overflow-y-auto" role="log" aria-live="polite">
            @foreach (var entry in FilteredEntries.Take(MaxVisible))
            {
                <div class="flex items-start gap-2 p-2 rounded hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors @GetSeverityBgClass(entry.Severity)">
                    @GetSeverityIcon(entry.Severity)
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-medium text-gray-900 dark:text-gray-100">@GetActionLabel(entry.Action)</span>
                            @if (!string.IsNullOrEmpty(entry.Resource))
                            {
                                <span class="text-[10px] text-gray-500 dark:text-gray-400 truncate">@entry.Resource</span>
                            }
                            @if (!entry.Success)
                            {
                                <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-300">Falha</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(entry.Details))
                        {
                            <p class="text-[11px] text-gray-600 dark:text-gray-400 mt-0.5 line-clamp-2">@entry.Details</p>
                        }
                        <div class="flex items-center gap-3 mt-1">
                            @if (!string.IsNullOrEmpty(entry.UserName))
                            {
                                <span class="text-[10px] text-gray-500 dark:text-gray-500">@entry.UserName</span>
                            }
                            <span class="text-[10px] text-gray-400 dark:text-gray-600">@FormatTimestamp(entry.Timestamp)</span>
                            @if (entry.Duration is { } dur)
                            {
                                <span class="text-[10px] text-gray-400 dark:text-gray-600">@FormatDuration(dur)</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (FilteredEntries.Count > MaxVisible)
        {
            <div class="text-center mt-2">
                <button type="button"
                        class="text-xs text-blue-600 dark:text-blue-400 hover:underline focus:outline-none focus:ring-2 focus:ring-blue-500 rounded"
                        @onclick="LoadMoreAsync">
                    @LoadMoreLabel (@(FilteredEntries.Count - MaxVisible) @RemainingLabel)
                </button>
            </div>
        }
    }
</div>
