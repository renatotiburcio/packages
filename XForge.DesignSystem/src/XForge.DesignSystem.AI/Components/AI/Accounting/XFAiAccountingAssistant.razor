@using XForge.DesignSystem.Components.AI.Common
@using XForge.DesignSystem.Services.AI
@inherits XForgeComponentBase

<section class="@RootClass" style="@Style" role="region" aria-label="@Title" aria-busy="@AriaBusyValue" @attributes="AdditionalAttributes">
    @if (ShowHeader)
    {
        <header class="@HeaderClass">
            @if (HeaderContent is not null) { @HeaderContent }
            else { <div class="min-w-0"><div class="@HeaderTitleClass"><span class="inline-flex h-5 w-5 items-center justify-center text-text-muted" aria-hidden="true">@XFSvgIcons.Markup("sparkles")</span>@Title</div></div> }
        </header>
    }

    <div class="@InputContainerClass">
        <textarea class="@TextareaClass" rows="3" value="@_query" placeholder="@Placeholder" disabled="@IsBusy" aria-label="@Placeholder" @oninput="HandleInput" @onkeydown="HandleKeyDownAsync" @onkeydown:preventDefault="@_preventEnterDefault"></textarea>
        <div class="@InputActionsClass">
            <button type="button" class="@SendButtonClass" disabled="@(!CanSend)" aria-label="Analisar contabilidade" @onclick="AnalyzeAsync">
                @if (IsBusy) { <span class="inline-flex h-4 w-4 animate-spin items-center justify-center" aria-hidden="true">@XFSvgIcons.Markup("spinner")</span> }
                else { <span class="inline-flex h-4 w-4 items-center justify-center" aria-hidden="true">@XFSvgIcons.Markup("calculator")</span> }
                <span>Analisar</span>
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorText))
    {
        <div class="@ErrorBannerClass" role="alert">
            <span class="inline-flex h-4 w-4 items-center justify-center" aria-hidden="true">@XFSvgIcons.Markup("circle-exclamation")</span>
            <span>@_errorText</span>
            <button type="button" class="ml-auto inline-flex h-5 w-5 items-center justify-center rounded text-text-muted hover:text-text-primary" aria-label="Dispensar erro" @onclick="DismissError"><span class="inline-flex h-3 w-3 items-center justify-center" aria-hidden="true">@XFSvgIcons.Markup("xmark")</span></button>
        </div>
    }

    @if (IsBusy)
    {
        <div class="@LoadingContainerClass" role="status" aria-label="Analisando contabilidade...">
            <span class="sr-only">Analisando contabilidade...</span>
            <div class="space-y-3"><div class="@SkeletonLineClass w-3/4"></div><div class="@SkeletonLineClass w-1/2"></div><div class="@SkeletonLineClass w-5/6"></div></div>
        </div>
    }

    @if (!IsBusy && _result is not null)
    {
        <div class="@PreviewContainerClass" aria-live="polite" aria-label="Resultado da analise contabil">
            @if (ResultPreview is not null) { @ResultPreview(_result) }
            else
            {
                @if (!string.IsNullOrWhiteSpace(_result.AiSummary))
                {
                    <div class="@SummaryBoxClass"><div class="flex items-start gap-2"><span class="inline-flex h-4 w-4 shrink-0 items-center justify-center text-primary" aria-hidden="true">@XFSvgIcons.Markup("sparkles")</span><p class="text-sm leading-5 text-text-primary">@_result.AiSummary</p></div></div>
                }
                @if (_result.DreSummary is not null)
                {
                    <div class="mb-3 rounded-lg bg-surface-50 p-3 ring-1 ring-border-light">
                        <div class="mb-2 text-xs font-semibold uppercase tracking-wider text-text-muted">DRE Simplificado</div>
                        <div class="grid grid-cols-2 gap-2 text-xs">
                            <div><span class="text-text-muted">Receita:</span> <span class="font-semibold text-emerald-600">@_result.DreSummary.Revenue.ToString("C0")</span></div>
                            <div><span class="text-text-muted">Lucro Liquido:</span> <span class="font-semibold @(_result.DreSummary.NetIncome >= 0 ? "text-emerald-600" : "text-red-600")">@_result.DreSummary.NetIncome.ToString("C0")</span></div>
                            <div><span class="text-text-muted">Margem Bruta:</span> <span class="font-semibold">@_result.DreSummary.GrossMargin.ToString("F1")%</span></div>
                            <div><span class="text-text-muted">Margem Liquida:</span> <span class="font-semibold">@_result.DreSummary.NetMargin.ToString("F1")%</span></div>
                        </div>
                    </div>
                }
                @if (_result.SuggestedEntries is { Count: > 0 })
                {
                    <div class="mb-3"><div class="mb-1.5 text-xs font-semibold uppercase tracking-wider text-text-muted">Lancamentos Sugeridos</div>
                        <div class="space-y-1">@foreach (var entry in _result.SuggestedEntries)
                        { <div class="rounded-md bg-surface-50 px-3 py-2 text-xs ring-1 ring-border-light"><div class="font-medium text-text-primary">@entry.Description</div><div class="mt-1 flex items-center gap-2 text-text-secondary"><span class="rounded bg-emerald-50 px-1.5 py-0.5 text-emerald-700 ring-1 ring-emerald-200">D: @entry.DebitAccount</span><span class="rounded bg-red-50 px-1.5 py-0.5 text-red-700 ring-1 ring-red-200">C: @entry.CreditAccount</span><span class="font-semibold">@entry.Amount.ToString("C2")</span></div></div> }</div>
                    </div>
                }
                @if (_result.Confidence > 0)
                {
                    <div class="flex items-center gap-2"><span class="text-xs text-text-muted">Confianca:</span><div class="@ConfidenceTrackClass" role="progressbar" aria-valuenow="@((int)(_result.Confidence * 100))" aria-valuemin="0" aria-valuemax="100"><div class="@ConfidenceFillClass" style="width: @((int)(_result.Confidence * 100))%"></div></div><span class="text-xs font-medium tabular-nums">@((_result.Confidence * 100).ToString("F0"))%</span></div>
                }
            }
        </div>
    }

    @if (!IsBusy && _result is null && string.IsNullOrWhiteSpace(_errorText))
    {
        <div class="@EmptyContainerClass">
            @if (EmptyContent is not null) { @EmptyContent }
            else { <div class="@EmptyInnerClass"><div class="@EmptyIconClass" aria-hidden="true">@XFSvgIcons.Markup("calculator")</div><div class="text-sm font-medium text-text-primary">Assistente Contabil</div><div class="@EmptyTextClass">Pergunte sobre lancamentos sugeridos, DRE, classificacao automatica, auditoria contabil ou reprocessamento.</div></div> }
        </div>
    }
</section>
