@inherits XForgeComponentBase

<article @attributes="AdditionalAttributes"
         id="@Id"
         class="@RootClass"
         style="@Style"
         role="region"
         aria-label="@($"Aprovacao: {Request.Title}")"
         aria-busy="@AriaBusyValue">

    @* ── Risk Indicator Bar *@
    <div class="@RiskBarClass" aria-hidden="true"></div>

    @* ── Header *@
    <div class="@HeaderClass">
        <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2">
                <span class="inline-flex h-4 w-4 items-center justify-center text-text-muted" aria-hidden="true">
                    @XFSvgIcons.Markup("user-shield")
                </span>
                <h3 class="truncate text-sm font-semibold text-text-primary">@Request.Title</h3>
            </div>
            @if (!string.IsNullOrWhiteSpace(Request.RequestedBy))
            {
                <p class="mt-0.5 text-xs text-text-muted">
                    Solicitado por <span class="font-medium text-text-secondary">@Request.RequestedBy</span>
                    em @Request.RequestedAt.ToString("dd/MM/yyyy HH:mm")
                </p>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(Request.Category))
        {
            <span class="@CategoryBadgeClass">@Request.Category</span>
        }
    </div>

    @* ── Body *@
    <div class="@BodyClass">
        @* -- Description *@
        <p class="text-sm leading-6 text-text-primary">@Request.Description</p>

        @* -- Risk Score *@
        @if (Request.RiskScore > 0)
        {
            <div class="mt-3 flex items-center gap-2">
                <span class="text-xs text-text-muted">Risco:</span>
                <div class="@RiskTrackClass" role="progressbar"
                     aria-valuenow="@((int)(Request.RiskScore * 100))" aria-valuemin="0" aria-valuemax="100"
                     aria-label="Score de risco">
                    <div class="@RiskFillClass" style="width: @((int)(Request.RiskScore * 100))%"></div>
                </div>
                <span class="@RiskLabelClass">@((int)(Request.RiskScore * 100))%</span>
            </div>
        }

        @* -- Impact Analysis *@
        @if (!string.IsNullOrWhiteSpace(Request.ImpactAnalysis))
        {
            <div class="mt-3 rounded-md bg-amber-50 px-3 py-2.5 text-xs text-amber-800 ring-1 ring-amber-200">
                <div class="flex items-start gap-1.5">
                    <span class="inline-flex h-3.5 w-3.5 shrink-0 items-center justify-center" aria-hidden="true">
                        @XFSvgIcons.Markup("triangle-exclamation")
                    </span>
                    <div>
                        <span class="font-semibold">Analise de impacto:</span>
                        <span class="ml-1">@Request.ImpactAnalysis</span>
                    </div>
                </div>
            </div>
        }

        @* -- Affected Entities *@
        @if (Request.AffectedEntities.Count > 0)
        {
            <div class="mt-2.5">
                <span class="text-xs font-medium text-text-muted">Entidades afetadas:</span>
                <div class="mt-1 flex flex-wrap gap-1">
                    @foreach (var entity in Request.AffectedEntities)
                    {
                        <span class="inline-flex items-center rounded-md bg-surface-50 px-2 py-0.5 text-[11px] text-text-secondary ring-1 ring-border-light">@entity</span>
                    }
                </div>
            </div>
        }

        @* -- Editable Payload *@
        @if (_decision == XFAiApprovalDecision.Edited && !string.IsNullOrWhiteSpace(Request.ProposedPayload))
        {
            <div class="mt-3">
                <label class="text-xs font-medium text-text-muted" for="@($"{Id}-edit")">Editar antes de aplicar:</label>
                <textarea id="@($"{Id}-edit")"
                          class="mt-1 w-full resize-none rounded-md border border-surface-200 bg-bg-surface px-3 py-2 text-xs leading-5 text-text-primary outline-none focus:border-[var(--color-primary)] focus:ring-1 focus:ring-[color-mix(in_oklab,var(--color-primary)_18%,transparent)]"
                          rows="3"
                          value="@_editedPayload"
                          @oninput="e => _editedPayload = e.Value?.ToString()"
                          aria-label="Editar payload"></textarea>
            </div>
        }

        @* -- Decision Status *@
        @if (_decision != XFAiApprovalDecision.Pending)
        {
            <div class="@DecisionBannerClass" role="status">
                <span class="inline-flex h-4 w-4 items-center justify-center" aria-hidden="true">
                    @XFSvgIcons.Markup(GetDecisionIcon())
                </span>
                <span class="font-medium">@GetDecisionLabel()</span>
                @* Reviewer notes can be added via OnEdited callback *@
            </div>
        }
    </div>

    @* ── Actions *@
    @if (_decision == XFAiApprovalDecision.Pending)
    {
        <div class="@ActionsClass">
            @if (ShowEditOption)
            {
                <button type="button"
                        class="@EditButtonClass"
                        disabled="@Disabled"
                        aria-label="Editar antes de aplicar"
                        @onclick="() => _decision = XFAiApprovalDecision.Edited">
                    <span class="inline-flex h-3.5 w-3.5 items-center justify-center" aria-hidden="true">
                        @XFSvgIcons.Markup("pencil")
                    </span>
                    <span>Editar</span>
                </button>
            }
            <button type="button"
                    class="@RejectButtonClass"
                    disabled="@Disabled"
                    aria-label="Rejeitar acao"
                    @onclick="RejectAsync">
                <span class="inline-flex h-3.5 w-3.5 items-center justify-center" aria-hidden="true">
                    @XFSvgIcons.Markup("xmark")
                </span>
                <span>@RejectLabel</span>
            </button>
            <button type="button"
                    class="@ApproveButtonClass"
                    disabled="@Disabled"
                    aria-label="Aprovar acao"
                    @onclick="ApproveAsync">
                <span class="inline-flex h-3.5 w-3.5 items-center justify-center" aria-hidden="true">
                    @XFSvgIcons.Markup("check")
                </span>
                <span>@ApproveLabel</span>
            </button>
        </div>
    }
</article>
