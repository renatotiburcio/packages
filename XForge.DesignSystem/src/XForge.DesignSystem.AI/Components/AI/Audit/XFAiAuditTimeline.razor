@inherits XForgeComponentBase

<section @attributes="AdditionalAttributes"
         id="@Id"
         class="@RootClass"
         style="@Style"
         role="region"
         aria-label="@Title">

    @* ── Header ─────────────────────────────────────────────────────────── *@
    @if (ShowHeader)
    {
        <div class="@HeaderClass">
            <div class="flex items-center gap-2">
                <span class="inline-flex h-4 w-4 items-center justify-center text-text-muted" aria-hidden="true">
                    @XFSvgIcons.Markup("clock-rotate-left")
                </span>
                <span class="text-sm font-semibold text-text-primary">@Title</span>
                @if (Entries.Count > 0)
                {
                    <span class="@CountBadgeClass">@Entries.Count</span>
                }
            </div>
            @if (ShowFilter)
            {
                <select class="@FilterClass"
                        aria-label="Filtrar por tipo"
                        @onchange="HandleFilterChange">
                    <option value="">Todos</option>
                    <option value="User">Usuarios</option>
                    <option value="Ai">IA</option>
                    <option value="System">Sistema</option>
                </select>
            }
        </div>
    }

    @* ── Timeline ───────────────────────────────────────────────────────── *@
    @if (FilteredEntries.Count > 0)
    {
        <ol class="@TimelineClass" role="list" aria-label="Timeline de auditoria">
            @foreach (var entry in FilteredEntries)
            {
                <li class="@ItemClass(entry)" role="listitem"
                    aria-label="@($"{entry.Action} por {entry.Actor} em {entry.Timestamp:dd/MM/yyyy HH:mm}")">

                    @* -- Dot *@
                    <div class="@DotContainerClass">
                        <div class="@DotClass(entry)"></div>
                    </div>

                    @* -- Content *@
                    <div class="min-w-0 flex-1 pb-6">
                        <div class="flex items-start justify-between gap-2">
                            <div class="min-w-0">
                                <p class="text-sm font-medium text-text-primary">@entry.Action</p>
                                <div class="mt-0.5 flex flex-wrap items-center gap-x-2 gap-y-0.5 text-xs text-text-muted">
                                    <span class="inline-flex items-center gap-1">
                                        <span class="inline-flex h-3 w-3 items-center justify-center" aria-hidden="true">
                                            @XFSvgIcons.Markup(GetActorIcon(entry))
                                        </span>
                                        @entry.Actor
                                    </span>
                                    <span>@entry.Timestamp.ToString("dd/MM/yyyy HH:mm")</span>
                                    @if (entry.Version > 0)
                                    {
                                        <span class="@VersionBadgeClass">v@entry.Version</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(entry.Category))
                                    {
                                        <span class="@CategoryBadgeClass">@entry.Category</span>
                                    }
                                </div>
                            </div>
                        </div>

                        @* -- AI Metadata *@
                        @if (entry.IsAiAction && !string.IsNullOrWhiteSpace(entry.Reasoning))
                        {
                            <div class="mt-2 rounded-md bg-purple-50 px-2.5 py-2 text-xs text-purple-700 ring-1 ring-purple-200">
                                <div class="flex items-start gap-1.5">
                                    <span class="inline-flex h-3 w-3 shrink-0 items-center justify-center" aria-hidden="true">
                                        @XFSvgIcons.Markup("sparkles")
                                    </span>
                                    <span>@entry.Reasoning</span>
                                </div>
                            </div>
                        }

                        @* -- Before/After *@
                        @if (ShowDiff && (!string.IsNullOrWhiteSpace(entry.BeforeState) || !string.IsNullOrWhiteSpace(entry.AfterState)))
                        {
                            <div class="mt-2 grid grid-cols-2 gap-2">
                                @if (!string.IsNullOrWhiteSpace(entry.BeforeState))
                                {
                                    <div class="@DiffBoxClass">
                                        <span class="text-[10px] font-semibold uppercase tracking-wider text-red-600">Antes</span>
                                        <pre class="mt-1 whitespace-pre-wrap break-words text-[11px] text-text-secondary">@entry.BeforeState</pre>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(entry.AfterState))
                                {
                                    <div class="@DiffBoxClass">
                                        <span class="text-[10px] font-semibold uppercase tracking-wider text-emerald-600">Depois</span>
                                        <pre class="mt-1 whitespace-pre-wrap break-words text-[11px] text-text-secondary">@entry.AfterState</pre>
                                    </div>
                                }
                            </div>
                        }

                        @* -- Hash *@
                        @if (ShowHash && !string.IsNullOrWhiteSpace(entry.Hash))
                        {
                            <div class="mt-1.5 flex items-center gap-1.5 text-[10px] text-text-muted">
                                <span class="inline-flex h-3 w-3 items-center justify-center" aria-hidden="true">
                                    @XFSvgIcons.Markup("hashtag")
                                </span>
                                <span class="font-mono">@entry.Hash[..Math.Min(16, entry.Hash.Length)]...</span>
                                @if (!string.IsNullOrWhiteSpace(entry.Signature))
                                {
                                    <span class="inline-flex items-center gap-0.5 text-emerald-600">
                                        <span class="inline-flex h-3 w-3 items-center justify-center" aria-hidden="true">
                                            @XFSvgIcons.Markup("lock")
                                        </span>
                                        Assinado
                                    </span>
                                }
                            </div>
                        }
                    </div>
                </li>
            }
        </ol>
    }
    else
    {
        @* ── Empty State *@
        <div class="@EmptyClass">
            @if (EmptyContent is not null)
            {
                @EmptyContent
            }
            else
            {
                <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-surface-100 text-text-muted" aria-hidden="true">
                    @XFSvgIcons.Markup("clock-rotate-left")
                </span>
                <p class="@EmptyTextClass">@EmptyText</p>
            }
        </div>
    }
</section>
