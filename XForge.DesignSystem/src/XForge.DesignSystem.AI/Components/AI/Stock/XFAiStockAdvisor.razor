@using XForge.DesignSystem.Components.AI.Common
@using XForge.DesignSystem.Services.AI
@inherits XForgeComponentBase

<section class="@RootClass"
         style="@Style"
         role="region"
         aria-label="@Title"
         aria-busy="@AriaBusyValue"
         @attributes="AdditionalAttributes">

    @if (ShowHeader)
    {
        <header class="@HeaderClass">
            @if (HeaderContent is not null) { @HeaderContent }
            else
            {
                <div class="min-w-0">
                    <div class="@HeaderTitleClass">
                        <span class="inline-flex h-5 w-5 items-center justify-center text-text-muted" aria-hidden="true">@XFSvgIcons.Markup("sparkles")</span>
                        @Title
                    </div>
                </div>
            }
        </header>
    }

    <div class="@InputContainerClass">
        <textarea class="@TextareaClass" rows="3" value="@_query" placeholder="@Placeholder" disabled="@IsBusy"
                  aria-label="@Placeholder" @oninput="HandleInput" @onkeydown="HandleKeyDownAsync" @onkeydown:preventDefault="@_preventEnterDefault"></textarea>
        <div class="@InputActionsClass">
            <button type="button" class="@SendButtonClass" disabled="@(!CanSend)" aria-label="Analisar estoque" @onclick="AnalyzeAsync">
                @if (IsBusy) { <span class="inline-flex h-4 w-4 animate-spin items-center justify-center" aria-hidden="true">@XFSvgIcons.Markup("spinner")</span> }
                else { <span class="inline-flex h-4 w-4 items-center justify-center" aria-hidden="true">@XFSvgIcons.Markup("boxes-stacked")</span> }
                <span>Analisar</span>
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorText))
    {
        <div class="@ErrorBannerClass" role="alert">
            <span class="inline-flex h-4 w-4 items-center justify-center" aria-hidden="true">@XFSvgIcons.Markup("circle-exclamation")</span>
            <span>@_errorText</span>
            <button type="button" class="ml-auto inline-flex h-5 w-5 items-center justify-center rounded text-text-muted hover:text-text-primary" aria-label="Dispensar erro" @onclick="DismissError">
                <span class="inline-flex h-3 w-3 items-center justify-center" aria-hidden="true">@XFSvgIcons.Markup("xmark")</span>
            </button>
        </div>
    }

    @if (IsBusy)
    {
        <div class="@LoadingContainerClass" role="status" aria-label="Analisando estoque...">
            <span class="sr-only">Analisando estoque...</span>
            <div class="space-y-3">
                <div class="@SkeletonLineClass w-3/4"></div>
                <div class="@SkeletonLineClass w-1/2"></div>
                <div class="@SkeletonLineClass w-5/6"></div>
            </div>
        </div>
    }

    @if (!IsBusy && _result is not null)
    {
        <div class="@PreviewContainerClass" aria-live="polite" aria-label="Resultado da analise de estoque">
            @if (ResultPreview is not null) { @ResultPreview(_result) }
            else
            {
                @if (!string.IsNullOrWhiteSpace(_result.AiSummary))
                {
                    <div class="@SummaryBoxClass">
                        <div class="flex items-start gap-2">
                            <span class="inline-flex h-4 w-4 shrink-0 items-center justify-center text-primary" aria-hidden="true">@XFSvgIcons.Markup("sparkles")</span>
                            <p class="text-sm leading-5 text-text-primary">@_result.AiSummary</p>
                        </div>
                    </div>
                }

                @if (_result.Summary is not null)
                {
                    <div class="mb-3 grid grid-cols-3 gap-2 text-xs">
                        <div class="rounded bg-surface-50 px-3 py-2 ring-1 ring-border-light text-center">
                            <div class="text-lg font-bold text-text-primary">@_result.Summary.TotalProducts</div>
                            <div class="text-text-muted">Produtos</div>
                        </div>
                        <div class="rounded bg-surface-50 px-3 py-2 ring-1 ring-border-light text-center">
                            <div class="text-lg font-bold text-amber-600">@_result.Summary.LowStockProducts</div>
                            <div class="text-text-muted">Estoque Baixo</div>
                        </div>
                        <div class="rounded bg-surface-50 px-3 py-2 ring-1 ring-border-light text-center">
                            <div class="text-lg font-bold text-blue-600">@_result.Summary.OverstockProducts</div>
                            <div class="text-text-muted">Excesso</div>
                        </div>
                    </div>
                }

                @if (_result.Alerts is { Count: > 0 })
                {
                    <div class="mb-3">
                        <div class="mb-1.5 text-xs font-semibold uppercase tracking-wider text-text-muted">Alertas</div>
                        <div class="space-y-1">
                            @foreach (var alert in _result.Alerts)
                            {
                                <div class="@GetAlertClass(alert.Severity)">
                                    <span class="inline-flex h-4 w-4 shrink-0 items-center justify-center" aria-hidden="true">@XFSvgIcons.Markup(GetAlertIcon(alert.Type))</span>
                                    <div class="min-w-0 flex-1">
                                        <span class="font-medium">@alert.ProductName</span>: @alert.Message
                                        @if (!string.IsNullOrWhiteSpace(alert.RecommendedAction)) { <p class="mt-0.5 text-xs opacity-80">@alert.RecommendedAction</p> }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (_result.Confidence > 0)
                {
                    <div class="flex items-center gap-2">
                        <span class="text-xs text-text-muted">Confianca:</span>
                        <div class="@ConfidenceTrackClass" role="progressbar" aria-valuenow="@((int)(_result.Confidence * 100))" aria-valuemin="0" aria-valuemax="100">
                            <div class="@ConfidenceFillClass" style="width: @((int)(_result.Confidence * 100))%"></div>
                        </div>
                        <span class="text-xs font-medium tabular-nums">@((_result.Confidence * 100).ToString("F0"))%</span>
                    </div>
                }
            }
        </div>
    }

    @if (!IsBusy && _result is null && string.IsNullOrWhiteSpace(_errorText))
    {
        <div class="@EmptyContainerClass">
            @if (EmptyContent is not null) { @EmptyContent }
            else
            {
                <div class="@EmptyInnerClass">
                    <div class="@EmptyIconClass" aria-hidden="true">@XFSvgIcons.Markup("boxes-stacked")</div>
                    <div class="text-sm font-medium text-text-primary">Assistente de Estoque</div>
                    <div class="@EmptyTextClass">Pergunte sobre previsao de demanda, curva ABC, ruptura de estoque, sugestoes de compra ou analise de giro.</div>
                </div>
            }
        </div>
    }
</section>