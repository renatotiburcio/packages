@inherits XForgeComponentBase
@implements IDisposable

<div class="@RootClass"
     role="region"
     aria-label="@AriaLabel"
     @attributes="AdditionalAttributes">

    @if (ShowHeader)
    {
        <div class="flex items-center justify-between border-b border-border-light px-4 py-2.5">
            <div class="flex items-center gap-2">
                <span class="text-sm font-semibold text-text-primary">@Title</span>
                <span class="rounded-full bg-surface-100 px-2 py-0.5 text-xs text-text-secondary dark:bg-slate-800">
                    @FilteredTokens.Count tokens
                </span>
            </div>
            <div class="flex items-center gap-2">
                @if (ShowSearch)
                {
                    <input type="search"
                           placeholder="Buscar token..."
                           class="w-48 rounded border border-border-light bg-bg-surface px-2 py-1 text-xs text-text-primary placeholder:text-text-muted"
                           value="@_searchTerm"
                           @oninput="OnSearchChanged"
                           aria-label="Buscar tokens" />
                }
                @if (ShowCategoryFilter)
                {
                    <select class="rounded border border-border-light bg-bg-surface px-2 py-1 text-xs text-text-secondary"
                            @onchange="OnCategoryChanged"
                            aria-label="Filtrar por categoria">
                        <option value="">Todas</option>
                        @foreach (var cat in _categories)
                        {
                            <option value="@cat">@GetCategoryLabel(cat)</option>
                        }
                    </select>
                }
                @if (ShowExport)
                {
                    <div class="flex gap-1">
                        <button class="rounded border border-border-light px-2 py-1 text-xs text-text-muted hover:bg-surface-100 hover:text-text-primary"
                                @onclick='() => ExportTokens("CSS")'>CSS</button>
                        <button class="rounded border border-border-light px-2 py-1 text-xs text-text-muted hover:bg-surface-100 hover:text-text-primary"
                                @onclick='() => ExportTokens("JSON")'>JSON</button>
                        <button class="rounded border border-border-light px-2 py-1 text-xs text-text-muted hover:bg-surface-100 hover:text-text-primary"
                                @onclick='() => ExportTokens("SCSS")'>SCSS</button>
                        <button class="rounded border border-border-light px-2 py-1 text-xs text-text-muted hover:bg-surface-100 hover:text-text-primary"
                                @onclick='() => ExportTokens("TS")'>TS</button>
                    </div>
                }
            </div>
        </div>
    }

    @if (ShowGroupHeaders)
    {
        @foreach (var group in GroupedTokens)
        {
            <div class="border-b border-border-light">
                <button class="flex w-full items-center justify-between px-4 py-2 text-xs font-semibold uppercase tracking-wide text-text-secondary hover:bg-surface-50 dark:hover:bg-slate-800/50"
                        @onclick="() => ToggleGroup(group.Key)">
                    <span>@group.Key</span>
                    <span class="flex items-center gap-2">
                        <span class="text-text-muted">@group.Value.Count tokens</span>
                        <svg class="h-3 w-3 text-text-muted transition-transform @(_collapsedGroups.Contains(group.Key) ? "" : "rotate-180")" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                    </span>
                </button>
                @if (!_collapsedGroups.Contains(group.Key))
                {
                    <div class="px-4 pb-3">
                        <div class="grid gap-1">
                            @foreach (var token in group.Value)
                            {
                                <div class="flex items-center gap-3 rounded px-2 py-1.5 hover:bg-surface-50 dark:hover:bg-slate-800/50">
                                    @if (token.Category == XFDesignTokenCategory.Color)
                                    {
                                        <div class="h-4 w-4 rounded border border-border-light shrink-0" style="background: @token.Value" title="@token.Value"></div>
                                    }
                                    else
                                    {
                                        <div class="h-4 w-4 shrink-0"></div>
                                    }
                                    <span class="w-40 font-mono text-xs text-text-primary">@token.Name</span>
                                    <span class="flex-1 font-mono text-xs text-text-secondary">@token.Value</span>
                                    <span class="w-48 font-mono text-xs text-text-muted">@token.CssVariable</span>
                                    @if (!string.IsNullOrEmpty(token.Description))
                                    {
                                        <span class="w-40 truncate text-xs text-text-muted" title="@token.Description">@token.Description</span>
                                    }
                                    @if (ShowCopyButton)
                                    {
                                        <button class="rounded p-1 text-text-muted hover:bg-surface-100 hover:text-text-primary"
                                                @onclick="() => CopyToken(token)"
                                                title="Copiar"
                                                aria-label="Copiar @token.Name">
                                            <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <div class="max-h-96 overflow-auto px-4 py-2">
            <div class="grid gap-1">
                @foreach (var token in FilteredTokens)
                {
                    <div class="flex items-center gap-3 rounded px-2 py-1.5 hover:bg-surface-50 dark:hover:bg-slate-800/50">
                        @if (token.Category == XFDesignTokenCategory.Color)
                        {
                            <div class="h-4 w-4 rounded border border-border-light shrink-0" style="background: @token.Value"></div>
                        }
                        <span class="w-40 font-mono text-xs text-text-primary">@token.Name</span>
                        <span class="flex-1 font-mono text-xs text-text-secondary">@token.Value</span>
                        <span class="w-48 font-mono text-xs text-text-muted">@token.CssVariable</span>
                    </div>
                }
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(_exportOutput))
    {
        <div class="border-t border-border-light px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-text-secondary">Export (@_exportFormat)</span>
                <button class="rounded p-1 text-text-muted hover:bg-surface-100 hover:text-text-primary"
                        @onclick='() => _exportOutput = ""'
                        title="Fechar"
                        aria-label="Fechar export">
                    <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>
            <pre class="mt-2 max-h-48 overflow-auto rounded bg-surface-100 p-3 font-mono text-xs text-text-primary dark:bg-slate-800"><code>@_exportOutput</code></pre>
        </div>
    }
</div>
