@inherits XForgeComponentBase
@implements IDisposable

<div class="@RootClass"
     role="region"
     aria-label="@AriaLabel"
     @attributes="AdditionalAttributes">

    @if (ShowHeader)
    {
        <div class="flex items-center justify-between border-b border-border-light px-4 py-2.5">
            <div class="flex items-center gap-2">
                <span class="text-sm font-semibold text-text-primary">@Title</span>
                <span class="rounded-full bg-violet-100 px-2 py-0.5 text-xs text-violet-700 dark:bg-violet-900/30 dark:text-violet-300">
                    @(_activeTab)
                </span>
            </div>
            <div class="flex items-center gap-2">
                @if (ShowPresetSelector)
                {
                    <select class="rounded border border-border-light bg-bg-surface px-2 py-1 text-xs text-text-secondary"
                            @onchange="OnPresetChanged">
                        <option value="">Personalizado</option>
                        @foreach (var preset in Presets)
                        {
                            <option value="@preset.Name" selected="@(preset.Name == _selectedPreset)">@preset.Name</option>
                        }
                    </select>
                }
                @if (ShowDarkModeToggle)
                {
                    <button class="rounded p-1.5 text-text-muted hover:bg-surface-100 hover:text-text-primary dark:hover:bg-slate-700"
                            @onclick="ToggleDarkMode"
                            title="@(_isDark ? "Modo claro" : "Modo escuro")"
                            aria-label="@(_isDark ? "Modo claro" : "Modo escuro")">
                        @if (_isDark)
                        {
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                        }
                        else
                        {
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
                        }
                    </button>
                }
            </div>
        </div>
    }

    <div class="flex border-b border-border-light">
        @foreach (var tab in _tabs)
        {
            <button class="px-4 py-2 text-xs font-medium transition-colors @(_activeTab == tab ? "border-b-2 border-primary text-primary" : "text-text-muted hover:text-text-secondary")"
                    @onclick="() => _activeTab = tab"
                    aria-selected="@(_activeTab == tab)"
                    role="tab">
                @tab
            </button>
        }
    </div>

    <div class="p-4">
        @if (_activeTab == "Cores")
        {
            <div class="grid gap-3">
                @foreach (var color in _colors)
                {
                    <div class="flex items-center gap-3">
                        <label class="w-24 text-xs text-text-secondary" for="@($"color-{color.Name}")">@color.Name</label>
                        <div class="flex items-center gap-2">
                            <div class="h-6 w-6 rounded border border-border-light" style="background: @color.Value" title="@color.Value"></div>
                            <input id="@($"color-{color.Name}")"
                                   type="color"
                                   value="@color.Value"
                                   class="h-8 w-16 cursor-pointer rounded border border-border-light"
                                   @onchange="(e) => HandleColorChanged(color.Name, e.Value?.ToString() ?? color.Value)"
                                   aria-label="Cor @color.Name" />
                            <input type="text"
                                   value="@color.Value"
                                   class="w-20 rounded border border-border-light bg-bg-surface px-2 py-1 font-mono text-xs text-text-primary"
                                   @onchange="(e) => HandleColorChanged(color.Name, e.Value?.ToString() ?? color.Value)"
                                   aria-label="Hex @color.Name" />
                        </div>
                        <span class="text-xs text-text-muted font-mono">@color.CssVariable</span>
                    </div>
                }
            </div>
        }
        else if (_activeTab == "Tipografia")
        {
            <div class="grid gap-3">
                @foreach (var typo in _typography)
                {
                    <div class="rounded-lg border border-border-light p-3">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-semibold text-text-secondary">@typo.Name</span>
                            <span class="font-mono text-xs text-text-muted">@typo.CssVariable</span>
                        </div>
                        <div class="mt-2 grid grid-cols-2 gap-2">
                            <div>
                                <label class="text-xs text-text-muted">Fonte</label>
                                <input type="text" value="@typo.FontFamily"
                                       class="w-full rounded border border-border-light bg-bg-surface px-2 py-1 text-xs text-text-primary"
                                       @onchange="(e) => HandleTypographyChanged(typo.Name, FontFamilyProp, e.Value?.ToString() ?? typo.FontFamily)" />
                            </div>
                            <div>
                                <label class="text-xs text-text-muted">Tamanho</label>
                                <input type="text" value="@typo.FontSize"
                                       class="w-full rounded border border-border-light bg-bg-surface px-2 py-1 text-xs text-text-primary"
                                       @onchange="(e) => HandleTypographyChanged(typo.Name, FontSizeProp, e.Value?.ToString() ?? typo.FontSize)" />
                            </div>
                        </div>
                        <div class="mt-2" style="font-family: @typo.FontFamily; font-size: @typo.FontSize; font-weight: @typo.FontWeight; line-height: @typo.LineHeight; letter-spacing: @typo.LetterSpacing;">
                            <span class="text-text-primary">The quick brown fox jumps over the lazy dog.</span>
                        </div>
                    </div>
                }
            </div>
        }
        else if (_activeTab == "Espacamento")
        {
            <div class="grid gap-3">
                @foreach (var space in _spacing)
                {
                    <div class="flex items-center gap-3">
                        <label class="w-16 text-xs text-text-secondary">@space.Name</label>
                        <div class="flex-1">
                            <div class="h-4 rounded bg-primary/20" style="width: @space.Value"></div>
                        </div>
                        <input type="text" value="@space.Value"
                               class="w-20 rounded border border-border-light bg-bg-surface px-2 py-1 font-mono text-xs text-text-primary"
                               @onchange="(e) => HandleSpacingChanged(space.Name, e.Value?.ToString() ?? space.Value)"
                               aria-label="Espacamento @space.Name" />
                        <span class="w-24 font-mono text-xs text-text-muted">@space.CssVariable</span>
                    </div>
                }
            </div>
        }
        else if (_activeTab == "Preview")
        {
            <div class="grid gap-4">
                <div class="rounded-lg border border-border-light p-4">
                    <h3 class="mb-2 text-sm font-semibold text-text-primary">Botoes</h3>
                    <div class="flex flex-wrap gap-2">
                        <button class="rounded px-3 py-1.5 text-sm font-medium text-white" style="background: @GetColorValue("Primary")">Primario</button>
                        <button class="rounded px-3 py-1.5 text-sm font-medium text-white" style="background: @GetColorValue("Secondary")">Secundario</button>
                        <button class="rounded px-3 py-1.5 text-sm font-medium text-white" style="background: @GetColorValue("Success")">Sucesso</button>
                        <button class="rounded px-3 py-1.5 text-sm font-medium text-white" style="background: @GetColorValue("Danger")">Perigo</button>
                    </div>
                </div>
                <div class="rounded-lg border border-border-light p-4">
                    <h3 class="mb-2 text-sm font-semibold text-text-primary">Cards</h3>
                    <div class="grid grid-cols-2 gap-3">
                        <div class="rounded-lg border p-3" style="border-color: @GetColorValue("Primary"); background: @GetColorValue("Surface")">
                            <span class="text-sm" style="color: @GetColorValue("Text"); font-family: @GetTypographyValue("Body", "font-family"); font-size: @GetTypographyValue("Body", "font-size")">Card exemplo com tema aplicado.</span>
                        </div>
                        <div class="rounded-lg p-3" style="background: @GetColorValue("Primary"); color: white; font-family: @GetTypographyValue("Heading", "font-family")">
                            <span class="text-sm">Card destaque.</span>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (ShowExportPanel)
        {
            <div class="mt-4 border-t border-border-light pt-4">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-semibold text-text-secondary">Exportar Tema</span>
                    <div class="flex gap-2">
                        <button class="rounded border border-border-light px-2 py-1 text-xs text-text-muted hover:bg-surface-100 hover:text-text-primary"
                                @onclick="ExportAsCss">CSS</button>
                        <button class="rounded border border-border-light px-2 py-1 text-xs text-text-muted hover:bg-surface-100 hover:text-text-primary"
                                @onclick="ExportAsJson">JSON</button>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(_exportOutput))
                {
                    <pre class="mt-2 max-h-48 overflow-auto rounded bg-surface-100 p-3 font-mono text-xs text-text-primary dark:bg-slate-800"><code>@_exportOutput</code></pre>
                }
            </div>
        }
    </div>
</div>

@code {
    private const string FontFamilyProp = "font-family";
    private const string FontSizeProp = "font-size";

    private string _activeTab = "Cores";
    private bool _isDark;
    private string? _selectedPreset;
    private string _exportOutput = "";
    private readonly string[] _tabs = ["Cores", "Tipografia", "Espacamento", "Preview"];

    private List<XFThemeColor> _colors = new();
    private List<XFThemeTypography> _typography = new();
    private List<XFThemeSpacing> _spacing = new();

    private void HandleColorChanged(string name, string value)
    {
        var idx = _colors.FindIndex(c => c.Name == name);
        if (idx >= 0)
            _colors[idx] = _colors[idx] with { Value = value };
        _exportOutput = "";
        if (OnThemeChanged.HasDelegate)
            OnThemeChanged.InvokeAsync();
    }

    private void HandleTypographyChanged(string name, string prop, string value)
    {
        var idx = _typography.FindIndex(t => t.Name == name);
        if (idx >= 0)
        {
            var t = _typography[idx];
            _typography[idx] = prop switch
            {
                FontFamilyProp => t with { FontFamily = value },
                FontSizeProp => t with { FontSize = value },
                _ => t
            };
        }
        _exportOutput = "";
        if (OnThemeChanged.HasDelegate)
            OnThemeChanged.InvokeAsync();
    }

    private void HandleSpacingChanged(string name, string value)
    {
        var idx = _spacing.FindIndex(s => s.Name == name);
        if (idx >= 0)
            _spacing[idx] = _spacing[idx] with { Value = value };
        _exportOutput = "";
        if (OnThemeChanged.HasDelegate)
            OnThemeChanged.InvokeAsync();
    }

    private void ToggleDarkMode() { _isDark = !_isDark; }

    private void OnPresetChanged(ChangeEventArgs e)
    {
        _selectedPreset = e.Value?.ToString();
        var preset = Presets.FirstOrDefault(p => p.Name == _selectedPreset);
        if (preset is not null)
        {
            _colors = preset.Colors.ToList();
            _typography = preset.Typography.ToList();
            _spacing = preset.Spacing.ToList();
            _exportOutput = "";
            if (OnThemeChanged.HasDelegate)
                OnThemeChanged.InvokeAsync();
        }
    }

    private string GetColorValue(string name) => _colors.FirstOrDefault(c => c.Name == name)?.Value ?? "#6366f1";

    private string GetTypographyValue(string name, string prop)
    {
        var t = _typography.FirstOrDefault(t => t.Name == name);
        if (t is null) return "inherit";
        return prop switch
        {
            FontFamilyProp => t.FontFamily,
            FontSizeProp => t.FontSize,
            _ => "inherit"
        };
    }

    private void ExportAsCss()
    {
        var lines = new List<string> { ":root {" };
        foreach (var c in _colors)
            lines.Add($"  {c.CssVariable}: {c.Value};");
        foreach (var t in _typography)
            lines.Add($"  {t.CssVariable}: {t.FontFamily};");
        foreach (var s in _spacing)
            lines.Add($"  {s.CssVariable}: {s.Value};");
        lines.Add("}");
        _exportOutput = string.Join("\n", lines);
    }

    private void ExportAsJson()
    {
        var obj = new
        {
            colors = _colors.ToDictionary(c => c.Name, c => c.Value),
            typography = _typography.ToDictionary(t => t.Name, t => new { family = t.FontFamily, size = t.FontSize }),
            spacing = _spacing.ToDictionary(s => s.Name, s => s.Value)
        };
        _exportOutput = System.Text.Json.JsonSerializer.Serialize(obj, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
    }
}
