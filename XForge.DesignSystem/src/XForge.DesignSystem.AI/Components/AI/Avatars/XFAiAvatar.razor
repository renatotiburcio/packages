@inherits XForge.DesignSystem.Core.Base.XForgeComponentBase

<div class="@RootClass" style="@Style" id="@Id" @attributes="AdditionalAttributes"
     role="img" aria-label="@AriaLabel"
     @onclick="HandleClickAsync" tabindex="@(Disabled ? -1 : 0)"
     @onkeydown="HandleKeyDownAsync">

    @* Avatar circle *@
    <div class="@AvatarContainerClass" style="@AvatarBgStyle">
        @if (ChildContent is not null)
        {
            @ChildContent
        }
        else if (!string.IsNullOrWhiteSpace(IconName))
        {
            <span class="@IconClass">@IconName</span>
        }
        else
        {
            <span class="@InitialsClass">@GetInitials()</span>
        }
    </div>

    @* Status indicator *@
    @if (Status != XFAiAvatarStatus.Hidden)
    {
        <span class="@StatusClass" aria-label="@StatusLabel"></span>
    }

    @* Agent name *@
    @if (ShowName && !string.IsNullOrWhiteSpace(Name))
    {
        <span class="@NameClass">@Name</span>
    }
</div>
