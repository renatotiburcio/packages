@inherits XForge.DesignSystem.Core.Base.XForgeComponentBase

<div class="@RootClass" style="@Style" id="@Id" @attributes="AdditionalAttributes"
     role="region" aria-label="@AriaLabel">

    @if (ShowHeader)
    {
        <div class="flex items-center justify-between gap-3 border-b border-border-light px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="text-sm font-semibold text-text-primary">@Title</span>
                @if (ActiveInsights.Count > 0)
                {
                    <span class="inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-primary px-1.5 text-[10px] font-semibold text-primary-contrast">
                        @ActiveInsights.Count
                    </span>
                }
            </div>
            @if (HeaderContent is not null)
            {
                @HeaderContent
            }
        </div>
    }

    @* Insights list *@
    <div class="max-h-96 overflow-y-auto">
        @if (ActiveInsights.Count == 0)
        {
            <div class="flex flex-col items-center gap-2 px-4 py-8 text-center">
                <span class="text-sm text-text-muted">@EmptyText</span>
            </div>
        }
        else
        {
            @foreach (var insight in ActiveInsights)
            {
                <div class="@GetInsightRowClass(insight)">
                    <div class="flex items-start gap-3">
                        <span class="mt-0.5 inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full @GetTypeColorClass(insight.Type) text-xs">
                            @GetTypeIcon(insight.Type)
                        </span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium text-text-primary">@insight.Title</span>
                                @if (insight.Priority >= XFAiInsightPriority.High)
                                {
                                    <span class="rounded-full bg-danger-50 px-1.5 py-0.5 text-[10px] font-medium text-danger dark:bg-danger-900/20">
                                        @(insight.Priority == XFAiInsightPriority.Critical ? "Crítico" : "Alto")
                                    </span>
                                }
                            </div>
                            <div class="mt-1 text-xs text-text-secondary">@insight.Description</div>
                            <div class="mt-2 flex items-center gap-2">
                                @if (!string.IsNullOrWhiteSpace(insight.ActionLabel))
                                {
                                    <button type="button"
                                            class="inline-flex items-center gap-1 rounded-md bg-primary px-2.5 py-1 text-xs font-medium text-primary-contrast hover:bg-primary-hover focus-visible:ring-2 focus-visible:ring-border-focus"
                                            @onclick="() => HandleActionAsync(insight)">
                                        @insight.ActionLabel
                                    </button>
                                }
                                <span class="text-[10px] text-text-muted">@FormatTimestamp(insight.GeneratedAt)</span>
                                @if (insight.Confidence < 1.0)
                                {
                                    <span class="text-[10px] text-text-muted">@(Math.Round(insight.Confidence * 100))% confiança</span>
                                }
                            </div>
                        </div>
                        <button type="button"
                                class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded text-text-muted hover:bg-surface-100 hover:text-text-primary focus-visible:ring-2 focus-visible:ring-border-focus"
                                @onclick="() => DismissInsightAsync(insight.Id)" aria-label="Dispensar insight">
                            ×
                        </button>
                    </div>
                </div>
            }
        }
    </div>

    @* Custom content *@
    @if (ChildContent is not null)
    {
        <div class="border-t border-border-light px-4 py-3">
            @ChildContent
        </div>
    }
</div>
