@inherits XForge.DesignSystem.Core.Base.XForgeComponentBase

<div class="@RootClass" style="@Style" id="@Id" @attributes="AdditionalAttributes"
     role="region" aria-label="@AriaLabel" aria-busy="@AriaBusyValue">

    @if (ShowHeader && Steps.Count > 0)
    {
        <div class="flex items-center justify-between gap-3 border-b border-border-light px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="text-sm font-semibold text-text-primary">@Title</span>
                <span class="text-xs text-text-muted">@((_currentIndex + 1)) de @Steps.Count</span>
            </div>
            @if (HeaderContent is not null)
            {
                @HeaderContent
            }
        </div>
    }

    @* Step progress indicator *@
    @if (ShowProgress && Steps.Count > 0)
    {
        <div class="flex items-center gap-1 border-b border-border-light px-4 py-3">
            @for (var i = 0; i < Steps.Count; i++)
            {
                var stepIndex = i;
                var step = Steps[i];
                var isActive = i == _currentIndex;
                var isCompleted = step.State == XFAiOnboardingStepState.Completed || i < _currentIndex;

                <div class="flex items-center gap-1">
                    <button type="button"
                            class="@GetStepDotClass(stepIndex, isActive, isCompleted)"
                            @onclick="() => GoToStepAsync(stepIndex)"
                            disabled="@(step.State == XFAiOnboardingStepState.Pending && i > _currentIndex)"
                            aria-label="@step.Title"
                            aria-current="@(isActive ? "step" : null)">
                        @if (isCompleted)
                        {
                            <span class="text-[10px]">✓</span>
                        }
                        else
                        {
                            <span class="text-[10px]">@(i + 1)</span>
                        }
                    </button>
                    @if (i < Steps.Count - 1)
                    {
                        <div class="h-px w-6 @(isCompleted ? "bg-primary" : "bg-surface-200")"></div>
                    }
                </div>
            }
        </div>
    }

    @* Current step content *@
    @if (CurrentStep is not null)
    {
        <div class="px-4 py-4">
            <div class="mb-3 flex items-center gap-2">
                @if (!string.IsNullOrWhiteSpace(CurrentStep.IconName))
                {
                    <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-violet-50 text-sm text-violet-600 dark:bg-violet-900/20 dark:text-violet-400">
                        @CurrentStep.IconName
                    </span>
                }
                <div>
                    <div class="text-sm font-semibold text-text-primary">@CurrentStep.Title</div>
                    @if (!string.IsNullOrWhiteSpace(CurrentStep.Description))
                    {
                        <div class="text-xs text-text-secondary">@CurrentStep.Description</div>
                    }
                </div>
            </div>

            @* Step-specific content via template *@
            @if (StepTemplate is not null)
            {
                <div class="mb-4">
                    @StepTemplate(CurrentStep)
                </div>
            }
            else if (ChildContent is not null)
            {
                <div class="mb-4">
                    @ChildContent
                </div>
            }

            @* Navigation buttons *@
            <div class="flex items-center justify-between gap-3 pt-2">
                <div class="flex items-center gap-2">
                    @if (_currentIndex > 0)
                    {
                        <button type="button"
                                class="inline-flex items-center gap-1.5 rounded-lg border border-border-light bg-bg-surface px-3 py-2 text-sm font-medium text-text-primary hover:bg-surface-100 focus-visible:ring-2 focus-visible:ring-border-focus"
                                @onclick="PreviousStepAsync">
                            @BackLabel
                        </button>
                    }
                </div>
                <div class="flex items-center gap-2">
                    @if (CurrentStep.CanSkip && _currentIndex < Steps.Count - 1)
                    {
                        <button type="button"
                                class="inline-flex items-center gap-1.5 rounded-lg px-3 py-2 text-sm font-medium text-text-muted hover:text-text-primary focus-visible:ring-2 focus-visible:ring-border-focus"
                                @onclick="SkipStepAsync">
                            @SkipLabel
                        </button>
                    }
                    @if (_currentIndex < Steps.Count - 1)
                    {
                        <button type="button"
                                class="inline-flex items-center gap-1.5 rounded-lg bg-primary px-3 py-2 text-sm font-semibold text-primary-contrast hover:bg-primary-hover focus-visible:ring-2 focus-visible:ring-border-focus"
                                @onclick="NextStepAsync">
                            @NextLabel
                        </button>
                    }
                    else
                    {
                        <button type="button"
                                class="inline-flex items-center gap-1.5 rounded-lg bg-green-600 px-3 py-2 text-sm font-semibold text-white hover:bg-green-700 focus-visible:ring-2 focus-visible:ring-border-focus"
                                @onclick="CompleteAsync">
                            @FinishLabel
                        </button>
                    }
                </div>
            </div>
        </div>
    }
</div>
