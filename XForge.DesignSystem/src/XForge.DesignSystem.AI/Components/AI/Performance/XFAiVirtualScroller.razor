@typeparam TItem
@inherits XForgeComponentBase
@implements IDisposable

<div class="@RootClass"
     role="region"
     aria-label="@AriaLabel"
     aria-busy="false"
     @attributes="AdditionalAttributes">

    @if (ShowHeader)
    {
        <div class="flex items-center justify-between border-b border-border-light px-4 py-2.5">
            <div class="flex items-center gap-2">
                <span class="text-sm font-semibold text-text-primary">@Title</span>
                <span class="rounded-full bg-surface-100 px-2 py-0.5 text-xs text-text-secondary dark:bg-slate-800">
                    @_visibleRange de @EffectiveTotalItems itens
                </span>
            </div>
            <div class="flex items-center gap-2 text-xs text-text-muted">
                <span>@_scrollPercentage.ToString("F0")%</span>
                <div class="h-1.5 w-16 overflow-hidden rounded-full bg-surface-200 dark:bg-slate-700">
                    <div class="h-full rounded-full bg-primary transition-all" style="width: @(_scrollPercentage.ToString("F0"))%"></div>
                </div>
            </div>
        </div>
    }

    <div @ref="_scrollContainer"
         class="relative overflow-auto"
         style="height: @(ContainerHeight)px;"
         @onscroll="HandleScrollAsync"
         tabindex="0"
         role="list"
         aria-label="Lista virtual de @TotalItems itens">

        @if (Items.Any())
        {
            <div style="height: @(_totalHeight.ToString("F0"))px; position: relative;">
                @foreach (var item in _visibleItems)
                {
                    <div @key="item.Index"
                         style="position: absolute; top: @(item.Top.ToString("F0"))px; width: 100%; height: @(item.Height.ToString("F0"))px;"
                         role="listitem"
                         aria-setsize="@TotalItems"
                         aria-posinset="@(item.Index + 1)">
                        @if (ItemTemplate is not null)
                        {
                            @ItemTemplate(item)
                        }
                        else
                        {
                            <div class="flex items-center border-b border-border-light/50 px-4 py-2 text-sm text-text-primary">
                                <span class="text-text-muted mr-2 text-xs">@(item.Index + 1).</span>
                                @item.Data?.ToString()
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="flex flex-col items-center justify-center gap-2 py-12 text-text-muted">
                <svg class="h-8 w-8 opacity-40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 13V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v7m16 0v5a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-5m16 0h-2.5a2 2 0 0 0-2 2v1a2 2 0 0 1-2 2h-3a2 2 0 0 1-2-2v-1a2 2 0 0 0-2-2H4"/></svg>
                <span class="text-sm">@EmptyText</span>
            </div>
        }
    </div>

    @if (ShowFooter && Items.Any())
    {
        <div class="flex items-center justify-between border-t border-border-light px-4 py-2 text-xs text-text-muted">
            <span>Renderizados: @_visibleItems.Count | Estrategia: @_strategy</span>
            <span>Total: @TotalItems | Altura: @(_totalHeight.ToString("F0"))px</span>
        </div>
    }
</div>
