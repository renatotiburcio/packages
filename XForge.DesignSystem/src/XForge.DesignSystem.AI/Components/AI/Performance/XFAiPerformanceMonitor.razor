@inherits XForgeComponentBase
@implements IDisposable

<div class="@RootClass"
     role="region"
     aria-label="@AriaLabel"
     @attributes="AdditionalAttributes">

    @if (ShowHeader)
    {
        <div class="flex items-center justify-between border-b border-border-light px-4 py-2.5">
            <div class="flex items-center gap-2">
                <span class="text-sm font-semibold text-text-primary">@Title</span>
                <span class="@GetOverallBadgeClass()">@GetOverallLabel()</span>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-xs text-text-muted">@_snapshots.Count metricas</span>
                <button class="rounded border border-border-light bg-bg-surface px-2 py-0.5 text-xs text-text-secondary transition-colors hover:border-primary/30 hover:text-primary"
                        @onclick="ClearSnapshots"
                        aria-label="Limpar metricas">
                    Limpar
                </button>
            </div>
        </div>
    }

    @if (ShowMetrics && _metrics.Any())
    {
        <div class="grid @(GridCols == 2 ? "grid-cols-2" : GridCols == 3 ? "grid-cols-3" : "grid-cols-4") gap-3 p-4">
            @foreach (var metric in _metrics)
            {
                <div class="@GetMetricCardClass(metric.Severity)">
                    <span class="text-xs text-text-muted">@metric.Label</span>
                    <span class="@GetMetricValueClass(metric.Severity)">@metric.Value.ToString("F1")@metric.Unit</span>
                    @if (ShowSparkline && _snapshots.Count > 1)
                    {
                        <div class="mt-1 h-4 overflow-hidden">
                            <svg class="h-full w-full" viewBox="0 0 100 20" preserveAspectRatio="none">
                                <polyline fill="none" stroke="currentColor" stroke-width="1.5"
                                          points="@GetSparklinePoints(metric.Label)"
                                          class="@GetSparklineColor(metric.Severity)" />
                            </svg>
                        </div>
                    }
                </div>
            }
        </div>
    }

    @if (ShowTimeline && _snapshots.Any())
    {
        <div class="border-t border-border-light px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="text-xs font-semibold uppercase tracking-wide text-text-secondary">Timeline</span>
                <span class="text-xs text-text-muted">Ultimas @_displayCount metricas</span>
            </div>
            <div class="flex items-end gap-1" style="height: @(BarHeight)px;">
                @foreach (var snapshot in _snapshots.TakeLast(_displayCount))
                {
                    var height = Math.Max(4, snapshot.RenderTimeMs / MaxRenderTimeMs * BarHeight);
                    var color = snapshot.RenderTimeMs < 16 ? "bg-emerald-400" : snapshot.RenderTimeMs < 50 ? "bg-amber-400" : "bg-red-400";
                    <div class="flex-1 @color rounded-t transition-all"
                         style="height: @(height.ToString("F0"))px; min-width: 3px;"
                         title="@snapshot.ComponentName — @snapshot.RenderTimeMs.ToString("F1")ms">
                    </div>
                }
            </div>
        </div>
    }

    @if (ShowBenchmarks && _benchmarkResults.Any())
    {
        <div class="border-t border-border-light px-4 py-3">
            <div class="mb-2 text-xs font-semibold uppercase tracking-wide text-text-secondary">Benchmarks</div>
            <div class="grid gap-2">
                @foreach (var result in _benchmarkResults)
                {
                    <div class="flex items-center justify-between rounded-md border border-border-light/50 px-3 py-2">
                        <div class="flex items-center gap-2">
                            @if (result.Passed)
                            {
                                <svg class="h-4 w-4 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m4.5 12.75 6 6 9-13.5"/></svg>
                            }
                            else
                            {
                                <svg class="h-4 w-4 text-red-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 18 18 6M6 6l12 12"/></svg>
                            }
                            <span class="text-sm text-text-primary">@result.Name</span>
                        </div>
                        <div class="flex items-center gap-2 text-xs">
                            <span class="font-mono">@result.MeasuredValue.ToString("F1")@result.Unit</span>
                            <span class="text-text-muted">/</span>
                            <span class="font-mono text-text-muted">@result.ThresholdValue.ToString("F1")@result.Unit</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (ShowFooter)
    {
        <div class="flex items-center justify-between border-t border-border-light px-4 py-2 text-xs text-text-muted">
            <span>Snapshots: @_snapshots.Count</span>
            <span>Modo: @Mode</span>
        </div>
    }
</div>
