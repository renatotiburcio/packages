@inherits XForgeComponentBase
@implements IDisposable

<div class="@RootClass"
     role="region"
     aria-label="@AriaLabel"
     @attributes="AdditionalAttributes">

    @if (ShowHeader)
    {
        <div class="flex items-center justify-between border-b border-border-light px-4 py-2.5">
            <div class="flex items-center gap-2">
                <span class="text-sm font-semibold text-text-primary">@Title</span>
                <span class="@GetUsageBadgeClass()">@_currentUsageMB.ToString("F1") MB</span>
            </div>
            <div class="flex items-center gap-2 text-xs text-text-muted">
                <span>GC: @_gen0Collections / @_gen1Collections / @_gen2Collections</span>
            </div>
        </div>
    }

    @if (ShowGauge)
    {
        <div class="flex items-center justify-center p-6">
            <div class="relative h-32 w-32">
                <svg viewBox="0 0 120 120" class="h-full w-full -rotate-90">
                    <circle cx="60" cy="60" r="50" fill="none" stroke="currentColor"
                            stroke-width="10" class="text-surface-200 dark:text-slate-700" />
                    <circle cx="60" cy="60" r="50" fill="none" stroke="currentColor"
                            stroke-width="10" stroke-linecap="round"
                            stroke-dasharray="@_circumference"
                            stroke-dashoffset="@_dashOffset"
                            class="@GetGaugeColor()" />
                </svg>
                <div class="absolute inset-0 flex flex-col items-center justify-center">
                    <span class="text-xl font-bold text-text-primary">@_usagePercent.ToString("F0")%</span>
                    <span class="text-xs text-text-muted">@_currentUsageMB.ToString("F1") / @_maxUsageMB.ToString("F0") MB</span>
                </div>
            </div>
        </div>
    }

    @if (ShowZones && _snapshot?.Allocations.Any() == true)
    {
        <div class="border-t border-border-light px-4 py-3">
            <div class="mb-2 text-xs font-semibold uppercase tracking-wide text-text-secondary">Zonas de Memoria</div>
            <div class="grid gap-2">
                @foreach (var alloc in _snapshot.Allocations.OrderByDescending(a => a.AllocatedBytes))
                {
                    var barColor = GetZoneColor(alloc.Zone);
                    <div class="flex items-center gap-3">
                        <span class="w-20 text-xs text-text-muted">@GetZoneLabel(alloc.Zone)</span>
                        <div class="flex-1">
                            <div class="h-3 overflow-hidden rounded-full bg-surface-200 dark:bg-slate-700">
                                <div class="h-full rounded-full @barColor transition-all" style="width: @alloc.UsagePercent.ToString("F0")%"></div>
                            </div>
                        </div>
                        <span class="w-16 text-right text-xs font-mono text-text-secondary">@FormatBytes(alloc.AllocatedBytes)</span>
                        <span class="w-10 text-right text-xs text-text-muted">@alloc.UsagePercent.ToString("F0")%</span>
                    </div>
                }
            </div>
        </div>
    }

    @if (ShowGCStats)
    {
        <div class="border-t border-border-light px-4 py-3">
            <div class="mb-2 text-xs font-semibold uppercase tracking-wide text-text-secondary">GC Collections</div>
            <div class="grid grid-cols-3 gap-3">
                <div class="flex flex-col items-center gap-1 rounded-lg border border-border-light p-2">
                    <span class="text-xs text-text-muted">Gen 0</span>
                    <span class="text-base font-bold text-emerald-600 dark:text-emerald-400">@_gen0Collections</span>
                </div>
                <div class="flex flex-col items-center gap-1 rounded-lg border border-border-light p-2">
                    <span class="text-xs text-text-muted">Gen 1</span>
                    <span class="text-base font-bold text-amber-600 dark:text-amber-400">@_gen1Collections</span>
                </div>
                <div class="flex flex-col items-center gap-1 rounded-lg border border-border-light p-2">
                    <span class="text-xs text-text-muted">Gen 2</span>
                    <span class="text-base font-bold text-red-600 dark:text-red-400">@_gen2Collections</span>
                </div>
            </div>
        </div>
    }

    @if (ShowHistory && _history.Any())
    {
        <div class="border-t border-border-light px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="text-xs font-semibold uppercase tracking-wide text-text-secondary">Historico</span>
                <span class="text-xs text-text-muted">@_history.Count amostras</span>
            </div>
            <div class="flex items-end gap-1" style="height: 40px;">
                @foreach (var value in _history.TakeLast(30))
                {
                    var height = MaxUsageMB > 0 ? Math.Max(2, value / MaxUsageMB * 40) : 2;
                    var color = value < MaxUsageMB * 0.6 ? "bg-emerald-400" : value < MaxUsageMB * 0.8 ? "bg-amber-400" : "bg-red-400";
                    <div class="flex-1 @color rounded-t" style="height: @(height.ToString("F0"))px; min-width: 3px;" title="@value.ToString("F1") MB"></div>
                }
            </div>
        </div>
    }

    @if (ShowFooter)
    {
        <div class="flex items-center justify-between border-t border-border-light px-4 py-2 text-xs text-text-muted">
            <span>Gerenciado: @FormatBytes(_snapshot?.TotalManagedBytes ?? 0)</span>
            <span>Total: @FormatBytes(_snapshot?.TotalAllocatedBytes ?? 0)</span>
        </div>
    }
</div>
