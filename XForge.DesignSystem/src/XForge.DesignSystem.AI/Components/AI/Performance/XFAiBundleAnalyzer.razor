@inherits XForgeComponentBase
@implements IDisposable

<div class="@RootClass"
     role="region"
     aria-label="@AriaLabel"
     @attributes="AdditionalAttributes">

    @if (ShowHeader)
    {
        <div class="flex items-center justify-between border-b border-border-light px-4 py-2.5">
            <div class="flex items-center gap-2">
                <span class="text-sm font-semibold text-text-primary">@Title</span>
                <span class="rounded-full bg-surface-100 px-2 py-0.5 text-xs text-text-secondary dark:bg-slate-800">
                    @FormatSize(_summary?.TotalSizeBytes ?? 0)
                </span>
            </div>
            <div class="flex items-center gap-2 text-xs text-text-muted">
                <span>@(_summary?.ModuleCount ?? 0) modulos</span>
                <span>|</span>
                <span>Gzip: @FormatSize(_summary?.TotalGzipSizeBytes ?? 0)</span>
            </div>
        </div>
    }

    @if (ShowSummary && _summary is not null)
    {
        <div class="grid grid-cols-3 gap-3 p-4">
            <div class="flex flex-col gap-1 rounded-lg border border-border-light bg-bg-surface p-3">
                <span class="text-xs text-text-muted">Total</span>
                <span class="text-lg font-bold text-text-primary">@FormatSize(_summary.TotalSizeBytes)</span>
            </div>
            <div class="flex flex-col gap-1 rounded-lg border border-border-light bg-bg-surface p-3">
                <span class="text-xs text-text-muted">Gzip</span>
                <span class="text-lg font-bold text-primary">@FormatSize(_summary.TotalGzipSizeBytes)</span>
            </div>
            <div class="flex flex-col gap-1 rounded-lg border border-border-light bg-bg-surface p-3">
                <span class="text-xs text-text-muted">Modulos</span>
                <span class="text-lg font-bold text-text-primary">@_summary.ModuleCount</span>
            </div>
        </div>
    }

    @if (ShowBreakdown && _summary?.Breakdown.Any() == true)
    {
        <div class="border-t border-border-light px-4 py-3">
            <div class="mb-2 text-xs font-semibold uppercase tracking-wide text-text-secondary">Breakdown por Categoria</div>
            <div class="grid gap-2">
                @foreach (var item in _summary.Breakdown.OrderByDescending(b => b.SizeBytes))
                {
                    var barColor = GetCategoryColor(item.Category);
                    <div class="flex items-center gap-3">
                        <span class="w-20 text-xs text-text-muted">@GetCategoryLabel(item.Category)</span>
                        <div class="flex-1">
                            <div class="h-3 overflow-hidden rounded-full bg-surface-200 dark:bg-slate-700">
                                <div class="h-full rounded-full @barColor transition-all" style="width: @item.Percentage.ToString("F0")%"></div>
                            </div>
                        </div>
                        <span class="w-16 text-right text-xs font-mono text-text-secondary">@FormatSize(item.SizeBytes)</span>
                        <span class="w-10 text-right text-xs text-text-muted">@item.Percentage.ToString("F0")%</span>
                    </div>
                }
            </div>
        </div>
    }

    @if (ShowModuleList && _summary?.Modules.Any() == true)
    {
        <div class="border-t border-border-light px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="text-xs font-semibold uppercase tracking-wide text-text-secondary">Modulos</span>
                <span class="text-xs text-text-muted">@_summary.Modules.Count modulos</span>
            </div>
            <div class="max-h-64 overflow-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b border-border-light">
                            <th class="py-1.5 text-left text-xs font-semibold text-text-secondary">Modulo</th>
                            <th class="py-1.5 text-right text-xs font-semibold text-text-secondary">Tamanho</th>
                            <th class="py-1.5 text-right text-xs font-semibold text-text-secondary">Gzip</th>
                            <th class="py-1.5 text-center text-xs font-semibold text-text-secondary">Tree-shake</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var module in _summary.Modules.OrderByDescending(m => m.SizeBytes).Take(MaxVisibleModules))
                        {
                            <tr class="border-b border-border-light/50">
                                <td class="py-1.5 font-mono text-xs text-text-primary">@module.Name</td>
                                <td class="py-1.5 text-right text-xs text-text-secondary">@FormatSize(module.SizeBytes)</td>
                                <td class="py-1.5 text-right text-xs text-text-muted">@FormatSize(module.GzipSizeBytes)</td>
                                <td class="py-1.5 text-center">
                                    @if (module.IsTreeShakeable)
                                    {
                                        <span class="text-emerald-500" title="Tree-shakeable">✓</span>
                                    }
                                    else
                                    {
                                        <span class="text-red-400" title="Nao tree-shakeable">✗</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (ShowFooter && _summary is not null)
    {
        <div class="flex items-center justify-between border-t border-border-light px-4 py-2 text-xs text-text-muted">
            <span>Tree-shakeable: @_summary.TreeShakeableCount / @_summary.ModuleCount</span>
            <span>Compressao: @((_summary.TotalSizeBytes > 0 ? (1 - (double)_summary.TotalGzipSizeBytes / _summary.TotalSizeBytes) * 100 : 0).ToString("F0"))%</span>
        </div>
    }
</div>
