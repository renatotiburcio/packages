@namespace XForge.DesignSystem.Components.AI.Audio
@inherits XForgeComponentBase

<div class="xf-ai-voice-assistant @Class" id="@Id" style="@Style" @attributes="AdditionalAttributes"
     role="region" aria-label="@AriaLabel" aria-busy="@(_state == XFAiVoiceState.Processing)">

    @* Header *@
    @if (ShowHeader)
    {
        <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
                </svg>
                <h3 class="text-sm font-semibold text-gray-900 dark:text-gray-100">@(Title ?? "Assistente de Voz")</h3>
            </div>
            @HeaderContent
        </div>
    }

    @* Voice Button *@
    <div class="flex flex-col items-center gap-4 py-4">
        @* Microphone Button *@
        <button type="button"
                class="relative w-20 h-20 rounded-full flex items-center justify-center transition-all focus:ring-4 focus:ring-offset-2 @GetMicButtonClasses()"
                @onclick="ToggleRecordingAsync"
                disabled="@(_state == XFAiVoiceState.Processing || Disabled)"
                aria-label="@(_state == XFAiVoiceState.Listening ? "Parar gravação" : "Iniciar gravação")">

            @* Pulse animation when listening *@
            @if (_state == XFAiVoiceState.Listening)
            {
                <span class="absolute inset-0 rounded-full bg-emerald-400 opacity-20 animate-ping"></span>
            }

            <svg class="w-8 h-8 @( _state == XFAiVoiceState.Listening ? "text-white" : "text-gray-600 dark:text-gray-300")" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                @if (_state == XFAiVoiceState.Listening)
                {
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 10a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z" />
                }
                else
                {
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
                }
            </svg>
        </button>

        @* State Label *@
        <p class="text-sm text-gray-600 dark:text-gray-400" aria-live="polite">
            @GetStateLabel()
        </p>
    </div>

    @* Transcription Result *@
    @if (_transcriptionResults.Count > 0 || _currentPartialText.Length > 0)
    {
        <div class="bg-gray-50 dark:bg-gray-800/50 rounded-lg p-3 mt-2" role="log" aria-live="polite" aria-label="Transcrições">
            @foreach (var result in _transcriptionResults)
            {
                <div class="mb-2 last:mb-0">
                    <div class="flex items-center gap-2 mb-0.5">
                        <span class="text-xs text-gray-400">@result.Timestamp.ToString("HH:mm:ss")</span>
                        @if (result.Confidence.HasValue)
                        {
                            <span class="text-xs @GetConfidenceTextClass(result.Confidence.Value)">@result.Confidence.Value.ToString("P0")</span>
                        }
                        @if (!string.IsNullOrEmpty(result.Language))
                        {
                            <span class="text-xs text-gray-400">@result.Language</span>
                        }
                    </div>
                    <p class="text-sm text-gray-800 dark:text-gray-200">@result.Text</p>
                </div>
            }
            @if (_currentPartialText.Length > 0)
            {
                <p class="text-sm text-gray-500 dark:text-gray-400 italic">@_currentPartialText</p>
            }
        </div>
    }

    @* Text-to-Speech *@
    @if (ShowTextToSpeech)
    {
        <div class="mt-3 border-t border-gray-200 dark:border-gray-700 pt-3">
            <p class="text-xs font-medium text-gray-500 dark:text-gray-400 mb-2">Texto para fala</p>
            <div class="flex gap-2">
                <input type="text"
                       class="flex-1 px-3 py-1.5 text-sm border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 placeholder-gray-400"
                       placeholder="Digite o texto para converter em áudio..."
                       @bind="_ttsText"
                       disabled="@(_state == XFAiVoiceState.Speaking || Disabled)" />
                <button type="button"
                        class="px-3 py-1.5 text-sm font-medium text-white bg-emerald-600 rounded-md hover:bg-emerald-700 disabled:opacity-50 transition-colors"
                        @onclick="SynthesizeSpeechAsync"
                        disabled="@(string.IsNullOrWhiteSpace(_ttsText) || _state == XFAiVoiceState.Speaking || Disabled)">
                    @if (_state == XFAiVoiceState.Speaking)
                    {
                        <span class="flex items-center gap-1">
                            <svg class="animate-spin h-3.5 w-3.5" viewBox="0 0 24 24" fill="none">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                            </svg>
                        </span>
                    }
                    else
                    {
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" />
                        </svg>
                    }
                </button>
            </div>
        </div>
    }

    @* Error *@
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-md p-3 mt-3" role="alert">
            <p class="text-sm text-red-700 dark:text-red-300">@_error</p>
        </div>
    }
</div>
