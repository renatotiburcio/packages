@namespace XForge.DesignSystem.Components.AI.Vision
@inherits XForgeComponentBase

<div class="xf-ai-video-analyzer @Class" id="@Id" style="@Style" @attributes="AdditionalAttributes"
     role="region" aria-label="@AriaLabel" aria-busy="@_isLoading">

    @* Header *@
    @if (ShowHeader)
    {
        <div class="flex items-center justify-between mb-3">
            <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-rose-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
                <h3 class="text-sm font-semibold text-gray-900 dark:text-gray-100">@(Title ?? "Análise de Vídeo")</h3>
            </div>
            @HeaderContent
        </div>
    }

    @* URL Input *@
    <div class="mb-3">
        <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">URL do vídeo</label>
        <div class="flex gap-2">
            <input type="url"
                   class="flex-1 px-3 py-1.5 text-sm border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 placeholder-gray-400"
                   placeholder="https://exemplo.com/video.mp4"
                   @bind="_videoUrl"
                   disabled="@(_isLoading || Disabled)" />
            <button type="button"
                    class="px-3 py-1.5 text-sm font-medium text-white bg-rose-600 rounded-md hover:bg-rose-700 disabled:opacity-50 transition-colors"
                    @onclick="AnalyzeVideoAsync"
                    disabled="@(_isLoading || Disabled || string.IsNullOrWhiteSpace(_videoUrl))">
                @if (_isLoading)
                {
                    <span class="flex items-center gap-1">
                        <svg class="animate-spin h-3.5 w-3.5" viewBox="0 0 24 24" fill="none">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                        </svg>
                        Analisando...
                    </span>
                }
                else
                {
                    @AnalyzeText
                }
            </button>
        </div>
    </div>

    @* Frames to Analyze *@
    @if (ShowFrameSelector)
    {
        <div class="mb-3">
            <label class="block text-xs font-medium text-gray-500 dark:text-gray-400 mb-1">
                Frames para análise: @_frameCount
            </label>
            <input type="range" min="1" max="20" step="1"
                   class="w-full h-1.5 bg-gray-200 dark:bg-gray-700 rounded-full appearance-none cursor-pointer"
                   @bind="_frameCount"
                   disabled="@(_isLoading || Disabled)" />
        </div>
    }

    @* Prompt *@
    <div class="mb-3">
        <textarea class="w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 placeholder-gray-400 resize-none"
                  rows="2"
                  placeholder="@(Placeholder ?? "Descreva o que deseja analisar no vídeo...")"
                  @bind="_prompt"
                  @bind:event="oninput"
                  disabled="@(_isLoading || Disabled)"
                  aria-label="Prompt de análise"></textarea>
    </div>

    @* Results *@
    @if (_results.Count > 0)
    {
        <div class="space-y-2" role="status" aria-live="polite">
            <p class="text-xs font-medium text-gray-500 dark:text-gray-400">@_results.Count frame(s) analisado(s)</p>
            @foreach (var (result, index) in _results.Select((r, i) => (r, i)))
            {
                <details class="bg-gray-50 dark:bg-gray-800/50 rounded-lg" open="@(index == _results.Count - 1)">
                    <summary class="px-3 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 cursor-pointer">
                        Frame @(index + 1)
                        @if (result.Confidence.HasValue)
                        {
                            <span class="ml-2 text-xs @GetConfidenceClass(result.Confidence.Value)">@result.Confidence.Value.ToString("P0")</span>
                        }
                    </summary>
                    <div class="px-3 pb-2">
                        <p class="text-sm text-gray-600 dark:text-gray-400">@result.Text</p>
                    </div>
                </details>
            }
        </div>
    }

    @* Summary *@
    @if (!string.IsNullOrEmpty(_summary))
    {
        <div class="bg-rose-50 dark:bg-rose-900/20 rounded-lg p-3 mt-3" role="status">
            <p class="text-xs font-medium text-rose-700 dark:text-rose-300 mb-1">Resumo</p>
            <p class="text-sm text-rose-800 dark:text-rose-200">@_summary</p>
        </div>
    }

    @* Error *@
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-md p-3 mt-3" role="alert">
            <p class="text-sm text-red-700 dark:text-red-300">@_error</p>
        </div>
    }
</div>
