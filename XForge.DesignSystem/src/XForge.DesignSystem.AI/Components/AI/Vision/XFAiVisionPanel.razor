@namespace XForge.DesignSystem.Components.AI.Vision
@inherits XForgeComponentBase

<div class="xf-ai-vision-panel @Class" id="@Id" style="@Style" @attributes="AdditionalAttributes"
     role="region" aria-label="@AriaLabel" aria-busy="@_isLoading">

    @* Header *@
    @if (ShowHeader)
    {
        <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
                <h3 class="text-sm font-semibold text-gray-900 dark:text-gray-100">@(Title ?? "Análise Visual")</h3>
            </div>
            @HeaderContent
        </div>
    }

    @* Analysis Type Selector *@
    @if (ShowAnalysisTypeSelector)
    {
        <div class="flex flex-wrap gap-1 mb-3" role="radiogroup" aria-label="Tipo de análise">
            @foreach (var type in _analysisTypes)
            {
                <button type="button"
                        class="px-2.5 py-1 text-xs rounded-full transition-colors @(_selectedType == type.Key ? "bg-indigo-100 text-indigo-700 dark:bg-indigo-900/30 dark:text-indigo-300" : "bg-gray-100 text-gray-600 hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-400 dark:hover:bg-gray-600")"
                        @onclick="() => SelectAnalysisType(type.Key)"
                        role="radio"
                        aria-checked="@(_selectedType == type.Key)">
                    @type.Value
                </button>
            }
        </div>
    }

    @* Image Upload / Preview Area *@
    <div class="border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-lg p-4 mb-3 transition-colors hover:border-indigo-400 dark:hover:border-indigo-500"
         @ondragover:preventDefault="true"
         @ondrop:preventDefault="true">
        @if (_imagePreviews.Count == 0)
        {
            <div class="text-center py-6">
                <svg class="mx-auto h-10 w-10 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0022.5 18.75V5.25A2.25 2.25 0 0020.25 3H3.75A2.25 2.25 0 001.5 5.25v13.5A2.25 2.25 0 003.75 21z" />
                </svg>
                <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">@(DropText ?? "Arraste imagens ou clique para selecionar")</p>
                <p class="text-xs text-gray-400 dark:text-gray-500 mt-1">PNG, JPG, WEBP até 10MB</p>
            </div>
        }
        else
        {
            <div class="flex flex-wrap gap-2">
                @foreach (var (preview, index) in _imagePreviews.Select((p, i) => (p, i)))
                {
                    <div class="relative group">
                        <img src="@preview" class="w-20 h-20 object-cover rounded-md border border-gray-200 dark:border-gray-600" alt="Imagem @(index + 1)" />
                        <button type="button"
                                class="absolute -top-1.5 -right-1.5 w-5 h-5 bg-red-500 text-white rounded-full text-xs flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity"
                                @onclick="() => RemoveImage(index)"
                                aria-label="Remover imagem @(index + 1)">
                            ×
                        </button>
                    </div>
                }
                @if (_imagePreviews.Count < MaxImages)
                {
                    <button type="button"
                            class="w-20 h-20 border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-md flex items-center justify-center text-gray-400 hover:text-indigo-500 hover:border-indigo-400 transition-colors"
                            @onclick="TriggerFileInput"
                            aria-label="Adicionar imagem">
                        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                        </svg>
                    </button>
                }
            </div>
        }
    </div>

    @* Prompt Input *@
    <div class="mb-3">
        <textarea class="w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-md bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 resize-none"
                  rows="2"
                  placeholder="@(Placeholder ?? "Descreva o que deseja analisar...")"
                  @bind="_prompt"
                  @bind:event="oninput"
                  disabled="@(_isLoading || Disabled)"
                  aria-label="Prompt de análise"></textarea>
    </div>

    @* Analyze Button *@
    <div class="flex items-center gap-2 mb-4">
        <button type="button"
                class="px-4 py-2 text-sm font-medium text-white bg-indigo-600 rounded-md hover:bg-indigo-700 focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
                @onclick="AnalyzeAsync"
                disabled="@(_isLoading || Disabled || _imageBase64List.Count == 0 || string.IsNullOrWhiteSpace(_prompt))">
            @if (_isLoading)
            {
                <span class="flex items-center gap-2">
                    <svg class="animate-spin h-4 w-4" viewBox="0 0 24 24" fill="none">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                    </svg>
                    @(LoadingText ?? "Analisando...")
                </span>
            }
            else
            {
                @(AnalyzeText ?? "Analisar")
            }
        </button>
        @if (_imageBase64List.Count > 0)
        {
            <span class="text-xs text-gray-500 dark:text-gray-400">@_imageBase64List.Count imagem(ns)</span>
        }
    </div>

    @* Results *@
    @if (_result != null)
    {
        <div class="bg-gray-50 dark:bg-gray-800/50 rounded-lg p-4" role="status" aria-live="polite">
            @if (_result.Confidence.HasValue)
            {
                <div class="flex items-center gap-2 mb-2">
                    <span class="text-xs font-medium text-gray-500 dark:text-gray-400">Confiança:</span>
                    <div class="flex-1 h-1.5 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden max-w-[120px]">
                        <div class="h-full rounded-full @GetConfidenceColor(_result.Confidence.Value)" style="width:@(_result.Confidence.Value * 100)%"></div>
                    </div>
                    <span class="text-xs text-gray-600 dark:text-gray-300">@(_result.Confidence.Value.ToString("P0"))</span>
                </div>
            }
            <p class="text-sm text-gray-800 dark:text-gray-200 whitespace-pre-wrap">@_result.Text</p>
            @if (!string.IsNullOrEmpty(_result.StructuredData))
            {
                <details class="mt-2">
                    <summary class="text-xs text-indigo-600 dark:text-indigo-400 cursor-pointer hover:underline">Dados estruturados</summary>
                    <pre class="mt-1 text-xs bg-gray-100 dark:bg-gray-800 p-2 rounded overflow-x-auto text-gray-700 dark:text-gray-300">@_result.StructuredData</pre>
                </details>
            }
        </div>
    }

    @* Error *@
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-md p-3 mt-3" role="alert">
            <p class="text-sm text-red-700 dark:text-red-300">@_error</p>
        </div>
    }

    @ResultContent
</div>
