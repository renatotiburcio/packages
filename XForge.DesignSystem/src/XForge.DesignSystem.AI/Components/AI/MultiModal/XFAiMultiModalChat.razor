@using XForge.DesignSystem.Components.AI.Common
@namespace XForge.DesignSystem.Components.AI.MultiModal
@inherits XForgeComponentBase

<div class="xf-ai-multimodal-chat @Class" id="@Id" style="@Style" @attributes="AdditionalAttributes"
     role="log" aria-label="@AriaLabel" aria-busy="@_isLoading" aria-live="polite">

    @* Header *@
    @if (ShowHeader)
    {
        <div class="flex items-center justify-between mb-3 pb-2 border-b border-gray-200 dark:border-gray-700">
            <div class="flex items-center gap-2">
                <svg class="w-5 h-5 text-violet-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                </svg>
                <h3 class="text-sm font-semibold text-gray-900 dark:text-gray-100">@(Title ?? "Chat Multi-modal")</h3>
            </div>
            @HeaderContent
        </div>
    }

    @* Messages *@
    <div class="space-y-3 mb-3 max-h-[400px] overflow-y-auto" @ref="_messagesContainer">
        @if (_messages.Count == 0)
        {
            <div class="text-center py-8">
                <svg class="mx-auto h-10 w-10 text-gray-300 dark:text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <p class="mt-2 text-sm text-gray-400 dark:text-gray-500">Envie imagens, áudio ou texto para análise</p>
            </div>
        }

        @foreach (var message in _messages)
        {
            <div class="flex @(message.Role == AiRole.User ? "justify-end" : "justify-start")">
                <div class="max-w-[80%] @(message.Role == AiRole.User ? "bg-violet-600 text-white" : "bg-gray-100 dark:bg-gray-800 text-gray-800 dark:text-gray-200") rounded-lg px-3 py-2">
                    @* Attachments *@
                    @if (message.Attachments?.Count > 0)
                    {
                        <div class="flex flex-wrap gap-1 mb-1.5">
                            @foreach (var att in message.Attachments)
                            {
                                @if (att.Type == XFAiAttachmentType.Image)
                                {
                                    <div class="relative">
                                        <img src="@att.Data" class="max-w-[150px] max-h-[100px] rounded border @(message.Role == AiRole.User ? "border-violet-400" : "border-gray-200 dark:border-gray-600")" alt="@att.Name" />
                                    </div>
                                }
                                else if (att.Type == XFAiAttachmentType.Audio)
                                {
                                    <div class="flex items-center gap-1 px-2 py-1 rounded @(message.Role == AiRole.User ? "bg-violet-500" : "bg-gray-200 dark:bg-gray-700")">
                                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
                                        </svg>
                                        <span class="text-xs">@att.Name</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="flex items-center gap-1 px-2 py-1 rounded @(message.Role == AiRole.User ? "bg-violet-500" : "bg-gray-200 dark:bg-gray-700")">
                                        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
                                        </svg>
                                        <span class="text-xs">@att.Name</span>
                                    </div>
                                }
                            }
                        </div>
                    }

                    @* Content *@
                    <p class="text-sm whitespace-pre-wrap">@message.Content</p>

                    @* Timestamp *@
                    <p class="text-[10px] mt-1 @(message.Role == AiRole.User ? "text-violet-200" : "text-gray-400 dark:text-gray-500")">
                        @message.Timestamp.ToString("HH:mm")
                    </p>
                </div>
            </div>
        }

        @if (_isLoading)
        {
            <div class="flex justify-start">
                <div class="bg-gray-100 dark:bg-gray-800 rounded-lg px-3 py-2">
                    <div class="flex items-center gap-1.5">
                        <div class="w-1.5 h-1.5 bg-gray-400 rounded-full animate-bounce" style="animation-delay:0ms"></div>
                        <div class="w-1.5 h-1.5 bg-gray-400 rounded-full animate-bounce" style="animation-delay:150ms"></div>
                        <div class="w-1.5 h-1.5 bg-gray-400 rounded-full animate-bounce" style="animation-delay:300ms"></div>
                    </div>
                </div>
            </div>
        }
    </div>

    @* Attachment Preview *@
    @if (_pendingAttachments.Count > 0)
    {
        <div class="flex flex-wrap gap-1.5 mb-2 px-1">
            @foreach (var (att, idx) in _pendingAttachments.Select((a, i) => (a, i)))
            {
                <div class="relative group">
                    @if (att.Type == XFAiAttachmentType.Image)
                    {
                        <img src="@att.Data" class="w-12 h-12 object-cover rounded border border-gray-200 dark:border-gray-600" alt="@att.Name" />
                    }
                    else
                    {
                        <div class="flex items-center gap-1 px-2 py-1 bg-gray-100 dark:bg-gray-700 rounded text-xs text-gray-600 dark:text-gray-300">
                            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" /></svg>
                            @att.Name
                        </div>
                    }
                    <button type="button" class="absolute -top-1 -right-1 w-4 h-4 bg-red-500 text-white rounded-full text-[10px] flex items-center justify-center opacity-0 group-hover:opacity-100" @onclick="() => RemovePendingAttachment(idx)">×</button>
                </div>
            }
        </div>
    }

    @* Input Area *@
    <div class="flex gap-2 items-end">
        @* Attachment Button *@
        <button type="button"
                class="p-2 text-gray-400 hover:text-violet-500 transition-colors flex-shrink-0"
                @onclick="TriggerAttachment"
                disabled="@(_isLoading || Disabled)"
                aria-label="Anexar arquivo">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
            </svg>
        </button>

        @* Text Input *@
        <div class="flex-1">
            <textarea class="w-full px-3 py-2 text-sm border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 focus:ring-2 focus:ring-violet-500 focus:border-violet-500 resize-none"
                      rows="1"
                      placeholder="@(Placeholder ?? "Envie uma mensagem...")"
                      @bind="_inputText"
                      @bind:event="oninput"
                      @onkeydown="HandleKeyDown"
                      disabled="@(_isLoading || Disabled)"
                      aria-label="Mensagem"></textarea>
        </div>

        @* Send Button *@
        <button type="button"
                class="p-2 text-violet-600 hover:text-violet-700 disabled:text-gray-300 dark:disabled:text-gray-600 transition-colors flex-shrink-0"
                @onclick="SendMessageAsync"
                disabled="@(_isLoading || Disabled || (string.IsNullOrWhiteSpace(_inputText) && _pendingAttachments.Count == 0))"
                aria-label="Enviar mensagem">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
            </svg>
        </button>
    </div>
</div>
