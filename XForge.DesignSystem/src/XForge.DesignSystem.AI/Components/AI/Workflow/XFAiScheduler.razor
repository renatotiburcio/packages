@inherits XForgeComponentBase

<section @attributes="AdditionalAttributes"
         id="@Id"
         class="@RootClass"
         style="@Style"
         role="region"
         aria-label="@AriaLabel">

    @if (ShowHeader)
    {
        <div class="flex items-center justify-between gap-3 border-b border-border-light px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="inline-flex h-5 w-5 items-center justify-center text-indigo-500" aria-hidden="true">
                    @XFSvgIcons.Markup("clock")
                </span>
                <span class="text-sm font-semibold text-text-primary">@Title</span>
                @if (Jobs.Count > 0)
                {
                    <span class="inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-surface-100 px-1.5 text-[10px] font-bold text-text-secondary">@Jobs.Count agendados</span>
                }
            </div>
            <button class="rounded-md bg-indigo-50 px-3 py-1.5 text-xs font-semibold text-indigo-600 hover:bg-indigo-100 transition-colors"
                    aria-label="Adicionar tarefa agendada"
                    @onclick="HandleAddJob">
                @XFSvgIcons.Markup("plus")
                Novo Agendamento
            </button>
        </div>
    }

    @if (ShowCalendar && _calendarDates.Count > 0)
    {
        <div class="border-b border-border-light px-4 py-3">
            <div class="flex items-center justify-between mb-2">
                <button class="rounded p-1 text-text-muted hover:bg-surface-100 transition-colors" aria-label="Semana anterior" @onclick="PreviousWeek">
                    @XFSvgIcons.Markup("chevron-left")
                </button>
                <span class="text-xs font-semibold text-text-primary">@GetWeekLabel()</span>
                <button class="rounded p-1 text-text-muted hover:bg-surface-100 transition-colors" aria-label="Proxima semana" @onclick="NextWeek">
                    @XFSvgIcons.Markup("chevron-right")
                </button>
            </div>
            <div class="grid grid-cols-7 gap-1">
                @foreach (var date in _calendarDates)
                {
                    var isToday = date.Date == DateTime.Today;
                    var jobsOnDate = GetJobsOnDate(date);
                    var dayClass = isToday
                        ? "bg-indigo-100 text-indigo-700 dark:bg-indigo-900/30 dark:text-indigo-300 font-bold"
                        : "text-text-secondary hover:bg-surface-50 dark:hover:bg-slate-800";
                    <div class="flex flex-col items-center rounded-md py-1 @dayClass transition-colors">
                        <span class="text-[10px] uppercase">@date.ToString("ddd")</span>
                        <span class="text-sm">@date.Day</span>
                        @if (jobsOnDate > 0)
                        {
                            <div class="flex gap-0.5 mt-0.5">
                                @for (var i = 0; i < Math.Min(jobsOnDate, 3); i++)
                                {
                                    <span class="h-1 w-1 rounded-full bg-indigo-500"></span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    @if (Jobs.Count > 0)
    {
        <div class="divide-y divide-border-light">
            @foreach (var job in Jobs)
            {
                var statusColor = GetJobStatusColor(job.Status);
                var freqColor = GetFrequencyColor(job.Frequency);
                <div class="px-4 py-3 hover:bg-surface-50 dark:hover:bg-slate-800/30 transition-colors">
                    <div class="flex items-start justify-between gap-3">
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-semibold text-text-primary">@job.Name</span>
                                <span class="inline-flex items-center rounded-full px-1.5 py-0.5 text-[10px] font-bold @statusColor">
                                    @GetJobStatusLabel(job.Status)
                                </span>
                                <span class="inline-flex items-center rounded-full px-1.5 py-0.5 text-[10px] font-bold @freqColor">
                                    @GetFrequencyLabel(job.Frequency)
                                </span>
                                @if (job.AiEnhanced)
                                {
                                    <span class="inline-flex items-center gap-0.5 rounded-full bg-purple-100 px-1.5 py-0.5 text-[10px] font-bold text-purple-700 dark:bg-purple-900/30 dark:text-purple-300">
                                        @XFSvgIcons.Markup("sparkles") IA
                                    </span>
                                }
                            </div>
                            @if (job.Description is not null)
                            {
                                <p class="mt-0.5 text-xs text-text-secondary">@job.Description</p>
                            }
                            <div class="mt-1.5 flex flex-wrap items-center gap-3 text-xs text-text-muted">
                                @if (job.NextRunAt.HasValue)
                                {
                                    <span class="inline-flex items-center gap-1">
                                        @XFSvgIcons.Markup("clock") Proximo: @job.NextRunAt.Value.ToString("dd/MM HH:mm")
                                    </span>
                                }
                                @if (job.LastRunAt.HasValue)
                                {
                                    <span class="inline-flex items-center gap-1">
                                        @XFSvgIcons.Markup("history") Ultimo: @job.LastRunAt.Value.ToString("dd/MM HH:mm")
                                    </span>
                                }
                                @if (job.TotalRuns > 0)
                                {
                                    <span>@job.TotalRuns execucoes (@job.SuccessfulRuns ok / @job.FailedRuns falhas)</span>
                                }
                                @if (job.CronExpression is not null)
                                {
                                    <span class="font-mono text-[10px] bg-surface-100 dark:bg-slate-800 rounded px-1">@job.CronExpression</span>
                                }
                            </div>
                            @if (job.AiSuggestedSchedule is not null)
                            {
                                <p class="mt-1 text-[11px] text-purple-600 dark:text-purple-400">
                                    @XFSvgIcons.Markup("sparkles") Sugestao IA: @job.AiSuggestedSchedule
                                </p>
                            }
                        </div>
                        <div class="flex shrink-0 items-center gap-1">
                            @if (job.Status == XFAiScheduledJobStatus.Active)
                            {
                                <button class="rounded p-1 text-amber-500 hover:bg-amber-50 transition-colors"
                                        aria-label="Pausar agendamento"
                                        @onclick="() => HandlePauseJob(job)">
                                    @XFSvgIcons.Markup("pause")
                                </button>
                            }
                            else if (job.Status == XFAiScheduledJobStatus.Paused)
                            {
                                <button class="rounded p-1 text-emerald-500 hover:bg-emerald-50 transition-colors"
                                        aria-label="Reativar agendamento"
                                        @onclick="() => HandleResumeJob(job)">
                                    @XFSvgIcons.Markup("play")
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="flex flex-col items-center justify-center gap-2 px-4 py-12 text-center">
            @if (EmptyContent is not null)
            {
                @EmptyContent
            }
            else
            {
                <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-surface-100 text-text-muted" aria-hidden="true">
                    @XFSvgIcons.Markup("clock")
                </span>
                <p class="text-sm text-text-secondary">@EmptyText</p>
            }
        </div>
    }
</section>
