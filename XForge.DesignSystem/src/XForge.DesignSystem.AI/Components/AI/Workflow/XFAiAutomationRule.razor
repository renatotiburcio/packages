@inherits XForgeComponentBase

<section @attributes="AdditionalAttributes"
         id="@Id"
         class="@RootClass"
         style="@Style"
         role="region"
         aria-label="@AriaLabel">

    @if (ShowHeader)
    {
        <div class="flex items-center justify-between gap-3 border-b border-border-light px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="inline-flex h-5 w-5 items-center justify-center text-blue-500" aria-hidden="true">
                    @XFSvgIcons.Markup("scale-balanced")
                </span>
                <span class="text-sm font-semibold text-text-primary">@Title</span>
                @if (Rules.Count > 0)
                {
                    <span class="inline-flex h-5 min-w-5 items-center justify-center rounded-full bg-surface-100 px-1.5 text-[10px] font-bold text-text-secondary">@Rules.Count regras</span>
                }
            </div>
            <button class="rounded-md bg-blue-50 px-3 py-1.5 text-xs font-semibold text-blue-600 hover:bg-blue-100 transition-colors"
                    aria-label="Adicionar regra"
                    @onclick="HandleAddRule">
                @XFSvgIcons.Markup("plus")
                Nova Regra
            </button>
        </div>
    }

    @if (Rules.Count > 0)
    {
        <div class="divide-y divide-border-light">
            @foreach (var rule in Rules)
            {
                var borderColor = rule.Enabled ? "border-l-blue-500" : "border-l-slate-300";
                var bgColor = rule.Enabled ? "" : "opacity-60";
                <div class="border-l-4 @borderColor @bgColor px-4 py-3">
                    <div class="flex items-start justify-between gap-3">
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-semibold text-text-primary">@rule.Name</span>
                                @if (rule.Enabled)
                                {
                                    <span class="inline-flex items-center gap-0.5 rounded-full bg-emerald-100 px-1.5 py-0.5 text-[10px] font-bold text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300">Ativa</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-0.5 rounded-full bg-slate-100 px-1.5 py-0.5 text-[10px] font-bold text-slate-500">Inativa</span>
                                }
                                @if (rule.AiEnhancementPrompt is not null)
                                {
                                    <span class="inline-flex items-center gap-0.5 rounded-full bg-purple-100 px-1.5 py-0.5 text-[10px] font-bold text-purple-700 dark:bg-purple-900/30 dark:text-purple-300">
                                        @XFSvgIcons.Markup("sparkles") IA
                                    </span>
                                }
                                <span class="text-xs text-text-muted">P@(rule.Priority)</span>
                            </div>
                            @if (rule.Description is not null)
                            {
                                <p class="mt-0.5 text-xs text-text-secondary">@rule.Description</p>
                            }

                            @* Conditions *@
                            <div class="mt-2 flex flex-wrap items-center gap-1">
                                <span class="text-[10px] font-semibold text-text-muted uppercase">SE</span>
                                @for (var i = 0; i < rule.Conditions.Count; i++)
                                {
                                    var cond = rule.Conditions[i];
                                    <span class="inline-flex items-center gap-1 rounded-md border border-surface-200 bg-surface-50 px-2 py-0.5 text-[11px] dark:bg-slate-800 dark:border-slate-700">
                                        <span class="font-medium text-text-primary">@cond.Field</span>
                                        <span class="text-text-muted">@GetOperatorLabel(cond.Operator)</span>
                                        <span class="text-blue-600 dark:text-blue-400">"@cond.Value"</span>
                                    </span>
                                    @if (i < rule.Conditions.Count - 1)
                                    {
                                        <span class="text-[10px] font-bold text-text-muted">@GetLogicalLabel(rule.LogicalOperator)</span>
                                    }
                                }
                            </div>

                            @* Actions *@
                            <div class="mt-1.5 flex flex-wrap items-center gap-1">
                                <span class="text-[10px] font-semibold text-text-muted uppercase">ENTAO</span>
                                @foreach (var action in rule.Actions)
                                {
                                    <span class="inline-flex items-center gap-1 rounded-md border border-emerald-200 bg-emerald-50 px-2 py-0.5 text-[11px] dark:bg-emerald-900/20 dark:border-emerald-800">
                                        @XFSvgIcons.Markup(GetActionIcon(action.Type))
                                        <span class="text-emerald-700 dark:text-emerald-300">@(action.Description ?? action.Type.ToString())</span>
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="flex shrink-0 items-center gap-2 text-xs text-text-muted">
                            @if (rule.ExecutionCount > 0)
                            {
                                <span title="Execucoes">@rule.ExecutionCount×</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="flex flex-col items-center justify-center gap-2 px-4 py-12 text-center">
            @if (EmptyContent is not null)
            {
                @EmptyContent
            }
            else
            {
                <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-surface-100 text-text-muted" aria-hidden="true">
                    @XFSvgIcons.Markup("scale-balanced")
                </span>
                <p class="text-sm text-text-secondary">@EmptyText</p>
            }
        </div>
    }
</section>
