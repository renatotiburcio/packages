@inherits XForgeComponentBase

<section @attributes="AdditionalAttributes"
         id="@Id"
         class="@RootClass"
         style="@Style"
         role="region"
         aria-label="@AriaLabel">

    @if (ShowHeader)
    {
        <div class="flex items-center justify-between gap-3 border-b border-border-light px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="inline-flex h-5 w-5 items-center justify-center text-emerald-500" aria-hidden="true">
                    @XFSvgIcons.Markup("play")
                </span>
                <span class="text-sm font-semibold text-text-primary">@Title</span>
                @if (Execution is not null)
                {
                    var statusColor = GetStatusColor(Execution.Status);
                    <span class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold @statusColor">
                        @GetStatusLabel(Execution.Status)
                    </span>
                }
            </div>
            <div class="flex items-center gap-1">
                @if (Execution?.Status == XFAiWfExecutionStatus.Running)
                {
                    <button class="rounded-md bg-red-50 px-3 py-1.5 text-xs font-semibold text-red-600 hover:bg-red-100 transition-colors"
                            aria-label="Cancelar execucao"
                            @onclick="HandleCancel">
                        @XFSvgIcons.Markup("stop")
                        Parar
                    </button>
                }
                else if (Execution is null || Execution.Status is XFAiWfExecutionStatus.Pending or XFAiWfExecutionStatus.Failed or XFAiWfExecutionStatus.Cancelled)
                {
                    <button class="rounded-md bg-emerald-50 px-3 py-1.5 text-xs font-semibold text-emerald-600 hover:bg-emerald-100 transition-colors"
                            aria-label="Iniciar execucao"
                            @onclick="HandleStart">
                        @XFSvgIcons.Markup("play")
                        Executar
                    </button>
                }
            </div>
        </div>
    }

    @if (Execution is not null)
    {
        <div class="px-4 py-3">
            <div class="flex items-center justify-between mb-2">
                <span class="text-xs text-text-muted">Progresso</span>
                <span class="text-xs font-semibold text-text-primary">@($"{Execution.Progress:F0}%")</span>
            </div>
            <div class="h-2 w-full rounded-full bg-surface-200 dark:bg-slate-700" role="progressbar"
                 aria-valuenow="@((int)Execution.Progress)" aria-valuemin="0" aria-valuemax="100"
                 aria-label="Progresso da execucao">
                <div class="h-2 rounded-full transition-all duration-300 @ProgressColorClass"
                     style="width: @($"{Execution.Progress:F0}%")"></div>
            </div>
            <div class="mt-3 grid grid-cols-2 gap-2 text-xs sm:grid-cols-4">
                <div class="rounded-md bg-surface-50 dark:bg-slate-800 px-3 py-2">
                    <p class="text-text-muted">Total</p>
                    <p class="font-semibold text-text-primary">@Execution.TotalNodes</p>
                </div>
                <div class="rounded-md bg-emerald-50 dark:bg-emerald-900/20 px-3 py-2">
                    <p class="text-emerald-600 dark:text-emerald-400">Concluidos</p>
                    <p class="font-semibold text-emerald-700 dark:text-emerald-300">@Execution.CompletedNodes</p>
                </div>
                <div class="rounded-md bg-red-50 dark:bg-red-900/20 px-3 py-2">
                    <p class="text-red-600 dark:text-red-400">Falhas</p>
                    <p class="font-semibold text-red-700 dark:text-red-300">@Execution.FailedNodes</p>
                </div>
                <div class="rounded-md bg-surface-50 dark:bg-slate-800 px-3 py-2">
                    <p class="text-text-muted">Tempo</p>
                    <p class="font-semibold text-text-primary">@GetElapsedTime()</p>
                </div>
            </div>
        </div>

        @if (Execution.Logs.Count > 0)
        {
            <div class="border-t border-border-light">
                <div class="flex items-center justify-between px-4 py-2">
                    <span class="text-xs font-semibold text-text-muted">Log de Execucao (@Execution.Logs.Count entradas)</span>
                    <div class="flex gap-1">
                        <button class="rounded px-2 py-0.5 text-[10px] font-medium @(_logFilter == null ? "bg-purple-100 text-purple-700" : "text-text-muted hover:bg-surface-100")"
                                @onclick="() => _logFilter = null">Todos</button>
                        <button class="rounded px-2 py-0.5 text-[10px] font-medium @(_logFilter == XFAiWfLogLevel.Error ? "bg-red-100 text-red-700" : "text-text-muted hover:bg-surface-100")"
                                @onclick="() => _logFilter = XFAiWfLogLevel.Error">Erros</button>
                        <button class="rounded px-2 py-0.5 text-[10px] font-medium @(_logFilter == XFAiWfLogLevel.Warning ? "bg-amber-100 text-amber-700" : "text-text-muted hover:bg-surface-100")"
                                @onclick="() => _logFilter = XFAiWfLogLevel.Warning">Avisos</button>
                    </div>
                </div>
                <div class="max-h-48 overflow-y-auto px-4 pb-3 space-y-1" role="log" aria-live="polite">
                    @foreach (var log in FilteredLogs)
                    {
                        <div class="flex items-start gap-2 rounded px-2 py-1 text-xs @GetLogBgClass(log.Level)">
                            <span class="mt-0.5 text-text-muted shrink-0">@log.Timestamp.ToString("HH:mm:ss")</span>
                            <span class="shrink-0 font-medium @GetLogLevelClass(log.Level)">@GetLogLevelLabel(log.Level)</span>
                            <span class="font-medium text-text-primary shrink-0">[@log.NodeLabel]</span>
                            <span class="text-text-secondary">@log.Message</span>
                            @if (log.DurationMs.HasValue)
                            {
                                <span class="text-text-muted shrink-0">(@log.DurationMs ms)</span>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="flex flex-col items-center justify-center gap-2 px-4 py-12 text-center">
            @if (EmptyContent is not null)
            {
                @EmptyContent
            }
            else
            {
                <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-surface-100 text-text-muted" aria-hidden="true">
                    @XFSvgIcons.Markup("play")
                </span>
                <p class="text-sm text-text-secondary">@EmptyText</p>
            }
        </div>
    }
</section>
