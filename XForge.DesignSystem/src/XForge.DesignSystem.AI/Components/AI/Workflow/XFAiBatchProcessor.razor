@inherits XForgeComponentBase

<section @attributes="AdditionalAttributes"
         id="@Id"
         class="@RootClass"
         style="@Style"
         role="region"
         aria-label="@AriaLabel">

    @if (ShowHeader)
    {
        <div class="flex items-center justify-between gap-3 border-b border-border-light px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="inline-flex h-5 w-5 items-center justify-center text-orange-500" aria-hidden="true">
                    @XFSvgIcons.Markup("layer-group")
                </span>
                <span class="text-sm font-semibold text-text-primary">@Title</span>
                @if (State is not null)
                {
                    var statusColor = GetStatusColor(State.Status);
                    <span class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-bold @statusColor">
                        @GetStatusLabel(State.Status)
                    </span>
                }
            </div>
            <div class="flex items-center gap-2">
                @if (State?.Status == XFAiWfExecutionStatus.Running)
                {
                    <button class="rounded-md bg-red-50 px-3 py-1.5 text-xs font-semibold text-red-600 hover:bg-red-100 transition-colors"
                            aria-label="Cancelar processamento"
                            @onclick="HandleCancel">
                        @XFSvgIcons.Markup("stop") Cancelar
                    </button>
                }
                else if (Items.Count > 0 && (State is null || State.Status is not XFAiWfExecutionStatus.Running))
                {
                    <button class="rounded-md bg-orange-50 px-3 py-1.5 text-xs font-semibold text-orange-600 hover:bg-orange-100 transition-colors"
                            aria-label="Iniciar processamento em lote"
                            @onclick="HandleStart">
                        @XFSvgIcons.Markup("play") Processar (@Items.Count itens)
                    </button>
                }
            </div>
        </div>
    }

    @if (State is not null)
    {
        <div class="px-4 py-3">
            <div class="flex items-center justify-between mb-2">
                <span class="text-xs text-text-muted">Progresso do lote</span>
                <span class="text-xs font-semibold text-text-primary">@State.ProcessedItems / @State.TotalItems (@($"{State.Progress:F0}%"))</span>
            </div>
            <div class="h-3 w-full rounded-full bg-surface-200 dark:bg-slate-700 overflow-hidden"
                 role="progressbar"
                 aria-valuenow="@((int)State.Progress)" aria-valuemin="0" aria-valuemax="100"
                 aria-label="Progresso do lote">
                <div class="flex h-3">
                    <div class="h-3 bg-emerald-500 transition-all duration-300"
                         style="width: @((double)State.SuccessfulItems / Math.Max(State.TotalItems, 1) * 100)%"></div>
                    <div class="h-3 bg-red-500 transition-all duration-300"
                         style="width: @((double)State.FailedItems / Math.Max(State.TotalItems, 1) * 100)%"></div>
                    <div class="h-3 bg-amber-400 transition-all duration-300"
                         style="width: @((double)State.CancelledItems / Math.Max(State.TotalItems, 1) * 100)%"></div>
                </div>
            </div>
            <div class="mt-3 grid grid-cols-2 gap-2 text-xs sm:grid-cols-5">
                <div class="rounded-md bg-surface-50 dark:bg-slate-800 px-3 py-2 text-center">
                    <p class="text-text-muted">Total</p>
                    <p class="font-semibold text-text-primary">@State.TotalItems</p>
                </div>
                <div class="rounded-md bg-emerald-50 dark:bg-emerald-900/20 px-3 py-2 text-center">
                    <p class="text-emerald-600 dark:text-emerald-400">Sucesso</p>
                    <p class="font-semibold text-emerald-700 dark:text-emerald-300">@State.SuccessfulItems</p>
                </div>
                <div class="rounded-md bg-red-50 dark:bg-red-900/20 px-3 py-2 text-center">
                    <p class="text-red-600 dark:text-red-400">Falha</p>
                    <p class="font-semibold text-red-700 dark:text-red-300">@State.FailedItems</p>
                </div>
                <div class="rounded-md bg-amber-50 dark:bg-amber-900/20 px-3 py-2 text-center">
                    <p class="text-amber-600 dark:text-amber-400">Cancelado</p>
                    <p class="font-semibold text-amber-700 dark:text-amber-300">@State.CancelledItems</p>
                </div>
                <div class="rounded-md bg-blue-50 dark:bg-blue-900/20 px-3 py-2 text-center">
                    <p class="text-blue-600 dark:text-blue-400">Taxa Sucesso</p>
                    <p class="font-semibold text-blue-700 dark:text-blue-300">@($"{State.SuccessRate:F0}%")</p>
                </div>
            </div>
        </div>
    }

    @if (ShowItems && Items.Count > 0)
    {
        <div class="border-t border-border-light">
            <div class="flex items-center justify-between px-4 py-2">
                <span class="text-xs font-semibold text-text-muted">Itens (@Items.Count)</span>
                <div class="flex gap-1">
                    <button class="rounded px-2 py-0.5 text-[10px] font-medium @(_statusFilter == null ? "bg-orange-100 text-orange-700" : "text-text-muted hover:bg-surface-100")"
                            @onclick="() => _statusFilter = null">Todos</button>
                    <button class="rounded px-2 py-0.5 text-[10px] font-medium @(_statusFilter == XFAiBatchItemStatus.Failed ? "bg-red-100 text-red-700" : "text-text-muted hover:bg-surface-100")"
                            @onclick="() => _statusFilter = XFAiBatchItemStatus.Failed">Falhas</button>
                    <button class="rounded px-2 py-0.5 text-[10px] font-medium @(_statusFilter == XFAiBatchItemStatus.Processing ? "bg-blue-100 text-blue-700" : "text-text-muted hover:bg-surface-100")"
                            @onclick="() => _statusFilter = XFAiBatchItemStatus.Processing">Processando</button>
                </div>
            </div>
            <div class="max-h-60 overflow-y-auto">
                <table class="w-full text-xs" role="table">
                    <thead>
                        <tr class="border-b border-border-light bg-surface-50 dark:bg-slate-800/50">
                            <th class="px-4 py-2 text-left font-medium text-text-muted">Item</th>
                            <th class="px-4 py-2 text-left font-medium text-text-muted">Status</th>
                            <th class="px-4 py-2 text-left font-medium text-text-muted">Resultado</th>
                            <th class="px-4 py-2 text-right font-medium text-text-muted">Tempo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in FilteredItems)
                        {
                            <tr class="border-b border-border-light/50 hover:bg-surface-50 dark:hover:bg-slate-800/30 transition-colors">
                                <td class="px-4 py-2 font-medium text-text-primary">@item.Label</td>
                                <td class="px-4 py-2">
                                    <span class="inline-flex items-center gap-1 rounded-full px-1.5 py-0.5 text-[10px] font-bold @GetItemStatusColor(item.Status)">
                                        @GetItemStatusLabel(item.Status)
                                    </span>
                                </td>
                                <td class="px-4 py-2 text-text-secondary truncate max-w-[200px]">
                                    @(item.Result ?? item.ErrorMessage ?? "—")
                                </td>
                                <td class="px-4 py-2 text-right text-text-muted">
                                    @(item.DurationMs.HasValue ? $"{item.DurationMs}ms" : "—")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (State is null)
    {
        <div class="flex flex-col items-center justify-center gap-2 px-4 py-12 text-center">
            @if (EmptyContent is not null)
            {
                @EmptyContent
            }
            else
            {
                <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-surface-100 text-text-muted" aria-hidden="true">
                    @XFSvgIcons.Markup("layer-group")
                </span>
                <p class="text-sm text-text-secondary">@EmptyText</p>
            }
        </div>
    }
</section>
