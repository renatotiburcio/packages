@using XForge.DesignSystem.Components.AI.Common
@using XForge.DesignSystem.Services.AI
@inherits XForgeComponentBase

<section class="@RootClass" style="@Style" role="region" aria-label="@Title" aria-busy="@AriaBusyValue" @attributes="AdditionalAttributes">
    @if (ShowHeader)
    {
        <header class="@HeaderClass">
            @if (HeaderContent is not null) { @HeaderContent }
            else
            {
                <div class="min-w-0">
                    <div class="@HeaderTitleClass">
                        <span class="inline-flex h-5 w-5 items-center justify-center text-text-muted" aria-hidden="true">@XFSvgIcons.Markup("sparkles")</span>
                        @Title
                    </div>
                </div>
            }
        </header>
    }

    <div class="@InputContainerClass">
        <textarea class="@TextareaClass" rows="3" value="@_query" placeholder="@Placeholder" disabled="@IsBusy"
                  aria-label="@Placeholder" @oninput="HandleInput" @onkeydown="HandleKeyDownAsync" @onkeydown:preventDefault="@_preventEnterDefault"></textarea>
        <div class="@InputActionsClass">
            <button type="button" class="@SendButtonClass" disabled="@(!CanSend)" aria-label="Analisar metas" @onclick="AnalyzeAsync">
                @if (IsBusy) { <span class="inline-flex h-4 w-4 animate-spin items-center justify-center" aria-hidden="true">@XFSvgIcons.Markup("spinner")</span> }
                else { <span class="inline-flex h-4 w-4 items-center justify-center" aria-hidden="true">@XFSvgIcons.Markup("bullseye")</span> }
                <span>Analisar</span>
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorText))
    {
        <div class="@ErrorBannerClass" role="alert">
            <span class="inline-flex h-4 w-4 items-center justify-center" aria-hidden="true">@XFSvgIcons.Markup("circle-exclamation")</span>
            <span>@_errorText</span>
            <button type="button" class="ml-auto inline-flex h-5 w-5 items-center justify-center rounded text-text-muted hover:text-text-primary" aria-label="Dispensar erro" @onclick="DismissError">
                <span class="inline-flex h-3 w-3 items-center justify-center" aria-hidden="true">@XFSvgIcons.Markup("xmark")</span>
            </button>
        </div>
    }

    @if (IsBusy)
    {
        <div class="@LoadingContainerClass" role="status" aria-label="Analisando metas...">
            <span class="sr-only">Analisando metas...</span>
            <div class="space-y-3"><div class="@SkeletonLineClass w-3/4"></div><div class="@SkeletonLineClass w-1/2"></div><div class="@SkeletonLineClass w-5/6"></div></div>
        </div>
    }

    @if (!IsBusy && _result is not null)
    {
        <div class="@PreviewContainerClass" aria-live="polite" aria-label="Resultado da analise de metas">
            @if (ResultPreview is not null) { @ResultPreview(_result) }
            else
            {
                @if (!string.IsNullOrWhiteSpace(_result.AiSummary))
                {
                    <div class="@SummaryBoxClass">
                        <div class="flex items-start gap-2">
                            <span class="inline-flex h-4 w-4 shrink-0 items-center justify-center text-primary" aria-hidden="true">@XFSvgIcons.Markup("sparkles")</span>
                            <p class="text-sm leading-5 text-text-primary">@_result.AiSummary</p>
                        </div>
                    </div>
                }

                @if (_result.Rankings is { Count: > 0 })
                {
                    <div class="mb-3">
                        <div class="mb-1.5 text-xs font-semibold uppercase tracking-wider text-text-muted">Ranking de Vendedores</div>
                        <div class="space-y-1">
                            @foreach (var r in _result.Rankings)
                            {
                                <div class="flex items-center justify-between rounded-md bg-surface-50 px-3 py-2 text-xs ring-1 ring-border-light">
                                    <div class="flex items-center gap-2">
                                        <span class="font-bold text-text-primary">#@r.Position</span>
                                        <span class="text-text-primary">@r.SalespersonName</span>
                                        @if (!string.IsNullOrWhiteSpace(r.Badge))
                                        {
                                            <span class="@GetBadgeClass(r.Badge)">@r.Badge</span>
                                        }
                                    </div>
                                    <div class="flex items-center gap-3">
                                        <span class="font-semibold text-text-primary">@r.TotalSales.ToString("C2")</span>
                                        <span class="@GetAchievementClass(r.AchievementPercentage)">@r.AchievementPercentage.ToString("F0")%</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (_result.Goals is { Count: > 0 })
                {
                    <div class="mb-3">
                        <div class="mb-1.5 text-xs font-semibold uppercase tracking-wider text-text-muted">Progresso das Metas</div>
                        <div class="space-y-2">
                            @foreach (var g in _result.Goals)
                            {
                                <div class="rounded-md bg-surface-50 px-3 py-2 ring-1 ring-border-light">
                                    <div class="mb-1 flex items-center justify-between text-xs">
                                        <span class="font-medium text-text-primary">@g.GoalName</span>
                                        <span class="@GetOutcomeClass(g.PredictedOutcome)">@GetOutcomeLabel(g.PredictedOutcome)</span>
                                    </div>
                                    <div class="h-2 w-full overflow-hidden rounded-full bg-surface-200">
                                        <div class="@GetProgressFillClass(g.ProgressPercentage)" style="width: @Math.Min(g.ProgressPercentage, 100)%"></div>
                                    </div>
                                    <div class="mt-1 flex items-center justify-between text-xs text-text-muted">
                                        <span>@g.CurrentAmount.ToString("C0") / @g.TargetAmount.ToString("C0")</span>
                                        <span>@g.DaysRemaining dias restantes</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (_result.Confidence > 0)
                {
                    <div class="flex items-center gap-2">
                        <span class="text-xs text-text-muted">Confianca:</span>
                        <div class="@ConfidenceTrackClass" role="progressbar" aria-valuenow="@((int)(_result.Confidence * 100))" aria-valuemin="0" aria-valuemax="100">
                            <div class="@ConfidenceFillClass" style="width: @((int)(_result.Confidence * 100))%"></div>
                        </div>
                        <span class="text-xs font-medium tabular-nums">@((_result.Confidence * 100).ToString("F0"))%</span>
                    </div>
                }
            }
        </div>
    }

    @if (!IsBusy && _result is null && string.IsNullOrWhiteSpace(_errorText))
    {
        <div class="@EmptyContainerClass">
            @if (EmptyContent is not null) { @EmptyContent }
            else
            {
                <div class="@EmptyInnerClass">
                    <div class="@EmptyIconClass" aria-hidden="true">@XFSvgIcons.Markup("bullseye")</div>
                    <div class="text-sm font-medium text-text-primary">Assistente de Metas</div>
                    <div class="@EmptyTextClass">Pergunte sobre ranking de vendedores, progresso de metas, comissoes, previsoes e recomendacoes de mix de produtos.</div>
                </div>
            }
        </div>
    }
</section>
