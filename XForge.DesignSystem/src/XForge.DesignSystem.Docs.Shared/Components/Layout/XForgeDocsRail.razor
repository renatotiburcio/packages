<XFRail Items="@XForgeDocsNavigation.GetRailItems(Product)" AutoTrackActiveItem="true" AriaLabel="@RailLabel">
    <Header>
        <span class="inline-flex h-5 w-5 items-center justify-center" aria-hidden="true">
            @((MarkupString)XFSvgIcons.Get("layer-group"))
        </span>
    </Header>
</XFRail>

@code {
    [Parameter] public XForgeDocsProduct Product { get; set; } = XForgeDocsProduct.Core;

    private string RailLabel => XForgeDocsNavigation.IsAiProduct(Product)
        ? "Navegacao XForge DesignSystem AI"
        : "Navegacao XForge DesignSystem";
}
