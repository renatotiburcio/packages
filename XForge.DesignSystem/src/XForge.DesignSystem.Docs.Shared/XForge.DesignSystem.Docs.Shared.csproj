<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>XForge.DesignSystem.Docs.Shared</RootNamespace>
    <StaticWebAssetBasePath>_content/XForge.DesignSystem.Docs.Shared</StaticWebAssetBasePath>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>XForge.DesignSystem.Docs.Shared</PackageId>
    <Version>1.0.0</Version>
    <Authors>XForge Team</Authors>
    <Company>XForge</Company>
    <Product>XForge Design System Docs Shared Platform</Product>
    <Description>Shared docs shell contracts, examples metadata and renderer primitives for core and AI documentation apps.</Description>
    <PackageTags>blazor;docs;design-system;playground;examples;api-explorer</PackageTags>
    <PackageProjectUrl>https://github.com/xforge/designsystem</PackageProjectUrl>
    <RepositoryUrl>https://github.com/xforge/designsystem</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 XForge</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XForge.DesignSystem.Shared\XForge.DesignSystem.Shared.csproj" />
    <ProjectReference Include="..\XForge.DesignSystem\XForge.DesignSystem.csproj" />
  </ItemGroup>

</Project>
