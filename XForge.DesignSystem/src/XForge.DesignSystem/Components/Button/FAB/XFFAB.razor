@using XForge.DesignSystem.Core.Primitives;
@inherits XForgeComponentBase
@using XForge.DesignSystem.Components.Icon

<div @attributes="AdditionalAttributes" id="@Id" class="@RootClass">
    @if (Open && Items.Count > 0)
    {
        <div id="@MenuId" class="@MenuClass" role="menu" aria-label="@MenuLabel">
            @foreach (var item in Items)
            {
                <button class="@MenuItemClass"
                        type="button"
                        role="menuitem"
                        disabled="@item.Disabled"
                        @onclick="@(() => SelectItemAsync(item))">
                    <span class="min-w-0 truncate">@item.Text</span>
                    <span class="@MenuItemIconClass" aria-hidden="true">
                        @if (item.Icon is not null)
                        {
                            @item.Icon
                        }
                        else
                        {
                            @XFSvgIcons.MarkupWithSize("plus", 12)
                        }
                    </span>
                </button>
            }
        </div>
    }

    <button class="@ButtonClass"
            type="button"
            disabled="@Disabled"
            aria-label="@EffectiveButtonAriaLabel"
            aria-haspopup="@(Items.Count > 0 ? "menu" : null)"
            aria-controls="@(Items.Count > 0 ? MenuId : null)"
            aria-expanded="@(Items.Count > 0 ? Open : null)"
            @onclick="HandleClickAsync">
        <span class="@IconClass" aria-hidden="true">
            @if (Icon is not null)
            {
                @Icon
            }
            else
            {
                @XFSvgIcons.MarkupWithSize(Items.Count > 0 && Open ? "chevron-down" : "plus", Size == XFExtendedSize.Xl ? 28 : 24)
            }
        </span>
        @if (IsExtended)
        {
            <span class="text-sm font-semibold">@Text</span>
        }
    </button>
</div>
