@namespace XForge.DesignSystem.Components.Feedback.Skeleton
@inherits XForge.DesignSystem.Core.Base.XForgeComponentBase

@if (Visible)
{
    <div id="@Id"
         class="@GetComponentClass()"
         role="@Role"
         aria-label="@ResolvedAriaLabel"
         aria-hidden="@AriaHidden"
         @attributes="AdditionalAttributes">
        @if (ShowHeader)
        {
            <div class="@RowClass">
                @for (var column = 0; column < NormalizedColumns; column++)
                {
                    <XFSkeleton Shape="XFSkeletonShape.Text"
                                Size="@HeaderSize"
                                Animation="@Animation"
                                WidthClass="@GetColumnWidthClass(column)"
                                Decorative="true" />
                }
            </div>
        }

        @for (var row = 0; row < NormalizedRows; row++)
        {
            <div class="@RowClass">
                @for (var column = 0; column < NormalizedColumns; column++)
                {
                    <XFSkeleton Shape="XFSkeletonShape.Text"
                                Size="@Size"
                                Animation="@Animation"
                                WidthClass="@GetCellWidthClass(row, column)"
                                Decorative="true" />
                }
            </div>
        }
    </div>
}
