@namespace XForge.Components.Charts
@inherits XForgeComponentBase

<div class="xf-radar" data-axes="@Axes.Count" data-series="@Series.Count">
  <svg viewBox="-1.2 -1.2 2.4 2.4">@((MarkupString)RenderSvg())</svg>
</div>

@code {
  public record RadarSeries(string Name, IReadOnlyList<double> Values, string Color);
}
