@namespace XForge.Components.Latam
@inherits XForgeComponentBase

<select class="xf-br-states" @bind="Value" @bind:after="() => ValueChanged.InvokeAsync(Value)">
  <option value="">--</option>
  @foreach (var s in States) { <option value="@s.Code">@s.Code - @s.Name</option> }
</select>

@code {
  public record BrazilianState(string Code, string Name);
}
