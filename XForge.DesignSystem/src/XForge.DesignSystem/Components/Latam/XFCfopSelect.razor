@namespace XForge.DesignSystem.Components.Latam
@inherits XForgeComponentBase

<select class="xf-cfop-select" @bind="Value" @bind:after="() => ValueChanged.InvokeAsync(Value)">
  <option value="">--</option>
  @foreach (var c in Cfops) { <option @key="c.Code" value="@c.Code">@c.Code - @c.Description</option> }
</select>

@code {
  public record CfopItem(string Code, string Description);
}
