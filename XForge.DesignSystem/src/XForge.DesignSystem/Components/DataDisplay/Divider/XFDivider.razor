@using XForge.DesignSystem.Core.Primitives;
@namespace XForge.DesignSystem.Components.DataDisplay.Divider
@inherits XForge.DesignSystem.Core.Base.XForgeComponentBase

@if (Visible)
{
    <div id="@Id"
         class="@GetComponentClass()"
         role="separator"
         aria-orientation="@AriaOrientation"
         @attributes="AdditionalAttributes">
        @if (HasLabel && Orientation == XFOrientation.Horizontal)
        {
            <span class="@BeforeLineClass"></span>
            <span class="@LabelClass">
                @if (ChildContent is not null)
                {
                    @ChildContent
                }
                else
                {
                    @Label
                }
            </span>
            <span class="@AfterLineClass"></span>
        }
    </div>
}
