@typeparam T
@inherits XForgeComponentBase

<div @attributes="AdditionalAttributes"
     id="@Id"
     class="@GetComponentClass()"
     style="@Style"
     role="img"
     aria-label="@(AriaLabel ?? "Bubble chart")">

    <svg class="h-full w-full" viewBox="0 0 @SvgWidth @SvgHeight" aria-hidden="true">
        @if (Data is { Count: > 0 })
        {
            var xMin = Data.Min(p => XSelector(p));
            var xMax = Data.Max(p => XSelector(p));
            var yMin = Data.Min(p => YSelector(p));
            var yMax = Data.Max(p => YSelector(p));
            var sizeMin = Data.Min(p => SizeSelector(p));
            var sizeMax = Data.Max(p => SizeSelector(p));
            var xRange = xMax - xMin; if (xRange == 0) xRange = 1;
            var yRange = yMax - yMin; if (yRange == 0) yRange = 1;
            var sizeRange = sizeMax - sizeMin; if (sizeRange == 0) sizeRange = 1;

            var paddingLeft = 40.0;
            var paddingRight = 10.0;
            var paddingTop = 10.0;
            var paddingBottom = 20.0;
            var chartW = SvgWidth - paddingLeft - paddingRight;
            var chartH = SvgHeight - paddingTop - paddingBottom;

            @* ── Grid Lines *@
            @for (var i = 0; i <= 4; i++)
            {
                var yPos = paddingTop + chartH * i / 4;
                <line x1="@paddingLeft" y1="@yPos" x2="@(paddingLeft + chartW)" y2="@yPos"
                      stroke-width="0.5" class="stroke-surface-200" />

                var xPos = paddingLeft + chartW * i / 4;
                <line x1="@xPos" y1="@paddingTop" x2="@xPos" y2="@(paddingTop + chartH)"
                      stroke-width="0.5" class="stroke-surface-200" />
            }

            @* ── Bubbles *@
            @foreach (var pt in Data)
            {
                var px = paddingLeft + (XSelector(pt) - xMin) / xRange * chartW;
                var py = paddingTop + (1 - (YSelector(pt) - yMin) / yRange) * chartH;
                var normSize = (SizeSelector(pt) - sizeMin) / sizeRange;
                var radius = 5 + normSize * (MaxBubbleSize - 5);

                <circle cx="@px" cy="@py" r="@radius"
                        fill="@(FillColor ?? "fill-primary/40")"
                        stroke="@(StrokeColor ?? "stroke-primary")"
                        stroke-width="1" />

                @if (ShowLabels)
                {
                    <svg:text x="@px" y="@(py - radius - 4)" text-anchor="middle"
                          class="fill-text-secondary text-[9px]">
                        @LabelSelector(pt)
                    </svg:text>
                }
            }
        }
    </svg>
</div>
