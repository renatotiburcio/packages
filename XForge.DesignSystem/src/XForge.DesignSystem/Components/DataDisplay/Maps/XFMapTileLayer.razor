@* XFMapTileLayer — Registers a tile layer with the parent XFMap *@

@code {
    [CascadingParameter] private XFMap ParentMap { get; set; } = default!;

    /// <summary>
    /// Tile source URL with {z}/{x}/{y} placeholders. Required.
    /// Use XFMapTileSources for common providers.
    /// </summary>
    [Parameter, EditorRequired] public string Source { get; set; } = string.Empty;

    /// <summary>
    /// Attribution text required by the tile provider.
    /// </summary>
    [Parameter] public string? Attribution { get; set; }

    /// <summary>
    /// Tile size in pixels. Default: 256.
    /// </summary>
    [Parameter] public int TileSize { get; set; } = 256;

    /// <summary>
    /// Minimum zoom level for this layer.
    /// </summary>
    [Parameter] public double? MinZoom { get; set; }

    /// <summary>
    /// Maximum zoom level for this layer.
    /// </summary>
    [Parameter] public double? MaxZoom { get; set; }

    /// <summary>
    /// Optional tile subdomains for source URL.
    /// </summary>
    [Parameter] public string[]? Subdomains { get; set; }

    private int _layerIndex = -1;
    private bool _added;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ParentMap.IsReady && !_added)
        {
            _layerIndex = await ParentMap.AddTileLayerAsync(Source, Attribution, TileSize, MinZoom, MaxZoom, Subdomains);
            _added = true;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_layerIndex >= 0 && ParentMap != null)
        {
            try { await ParentMap.RemoveLayerAsync(_layerIndex); }
            catch (Microsoft.JSInterop.JSDisconnectedException) { }
            catch (InvalidOperationException) { }
        }
    }
}
