@inherits XForge.DesignSystem.Core.Base.XForgeComponentBase
@inject NavigationManager Navigation

<div id="@Id" class="@GetComponentClass()" style="@Style" @attributes="AdditionalAttributes"
     role="tablist" aria-label="@AriaLabel">

    <!-- Tab headers -->
    <div class="@TabListClass">
        <div class="flex items-center overflow-x-auto scrollbar-none" role="tablist">
            @foreach (var tab in _tabs)
            {
                var isActive = tab.Id == _activeTabId;
                <button @key="tab" type="button"
                        role="tab"
                        id="@($"tab-{tab.Id}")"
                        aria-selected="@(isActive.ToString().ToLower())"
                        aria-controls="@($"panel-{tab.Id}")"
                        tabindex="@(isActive ? 0 : -1)"
                        class="@TabClass(isActive)"
                        @onclick="() => ActivateTabAsync(tab.Id)"
                        @onmousedown:stopPropagation="true">

                    @if (tab.Icon != null)
                    {
                        <span class="inline-block h-4 w-4 mr-1.5">@tab.Icon</span>
                    }

                    <span class="truncate max-w-[150px]">@tab.Title</span>

                    @if (tab.IsModified)
                    {
                        <span class="ml-1 inline-block h-2 w-2 rounded-full bg-amber-500" title="@ModifiedText"></span>
                    }

                    @if (tab.Closable)
                    {
                        <button type="button"
                                class="ml-1 inline-flex h-4 w-4 items-center justify-center rounded text-text-muted hover:bg-surface-200 hover:text-text-primary transition-colors"
                                aria-label="@string.Format(CloseTabText, tab.Title)"
                                @onclick="() => CloseTabAsync(tab.Id)"
                                @onclick:stopPropagation="true">
                            <span class="text-xs">&times;</span>
                        </button>
                    }
                </button>
            }
        </div>

        <!-- Add tab button -->
        @if (AllowNewTab)
        {
            <button type="button"
                    class="@AddTabButtonClass"
                    aria-label="@AddTabText"
                    @onclick="AddNewTabAsync">
                <span class="inline-block h-4 w-4">@XFSvgIcons.Markup("plus")</span>
            </button>
        }
    </div>

    <!-- Tab panels -->
    <div class="@PanelContainerClass">
        @foreach (var tab in _tabs)
        {
            var isActive = tab.Id == _activeTabId;
            <div @key="tab" id="@($"panel-{tab.Id}")"
                 role="tabpanel"
                 aria-labelledby="@($"tab-{tab.Id}")"
                 hidden="@(!isActive)"
                 class="@(isActive ? "" : "hidden")">

                @if (tab.Content != null)
                {
                    @tab.Content
                }
                else if (tab.Route != null)
                {
                    <RouterPageContent Route="@tab.Route" />
                }
            </div>
        }
    </div>
</div>
