@inherits XForgeComponentBase

<button @ref="buttonElement"
        id="@TabDomId"
        type="button"
        role="tab"
        class="@GetComponentClass()"
        aria-label="@EffectiveAriaLabel"
        aria-selected="@IsActive.ToString().ToLowerInvariant()"
        aria-controls="@PanelId"
        aria-disabled="@Disabled.ToString().ToLowerInvariant()"
        tabindex="@(IsActive ? "0" : "-1")"
        disabled="@Disabled"
        data-state="@(IsActive ? "active" : "inactive")"
        @onclick="SelectAsync"
        @onkeydown="HandleKeyDownAsync"
        @onkeydown:stopPropagation="true">
    @if (StartIcon is not null)
    {
        <span class="inline-flex shrink-0 items-center justify-center">@StartIcon</span>
    }

    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        <span class="truncate">@Label</span>
    }

    @if (EndContent is not null)
    {
        <span class="inline-flex shrink-0 items-center justify-center">@EndContent</span>
    }

    @if (IsClosable)
    {
        <span class="inline-flex shrink-0 items-center justify-center">
            <button type="button"
                    tabindex="-1"
                    aria-label="@CloseTabLabel"
                    class="ml-1 inline-flex h-4 w-4 items-center justify-center rounded-full text-text-muted hover:bg-surface-200 hover:text-text-primary focus-visible:ring-2 focus-visible:ring-[color-mix(in_oklab,var(--color-primary)_24%,transparent)]"
                    @onclick="CloseAsync"
                    @onclick:stopPropagation="true"
                    @onkeydown:stopPropagation="true">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-3 w-3" aria-hidden="true">
                    <path d="M6.28 5.22a.75.75 0 0 0-1.06 1.06L8.94 10l-3.72 3.72a.75.75 0 1 0 1.06 1.06L10 11.06l3.72 3.72a.75.75 0 1 0 1.06-1.06L11.06 10l3.72-3.72a.75.75 0 0 0-1.06-1.06L10 8.94 6.28 5.22Z" />
                </svg>
            </button>
        </span>
    }
</button>
