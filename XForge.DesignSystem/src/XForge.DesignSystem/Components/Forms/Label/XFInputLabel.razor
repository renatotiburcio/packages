@inherits XForgeComponentBase

<label @attributes="AdditionalAttributes"
       id="@Id"
       for="@For"
       class="@GetComponentClass()"
       style="@Style"
       aria-label="@AriaLabel">
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        @Text
    }
    @if (Required)
    {
        <span class="text-danger" aria-hidden="true">&ast;</span>
    }
</label>
