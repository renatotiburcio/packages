@typeparam TItem
@typeparam TValue
@inherits XForgeComponentBase

<div class="@RootClass" style="@Style" @onkeydown="HandleKeyDownAsync">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label for="@Id" class="@LabelClass">
            @Label
            @if (Required)
            {
                <span class="text-danger" aria-hidden="true">*</span>
            }
        </label>
    }

    <div class="@ShellWrapClass">
        <div class="@FieldShellClass" @onclick="OpenAsync">
            @if (SelectedItems.Count > 0)
            {
                <div class="@ChipListClass">
                    @foreach (var selectedItem in SelectedItems.Take(MaxVisibleChips))
                    {
                        <span @key="selectedItem" class="@ChipClass">
                            <span class="min-w-0 truncate">@GetItemText(selectedItem)</span>
                            @if (!Disabled && !ReadOnly)
                            {
                                <button type="button" class="@ChipRemoveClass" aria-label="@FormatRemoveChipLabel(selectedItem)" @onclick:stopPropagation="true" @onclick="@(() => RemoveItemAsync(selectedItem))">
                                    <span class="inline-block h-3 w-3">@XFSvgIcons.Markup("xmark")</span>
                                </button>
                            }
                        </span>
                    }
                    @if (SelectedItems.Count > MaxVisibleChips)
                    {
                        <span class="@ChipClass">+@(SelectedItems.Count - MaxVisibleChips)</span>
                    }
                </div>
            }

            <input @attributes="AdditionalAttributes"
                   id="@Id"
                   name="@Name"
                   class="@InputClass"
                   type="text"
                   autocomplete="off"
                   placeholder="@InputPlaceholder"
                   disabled="@Disabled"
                   readonly="@ReadOnly"
                   required="@Required"
                   aria-label="@AriaLabel"
                   aria-invalid="@AriaInvalid"
                   aria-required="@Required"
                   aria-readonly="@ReadOnly"
                   aria-describedby="@DescribedBy"
                   aria-autocomplete="list"
                   aria-expanded="@IsOpen"
                   aria-controls="@ListboxId"
                   aria-activedescendant="@ActiveOptionId"
                   role="combobox"
                   value="@SearchText"
                   @oninput="HandleInputAsync"
                   @onfocus="HandleFocusAsync" />

            @if (Loading)
            {
                <div class="@AdornmentClass">
                    <span class="h-4 w-4 animate-spin rounded-full border-2 border-[color-mix(in_oklab,var(--color-primary)_25%,transparent)] border-t-primary" aria-label="@LoadingText"></span>
                </div>
            }
            else if (Clearable && SelectedItems.Count > 0 && !Disabled && !ReadOnly)
            {
                <button type="button" class="@IconButtonClass" aria-label="@ClearLabel" @onclick:stopPropagation="true" @onclick="ClearAsync">
                    <span class="inline-block h-3 w-3">@XFSvgIcons.Markup("xmark")</span>
                </button>
            }

            <button type="button"
                    class="@ToggleButtonClass"
                    disabled="@Disabled"
                    aria-label="@ToggleLabel"
                    aria-expanded="@IsOpen"
                    aria-controls="@ListboxId"
                    @onclick:stopPropagation="true"
                    @onclick="ToggleAsync">
                <span class="@ChevronClass">@XFSvgIcons.Markup("chevron-down")</span>
            </button>
        </div>

        @if (IsOpen)
        {
            <div id="@ListboxId" class="@ListboxClass" role="listbox" aria-label="@ListboxLabel" aria-multiselectable="true">
                @if (ShowBulkActions && !Loading && FilteredItems.Count > 0)
                {
                    <div class="flex items-center justify-between gap-2 border-b border-border-light px-2 py-1.5">
                        <button type="button" class="@BulkButtonClass" @onclick="SelectAllAsync">@SelectAllLabel</button>
                        <button type="button" class="@BulkButtonClass" @onclick="ClearAsync">@ClearLabel</button>
                    </div>
                }

                @if (Loading)
                {
                    <div class="@StateRowClass">@LoadingText</div>
                }
                else if (FilteredItems.Count == 0)
                {
                    <div class="@StateRowClass">@EmptyText</div>
                }
                else
                {
                    @if (HasGroups)
                    {
                        var groupedIndex = 0;
                        @foreach (var group in FilteredItems.GroupBy(GetItemGroup))
                        {
                            <div @key="group.Key" class="@GroupHeaderClass" role="group" aria-label="@group.Key">
                                @if (GroupTemplate is not null)
                                {
                                    @GroupTemplate(group.Key)
                                }
                                else
                                {
                                    @group.Key
                                }
                            </div>
                            @foreach (var item in group)
                            {
                                var localIndex = groupedIndex;
                                var selected = IsSelected(item);
                                <button type="button"
                                        id="@GetOptionId(localIndex)"
                                        class="@GetOptionClass(localIndex, selected)"
                                        role="option"
                                        aria-selected="@selected.ToString().ToLowerInvariant()"
                                        aria-disabled="@IsDisabled(item).ToString().ToLowerInvariant()"
                                        @onclick="@(() => ToggleItemAsync(item))">
                                    <span class="@CheckClass(selected)">
                                        @if (selected)
                                        {
                                            <span class="inline-block h-3 w-3">@XFSvgIcons.Markup("check")</span>
                                        }
                                    </span>
                                    <span class="min-w-0 flex-1">
                                        @if (ItemTemplate is not null)
                                        {
                                            @ItemTemplate(item)
                                        }
                                        else
                                        {
                                            @GetItemText(item)
                                        }
                                    </span>
                                </button>
                                groupedIndex++;
                            }
                        }
                    }
                    else
                    {
                        @foreach (var indexedItem in FilteredItems.Select((item, index) => new { item, index }))
                        {
                            var selected = IsSelected(indexedItem.item);
                            <button type="button"
                                    id="@GetOptionId(indexedItem.index)"
                                    class="@GetOptionClass(indexedItem.index, selected)"
                                    role="option"
                                    aria-selected="@selected.ToString().ToLowerInvariant()"
                                    aria-disabled="@IsDisabled(indexedItem.item).ToString().ToLowerInvariant()"
                                    @onclick="@(() => ToggleItemAsync(indexedItem.item))">
                                <span class="@CheckClass(selected)">
                                    @if (selected)
                                    {
                                        <span class="inline-block h-3 w-3">@XFSvgIcons.Markup("check")</span>
                                    }
                                </span>
                                <span class="min-w-0 flex-1">
                                    @if (ItemTemplate is not null)
                                    {
                                        @ItemTemplate(indexedItem.item)
                                    }
                                    else
                                    {
                                        @GetItemText(indexedItem.item)
                                    }
                                </span>
                            </button>
                        }
                    }
                }
            </div>
        }
    </div>

    @if (HasValidationError)
    {
        <div id="@ErrorId" class="@ErrorClass" role="alert">@FirstValidationMessage</div>
    }
    else if (!string.IsNullOrWhiteSpace(HelperText))
    {
        <div id="@HelperId" class="@HelperClass">@HelperText</div>
    }
</div>

