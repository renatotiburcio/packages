@inherits XFInputComponentBase

<div class="@RootClass" style="@Style">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label for="@Id" class="@LabelClass">
            @Label
            @if (Required)
            {
                <span class="text-danger" aria-hidden="true">*</span>
            }
        </label>
    }

    <div class="@FieldClass">
        <input @ref="InputRef"
               @attributes="AdditionalAttributes"
               id="@Id"
               name="@Name"
               class="@InputClass"
               type="@InputType"
               placeholder="@Placeholder"
               autocomplete="@AutoComplete"
               disabled="@Disabled"
               readonly="@ReadOnly"
               required="@Required"
               aria-label="@AriaLabel"
               aria-required="@Required.ToString().ToLowerInvariant()"
               aria-disabled="@Disabled.ToString().ToLowerInvariant()"
               aria-readonly="@ReadOnly.ToString().ToLowerInvariant()"
               aria-describedby="@DescribedBy"
               value="@CurrentValue"
               @oninput="HandleInputAsync"
               @onchange="HandleChangeAsync"
               @onfocus="OnFocus"
               @onblur="OnBlur" />

        @if (ShowPasswordToggle)
        {
            <button type="button"
                    class="@ToggleButtonClass"
                    disabled="@Disabled"
                    aria-label="@ToggleLabel"
                    aria-pressed="@showPassword.ToString().ToLowerInvariant()"
                    title="@ToggleLabel"
                    @onclick="ToggleVisibility">
                <span class="inline-block h-4 w-4">@XFSvgIcons.Markup("eye")</span>
            </button>
        }
    </div>

    @if (ShowStrength)
    {
        <div class="mt-3 flex items-center justify-between gap-3">
            <span class="text-xs font-bold uppercase tracking-wide text-text-muted">@StrengthCaption</span>
            <span class="@StrengthTextClass">@StrengthLabel</span>
        </div>
        <div class="mt-1 h-2 overflow-hidden rounded-full bg-surface-200">
            <div class="@ProgressClass" style="width:@Score%;"></div>
        </div>
    }

    @if (ShowRules)
    {
        <div id="@RulesId" class="mt-4 grid gap-2">
            @foreach (var rule in RuleStates)
            {
                <div class="flex items-center gap-2 text-sm">
                    <span class="@GetRuleIconClass(rule)" aria-hidden="true">
                        @XFSvgIcons.Markup(rule.IsSatisfied ? "check" : "xmark")
                    </span>
                    <span class="@GetRuleTextClass(rule)">@rule.Text</span>
                </div>
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(HelperText))
    {
        <div id="@HelperId" class="text-xs leading-5 text-text-secondary">@HelperText</div>
    }
</div>
