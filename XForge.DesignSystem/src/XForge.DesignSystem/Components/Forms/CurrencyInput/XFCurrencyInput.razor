@using XForge.DesignSystem.Components.Forms.NumberInput
@inherits XFInputComponentBase

@if (StartIcon is null)
{
    <XFNumberInput TValue="decimal?"
                   Id="@Id"
                   Name="@Name"
                   Label="@Label"
                   AriaLabel="@AriaLabel"
                   Placeholder="@Placeholder"
                   HelperText="@HelperText"
                   PrefixText="@ResolvedCurrencySymbol"
                   SuffixText="@ResolvedSuffixText"
                   Value="@Value"
                   ValueChanged="@ValueChanged"
                   ValueExpression="@ValueExpression"
                   Change="@Change"
                   Min="@Min"
                   Max="@Max"
                   Step="@Step"
                   Scale="@Scale"
                   Precision="@Precision"
                   Culture="@Culture"
                   CultureName="@CultureName"
                   CurrencySymbol="@ResolvedCurrencySymbol"
                   FormatStyle="XFNumberInputFormatStyle.Currency"
                   Variant="@Variant"
                   Size="@Size"
                   Tone="@Tone"
                   TextAlign="@TextAlign"
                   Disabled="@Disabled"
                   ReadOnly="@ReadOnly"
                   Required="@Required"
                   FullWidth="@FullWidth"
                   Immediate="@Immediate"
                   Clamp="@Clamp"
                   ShowSteppers="@ShowSteppers"
                   StepperLayout="@StepperLayout"
                   AutoDecimalSeparator="@AutoDecimalSeparator"
                   IncrementLabel="@IncrementLabel"
                   DecrementLabel="@DecrementLabel"
                   AriaValueTextFormat="@AriaValueTextFormat"
                   Class="@Class"
                   Style="@Style"
                   AdditionalAttributes="@AdditionalAttributes" />
}
else
{
    <XFNumberInput TValue="decimal?"
                   Id="@Id"
                   Name="@Name"
                   Label="@Label"
                   AriaLabel="@AriaLabel"
                   Placeholder="@Placeholder"
                   HelperText="@HelperText"
                   SuffixText="@ResolvedSuffixText"
                   Value="@Value"
                   ValueChanged="@ValueChanged"
                   ValueExpression="@ValueExpression"
                   Change="@Change"
                   Min="@Min"
                   Max="@Max"
                   Step="@Step"
                   Scale="@Scale"
                   Precision="@Precision"
                   Culture="@Culture"
                   CultureName="@CultureName"
                   CurrencySymbol="@ResolvedCurrencySymbol"
                   FormatStyle="XFNumberInputFormatStyle.Currency"
                   Variant="@Variant"
                   Size="@Size"
                   Tone="@Tone"
                   TextAlign="@TextAlign"
                   Disabled="@Disabled"
                   ReadOnly="@ReadOnly"
                   Required="@Required"
                   FullWidth="@FullWidth"
                   Immediate="@Immediate"
                   Clamp="@Clamp"
                   ShowSteppers="@ShowSteppers"
                   StepperLayout="@StepperLayout"
                   AutoDecimalSeparator="@AutoDecimalSeparator"
                   IncrementLabel="@IncrementLabel"
                   DecrementLabel="@DecrementLabel"
                   AriaValueTextFormat="@AriaValueTextFormat"
                   Class="@Class"
                   Style="@Style"
                   AdditionalAttributes="@AdditionalAttributes">
        <StartIcon>
            @StartIcon
        </StartIcon>
    </XFNumberInput>
}
