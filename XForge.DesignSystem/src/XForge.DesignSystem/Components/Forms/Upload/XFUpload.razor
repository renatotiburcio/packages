@using Microsoft.AspNetCore.Components.Forms
@inherits XForgeComponentBase

<div class="@RootClass" style="@Style">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="@LabelClass">@Label</label>
    }

    <div class="@DropZoneClass"
         role="region"
         aria-label="@Label"
         aria-disabled="@Disabled.ToString().ToLowerInvariant()"
         aria-describedby="@DescribedBy"
         aria-live="polite">
        <InputFile @attributes="AdditionalAttributes"
                   id="@Id"
                   class="sr-only"
                   OnChange="HandleChangeAsync"
                   multiple="@Multiple"
                   accept="@Accept"
                   disabled="@Disabled" />

        <label for="@Id" class="flex min-w-0 flex-1 cursor-pointer items-center gap-3">
            <span class="@IconWrapClass" aria-hidden="true">
                @if (Icon is not null)
                {
                    @Icon
                }
                else
                {
                    <span class="inline-block h-5 w-5">@XFSvgIcons.Markup("cloud-arrow-up")</span>
                }
            </span>
            <span class="min-w-0 flex-1 space-y-1">
                <span class="@TitleClass">@ResolvedTitle</span>
                <span class="@DescriptionClass">@ResolvedDescription</span>
            </span>
        </label>

        @if (ShowUploadAll)
        {
            <button type="button" class="@ActionButtonClass" disabled="@ActionDisabled" @onclick="UploadAllAsync">@UploadText</button>
        }
    </div>

    @if (Items.Count > 0)
    {
        <div class="@ListClass">
            @foreach (var item in Items)
            {
                <div @key="item" class="@ItemClass">
                    <div class="min-w-0 flex-1 space-y-2">
                        <div class="flex items-start justify-between gap-3">
                            <div class="min-w-0">
                                <div class="truncate text-sm font-semibold text-text-primary">@item.Name</div>
                                <div class="text-xs text-text-secondary">@FormatFileMetadata(item)</div>
                            </div>
                            <span class="@GetStatusClass(item.Status)">@GetStatusText(item)</span>
                        </div>
                        <div class="h-1.5 overflow-hidden rounded-full bg-surface-200" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@ClampProgress(item.Progress)">
                            <div class="@GetProgressClass(item.Status)" style="@GetProgressStyle(item.Progress)"></div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(item.Message))
                        {
                            <div class="text-xs text-text-secondary">@item.Message</div>
                        }
                    </div>
                    <div class="flex shrink-0 items-center gap-1">
                        @if (item.Status is XFUploadStatus.Ready or XFUploadStatus.Error or XFUploadStatus.Canceled)
                        {
                            <button type="button" class="@IconButtonClass" aria-label="@RetryText" @onclick="@(() => UploadItemAsync(item))">
                                <span class="inline-block h-3 w-3">@XFSvgIcons.Markup("arrows-rotate")</span>
                            </button>
                        }
                        @if (item.Status == XFUploadStatus.Uploading)
                        {
                            <button type="button" class="@IconButtonClass" aria-label="@CancelText" @onclick="@(() => CancelItemAsync(item))">
                                <span class="inline-block h-3 w-3">@XFSvgIcons.Markup("xmark")</span>
                            </button>
                        }
                        <button type="button" class="@IconButtonClass" aria-label="@RemoveText" @onclick="@(() => RemoveItemAsync(item))">
                            <span class="inline-block h-3 w-3">@XFSvgIcons.Markup("xmark")</span>
                        </button>
                    </div>
                </div>
            }
        </div>
    }
    else if (EmptyContent is not null)
    {
        @EmptyContent
    }

    @if (!string.IsNullOrWhiteSpace(HelperText))
    {
        <div id="@HelperId" class="@HelperClass">@HelperText</div>
    }
</div>

