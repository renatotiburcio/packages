@typeparam TValue

<div class="@OptionClass"
     role="option"
     aria-selected="@(IsSelected ? "true" : "false")"
     @onmousedown="HandleSelect"
     @onmousedown:preventDefault>
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        @Text
    }
    @if (IsSelected)
    {
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
    }
</div>

@code {
    [Parameter] public TValue? Value { get; set; }
    [Parameter] public string? Text { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Hidden { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [CascadingParameter] private XFSelect<TValue>? Select { get; set; }

    private bool IsSelected => Select is not null && object.Equals(Value, Select.CurrentValue);

    private string OptionClass
    {
        get
        {
            var classes = new List<string> { "xf-select-option" };
            if (IsSelected) classes.Add("selected");
            if (Disabled) classes.Add("disabled");
            if (Hidden) classes.Add("hidden");
            return string.Join(" ", classes);
        }
    }

    private void HandleSelect()
    {
        if (Disabled || Select is null) return;
        _ = Select.SelectValueWithDisplayAsync(Value, Text ?? Value?.ToString());
    }
}