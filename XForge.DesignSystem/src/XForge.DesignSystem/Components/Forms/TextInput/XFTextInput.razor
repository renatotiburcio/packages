@inherits XFInputComponentBase

<div class="@RootClass" style="@Style">
    @if (!string.IsNullOrWhiteSpace(Label) && !FloatingLabel)
    {
        <label for="@Id" class="@LabelClass">
            @Label
            @if (Required)
            {
                <span class="text-danger" aria-hidden="true">*</span>
            }
        </label>
    }

    <div class="@FieldShellClass">
        @if (StartIcon is not null || !string.IsNullOrWhiteSpace(PrefixText))
        {
            <div class="@EndAdornmentClass">
                @if (StartIcon is not null)
                {
                    @StartIcon
                }
                else
                {
                    <span>@PrefixText</span>
                }
            </div>
        }

        <input @ref="InputRef"
               @attributes="AdditionalAttributes"
               id="@Id"
               name="@Name"
               class="@InputClass"
               style="@InputStyle"
               type="@InputType"
               inputmode="@InputMode"
               autocomplete="@AutoComplete"
               placeholder="@ResolvedPlaceholder"
               maxlength="@MaxLength"
               minlength="@MinLength"
               pattern="@Pattern"
               size="@VisibleCharacters"
               disabled="@Disabled"
               readonly="@ReadOnly"
               required="@Required"
               aria-label="@AriaLabel"
               aria-disabled="@Disabled.ToString().ToLowerInvariant()"
               aria-invalid="@AriaInvalid"
               aria-required="@Required.ToString().ToLowerInvariant()"
               aria-readonly="@ReadOnly.ToString().ToLowerInvariant()"
               aria-describedby="@DescribedBy"
               value="@CurrentValue"
               @oninput="HandleInputAsync"
               @onchange="HandleChangeAsync"
               @onfocus="OnFocus"
               @onblur="OnBlur" />

        @if (FloatingLabel && !string.IsNullOrWhiteSpace(Label))
        {
            <label for="@Id" class="@FloatingLabelClass">
                @Label
                @if (Required)
                {
                    <span class="text-danger" aria-hidden="true">*</span>
                }
            </label>
        }

        @if (EndIcon is not null || Clearable || !string.IsNullOrWhiteSpace(SuffixText))
        {
            <div class="@AdornmentClass">
                @if (EndIcon is not null)
                {
                    @EndIcon
                }
                else if (Clearable && !string.IsNullOrEmpty(CurrentValue) && !ReadOnly && !Disabled)
                {
                    <button type="button" class="@ClearButtonClass" aria-label="@ClearLabel" @onclick="ClearAsync">
                        <span class="inline-block h-3 w-3">@XFSvgIcons.Markup("xmark")</span>
                    </button>
                }
                else
                {
                    <span>@SuffixText</span>
                }
            </div>
        }
    </div>

    @if (HasValidationError)
    {
        <div id="@ErrorId" class="@ErrorClass" role="alert">
            @FirstValidationMessage
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(HelperText))
    {
        <div id="@HelperId" class="@HelperClass">
            @HelperText
        </div>
    }
</div>

