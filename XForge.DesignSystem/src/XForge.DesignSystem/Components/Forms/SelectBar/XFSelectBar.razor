@inherits XForgeComponentBase

<div @attributes="AdditionalAttributes"
     id="@Id"
     class="@GetComponentClass()"
     style="@Style"
     role="radiogroup"
     aria-label="@AriaLabel">
    @if (Items is not null)
    {
        @foreach (var item in Items)
        {
            var isSelected = string.Equals(Value, item.Value, StringComparison.Ordinal);
            <button @key="item" type="button"
                    class="@GetItemClass(item.Value, item.Disabled)"
                    role="radio"
                    aria-checked="@(isSelected ? "true" : "false")"
                    disabled="@item.Disabled"
                    aria-disabled="@item.Disabled.ToString().ToLowerInvariant()"
                    @onclick="() => HandleItemClickAsync(item.Value, item.Disabled)">
                @if (item.Icon is not null)
                {
                    <span class="inline-flex shrink-0 items-center justify-center" aria-hidden="true">@item.Icon</span>
                }
                @item.Text
            </button>
        }
    }
</div>
