@inherits XForgeComponentBase
@using XForge.DesignSystem.Components.Overlays.DropdownMenu
@using XForge.DesignSystem.Components.Forms.Checkbox
@using XForge.DesignSystem.Components.Forms.Radio
@using XForge.DesignSystem.Core.Primitives

<div @attributes="AdditionalAttributes"
     id="@Id"
     class="@RootClass"
     style="@Style"
     @oncontextmenu="HandleContextMenuAsync"
     @oncontextmenu:preventDefault="true">
    @ChildContent
</div>

@if (Open)
{
    <div class="@OverlayClass" @onclick="HandleOverlayClickAsync"></div>
    <div @attributes="AdditionalAttributes"
         id="@Id"
         class="@MenuClass"
         style="@MenuStyle"
         role="menu"
         aria-label="@AriaLabel"
         aria-orientation="vertical"
         tabindex="-1"
         @onkeydown="HandleKeyDownAsync">
        @{ }
        @foreach (var indexedItem in Items.Select((item, index) => new { item, index }))
        {
            if (indexedItem.item.Kind == XFDropdownMenuItemKind.Separator)
            {
                <div class="my-1 h-px bg-border-light" role="separator"></div>
            }
            else if (indexedItem.item.Kind == XFDropdownMenuItemKind.Header)
            {
                <div class="px-2 py-1.5 text-xs font-semibold uppercase tracking-wide text-text-muted">@indexedItem.item.Text</div>
            }
            else if (indexedItem.item.Kind == XFDropdownMenuItemKind.XFCheckbox)
            {
                <div class="flex items-center px-2 py-1.5">
                    <XFCheckbox Value="@indexedItem.item.Checked"
                                ValueChanged="@((bool? v) => HandleCheckboxChanged(indexedItem.item, v))"
                                Label="@indexedItem.item.Text"
                                Size="XFSize.Sm"
                                Disabled="@indexedItem.item.Disabled"
                                Description="@indexedItem.item.Description" />
                </div>
            }
            else if (indexedItem.item.Kind == XFDropdownMenuItemKind.XFRadio)
            {
                @if (IsFirstInRadioGroup(indexedItem.item, indexedItem.index))
                {
                    var groupItems = Items.Where(i => i.Kind == XFDropdownMenuItemKind.XFRadio && i.Group == indexedItem.item.Group).ToList();
                    var checkedItem = groupItems.FirstOrDefault(i => i.Checked);
                    <XFRadioGroup Value="@checkedItem?.Id"
                                  ValueChanged="@((string? v) => HandleRadioGroupChanged(indexedItem.item.Group, v))"
                                  Size="XFSize.Sm"
                                  AriaLabel="@indexedItem.item.Group">
                        @foreach (var radioItem in groupItems)
                        {
                            <XFRadio Value="@radioItem.Id"
                                     Label="@radioItem.Text"
                                     Disabled="@radioItem.Disabled" />
                        }
                    </XFRadioGroup>
                }
            }
            else
            {
                var itemRole = GetItemRole(indexedItem.item);
                <div class="group relative">
                    <button type="button"
                            class="@GetItemClass(indexedItem.index)"
                            role="@itemRole"
                            aria-haspopup="@(HasSubmenu(indexedItem.item) ? "menu" : null)"
                            aria-expanded="@(HasSubmenu(indexedItem.item) ? (indexedItem.index == ActiveIndex).ToString().ToLowerInvariant() : null)"
                            disabled="@indexedItem.item.Disabled"
                            @onmouseenter="@(() => SetActiveIndex(indexedItem.index))"
                            @onclick="@(() => ActivateItemAsync(indexedItem.item))">
                        @if (indexedItem.item.Icon is not null)
                        {
                            <span class="@IndicatorClass(indexedItem.item)">@indexedItem.item.Icon</span>
                        }
                        <span class="min-w-0 flex-1 text-left">
                            <span class="block truncate">@indexedItem.item.Text</span>
                            @if (!string.IsNullOrWhiteSpace(indexedItem.item.Description))
                            {
                                <span class="block truncate text-xs text-text-muted">@indexedItem.item.Description</span>
                            }
                        </span>
                        @if (HasSubmenu(indexedItem.item))
                        {
                            <span class="ml-2 inline-block h-3 w-3 text-text-muted">@XFSvgIcons.Markup("chevron-right")</span>
                        }
                    </button>

                    @if (HasSubmenu(indexedItem.item))
                    {
                        <div class="@GetSubmenuClass(indexedItem.index)" role="menu" aria-label="@GetSubmenuAriaLabel(indexedItem.item)">
                            @foreach (var child in indexedItem.item.Children)
                            {
                                if (child.Kind == XFDropdownMenuItemKind.Separator)
                                {
                                    <div class="my-1 h-px bg-border-light" role="separator"></div>
                                }
                                else if (child.Kind == XFDropdownMenuItemKind.Header)
                                {
                                    <div class="px-2 py-1.5 text-xs font-semibold uppercase tracking-wide text-text-muted">@child.Text</div>
                                }
                                else if (child.Kind == XFDropdownMenuItemKind.XFCheckbox)
                                {
                                    <div class="flex items-center px-2 py-1.5">
                                        <XFCheckbox Value="@child.Checked"
                                                    ValueChanged="@((bool? v) => HandleCheckboxChanged(child, v))"
                                                    Label="@child.Text"
                                                    Size="XFSize.Sm"
                                                    Disabled="@child.Disabled"
                                                    Description="@child.Description" />
                                    </div>
                                }
                                else
                                {
                                    <button type="button"
                                            class="@GetSubmenuItemClass(child)"
                                            role="@GetItemRole(child)"
                                            disabled="@child.Disabled"
                                            @onclick="@(() => ActivateItemAsync(child))">
                                        @if (child.Icon is not null)
                                        {
                                            <span class="@IndicatorClass(child)">@child.Icon</span>
                                        }
                                        <span class="min-w-0 flex-1 text-left">
                                            <span class="block truncate">@child.Text</span>
                                            @if (!string.IsNullOrWhiteSpace(child.Description))
                                            {
                                                <span class="block truncate text-xs text-text-muted">@child.Description</span>
                                            }
                                        </span>
                                    </button>
                                }
                            }
                        </div>
                    }
                </div>
            }
        }
    </div>
}
