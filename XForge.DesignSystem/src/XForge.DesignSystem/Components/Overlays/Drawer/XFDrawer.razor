@inherits XForgeComponentBase

@if (ShouldRenderDrawer)
{
    <div class="@OverlayClass" @onclick="HandleOverlayClickAsync" @onclick:stopPropagation="false">
        <aside @attributes="AdditionalAttributes"
               id="@Id"
               class="@PanelClass"
               style="@Style"
               role="dialog"
               aria-modal="@Modal.ToString().ToLowerInvariant()"
               aria-label="@EffectiveAriaLabel"
               aria-labelledby="@EffectiveAriaLabelledBy"
               aria-describedby="@AriaDescribedBy"
               data-placement="@Placement.ToString().ToLowerInvariant()"
               @onclick:stopPropagation="true"
               @onkeydown="HandleKeyDownAsync"
               tabindex="-1">
            @if (ShowHeader)
            {
                <header class="@HeaderClass">
                    <div class="min-w-0 space-y-1">
                        @if (Header is not null)
                        {
                            @Header
                        }
                        else
                        {
                            @if (!string.IsNullOrWhiteSpace(Title))
                            {
                                <h2 id="@TitleId" class="@TitleClass">@Title</h2>
                            }

                            @if (!string.IsNullOrWhiteSpace(Description))
                            {
                                <p id="@DescriptionId" class="@DescriptionClass">@Description</p>
                            }
                        }
                    </div>

                    @if (ShowCloseButton)
                    {
                        <button type="button" class="@CloseButtonClass" aria-label="@CloseLabel" @onclick="@(() => CloseAsync(XFDrawerCloseReason.User))">
                            <span class="inline-block h-4 w-4">@XFSvgIcons.Markup("xmark")</span>
                        </button>
                    }
                </header>
            }

            <div class="@BodyClass">
                @ChildContent
            </div>

            @if (Footer is not null)
            {
                <footer class="@FooterClass">
                    @Footer
                </footer>
            }
        </aside>
    </div>
}

