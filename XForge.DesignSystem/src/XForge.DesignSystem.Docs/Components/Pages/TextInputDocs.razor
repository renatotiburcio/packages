@page "/forms/text-input"
@using Microsoft.AspNetCore.Components.Forms
@using XForge.DesignSystem.Core.Primitives
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFTextInput" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Acessivel", "Accessible")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Debounce", "Debounce")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Enterprise", "Enterprise")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Campo de texto acessivel com label, adornos, debounce, limpeza e validacao.",
                               "Accessible text input with label, adornments, debounce, clear and validation.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("XFTextInput e o componente base de entrada de texto do XForge. Suporta 6 tipos HTML, 4 variantes, 3 tamanhos, label flutuante, adornos, clearable, debounce, trim e integracao completa com EditForm.",
                               "XFTextInput is the base text input component of XForge. Supports 6 HTML types, 4 variants, 3 sizes, floating label, adornments, clearable, debounce, trim and full EditForm integration.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico. Interacoes requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderizacao.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Consideracoes", "Considerations")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor Server: eventos sao tratados via SignalR. Sem latencia adicional para componentes puramente renderizados.", "Blazor Server: events are handled via SignalR. No additional latency for purely rendered components.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor WebAssembly: eventos sao tratados diretamente no cliente. Mais responsivo.", "Blazor WebAssembly: events are handled directly on the client. More responsive.")</XFTypography>
                </XFStack>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Hierarquia visual", "Visual Hierarchy"), @<div>@TileGrid(VisualHierarchyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 11 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Basico", "1. Basic"),
                T("XFTextInput com Label, Placeholder e HelperText.", "XFTextInput with Label, Placeholder and HelperText."),
                ExBasic(), CodeBasic)

            @Example(T("2. Variantes", "2. Variants"),
                T("Outline, Filled, Soft e Ghost.", "Outline, Filled, Soft and Ghost."),
                ExVariants(), CodeVariants)

            @Example(T("3. Tamanhos", "3. Sizes"),
                T("Sm, Md e Lg.", "Sm, Md and Lg."),
                ExSizes(), CodeSizes)

            @Example(T("4. Tipos", "4. Types"),
                T("Text, Email, Password, Search, Tel, Url.", "Text, Email, Password, Search, Tel, Url."),
                ExTypes(), CodeTypes)

            @Example(T("5. Adornos", "5. Adornments"),
                T("StartIcon, EndIcon, PrefixText e SuffixText.", "StartIcon, EndIcon, PrefixText and SuffixText."),
                ExAdornments(), CodeAdornments)

            @Example(T("6. Clearable", "6. Clearable"),
                T("Botao de limpar com ClearLabel customizado.", "Clear button with custom ClearLabel."),
                ExClearable(), CodeClearable)

            @Example(T("7. Floating Label", "7. Floating Label"),
                T("Label flutuante estilo Material.", "Material-style floating label."),
                ExFloatingLabel(), CodeFloatingLabel)

            @Example(T("8. Estados", "8. States"),
                T("Disabled, ReadOnly e Required.", "Disabled, ReadOnly and Required."),
                ExStates(), CodeStates)

            @Example(T("9. Immediate + Debounce", "9. Immediate + Debounce"),
                T("Valor em tempo real com debounce de 400ms.", "Real-time value with 400ms debounce."),
                ExImmediate(), CodeImmediate)

            @Example(T("10. Validacao EditForm", "10. EditForm Validation"),
                T("Integracao com DataAnnotations: Required, Length.", "Integration with DataAnnotations: Required, Length."),
                ExValidation(), CodeValidation)

            @Example(T("11. Enterprise", "11. Enterprise"),
                T("Formulario de cadastro de cliente com multiplos campos.", "Customer registration form with multiple fields."),
                ExEnterprise(), CodeEnterprise)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Variantes", "Variants"), @<div>@NameValueTable(VariantRows, T("Variante", "Variant"), T("Caso de uso", "Use case"))</div>)
            @Section(T("Estados", "States"), @<div>@NameValueTable(StateRows, T("Estado", "State"), T("Comportamento", "Behavior"))</div>)
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Metodos", "Methods"), @<div>@NameValueTable(MethodRows, T("Metodo", "Method"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("Design Tokens", @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>

@code {
    private string ProductLabelText => T("Forms", "Forms");
    private string PageTitleText => T("Text Input", "Text Input");
    private string PageStatusText => T("Documentacao completa", "Complete docs");
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");

    // --- State for interactive examples ---
    private string? _basicValue;
    private string? _variantValue;
    private string? _sizeValue;
    private string? _emailValue;
    private string? _passwordValue;
    private string? _searchValue;
    private string? _telValue;
    private string? _urlValue;
    private string? _prefixValue;
    private string? _suffixValue;
    private string? _clearableValue;
    private string? _floatingValue;
#pragma warning disable CS0649
    private string? _disabledValue;
    private string? _readonlyValue;
#pragma warning restore CS0649
    private string? _immediateValue;
    private bool _formSubmitted;
    private string? _enterpriseName;
    private string? _enterpriseEmail;
    private string? _enterprisePhone;
    private string? _enterpriseDocument;

    // --- Validation model ---
    private TextInputFormModel _formModel = new();
    private EditContext? _editContext;

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_formModel);
    }

    private void HandleValidSubmit()
    {
        _formSubmitted = true;
    }

    // --- Helpers ---
    private RenderFragment Section(string title, RenderFragment content) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg"><Header><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography></Header><ChildContent>@content</ChildContent></XFCard>;
    private RenderFragment Example(string title, string description, RenderFragment preview, string codeText) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.None" AreaRestricted="false"><Header><div class="px-6 pt-6"><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@description</XFTypography></div></Header><ChildContent><div class="grid"><div class="border-t border-border-light p-6">@preview</div><div class="border-t border-border-light bg-surface-50 p-6"><XFCode Text="@codeText" Language="razor" Title="@CopyableCodeTitle" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" /></div></div></ChildContent></XFCard>;
    private RenderFragment Tile(DocTile item) => @<XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true"><div class="flex items-center gap-4"><span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-primary/10 bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span><div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div></div><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography></XFStack></ChildContent></XFCard>;
    private RenderFragment TileGrid(IReadOnlyList<DocTile> items, int columns) => @<XFGrid Cols="1" Md="@Math.Min(columns, 2)" Lg="@columns" Gap="4">@foreach (var item in items) { @Tile(item) }</XFGrid>;
    private RenderFragment WarningGrid(IReadOnlyList<DocTile> items) => @<XFGrid Cols="1" Md="2" Gap="4">@foreach (var item in items) { <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true"><div class="flex items-center gap-4"><span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-danger/10 bg-danger/10 text-danger" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span><div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div></div><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography></XFStack></ChildContent></XFCard> }</XFGrid>;
    private RenderFragment NameValueTable(IReadOnlyList<NameValueRow> rows, string nameHeader, string valueHeader) => @<XFTable Striped="true" Hoverable="true" Compact="true"><XFTableHeader><XFTableRow><XFTableCell Header="true">@nameHeader</XFTableCell><XFTableCell Header="true">@valueHeader</XFTableCell></XFTableRow></XFTableHeader><XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Value</XFTableCell></XFTableRow> }</XFTableBody></XFTable>;
    private RenderFragment ApiTable(IReadOnlyList<ApiRow> rows) => @<XFTable Striped="true" Hoverable="true" Compact="true"><XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Parametro", "Parameter")</XFTableCell><XFTableCell Header="true">Type</XFTableCell><XFTableCell Header="true">Default</XFTableCell><XFTableCell Header="true">@T("Descricao", "Description")</XFTableCell></XFTableRow></XFTableHeader><XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Type</XFTableCell><XFTableCell><XFCode Text="@row.DefaultValue" /></XFTableCell><XFTableCell>@row.Description</XFTableCell></XFTableRow> }</XFTableBody></XFTable>;

    // ==================== HERO ====================
    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFTextInput Label="@T("Nome do cliente", "Client name")"
                     Value="@_basicValue"
                     ValueChanged="@(v => _basicValue = v)"
                     Placeholder="@T("Ex: Empresa ABC Ltda", "Ex: ABC Company Ltd")"
                     HelperText="@T("Usado em buscas e identificacao visual.", "Used for search and visual identification.")"
                     Clearable="true" />
    </XFStack>;

    // ==================== 1. BASIC ====================
    private RenderFragment ExBasic() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFTextInput Label="@T("Nome completo", "Full name")"
                     Value="@_basicValue"
                     ValueChanged="@(v => _basicValue = v)"
                     Placeholder="@T("Digite o nome completo", "Enter full name")"
                     HelperText="@T("Conforme documento de identidade.", "As per identity document.")" />
        <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">
            @T("Valor atual: ", "Current value: ") @(_basicValue ?? "-")
        </XFTypography>
    </XFStack>;

    // ==================== 2. VARIANTS ====================
    private RenderFragment ExVariants() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFTextInput Variant="XFFormVariant.Outline" Label="Outline (default)" Value="@_variantValue" ValueChanged="@(v => _variantValue = v)" Placeholder="@T("Variante Outline", "Outline variant")" />
        <XFTextInput Variant="XFFormVariant.Filled" Label="Filled" Value="@_variantValue" ValueChanged="@(v => _variantValue = v)" Placeholder="@T("Variante Filled", "Filled variant")" />
        <XFTextInput Variant="XFFormVariant.Soft" Label="Soft" Value="@_variantValue" ValueChanged="@(v => _variantValue = v)" Placeholder="@T("Variante Soft", "Soft variant")" />
        <XFTextInput Variant="XFFormVariant.Ghost" Label="Ghost" Value="@_variantValue" ValueChanged="@(v => _variantValue = v)" Placeholder="@T("Variante Ghost", "Ghost variant")" />
    </XFStack>;

    // ==================== 3. SIZES ====================
    private RenderFragment ExSizes() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFTextInput Size="XFSize.Sm" Label="Small (Sm)" Value="@_sizeValue" ValueChanged="@(v => _sizeValue = v)" Placeholder="36px height" />
        <XFTextInput Size="XFSize.Md" Label="Medium (Md, default)" Value="@_sizeValue" ValueChanged="@(v => _sizeValue = v)" Placeholder="40px height" />
        <XFTextInput Size="XFSize.Lg" Label="Large (Lg)" Value="@_sizeValue" ValueChanged="@(v => _sizeValue = v)" Placeholder="48px height" />
    </XFStack>;

    // ==================== 4. TYPES ====================
    private RenderFragment ExTypes() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFTextInput Type="XFTextInputType.Text" Label="Text (default)" Value="@_basicValue" Placeholder="@T("Texto livre", "Free text")" />
        <XFTextInput Type="XFTextInputType.Email" Label="Email" Value="@_emailValue" ValueChanged="@(v => _emailValue = v)" Placeholder="email@empresa.com" />
        <XFTextInput Type="XFTextInputType.Password" Label="Password" Value="@_passwordValue" ValueChanged="@(v => _passwordValue = v)" Placeholder="@T("Senha", "Password")" />
        <XFTextInput Type="XFTextInputType.Search" Label="Search" Value="@_searchValue" ValueChanged="@(v => _searchValue = v)" Placeholder="@T("Buscar...", "Search...")" />
        <XFTextInput Type="XFTextInputType.Tel" Label="Tel" Value="@_telValue" ValueChanged="@(v => _telValue = v)" Placeholder="(11) 99999-0000" />
        <XFTextInput Type="XFTextInputType.Url" Label="Url" Value="@_urlValue" ValueChanged="@(v => _urlValue = v)" Placeholder="https://exemplo.com" />
    </XFStack>;

    // ==================== 5. ADORNMENTS ====================
    private RenderFragment ExAdornments() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFTextInput Label="StartIcon + EndIcon" Value="@_basicValue" PrefixText="" SuffixText="">
            <StartIcon><span class="text-sm" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize("user", 16))</span></StartIcon>
            <EndIcon><span class="text-sm" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize("check", 16))</span></EndIcon>
        </XFTextInput>
        <XFTextInput Label="PrefixText" PrefixText="R$" Value="@_prefixValue" ValueChanged="@(v => _prefixValue = v)" Placeholder="0.00" />
        <XFTextInput Label="SuffixText" SuffixText="kg" Value="@_suffixValue" ValueChanged="@(v => _suffixValue = v)" Placeholder="@T("Peso", "Weight")" />
    </XFStack>;

    // ==================== 6. CLEARABLE ====================
    private RenderFragment ExClearable() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFTextInput Label="@T("Campo limpo", "Clearable field")"
                     Value="@_clearableValue"
                     ValueChanged="@(v => _clearableValue = v)"
                     Placeholder="@T("Digite e limpe", "Type and clear")"
                     Clearable="true"
                     ClearLabel="@T("Limpar campo", "Clear field")"
                     HelperText="@T("Clique no X para limpar.", "Click X to clear.")" />
        <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">
            @T("Valor: ", "Value: ") @(_clearableValue ?? "-")
        </XFTypography>
    </XFStack>;

    // ==================== 7. FLOATING LABEL ====================
    private RenderFragment ExFloatingLabel() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFTextInput FloatingLabel="true"
                     Label="@T("Razao social", "Company name")"
                     Value="@_floatingValue"
                     ValueChanged="@(v => _floatingValue = v)"
                     HelperText="@T("Label flutua ao focar.", "Label floats on focus.")" />
    </XFStack>;

    // ==================== 8. STATES ====================
    private RenderFragment ExStates() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFTextInput Label="@T("Desabilitado", "Disabled")" Value="@_disabledValue" Disabled="true" HelperText="@T("Campo desabilitado.", "Disabled field.")" />
        <XFTextInput Label="@T("Somente leitura", "Read only")" Value="@_readonlyValue" ReadOnly="true" HelperText="@T("Campo somente leitura.", "Read-only field.")" />
        <XFTextInput Label="@T("Obrigatorio", "Required")" Value="@_basicValue" Required="true" HelperText="@T("Campo obrigatorio com asterisco.", "Required field with asterisk.")" />
    </XFStack>;

    // ==================== 9. IMMEDIATE + DEBOUNCE ====================
    private RenderFragment ExImmediate() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFTextInput Label="@T("Busca com debounce (400ms)", "Search with debounce (400ms)")"
                     Value="@_immediateValue"
                      ValueChanged="@(v => _immediateValue = v)"
                     Immediate="true"
                     DebounceMilliseconds="400"
                     Placeholder="@T("Digite para buscar...", "Type to search...")"
                     HelperText="@T("Valor atualizado a cada 400ms.", "Value updated every 400ms.")" />
        <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">
            @T("Valor: ", "Value: ") @(_immediateValue ?? "-")
        </XFTypography>
    </XFStack>;

    // ==================== 10. VALIDATION ====================
    private RenderFragment ExValidation() => @<div>
        <EditForm EditContext="@_editContext" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />
            <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                <XFTextInput Label="@T("Nome do produto", "Product name")" @bind-Value="_formModel.ProductName" />
                <XFTextInput Label="@T("Codigo SKU", "SKU code")" @bind-Value="_formModel.SkuCode" />
