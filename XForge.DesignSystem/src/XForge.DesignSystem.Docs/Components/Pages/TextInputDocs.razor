    private RenderFragment ExEnterprise() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@T("Cadastro de cliente", "Customer registration")</XFTypography>
        <div class="grid gap-4 md:grid-cols-2">
            <XFTextInput Label="@T("Razao social", "Company name")" Value="@_enterpriseName" ValueChanged="@(v => _enterpriseName = v)" Required="true" Variant="XFFormVariant.Soft" Tone="XFSemanticColor.Primary" />
            <XFTextInput Label="Email" Type="XFTextInputType.Email" Value="@_enterpriseEmail" ValueChanged="@(v => _enterpriseEmail = v)" Required="true" Variant="XFFormVariant.Soft" Tone="XFSemanticColor.Primary" />
            <XFTextInput Label="@T("Telefone", "Phone")" Type="XFTextInputType.Tel" Value="@_enterprisePhone" ValueChanged="@(v => _enterprisePhone = v)" Variant="XFFormVariant.Soft" Tone="XFSemanticColor.Primary" />
            <XFTextInput Label="CNPJ" Value="@_enterpriseDocument" ValueChanged="@(v => _enterpriseDocument = v)" Placeholder="00.000.000/0000-00" Variant="XFFormVariant.Soft" Tone="XFSemanticColor.Primary" />
        </div>
    </XFStack>;

