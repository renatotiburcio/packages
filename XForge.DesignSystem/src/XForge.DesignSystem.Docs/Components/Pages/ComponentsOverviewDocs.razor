@page "/components/overview"
@using XForge.DesignSystem.Core.Primitives
@inject XForgeDocsLanguageService Language

<XForgeDocsShell ProductLabel="@T("Core Open Source", "Core Open Source")" Title="@T("Visao geral de Components", "Components Overview")" Status="@T("Padrao de categoria", "Category standard")" Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <div class="grid gap-6">
                    <div class="flex flex-wrap gap-2">
                        <XFBadge Text="@T("Primitivas de componente", "Component primitives")" Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" />
                        <XFBadge Text="@T("Base OSS", "OSS foundation")" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" />
                        <XFBadge Text="@T("DesignSystem primeiro", "DesignSystem-first")" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" />
                    </div>

                    <div class="grid gap-2">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Componentes-base para construir interfaces enterprise consistentes, acessiveis e reutilizaveis.",
                               "Base components for building consistent, accessible and reusable enterprise interfaces.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("A categoria Components representa a fundacao visual do XForge DesignSystem: acoes, marcadores, conteineres, iconografia, tipografia e pequenos blocos de composicao usados por todas as outras categorias. Ela existe para evitar duplicacao local e manter um contrato unico para produtos OSS, docs, playgrounds e aplicacoes ERP.",
                               "The Components category represents the visual foundation of XForge DesignSystem: actions, markers, containers, iconography, typography and small composition blocks used by every other category. It exists to avoid local duplication and keep a single contract for OSS products, docs, playgrounds and ERP applications.")
                        </XFTypography>
                    </div>

                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @FoundationPreview()
                        </div>
                        <div class="grid gap-3">
                            @foreach (var item in HeroFacts)
                            {
                                <XForgeCategoryOverviewTile Item="item" />
                            }
                        </div>
                    </div>
                </div>
            </ChildContent>
        </XFCard>

        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
            <Header><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">Blazor Server e Blazor WebAssembly</XFTypography></Header>
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                    <XFTable Striped="true" Hoverable="true" Compact="true">
                        <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                        <XFTableBody>
                            <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                            <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                            <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                            <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico. Interacoes requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                        </XFTableBody>
                    </XFTable>
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderizacao.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
                </XFStack>
            </ChildContent>
        </XFCard>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewSection Title="@T("Visao geral", "Overview")" Items="OverviewGoals" Columns="2" />
            <XForgeCategoryOverviewSection Title="@T("Filosofia", "Philosophy")" Items="Philosophy" Columns="2" />
            <XForgeCategoryOverviewSection Title="@T("Objetivos da categoria", "Category Objectives")" Items="Objectives" Columns="3" />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewComponentTable Rows="ComponentRows"
                                                  Description="@T("Componentes-base devem ser pequenos, previsiveis e seguros para composicao em outros componentes.",
                                                                  "Base components must be small, predictable and safe to compose into other components.")" />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewSection Title="@T("Linguagem visual", "Visual Language")" Items="VisualLanguage" Columns="3" />
            <XForgeCategoryOverviewSection Title="@T("Padroes de UX", "UX Standards")" Items="UxStandards" Columns="2" />
            <XForgeCategoryOverviewSection Title="@T("Padroes de acessibilidade", "Accessibility Standards")" Items="AccessibilityStandards" Columns="2" />
            <XForgeCategoryOverviewSection Title="@T("Padroes de responsividade", "Responsiveness Standards")" Items="ResponsiveStandards" Columns="2" />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewSection Title="@T("Padroes de tema", "Theme Standards")" Items="ThemeStandards" Columns="2" />
            <XForgeCategoryOverviewNameDescriptionTable Title="@T("Design Tokens", "Design Tokens")" NameHeader="@T("Grupo de token", "Token Group")" DescriptionHeader="@T("Proposito", "Purpose")" Rows="TokenRows" CodeName="true" />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewSection Title="@T("Padroes comuns", "Common Patterns")" Items="CommonPatterns" Columns="3" />
            <XForgeCategoryOverviewSection Title="@T("Cenarios enterprise", "Enterprise Scenarios")" Items="EnterpriseScenarios" Columns="3" />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewExampleGallery Examples="Examples" />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewSection Title="@T("Padroes de documentacao", "Documentation Standards")" Items="DocumentationStandards" Columns="2" />
            <XForgeCategoryOverviewSection Title="@T("Anti-patterns", "Anti-patterns")" Items="AntiPatterns" Columns="2" />
            <XForgeCategoryOverviewSection Title="@T("Guia de migracao", "Migration Guidance")" Items="MigrationGuidance" Columns="2" />
            <XForgeCategoryOverviewSection Title="@T("Boas praticas", "Best Practices")" Items="BestPractices" Columns="2" />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewNameDescriptionTable Title="@T("Categorias relacionadas", "Related Categories")" NameHeader="@T("Categoria", "Category")" DescriptionHeader="@T("Relacao", "Relationship")" Rows="RelatedCategories" />
        </XFStack>
    </XFStack>

    <XForgeDocsPageStandard ComponentName="ComponentsOverviewDocs" IsOverview="true" />
</XForgeDocsShell>

@code {
    private string T(string ptBr, string enUs) => Language.Text(ptBr, enUs);

    private RenderFragment FoundationPreview() => @<div class="grid gap-4">
        <div class="flex flex-wrap items-center gap-3">
            <XFButton Text="@T("Salvar", "Save")" Color="XFButtonColor.Primary" />
            <XFButton Text="@T("Cancelar", "Cancel")" Variant="XFButtonVariant.Outline" Color="XFButtonColor.Neutral" />
            <XFButton Text="@T("Processando", "Processing")" Loading="true" LoadingText="@T("Processando", "Processing")" />
        </div>
        <div class="grid gap-3 md:grid-cols-3">
            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
                <ChildContent>
                    <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">Workflow</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Aprovacao fiscal", "Tax approval")</XFTypography>
                    <div class="mt-3 flex flex-wrap gap-2">
                        <XFBadge Text="@T("Novo", "New")" Color="XFBadgeColor.Primary" />
                        <XFChip Tone="XFSemanticColor.Warning" Variant="XFChipVariant.Soft" Size="XFSize.Sm">@T("Prioridade alta", "High priority")</XFChip>
                    </div>
                </ChildContent>
            </XFCard>
            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
                <ChildContent>
                    <XFAvatar Name="Marina Costa" Size="XFAvatarSize.Md" />
                    <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">Marina Costa</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@T("Responsavel pelo fechamento.", "Responsible for period close.")</XFTypography>
                </ChildContent>
            </XFCard>
            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
                <ChildContent>
                    <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-[color-mix(in_oklab,var(--color-primary)_10%,transparent)] text-primary">
                        @XFSvgIcons.MarkupWithSize("sparkles", 18)
                    </div>
                    <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">Token driven</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@T("Cores e estados seguem o tema ativo.", "Colors and states follow the active theme.")</XFTypography>
                </ChildContent>
            </XFCard>
        </div>
    </div>;

    private RenderFragment ActionPreview() => @<div class="flex flex-wrap gap-3">
        <XFButton Text="@T("Criar pedido", "Create order")" Color="XFButtonColor.Primary" />
        <XFButton Text="@T("Exportar", "Export")" Variant="XFButtonVariant.Outline" Color="XFButtonColor.Secondary" />
        <XFButton Text="@T("Excluir", "Delete")" Variant="XFButtonVariant.Ghost" Color="XFButtonColor.Danger" />
    </div>;

    private RenderFragment IdentityPreview() => @<div class="grid gap-3 md:grid-cols-2">
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
            <ChildContent>
                <div class="flex items-center gap-3">
                    <XFAvatar Name="Ana Lima" Status="XFAvatarStatus.Online" />
                    <div>
                        <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">Ana Lima</XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@T("Aprovadora financeira", "Financial approver")</XFTypography>
                    </div>
                </div>
            </ChildContent>
        </XFCard>
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
            <ChildContent>
                <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">NF-e 94381</XFTypography>
                <div class="mt-3 flex flex-wrap gap-2">
                    <XFBadge Text="@T("Pendente", "Pending")" Color="XFBadgeColor.Warning" />
                    <XFChip Tone="XFSemanticColor.Info" Variant="XFChipVariant.Soft" Size="XFSize.Sm">@T("Validacao fiscal", "Tax validation")</XFChip>
                </div>
            </ChildContent>
        </XFCard>
    </div>;

    private RenderFragment TokenPreview() => @<div class="grid gap-3 md:grid-cols-3">
        <XFCard Variant="XFCardVariant.Outlined" Tone="XFSemanticColor.Primary" Padding="XFPadding.Lg"><ChildContent><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">Primary action</XFTypography><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@T("Acoes principais.", "Primary actions.")</XFTypography></ChildContent></XFCard>
        <XFCard Variant="XFCardVariant.Outlined" Tone="XFSemanticColor.Warning" Padding="XFPadding.Lg"><ChildContent><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">Warning state</XFTypography><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@T("Atencao operacional.", "Operational attention.")</XFTypography></ChildContent></XFCard>
        <XFCard Variant="XFCardVariant.Outlined" Tone="XFSemanticColor.Success" Padding="XFPadding.Lg"><ChildContent><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">Success state</XFTypography><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@T("Conclusao segura.", "Safe completion.")</XFTypography></ChildContent></XFCard>
    </div>;

    private IReadOnlyList<XForgeCategoryOverviewExample> Examples => [
        new(T("Barra de acoes", "Action bar"), T("Acoes primarias e secundarias com hierarquia clara.", "Primary and secondary actions with clear hierarchy."), ActionPreview(), ActionCode),
        new(T("Identidade e status", "Identity and status"), T("Avatar, badge e chip para contexto humano e operacional.", "Avatar, badge and chip for human and operational context."), IdentityPreview(), IdentityCode),
        new(T("Variacoes de token", "Token variations"), T("Cards base respondendo aos tons do tema.", "Base cards responding to theme tones."), TokenPreview(), TokenCode),
        new(T("Composicao foundation", "Foundation composition"), T("Composicao base de card, botao, avatar, chip, badge e icone.", "Base composition with card, button, avatar, chip, badge and icon."), FoundationPreview(), FoundationCode)
    ];

    private IReadOnlyList<XForgeCategoryOverviewItem> HeroFacts => [
        new(T("Base OSS", "OSS base"), T("Define primitivas reutilizaveis usadas por Forms, Display, Feedback e Layout.", "Defines reusable primitives used by Forms, Display, Feedback and Layout."), "cube"),
        new(T("Consistencia", "Consistency"), T("Centraliza interacao, foco, densidade, estados e temas.", "Centralizes interaction, focus, density, states and themes."), "swatchbook"),
        new(T("Governanca", "Governance"), T("Impede HTML/CSS local quando existe componente XForge equivalente.", "Prevents local HTML/CSS when an equivalent XForge component exists."), "shield-check")
    ];

    private IReadOnlyList<XForgeCategoryOverviewItem> OverviewGoals => [
        Item("Representa primitivas", "Represents primitives", "Agrupa componentes menores que formam a base de interfaces XForge.", "Groups smaller components that form the foundation of XForge interfaces.", "grid-2"),
        Item("Existe para reduzir variacao", "Exists to reduce variation", "Evita botoes, badges, cards e icones inconsistentes entre produtos.", "Avoids inconsistent buttons, badges, cards and icons across products.", "arrows-minimize"),
        Item("Objetivo de UX", "UX goal", "Criar leitura e acao previsiveis em qualquer modulo enterprise.", "Create predictable reading and actions in any enterprise module.", "arrow-pointer"),
        Item("Objetivo de arquitetura", "Architecture goal", "Fornecer contratos pequenos, compostos e seguros para reuso.", "Provide small, composable and safe contracts for reuse.", "share-nodes"),
        Item("Objetivo de acessibilidade", "Accessibility goal", "Foco visivel, nomes acessiveis e estados semanticos por padrao.", "Visible focus, accessible names and semantic states by default.", "universal-access"),
        Item("Objetivo de performance", "Performance goal", "Componentes leves, sem dependencias desnecessarias e com classes estaveis.", "Lightweight components with no unnecessary dependencies and stable classes.", "bolt")
    ];

    private IReadOnlyList<XForgeCategoryOverviewItem> Philosophy => [
        Item("Pequeno e composable", "Small and composable", "Cada componente resolve uma responsabilidade clara.", "Each component solves one clear responsibility.", "cube"),
        Item("Design token first", "Design token first", "Cores, spacing, radius e motion devem vir de tokens.", "Colors, spacing, radius and motion must come from tokens.", "swatchbook"),
        Item("Acessivel antes de bonito", "Accessible before beautiful", "A UI so esta pronta quando teclado e leitor de tela funcionam.", "The UI is only ready when keyboard and screen reader work.", "shield-check"),
        Item("Responsivo por padrao", "Responsive by default", "Primitivas nao devem quebrar quando usadas em grids, cards ou toolbars.", "Primitives must not break when used in grids, cards or toolbars.", "mobile-screen")
    ];

    private IReadOnlyList<XForgeCategoryOverviewItem> Objectives => [
        Item("Padronizacao", "Standardization", "Um unico jeito de renderizar acoes, status, conteineres e icones.", "One way to render actions, status, containers and icons.", "check"),
        Item("Reuso", "Reusability", "Primitivas compoem paginas, docs, playgrounds e componentes maiores.", "Primitives compose pages, docs, playgrounds and larger components.", "arrows-rotate"),
        Item("Escala", "Scalability", "Novos produtos reutilizam o mesmo contrato visual.", "New products reuse the same visual contract.", "chart-line-up"),
        Item("Manutencao", "Maintainability", "Menos CSS local e menos variantes inventadas por modulo.", "Less local CSS and fewer module-specific invented variants.", "wrench"),
        Item("Workflow", "Workflow", "Apoiar fluxos ERP com acoes claras e status rastreavel.", "Support ERP flows with clear actions and traceable status.", "route"),
        Item("Open source", "Open source", "Manter a base livre, auditavel e extensivel.", "Keep the foundation free, auditable and extensible.", "code")
    ];

    private IReadOnlyList<XForgeCategoryOverviewComponentRow> ComponentRows => [
        Row("XFButton", "Acao clicavel com tons, variantes e loading.", "Clickable action with tones, variants and loading.", "Executar comandos.", "Execute commands.", "Salvar, cancelar, aprovar e excluir.", "Save, cancel, approve and delete.", "High", "Medium"),
        Row("XFSplitButton", "Acao principal com menu de alternativas.", "Primary action with an alternatives menu.", "Escolher variacao de comando.", "Choose a command variation.", "Salvar, salvar e fechar, salvar como rascunho.", "Save, save and close, save as draft.", "High", "High"),
        Row("XFFAB", "Acao flutuante contextual.", "Contextual floating action.", "Criar item rapidamente.", "Create an item quickly.", "Nova venda, novo chamado, nova tarefa.", "New sale, new ticket, new task.", "Medium", "Medium"),
        Row("XFIcon", "Renderizacao padronizada de iconografia.", "Standardized icon rendering.", "Mostrar simbolo visual.", "Show a visual symbol.", "Acoes, status e navegacao.", "Actions, status and navigation.", "Medium", "Low"),
        Row("XFBadge", "Marcador compacto de status.", "Compact status marker.", "Exibir estado ou classificacao.", "Show state or classification.", "SLA, risco, fiscal, status de pedido.", "SLA, risk, tax, order status.", "Medium", "Low"),
