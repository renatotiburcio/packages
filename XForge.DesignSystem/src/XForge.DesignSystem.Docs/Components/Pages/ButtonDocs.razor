@page "/components/button"
@page "/components/buttons"
@using XForge.DesignSystem.Core.Primitives
@using XForge.DesignSystem.Components.Button

@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFButton" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("6 Variantes", "6 Variants")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Enterprise", "Enterprise")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Botao semantico, acessivel e enterprise-ready para Blazor.", "Semantic, accessible and enterprise-ready button for Blazor.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("6 variantes, 7 cores, 5 tamanhos, 4 formas, loading, ICommand, form state, icon-only e full width.",
                               "6 variants, 7 colors, 5 sizes, 4 shapes, loading, ICommand, form state, icon-only and full width.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico. Interacoes requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderizacao.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Consideracoes", "Considerations")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor Server: eventos sao tratados via SignalR. Sem latencia adicional para componentes puramente renderizados.", "Blazor Server: events are handled via SignalR. No additional latency for purely rendered components.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor WebAssembly: eventos sao tratados diretamente no cliente. Mais responsivo.", "Blazor WebAssembly: events are handled directly on the client. More responsive.")</XFTypography>
                </XFStack>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Basico", "1. Basic"), T("Padrao CRUD: Salvar, Cancelar e Ver detalhes.", "CRUD pattern: Save, Cancel and View details."), ExBasic(), CodeBasic)
            @Example(T("2. Tamanhos", "2. Sizes"), T("5 tamanhos explicitos: Xs, Sm, Md, Lg, Xl.", "5 explicit sizes: Xs, Sm, Md, Lg, Xl."), ExSizes(), CodeSizes)
            @Example(T("3. Cores", "3. Colors"), T("7 cores semanticas em Solid e Soft.", "7 semantic colors in Solid and Soft."), ExColors(), CodeColors)
            @Example(T("4. Formas", "4. Shapes"), T("Auto, Rounded, Square e Circle.", "Auto, Rounded, Square and Circle."), ExShapes(), CodeShapes)
            @Example(T("5. Variantes", "5. Variants"), T("Solid, Outline, Ghost, Soft, Subtle e Link.", "Solid, Outline, Ghost, Soft, Subtle and Link."), ExVariants(), CodeVariants)
            @Example(T("6. Variantes de container", "6. Container variants"), T("Toolbar, card footer e dialog footer.", "Toolbar, card footer and dialog footer."), ExContainerVariants(), CodeContainerVariants)
            @Example(T("7. Densidade", "7. Density"), T("Gap 1 denso, Gap 3 normal, Gap 4 espacoso.", "Gap 1 dense, Gap 3 normal, Gap 4 spacious."), ExDensity(), CodeDensity)
            @Example(T("8. Comportamento", "8. Behavior"), T("Loading, Disabled, Active, Pressed e icon-only.", "Loading, Disabled, Active, Pressed and icon-only."), ExBehavior(), CodeBehavior)
            @Example(T("9. Templates", "9. Templates"), T("StartIcon, EndIcon, ambos, ChildContent e LoadingContent custom.", "StartIcon, EndIcon, both, ChildContent and custom LoadingContent."), ExTemplates(), CodeTemplates)
            @Example(T("10. Feature toggles", "10. Feature toggles"), T("FullWidth, type Submit, Reset e form externo.", "FullWidth, Submit type, Reset and external form."), ExFeatureToggles(), CodeFeatureToggles)
            @Example(T("11. Responsivo", "11. Responsive"), T("Mobile stacked, desktop inline, auto-wrapping.", "Mobile stacked, desktop inline, auto-wrapping."), ExResponsive(), CodeResponsive)
            @Example(T("12. Cenario enterprise", "12. Enterprise scenario"), T("Aprovacao de NF-e com dados ERP reais.", "NF-e approval with real ERP data."), ExEnterprise(), CodeEnterprise)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string ProductLabelText => T("Core Open Source", "Core Open Source");
    private string PageTitleText => T("Button", "Button");
    private string PageStatusText => T("Documentacao completa", "Complete docs");
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");

    private RenderFragment HeroPreview() => @<div class="flex flex-col gap-4">
        <div class="flex flex-wrap gap-3">
            <XFButton Text="@T("Salvar pedido", "Save order")" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Md">
                <StartIcon>@XFSvgIcons.MarkupWithSize("floppy-disk", 16)</StartIcon>
            </XFButton>
            <XFButton Text="@T("Enviar para aprovacao", "Send for approval")" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Success" Size="XFExtendedSize.Md">
                <StartIcon>@XFSvgIcons.MarkupWithSize("paper-plane", 16)</StartIcon>
            </XFButton>
            <XFButton Text="@T("Cancelar", "Cancel")" Variant="XFButtonVariant.Outline" Color="XFButtonColor.Neutral" Size="XFExtendedSize.Md" />
        </div>
        <div class="grid gap-3 sm:grid-cols-3">
            <div class="rounded-lg border border-border-light bg-bg-surface p-4">
                <div class="flex items-center gap-2 mb-2">
                    <span class="inline-flex h-6 w-6 items-center justify-center rounded bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize("file-invoice", 12))</span>
                    <XFTypography Variant="XFTypographyVariant.Caption" Weight="XFTypographyWeight.Semibold">@T("Workflow NF-e 94381", "Workflow NF-e 94381")</XFTypography>
                </div>
                <XFButton Text="@T("Aprovar", "Approve")" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Success" Size="XFExtendedSize.Md" FullWidth="true">
                    <StartIcon>@XFSvgIcons.MarkupWithSize("circle-check", 14)</StartIcon>
                </XFButton>
            </div>
            <div class="rounded-lg border border-border-light bg-bg-surface p-4">
                <div class="flex items-center gap-2 mb-2">
                    <span class="inline-flex h-6 w-6 items-center justify-center rounded bg-warning/10 text-warning" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize("money-bill", 12))</span>
                    <XFTypography Variant="XFTypographyVariant.Caption" Weight="XFTypographyWeight.Semibold">@T("Financeiro R$ 84,2k", "Finance R$ 84.2k")</XFTypography>
                </div>
                <XFButton Text="@T("Processando...", "Processing...")" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Warning" Size="XFExtendedSize.Md" FullWidth="true" Loading="true" />
            </div>
            <div class="rounded-lg border border-border-light bg-bg-surface p-4">
                <div class="flex items-center gap-2 mb-2">
                    <span class="inline-flex h-6 w-6 items-center justify-center rounded bg-danger/10 text-danger" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize("triangle-exclamation", 12))</span>
                    <XFTypography Variant="XFTypographyVariant.Caption" Weight="XFTypographyWeight.Semibold">@T("Risco Alto", "High Risk")</XFTypography>
                </div>
                <XFButton Text="@T("Bloquear", "Block")" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Danger" Size="XFExtendedSize.Md" FullWidth="true">
                    <StartIcon>@XFSvgIcons.MarkupWithSize("ban", 14)</StartIcon>
                </XFButton>
            </div>
        </div>
    </div>;

    private RenderFragment ExBasic() => @<div class="flex flex-wrap gap-3">
        <XFButton Text="@T("Salvar", "Save")" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Md">
            <StartIcon>@XFSvgIcons.MarkupWithSize("floppy-disk", 16)</StartIcon>
        </XFButton>
        <XFButton Text="@T("Cancelar", "Cancel")" Variant="XFButtonVariant.Outline" Color="XFButtonColor.Neutral" Size="XFExtendedSize.Md" />
        <XFButton Text="@T("Ver detalhes", "View details")" Variant="XFButtonVariant.Ghost" Color="XFButtonColor.Primary" Size="XFExtendedSize.Md">
            <EndIcon>@XFSvgIcons.MarkupWithSize("chevron-right", 14)</EndIcon>
        </XFButton>
    </div>;

    private RenderFragment ExSizes() => @<div class="flex flex-col gap-5">
        <div class="flex flex-col gap-2">
            <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="Xs" />
            <div class="flex flex-wrap items-center gap-2">
                <XFButton Text="Xs" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Xs" />
                <XFButton Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Xs"  AriaLabel="@T("Adicionar", "Add")">
                    <StartIcon>@XFSvgIcons.MarkupWithSize("plus", 12)</StartIcon>
                </XFButton>
                <XFButton Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Xs" Shape="XFButtonShape.Circle"  AriaLabel="@T("Mais", "More")">
                    <StartIcon>@XFSvgIcons.MarkupWithSize("ellipsis", 12)</StartIcon>
                </XFButton>
            </div>
        </div>
        <div class="flex flex-col gap-2">
            <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="Sm" />
            <div class="flex flex-wrap items-center gap-2">
                <XFButton Text="Sm" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Sm" />
                <XFButton Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Sm"  AriaLabel="@T("Adicionar", "Add")">
                    <StartIcon>@XFSvgIcons.MarkupWithSize("plus", 14)</StartIcon>
                </XFButton>
                <XFButton Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Sm" Shape="XFButtonShape.Circle"  AriaLabel="@T("Mais", "More")">
                    <StartIcon>@XFSvgIcons.MarkupWithSize("ellipsis", 14)</StartIcon>
                </XFButton>
            </div>
        </div>
        <div class="flex flex-col gap-2">
            <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="Md" />
            <div class="flex flex-wrap items-center gap-2">
                <XFButton Text="Md" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Md" />
                <XFButton Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Md"  AriaLabel="@T("Adicionar", "Add")">
                    <StartIcon>@XFSvgIcons.MarkupWithSize("plus", 16)</StartIcon>
                </XFButton>
                <XFButton Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Md" Shape="XFButtonShape.Circle"  AriaLabel="@T("Mais", "More")">
                    <StartIcon>@XFSvgIcons.MarkupWithSize("ellipsis", 16)</StartIcon>
                </XFButton>
            </div>
        </div>
        <div class="flex flex-col gap-2">
            <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="Lg" />
            <div class="flex flex-wrap items-center gap-2">
                <XFButton Text="Lg" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Lg" />
                <XFButton Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Lg"  AriaLabel="@T("Adicionar", "Add")">
                    <StartIcon>@XFSvgIcons.MarkupWithSize("plus", 18)</StartIcon>
                </XFButton>
                <XFButton Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Lg" Shape="XFButtonShape.Circle"  AriaLabel="@T("Mais", "More")">
                    <StartIcon>@XFSvgIcons.MarkupWithSize("ellipsis", 18)</StartIcon>
                </XFButton>
            </div>
        </div>
        <div class="flex flex-col gap-2">
            <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="Xl" />
            <div class="flex flex-wrap items-center gap-2">
                <XFButton Text="Xl" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Xl" />
                <XFButton Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Xl"  AriaLabel="@T("Adicionar", "Add")">
                    <StartIcon>@XFSvgIcons.MarkupWithSize("plus", 20)</StartIcon>
                </XFButton>
                <XFButton Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Xl" Shape="XFButtonShape.Circle"  AriaLabel="@T("Mais", "More")">
                    <StartIcon>@XFSvgIcons.MarkupWithSize("ellipsis", 20)</StartIcon>
                </XFButton>
            </div>
        </div>
    </div>;

    private RenderFragment ExColors() => @<div class="flex flex-col gap-5">
        <div class="flex flex-col gap-2">
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="Solid" />
            <div class="flex flex-wrap gap-2">
                <XFButton Text="Primary" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Md" />
                <XFButton Text="Secondary" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Secondary" Size="XFExtendedSize.Md" />
                <XFButton Text="Success" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Success" Size="XFExtendedSize.Md" />
                <XFButton Text="Warning" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Warning" Size="XFExtendedSize.Md" />
                <XFButton Text="Danger" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Danger" Size="XFExtendedSize.Md" />
                <XFButton Text="Neutral" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Neutral" Size="XFExtendedSize.Md" />
                <XFButton Text="Info" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Info" Size="XFExtendedSize.Md" />
            </div>
        </div>
        <div class="flex flex-col gap-2">
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="Soft" />
            <div class="flex flex-wrap gap-2">
                <XFButton Text="Primary" Variant="XFButtonVariant.Soft" Color="XFButtonColor.Primary" Size="XFExtendedSize.Md" />
                <XFButton Text="Secondary" Variant="XFButtonVariant.Soft" Color="XFButtonColor.Secondary" Size="XFExtendedSize.Md" />
                <XFButton Text="Success" Variant="XFButtonVariant.Soft" Color="XFButtonColor.Success" Size="XFExtendedSize.Md" />
                <XFButton Text="Warning" Variant="XFButtonVariant.Soft" Color="XFButtonColor.Warning" Size="XFExtendedSize.Md" />
                <XFButton Text="Danger" Variant="XFButtonVariant.Soft" Color="XFButtonColor.Danger" Size="XFExtendedSize.Md" />
                <XFButton Text="Neutral" Variant="XFButtonVariant.Soft" Color="XFButtonColor.Neutral" Size="XFExtendedSize.Md" />
                <XFButton Text="Info" Variant="XFButtonVariant.Soft" Color="XFButtonColor.Info" Size="XFExtendedSize.Md" />
            </div>
        </div>
    </div>;

    private RenderFragment ExShapes() => @<div class="flex flex-col gap-5">
        <div class="flex flex-col gap-2">
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="Auto" />
            <div class="flex flex-wrap items-center gap-2">
                <XFButton Text="Auto" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Md" Shape="XFButtonShape.Auto" />
                <XFButton Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Md" Shape="XFButtonShape.Auto"  AriaLabel="@T("Adicionar", "Add")">
                    <StartIcon>@XFSvgIcons.MarkupWithSize("plus", 16)</StartIcon>
                </XFButton>
            </div>
        </div>
        <div class="flex flex-col gap-2">
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="Rounded" />
            <div class="flex flex-wrap items-center gap-2">
                <XFButton Text="Rounded" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Md" Shape="XFButtonShape.Rounded" />
                <XFButton Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Md" Shape="XFButtonShape.Rounded"  AriaLabel="@T("Adicionar", "Add")">
                    <StartIcon>@XFSvgIcons.MarkupWithSize("plus", 16)</StartIcon>
                </XFButton>
            </div>
        </div>
        <div class="flex flex-col gap-2">
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="Square" />
            <div class="flex flex-wrap items-center gap-2">
                <XFButton Text="Square" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Md" Shape="XFButtonShape.Square" />
                <XFButton Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Md" Shape="XFButtonShape.Square"  AriaLabel="@T("Adicionar", "Add")">
                    <StartIcon>@XFSvgIcons.MarkupWithSize("plus", 16)</StartIcon>
                </XFButton>
