@page "/navigation/overview"
@inject XForgeDocsLanguageService LanguageService
@using XForge.DesignSystem.Core.Primitives


<XForgeDocsShell ProductLabel="Core Open Source" Title="Navigation Overview" Status="Category standard" Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Text="Navigation" Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Success" />
                        <XFBadge Text="Wayfinding" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" />
                        <XFBadge Text="Keyboard-first" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Primary" />
                    </XFStack>

                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            Oriente usuarios em jornadas enterprise sem perder contexto.
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            A categoria Navigation cobre breadcrumb, menu, tabs, toolbar, steps, pagination, accordion e TOC.
                            Ela existe para transformar rotas, categorias, filtros de pagina e progresso de tarefas em um contrato
                            acessivel, previsivel e performatico para docs, playgrounds, apps ERP e produtos AI.
                        </XFTypography>
                    </XFStack>

                    <XFGrid Cols="1" Gap="4" Class="lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in HeroFacts)
                            {
                                @InfoTile(item)
                            }
                        </XFStack>
                    </XFGrid>
                </XFStack>
            </ChildContent>
        </XFCard>

        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
            <Header><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">Blazor Server e Blazor WebAssembly</XFTypography></Header>
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                    <XFTable Striped="true" Hoverable="true" Compact="true">
                        <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                        <XFTableBody>
                            <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                            <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                            <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                            <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico. Interacoes requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                        </XFTableBody>
                    </XFTable>
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderizacao.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
                </XFStack>
            </ChildContent>
        </XFCard>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewSection Title="Overview" Items="OverviewItems" Columns="3" />
            <XForgeCategoryOverviewSection Title="Philosophy" Items="PhilosophyItems" />
            <XForgeCategoryOverviewSection Title="Category Objectives" Items="ObjectiveItems" Columns="3" />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewComponentTable Rows="ComponentRows"
                                                  Description="Componentes de Navigation controlam orientacao, troca de contexto, progresso, comandos locais e paginacao sem depender de markup local fragil." />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewSection Title="Visual Language" Items="VisualLanguageItems" Columns="3" />
            <XForgeCategoryOverviewSection Title="UX Standards" Items="UxStandardItems" Columns="3" />
            <XForgeCategoryOverviewSection Title="Accessibility Standards" Items="AccessibilityItems" />
            <XForgeCategoryOverviewSection Title="Responsiveness Standards" Items="ResponsiveItems" />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewSection Title="Theme Standards" Items="ThemeItems" />
            <XForgeCategoryOverviewNameDescriptionTable Title="Design Tokens"
                                                        NameHeader="Token Group"
                                                        DescriptionHeader="Purpose"
                                                        CodeName="true"
                                                        Rows="TokenRows" />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewSection Title="Common Patterns" Items="PatternItems" Columns="3" />
            <XForgeCategoryOverviewSection Title="Enterprise Scenarios" Items="ScenarioItems" Columns="3" />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewExampleGallery Examples="Examples" />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewSection Title="Documentation Standards" Items="DocumentationItems" Columns="3" />
            <XForgeCategoryOverviewSection Title="Anti-patterns" Items="AntiPatternItems" Columns="3" />
            <XForgeCategoryOverviewSection Title="Migration Guidance" Items="MigrationItems" Columns="3" />
            <XForgeCategoryOverviewSection Title="Best Practices" Items="BestPracticeItems" Columns="3" />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewNameDescriptionTable Title="Related Categories"
                                                        NameHeader="Category"
                                                        DescriptionHeader="Relationship"
                                                        Rows="RelatedCategories" />
        </XFStack>
    </XFStack>

    <XForgeDocsPageStandard ComponentName="NavigationOverviewDocs" IsOverview="true" />
</XForgeDocsShell>

@code {
    private string T(string pt, string en) => LanguageService.Text(pt, en);
    private IReadOnlyList<XForgeCategoryOverviewExample> Examples =>
    [
        new("Operational wayfinding", "Breadcrumb, tabs e steps mantem modulo, visao e etapa explicitos durante uma aprovacao fiscal.", WayfindingPreview(), WayfindingCode),
        new("Sidebar command surface", "Menu e toolbar separam navegacao persistente de comandos locais do workspace.", CommandSurfacePreview(), CommandSurfaceCode),
        new("Paged review queue", "Pagination e TOC tornam listas longas e documentos navegaveis sem perder foco.", PagedQueuePreview(), PagedQueueCode)
    ];

    private static RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFBreadcrumb Items="HeroBreadcrumbItems" Variant="XFContainerVariant.Surface" MaxVisibleItems="4" />

        <XFGrid Cols="1" Md="12" Gap="4">
            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg" Class="md:col-span-4">
                <ChildContent>
                    <XFMenu Items="HeroMenuItems" SelectedId="invoices" Variant="XFMenuVariant.Sidebar" AriaLabel="Menu financeiro" />
                </ChildContent>
            </XFCard>

            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg" Class="md:col-span-8">
                <ChildContent>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                        <XFToolbar Items="HeroToolbarItems" Variant="XFToolbarVariant.Soft" AriaLabel="Acoes da conciliacao" />
                        <XFSteps Items="HeroSteps" Variant="XFContainerVariant.Surface" Size="XFSize.Sm" />
                        <XFTabs ActiveId="pending" Variant="XFTabsVariant.Pills" FullWidth="true">
                            <Tabs>
                                <XFTab TabId="pending" Label="Pendentes" />
                                <XFTab TabId="approved" Label="Aprovadas" />
                                <XFTab TabId="history" Label="Historico" />
                            </Tabs>
                            <Panels>
                                <XFTabPanel TabId="pending">
                                    <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                                        <XFGrid Cols="1" Sm="3" Gap="3">
                                            <XFBadge Text="248 notas" Color="XFBadgeColor.Info" />
                                            <XFBadge Text="12 divergencias" Color="XFBadgeColor.Warning" />
                                            <XFBadge Text="3 bloqueios" Color="XFBadgeColor.Danger" />
                                        </XFGrid>
                                        <XFPagination Page="2" PageSize="25" TotalItems="248" ShowPageSize="false" Size="XFSize.Sm" />
                                    </XFStack>
                                </XFTabPanel>
                                <XFTabPanel TabId="approved">Itens aprovados no periodo.</XFTabPanel>
                                <XFTabPanel TabId="history">Historico auditavel de navegacao.</XFTabPanel>
                            </Panels>
                        </XFTabs>
                    </XFStack>
                </ChildContent>
            </XFCard>
        </XFGrid>
    </XFStack>;

    private static RenderFragment WayfindingPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFBreadcrumb Items="ExampleBreadcrumbItems" Variant="XFContainerVariant.Surface" MaxVisibleItems="4" />
        <XFSteps Items="ApprovalSteps" Variant="XFContainerVariant.Surface" />
        <XFTabs ActiveId="documents" Variant="XFTabsVariant.Enclosed">
            <Tabs>
                <XFTab TabId="documents" Label="Documentos" />
                <XFTab TabId="audit" Label="Auditoria" />
            </Tabs>
            <Panels>
                <XFTabPanel TabId="documents">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Text="NF-e 94381" Color="XFBadgeColor.Info" />
                        <XFBadge Text="Validacao fiscal" Color="XFBadgeColor.Warning" />
                    </XFStack>
                </XFTabPanel>
                <XFTabPanel TabId="audit">Eventos de navegacao e decisao.</XFTabPanel>
            </Panels>
        </XFTabs>
    </XFStack>;

    private static RenderFragment CommandSurfacePreview() => @<XFGrid Cols="1" Md="12" Gap="4">
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg" Class="md:col-span-4">
            <ChildContent>
                <XFMenu Items="WorkspaceMenuItems" SelectedId="orders" Variant="XFMenuVariant.Sidebar" AriaLabel="Menu operacional" />
            </ChildContent>
        </XFCard>
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg" Class="md:col-span-8">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                    <XFToolbar Items="WorkspaceToolbarItems" EndItems="WorkspaceToolbarEndItems" Variant="XFToolbarVariant.Bordered" AriaLabel="Comandos do pedido" />
                    <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">Pedido 2048</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">
                        A barra de comandos opera o contexto selecionado sem substituir a navegacao principal.
                    </XFTypography>
                </XFStack>
            </ChildContent>
        </XFCard>
    </XFGrid>;

    private static RenderFragment PagedQueuePreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFGrid Cols="1" Md="3" Gap="3">
            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
                <ChildContent>
                    <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">Fila</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">248</XFTypography>
                </ChildContent>
            </XFCard>
            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
                <ChildContent>
                    <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">Pagina</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">2/10</XFTypography>
                </ChildContent>
            </XFCard>
            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
                <ChildContent>
                    <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">Secao</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">Fiscal</XFTypography>
                </ChildContent>
            </XFCard>
        </XFGrid>
        <XFPagination Page="2" PageSize="25" TotalItems="248" ShowPageSize="true" PageSizeOptions="PageSizes" AllowReload="true" />
    </XFStack>;

