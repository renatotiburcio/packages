@page "/forms/color-input"

@using XForge.DesignSystem.Core.Primitives
@using Microsoft.AspNetCore.Components.Forms
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@T("Core Open Source", "Core Open Source")"
                 Title="ColorInput"
                 Status="@T("Documentacao completa", "Complete docs")"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFColorInput" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Hex Input", "Hex Input")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Paleta", "Palette")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Clearable", "Clearable")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Input de cor hexadecimal com paleta, validacao e integracao com formulario.", "Hexadecimal color input with palette, validation and form integration.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("XFColorInput e o campo especializado para selecao de cores hexadecimais com preview nativo, paleta de amostras e integracao com EditForm.", "XFColorInput is the specialized field for hexadecimal color selection with native preview, sample palette and EditForm integration.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts)
                            {
                                @Tile(item)
                            }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico. Interacoes requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderizacao.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Consideracoes", "Considerations")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor Server: eventos sao tratados via SignalR. Sem latencia adicional para componentes puramente renderizados.", "Blazor Server: events are handled via SignalR. No additional latency for purely rendered components.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor WebAssembly: eventos sao tratados diretamente no cliente. Mais responsivo.", "Blazor WebAssembly: events are handled directly on the client. More responsive.")</XFTypography>
                </XFStack>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Hierarquia visual", "Visual Hierarchy"), @<div>@TileGrid(VisualHierarchyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                        @Example(T("Preview basico", "Basic Preview"),
                T("Input de cor com preview e paleta.", "Color input with preview and palette."),
                HeroPreview(), BasicCode)
            @Example(T("Variantes e tons", "Variants and Tones"),
                T("Outline, Filled, Soft e Ghost.", "Outline, Filled, Soft and Ghost."),
                VariantsPreview(), VariantsCode)
            @Example(T("Cenarios enterprise", "Enterprise Scenarios"),
                T("Configuracao de tema e cores de categoria.", "Theme and category colors."),
                EnterprisePreview(), EnterpriseCode)
            @Example(T("Paleta interativa", "Interactive Palette"),
                T("Swatches que trocam a cor do input.", "Swatches that change input color."),
                PalettePreview(), PaletteCode)
            @Example(T("Tamanho dos swatches", "Swatch Sizes"),
                T("Sm, Md e Lg para diferentes densidades.", "Sm, Md and Lg for different densities."),
                SwatchSizePreview(), SwatchSizeCode)
            @Example(T("Formato dos swatches", "Swatch Shapes"),
                T("Rounded, Square e Circle.", "Rounded, Square and Circle."),
                SwatchShapePreview(), SwatchShapeCode)
            @Example(T("Tamanhos do campo", "Field Sizes"),
                T("Sm, Md e Lg para o campo de input.", "Sm, Md and Lg for input field."),
                SizesPreview(), SizesCode)
            @Example(T("Clearable", "Clearable"),
                T("Botao para limpar a cor.", "Button to clear color."),
                ClearablePreview(), ClearableCode)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Variantes", "Variants"), @<div>@NameValueTable(VariantRows, T("Variante", "Variant"), T("Caso de uso", "Use case"))</div>)
            @Section(T("Estados", "States"), @<div>@NameValueTable(StateRows, T("Estado", "State"), T("Comportamento", "Behavior"))</div>)
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Metodos", "Methods"), @<div>@NameValueTable(MethodRows, T("Metodo", "Method"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Navegacao enterprise por teclado", "Enterprise Keyboard Navigation"), @<div>@TileGrid(EnterpriseKeyboardItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Exemplos de integracao", "Integration Examples"), @<div>@TileGrid(IntegrationItems, 2)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("Design Tokens", @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Seguranca", "Security Considerations"), @<div>@TileGrid(SecurityItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Notas de migracao", "Migration Notes"), @<div>@TileGrid(MigrationItems, 2)</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>

@code {
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);

    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFStack Orientation="XFOrientation.Horizontal" Gap="3" Wrap="XFWrap.Wrap">
            <XFColorInput Label="@T("Cor primaria", "Primary color")" @bind-Value="_heroPrimary" ShowValue="true" />
            <XFColorInput Label="@T("Cor de destaque", "Accent color")" @bind-Value="_heroAccent" Clearable="true" />
        </XFStack>
        <XFGrid Cols="1" Md="3" Gap="3">
            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent>
                <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Com paleta", "With palette")</XFTypography>
                <XFColorInput @bind-Value="_heroPalette" Palette="@(new[] { "#22C55E", "#3B82F6", "#EF4444", "#F59E0B", "#8B5CF6" })" />
            </ChildContent></XFCard>
            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent>
                <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Disabled", "Disabled")</XFTypography>
                <XFColorInput Value="#3B82F6" Disabled="true" />
            </ChildContent></XFCard>
            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent>
                <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("ReadOnly", "ReadOnly")</XFTypography>
                <XFColorInput Value="#F59E0B" ReadOnly="true" />
            </ChildContent></XFCard>
        </XFGrid>
    </XFStack>;


    private IReadOnlyList<DocTile> QuickFacts =>
    [
        new(T("Input de cor hex", "Hex color input"), T("Campo com seletor nativo, texto hex e preview ao vivo.", "Field with native picker, hex text and live preview."), "droplet"),
        new(T("Paleta de amostras", "Sample palette"), T("Swatches configuraveis para selecao rapida.", "Configurable swatches for quick selection."), "swatchbook"),
        new(T("Integracao EditForm", "EditForm integration"), T("Validacao, two-way binding e NotifyFieldChanged.", "Validation, two-way binding and NotifyFieldChanged."), "shield-check")
    ];

    private IReadOnlyList<NameValueRow> MetadataRows =>
    [
        new("Component", "XFColorInput"),
        new("Namespace", "XForge.DesignSystem.Components.Forms.ColorInput"),
        new("Package", "XForge.DesignSystem"),
        new("Category", "Forms / ColorInput"),
        new("Status", T("Estavel", "Stable")),
        new("Accessibility", T("Label associado, aria-label e paleta acessivel.", "Associated label, aria-label and accessible palette."))
    ];

    private IReadOnlyList<DocTile> OverviewItems =>
    [
        new(T("Input especializado", "Specialized input"), T("Campo hex com preview nativo e texto editavel.", "Hex field with native preview and editable text."), "droplet"),
        new(T("Suporte a paleta", "Palette support"), T("Swatches de cores predefinidas para selecao rapida.", "Predefined color swatches for quick selection."), "swatchbook"),
        new(T("Integracao formulario", "Form integration"), T("Validacao automatica de formato hex e EditForm.", "Automatic hex format validation and EditForm."), "file-lines")
    ];

    private IReadOnlyList<DocTile> PurposeItems =>
    [
        new(T("Configuracao de tema", "Theme configuration"), T("Selecionar cores primaria, secundaria e de destaque.", "Select primary, secondary and accent colors."), "swatchbook"),
        new(T("Personalizacao", "Customization"), T("Cores configuraveis por tenant ou usuario.", "Colors configurable per tenant or user."), "paintbrush"),
        new(T("Categorizacao", "Categorization"), T("Cores para etiquetas, tags e series de dados.", "Colors for labels, tags and data series."), "tag")
    ];

    private IReadOnlyList<DocTile> ProblemItems =>
    [
        new(T("Antes", "Before"), T("Input generico sem preview, validacao ou paleta de cores.", "Generic input without preview, validation or color palette."), "xmark"),
        new(T("Depois", "After"), T("Campo com preview ao vivo, validacao hex e swatches.", "Field with live preview, hex validation and swatches."), "check"),
        new(T("Risco reduzido", "Reduced risk"), T("Evita cores invalidas e entrada inconsistente.", "Prevents invalid colors and inconsistent input."), "shield-check")
    ];

    private IReadOnlyList<DocTile> UseItems =>
    [
        new(T("Configuracoes de tema", "Theme settings"), T("Cores primaria, secundaria e de destaque do sistema.", "Primary, secondary and accent system colors."), "swatchbook"),
        new(T("Design tokens", "Design tokens"), T("Editor de variaveis de cor do design system.", "Design system color variable editor."), "palette"),
        new(T("Cores de serie", "Series colors"), T("Cores para graficos e visualizacao de dados.", "Colors for charts and data visualization."), "chart-line-up")
    ];

    private IReadOnlyList<DocTile> AvoidItems =>
    [
        new(T("Seletor completo", "Full picker"), T("Use XFColorPicker para selecao HSV/RGB com sliders.", "Use XFColorPicker for HSV/RGB selection with sliders."), "triangle-exclamation"),
        new(T("Somente leitura", "Read-only display"), T("Use um swatch simples para mostrar cor fixa.", "Use a simple swatch to show a fixed color."), "eye")
    ];

    private IReadOnlyList<DocTile> AnatomyItems =>
    [
        new("Root", T("Container com label, field shell, helper e error.", "Container with label, field shell, helper and error."), "code"),
        new(T("Swatch de cor", "Color swatch"), T("input[type=color] nativo para preview visual.", "Native input[type=color] for visual preview."), "droplet"),
        new(T("Campo hex", "Hex field"), T("Campo font-mono para valor hex editavel.", "Font-mono field for editable hex value."), "font"),
        new("Palette", T("Grid opcional de swatches predefinidos.", "Optional grid of predefined swatches."), "grid")
    ];

    private IReadOnlyList<DocTile> VisualHierarchyItems =>
    [
        new("Outline", T("Padrao para contextos de formulario.", "Default for form contexts."), "square"),
        new("Filled", T("Paineis compactos e edicao inline.", "Compact panels and inline editing."), "square-full"),
        new("Soft", T("Destaque sutil com tom primario.", "Subtle emphasis with primary tone."), "circle")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems =>
    [
        new(T("Feedback visual", "Visual feedback"), T("Preview de cor atualiza em tempo real.", "Color preview updates in real time."), "eye"),
        new(T("Selecao rapida", "Quick selection"), T("Swatches de paleta para cores comuns.", "Palette swatches for common colors."), "bolt"),
        new(T("Validacao clara", "Clear validation"), T("Formato hex validado com estado de erro.", "Hex format validated with error state."), "shield-check")
    ];

    private IReadOnlyList<NameValueRow> VariantRows =>
    [
        new("Outline", T("Borda com fundo de superficie. Padrao para formularios.", "Border with surface background. Default for forms.")),
        new("Filled", T("Fundo solido com sombra interna.", "Solid background with inset shadow.")),
        new("Soft", T("Borda e fundo com tom primario.", "Border and background with primary tone.")),
        new("Ghost", T("Transparente com efeito hover.", "Transparent with hover effect."))
    ];

    private IReadOnlyList<NameValueRow> StateRows =>
    [
        new("Default", T("Interativo com hover e focus.", "Interactive with hover and focus.")),
        new("Disabled", T("Opacidade reduzida, sem interacao.", "Reduced opacity, no interaction.")),
        new("ReadOnly", T("Valor visivel, sem edicao.", "Value visible, no editing.")),
        new("Error", T("Borda danger e mensagem de validacao.", "Danger border and validation message."))
    ];

    private IReadOnlyList<ApiRow> ApiRows =>
    [
        new("Value", "string?", "null", T("Valor hex da cor selecionada.", "Hex value of selected color.")),
        new("ValueChanged", "EventCallback<string?>", "default", T("Two-way binding.", "Two-way binding.")),
        new("Change", "EventCallback<string?>", "default", T("Mudanca confirmada.", "Committed change.")),
        new("Label", "string?", "null", T("Texto do label.", "Label text.")),
        new("AriaLabel", "string?", "null", T("Label acessivel.", "Accessible label.")),
        new("HelperText", "string?", "null", T("Texto de ajuda.", "Helper text.")),
        new("Variant", "XFFormVariant", "Outline", T("Outline, Filled, Soft ou Ghost.", "Outline, Filled, Soft or Ghost.")),
        new("Size", "XFSize", "Md", T("Sm, Md ou Lg.", "Sm, Md or Lg.")),
        new("Tone", "XFSemanticColor", "Default", T("Default, Primary, Success, Warning, Danger.", "Default, Primary, Success, Warning, Danger.")),
        new("ReadOnly", "bool", "false", T("Somente leitura.", "Read-only.")),
        new("Required", "bool", "false", T("Obrigatorio.", "Required.")),
        new("FullWidth", "bool", "true", T("Ocupa toda a largura.", "Fills width.")),
        new("Immediate", "bool", "false", T("Atualiza Value a cada tecla.", "Updates Value on each keystroke.")),
        new("Clearable", "bool", "false", T("Exibe botao de limpar.", "Shows clear button.")),
        new("ShowValue", "bool", "true", T("Exibe campo de texto hex.", "Shows hex text field.")),
        new("Palette", "IReadOnlyList<string>", "empty", T("Lista de cores hex para swatches.", "List of hex colors for swatches.")),
        new("PrefixText", "string?", "null", T("Texto prefixo.", "Prefix text.")),
        new("SuffixText", "string?", "null", T("Texto sufixo.", "Suffix text.")),
        new("StartIcon", "RenderFragment?", "null", T("Icone antes do campo.", "Icon before field.")),
        new("EndIcon", "RenderFragment?", "null", T("Icone depois do campo.", "Icon after field.")),
        new("ClearLabel", "string", "\"Limpar cor\"", T("Label do botao limpar.", "Clear button label.")),
        new("PaletteLabel", "string", "\"Amostras de cor\"", T("Label da paleta.", "Palette label.")),
        new("SwatchLabelFormat", "string", "\"Selecionar {0}\"", T("Formato do label de cada swatch.", "Format of each swatch label.")),
        new("SwatchSize", "XFSize", "Md", T("Tamanho do swatch: Sm, Md, Lg.", "Swatch size: Sm, Md, Lg.")),
        new("SwatchShape", "XFShape", "Rounded", T("Formato: Rounded, Square, Circle, Pill.", "Shape: Rounded, Square, Circle, Pill.")),
        new("SwatchButtonClass", "string?", "null", T("Classe CSS customizada para swatches.", "Custom CSS class for swatches."))
