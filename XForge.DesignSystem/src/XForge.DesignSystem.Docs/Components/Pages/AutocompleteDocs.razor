    private RenderFragment ExAsync() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFAutocomplete TItem="CustomerItem"
                        TValue="string"
                        Label="@T("Busca remota", "Remote search")"
                        Placeholder="@T("Digite para buscar na API...", "Type to search API...")"
                        SearchAsync="SearchCustomersAsync"
                        TextSelector="@(c => c.Name)"
                        ValueSelector="@(c => c.Id)"
                        Value="_asyncResult"
                        ValueChanged="@(v => _asyncResult = v)"
                        DebounceMs="400"
                        MinLength="2"
                        LoadingText="@T("Consultando API...", "Querying API...")"
                        EmptyText="@T("Nenhum cliente encontrado.", "No customer found.")"
                        HelperText="@T("Simula chamada async com 500ms de delay e debounce 400ms.", "Simulates async call with 500ms delay and 400ms debounce.")" />
    </XFStack>;

    private async Task<IEnumerable<CustomerItem>> SearchCustomersAsync(string? search, CancellationToken ct)
    {
        await Task.Delay(500, ct);
        if (string.IsNullOrWhiteSpace(search)) return [];
        return Customers.Where(c => c.Name.Contains(search, StringComparison.OrdinalIgnoreCase));
    }

