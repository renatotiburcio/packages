        <XFAutocomplete TItem="CustomerItem" TValue="string" Label="@T("Required", "Required")" Placeholder="@T("Obrigatorio...", "Required...")" Items="Customers" TextSelector="@(c => c.Name)" ValueSelector="@(c => c.Id)" Required="true" HelperText="@T("Obrigatorio para prosseguir.", "Required to proceed.")" />
