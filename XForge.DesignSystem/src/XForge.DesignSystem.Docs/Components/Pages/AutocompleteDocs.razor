    private RenderFragment ExEnterprise() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFAutocomplete TItem="CostCenterItem"
                        TValue="string"
                        Label="@T("Centro de custo", "Cost Center")"
                        Placeholder="@T("Buscar por nome ou codigo...", "Search by name or code...")"
                        Items="CostCenters"
                        TextSelector="@(cc => $"{cc.Code} - {cc.Name}")"
                        ValueSelector="@(cc => cc.Code)"
                        Value="_selectedCostCenter"
                        ValueChanged="@(v => _selectedCostCenter = v)"
                        Required="true"
                        Variant="XFFormVariant.Filled"
                        Tone="XFSemanticColor.Success">
            <StartIcon>@((MarkupString)XFSvgIcons.MarkupWithSize("sitemap", 16))</StartIcon>
            <ItemTemplate Context="cc">
                <div class="flex items-center justify-between w-full gap-3">
                    <div class="min-w-0">
                        <div class="text-sm font-medium text-text-primary">@cc.Name</div>
                        <div class="text-xs text-text-muted">@cc.Code @(string.IsNullOrWhiteSpace(cc.ParentCode) ? "" : $"({cc.ParentCode})")</div>
                    </div>
                    <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Primary" Text="@cc.Code" />
                </div>
            </ItemTemplate>
        </XFAutocomplete>
        @if (!string.IsNullOrEmpty(_selectedCostCenter))
        {
            <XFAlert Variant="XFAlertVariant.Soft" Color="XFSemanticColor.Success">
                @T($"Centro de custo selecionado: {_selectedCostCenter}", $"Selected cost center: {_selectedCostCenter}")
            </XFAlert>
        }
    </XFStack>;

