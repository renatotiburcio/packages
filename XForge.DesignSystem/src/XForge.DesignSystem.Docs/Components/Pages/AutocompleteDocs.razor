    private string CodeAsync => T("""
<XFAutocomplete TItem="CustomerItem" TValue="string"
    Label="Busca remota"
    SearchAsync="SearchCustomersAsync"
    TextSelector="@(c => c.Name)"
    ValueSelector="@(c => c.Id)"
    DebounceMs="400" MinLength="2" />

@code {
    private async Task<IEnumerable<CustomerItem>> SearchCustomersAsync(
        string? search, CancellationToken ct)
    {
        await Task.Delay(500, ct);
        return Customers.Where(c =>
            c.Name.Contains(search, StringComparison.OrdinalIgnoreCase));
    }
}
