@page "/forms/validation"
@using Microsoft.AspNetCore.Components.Forms
@using XForge.DesignSystem.Core.Primitives
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFValidation" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("7 validadores + Summary/Message/Status", "7 validators + Summary/Message/Status")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Sistema de validacao para formularios enterprise com 7 validadores integrados ao EditContext.",
                               "Enterprise form validation system with 7 validators integrated with EditContext.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("Validadores, mensagens e resumo de validacao para formularios Blazor. Suporte a Required, Email, Length, Range, Regex, Compare e Custom.",
                               "Validators, messages and validation summary for Blazor forms. Support for Required, Email, Length, Range, Regex, Compare and Custom.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico.", "Renders as static HTML.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 7 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Validacao basica", "1. Basic Validation"), T("Required e Email validando campos obrigatorios.", "Required and Email validating mandatory fields."), ExBasicValidation(), Code1)
            @Example(T("2. Comprimento e Intervalo", "2. Length and Range"), T("LengthValidator e RangeValidator com Min/Max.", "LengthValidator and RangeValidator with Min/Max."), ExLengthRange(), Code2)
            @Example(T("3. Regex e Compare", "3. Regex and Compare"), T("RegexValidator e CompareValidator com operadores.", "RegexValidator and CompareValidator with operators."), ExRegexCompare(), Code3)
            @Example(T("4. Validador Customizado", "4. Custom Validator"), T("XFCustomValidator com delegate de validacao.", "XFCustomValidator with validation delegate."), ExCustom(), Code4)
            @Example(T("5. Mensagem e Status", "5. Message and Status"), T("XFValidationMessage e XFValidationStatus inline.", "XFValidationMessage and XFValidationStatus inline."), ExMessageStatus(), Code5)
            @Example(T("6. Resumo de Validacao", "6. Validation Summary"), T("XFValidationSummary listando todos os erros.", "XFValidationSummary listing all errors."), ExSummary(), Code6)
            @Example(T("7. Formulario completo", "7. Full Form"), T("Formulario enterprise com todos os validadores.", "Enterprise form with all validators."), ExFullForm(), Code7)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("API", "API"), @<div>
                <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">XFValidatorBase</XFTypography>
                    @ApiTable(ValidatorBaseApiRows)
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">XFRequiredValidator</XFTypography>
                    @ApiTable(RequiredApiRows)
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">XFEmailValidator</XFTypography>
                    @ApiTable(EmailApiRows)
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">XFLengthValidator</XFTypography>
                    @ApiTable(LengthApiRows)
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">XFRangeValidator</XFTypography>
                    @ApiTable(RangeApiRows)
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">XFRegexValidator</XFTypography>
                    @ApiTable(RegexApiRows)
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">XFCompareValidator</XFTypography>
                    @ApiTable(CompareApiRows)
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">XFCustomValidator</XFTypography>
                    @ApiTable(CustomApiRows)
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">XFValidationSummary</XFTypography>
                    @ApiTable(SummaryApiRows)
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">XFValidationMessage</XFTypography>
                    @ApiTable(MessageApiRows)
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">XFValidationStatus</XFTypography>
                    @ApiTable(StatusApiRows)
                </XFStack>
            </div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string ProductLabelText => T("Core Open Source", "Core Open Source");
    private string PageTitleText => T("XFValidation", "XFValidation");
    private string PageStatusText => T("Documentacao completa", "Complete docs");
    private string T(string pt, string en) => LanguageService.Text(pt, en);
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <EditForm Model="HeroModel">
            <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                <XFValidationSummary Tone="XFSemanticColor.Danger" />
                <XFValidationStatus ShowIcon="true" />
            </XFStack>
        </EditForm>
    </XFStack>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("7 validadores", "7 validators"), T("Required, Email, Length, Range, Regex, Compare, Custom.", "Required, Email, Length, Range, Regex, Compare, Custom."), "shield-check"),
        new(T("Integracao EditContext", "EditContext integration"), T("Hooks direto no EditContext do Blazor.", "Hooks directly into Blazor EditContext."), "link"),
        new(T("Zero JS", "Zero JS"), T("Nenhum JavaScript interop. Puro C# + Tailwind.", "No JavaScript interop. Pure C# + Tailwind."), "bolt")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFValidation (7 validators + Summary/Message/Status)"),
        new("Namespace", "XForge.DesignSystem.Components.Forms.Validation"),
        new("Package", "XForge.DesignSystem"),
        new("Category", "Forms / Validation"),
        new("Status", T("Estavel", "Stable")),
        new("Accessibility", T("role=alert, role=status, aria-live=polite, aria-label.", "role=alert, role=status, aria-live=polite, aria-label.")),
        new("Theme support", T("Light, dark e data-brand via tokens.", "Light, dark and data-brand via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("Validadores", "Validators"), T("7 validadores para todos os tipos de campo.", "7 validators for all field types."), "shield-check"),
        new(T("Mensagens", "Messages"), T("XFValidationMessage para erros inline.", "XFValidationMessage for inline errors."), "message"),
        new(T("Resumo", "Summary"), T("XFValidationSummary para lista de erros.", "XFValidationSummary for error list."), "list-check")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Formularios", "Forms"), T("Validacao de campos obrigatorios e formatos.", "Validation of required fields and formats."), "pen-to-square"),
        new(T("Enterprise", "Enterprise"), T("Regras complexas com Compare e Custom.", "Complex rules with Compare and Custom."), "building"),
        new(T("UX", "UX"), T("Feedback visual imediato com cor e icone.", "Immediate visual feedback with color and icon."), "eye")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Validacao manual em cada campo.", "Manual validation on each field."), "xmark"),
        new(T("Depois", "After"), T("7 validadores declarativos via EditContext.", "7 declarative validators via EditContext."), "check"),
        new(T("Acessibilidade", "Accessibility"), T("role=alert, aria-live para leitores de tela.", "role=alert, aria-live for screen readers."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Formularios enterprise", "Enterprise forms"), T("Login, cadastro, configuracoes.", "Login, registration, settings."), "building"),
        new(T("Validacao complexa", "Complex validation"), T("Compare, Regex, Custom.", "Compare, Regex, Custom."), "puzzle-piece")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Formularios simples", "Simple forms"), T("Use DataAnnotations do .NET.", "Use .NET DataAnnotations."), "minus"),
        new(T("Server-side only", "Server-side only"), T("Use validacao no backend.", "Use backend validation."), "server")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new("For", T("Expression targeting o campo.", "Expression targeting the field."), "arrow-pointer"),
        new("Text", T("Mensagem de erro exibida.", "Displayed error message."), "message"),
        new("EditContext", T("Contexto pai que gerencia validacao.", "Parent context managing validation."), "layer-group")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(T("Declarativo", "Declarative"), T("Validacao como componentes Blazor.", "Validation as Blazor components."), "code"),
        new(T("Composicao", "Composition"), T("Componha validators com EditForm.", "Compose validators with EditForm."), "puzzle-piece"),
        new(T("Acessivel", "Accessible"), T("role=alert e aria-live para feedback.", "role=alert and aria-live for feedback."), "universal-access")
    ];

    // === EXAMPLES ===
    private RenderFragment ExBasicValidation() => @<EditForm Model="BasicModel">
        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <XFTextInput @bind-Value="BasicModel.Name" Label="@T("Nome", "Name")" />
            <XFRequiredValidator For="() => BasicModel.Name" Text="@T("Nome e obrigatorio.", "Name is required.")" />
            <XFValidationMessage For="() => BasicModel.Name" Tone="XFSemanticColor.Danger" />
            <XFTextInput @bind-Value="BasicModel.Email" Label="@T("Email", "Email")" />
            <XFEmailValidator For="() => BasicModel.Email" Text="@T("Email invalido.", "Invalid email.")" />
            <XFValidationMessage For="() => BasicModel.Email" Tone="XFSemanticColor.Danger" />
            <XFButton Text="@T("Enviar", "Submit")" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" />
        </XFStack>
    </EditForm>;

    private const string Code1 = @"<EditForm Model=""Model"">
    <XFStack Orientation=""XFOrientation.Vertical"" Gap=""3"" FullWidth=""true"">
        <XFTextInput @bind-Value=""Model.Name"" Label=""Nome"" />
        <XFRequiredValidator For=""() => Model.Name"" Text=""Nome e obrigatorio."" />
        <XFValidationMessage For=""() => Model.Name"" Tone=""XFSemanticColor.Danger"" />
        <XFTextInput @bind-Value=""Model.Email"" Label=""Email"" />
        <XFEmailValidator For=""() => Model.Email"" Text=""Email invalido."" />
        <XFValidationMessage For=""() => Model.Email"" Tone=""XFSemanticColor.Danger"" />
        <XFButton Text=""Enviar"" Variant=""XFButtonVariant.Solid"" Color=""XFButtonColor.Primary"" />
    </XFStack>
</EditForm>";

    private RenderFragment ExLengthRange() => @<EditForm Model="_lengthRangeModel">
        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <XFTextInput @bind-Value="_lengthRangeModel.Username" Label="@T("Nome de usuario (3-20 caracteres)", "Username (3-20 characters)")" />
            <XFLengthValidator For="() => _lengthRangeModel.Username" Min="3" Max="20" Text="@T("Entre 3 e 20 caracteres.", "Between 3 and 20 characters.")" />
            <XFValidationMessage For="() => _lengthRangeModel.Username" Tone="XFSemanticColor.Danger" />
            <XFTextInput @bind-Value="_lengthRangeModel.Age" Label="@T("Idade (18-120)", "Age (18-120)")" />
            <XFRangeValidator For="() => _lengthRangeModel.Age" Min="18" Max="120" Text="@T("Idade deve ser entre 18 e 120.", "Age must be between 18 and 120.")" />
            <XFValidationMessage For="() => _lengthRangeModel.Age" Tone="XFSemanticColor.Danger" />
            <XFButton Text="@T("Enviar", "Submit")" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" />
        </XFStack>
    </EditForm>;

    private const string Code2 = @"<EditForm Model=""Model"">
    <XFStack Orientation=""XFOrientation.Vertical"" Gap=""3"" FullWidth=""true"">
        <XFTextInput @bind-Value=""Model.Username"" Label=""Nome de usuario (3-20 caracteres)"" />
        <XFLengthValidator For=""() => Model.Username"" Min=""3"" Max=""20"" Text=""Entre 3 e 20 caracteres."" />
        <XFValidationMessage For=""() => Model.Username"" Tone=""XFSemanticColor.Danger"" />
        <XFTextInput @bind-Value=""Model.Age"" Label=""Idade (18-120)"" />
        <XFRangeValidator For=""() => Model.Age"" Min=""18"" Max=""120"" Text=""Idade deve ser entre 18 e 120."" />
        <XFValidationMessage For=""() => Model.Age"" Tone=""XFSemanticColor.Danger"" />
        <XFButton Text=""Enviar"" Variant=""XFButtonVariant.Solid"" Color=""XFButtonColor.Primary"" />
    </XFStack>
</EditForm>";

    private RenderFragment ExRegexCompare() => @<EditForm Model="_regexCompareModel">
        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <XFTextInput @bind-Value="_regexCompareModel.CPF" Label="@T("CPF (###.###.###-##)", "CPF (###.###.###-##)")" />
            <XFRegexValidator For="() => _regexCompareModel.CPF" Pattern="^\d{3}\.\d{3}\.\d{3}-\d{2}$" Text="@T("Formato de CPF invalido.", "Invalid CPF format.")" />
            <XFValidationMessage For="() => _regexCompareModel.CPF" Tone="XFSemanticColor.Danger" />
            <XFTextInput @bind-Value="_regexCompareModel.Price" Label="@T("Preco", "Price")" />
            <XFCompareValidator For="() => _regexCompareModel.Price" Value="0" Operator="XFCompareOperator.GreaterThan" Text="@T("Preco deve ser maior que zero.", "Price must be greater than zero.")" />
            <XFValidationMessage For="() => _regexCompareModel.Price" Tone="XFSemanticColor.Danger" />
            <XFButton Text="@T("Enviar", "Submit")" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" />
        </XFStack>
    </EditForm>;

    private const string Code3 = @"<EditForm Model=""Model"">
    <XFStack Orientation=""XFOrientation.Vertical"" Gap=""3"" FullWidth=""true"">
        <XFTextInput @bind-Value=""Model.CPF"" Label=""CPF (###.###.###-##)"" />
        <XFRegexValidator For=""() => Model.CPF"" Pattern=""^\d{3}\.\d{3}\.\d{3}-\d{2}$"" Text=""Formato de CPF invalido."" />
        <XFValidationMessage For=""() => Model.CPF"" Tone=""XFSemanticColor.Danger"" />
        <XFTextInput @bind-Value=""Model.Price"" Label=""Preco"" />
        <XFCompareValidator For=""() => Model.Price"" Value=""0"" Operator=""XFCompareOperator.GreaterThan"" Text=""Preco deve ser maior que zero."" />
        <XFValidationMessage For=""() => Model.Price"" Tone=""XFSemanticColor.Danger"" />
        <XFButton Text=""Enviar"" Variant=""XFButtonVariant.Solid"" Color=""XFButtonColor.Primary"" />
    </XFStack>
</EditForm>";

    private RenderFragment ExCustom() => @<EditForm Model="CustomModel">
        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <XFTextInput @bind-Value="CustomModel.CNPJ" Label="@T("CNPJ", "CNPJ")" />
            <XFCustomValidator For="() => CustomModel.CNPJ" Validator="ValidateCNPJ" Text="@T("CNPJ invalido.", "Invalid CNPJ.")" />
            <XFValidationMessage For="() => CustomModel.CNPJ" Tone="XFSemanticColor.Danger" />
            <XFButton Text="@T("Enviar", "Submit")" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" />
        </XFStack>
    </EditForm>;

    private const string Code4 = @"<EditForm Model=""Model"">
    <XFStack Orientation=""XFOrientation.Vertical"" Gap=""3"" FullWidth=""true"">
        <XFTextInput @bind-Value=""Model.CNPJ"" Label=""CNPJ"" />
        <XFCustomValidator For=""() => Model.CNPJ"" Validator=""ValidateCNPJ"" Text=""CNPJ invalido."" />
        <XFValidationMessage For=""() => Model.CNPJ"" Tone=""XFSemanticColor.Danger"" />
        <XFButton Text=""Enviar"" Variant=""XFButtonVariant.Solid"" Color=""XFButtonColor.Primary"" />
    </XFStack>
</EditForm>

@code {
    private bool ValidateCNPJ(object? value)
    {
        var text = value?.ToString() ?? string.Empty;
        return text.Length == 14 && text.All(char.IsDigit);
    }
}";

    private RenderFragment ExMessageStatus() => @<EditForm Model="StatusModel">
        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <XFValidationStatus ShowIcon="true" ValidText="@T("Formulario valido", "Form valid")" InvalidText="@T("Formulario com erros", "Form has errors")" NeutralText="@T("Preencha os campos", "Fill in the fields")" />
            <XFTextInput @bind-Value="StatusModel.Name" Label="@T("Nome", "Name")" />
            <XFRequiredValidator For="() => StatusModel.Name" Text="@T("Obrigatorio", "Required")" />
            <XFValidationMessage For="() => StatusModel.Name" Tone="XFSemanticColor.Danger" ShowIcon="true" />
            <XFTextInput @bind-Value="StatusModel.Email" Label="@T("Email", "Email")" />
            <XFEmailValidator For="() => StatusModel.Email" Text="@T("Email invalido", "Invalid email")" />
            <XFValidationMessage For="() => StatusModel.Email" Tone="XFSemanticColor.Warning" ShowIcon="true" />
            <XFButton Text="@T("Enviar", "Submit")" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" />
        </XFStack>
    </EditForm>;

    private const string Code5 = @"<EditForm Model=""Model"">
    <XFStack Orientation=""XFOrientation.Vertical"" Gap=""3"" FullWidth=""true"">
        <XFValidationStatus ShowIcon=""true"" ValidText=""Formulario valido"" InvalidText=""Formulario com erros"" NeutralText=""Preencha os campos"" />
        <XFTextInput @bind-Value=""Model.Name"" Label=""Nome"" />
        <XFRequiredValidator For=""() => Model.Name"" Text=""Obrigatorio"" />
        <XFValidationMessage For=""() => Model.Name"" Tone=""XFSemanticColor.Danger"" ShowIcon=""true"" />
        <XFTextInput @bind-Value=""Model.Email"" Label=""Email"" />
        <XFEmailValidator For=""() => Model.Email"" Text=""Email invalido"" />
        <XFValidationMessage For=""() => Model.Email"" Tone=""XFSemanticColor.Warning"" ShowIcon=""true"" />
        <XFButton Text=""Enviar"" Variant=""XFButtonVariant.Solid"" Color=""XFButtonColor.Primary"" />
    </XFStack>
