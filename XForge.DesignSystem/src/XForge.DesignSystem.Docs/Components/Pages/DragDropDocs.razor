@page "/components/drag-drop"
@using XForge.DesignSystem.Components.Utilities.DragDrop
@using XForge.DesignSystem.Core.Primitives
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="Core OSS"
                 Title="Drag & Drop"
                 Status="Premium"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">

        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFDragDrop" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Typed payload", "Typed payload")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Enterprise", "Enterprise")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Zona de drag-and-drop acessivel para kanban, listas e layout.", "Accessible drag-and-drop zone for kanban, lists and layout.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("3 estados (Idle, DragOver, Rejected), AcceptTypes, StateContent template, tons semanticos e XFDragDropZone<T> com payload tipado.",
                               "3 states (Idle, DragOver, Rejected), AcceptTypes, StateContent template, semantic tones and XFDragDropZone<T> with typed payload.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Basico", "1. Basic"),
                T("Zona de drop simples com label e descricao.", "Simple drop zone with label and description."),
                ExBasic(), CodeBasic)

            @Example(T("2. Estados", "2. States"),
                T("Idle, DragOver e Rejected — feedback visual por estado.", "Idle, DragOver and Rejected — visual feedback per state."),
                ExStates(), CodeStates)

            @Example(T("3. Kanban board", "3. Kanban board"),
                T("Mover cards entre colunas de status usando XFDragDrop com OnDrop.", "Move cards between status columns using XFDragDrop with OnDrop."),
                ExKanban(), CodeKanban)

            @Example(T("4. Tons semanticos", "4. Semantic tones"),
                T("Primary, Success, Warning, Danger — cores de feedback.", "Primary, Success, Warning, Danger — feedback colors."),
                ExTones(), ExTonesCode)

            @Example(T("5. Tamanhos", "5. Sizes"),
                T("Sm, Md e Lg — alturas progressivas.", "Sm, Md and Lg — progressive heights."),
                ExSizes(), CodeSizes)

            @Example(T("6. StateContent template", "6. StateContent template"),
                T("RenderFragment<XFDragDropState> para markup por estado.", "RenderFragment<XFDragDropState> for per-state markup."),
                ExStateContent(), CodeStateContent)

            @Example(T("7. Descricao", "7. Description"),
                T("Label e descricao customizados.", "Custom label and description."),
                ExDescription(), CodeDescription)

            @Example(T("8. Reordenar lista", "8. Reorder list"),
                T("Arrastar para reordenar itens de uma lista.", "Drag to reorder list items."),
                ExReorder(), CodeReorder)

            @Example(T("9. Payload tipado", "9. Typed payload"),
                T("XFDragDropZone<T> com Payload e PayloadDrop event.", "XFDragDropZone<T> with Payload and PayloadDrop event."),
                ExPayload(), CodePayload)

            @Example(T("10. Mover componente de area", "10. Move component to area"),
                T("Mover componentes para diferentes areas de layout usando drop zones.", "Move components to different layout areas using drop zones."),
                ExMoveToArea(), CodeMoveToArea)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API — XFDragDrop", @<div>@ApiTable(ApiRows)</div>)
            @Section("API — XFDragDropZone<T>", @<div>@ApiTable(ZoneApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>

    </XFStack>
</XForgeDocsShell>

@code {
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);
    private string CopyableCodeTitle => T("Copiar codigo", "Copy code");

    private string lastDropInfo = "";

    private RenderFragment HeroPreview() => @<div>
        <XFDragDrop Label="@T("Solte aqui", "Drop here")"
                    Description="@T("Arraste componentes ou arquivos", "Drag components or files")"
                    Tone="XFSemanticColor.Primary"
                    Size="XFSize.Md" />
    </div>;

    private RenderFragment ExBasic() => @<div>
        <XFDragDrop Label="@T("Solte aqui", "Drop here")"
                    Description="@T("Arraste um item para esta zona", "Drag an item to this zone")" />
    </div>;

    private string CodeBasic =>
        "<XFDragDrop Label=\"Drop here\"" + "\n" +
        "            Description=\"Drag an item to this zone\" />";

    private RenderFragment ExStates() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <div>
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="Idle" />
            <XFDragDrop Label="@T("Idle - aguardando", "Idle - waiting")" Size="XFSize.Sm" Class="mt-1" />
        </div>
        <div>
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="DragOver" />
            <XFDragDrop Label="@T("DragOver - solte!", "DragOver - drop!")" Size="XFSize.Sm" Tone="XFSemanticColor.Success" Class="mt-1" />
        </div>
        <div>
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Danger" Text="Rejected" />
            <XFDragDrop Label="@T("Rejected - tipo invalido", "Rejected - invalid type")" Size="XFSize.Sm" Tone="XFSemanticColor.Danger" Class="mt-1" />
        </div>
    </XFStack>;

    private string CodeStates =>
        "// Idle (default)" + "\n" +
        "<XFDragDrop Label=\"Waiting\" />" + "\n" +
        "\n" +
        "// DragOver (visual feedback)" + "\n" +
        "<XFDragDrop Tone=\"XFSemanticColor.Success\" />" + "\n" +
        "\n" +
        "// Rejected (danger feedback)" + "\n" +
        "<XFDragDrop Tone=\"XFSemanticColor.Danger\" />";

    // --- 3. Kanban ---
    private sealed record TaskCard(string Id, string Title);

    private List<TaskCard> todoCards = new()
    {
        new("t1", "Design system audit"),
        new("t2", "Write unit tests"),
        new("t3", "Update documentation")
    };

    private List<TaskCard> inProgressCards = new()
    {
        new("t4", "Implement DragDrop"),
        new("t5", "Review PR #42")
    };

    private List<TaskCard> doneCards = new()
    {
        new("t6", "Setup CI pipeline")
    };

    private string kanbanMessage = "";

    private void MoveCard(TaskCard card, string targetColumn)
    {
        todoCards.Remove(card);
        inProgressCards.Remove(card);
        doneCards.Remove(card);

        switch (targetColumn)
        {
            case "todo": todoCards.Add(card); break;
            case "progress": inProgressCards.Add(card); break;
            case "done": doneCards.Add(card); break;
        }

        kanbanMessage = $"Moved \"{card.Title}\" to {targetColumn}";
        StateHasChanged();
    }

    private RenderFragment ExKanban() => @<div>
        <XFGrid Cols="3" Gap="4">
            <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("A fazer", "To Do")" />
                @foreach (var card in todoCards)
                {
                    <div class="rounded-lg border border-border-light bg-bg-surface p-3 text-sm font-medium text-text-primary">@card.Title</div>
                }
                <XFDragDrop Label="@T("Soltar aqui", "Drop here")"
                            Size="XFSize.Sm"
                            Tone="XFSemanticColor.Primary"
                            OnDrop="@(() => MoveCard(todoCards.LastOrDefault() ?? new("t0",""), "todo"))" />
            </XFStack>

            <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Em progresso", "In Progress")" />
                @foreach (var card in inProgressCards)
                {
                    <div class="rounded-lg border border-warning/20 bg-warning/8 p-3 text-sm font-medium text-text-primary">@card.Title</div>
                }
                <XFDragDrop Label="@T("Soltar aqui", "Drop here")"
                            Size="XFSize.Sm"
                            Tone="XFSemanticColor.Warning"
                            OnDrop="@(() => MoveCard(inProgressCards.LastOrDefault() ?? new("t0",""), "progress"))" />
            </XFStack>

            <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Concluido", "Done")" />
                @foreach (var card in doneCards)
                {
                    <div class="rounded-lg border border-success/20 bg-success/8 p-3 text-sm font-medium text-text-primary">@card.Title</div>
                }
                <XFDragDrop Label="@T("Soltar aqui", "Drop here")"
                            Size="XFSize.Sm"
                            Tone="XFSemanticColor.Success"
                            OnDrop="@(() => MoveCard(doneCards.LastOrDefault() ?? new("t0",""), "done"))" />
            </XFStack>
        </XFGrid>
        @if (!string.IsNullOrEmpty(kanbanMessage))
        {
            <div class="mt-3 text-sm text-text-secondary">@kanbanMessage</div>
        }
    </div>;

    private string CodeKanban =>
        "@using XForge.DesignSystem.Components.Utilities.DragDrop" + "\n" +
        "\n" +
        "<XFGrid Cols=\"3\" Gap=\"4\">" + "\n" +
        "    <!-- To Do Column -->" + "\n" +
        "    <XFStack Orientation=\"XFOrientation.Vertical\" Gap=\"2\">" + "\n" +
        "        <XFBadge Text=\"To Do\" Color=\"XFBadgeColor.Info\" />" + "\n" +
        "        @foreach (var card in TodoCards)" + "\n" +
        "        {" + "\n" +
        "            <div class=\"rounded-lg border p-3 text-sm\">@card.Title</div>" + "\n" +
        "        }" + "\n" +
        "        <XFDragDrop Label=\"Drop here\"" + "\n" +
        "                    Size=\"XFSize.Sm\"" + "\n" +
        "                    Tone=\"XFSemanticColor.Primary\"" + "\n" +
        "                    OnDrop=\"@(() => MoveCard(TodoCards.LastOrDefault() ?? new(\"t0\", \"\"), \\\"todo\\\"))\" />" + "\n" +
        "    </XFStack>" + "\n" +
        "    <!-- Done Column -->" + "\n" +
        "    <XFStack Orientation=\"XFOrientation.Vertical\" Gap=\"2\">" + "\n" +
        "        <XFBadge Text=\"Done\" Color=\"XFBadgeColor.Success\" />" + "\n" +
        "        @foreach (var card in DoneCards)" + "\n" +
        "        {" + "\n" +
        "            <div class=\"rounded-lg border p-3 text-sm\">@card.Title</div>" + "\n" +
        "        }" + "\n" +
        "        <XFDragDrop Label=\"Drop here\"" + "\n" +
        "                    Size=\"XFSize.Sm\"" + "\n" +
        "                    Tone=\"XFSemanticColor.Success\"" + "\n" +
        "                    OnDrop=\"@(() => MoveCard(DoneCards.LastOrDefault() ?? new(\"t0\", \"\"), \\\"done\\\"))\" />" + "\n" +
        "    </XFStack>" + "\n" +
        "</XFGrid>" + "\n" +
        "\n" +
        "@code {" + "\n" +
        "    private sealed record TaskCard(string Id, string Title);" + "\n" +
        "\n" +
        "    private List<TaskCard> TodoCards = new() { new(\"t1\", \"Design audit\") };" + "\n" +
        "    private List<TaskCard> DoneCards = new();" + "\n" +
        "\n" +
        "    private void MoveCard(TaskCard card, string target)" + "\n" +
        "    {" + "\n" +
        "        TodoCards.Remove(card);" + "\n" +
        "        DoneCards.Remove(card);" + "\n" +
        "        if (target == \"todo\") TodoCards.Add(card);" + "\n" +
        "        if (target == \"done\") DoneCards.Add(card);" + "\n" +
        "        StateHasChanged();" + "\n" +
        "    }" + "\n" +
        "}";

    // --- 4. Tones ---
    private RenderFragment ExTones() => @<XFGrid Cols="2" Gap="4">
        @foreach (var tone in new[] { XFSemanticColor.Primary, XFSemanticColor.Success, XFSemanticColor.Warning, XFSemanticColor.Danger })
        {
            <div>
                <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@tone.ToString()" />
                <XFDragDrop Label="@tone.ToString()" Size="XFSize.Sm" Tone="@tone" Class="mt-1" />
            </div>
        }
    </XFGrid>;

    private string ExTonesCode =>
        "<XFDragDrop Tone=\"XFSemanticColor.Primary\" Label=\"Primary\" Size=\"XFSize.Sm\" />" + "\n" +
        "<XFDragDrop Tone=\"XFSemanticColor.Success\" Label=\"Success\" Size=\"XFSize.Sm\" />" + "\n" +
        "<XFDragDrop Tone=\"XFSemanticColor.Warning\" Label=\"Warning\" Size=\"XFSize.Sm\" />" + "\n" +
        "<XFDragDrop Tone=\"XFSemanticColor.Danger\" Label=\"Danger\" Size=\"XFSize.Sm\" />";

    // --- 5. Sizes ---
    private RenderFragment ExSizes() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        @foreach (var size in Enum.GetValues<XFSize>())
        {
            <div>
                <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@size.ToString()" />
                <XFDragDrop Label="@size.ToString()" Size="@size" Class="mt-1" />
            </div>
        }
    </XFStack>;

    private string CodeSizes =>
        "<XFDragDrop Size=\"XFSize.Sm\" Label=\"Small\" />" + "\n" +
        "<XFDragDrop Size=\"XFSize.Md\" Label=\"Medium\" />" + "\n" +
        "<XFDragDrop Size=\"XFSize.Lg\" Label=\"Large\" />";

    // --- 6. StateContent ---
    private RenderFragment ExStateContent() => @<div>
        <XFDragDrop Size="XFSize.Md" Tone="XFSemanticColor.Success">
            <StateContent Context="state">
                @if (state == XFDragDropState.DragOver)
                {
                    <div class="text-center">
                        <div class="text-2xl font-bold text-success">@T("Solte agora!", "Drop now!")</div>
                        <div class="text-sm text-text-secondary">@T("Item aceito", "Item accepted")</div>
                    </div>
                }
                else if (state == XFDragDropState.Rejected)
                {
                    <div class="text-center">
                        <div class="text-2xl font-bold text-danger">@T("Tipo invalido", "Invalid type")</div>
                        <div class="text-sm text-text-secondary">@T("Item rejeitado", "Item rejected")</div>
                    </div>
                }
                else
                {
                    <div class="text-center">
                        <div class="text-2xl font-bold text-text-primary">@T("Arraste aqui", "Drag here")</div>
                        <div class="text-sm text-text-secondary">@T("Solte para adicionar", "Drop to add")</div>
                    </div>
                }
            </StateContent>
        </XFDragDrop>
    </div>;

    private string CodeStateContent =>
        "<XFDragDrop>" + "\n" +
        "    <StateContent Context=\"state\">" + "\n" +
        "        @switch (state)" + "\n" +
        "        {" + "\n" +
        "            case XFDragDropState.DragOver:" + "\n" +
        "                <div>Drop now!</div>" + "\n" +
        "                break;" + "\n" +
        "            case XFDragDropState.Rejected:" + "\n" +
        "                <div>Invalid type</div>" + "\n" +
        "                break;" + "\n" +
        "            default:" + "\n" +
        "                <div>Drag here</div>" + "\n" +
        "                break;" + "\n" +
        "        }" + "\n" +
        "    </StateContent>" + "\n" +
        "</XFDragDrop>";

    // --- 7. Description ---
    private RenderFragment ExDescription() => @<div>
        <XFDragDrop Label="@T("Zona de drop", "Drop zone")"
                    Description="@T("Solte qualquer tipo de arquivo ou componente", "Drop any type of file or component")"
                    Size="XFSize.Lg" />
    </div>;

    private string CodeDescription =>
        "<XFDragDrop Label=\"Drop zone\"" + "\n" +
        "            Description=\"Drop any type of file or component\"" + "\n" +
        "            Size=\"XFSize.Lg\" />";

    // --- 8. Reorder list ---
    private sealed record ReorderItem(string Id, string Label);

    private List<ReorderItem> reorderItems = new()
    {
        new("r1", "First item"),
        new("r2", "Second item"),
        new("r3", "Third item"),
        new("r4", "Fourth item"),
        new("r5", "Fifth item")
    };

    private string reorderMessage = "";

    private RenderFragment ExReorder() => @<div class="max-w-sm">
        <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
            @foreach (var item in reorderItems)
            {
                <div class="flex items-center gap-3 rounded-lg border border-border-light bg-bg-surface px-4 py-3">
                    <span class="inline-block h-3 w-3 text-text-muted">@((MarkupString)XFSvgIcons.MarkupWithSize("grip-vertical", 14))</span>
                    <span class="text-sm font-medium text-text-primary">@item.Label</span>
                </div>
            }
        </XFStack>
        <div class="mt-3">
            <XFDragDrop Label="@T("Soltar para reordenar", "Drop to reorder")"
                        Size="XFSize.Sm"
                        Tone="XFSemanticColor.Primary"
                        OnDrop="@HandleReorderDrop" />
        </div>
        @if (!string.IsNullOrEmpty(reorderMessage))
        {
            <div class="mt-2 text-sm text-success">@reorderMessage</div>
        }
    </div>;

    private void HandleReorderDrop(XFDragDropEventArgs args)
    {
        reorderMessage = T("Item reordenado! Lista atualizada.", "Item reordered! List updated.");
        StateHasChanged();
    }

    private string CodeReorder =>
        "@using XForge.DesignSystem.Components.Utilities.DragDrop" + "\n" +
        "\n" +
        "<XFStack Orientation=\"XFOrientation.Vertical\" Gap=\"2\">" + "\n" +
        "    @foreach (var item in Items)" + "\n" +
        "    {" + "\n" +
        "        <div class=\"flex items-center gap-3 rounded-lg border p-3\">" + "\n" +
        "            <span class=\"text-text-muted\">@((MarkupString)XFSvgIcons.MarkupWithSize(\"grip-vertical\", 14))</span>" + "\n" +
        "            <span>@item.Label</span>" + "\n" +
        "        </div>" + "\n" +
        "    }" + "\n" +
        "</XFStack>" + "\n" +
        "\n" +
        "<XFDragDrop Label=\"Drop to reorder\"" + "\n" +
        "            Size=\"XFSize.Sm\"" + "\n" +
        "            OnDrop=\"@OnReorderDrop\" />" + "\n" +
        "\n" +
        "@code {" + "\n" +
        "    private sealed record ReorderItem(string Id, string Label);" + "\n" +
        "\n" +
        "    private List<ReorderItem> Items = new()" + "\n" +
        "    {" + "\n" +
        "        new(\"r1\", \"First item\")," + "\n" +
        "        new(\"r2\", \"Second item\")," + "\n" +
        "        new(\"r3\", \"Third item\")" + "\n" +
        "    };" + "\n" +
        "\n" +
        "    private void OnReorderDrop(XFDragDropEventArgs args)" + "\n" +
        "    {" + "\n" +
        "        if (args.Accepted)" + "\n" +
        "        {" + "\n" +
        "            // Reorder logic: move item to new position" + "\n" +
        "            StateHasChanged();" + "\n" +
        "        }" + "\n" +
        "    }" + "\n" +
        "}";

    // --- 9. Payload ---
    private RenderFragment ExPayload() => @<div>
        <XFDragDrop Label="@T("Zone com payload (veja codigo para XFDragDropZone<T>)", "Zone with payload (see code for XFDragDropZone<T>)")"
                    Description="@T("Use XFDragDropZone<T> para dados tipados no drop", "Use XFDragDropZone<T> for typed data on drop")"
                    Size="XFSize.Md"
                    OnDrop="@(args => lastDropInfo = $"Accepted: {args.Accepted}, Types: {string.Join(", ", args.Types)}")" />
        @if (!string.IsNullOrEmpty(lastDropInfo))
        {
            <div class="mt-2 text-sm text-text-secondary">@lastDropInfo</div>
        }
    </div>;

    private string CodePayload =>
        "<XFDragDropZone<string> Label=\"Zone with payload\"" + "\n" +
        "                     Payload=\"@(\"doc-2026\")\"" + "\n" +
        "                     PayloadDrop=\"@OnPayloadDrop\" />" + "\n" +
        "\n" +
