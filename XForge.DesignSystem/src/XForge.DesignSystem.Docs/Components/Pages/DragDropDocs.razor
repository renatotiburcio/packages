    // --- 10. Move to area ---
    private sealed record LayoutWidget(string Id, string Name);

    private List<LayoutWidget> headerWidgets = new() { new("w1", "Navigation Bar") };
    private List<LayoutWidget> sidebarWidgets = new() { new("w2", "Quick Links") };
    private List<LayoutWidget> mainWidgets = new() { new("w3", "Content Area") };
    private string areaMessage = "";

    private void MoveWidget(LayoutWidget widget, string targetArea)
    {
        headerWidgets.Remove(widget);
        sidebarWidgets.Remove(widget);
        mainWidgets.Remove(widget);

        switch (targetArea)
        {
            case "header": headerWidgets.Add(widget); break;
            case "sidebar": sidebarWidgets.Add(widget); break;
            case "main": mainWidgets.Add(widget); break;
        }

        areaMessage = $"Moved \"{widget.Name}\" to {targetArea}";
        StateHasChanged();
    }

    private RenderFragment ExMoveToArea() => @<div>
        <XFGrid Cols="3" Gap="4">
            <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Header", "Header")" />
                @foreach (var w in headerWidgets)
                {
                    <div class="rounded-lg border border-primary/20 bg-primary/8 p-3 text-sm font-medium text-text-primary">@w.Name</div>
                }
                <XFDragDrop Label="@T("Soltar no Header", "Drop in Header")"
                            Size="XFSize.Sm"
                            Tone="XFSemanticColor.Primary"
                            OnDrop="@(() => MoveWidget(headerWidgets.LastOrDefault() ?? new("w0",""), "header"))" />
            </XFStack>

            <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Sidebar", "Sidebar")" />
                @foreach (var w in sidebarWidgets)
                {
                    <div class="rounded-lg border border-warning/20 bg-warning/8 p-3 text-sm font-medium text-text-primary">@w.Name</div>
                }
                <XFDragDrop Label="@T("Soltar na Sidebar", "Drop in Sidebar")"
                            Size="XFSize.Sm"
                            Tone="XFSemanticColor.Warning"
                            OnDrop="@(() => MoveWidget(sidebarWidgets.LastOrDefault() ?? new("w0",""), "sidebar"))" />
            </XFStack>

            <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Main", "Main")" />
                @foreach (var w in mainWidgets)
                {
                    <div class="rounded-lg border border-success/20 bg-success/8 p-3 text-sm font-medium text-text-primary">@w.Name</div>
                }
                <XFDragDrop Label="@T("Soltar no Main", "Drop in Main")"
                            Size="XFSize.Sm"
                            Tone="XFSemanticColor.Success"
                            OnDrop="@(() => MoveWidget(mainWidgets.LastOrDefault() ?? new("w0",""), "main"))" />
            </XFStack>
        </XFGrid>
        @if (!string.IsNullOrEmpty(areaMessage))
        {
            <div class="mt-3 text-sm text-text-secondary">@areaMessage</div>
        }
    </div>;

    private string CodeMoveToArea =>
        "@using XForge.DesignSystem.Components.Utilities.DragDrop" + "\n" +
        "\n" +
        "<XFGrid Cols=\"3\" Gap=\"4\">" + "\n" +
        "    <XFStack Orientation=\"XFOrientation.Vertical\" Gap=\"2\">" + "\n" +
        "        <XFBadge Text=\"Header\" Color=\"XFBadgeColor.Info\" />" + "\n" +
        "        @foreach (var widget in HeaderWidgets)" + "\n" +
        "        {" + "\n" +
        "            <div class=\"rounded-lg border p-3 text-sm\">@widget.Name</div>" + "\n" +
        "        }" + "\n" +
        "        <XFDragDrop Label=\"Drop in Header\"" + "\n" +
        "                    Size=\"XFSize.Sm\"" + "\n" +
        "                    Tone=\"XFSemanticColor.Primary\"" + "\n" +
        "                    OnDrop=\"@(() => MoveWidget(HeaderWidgets.LastOrDefault() ?? new(\"w0\", \"\"), \\\"header\\\"))\" />" + "\n" +
        "    </XFStack>" + "\n" +
        "    <XFStack Orientation=\"XFOrientation.Vertical\" Gap=\"2\">" + "\n" +
        "        <XFBadge Text=\"Sidebar\" Color=\"XFBadgeColor.Warning\" />" + "\n" +
        "        @foreach (var widget in SidebarWidgets)" + "\n" +
        "        {" + "\n" +
        "            <div class=\"rounded-lg border p-3 text-sm\">@widget.Name</div>" + "\n" +
        "        }" + "\n" +
        "        <XFDragDrop Label=\"Drop in Sidebar\"" + "\n" +
        "                    Size=\"XFSize.Sm\"" + "\n" +
        "                    Tone=\"XFSemanticColor.Warning\"" + "\n" +
        "                    OnDrop=\"@(() => MoveWidget(SidebarWidgets.LastOrDefault() ?? new(\"w0\", \"\"), \\\"sidebar\\\"))\" />" + "\n" +
        "    </XFStack>" + "\n" +
        "    <XFStack Orientation=\"XFOrientation.Vertical\" Gap=\"2\">" + "\n" +
        "        <XFBadge Text=\"Main\" Color=\"XFBadgeColor.Success\" />" + "\n" +
        "        @foreach (var widget in MainWidgets)" + "\n" +
        "        {" + "\n" +
        "            <div class=\"rounded-lg border p-3 text-sm\">@widget.Name</div>" + "\n" +
        "        }" + "\n" +
        "        <XFDragDrop Label=\"Drop in Main\"" + "\n" +
        "                    Size=\"XFSize.Sm\"" + "\n" +
        "                    Tone=\"XFSemanticColor.Success\"" + "\n" +
        "                    OnDrop=\"@(() => MoveWidget(MainWidgets.LastOrDefault() ?? new(\"w0\", \"\"), \\\"main\\\"))\" />" + "\n" +
        "    </XFStack>" + "\n" +
        "</XFGrid>" + "\n" +
        "\n" +
        "@code {" + "\n" +
        "    private sealed record LayoutWidget(string Id, string Name);" + "\n" +
        "\n" +
        "    private List<LayoutWidget> HeaderWidgets = new() { new(\"w1\", \"Nav Bar\") };" + "\n" +
        "    private List<LayoutWidget> SidebarWidgets = new() { new(\"w2\", \"Quick Links\") };" + "\n" +
        "    private List<LayoutWidget> MainWidgets = new() { new(\"w3\", \"Content\") };" + "\n" +
        "\n" +
        "    private void MoveWidget(LayoutWidget widget, string target)" + "\n" +
        "    {" + "\n" +
        "        HeaderWidgets.Remove(widget);" + "\n" +
        "        SidebarWidgets.Remove(widget);" + "\n" +
        "        MainWidgets.Remove(widget);" + "\n" +
        "        if (target == \"header\") HeaderWidgets.Add(widget);" + "\n" +
        "        if (target == \"sidebar\") SidebarWidgets.Add(widget);" + "\n" +
        "        if (target == \"main\") MainWidgets.Add(widget);" + "\n" +
        "        StateHasChanged();" + "\n" +
        "    }" + "\n" +
        "}";

    // --- Helpers ---
    private RenderFragment Section(string title, RenderFragment content) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
        <Header><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography></Header>
        <ChildContent>@content</ChildContent>
    </XFCard>;

    private RenderFragment Example(string title, string description, RenderFragment preview, string codeText) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.None" AreaRestricted="false">
        <Header><div class="px-6 pt-6 pb-2">
            <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@description</XFTypography>
        </div></Header>
        <ChildContent><div class="flex flex-col">
            <div class="border-t border-border-light p-6">@preview</div>
