@page "/components/collapse"
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFCollapse" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Animacoes", "Animations")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="WCAG AAA" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Expandir e recolher conteudo com semantica, acessibilidade e animacao nativas.",
                               "Expand and collapse content with native semantics, accessibility and animation.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("XFCollapse e um container expansivel com navegacao por teclado, heading hierarchy, touch target AAA e 4 modos de animacao.",
                               "XFCollapse is an expandable container with keyboard navigation, heading hierarchy, AAA touch target and 4 animation modes.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico. Interacoes requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Basico", "1. Basic"),
                T("Collapse simples com titulo e conteudo.", "Simple collapse with title and content."),
                ExBasic(), CodeBasic)

            @Example(T("2. Tamanhos", "2. Sizes"),
                T("Sm, Md e Lg, todos com touch target minimo 44px.", "Sm, Md and Lg, all with 44px minimum touch target."),
                ExSizes(), CodeSizes)

            @Example(T("3. Variantes", "3. Variants"),
                T("Plain, Soft, Surface, Outline e Ghost.", "Plain, Soft, Surface, Outline and Ghost."),
                ExVariants(), CodeVariants)

            @Example(T("4. Animacoes", "4. Animations"),
                T("4 modos: None, Height, HeightFade e SlideFade.", "4 modes: None, Height, HeightFade and SlideFade."),
                ExAnimations(), CodeAnimations)

            @Example(T("5. Modos de icone", "5. Icon Modes"),
                T("Chevron, PlusMinus e None.", "Chevron, PlusMinus and None."),
                ExIconModes(), CodeIconModes)

            @Example(T("6. Slots de conteudo", "6. Content Slots"),
                T("StartIcon, EndContent e Header customizado.", "StartIcon, EndContent and custom Header."),
                ExSlots(), CodeSlots)

            @Example(T("7. Descricao", "7. Description"),
                T("Titulo e descricao secundaria.", "Title and secondary description."),
                ExDescription(), CodeDescription)

            @Example(T("8. Lazy e KeepAlive", "8. Lazy and KeepAlive"),
                T("Lazy=true renderiza na primeira expansao; KeepAlive=false destroi ao recolher.", "Lazy=true renders on first expansion; KeepAlive=false destroys on collapse."),
                ExLazy(), CodeLazy)

            @Example(T("9. Estado controlado", "9. Controlled State"),
                T("Two-way binding com Expanded e ExpandedChanged.", "Two-way binding with Expanded and ExpandedChanged."),
                ExControlled(), CodeControlled)

            @Example(T("10. Desabilitado", "10. Disabled"),
                T("Collapse desabilitado com visual e interacao bloqueados.", "Disabled collapse with blocked visual and interaction."),
                ExDisabled(), CodeDisabled)

            @Example(T("11. Cenario ERP", "11. ERP Scenario"),
                T("Detalhes do pedido, configuracoes fiscais em contexto enterprise.", "Order details, tax settings in enterprise context."),
                ExErp(), CodeErp)

            @Example(T("12. Composicao avancada", "12. Advanced Composition"),
                T("Multiplos collapses com XFCard, badges e acoes.", "Multiple collapses with XFCard, badges and actions."),
                ExAdvanced(), CodeAdvanced)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>

@code {
    private string ProductLabelText => T("Core Open Source", "Core Open Source");
    private string PageTitleText => T("XFCollapse", "XFCollapse");
    private string PageStatusText => T("Documentacao completa", "Complete docs");
    private string T(string pt, string en) => LanguageService.Text(pt, en);
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");

    // ─── Hero ───
    private RenderFragment HeroPreview() => @<div class="grid gap-3">
        <XFCollapse Title="@T("Dados do Pedido", "Order Data")" Expanded="true" Variant="XFCollapseVariant.Surface" Size="XFSize.Md">
            <ChildContent>
                <div class="grid gap-2 text-sm">
                    <div class="flex justify-between"><span class="text-text-secondary">@T("Pedido", "Order")</span><span class="font-medium">#4821</span></div>
                    <div class="flex justify-between"><span class="text-text-secondary">@T("Cliente", "Customer")</span><span class="font-medium">Acme Corp</span></div>
                    <div class="flex justify-between"><span class="text-text-secondary">@T("Total", "Total")</span><span class="font-medium text-primary">R$ 12.450,00</span></div>
                </div>
            </ChildContent>
        </XFCollapse>
        <XFCollapse Title="@T("Itens do Pedido", "Order Items")" Variant="XFCollapseVariant.Surface" Size="XFSize.Md">
            <ChildContent><p class="text-sm text-text-secondary">3 @T("itens encontrados", "items found")</p></ChildContent>
        </XFCollapse>
    </div>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("Container expansivel", "Expandable container"), T("Revela e oculta conteudo com animacao suave.", "Reveals and hides content with smooth animation."), "expand"),
        new(T("WCAG AAA", "WCAG AAA"), T("aria-expanded, keyboard e heading hierarchy.", "aria-expanded, keyboard and heading hierarchy."), "universal-access"),
        new(T("4 animacoes", "4 animations"), T("None, Height, HeightFade e SlideFade.", "None, Height, HeightFade and SlideFade."), "sparkles"),
        new(T("5 variantes", "5 variants"), T("Plain, Soft, Surface, Outline e Ghost.", "Plain, Soft, Surface, Outline and Ghost."), "layers")
    ];

    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFCollapse"),
        new("Namespace", "XForge.DesignSystem.Components.Utilities.Collapse"),
        new("Package", "XForge.DesignSystem"),
        new("Category", "Utilities / Collapse"),
        new("Status", T("Estavel", "Stable")),
        new("Accessibility", T("aria-expanded, aria-controls, aria-labelledby, role=region, heading hierarchy.", "aria-expanded, aria-controls, aria-labelledby, role=region, heading hierarchy.")),
        new("Theme support", T("Light, dark e data-brand via tokens.", "Light, dark and data-brand via tokens."))
    ];

    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("Container expansivel", "Expandable container"), T("Revela e oculta conteudo com animacao suave.", "Reveals and hides content with smooth animation."), "expand"),
        new(T("Acessivel", "Accessible"), T("ARIA completo e navegacao por teclado.", "Full ARIA and keyboard navigation."), "universal-access"),
        new(T("4 animacoes", "4 animations"), T("None, Height, HeightFade e SlideFade.", "None, Height, HeightFade and SlideFade."), "sparkles")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Revelacao progressiva", "Progressive disclosure"), T("Oculta detalhes ate precisar.", "Hides details until needed."), "eye"),
        new(T("Organizacao", "Organization"), T("Agrupa informacoes em secoes.", "Groups info in sections."), "layer-group"),
        new(T("Semantica", "Semantics"), T("Heading hierarchy e ARIA.", "Heading hierarchy and ARIA."), "font")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Sem colapso", "Without collapse"), T("Paginas longas e confusas com tudo visivel.", "Long, confusing pages with everything visible."), "xmark"),
        new(T("Com XFCollapse", "With XFCollapse"), T("Secoes ocultas ate o usuario precisar.", "Sections hidden until the user needs them."), "check"),
        new(T("Acessibilidade", "Accessibility"), T("aria-expanded, aria-controls, role=region.", "aria-expanded, aria-controls, role=region."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Detalhes de pedido", "Order details"), T("Expandir itens e pagamento.", "Expand items and payment."), "check"),
        new(T("Configuracoes", "Settings"), T("Ocultar opcoes raras.", "Hide rare options."), "sliders"),
        new(T("FAQ", "FAQ"), T("Perguntas expansiveis.", "Expandable questions."), "circle-info")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Navegacao", "Not for navigation"), T("Use XFAccordion para multiplos itens.", "Use XFAccordion for multiple items."), "xmark"),
        new(T("Esconder criticas", "Don't hide critical"), T("Info essencial deve ser visivel.", "Essential info should be visible."), "xmark")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new(T("Container", "Container"), T("Wrapper com data-state e variant.", "Wrapper with data-state and variant."), "square"),
        new(T("Header (button)", "Header (button)"), T("Button com aria-expanded e icone.", "Button with aria-expanded and icon."), "arrow-pointer"),
        new(T("Panel (region)", "Panel (region)"), T("role=region com CSS Grid anim.", "role=region with CSS Grid anim."), "layers")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(T("Revelacao progressiva", "Progressive disclosure"), T("Reveal information on demand, not all at once.", "Reveal information on demand, not all at once."), "eye"),
        new(T("Heading semantico", "Semantic heading"), T("h3 wraps the header button for proper outline.", "h3 wraps the header button for proper outline."), "font"),
        new(T("GPU-accelerado", "GPU-accelerated"), T("CSS Grid rows transition with cubic-bezier easing.", "CSS Grid rows transition with cubic-bezier easing."), "bolt")
    ];

    // ─── Examples ───
    private RenderFragment ExBasic() => @<div class="grid gap-3 max-w-lg">
        <XFCollapse Title="@T("Informacoes do Cliente", "Customer Information")" Expanded="true">
            <ChildContent><p class="text-sm text-text-secondary">@T("Nome: Joao Silva, CPF: 123.456.789-00", "Name: John Smith, SSN: 123-45-6789")</p></ChildContent>
        </XFCollapse>
        <XFCollapse Title="@T("Endereco de Entrega", "Shipping Address")">
            <ChildContent><p class="text-sm text-text-secondary">@T("Rua das Flores, 123, Sao Paulo", "123 Main St, New York")</p></ChildContent>
        </XFCollapse>
    </div>;
    private string CodeBasic => "\x3CXFCollapse Title=\"Customer Information\" Expanded=\"true\">\n    \x3CChildContent>\x3Cp>Name: John Smith\x3C/p>\x3C/ChildContent>\n\x3C/XFCollapse>";

    private RenderFragment ExSizes() => @<div class="grid gap-3 max-w-lg">
        <XFCollapse Title="Small" Size="XFSize.Sm" Variant="XFCollapseVariant.Surface"><ChildContent><p class="text-sm text-text-secondary">@T("Compacto.", "Compact.")</p></ChildContent></XFCollapse>
        <XFCollapse Title="Medium" Size="XFSize.Md" Variant="XFCollapseVariant.Surface"><ChildContent><p class="text-sm text-text-secondary">@T("Padrao.", "Default.")</p></ChildContent></XFCollapse>
        <XFCollapse Title="Large" Size="XFSize.Lg" Variant="XFCollapseVariant.Surface"><ChildContent><p class="text-sm text-text-secondary">@T("Maior.", "Larger.")</p></ChildContent></XFCollapse>
    </div>;
    private string CodeSizes => "\x3CXFCollapse Title=\"Small\" Size=\"XFSize.Sm\" Variant=\"XFCollapseVariant.Surface\">\x3CChildContent\x3E\x3Cp class=\"text-sm text-text-secondary\"\x3ECompact.\x3C/p\x3E\x3C/ChildContent\x3E\n\x3C/XFCollapse>\n\x3CXFCollapse Title=\"Medium\" Size=\"XFSize.Md\" Variant=\"XFCollapseVariant.Surface\">\x3CChildContent\x3E\x3Cp class=\"text-sm text-text-secondary\"\x3EDefault.\x3C/p\x3E\x3C/ChildContent\x3E\n\x3C/XFCollapse>\n\x3CXFCollapse Title=\"Large\" Size=\"XFSize.Lg\" Variant=\"XFCollapseVariant.Surface\">\x3CChildContent\x3E\x3Cp class=\"text-sm text-text-secondary\"\x3ELarger.\x3C/p\x3E\x3C/ChildContent\x3E\n\x3C/XFCollapse>";

    private RenderFragment ExVariants() => @<div class="grid gap-3 max-w-lg">
        <XFCollapse Title="Plain" Variant="XFCollapseVariant.Plain" Expanded="true"><ChildContent><p class="text-sm text-text-secondary">Plain</p></ChildContent></XFCollapse>
        <XFCollapse Title="Soft" Variant="XFCollapseVariant.Soft" Expanded="true"><ChildContent><p class="text-sm text-text-secondary">Soft</p></ChildContent></XFCollapse>
        <XFCollapse Title="Surface" Variant="XFCollapseVariant.Surface" Expanded="true"><ChildContent><p class="text-sm text-text-secondary">Surface</p></ChildContent></XFCollapse>
        <XFCollapse Title="Outline" Variant="XFCollapseVariant.Outline" Expanded="true"><ChildContent><p class="text-sm text-text-secondary">Outline</p></ChildContent></XFCollapse>
        <XFCollapse Title="Ghost" Variant="XFCollapseVariant.Ghost" Expanded="true"><ChildContent><p class="text-sm text-text-secondary">Ghost</p></ChildContent></XFCollapse>
    </div>;
    private string CodeVariants => "\x3CXFCollapse Title=\"Plain\" Variant=\"XFCollapseVariant.Plain\" Expanded=\"true\">\x3CChildContent\x3E\x3Cp class=\"text-sm text-text-secondary\"\x3EPlain\x3C/p\x3E\x3C/ChildContent\x3E\n\x3C/XFCollapse>\n\x3CXFCollapse Title=\"Soft\" Variant=\"XFCollapseVariant.Soft\" Expanded=\"true\">\x3CChildContent\x3E\x3Cp class=\"text-sm text-text-secondary\"\x3ESoft\x3C/p\x3E\x3C/ChildContent\x3E\n\x3C/XFCollapse>\n\x3CXFCollapse Title=\"Surface\" Variant=\"XFCollapseVariant.Surface\" Expanded=\"true\">\x3CChildContent\x3E\x3Cp class=\"text-sm text-text-secondary\"\x3ESurface\x3C/p\x3E\x3C/ChildContent\x3E\n\x3C/XFCollapse>";

    private RenderFragment ExAnimations() => @<div class="grid gap-3 max-w-lg">
        <XFCollapse Title="None" Animation="XFCollapseAnimation.None" Variant="XFCollapseVariant.Surface"><ChildContent><p class="text-sm text-text-secondary">@T("Sem animacao.", "No animation.")</p></ChildContent></XFCollapse>
        <XFCollapse Title="Height" Animation="XFCollapseAnimation.Height" Variant="XFCollapseVariant.Surface"><ChildContent><p class="text-sm text-text-secondary">@T("Apenas altura.", "Height only.")</p></ChildContent></XFCollapse>
        <XFCollapse Title="HeightFade" Animation="XFCollapseAnimation.HeightFade" Variant="XFCollapseVariant.Surface"><ChildContent><p class="text-sm text-text-secondary">@T("Altura e opacidade.", "Height and opacity.")</p></ChildContent></XFCollapse>
        <XFCollapse Title="SlideFade" Animation="XFCollapseAnimation.SlideFade" Variant="XFCollapseVariant.Surface"><ChildContent><p class="text-sm text-text-secondary">@T("Slide e fade.", "Slide and fade.")</p></ChildContent></XFCollapse>
    </div>;
    private string CodeAnimations => "\x3CXFCollapse Title=\"None\" Animation=\"XFCollapseAnimation.None\" Variant=\"XFCollapseVariant.Surface\">\x3CChildContent\x3E\x3Cp class=\"text-sm text-text-secondary\"\x3ENo animation.\x3C/p\x3E\x3C/ChildContent\x3E\n\x3C/XFCollapse>\n\x3CXFCollapse Title=\"Height\" Animation=\"XFCollapseAnimation.Height\" Variant=\"XFCollapseVariant.Surface\">\x3CChildContent\x3E\x3Cp class=\"text-sm text-text-secondary\"\x3EHeight only.\x3C/p\x3E\x3C/ChildContent\x3E\n\x3C/XFCollapse>\n\x3CXFCollapse Title=\"HeightFade\" Animation=\"XFCollapseAnimation.HeightFade\" Variant=\"XFCollapseVariant.Surface\">\x3CChildContent\x3E\x3Cp class=\"text-sm text-text-secondary\"\x3EHeight and opacity.\x3C/p\x3E\x3C/ChildContent\x3E\n\x3C/XFCollapse>\n\x3CXFCollapse Title=\"SlideFade\" Animation=\"XFCollapseAnimation.SlideFade\" Variant=\"XFCollapseVariant.Surface\">\x3CChildContent\x3E\x3Cp class=\"text-sm text-text-secondary\"\x3ESlide and fade.\x3C/p\x3E\x3C/ChildContent\x3E\n\x3C/XFCollapse>";

    private RenderFragment ExIconModes() => @<div class="grid gap-3 max-w-lg">
        <XFCollapse Title="Chevron" IconMode="XFCollapseIconMode.Chevron" Variant="XFCollapseVariant.Surface"><ChildContent><p class="text-sm text-text-secondary">@T("Seta.", "Arrow.")</p></ChildContent></XFCollapse>
        <XFCollapse Title="PlusMinus" IconMode="XFCollapseIconMode.PlusMinus" Variant="XFCollapseVariant.Surface"><ChildContent><p class="text-sm text-text-secondary">@T("Mais e menos.", "Plus and minus.")</p></ChildContent></XFCollapse>
        <XFCollapse Title="None" IconMode="XFCollapseIconMode.None" Variant="XFCollapseVariant.Surface"><ChildContent><p class="text-sm text-text-secondary">@T("Sem icone.", "No icon.")</p></ChildContent></XFCollapse>
    </div>;
    private string CodeIconModes => "\x3CXFCollapse Title=\"Chevron\" IconMode=\"XFCollapseIconMode.Chevron\" Variant=\"XFCollapseVariant.Surface\">\x3CChildContent\x3E\x3Cp class=\"text-sm text-text-secondary\"\x3EArrow.\x3C/p\x3E\x3C/ChildContent\x3E\n\x3C/XFCollapse>\n\x3CXFCollapse Title=\"PlusMinus\" IconMode=\"XFCollapseIconMode.PlusMinus\" Variant=\"XFCollapseVariant.Surface\">\x3CChildContent\x3E\x3Cp class=\"text-sm text-text-secondary\"\x3EPlus and minus.\x3C/p\x3E\x3C/ChildContent\x3E\n\x3C/XFCollapse>\n\x3CXFCollapse Title=\"None\" IconMode=\"XFCollapseIconMode.None\" Variant=\"XFCollapseVariant.Surface\">\x3CChildContent\x3E\x3Cp class=\"text-sm text-text-secondary\"\x3ENo icon.\x3C/p\x3E\x3C/ChildContent\x3E\n\x3C/XFCollapse>";

    private RenderFragment ExSlots() => @<div class="grid gap-3 max-w-lg">
