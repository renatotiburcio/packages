@page "/forms/speech-to-text"

@using XForge.DesignSystem.Core.Primitives
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@T("Core Open Source", "Core Open Source")"
                 Title="@T("Speech To Text", "Speech To Text")"
                 Status="@T("Documentacao completa", "Complete docs")"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFSpeechToText" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Web Speech API", "Web Speech API")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Voz para texto", "Voice to text")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Formularios", "Forms")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">@T("Entrada por voz com captura, transcricao e fallback de texto.", "Voice input with capture, transcription and text fallback.")</XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">@T("XFSpeechToText usa a Web Speech API para capturar voz do usuario e transcrever em tempo real. Ideal para campos de descricao longa, notas de atendimento, ditado de relatorios e acessibilidade em dispositivos com suporte.", "XFSpeechToText uses the Web Speech API to capture user voice and transcribe in real time. Ideal for long description fields, service notes, report dictation and accessibility on supported devices.")</XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">@HeroPreview()</div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">@foreach (var item in QuickFacts) { @Tile(item) }</XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section(T("Blazor Server e Blazor WebAssembly", "Blazor Server and Blazor WebAssembly"), @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona com prerender-safe guards.", "Works with prerender-safe guards.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona com prerender-safe guards no primeiro render.", "Works with prerender-safe guards on first render.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Danger" Text="@T("Nao", "No")" /></XFTableCell><XFTableCell>@T("Web Speech API indisponivel em SSR. Requer navegador com suporte a SpeechRecognition.", "Web Speech API unavailable in SSR. Requires browser with SpeechRecognition support.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("JS Interop", "JS Interop")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Arquivo JS: xf-speechtotext.js — inicializa SpeechRecognition, gerencia eventos onresult/onerror/onend e expoe metodos start/stop.", "JS file: xf-speechtotext.js — initializes SpeechRecognition, manages onresult/onerror/onend events and exposes start/stop methods.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Quando carrega: OnAfterRenderAsync.", "When loaded: OnAfterRenderAsync.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Prerender seguro: try/catch para InvalidOperationException e JSDisconnectedException.", "Prerender safe: try/catch for InvalidOperationException and JSDisconnectedException.")</XFTypography>
                </XFStack>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Consideracoes Blazor Server", "Blazor Server Considerations")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("JS interop via SignalR com latencia. Streaming de audio pode ter resposta mais lenta.", "JS interop via SignalR with latency. Audio streaming may have slower response.")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Consideracoes Blazor WebAssembly", "Blazor WebAssembly Considerations")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("JS interop direto sem latencia de rede. Disponivel apos carregamento do WASM.", "Direct JS interop with no network latency. Available after WASM load.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("Preview renderizado", "Live Preview"), T("Botao de gravacao com variantes e tons.", "Recording button with variants and tones."), SpeechPreview(), SpeechCode)
            @Example(T("Variantes e tons", "Variants and tones"), T("Outline, Solid, Ghost com Default, Primary e Danger.", "Outline, Solid, Ghost with Default, Primary and Danger."), VariantsPreview(), VariantsCode)
            @Example(T("Estados", "States"), T("Idle e recording com visual diferenciado.", "Idle and recording with differentiated visual."), StatesPreview(), StatesCode)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Metodos", "Methods"), @<div>@NameValueTable(MethodRows, T("Metodo", "Method"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>

@code {
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);

    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFSpeechToText Language="pt-BR" Change="@(text => { })" />
        <XFStack Orientation="XFOrientation.Horizontal" Gap="3" Wrap="XFWrap.Wrap">
            <XFSpeechToText Language="pt-BR" Variant="XFFormVariant.Filled" Tone="XFSemanticColor.Primary" />
            <XFSpeechToText Language="pt-BR" Variant="XFFormVariant.Ghost" Tone="XFSemanticColor.Default" />
        </XFStack>
    </XFStack>;

    private RenderFragment SpeechPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFSpeechToText Language="pt-BR" StartLabel="@T("Falar", "Speak")" StopLabel="@T("Parar", "Stop")" />
        <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Clique para iniciar reconhecimento de voz.", "Click to start voice recognition.")</XFTypography>
    </XFStack>;

    private RenderFragment VariantsPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFStack Orientation="XFOrientation.Horizontal" Gap="3" Wrap="XFWrap.Wrap">
            <XFSpeechToText Variant="XFFormVariant.Outline" Tone="XFSemanticColor.Default" />
            <XFSpeechToText Variant="XFFormVariant.Filled" Tone="XFSemanticColor.Primary" />
            <XFSpeechToText Variant="XFFormVariant.Ghost" Tone="XFSemanticColor.Default" />
        </XFStack>
        <XFStack Orientation="XFOrientation.Horizontal" Gap="3" Wrap="XFWrap.Wrap">
            <XFSpeechToText Variant="XFFormVariant.Outline" Tone="XFSemanticColor.Primary" />
            <XFSpeechToText Variant="XFFormVariant.Outline" Tone="XFSemanticColor.Danger" />
        </XFStack>
    </XFStack>;

    private RenderFragment StatesPreview() => @<XFStack Orientation="XFOrientation.Horizontal" Gap="3" Wrap="XFWrap.Wrap">
        <XFSpeechToText Disabled="true" />
        <XFSpeechToText Size="XFSize.Sm" />
        <XFSpeechToText Size="XFSize.Lg" FullWidth="true" />
    </XFStack>;

    private RenderFragment Section(string title, RenderFragment content) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg"><Header><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography></Header><ChildContent>@content</ChildContent></XFCard>;
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");
    private RenderFragment Example(string title, string description, RenderFragment preview, string codeText) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.None" AreaRestricted="false"><Header><div class="px-6 pt-6"><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@description</XFTypography></div></Header><ChildContent><div class="grid"><div class="border-t border-border-light p-6">@preview</div><div class="border-t border-border-light bg-surface-50 p-6"><XFCode Text="@codeText" Language="razor" Title="@CopyableCodeTitle" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" /></div></div></ChildContent></XFCard>;
    private RenderFragment Tile(DocTile item) => @<XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true"><div class="flex items-center gap-4"><span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-primary/10 bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span><div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div></div><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography></XFStack></ChildContent></XFCard>;
    private RenderFragment TileGrid(IReadOnlyList<DocTile> items, int columns) => @<XFGrid Cols="1" Md="@Math.Min(columns, 2)" Lg="@columns" Gap="4">@foreach (var item in items) { @Tile(item) }</XFGrid>;
    private RenderFragment WarningGrid(IReadOnlyList<DocTile> items) => @<XFGrid Cols="1" Md="2" Gap="4">@foreach (var item in items) { <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true"><div class="flex items-center gap-4"><span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-danger/10 bg-danger/10 text-danger" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span><div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div></div><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography></XFStack></ChildContent></XFCard> }</XFGrid>;
    private RenderFragment NameValueTable(IReadOnlyList<NameValueRow> rows, string nameHeader, string valueHeader) => @<XFTable Striped="true" Hoverable="true" Compact="true"><XFTableHeader><XFTableRow><XFTableCell Header="true">@nameHeader</XFTableCell><XFTableCell Header="true">@valueHeader</XFTableCell></XFTableRow></XFTableHeader><XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Value</XFTableCell></XFTableRow> }</XFTableBody></XFTable>;
    private RenderFragment ApiTable(IReadOnlyList<ApiRow> rows) => @<XFTable Striped="true" Hoverable="true" Compact="true"><XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Parametro","Parameter")</XFTableCell><XFTableCell Header="true">Type</XFTableCell><XFTableCell Header="true">Default</XFTableCell><XFTableCell Header="true">@T("Descricao","Description")</XFTableCell></XFTableRow></XFTableHeader><XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Type</XFTableCell><XFTableCell><XFCode Text="@row.DefaultValue" /></XFTableCell><XFTableCell>@row.Description</XFTableCell></XFTableRow> }</XFTableBody></XFTable>;

    private string SpeechCode => @"<XFSpeechToText Language=""pt-BR"" Change=""@(text => HandleText(text))"" />";

    private string VariantsCode => @"<XFSpeechToText Variant=""XFFormVariant.Outline"" Tone=""XFSemanticColor.Default"" />
<XFSpeechToText Variant=""XFFormVariant.Filled"" Tone=""XFSemanticColor.Primary"" />
<XFSpeechToText Variant=""XFFormVariant.Ghost"" Tone=""XFSemanticColor.Default"" />";

    private string StatesCode => @"<XFSpeechToText Disabled=""true"" />
<XFSpeechToText Size=""XFSize.Sm"" />
<XFSpeechToText Size=""XFSize.Lg"" FullWidth=""true"" />";

    private IReadOnlyList<DocTile> QuickFacts => [new(T("Web Speech API", "Web Speech API"), T("Usa SpeechRecognition nativo do navegador.", "Uses native SpeechRecognition of the browser."), "microphone"), new(T("JS Interop", "JS Interop"), T("Modulo JS para inicializacao e controle.", "JS module for initialization and control."), "code"), new(T("Multi-lingua", "Multi-language"), T("Suporta qualquer idioma via Language.", "Supports any language via Language."), "globe")];
    private IReadOnlyList<NameValueRow> MetadataRows => [new("Component", "XFSpeechToText"), new("Namespace", "XForge.DesignSystem.Components.Forms.SpeechToText"), new("Package", "XForge.DesignSystem"), new("Category", T("Formularios / Entrada de voz", "Forms / Voice input")), new("Status", T("Estavel", "Stable")), new("Accessibility", T("aria-label e aria-pressed nativos.", "Native aria-label and aria-pressed."))];
    private IReadOnlyList<DocTile> OverviewItems => [new(T("Captura de voz", "Voice capture"), T("Reconhecimento de voz em tempo real.", "Real-time voice recognition."), "microphone"), new(T("Variantes visuais", "Visual variants"), T("Outline, Solid e Ghost.", "Outline, Solid and Ghost."), "layer-group"), new(T("Tons", "Tones"), T("Default, Primary e Danger.", "Default, Primary and Danger."), "palette")];
    private IReadOnlyList<DocTile> PurposeItems => [new(T("Ditado", "Dictation"), T("Permite entrada de texto por voz.", "Allows text input by voice."), "microphone"), new(T("Acessibilidade", "Accessibility"), T("Alternativa para usuarios com dificuldade de dig.", "Alternative for users with typing difficulty."), "universal-access")];
    private IReadOnlyList<DocTile> ProblemItems => [new(T("Antes", "Before"), T("Integracao manual com Web Speech API.", "Manual integration with Web Speech API."), "xmark"), new(T("Depois", "After"), T("Componente encapsulado com fallback.", "Encapsulated component with fallback."), "check")];
    private IReadOnlyList<DocTile> UseItems => [new(T("Campos longos", "Long fields"), T("Descricoes, notas, relatorios.", "Descriptions, notes, reports."), "file-lines"), new(T("Mobile", "Mobile"), T("Entrada por voz em dispositivos moveis.", "Voice input on mobile devices."), "mobile-screen")];
    private IReadOnlyList<DocTile> AvoidItems => [new(T("Campos criticos", "Critical fields"), T("Nao use para campos que exigem precisao (CPF, valores).", "Do not use for fields requiring precision (CPF, amounts)."), "xmark"), new(T("Ambiente ruidoso", "Noisy environment"), T("Reconhecimento falha em ambientes com ruido.", "Recognition fails in noisy environments."), "xmark")];
    private IReadOnlyList<DocTile> AnatomyItems => [new(T("Botao toggle", "Toggle button"), T("Elemento principal que inicia ou para gravacao.", "Main element that starts or stops recording."), "hand-pointer"), new(T("Label", "Label"), T("Texto StartLabel ou StopLabel conforme estado.", "StartLabel or StopLabel text based on state."), "font"), new(T("Indicador visual", "Visual indicator"), T("Mudanca de cor e estilo durante gravacao.", "Color and style change during recording."), "eye")];
    private IReadOnlyList<DocTile> AccessibilityItems => [new(T("aria-label", "aria-label"), T("Muda label conforme estado idle/recording.", "Changes label based on idle/recording state."), "universal-access"), new(T("aria-pressed", "aria-pressed"), T("Indica estado de gravacao.", "Indicates recording state."), "hand-pointer")];
    private IReadOnlyList<NameValueRow> KeyboardRows => [new("Enter", T("Alterna entre iniciar e parar gravacao.", "Toggles between start and stop recording.")), new("Space", T("Alterna entre iniciar e parar gravacao.", "Toggles between start and stop recording.")), new("Escape", T("Para gravacao se estiver ativa.", "Stops recording if active."))];
    private IReadOnlyList<DocTile> ResponsivenessItems => [new(T("FullWidth", "FullWidth"), T("Ocupa largura total em mobile.", "Fills width on mobile."), "mobile-screen")];
    private IReadOnlyList<DocTile> PerformanceItems => [new(T("Lazy JS", "Lazy JS"), T("Modulo JS carregado apenas no primeiro render.", "JS module loaded only on first render."), "bolt"), new(T("Cleanup", "Cleanup"), T("DisposeAsync limpa modulo e referencias.", "DisposeAsync cleans up module and references."), "shield-check")];
    private IReadOnlyList<DocTile> ScenarioItems => [new("ERP", T("Notas de atendimento e descricao de chamados.", "Service notes and ticket descriptions."), "briefcase"), new(T("RH", "HR"), T("Ditado de avaliacoes e feedbacks.", "Dictation of evaluations and feedbacks."), "users")];
    private IReadOnlyList<DocTile> CompositionItems => [new(T("SpeechToText + TextArea", "SpeechToText + TextArea"), T("Entrada por voz com fallback de texto.", "Voice input with text fallback."), "font"), new(T("SpeechToText + XFCard", "SpeechToText + XFCard"), T("Entrada de voz delimitada visualmente.", "Visually bounded voice input."), "square"), new(T("SpeechToText + Label", "SpeechToText + Label"), T("Campo com label descritivo acima.", "Field with descriptive label above."), "tag")];
    private IReadOnlyList<DocTile> BestPracticeItems => [new(T("Label claro", "Clear label"), T("Forneça StartLabel e StopLabel descritivos.", "Provide descriptive StartLabel and StopLabel."), "circle-check"), new(T("Fallback", "Fallback"), T("Ofereça campo de texto como alternativa.", "Offer text field as alternative."), "shield-check")];
    private IReadOnlyList<DocTile> AntiPatternItems => [new(T("Sem fallback", "No fallback"), T("Nem todos os navegadores suportam Web Speech API.", "Not all browsers support Web Speech API."), "xmark")];
    private IReadOnlyList<DocTile> ThemeItems => [new("data-theme", T("Botoes seguem tokens de cor.", "Buttons follow color tokens."), "moon")];
    private IReadOnlyList<NameValueRow> TokenRows => [new("border-surface-200", T("Borda padrao do botao.", "Default button border.")), new("bg-bg-surface", T("Fundo padrao do botao.", "Default button background.")), new("border-danger bg-danger", T("Estado de gravacao com Danger.", "Recording state with Danger.")), new("focus:ring-primary", T("Anel de foco com cor primaria.", "Focus ring with primary color.")), new("transition-all duration-200", T("Transicao suave entre estados.", "Smooth transition between states."))];
    private IReadOnlyList<NameValueRow> TestingRows => [new("Unit", T("Cobre render, variant, tone, size, disabled, fullWidth.", "Covers render, variant, tone, size, disabled, fullWidth.")), new("JS Interop", T("Mocks modulo JS para testes sem browser.", "Mocks JS module for tests without browser."))];
    private IReadOnlyList<NameValueRow> LimitationRows => [new(T("Browser support", "Browser support"), T("Alguns navegadores nao suportam Web Speech API.", "Some browsers do not support Web Speech API.")), new(T("Microfone", "Microphone"), T("Requer permissao de microfone do navegador.", "Requires browser microphone permission.")), new(T("Rede", "Network"), T("Reconhecimento requer conexao com a internet.", "Recognition requires internet connection.")), new(T("SSR", "SSR"), T("Nao funciona em Static SSR.", "Does not work in Static SSR."))];
