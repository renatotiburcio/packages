@page "/overlays/context-menu"
@page "/components/context-menu"
@using XForge.DesignSystem.Components.Overlays.ContextMenu
@using XForge.DesignSystem.Components.Overlays.DropdownMenu
@using XForge.DesignSystem.Core.Primitives
@using XForge.DesignSystem.Services
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFContextMenu" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("WAI-ARIA", "WAI-ARIA")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Submenus", "Submenus")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Enterprise", "Enterprise")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Menu contextual acessível para ações locais em tabelas, listas e superfícies interativas.",
                               "Accessible context menu for local actions on tables, lists and interactive surfaces.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("5 tipos de item (Action, XFCheckbox, XFRadio, Separator, Header), submenus, ícones, shortcuts, navegação por teclado e focus trap.",
                               "5 item types (Action, XFCheckbox, XFRadio, Separator, Header), submenus, icons, shortcuts, keyboard navigation and focus trap.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observações", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona com prerender-safe guards.", "Works with prerender-safe guards.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona com prerender-safe guards no primeiro render.", "Works with prerender-safe guards on first render.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Parcial", "Partial")" /></XFTableCell><XFTableCell>@T("Renderiza HTML base. Focus trap e posicionamento indisponíveis durante prerender.", "Renders base HTML. Focus trap and positioning unavailable during prerender.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("JS Interop", "JS Interop")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Arquivo JS: xf-contextmenu.js — gerencia xfFocusTrap.activate/release, posicionamento com CollisionPadding e fechamento por clique externo.", "JS file: xf-contextmenu.js — manages xfFocusTrap.activate/release, positioning with CollisionPadding and outside-click close.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Quando carrega: OnAfterRenderAsync. Prerender seguro: try/catch para InvalidOperationException e JSDisconnectedException.", "When loaded: OnAfterRenderAsync. Prerender safe: try/catch for InvalidOperationException and JSDisconnectedException.")</XFTypography>
                </XFStack>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Considerações", "Considerations")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor Server: JS interop via SignalR com latência. Focus trap e posicionamento podem ter resposta mais lenta.", "Blazor Server: JS interop via SignalR with latency. Focus trap and positioning may have slower response.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor WebAssembly: JS interop direto sem latência de rede. Disponível após carregamento do WASM.", "Blazor WebAssembly: Direct JS interop with no network latency. Available after WASM load.")</XFTypography>
                </XFStack>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visão geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Propósito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando não usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Hierarquia visual", "Visual Hierarchy"), @<div>@TileGrid(VisualHierarchyItems, 3)</div>)
            @Section(T("Princípios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Básico", "1. Basic"),
                T("Clique direito para abrir menu contextual com ações.", "Right-click to open context menu with actions."),
                ExBasic(), CodeBasic)

            @Example(T("2. Tipos de item", "2. Item types"),
                T("Action, XFCheckbox, XFRadio, Separator e Header.", "Action, XFCheckbox, XFRadio, Separator and Header."),
                ExItemTypes(), CodeItemTypes)

            @Example(T("3. Ícones", "3. Icons"),
                T("Itens com ícones SVG via RenderFragment Icon.", "Items with SVG icons via RenderFragment Icon."),
                ExIcons(), CodeIcons)

            @Example(T("4. Descrição e shortcuts", "4. Description & Shortcuts"),
                T("Itens com descrição e atalhos de teclado.", "Items with description and keyboard shortcuts."),
                ExDescription(), CodeDescription)

            @Example(T("5. Submenus", "5. Submenus"),
                T("Itens com Children para menus aninhados.", "Items with Children for nested menus."),
                ExSubmenus(), CodeSubmenus)

            @Example(T("6. Checkbox", "6. Checkbox"),
                T("Itens com Kind=XFCheckbox e Checked toggle.", "Items with Kind=XFCheckbox and Checked toggle."),
                ExCheckbox(), CodeCheckbox)

            @Example(T("7. Radio groups", "7. Radio Groups"),
                T("Itens com Kind=XFRadio e Group para seleção mutuamente exclusiva.", "Items with Kind=XFRadio and Group for mutually exclusive selection."),
                ExRadio(), CodeRadio)

            @Example(T("8. Desabilitado", "8. Disabled"),
                T("Itens desabilitados com Disabled=true.", "Disabled items with Disabled=true."),
                ExDisabled(), CodeDisabled)

            @Example(T("9. Tamanhos", "9. Sizes"),
                T("Sm, Md e Lg — larguras progressivas.", "Sm, Md and Lg — progressive widths."),
                ExSizes(), CodeSizes)

            @Example(T("10. Cenário enterprise", "10. Enterprise Scenario"),
                T("Menu de contexto em linha de tabela com ações de NF-e.", "Context menu on table row with NF-e actions."),
                ExEnterprise(), CodeEnterprise)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API — XFContextMenu", @<div>@ApiTable(ApiRows)</div>)
            @Section("API — XFDropdownMenuItem", @<div>@ApiTable(ItemApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenários enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padrões de composição", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas práticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padrões", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Propósito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidência", "Evidence"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Limitações conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitação", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versão", "Version"), T("Mudança", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>

@code {
    private string ProductLabelText => T("Core Open Source", "Core Open Source");
    private string PageTitleText => T("XFContextMenu", "XFContextMenu");
    private string PageStatusText => T("Documentação completa", "Complete docs");
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);
    private string CopyableCodeTitle => T("Código copiável", "Copyable code");

    private bool heroOpen;
    private bool basicOpen;
    private bool typeOpen;
    private bool iconOpen;
    private bool descOpen;
    private bool submenuOpen;
    private bool checkboxOpen;
    private bool radioOpen;
    private bool disabledOpen;
    private bool sizeSmOpen;
    private bool sizeMdOpen;
    private bool sizeLgOpen;
    private bool enterpriseOpen;

    private RenderFragment HeroPreview() => @<div>
        <XFContextMenu Open="heroOpen" OpenChanged="@(v => heroOpen = v)" Items="BasicItems" AriaLabel="Demo menu">
            <div class="flex h-40 cursor-context-menu items-center justify-center rounded-lg border-2 border-dashed border-primary/30 bg-primary/5 text-sm text-text-secondary">
                @T("Clique direito aqui", "Right-click here")
            </div>
        </XFContextMenu>
    </div>;

    private RenderFragment ExBasic() => @<div>
        <XFContextMenu Open="basicOpen" OpenChanged="@(v => basicOpen = v)" Items="BasicItems">
            <div class="flex h-32 cursor-context-menu items-center justify-center rounded-lg border-2 border-dashed border-border-light bg-surface-50 text-sm text-text-secondary">
                @T("Clique direito", "Right-click")
            </div>
        </XFContextMenu>
    </div>;

    private IReadOnlyList<XFDropdownMenuItem> BasicItems =>
    [
        new() { Text = T("Copiar", "Copy"), Icon = @<span class="inline-block h-4 w-4">@((MarkupString)XFSvgIcons.Markup("copy"))</span> },
        new() { Text = T("Colar", "Paste"), Icon = @<span class="inline-block h-4 w-4">@((MarkupString)XFSvgIcons.Markup("paste"))</span> },
        new() { Kind = XFDropdownMenuItemKind.Separator },
        new() { Text = T("Excluir", "Delete"), Icon = @<span class="inline-block h-4 w-4">@((MarkupString)XFSvgIcons.Markup("trash"))</span> }
    ];

    private RenderFragment ExItemTypes() => @<div>
        <XFContextMenu Open="typeOpen" OpenChanged="@(v => typeOpen = v)" Items="_typeItems">
            <div class="flex h-32 cursor-context-menu items-center justify-center rounded-lg border-2 border-dashed border-border-light bg-surface-50 text-sm text-text-secondary">
                @T("5 tipos de item", "5 item types")
            </div>
        </XFContextMenu>
    </div>;

    private readonly List<XFDropdownMenuItem> _typeItems =
    [
        new() { Text = "Header — Ações", Kind = XFDropdownMenuItemKind.Header },
        new() { Text = "Ação simples", Kind = XFDropdownMenuItemKind.Action },
        new() { Text = "Opção check", Kind = XFDropdownMenuItemKind.XFCheckbox, Checked = true },
        new() { Text = "Opção radio", Kind = XFDropdownMenuItemKind.XFRadio, Checked = true, Group = "mode" },
        new() { Kind = XFDropdownMenuItemKind.Separator },
        new() { Text = "Outra ação", Kind = XFDropdownMenuItemKind.Action }
    ];

    private RenderFragment ExIcons() => @<div>
        <XFContextMenu Open="iconOpen" OpenChanged="@(v => iconOpen = v)" Items="IconItems">
            <div class="flex h-32 cursor-context-menu items-center justify-center rounded-lg border-2 border-dashed border-border-light bg-surface-50 text-sm text-text-secondary">
                @T("Com ícones", "With icons")
            </div>
        </XFContextMenu>
    </div>;

    private IReadOnlyList<XFDropdownMenuItem> IconItems =>
    [
        new() { Text = T("Editar", "Edit"), Icon = @<span class="inline-block h-4 w-4">@((MarkupString)XFSvgIcons.Markup("pen"))</span> },
        new() { Text = T("Duplicar", "Duplicate"), Icon = @<span class="inline-block h-4 w-4">@((MarkupString)XFSvgIcons.Markup("copy"))</span> },
        new() { Text = T("Arquivar", "Archive"), Icon = @<span class="inline-block h-4 w-4">@((MarkupString)XFSvgIcons.Markup("box-archive"))</span> },
        new() { Kind = XFDropdownMenuItemKind.Separator },
        new() { Text = T("Excluir", "Delete"), Icon = @<span class="inline-block h-4 w-4">@((MarkupString)XFSvgIcons.Markup("trash"))</span>, Tone = XFSemanticColor.Danger }
    ];

    private RenderFragment ExDescription() => @<div>
        <XFContextMenu Open="descOpen" OpenChanged="@(v => descOpen = v)" Items="DescItems">
            <div class="flex h-32 cursor-context-menu items-center justify-center rounded-lg border-2 border-dashed border-border-light bg-surface-50 text-sm text-text-secondary">
                @T("Com descrição e shortcuts", "With description and shortcuts")
            </div>
        </XFContextMenu>
    </div>;

    private IReadOnlyList<XFDropdownMenuItem> DescItems =>
    [
        new() { Text = T("Copiar", "Copy"), Description = T("Copiar seleção", "Copy selection"), Shortcut = "Ctrl+C" },
        new() { Text = T("Colar", "Paste"), Description = T("Colar da área de transferência", "Paste from clipboard"), Shortcut = "Ctrl+V" },
        new() { Text = T("Desfazer", "Undo"), Description = T("Desfazer última ação", "Undo last action"), Shortcut = "Ctrl+Z" },
        new() { Text = T("Refazer", "Redo"), Description = T("Refazer ação desfeita", "Redo undone action"), Shortcut = "Ctrl+Y" }
    ];

    private RenderFragment ExSubmenus() => @<div>
        <XFContextMenu Open="submenuOpen" OpenChanged="@(v => submenuOpen = v)" Items="SubmenuItems">
            <div class="flex h-32 cursor-context-menu items-center justify-center rounded-lg border-2 border-dashed border-border-light bg-surface-50 text-sm text-text-secondary">
                @T("Com submenus", "With submenus")
            </div>
        </XFContextMenu>
    </div>;

    private IReadOnlyList<XFDropdownMenuItem> SubmenuItems =>
    [
        new() { Text = T("Ordenar por", "Sort by"), Children = [
            new() { Text = T("Nome", "Name") },
            new() { Text = T("Data", "Date") },
            new() { Text = T("Tamanho", "Size") }
        ]},
        new() { Text = T("Exportar como", "Export as"), Children = [
            new() { Text = "PDF" },
            new() { Text = "CSV" },
            new() { Text = "XLSX" }
        ]},
        new() { Kind = XFDropdownMenuItemKind.Separator },
        new() { Text = T("Propriedades", "Properties") }
    ];

    private RenderFragment ExCheckbox() => @<div>
        <XFContextMenu Open="checkboxOpen" OpenChanged="@(v => checkboxOpen = v)" Items="_checkboxItems">
            <div class="flex h-32 cursor-context-menu items-center justify-center rounded-lg border-2 border-dashed border-border-light bg-surface-50 text-sm text-text-secondary">
                @T("Checkbox items", "Checkbox items")
            </div>
        </XFContextMenu>
    </div>;

    private readonly List<XFDropdownMenuItem> _checkboxItems =
    [
        new() { Text = "Mostrar colunas", Kind = XFDropdownMenuItemKind.Header },
        new() { Text = "ID", Kind = XFDropdownMenuItemKind.XFCheckbox, Checked = true },
        new() { Text = "Nome", Kind = XFDropdownMenuItemKind.XFCheckbox, Checked = true },
        new() { Text = "Status", Kind = XFDropdownMenuItemKind.XFCheckbox, Checked = true },
        new() { Text = "Data de criação", Kind = XFDropdownMenuItemKind.XFCheckbox },
        new() { Text = "Responsável", Kind = XFDropdownMenuItemKind.XFCheckbox },
        new() { Kind = XFDropdownMenuItemKind.Separator },
        new() { Text = "Aplicar", Kind = XFDropdownMenuItemKind.Action, Tone = XFSemanticColor.Primary }
    ];

    private RenderFragment ExRadio() => @<div>
        <XFContextMenu Open="radioOpen" OpenChanged="@(v => radioOpen = v)" Items="_radioItems">
            <div class="flex h-32 cursor-context-menu items-center justify-center rounded-lg border-2 border-dashed border-border-light bg-surface-50 text-sm text-text-secondary">
                @T("Radio groups", "Radio groups")
            </div>
        </XFContextMenu>
    </div>;

    private readonly List<XFDropdownMenuItem> _radioItems =
    [
        new() { Text = "Ordenação", Kind = XFDropdownMenuItemKind.Header },
        new() { Text = "Nenhum", Kind = XFDropdownMenuItemKind.XFRadio, Group = "sort", Checked = true },
        new() { Text = "Crescente", Kind = XFDropdownMenuItemKind.XFRadio, Group = "sort" },
        new() { Text = "Decrescente", Kind = XFDropdownMenuItemKind.XFRadio, Group = "sort" },
        new() { Kind = XFDropdownMenuItemKind.Separator },
        new() { Text = "Densidade", Kind = XFDropdownMenuItemKind.Header },
        new() { Text = "Compacto", Kind = XFDropdownMenuItemKind.XFRadio, Group = "density" },
        new() { Text = "Normal", Kind = XFDropdownMenuItemKind.XFRadio, Group = "density", Checked = true },
        new() { Text = "Confortável", Kind = XFDropdownMenuItemKind.XFRadio, Group = "density" },
        new() { Kind = XFDropdownMenuItemKind.Separator },
        new() { Text = "Salvar preferências", Kind = XFDropdownMenuItemKind.Action, Tone = XFSemanticColor.Primary }
    ];

    private RenderFragment ExDisabled() => @<div>
        <XFContextMenu Open="disabledOpen" OpenChanged="@(v => disabledOpen = v)" Items="DisabledItems">
            <div class="flex h-32 cursor-context-menu items-center justify-center rounded-lg border-2 border-dashed border-border-light bg-surface-50 text-sm text-text-secondary">
                @T("Itens desabilitados", "Disabled items")
            </div>
        </XFContextMenu>
    </div>;

    private IReadOnlyList<XFDropdownMenuItem> DisabledItems =>
    [
        new() { Text = T("Disponível", "Available") },
        new() { Text = T("Desabilitado", "Disabled"), Disabled = true },
        new() { Text = T("Outro disponível", "Another available") },
        new() { Text = T("Sem permissão", "No permission"), Disabled = true, Description = T("Requer role admin", "Requires admin role") }
    ];

    private RenderFragment ExSizes() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <div>
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="Sm" />
            <XFContextMenu Open="sizeSmOpen" OpenChanged="@(v => sizeSmOpen = v)" Items="BasicItems" Size="XFSize.Sm">
                <div class="mt-1 flex h-24 cursor-context-menu items-center justify-center rounded-lg border-2 border-dashed border-border-light bg-surface-50 text-xs text-text-secondary">Sm</div>
            </XFContextMenu>
        </div>
        <div>
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="Md" />
            <XFContextMenu Open="sizeMdOpen" OpenChanged="@(v => sizeMdOpen = v)" Items="BasicItems" Size="XFSize.Md">
                <div class="mt-1 flex h-24 cursor-context-menu items-center justify-center rounded-lg border-2 border-dashed border-border-light bg-surface-50 text-xs text-text-secondary">Md</div>
            </XFContextMenu>
        </div>
        <div>
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="Lg" />
            <XFContextMenu Open="sizeLgOpen" OpenChanged="@(v => sizeLgOpen = v)" Items="BasicItems" Size="XFSize.Lg">
                <div class="mt-1 flex h-24 cursor-context-menu items-center justify-center rounded-lg border-2 border-dashed border-border-light bg-surface-50 text-xs text-text-secondary">Lg</div>
            </XFContextMenu>
        </div>
    </XFStack>;

    private RenderFragment ExEnterprise() => @<div>
        <XFContextMenu Open="enterpriseOpen" OpenChanged="@(v => enterpriseOpen = v)" Items="EnterpriseItems" AriaLabel="NF-e actions">
            <table class="w-full text-sm">
                <thead><tr class="border-b border-border-light text-left text-xs text-text-muted">
                    <th class="px-3 py-2">NF-e</th><th class="px-3 py-2">@T("Cliente", "Client")</th><th class="px-3 py-2">@T("Valor", "Amount")</th><th class="px-3 py-2">@T("Status", "Status")</th>
                </tr></thead>
                <tbody><tr class="cursor-context-menu hover:bg-surface-50">
                    <td class="px-3 py-2 font-mono">2026/0042</td>
                    <td class="px-3 py-2">Silva Comércio</td>
                    <td class="px-3 py-2">R$ 12.450,00</td>
