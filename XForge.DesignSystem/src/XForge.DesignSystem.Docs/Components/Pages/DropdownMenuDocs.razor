@page "/overlays/dropdown-menu"
@page "/components/dropdown-menu"
@using XForge.DesignSystem.Components.Overlays.DropdownMenu
@using XForge.DesignSystem.Services
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFDropdownMenu" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("WAI-ARIA", "WAI-ARIA")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Submenus", "Submenus")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Enterprise", "Enterprise")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Menu de ações contextual com grupos, submenus e navegação por teclado.",
                               "Contextual action menu with groups, submenus and keyboard navigation.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("XFDropdownMenu renderiza menus com 5 tipos de itens (Action, Checkbox, Radio, Separator, Header), atalhos, badges, ícones, submenus e navegação WAI-ARIA por setas.",
                               "XFDropdownMenu renders menus with 5 item types (Action, Checkbox, Radio, Separator, Header), shortcuts, badges, icons, submenus and WAI-ARIA arrow navigation.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light p-6">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observações", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estático. Interações requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependências JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente não utiliza JavaScript interop. É puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderização.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Considerações", "Considerations")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor Server: eventos são tratados via SignalR. Sem latência adicional para componentes puramente renderizados.", "Blazor Server: events are handled via SignalR. No additional latency for purely rendered components.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor WebAssembly: eventos são tratados diretamente no cliente. Mais responsivo.", "Blazor WebAssembly: events are handled directly on the client. More responsive.")</XFTypography>
                </XFStack>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visão geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Propósito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando não usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Hierarquia visual", "Visual Hierarchy"), @<div>@TileGrid(VisualHierarchyItems, 3)</div>)
            @Section(T("Princípios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Básico", "1. Basic"),
                T("Menu simples com 3 itens: Editar, Duplicar e Excluir.", "Simple menu with 3 items: Edit, Duplicate and Delete."),
                ExBasic(), CodeBasic)

            @Example(T("2. Tipos de itens", "2. Item Kinds"),
                T("5 tipos: Action, Checkbox, Radio, Separator e Header.", "5 types: Action, Checkbox, Radio, Separator and Header."),
                ExKinds(), CodeKinds)

            @Example(T("3. Ícones", "3. Icons"),
                T("Itens com ícones SVG via propriedade Icon (RenderFragment).", "Items with SVG icons via Icon property (RenderFragment)."),
                ExIcons(), CodeIcons)

            @Example(T("4. Descrição e atalhos", "4. Description & Shortcuts"),
                T("Itens com descrição secundária e atalhos de teclado.", "Items with secondary description and keyboard shortcuts."),
                ExDescription(), CodeDescription)

            @Example(T("5. Submenus", "5. Submenus"),
                T("Itens com Children abrem submenu lateral. Navegação por setas.", "Items with Children open side submenu. Arrow navigation."),
                ExSubmenus(), CodeSubmenus)

            @Example(T("6. Checkbox", "6. Checkbox"),
                T("XFCheckbox para alternar estados com two-way binding.", "XFCheckbox to toggle states with two-way binding."),
                ExCheckbox(), CodeCheckbox)

            @Example(T("7. Radio groups", "7. Radio Groups"),
                T("XFRadioGroup com XFRadio para seleção mutuamente exclusiva.", "XFRadioGroup with XFRadio for mutually exclusive selection."),
                ExRadio(), CodeRadio)

            @Example(T("8. Desabilitado", "8. Disabled"),
                T("Itens desabilitados com Disabled=true.", "Disabled items with Disabled=true."),
                ExDisabled(), CodeDisabled)

            @Example(T("9. Posicionamento", "9. Placement"),
                T("Placement (Top/Bottom/Left/Right) e Alignment (Start/Center/End).", "Placement (Top/Bottom/Left/Right) and Alignment (Start/Center/End)."),
                ExPlacement(), CodePlacement)

            @Example(T("10. Cenário enterprise", "10. Enterprise Scenario"),
                T("Menu de ações da grid ERP com grupos, atalhos e submenus.", "ERP grid action menu with groups, shortcuts and submenus."),
                ExEnterprise(), CodeEnterprise)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Variantes", "Variants"), @<div>@NameValueTable(ItemKindRows, T("Tipo", "Type"), T("Uso", "Usage"))</div>)
            @Section("API — XFDropdownMenu", @<div>@ApiTable(ApiRows)</div>)
            @Section("API — XFDropdownMenuItem", @<div>@ApiTable(ItemApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenários enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padrões de composição", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas práticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padrões", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Propósito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidência", "Evidence"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Limitações conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitação", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versão", "Version"), T("Mudança", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>

@code {
    private string ProductLabelText => T("Core Open Source", "Core Open Source");
    private string PageTitleText => T("XFDropdownMenu", "XFDropdownMenu");
    private string PageStatusText => T("Documentação completa", "Complete docs");
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);
    private string CopyableCodeTitle => T("Código copiável", "Copyable code");

    private bool _heroOpen = true;
    private bool _basicOpen;
    private bool _kindsOpen;
    private bool _iconsOpen;
    private bool _descOpen;
    private bool _submenuOpen;
    private bool _disabledOpen;
    private bool _entOpen;

    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFDropdownMenu ButtonText="@T("Ações", "Actions")"
                        Items="HeroItems"
                        @bind-Open="_heroOpen"
                        ActiveTone="XFSemanticColor.Primary" />
    </XFStack>;

    private IReadOnlyList<XFDropdownMenuItem> HeroItems =>
    [
        new() { Text = T("Editar", "Edit"), Icon = @<span class="inline-block h-4 w-4">@((MarkupString)XFSvgIcons.Markup("pencil"))</span>, Shortcut = "E", Tone = XFSemanticColor.Primary },
        new() { Text = T("Duplicar", "Duplicate"), Icon = @<span class="inline-block h-4 w-4">@((MarkupString)XFSvgIcons.Markup("copy"))</span>, Badge = "novo" },
        new() { Kind = XFDropdownMenuItemKind.Separator },
        new() { Text = T("Excluir", "Delete"), Icon = @<span class="inline-block h-4 w-4">@((MarkupString)XFSvgIcons.Markup("trash"))</span>, Tone = XFSemanticColor.Danger }
    ];

    private IReadOnlyList<DocTile> QuickFacts =>
    [
        new(T("WAI-ARIA menu", "WAI-ARIA menu"), T("role=menu, menuitem, menuitemcheckbox, menuitemradio, aria-activedescendant.", "role=menu, menuitem, menuitemcheckbox, menuitemradio, aria-activedescendant."), "universal-access"),
        new(T("5 tipos de itens", "5 item types"), T("Action, Checkbox, Radio, Separator e Header com ícones e atalhos.", "Action, Checkbox, Radio, Separator and Header with icons and shortcuts."), "list"),
        new(T("Submenus", "Submenus"), T("Children recursivos com submenu lateral e navegação por setas.", "Recursive Children with side submenu and arrow navigation."), "code")
    ];

    private IReadOnlyList<NameValueRow> MetadataRows =>
    [
        new("Component", "XFDropdownMenu"),
        new("Namespace", "XForge.DesignSystem.Components.Overlays.DropdownMenu"),
        new("Package", "XForge.DesignSystem"),
        new("Category", "Components / Overlays / DropdownMenu"),
        new("Status", T("Estável", "Stable")),
        new("Accessibility", T("WAI-ARIA menu, keyboard (arrows, Home, End, Enter, Escape), aria-activedescendant.", "WAI-ARIA menu, keyboard (arrows, Home, End, Enter, Escape), aria-activedescendant.")),
        new("Theme support", T("Light, dark via CSS variables.", "Light, dark via CSS variables."))
    ];

    private IReadOnlyList<DocTile> OverviewItems =>
    [
        new(T("Menu contextual", "Contextual menu"), T("Renderiza menu de ações com botão trigger e popover.", "Renders action menu with trigger button and popover."), "bars"),
        new(T("5 tipos de itens", "5 item types"), T("Action, Checkbox, Radio, Separator e Header para todos os cenários.", "Action, Checkbox, Radio, Separator and Header for all scenarios."), "list"),
        new(T("Submenus", "Submenus"), T("Children recursivos para menus aninhados.", "Recursive Children for nested menus."), "code")
    ];

    private IReadOnlyList<DocTile> PurposeItems =>
    [
        new(T("Ações agrupadas", "Grouped actions"), T("Agrupar múltiplas ações em um único trigger para economizar espaço.", "Group multiple actions into a single trigger to save space."), "bars"),
        new(T("Seleção de opções", "Option selection"), T("Checkbox e Radio para seleção de colunas, modos e configurações.", "Checkbox and Radio for column, mode and settings selection."), "check-circle"),
        new(T("Navegação por teclado", "Keyboard navigation"), T("Setas, Home, End, Enter e Escape para acesso completo via teclado.", "Arrows, Home, End, Enter and Escape for full keyboard access."), "keyboard")
    ];

    private IReadOnlyList<DocTile> ProblemItems =>
    [
        new(T("Antes", "Before"), T("Botões de ação espalhados na tela, sem contexto visual.", "Action buttons scattered on screen, no visual context."), "xmark"),
        new(T("Depois", "After"), T("Menu agrupado com atalhos, ícones e submenus. Um trigger abre todas as ações.", "Grouped menu with shortcuts, icons and submenus. One trigger opens all actions."), "check"),
        new(T("Risco reduzido", "Reduced risk"), T("WAI-ARIA menu, keyboard navigation, aria-activedescendant.", "WAI-ARIA menu, keyboard navigation, aria-activedescendant."), "shield-check")
    ];

    private IReadOnlyList<DocTile> UseItems =>
    [
        new(T("Ações de grid", "Grid actions"), T("Menu de contexto para linhas de tabela: editar, duplicar, excluir.", "Context menu for table rows: edit, duplicate, delete."), "table-cells"),
        new(T("Filtros", "Filters"), T("Menu de filtros com checkbox para colunas visíveis.", "Filter menu with checkboxes for visible columns."), "filter"),
        new(T("Configurações", "Settings"), T("Menu de opções com radio para modo de exibição.", "Options menu with radio for display mode."), "sliders"),
        new(T("Ações de toolbar", "Toolbar actions"), T("Menu de ações agrupadas na toolbar.", "Grouped action menu in toolbar."), "bars")
    ];

    private IReadOnlyList<DocTile> AvoidItems =>
    [
        new(T("Navegação principal", "Primary navigation"), T("Use Sidebar ou Rail para navegação entre páginas.", "Use Sidebar or Rail for page navigation."), "route"),
        new(T("Formulários", "Forms"), T("Use select nativo ou XFSelect para campos de formulário.", "Use native select or XFSelect for form fields."), "file-lines"),
        new(T("Ação única", "Single action"), T("Se há apenas uma ação, use um botão direto.", "If there is only one action, use a direct button."), "square")
    ];

    private IReadOnlyList<DocTile> AnatomyItems =>
    [
        new(T("Trigger", "Trigger"), T("Botão padrão com ButtonText e chevron. Suporta Trigger template.", "Default button with ButtonText and chevron. Supports Trigger template."), "hand-pointer"),
        new(T("Popover", "Popover"), T("XFPopover controla posicionamento, fechamento e backdrop.", "XFPopover handles positioning, closing and backdrop."), "layer-group"),
        new(T("Menu (role=menu)", "Menu (role=menu)"), T("Div com role=menu, aria-label e navegação por setas.", "Div with role=menu, aria-label and arrow navigation."), "bars"),
        new(T("Menu item", "Menu item"), T("Botão com role=menuitem, icon, text, shortcut, badge.", "Button with role=menuitem, icon, text, shortcut, badge."), "square"),
        new(T("Submenu", "Submenu"), T("Children recursivos com role=menu e chevron-right.", "Recursive Children with role=menu and chevron-right."), "code")
    ];

    private IReadOnlyList<DocTile> VisualHierarchyItems =>
    [
        new(T("Action", "Action"), T("Item clicável padrão. Dispara ItemSelected e fecha (CloseOnSelect).", "Default clickable item. Fires ItemSelected and closes (CloseOnSelect)."), "hand-pointer"),
        new(T("Checkbox/Radio", "Checkbox/Radio"), T("Indicador visual de estado marcado com aria-checked.", "Visual checked state indicator with aria-checked."), "check-circle"),
        new(T("Header/Separator", "Header/Separator"), T("Header para títulos de seção, Separator para divisão visual.", "Header for section titles, Separator for visual division."), "minus")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems =>
    [
        new(T("Atalhos visíveis", "Visible shortcuts"), T("kbd com estilo para atalhos de teclado (Ctrl+S, etc.).", "Styled kbd for keyboard shortcuts (Ctrl+S, etc.)."), "keyboard"),
        new(T("Tons semânticos", "Semantic tones"), T("Primary para destaque, Danger para exclusão, Warning para cancelamento.", "Primary for highlight, Danger for deletion, Warning for cancellation."), "swatchbook"),
        new(T("Touch target", "Touch target"), T("py-2 em cada item garante altura mínima para toque.", "py-2 on each item ensures minimum touch height."), "hand-pointer"),
        new(T("Overflow inteligente", "Smart overflow"), T("max-h-80 com scroll, submenus expandem sem corte.", "max-h-80 with scroll, submenus expand without clipping."), "arrows-left-right")
    ];

    // === EXAMPLES ===
    private RenderFragment ExBasic() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFDropdownMenu ButtonText="@T("Ações", "Actions")"
                        Items="BasicItems"
                        @bind-Open="_basicOpen"
                        ActiveTone="XFSemanticColor.Primary" />
    </XFStack>;

    private IReadOnlyList<XFDropdownMenuItem> BasicItems =>
    [
        new() { Text = T("Editar", "Edit"), Shortcut = "E", Tone = XFSemanticColor.Primary },
        new() { Text = T("Duplicar", "Duplicate") },
        new() { Text = T("Excluir", "Delete"), Tone = XFSemanticColor.Danger }
    ];

    private RenderFragment ExKinds() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFDropdownMenu ButtonText="@T("Tipos", "Types")"
                        Items="KindsItems"
                        @bind-Open="_kindsOpen"
                        ActiveTone="XFSemanticColor.Primary" />
    </XFStack>;

    private IReadOnlyList<XFDropdownMenuItem> KindsItems =>
    [
        new() { Text = T("Seção", "Section"), Kind = XFDropdownMenuItemKind.Header },
        new() { Text = T("Ação", "Action"), Kind = XFDropdownMenuItemKind.Action },
        new() { Text = T("Opção toggle", "Toggle option"), Kind = XFDropdownMenuItemKind.XFCheckbox, Checked = true },
        new() { Kind = XFDropdownMenuItemKind.Separator },
        new() { Text = T("Opção A", "Option A"), Kind = XFDropdownMenuItemKind.XFRadio, Checked = true, Group = "view" },
        new() { Text = T("Opção B", "Option B"), Kind = XFDropdownMenuItemKind.XFRadio, Group = "view" }
    ];

    private RenderFragment ExIcons() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFDropdownMenu ButtonText="@T("Ações", "Actions")"
                        Items="IconItems"
                        @bind-Open="_iconsOpen"
                        ActiveTone="XFSemanticColor.Primary" />
    </XFStack>;

    private IReadOnlyList<XFDropdownMenuItem> IconItems =>
    [
        new() { Text = T("Editar", "Edit"), Icon = @<span class="inline-block h-4 w-4">@((MarkupString)XFSvgIcons.Markup("pencil"))</span>, Tone = XFSemanticColor.Primary },
        new() { Text = T("Duplicar", "Duplicate"), Icon = @<span class="inline-block h-4 w-4">@((MarkupString)XFSvgIcons.Markup("copy"))</span> },
        new() { Text = T("Imprimir", "Print"), Icon = @<span class="inline-block h-4 w-4">@((MarkupString)XFSvgIcons.Markup("print"))</span> },
        new() { Kind = XFDropdownMenuItemKind.Separator },
        new() { Text = T("Excluir", "Delete"), Icon = @<span class="inline-block h-4 w-4">@((MarkupString)XFSvgIcons.Markup("trash"))</span>, Tone = XFSemanticColor.Danger }
    ];

    private RenderFragment ExDescription() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFDropdownMenu ButtonText="@T("Arquivo", "File")"
                        Items="DescItems"
                        @bind-Open="_descOpen"
                        ActiveTone="XFSemanticColor.Primary" />
    </XFStack>;

    private IReadOnlyList<XFDropdownMenuItem> DescItems =>
    [
        new() { Text = T("Salvar", "Save"), Description = T("Salva o arquivo atual", "Saves current file"), Shortcut = "Ctrl+S", Tone = XFSemanticColor.Primary },
        new() { Text = T("Salvar como", "Save As"), Description = T("Salva com novo nome", "Saves with new name"), Shortcut = "Ctrl+Shift+S" },
        new() { Text = T("Exportar PDF", "Export PDF"), Description = T("Exporta como documento PDF", "Exports as PDF document"), Badge = "novo" },
        new() { Kind = XFDropdownMenuItemKind.Separator },
        new() { Text = T("Fechar", "Close"), Description = T("Fecha sem salvar", "Closes without saving"), Shortcut = "Ctrl+W", Tone = XFSemanticColor.Warning }
    ];

    private RenderFragment ExSubmenus() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFDropdownMenu ButtonText="@T("Exportar", "Export")"
                        Items="SubmenuItems"
                        @bind-Open="_submenuOpen"
                        ActiveTone="XFSemanticColor.Primary" />
    </XFStack>;

    private IReadOnlyList<XFDropdownMenuItem> SubmenuItems =>
    [
        new() { Text = T("Exportar como", "Export as"), Children = [
