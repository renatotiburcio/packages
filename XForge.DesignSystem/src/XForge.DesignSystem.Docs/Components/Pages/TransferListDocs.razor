@page "/forms/transfer-list"

@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@T("Core Open Source", "Core Open Source")"
                 Title="@T("Transfer List", "Transfer List")"
                 Status="@T("Documentacao completa", "Complete docs")"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFTransferList" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Dual-list", "Dual-list")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Permissoes", "Permissions")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Formularios", "Forms")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">@T("Movimentacao de itens entre listas para permissoes, grupos e selecoes complexas.", "Item movement between lists for permissions, groups and complex selections.")</XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">@T("XFTransferList exibe duas listas lado a lado com botoes para mover itens da origem (disponiveis) para o destino (selecionados). Suporta busca, selecao multipla, mover todos, itens desabilitados e live region para acessibilidade. Ideal para atribuicao de permissoes, grupos, modulos e recursos.", "XFTransferList displays two lists side by side with buttons to move items from source (available) to target (selected). Supports search, multi-select, move all, disabled items and live region for accessibility. Ideal for assigning permissions, groups, modules and resources.")</XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">@HeroPreview()</div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">@foreach (var item in QuickFacts) { @Tile(item) }</XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico. Interacoes requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderizacao.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Consideracoes", "Considerations")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor Server: eventos sao tratados via SignalR. Sem latencia adicional para componentes puramente renderizados.", "Blazor Server: events are handled via SignalR. No additional latency for purely rendered components.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor WebAssembly: eventos sao tratados diretamente no cliente. Mais responsivo.", "Blazor WebAssembly: events are handled directly on the client. More responsive.")</XFTypography>
                </XFStack>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("Preview renderizado", "Live Preview"), T("Transfer list com permissoes de ERP.", "Transfer list with ERP permissions."), TransferPreview(), TransferCode)
            @Example(T("Com itens desabilitados", "With Disabled Items"), T("Itens desabilitados nao podem ser movidos.", "Disabled items cannot be moved."), DisabledPreview(), DisabledCode)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>

@code {
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);

    private IReadOnlyList<XFTransferListItem> DemoItems => [
        new() { Value = "fin-view", Text = T("Visualizar financeiro", "View finance"), Description = T("Somente leitura", "Read only") },
        new() { Value = "fin-edit", Text = T("Editar financeiro", "Edit finance") },
        new() { Value = "fin-approve", Text = T("Aprovar pagamentos", "Approve payments"), Description = T("Requer supervisor", "Requires supervisor") },
        new() { Value = "fiscal-view", Text = T("Visualizar fiscal", "View fiscal") },
        new() { Value = "fiscal-edit", Text = T("Editar fiscal", "Edit fiscal") },
        new() { Value = "stock-transfer", Text = T("Transferir estoque", "Transfer stock") },
        new() { Value = "hr-manage", Text = T("Gerenciar RH", "Manage HR"), Disabled = true }
    ];

    private IReadOnlyList<string> DemoTarget = ["fin-view", "fiscal-view"];

    private RenderFragment HeroPreview() => @<XFTransferList Items="DemoItems" TargetValues="DemoTarget" SourceLabel="@T("Disponiveis", "Available")" TargetLabel="@T("Selecionados", "Selected")" />;

    private RenderFragment TransferPreview() => @<XFTransferList Items="DemoItems" TargetValues="DemoTarget" SourceLabel="@T("Permissoes disponiveis", "Available permissions")" TargetLabel="@T("Permissoes ativas", "Active permissions")" Searchable="true" />;

    private IReadOnlyList<XFTransferListItem> DisabledDemoItems => [
        new() { Value = "a", Text = "Item A" },
        new() { Value = "b", Text = "Item B", Disabled = true },
        new() { Value = "c", Text = "Item C" }
    ];

    private RenderFragment DisabledPreview() => @<XFTransferList Items="DisabledDemoItems" TargetValues="Array.Empty<string>()" />;

    private RenderFragment Section(string title, RenderFragment content) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg"><Header><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography></Header><ChildContent>@content</ChildContent></XFCard>;
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");
    private RenderFragment Example(string title, string description, RenderFragment preview, string codeText) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.None" AreaRestricted="false"><Header><div class="px-6 pt-6"><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@description</XFTypography></div></Header><ChildContent><div class="grid"><div class="border-t border-border-light p-6">@preview</div><div class="border-t border-border-light bg-surface-50 p-6"><XFCode Text="@codeText" Language="razor" Title="@CopyableCodeTitle" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" /></div></div></ChildContent></XFCard>;
    private RenderFragment Tile(DocTile item) => @<XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true"><div class="flex items-center gap-4"><span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-primary/10 bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span><div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div></div><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography></XFStack></ChildContent></XFCard>;
    private RenderFragment TileGrid(IReadOnlyList<DocTile> items, int columns) => @<XFGrid Cols="1" Md="@Math.Min(columns, 2)" Lg="@columns" Gap="4">@foreach (var item in items) { @Tile(item) }</XFGrid>;
    private RenderFragment WarningGrid(IReadOnlyList<DocTile> items) => @<XFGrid Cols="1" Md="2" Gap="4">@foreach (var item in items) { <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true"><div class="flex items-center gap-4"><span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-danger/10 bg-danger/10 text-danger" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span><div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div></div><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography></XFStack></ChildContent></XFCard> }</XFGrid>;
    private RenderFragment NameValueTable(IReadOnlyList<NameValueRow> rows, string nameHeader, string valueHeader) => @<XFTable Striped="true" Hoverable="true" Compact="true"><XFTableHeader><XFTableRow><XFTableCell Header="true">@nameHeader</XFTableCell><XFTableCell Header="true">@valueHeader</XFTableCell></XFTableRow></XFTableHeader><XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Value</XFTableCell></XFTableRow> }</XFTableBody></XFTable>;
    private RenderFragment ApiTable(IReadOnlyList<ApiRow> rows) => @<XFTable Striped="true" Hoverable="true" Compact="true"><XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Parametro","Parameter")</XFTableCell><XFTableCell Header="true">Type</XFTableCell><XFTableCell Header="true">Default</XFTableCell><XFTableCell Header="true">@T("Descricao","Description")</XFTableCell></XFTableRow></XFTableHeader><XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Type</XFTableCell><XFTableCell><XFCode Text="@row.DefaultValue" /></XFTableCell><XFTableCell>@row.Description</XFTableCell></XFTableRow> }</XFTableBody></XFTable>;

    private string TransferCode => @"<XFTransferList Items=""@Permissoes""
    TargetValues=""@PermissoesAtivas""
    TargetValuesChanged=""@(v => PermissoesAtivas = v)""
    SourceLabel=""Disponiveis""
    TargetLabel=""Selecionados""
    Searchable=""true"" />";

    private string DisabledCode => @"<XFTransferList Items=""@Items"" TargetValues=""@Target"" />";

    private IReadOnlyList<DocTile> QuickFacts => [new(T("Dual-list", "Dual-list"), T("Duas listas com transferencia bidirecional.", "Two lists with bidirectional transfer."), "arrow-right-arrow-left"), new(T("Busca integrada", "Integrated search"), T("Filtro em tempo real por texto e descricao.", "Real-time filter by text and description."), "search"), new(T("Acessivel", "Accessible"), T("Live region, aria-labels e keyboard nav.", "Live region, aria-labels and keyboard nav."), "universal-access")];
    private IReadOnlyList<NameValueRow> MetadataRows => [new("Component", "XFTransferList"), new("Namespace", "XForge.DesignSystem.Components.Forms.TransferList"), new("Package", "XForge.DesignSystem"), new("Category", T("Formularios / Transfer List", "Forms / Transfer List")), new("Status", T("Estavel", "Stable")), new("Accessibility", T("role=listbox, aria-multiselectable, aria-live=polite.", "role=listbox, aria-multiselectable, aria-live=polite."))];
    private IReadOnlyList<DocTile> OverviewItems => [new(T("Duas listas", "Two lists"), T("Origem (disponiveis) e destino (selecionados).", "Source (available) and target (selected)."), "arrow-right-arrow-left"), new(T("Botoes de transferencia", "Transfer buttons"), T("Mover selecionados e mover todos.", "Move selected and move all."), "arrows-up-down"), new(T("Itens ricos", "Rich items"), T("Text, Description e Disabled por item.", "Text, Description and Disabled per item."), "list")];
    private IReadOnlyList<DocTile> PurposeItems => [new(T("Atribuicao", "Assignment"), T("Atribuir permissoes, modulos e recursos.", "Assign permissions, modules and resources."), "key"), new(T("Selecao", "Selection"), T("Selecionar itens de grandes listas.", "Select items from large lists."), "list-check")];
    private IReadOnlyList<DocTile> ProblemItems => [new(T("Antes", "Before"), T("Multiplos selects com transferencia manual.", "Multiple selects with manual transfer."), "xmark"), new(T("Depois", "After"), T("Componente dual-list com busca e live region.", "Dual-list component with search and live region."), "check")];
    private IReadOnlyList<DocTile> UseItems => [new(T("Permissoes", "Permissions"), T("Atribuir permissoes a usuarios e grupos.", "Assign permissions to users and groups."), "key"), new(T("Modulos ERP", "ERP modules"), T("Ativar modulos por tenant.", "Activate modules per tenant."), "puzzle-piece"), new(T("Grupos", "Groups"), T("Alocar itens em categorias.", "Allocate items into categories."), "users")];
    private IReadOnlyList<DocTile> AvoidItems => [new(T("Listas muito grandes", "Very large lists"), T("Para 1000+ itens considere virtualizacao.", "For 1000+ items consider virtualization."), "xmark"), new(T("Selecao simples", "Simple selection"), T("Para 1-5 itens use select ou checkbox.", "For 1-5 items use select or checkbox."), "xmark")];
    private IReadOnlyList<DocTile> AnatomyItems => [new("Source list", T("Lista de itens disponiveis.", "List of available items."), "list"), new("Target list", T("Lista de itens selecionados.", "List of selected items."), "list-check"), new("Transfer buttons", T("Botoes para mover itens entre listas.", "Buttons to move items between lists."), "arrows-right-left"), new("Search", T("Campo de busca para filtrar itens.", "Search field to filter items."), "magnifying-glass")];
    private IReadOnlyList<DocTile> DesignPrincipleItems => [new(T("Dual-list", "Dual-list"), T("Visibilidade clara de disponiveis vs selecionados.", "Clear visibility of available vs selected."), "arrow-right-arrow-left"), new(T("Live region", "Live region"), T("Anuncia mudancas para leitores de tela.", "Announces changes to screen readers."), "universal-access"), new(T("Touch-first", "Touch-first"), T("Botoes de transferencia minimos 44px.", "Transfer buttons minimum 44px."), "hand-pointer")];
    private IReadOnlyList<NameValueRow> KeyboardRows => [new("Tab", T("Navega entre botoes de transferencia.", "Navigate between transfer buttons.")), new("Enter", T("Move itens selecionados.", "Move selected items.")), new("Space", T("Seleciona/desseleciona item.", "Select/deselect item."))];
    private IReadOnlyList<NameValueRow> TokenRows => [new("list", T("border rounded-lg bg-bg-surface overflow-y-auto.", "border rounded-lg bg-bg-surface overflow-y-auto.")), new("button", T("h-9 rounded-lg border bg-bg-surface px-3.", "h-9 rounded-lg border bg-bg-surface px-3.")), new("item", T("px-3 py-2 hover:bg-surface-50 cursor-pointer.", "px-3 py-2 hover:bg-surface-50 cursor-pointer."))];
    private IReadOnlyList<DocTile> ThemeItems => [new("data-theme", T("Tokens light/dark via CSS variables.", "Light/dark tokens via CSS variables."), "moon"), new("data-brand", T("Primary acompanha marca ativa.", "Primary follows active brand."), "swatchbook")];
    private IReadOnlyList<NameValueRow> LimitationRows => [new("Performance", T("Listas com 1000+ itens podem ficar lentas. Use XFVirtualList.", "Lists with 1000+ items may be slow. Use XFVirtualList.")), new("Mobile", T("Em telas estreitas, listas empilham verticalmente.", "On narrow screens, lists stack vertically."))];
    private IReadOnlyList<DocTile> AccessibilityItems => [new(T("Live region", "Live region"), T("Anuncia movimentacao para leitores de tela.", "Announces movement to screen readers."), "universal-access"), new(T("Keyboard", "Keyboard"), T("Navegacao por Tab e selecao por Enter.", "Navigate by Tab and select by Enter."), "keyboard")];
    private IReadOnlyList<DocTile> ResponsivenessItems => [new(T("Layout responsivo", "Responsive layout"), T("Em mobile as listas ficam empilhadas.", "On mobile lists are stacked."), "mobile-screen")];
    private IReadOnlyList<DocTile> PerformanceItems => [new(T("Render eficiente", "Efficient render"), T("Apenas itens visiveis sao renderizados.", "Only visible items are rendered."), "bolt")];
    private IReadOnlyList<DocTile> ScenarioItems => [new("ERP", T("Permissoes de usuario e modulo.", "User and module permissions."), "briefcase"), new(T("RH", "HR"), T("Alocacao de funcionarios em departamentos.", "Employee allocation to departments."), "users")];
    private IReadOnlyList<DocTile> CompositionItems => [new(T("TransferList + Busca", "TransferList + Search"), T("Busca integrada para filtrar itens em listas grandes.", "Integrated search to filter items in large lists."), "magnifying-glass"), new(T("TransferList + Labels", "TransferList + Custom Labels"), T("Labels personalizados por contexto de uso.", "Custom labels per usage context."), "tag"), new(T("TransferList + Disabled", "TransferList + Disabled Items"), T("Itens desabilitados para restricoes de permissao.", "Disabled items for permission restrictions."), "lock")];
    private IReadOnlyList<DocTile> BestPracticeItems => [new(T("Busca", "Search"), T("Habilite Searchable para listas > 10 itens.", "Enable Searchable for lists > 10 items."), "circle-check"), new(T("Count format", "Count format"), T("Customize SingleCountFormat e MultipleCountFormat.", "Customize SingleCountFormat and MultipleCountFormat."), "circle-check")];
    private IReadOnlyList<DocTile> AntiPatternItems => [new(T("Sem busca", "No search"), T("Listas sem busca causam friccao.", "Lists without search cause friction."), "xmark")];
    private IReadOnlyList<NameValueRow> TestingRows => [new("Unit", T("Cobre render, items, target, search, move, disabled.", "Covers render, items, target, search, move, disabled."))];
    private IReadOnlyList<DocTile> RelatedComponentItems => [new("XFSelect", T("Para selecao simples.", "For simple selection."), "list-dropdown"), new("XFCheckbox", T("Para multipla selecao em lista.", "For multiple selection in list."), "check")];
    private IReadOnlyList<NameValueRow> FaqRows => [new(T("Como desabilitar item?", "How to disable item?"), T("Set Disabled=true no XFTransferListItem.", "Set Disabled=true on XFTransferListItem.")), new(T("Posso reordenar itens?", "Can I reorder items?"), T("Nao; apenas transferir entre listas.", "No; only transfer between lists."))];
    private IReadOnlyList<NameValueRow> ChangelogRows => [new("2026-05-26", T("Pagina refeita no padrao enterprise com API real.", "Page rebuilt in the enterprise standard with real API."))];

    private IReadOnlyList<ApiRow> ApiRows =>
    [
        new("Items", "IReadOnlyList<XFTransferListItem>", "[]", T("Todos os itens disponiveis.", "All available items.")),
        new("TargetValues", "IReadOnlyList<string>", "[]", T("Valores dos itens no destino.", "Values of items in target.")),
        new("TargetValuesChanged", "EventCallback<IReadOnlyList<string>>", "default", T("Binding two-way do TargetValues.", "Two-way binding of TargetValues.")),
        new("Change", "EventCallback<IReadOnlyList<string>>", "default", T("Disparado ao mover itens.", "Fired when items are moved.")),
        new("SourceLabel", "string", "\"Disponiveis\"", T("Label da lista de origem.", "Source list label.")),
        new("TargetLabel", "string", "\"Selecionados\"", T("Label da lista de destino.", "Target list label.")),
        new("Searchable", "bool", "true", T("Habilita busca em ambas listas.", "Enables search on both lists.")),
        new("SearchPlaceholder", "string", "\"Buscar\"", T("Placeholder do campo de busca.", "Search field placeholder.")),
        new("MoveAllText", "string", "\"Todos\"", T("Label do botao mover todos.", "Move all button label.")),
        new("SelectAllText", "string", "\"Todos\"", T("Label do botao selecionar todos.", "Select all button label.")),
        new("Disabled", "bool", "false", T("Desabilita todo o componente.", "Disables the entire component."))
    ];

