@page "/display/carousel"
@page "/components/carousel"
@using XForge.DesignSystem.Components.DataDisplay.Carousel
@using XForge.DesignSystem.Core.Primitives
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="Core OSS"
                 Title="Carousel"
                 Status="Premium"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">

        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFCarousel" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Swipe", "Swipe")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Enterprise", "Enterprise")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Carrossel acessivel para exibicao sequencial de slides, banners e estados de conteudo.", "Accessible carousel for sequential display of slides, banners and content states.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("3 transicoes (Slide, Fade, None), autoplay com pausa, swipe touch, navegacao por teclado, indicadores configuraveis e templates de icones.",
                               "3 transitions (Slide, Fade, None), autoplay with pause, touch swipe, keyboard navigation, configurable indicators and icon templates.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico. Interacoes requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderizacao.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Consideracoes", "Considerations")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor Server: eventos sao tratados via SignalR. Sem latencia adicional para componentes puramente renderizados.", "Blazor Server: events are handled via SignalR. No additional latency for purely rendered components.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor WebAssembly: eventos sao tratados diretamente no cliente. Mais responsivo.", "Blazor WebAssembly: events are handled directly on the client. More responsive.")</XFTypography>
                </XFStack>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Basico", "1. Basic"),
                T("Carrossel simples com tres slides e navegacao por setas.", "Simple carousel with three slides and arrow navigation."),
                ExBasic(), CodeBasic)

            @Example(T("2. Autoplay", "2. Autoplay"),
                T("Reproducao automatica com intervalo de 3s, pausa ao hover e ao focar.", "Auto-advance with 3s interval, pause on hover and focus."),
                ExAutoplay(), CodeAutoplay)

            @Example(T("3. Transicoes", "3. Transitions"),
                T("Slide, Fade e None - tres modos de transicao entre slides.", "Slide, Fade and None - three slide transition modes."),
                ExTransitions(), CodeTransitions)

            @Example(T("4. Controles e indicadores", "4. Controls and Indicators"),
                T("Combinacoes de ShowControls e ShowIndicators.", "Combinations of ShowControls and ShowIndicators."),
                ExControlsIndicators(), CodeControlsIndicators)

            @Example(T("5. Posicao dos indicadores", "5. Indicator Position"),
                T("Bottom, Top e Overlay - posicoes dos dots de navegacao.", "Bottom, Top and Overlay - navigation dot positions."),
                ExIndicatorPosition(), CodeIndicatorPosition)

            @Example(T("6. Loop desabilitado", "6. Loop Disabled"),
                T("Loop=false desabilita navegacao circular; botoes desabilitam nas extremidades.", "Loop=false disables circular navigation; buttons disable at boundaries."),
                ExLoopDisabled(), CodeLoopDisabled)

            @Example(T("7. Icones customizados", "7. Custom Icons"),
                T("PreviousIcon e NextIcon RenderFragment para icones SVG ou markup.", "PreviousIcon and NextIcon RenderFragment for SVG icons or markup."),
                ExCustomIcons(), CodeCustomIcons)

            @Example(T("8. Swipe touch", "8. Touch Swipe"),
                T("SwipeEnabled com SwipeThreshold configuravel para navegacao por gestos.", "SwipeEnabled with configurable SwipeThreshold for gesture navigation."),
                ExSwipe(), CodeSwipe)

            @Example(T("9. Acessibilidade", "9. Accessibility"),
                T("AriaLabel, PauseLabel, PauseOnHover e PauseOnFocus para leitores de tela.", "AriaLabel, PauseLabel, PauseOnHover and PauseOnFocus for screen readers."),
                ExAccessibility(), CodeAccessibility)

            @Example(T("10. Cenario enterprise", "10. Enterprise scenario"),
                T("Carrossel de KPIs financeiros com metricas e indicadores de status.", "Financial KPI carousel with metrics and status indicators."),
                ExEnterprise(), CodeEnterprise)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>
                <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">XFCarousel</XFTypography>
                    @ApiTable(ApiRows)
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">XFCarouselSlide</XFTypography>
                    @ApiTable(SlideApiRows)
                </XFStack>
            </div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>

    </XFStack>
</XForgeDocsShell>

@code {
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);
    private string CopyableCodeTitle => T("Copiar codigo", "Copy code");

    // --- Hero ---
    private RenderFragment HeroPreview() => @<div>
        <XFCarousel AriaLabel="Demo carousel" Autoplay="true" Interval="4000" Loop="true">
            <XFCarouselSlide SlideId="hero-1" Label="Dashboard overview">
                <div class="flex h-48 items-center justify-center bg-gradient-to-br from-primary/20 to-primary/5 p-6">
                    <div class="text-center">
                        <div class="text-3xl font-bold text-primary">R$ 2.4M</div>
                        <div class="text-sm text-text-secondary">@T("Receita mensal", "Monthly revenue")</div>
                    </div>
                </div>
            </XFCarouselSlide>
            <XFCarouselSlide SlideId="hero-2" Label="Growth metrics">
                <div class="flex h-48 items-center justify-center bg-gradient-to-br from-success/20 to-success/5 p-6">
                    <div class="text-center">
                        <div class="text-3xl font-bold text-success">+18.5%</div>
                        <div class="text-sm text-text-secondary">@T("Crescimento trimestral", "Quarterly growth")</div>
                    </div>
                </div>
            </XFCarouselSlide>
            <XFCarouselSlide SlideId="hero-3" Label="Active users">
                <div class="flex h-48 items-center justify-center bg-gradient-to-br from-info/20 to-info/5 p-6">
                    <div class="text-center">
                        <div class="text-3xl font-bold text-info">12.847</div>
                        <div class="text-sm text-text-secondary">@T("Usuarios ativos", "Active users")</div>
                    </div>
                </div>
            </XFCarouselSlide>
        </XFCarousel>
    </div>;

    // --- 1. Basic ---
    private RenderFragment ExBasic() => @<div>
        <XFCarousel AriaLabel="Basic carousel">
            <XFCarouselSlide SlideId="basic-1" Label="Slide 1">
                <div class="flex h-40 items-center justify-center bg-primary/10 text-lg font-semibold text-primary">Slide 1</div>
            </XFCarouselSlide>
            <XFCarouselSlide SlideId="basic-2" Label="Slide 2">
                <div class="flex h-40 items-center justify-center bg-success/10 text-lg font-semibold text-success">Slide 2</div>
            </XFCarouselSlide>
            <XFCarouselSlide SlideId="basic-3" Label="Slide 3">
                <div class="flex h-40 items-center justify-center bg-warning/10 text-lg font-semibold text-warning">Slide 3</div>
            </XFCarouselSlide>
        </XFCarousel>
    </div>;

    // --- 2. Autoplay ---
    private RenderFragment ExAutoplay() => @<div>
        <XFCarousel AriaLabel="Autoplay carousel" Autoplay="true" Interval="3000" PauseOnHover="true" PauseOnFocus="true">
            <XFCarouselSlide SlideId="auto-1" Label="KPI 1">
                <div class="flex h-40 items-center justify-center bg-gradient-to-r from-primary/15 to-primary/5">
                    <XFTypography Variant="XFTypographyVariant.H3" Weight="XFTypographyWeight.Bold">@T("Vendas: R$ 890K", "Sales: $890K")</XFTypography>
                </div>
            </XFCarouselSlide>
            <XFCarouselSlide SlideId="auto-2" Label="KPI 2">
                <div class="flex h-40 items-center justify-center bg-gradient-to-r from-success/15 to-success/5">
                    <XFTypography Variant="XFTypographyVariant.H3" Weight="XFTypographyWeight.Bold">@T("Meta: 92%", "Target: 92%")</XFTypography>
                </div>
            </XFCarouselSlide>
            <XFCarouselSlide SlideId="auto-3" Label="KPI 3">
                <div class="flex h-40 items-center justify-center bg-gradient-to-r from-info/15 to-info/5">
                    <XFTypography Variant="XFTypographyVariant.H3" Weight="XFTypographyWeight.Bold">@T("NPS: 78", "NPS: 78")</XFTypography>
                </div>
            </XFCarouselSlide>
        </XFCarousel>
    </div>;

    // --- 3. Transitions ---
    private RenderFragment ExTransitions() => @<XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
        @foreach (var transition in Enum.GetValues<XFCarouselTransition>())
        {
            <div>
                <div class="mb-2 flex items-center gap-2">
                    <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@transition.ToString()" />
                </div>
                <XFCarousel AriaLabel="@($"{transition} carousel")" Transition="@transition">
                    <XFCarouselSlide SlideId="@($"trans-{transition}-1")" Label="A">
                        <div class="flex h-32 items-center justify-center bg-primary/10 font-semibold text-primary">A</div>
                    </XFCarouselSlide>
                    <XFCarouselSlide SlideId="@($"trans-{transition}-2")" Label="B">
                        <div class="flex h-32 items-center justify-center bg-success/10 font-semibold text-success">B</div>
                    </XFCarouselSlide>
                    <XFCarouselSlide SlideId="@($"trans-{transition}-3")" Label="C">
                        <div class="flex h-32 items-center justify-center bg-warning/10 font-semibold text-warning">C</div>
                    </XFCarouselSlide>
                </XFCarousel>
            </div>
        }
    </XFStack>;

    // --- 4. Controls & Indicators ---
    private RenderFragment ExControlsIndicators() => @<XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
        <div>
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Sem controles, com indicadores", "No controls, with indicators")" />
            <XFCarousel AriaLabel="No controls" ShowControls="false" ShowIndicators="true" Class="mt-2">
                <XFCarouselSlide SlideId="ci-1" Label="1"><div class="flex h-32 items-center justify-center bg-primary/10 font-semibold text-primary">1</div></XFCarouselSlide>
                <XFCarouselSlide SlideId="ci-2" Label="2"><div class="flex h-32 items-center justify-center bg-success/10 font-semibold text-success">2</div></XFCarouselSlide>
            </XFCarousel>
        </div>
        <div>
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Com controles, sem indicadores", "With controls, no indicators")" />
            <XFCarousel AriaLabel="No indicators" ShowControls="true" ShowIndicators="false" Class="mt-2">
                <XFCarouselSlide SlideId="ci-3" Label="1"><div class="flex h-32 items-center justify-center bg-primary/10 font-semibold text-primary">1</div></XFCarouselSlide>
                <XFCarouselSlide SlideId="ci-4" Label="2"><div class="flex h-32 items-center justify-center bg-success/10 font-semibold text-success">2</div></XFCarouselSlide>
            </XFCarousel>
        </div>
        <div>
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Sem controles, sem indicadores", "No controls, no indicators")" />
            <XFCarousel AriaLabel="Minimal" ShowControls="false" ShowIndicators="false" Class="mt-2">
                <XFCarouselSlide SlideId="ci-5" Label="1"><div class="flex h-32 items-center justify-center bg-primary/10 font-semibold text-primary">1</div></XFCarouselSlide>
                <XFCarouselSlide SlideId="ci-6" Label="2"><div class="flex h-32 items-center justify-center bg-success/10 font-semibold text-success">2</div></XFCarouselSlide>
            </XFCarousel>
        </div>
    </XFStack>;

    // --- 5. Indicator Position ---
    private RenderFragment ExIndicatorPosition() => @<XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
        @foreach (var pos in Enum.GetValues<XFCarouselIndicatorPosition>())
        {
            <div>
                <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@pos.ToString()" />
                <XFCarousel AriaLabel="@($"{pos} indicators")" IndicatorPosition="@pos" Class="mt-2">
                    <XFCarouselSlide SlideId="@($"pos-{pos}-1")" Label="A"><div class="flex h-32 items-center justify-center bg-primary/10 font-semibold text-primary">A</div></XFCarouselSlide>
                    <XFCarouselSlide SlideId="@($"pos-{pos}-2")" Label="B"><div class="flex h-32 items-center justify-center bg-success/10 font-semibold text-success">B</div></XFCarouselSlide>
                    <XFCarouselSlide SlideId="@($"pos-{pos}-3")" Label="C"><div class="flex h-32 items-center justify-center bg-warning/10 font-semibold text-warning">C</div></XFCarouselSlide>
                </XFCarousel>
            </div>
        }
    </XFStack>;

    // --- 6. Loop Disabled ---
    private RenderFragment ExLoopDisabled() => @<div>
        <XFCarousel AriaLabel="No loop carousel" Loop="false">
            <XFCarouselSlide SlideId="loop-1" Label="First"><div class="flex h-40 items-center justify-center bg-primary/10 font-semibold text-primary">@T("Primeiro - seta esquerda desabilitada", "First - left arrow disabled")</div></XFCarouselSlide>
            <XFCarouselSlide SlideId="loop-2" Label="Middle"><div class="flex h-40 items-center justify-center bg-success/10 font-semibold text-success">@T("Meio - ambas as setas ativas", "Middle - both arrows active")</div></XFCarouselSlide>
            <XFCarouselSlide SlideId="loop-3" Label="Last"><div class="flex h-40 items-center justify-center bg-warning/10 font-semibold text-warning">@T("Ultimo - seta direita desabilitada", "Last - right arrow disabled")</div></XFCarouselSlide>
        </XFCarousel>
    </div>;

    // --- 7. Custom Icons ---
    private RenderFragment ExCustomIcons() => @<div>
        <XFCarousel AriaLabel="Custom icon carousel">
            <PreviousIcon><span aria-hidden="true" class="text-lg font-bold">&larr;</span></PreviousIcon>
            <NextIcon><span aria-hidden="true" class="text-lg font-bold">&rarr;</span></NextIcon>
            <ChildContent>
                <XFCarouselSlide SlideId="icon-1" Label="A"><div class="flex h-36 items-center justify-center bg-gradient-to-br from-primary/20 to-primary/5 text-xl font-bold text-primary">A</div></XFCarouselSlide>
                <XFCarouselSlide SlideId="icon-2" Label="B"><div class="flex h-36 items-center justify-center bg-gradient-to-br from-success/20 to-success/5 text-xl font-bold text-success">B</div></XFCarouselSlide>
                <XFCarouselSlide SlideId="icon-3" Label="C"><div class="flex h-36 items-center justify-center bg-gradient-to-br from-info/20 to-info/5 text-xl font-bold text-info">C</div></XFCarouselSlide>
            </ChildContent>
        </XFCarousel>
    </div>;

    // --- 8. Swipe ---
    private RenderFragment ExSwipe() => @<div>
        <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted" Class="mb-2">
            @T("Arraste para a esquerda ou direita para navegar. Threshold: 48px (padrao).", "Drag left or right to navigate. Threshold: 48px (default).")
        </XFTypography>
        <XFCarousel AriaLabel="Swipe carousel" SwipeEnabled="true" SwipeThreshold="48">
            <XFCarouselSlide SlideId="swipe-1" Label="Swipe 1"><div class="flex h-40 items-center justify-center bg-primary/10 text-lg font-semibold text-primary">@T("Slide 1 - arraste!", "Slide 1 - swipe!")</div></XFCarouselSlide>
            <XFCarouselSlide SlideId="swipe-2" Label="Swipe 2"><div class="flex h-40 items-center justify-center bg-success/10 text-lg font-semibold text-success">@T("Slide 2 - continue!", "Slide 2 - keep going!")</div></XFCarouselSlide>
            <XFCarouselSlide SlideId="swipe-3" Label="Swipe 3"><div class="flex h-40 items-center justify-center bg-warning/10 text-lg font-semibold text-warning">@T("Slide 3 - quase la!", "Slide 3 - almost there!")</div></XFCarouselSlide>
        </XFCarousel>
    </div>;

    // --- 9. Accessibility ---
    private RenderFragment ExAccessibility() => @<div>
        <XFCarousel AriaLabel="Accessible product showcase"
                    PauseLabel="Auto-advance pauses on hover or focus."
                    PauseOnHover="true"
                    PauseOnFocus="true"
                    Autoplay="true"
                    Interval="5000"
                    RespectReducedMotion="true">
            <XFCarouselSlide SlideId="a11y-1" Label="Product A">
                <div class="flex h-40 items-center justify-center bg-primary/10 p-4">
                    <XFTypography Variant="XFTypographyVariant.Body1">@T("Produto A - respeita prefers-reduced-motion", "Product A - respects prefers-reduced-motion")</XFTypography>
                </div>
            </XFCarouselSlide>
            <XFCarouselSlide SlideId="a11y-2" Label="Product B">
                <div class="flex h-40 items-center justify-center bg-success/10 p-4">
