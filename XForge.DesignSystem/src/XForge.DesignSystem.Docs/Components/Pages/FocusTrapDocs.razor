@page "/components/focus-trap"
@using XForge.DesignSystem.Core.Primitives
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFFocusTrap" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Acessibilidade para overlays", "Accessibility for overlays")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Utilitario de foco para dialogs, drawers e overlays com trap, restore e escape.",
                               "Focus utility for dialogs, drawers and overlays with trap, restore and escape.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("Mantem o foco do teclado dentro de um container modal, prevenindo que o usuario tabule para fora. Suporta restauracao de foco, foco inicial customizado e liberacao por Escape.",
                               "Keeps keyboard focus within a modal container, preventing the user from tabbing out. Supports focus restoration, custom initial focus and Escape release.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Parcial", "Partial")" /></XFTableCell><XFTableCell>@T("JS interop via SignalR. Pode haver latencia.", "JS interop via SignalR. May have latency.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("JS interop direto, sem latencia de rede.", "Direct JS interop, no network latency.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Parcial", "Partial")" /></XFTableCell><XFTableCell>@T("Depende do modo ativo no momento.", "Depends on the active mode at the time.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Danger" Text="@T("Nao", "No")" /></XFTableCell><XFTableCell>@T("JS interop nao disponivel em modo estatico.", "JS interop not available in static mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("JS Interop", "JS Interop")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente utiliza JavaScript interop para gerenciar foco. As funcoes JS xfFocusTrap.activate, xfFocusTrap.focusInitial e xfFocusTrap.release sao chamadas via IJSRuntime.", "This component uses JavaScript interop to manage focus. The JS functions xfFocusTrap.activate, xfFocusTrap.focusInitial and xfFocusTrap.release are called via IJSRuntime.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 6 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Dialog basico", "1. Basic Dialog"), T("Trap de foco em dialog de confirmacao com botao primario.", "Focus trap in confirmation dialog with primary button."), ExBasicDialog(), Code1)
            @Example(T("2. Escape libera foco", "2. Escape Releases Focus"), T("Escape tecla libera o trap e restaura foco ao elemento anterior.", "Escape key releases the trap and restores focus to the previous element."), ExEscapeRelease(), Code2)
            @Example(T("3. Foco inicial customizado", "3. Custom Initial Focus"), T("Foco inicial direcionado para um campo especifico via selector.", "Initial focus directed to a specific field via selector."), ExCustomInitialFocus(), Code3)
            @Example(T("4. Drawer com trap", "4. Drawer with Trap"), T("Trap de foco em drawer lateral com conteudo de formulario.", "Focus trap in side drawer with form content."), ExDrawerTrap(), Code4)
            @Example(T("5. Dialog de confirmacao", "5. Confirmation Dialog"), T("Dialog com dois botoes e trap de foco completo.", "Dialog with two buttons and complete focus trap."), ExConfirmDialog(), Code5)
            @Example(T("6. Ativacao programatica", "6. Programmatic Activation"), T("Ativacao e desativacao do trap via metodos C#.", "Trap activation and deactivation via C# methods."), ExProgrammatic(), Code6)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string ProductLabelText => T("Core Open Source", "Core Open Source");
    private string PageTitleText => T("XFFocusTrap", "XFFocusTrap");
    private string PageStatusText => T("Documentacao completa", "Complete docs");
    private string T(string pt, string en) => LanguageService.Text(pt, en);
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <div class="rounded-lg border border-border-light bg-surface-100 p-4">
            <div class="text-sm font-medium text-text-primary mb-2">@T("Dialog de exemplo", "Example dialog")</div>
            <div class="flex gap-2">
                <button class="inline-flex items-center rounded-md bg-primary px-3 py-1.5 text-sm font-medium text-white">OK</button>
                <button class="inline-flex items-center rounded-md border border-border-light px-3 py-1.5 text-sm font-medium text-text-secondary">Cancel</button>
            </div>
        </div>
        <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Tab cicla entre OK e Cancel dentro do trap.", "Tab cycles between OK and Cancel inside the trap.")</XFTypography>
    </XFStack>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("Trap de foco", "Focus trap"), T("Mantem tab dentro do container modal.", "Keeps tab inside modal container."), "lock"),
        new(T("Restore focus", "Restore focus"), T("Restaura foco ao elemento original ao liberar.", "Restores focus to original element on release."), "lock-open"),
        new(T("Escape release", "Escape release"), T("Libera trap com tecla Escape opcional.", "Releases trap with optional Escape key."), "arrow-right-from-bracket")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFFocusTrap"),
        new("Namespace", "XForge.DesignSystem.Components.Utilities.FocusTrap"),
        new("Package", "XForge.DesignSystem"),
        new("Category", "Utilities / Focus Trap"),
        new("Status", T("Estavel", "Stable")),
        new("Accessibility", T("Tab trap, Escape key, focus restore, InitialFocusSelector.", "Tab trap, Escape key, focus restore, InitialFocusSelector.")),
        new("Theme support", T("Neutro. Sem tokens visuais proprios.", "Neutral. No visual tokens of its own."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("Container de foco", "Focus container"), T("Div wrapper com tabindex=-1 que captura foco.", "Div wrapper with tabindex=-1 that captures focus."), "lock"),
        new(T("JS interop", "JS interop"), T("Usa xfFocusTrap JS para gerenciar Tab cycle.", "Uses xfFocusTrap JS to manage Tab cycle."), "bolt"),
        new(T("Programatico", "Programmatic"), T("Metodos C# publicos para controle externo.", "Public C# methods for external control."), "gear")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Dialogs", "Dialogs"), T("Manter foco dentro de modais de confirmacao.", "Keep focus inside confirmation modals."), "window-maximize"),
        new(T("Drawers", "Drawers"), T("Trap de foco em paineis laterais.", "Focus trap in side panels."), "arrows-left-right"),
        new(T("Overlays", "Overlays"), T("Qualquer camada que bloqueia interacao com o fundo.", "Any layer that blocks interaction with the background."), "layer-group")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Tab navega para fora do modal, quebrando acessibilidade.", "Tab navigates outside the modal, breaking accessibility."), "xmark"),
        new(T("Depois", "After"), T("Tab cicla dentro do container, mantendo foco.", "Tab cycles inside the container, maintaining focus."), "check"),
        new(T("Acessibilidade", "Accessibility"), T("WCAG 2.1 requiremenet para modais acessiveis.", "WCAG 2.1 requirement for accessible modals."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Dialogs modais", "Modal dialogs"), T("Confirmacao, alerta, selecao.", "Confirmation, alert, selection."), "window-maximize"),
        new(T("Drawers", "Drawers"), T("Paineis laterais de formulario.", "Side form panels."), "arrows-left-right")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Inline content", "Inline content"), T("Nao use para conteudo que nao bloqueia a pagina.", "Do not use for content that does not block the page."), "xmark"),
        new(T("Dropdowns", "Dropdowns"), T("Use XFDropdownMenu para menus suspensos.", "Use XFDropdownMenu for dropdown menus."), "ban")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new("Container", T("Div com tabindex=-1 e data-active.", "Div with tabindex=-1 and data-active."), "square"),
        new("Tab cycle", T("Tab e Shift+Tab capturados pelo JS.", "Tab and Shift+Tab captured by JS."), "arrows-left-right"),
        new("Escape", T("Tecla Escape opcional para liberar.", "Optional Escape key to release."), "arrow-right-from-bracket"),
        new("Focus restore", T("Foco restaurado ao elemento anterior.", "Focus restored to previous element."), "rotate-left")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(T("Acessibilidade primeiro", "Accessibility first"), T("WCAG 2.1 modais requerem trap de foco.", "WCAG 2.1 modals require focus trap."), "universal-access"),
        new(T("Intrusao minima", "Minimal intrusion"), T("Nao afeta layout ou estilo dos filhos.", "Does not affect layout or style of children."), "minimize"),
        new(T("Controle programatico", "Programmatic control"), T("Metodos publicos para ativacao externa.", "Public methods for external activation."), "gear")
    ];

    // === EXAMPLES ===
    private RenderFragment ExBasicDialog() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <div class="rounded-lg border border-border-light bg-surface-100 p-6">
            <XFFocusTrap Active="true" EscapeReleases="true">
                <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
                    <ChildContent>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                            <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@T("Confirmar exclusao", "Confirm deletion")</XFTypography>
                            <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">@T("Tem certeza que deseja excluir este item? Esta acao nao pode ser desfeita.", "Are you sure you want to delete this item? This action cannot be undone.")</XFTypography>
                            <XFStack Orientation="XFOrientation.Horizontal" Gap="3">
                                <button class="inline-flex items-center rounded-md bg-danger px-3 py-1.5 text-sm font-medium text-white">@T("Excluir", "Delete")</button>
                                <button class="inline-flex items-center rounded-md border border-border-light px-3 py-1.5 text-sm font-medium text-text-secondary">@T("Cancelar", "Cancel")</button>
                            </XFStack>
                        </XFStack>
                    </ChildContent>
                </XFCard>
            </XFFocusTrap>
        </div>
    </XFStack>;

    private RenderFragment ExEscapeRelease() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <div class="rounded-lg border border-border-light bg-surface-100 p-6">
            <XFFocusTrap Active="true" EscapeReleases="true" RestoreFocus="true">
                <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
                    <ChildContent>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                            <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@T("Notificacao", "Notification")</XFTypography>
                            <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">@T("Pressione Escape para fechar. O foco voltara ao elemento anterior.", "Press Escape to close. Focus will return to the previous element.")</XFTypography>
                            <button class="inline-flex items-center rounded-md bg-primary px-3 py-1.5 text-sm font-medium text-white w-fit">OK</button>
                        </XFStack>
                    </ChildContent>
                </XFCard>
            </XFFocusTrap>
        </div>
    </XFStack>;

    private RenderFragment ExCustomInitialFocus() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <div class="rounded-lg border border-border-light bg-surface-100 p-6">
            <XFFocusTrap Active="true" InitialFocusSelector="[data-autofocus]">
                <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
                    <ChildContent>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                            <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@T("Pesquisar", "Search")</XFTypography>
                            <input data-autofocus="true" class="rounded-md border border-border-light px-3 py-1.5 text-sm w-full" placeholder="@T("Digite sua busca...", "Type your search...")" />
                            <button class="inline-flex items-center rounded-md bg-primary px-3 py-1.5 text-sm font-medium text-white w-fit">@T("Buscar", "Search")</button>
                        </XFStack>
                    </ChildContent>
                </XFCard>
            </XFFocusTrap>
        </div>
    </XFStack>;

    private RenderFragment ExDrawerTrap() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <div class="rounded-lg border border-border-light bg-surface-100 p-6">
            <XFFocusTrap Active="true" EscapeReleases="true">
                <div class="flex">
                    <div class="w-72 border-r border-border-light bg-surface-50 p-4">
                        <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                            <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@T("Configuracoes", "Settings")</XFTypography>
                            <input class="rounded-md border border-border-light px-3 py-1.5 text-sm w-full" placeholder="@T("Nome", "Name")" />
                            <input class="rounded-md border border-border-light px-3 py-1.5 text-sm w-full" placeholder="@T("Email", "Email")" />
                            <XFStack Orientation="XFOrientation.Horizontal" Gap="3">
                                <button class="inline-flex items-center rounded-md bg-primary px-3 py-1.5 text-sm font-medium text-white">@T("Salvar", "Save")</button>
                                <button class="inline-flex items-center rounded-md border border-border-light px-3 py-1.5 text-sm font-medium text-text-secondary">@T("Cancelar", "Cancel")</button>
                            </XFStack>
                        </XFStack>
                    </div>
                    <div class="flex-1 p-4">
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">@T("Conteudo principal da pagina atras do drawer.", "Main page content behind the drawer.")</XFTypography>
                    </div>
                </div>
            </XFFocusTrap>
        </div>
    </XFStack>;

    private RenderFragment ExConfirmDialog() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <div class="rounded-lg border border-border-light bg-surface-100 p-6">
            <XFFocusTrap Active="true" EscapeReleases="true" RestoreFocus="true" InitialFocusSelector="[data-autofocus]">
                <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
                    <ChildContent>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                            <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@T("Salvar alteracoes?", "Save changes?")</XFTypography>
                            <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">@T("Existem alteracoes nao salvas. Deseja salvar antes de sair?", "There are unsaved changes. Do you want to save before leaving?")</XFTypography>
                            <XFStack Orientation="XFOrientation.Horizontal" Gap="3">
                                <button data-autofocus="true" class="inline-flex items-center rounded-md bg-primary px-3 py-1.5 text-sm font-medium text-white">@T("Salvar", "Save")</button>
                                <button class="inline-flex items-center rounded-md border border-border-light px-3 py-1.5 text-sm font-medium text-text-secondary">@T("Nao salvar", "Don't save")</button>
                                <button class="inline-flex items-center rounded-md border border-border-light px-3 py-1.5 text-sm font-medium text-text-secondary">@T("Cancelar", "Cancel")</button>
                            </XFStack>
                        </XFStack>
                    </ChildContent>
                </XFCard>
            </XFFocusTrap>
        </div>
    </XFStack>;

    private RenderFragment ExProgrammatic() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <div class="rounded-lg border border-border-light bg-surface-100 p-6" @ref="_programmaticRef">
            <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                <XFStack Orientation="XFOrientation.Horizontal" Gap="2">
                    <button class="inline-flex items-center rounded-md bg-primary px-3 py-1.5 text-sm font-medium text-white" @onclick="() => _programmaticActive = true">@T("Ativar trap", "Activate trap")</button>
                    <button class="inline-flex items-center rounded-md border border-border-light px-3 py-1.5 text-sm font-medium text-text-secondary" @onclick="() => _programmaticActive = false">@T("Liberar trap", "Release trap")</button>
                </XFStack>
                <XFFocusTrap @ref="_programmaticTrap" Active="_programmaticActive" EscapeReleases="true">
                    <div class="rounded-md border border-primary/20 bg-primary/5 p-4">
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@T("Conteudo com trap controlado por C#", "Content with C# controlled trap")</XFTypography>
                            <button class="inline-flex items-center rounded-md bg-primary px-3 py-1.5 text-sm font-medium text-white w-fit">Action</button>
                        </XFStack>
                    </div>
                </XFFocusTrap>
            </XFStack>
        </div>
    </XFStack>;

    private const string Code1 = @"<XFFocusTrap Active=""true"" EscapeReleases=""true"">
    <XFCard Variant=""XFCardVariant.Outlined"" Padding=""XFPadding.Lg"">
        <ChildContent>
            <XFStack Orientation=""XFOrientation.Vertical"" Gap=""4"" FullWidth=""true"">
                <XFTypography Variant=""XFTypographyVariant.H4"" Weight=""XFTypographyWeight.Semibold"">Confirmar exclusao</XFTypography>
                <XFTypography Variant=""XFTypographyVariant.Body1"" Color=""XFTypographyColor.Secondary"">Tem certeza que deseja excluir?</XFTypography>
                <XFStack Orientation=""XFOrientation.Horizontal"" Gap=""3"">
                    <button class=""inline-flex items-center rounded-md bg-danger px-3 py-1.5 text-sm font-medium text-white"">Excluir</button>
                    <button class=""inline-flex items-center rounded-md border border-border-light px-3 py-1.5 text-sm font-medium text-text-secondary"">Cancelar</button>
                </XFStack>
            </XFStack>
        </ChildContent>
