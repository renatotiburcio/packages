    private const string Code6 = @"@* Bind Active to a bool field and toggle via C# *@
<XFFocusTrap @ref=""_trap"" Active=""@_isActive"" EscapeReleases=""true"">
    <div class=""rounded-md border border-primary/20 bg-primary/5 p-4"">
        <p>Conteudo com trap controlado por C#</p>
        <button>Action</button>
    </div>
</XFFocusTrap>

@code {
    private XFFocusTrap? _trap;
    private bool _isActive;

    private async Task ActivateTrapAsync()
    {
        _isActive = true;
        StateHasChanged();
        if (_trap is not null) await _trap.ActivateAsync();
    }

    private async Task ReleaseTrapAsync()
    {
        if (_trap is not null) await _trap.ReleaseAsync();
        _isActive = false;
    }
}";

