    // ==================== 8. CUSTOM FOOTER ====================
    private RenderFragment ExCustomFooter() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFDatePicker Label="@T("Rodape customizado", "Custom footer")"
                      Placeholder="@T("Selecione...", "Select...")"
                      @bind-Value="_footerValue">
            <FooterTemplate Context="ctx">
                <div class="flex items-center justify-between gap-2">
                    <button type="button" class="inline-flex h-8 items-center rounded-md px-2.5 text-sm font-medium text-primary outline-none transition-all duration-150 hover:bg-[color-mix(in_oklab,var(--color-primary)_8%,transparent)] focus-visible:ring-2 focus-visible:ring-[color-mix(in_oklab,var(--color-primary)_24%,transparent)] disabled:pointer-events-none disabled:text-text-muted"
                            @onclick="ctx.SelectTodayAsync"
                            disabled="@ctx.IsTodayDisabled">
                        @T("Selecionar hoje", "Select Today")
                    </button>
                    <span class="text-sm text-text-secondary">
                        @(ctx.Value?.ToString("dd/MM/yyyy") ?? T("nenhuma", "none"))
                    </span>
                    <button type="button" class="inline-flex h-8 items-center rounded-md px-2.5 text-sm font-medium text-danger outline-none transition-all duration-150 hover:bg-danger/10 focus-visible:ring-2 focus-visible:ring-danger/25 disabled:pointer-events-none disabled:text-text-muted"
                            @onclick="ctx.ClearAsync"
                            disabled="@ctx.IsClearDisabled">
                        @T("Limpar", "Clear")
                    </button>
                </div>
            </FooterTemplate>
        </XFDatePicker>
    </XFStack>;

    // ==================== 9. DATERENDER ====================
    private RenderFragment ExDateRender() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
