        "@code {\n" +
        "    private void ApplyWeekendHighlight(XFDatePickerDateRenderArgs args)\n" +
        "    {\n" +
        "        if (args.Date.DayOfWeek is DayOfWeek.Saturday\n" +
        "            or DayOfWeek.Sunday)\n" +
        "        {\n" +
        "            args.CssClass = \"text-danger font-semibold\";\n" +
        "        }\n" +
        "        if (args.Date < DateOnly.FromDateTime(DateTime.Today))\n" +
        "        {\n" +
        "            args.IsDisabled = true;\n" +
        "        }\n" +
        "    }\n" +
        "}";

