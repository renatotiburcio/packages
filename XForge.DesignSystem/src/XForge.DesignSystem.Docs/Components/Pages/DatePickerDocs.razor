    // ==================== 10. INLINE ====================
    private RenderFragment ExInline() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFDatePicker Label="@T("Calendario inline", "Inline calendar")"
                      @bind-Value="_inlineValue"
                      Inline="true" />
        <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">
