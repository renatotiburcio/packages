@page "/feedback/toast"
@using XForge.DesignSystem.Components.Feedback.Toast
@using XForge.DesignSystem.Core.Primitives
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="Core OSS"
                 Title="XFToast"
                 Status="Complete docs"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFToast" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("7 Intents", "7 Intents")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Enterprise", "Enterprise")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Notificação temporária para feedback assíncrono, sucesso, alerta e erro.",
                               "Temporary notification for async feedback, success, alert and error.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("XFToast renderiza notificações com 7 intents, 6 posições, duração configurável, ação contextual, botão fechar e cores ricas. Criado via XFToastService.",
                               "XFToast renders notifications with 7 intents, 6 positions, configurable duration, contextual action, close button and rich colors. Created via XFToastService.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section(T("Blazor Server e Blazor WebAssembly", "Blazor Server and Blazor WebAssembly"), @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observações", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estático. Interações requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow></XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependências JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente não utiliza JavaScript interop. É puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderização.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Considerações", "Considerations")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor Server: eventos são tratados via SignalR. Sem latência adicional para componentes puramente renderizados.", "Blazor Server: events are handled via SignalR. No additional latency for purely rendered components.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor WebAssembly: eventos são tratados diretamente no cliente. Mais responsivo.", "Blazor WebAssembly: events are handled directly on the client. More responsive.")</XFTypography>
                </XFStack>
            </XFStack>
        </div>)

        <!-- ===== OVERVIEW ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visão geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Propósito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando não usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 2)</div>)
            @Section(T("Princípios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 10 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Básico", "1. Basic"),
                T("Toast simples com XFToast component e XFToastItem.", "Simple toast with XFToast component and XFToastItem."),
                ExBasic(), CodeBasic)

            @Example(T("2. Intents", "2. Intents"),
                T("7 intents: Success, Error, Warning, Info, Danger, Primary, Secondary, Neutral.", "7 intents: Success, Error, Warning, Info, Danger, Primary, Secondary, Neutral."),
                ExIntents(), CodeIntents)

            @Example(T("3. Serviço", "3. Service"),
                T("XFToastService.SuccessAsync, ErrorAsync, WarningAsync, InfoAsync.", "XFToastService.SuccessAsync, ErrorAsync, WarningAsync, InfoAsync."),
                ExService(), CodeService)

            @Example(T("4. Posições", "4. Positions"),
                T("6 posições: TopStart, Top, TopEnd, BottomStart, Bottom, BottomEnd.", "6 positions: TopStart, Top, TopEnd, BottomStart, Bottom, BottomEnd."),
                ExPositions(), CodePositions)

            @Example(T("5. Duração", "5. Duration"),
                T("Persistente (Duration=0) vs auto-dismiss com Duration em ms.", "Persistent (Duration=0) vs auto-dismiss with Duration in ms."),
                ExDuration(), CodeDuration)

            @Example(T("6. Cores ricas", "6. Rich Colors"),
                T("RichColors=true vs false para cores intensas.", "RichColors=true vs false for intense colors."),
                ExRichColors(), CodeRichColors)

            @Example(T("7. Botão de ação", "7. Action Button"),
                T("Action + ActionText com callback para ação contextual.", "Action + ActionText with callback for contextual action."),
                ExActionButton(), CodeActionButton)

            @Example(T("8. Botão fechar", "8. Close Button"),
                T("Dismissible na Options e CloseButton no componente.", "Dismissible in Options and CloseButton on component."),
                ExCloseButton(), CodeCloseButton)

            @Example(T("9. Expandido", "9. Expanded"),
                T("Expanded=true para toast com conteúdo completo.", "Expanded=true for toast with full content."),
                ExExpanded(), CodeExpanded)

            @Example(T("10. Cenário enterprise", "10. Enterprise Scenario"),
                T("Notificações para operações fiscais: aprovação NF-e, confirmação de pagamento.", "Notifications for fiscal operations: NF-e approval, payment confirmation."),
                ExEnterprise(), CodeEnterprise)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("API do XFToast", "XFToast API"), @<div>@ApiTable(ApiRows)</div>)
            @Section(T("API do XFToastService", "XFToastService API"), @<div>@ApiTable(ServiceApiRows)</div>)
            @Section(T("API do XFToastOptions", "XFToastOptions API"), @<div>@ApiTable(OptionsApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenários enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padrões de composição", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Anti-padrões", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
            @Section(T("Boas práticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Propósito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidência", "Evidence"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versão", "Version"), T("Mudança", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>

@code {
    private string T(string pt, string en) => LanguageService.Text(pt, en);
    private string CopyableCodeTitle => T("Copiar código", "Copy code");

    [Inject] private XFToastService ToastService { get; set; } = default!;

    // === HERO (hardcoded strings to avoid CS0236) ===
    private static readonly XFToastItem HeroSuccess = CreateHeroToast(XFIntent.Success, "Sincronizado", "Dados enviados para o ERP.");
    private static readonly XFToastItem HeroWarning = CreateHeroToast(XFIntent.Warning, "Atenção", "3 registros pendentes de validação.");
    private static readonly XFToastItem HeroError = CreateHeroToast(XFIntent.Danger, "Erro", "Falha na conexão com SEFAZ.");

    private static XFToastItem CreateHeroToast(XFIntent intent, string title, string message) =>
        new(Guid.NewGuid(), new XFToastOptions {
            Title = title,
            Message = message,
            Intent = intent,
            RichColors = true
        });

    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFToast Item="HeroSuccess" CloseButton="true" RichColors="true" />
        <XFToast Item="HeroWarning" CloseButton="true" RichColors="true" />
        <XFToast Item="HeroError" CloseButton="true" RichColors="true" />
    </XFStack>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("role=alert", "role=alert"), T("Notificação com role=alert e aria-live para leitores de tela.", "Notification with role=alert and aria-live for screen readers."), "universal-access"),
        new(T("7 intents", "7 intents"), T("Success, Error, Warning, Info, Danger, Primary, Secondary, Neutral.", "Success, Error, Warning, Info, Danger, Primary, Secondary, Neutral."), "palette"),
        new(T("Serviço DI", "DI service"), T("XFToastService injetável para criar toasts de qualquer lugar.", "Injectable XFToastService to create toasts from anywhere."), "code")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFToast"),
        new("Namespace", "XForge.DesignSystem.Components.Feedback.Toast"),
        new("Package", "XForge.DesignSystem"),
        new("Category", "Components / Feedback / Toast"),
        new("Status", T("Estável", "Stable")),
        new("Accessibility", T("role=alert, aria-live, aria-atomic, botão fechar com aria-label.", "role=alert, aria-live, aria-atomic, close button with aria-label.")),
        new("Theme support", T("Light, dark e data-brand via tokens.", "Light, dark and data-brand via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("Notificação temporária", "Temporary notification"), T("Feedback assíncrono que desaparece automaticamente.", "Async feedback that disappears automatically."), "bell"),
        new(T("7 intents semânticos", "7 semantic intents"), T("Cores e ícones por tipo de mensagem.", "Colors and icons per message type."), "palette"),
        new(T("Serviço programático", "Programmatic service"), T("XFToastService para criar toasts de qualquer camada.", "XFToastService to create toasts from any layer."), "code")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Feedback de operação", "Operation feedback"), T("Confirmar que uma ação foi concluída com sucesso ou falhou.", "Confirm that an action completed successfully or failed."), "check-circle"),
        new(T("Alertas proativos", "Proactive alerts"), T("Notificar o usuário sobre eventos que precisam de atenção.", "Notify the user about events needing attention."), "bell"),
        new(T("Status assíncrono", "Async status"), T("Acompanhar processos em segundo plano sem bloquear a UI.", "Track background processes without blocking the UI."), "spinner")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Alerts fixos na página ou modais para feedback simples.", "Fixed alerts on page or modals for simple feedback."), "xmark"),
        new(T("Depois", "After"), T("Toasts temporários que não interrompem o fluxo do usuário.", "Temporary toasts that don't interrupt user flow."), "check"),
        new(T("Risco reduzido", "Reduced risk"), T("role=alert e aria-live garantem acessibilidade.", "role=alert and aria-live ensure accessibility."), "shield-check")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Feedback de operação", "Operation feedback"), T("Salvar, excluir, enviar, sincronizar.", "Save, delete, send, sync."), "check-circle"),
        new(T("Alertas de sistema", "System alerts"), T("Erros de conexão, timeout, manutenção.", "Connection errors, timeout, maintenance."), "triangle-exclamation"),
        new(T("Confirmações", "Confirmations"), T("Aprovação, rejeição, processamento concluído.", "Approval, rejection, processing completed."), "circle-check"),
        new(T("Notificações em lote", "Batch notifications"), T("Processamento de NF-e, folha, importação.", "NF-e processing, payroll, import."), "layer-group")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Informação persistente", "Persistent information"), T("Use Alert ou Banner para informações que devem permanecer.", "Use Alert or Banner for information that should persist."), "xmark"),
        new(T("Muitos toasts simultâneos", "Too many simultaneous toasts"), T("Limite de 3-4 toasts visíveis simultaneamente.", "Limit of 3-4 visible toasts simultaneously."), "layer-group"),
        new(T("Conteúdo interativo", "Interactive content"), T("Toasts não devem conter formulários ou inputs complexos.", "Toasts must not contain forms or complex inputs."), "triangle-exclamation")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new(T("Ícone de intent", "Intent icon"), T("Ícone automático por tipo de mensagem.", "Automatic icon per message type."), "circle"),
        new(T("Título", "Title"), T("Título breve e descritivo.", "Brief and descriptive title."), "font"),
        new(T("Mensagem", "Message"), T("Corpo da notificação.", "Notification body."), "align-left"),
        new(T("Ação / Fechar", "Action / Close"), T("Botão de ação contextual e botão fechar.", "Contextual action button and close button."), "check-circle")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(T("Non-blocking", "Non-blocking"), T("Toasts nunca interrompem a interação do usuário.", "Toasts never interrupt user interaction."), "ban"),
        new(T("Semântica visual", "Visual semantics"), T("Cor e ícone transmitem severidade imediatamente.", "Color and icon convey severity immediately."), "palette"),
        new(T("Mínimo necessário", "Minimum necessary"), T("Título + mensagem. Sem textos longos ou detalhes.", "Title + message. No long text or details."), "minimize")
    ];

    // === 1. Basic ===
    private static readonly XFToastItem BasicToast = new(Guid.NewGuid(), new XFToastOptions {
        Title = "Operação concluída",
        Message = "Registro salvo com sucesso.",
        Intent = XFIntent.Success,
        RichColors = true
    });

    private RenderFragment ExBasic() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFToast Item="BasicToast" CloseButton="true" RichColors="true" />
    </XFStack>;

    // === 2. Intents ===
    private static readonly XFToastItem IntentSuccess = new(Guid.NewGuid(), new XFToastOptions { Title = "Success", Message = "Operação realizada.", Intent = XFIntent.Success, RichColors = true });
    private static readonly XFToastItem IntentError = new(Guid.NewGuid(), new XFToastOptions { Title = "Error", Message = "Falha na operação.", Intent = XFIntent.Danger, RichColors = true });
    private static readonly XFToastItem IntentWarning = new(Guid.NewGuid(), new XFToastOptions { Title = "Warning", Message = "Atenção necessária.", Intent = XFIntent.Warning, RichColors = true });
    private static readonly XFToastItem IntentInfo = new(Guid.NewGuid(), new XFToastOptions { Title = "Info", Message = "Informação importante.", Intent = XFIntent.Info, RichColors = true });
    private static readonly XFToastItem IntentPrimary = new(Guid.NewGuid(), new XFToastOptions { Title = "Primary", Message = "Notificação primária.", Intent = XFIntent.Primary, RichColors = true });
    private static readonly XFToastItem IntentSecondary = new(Guid.NewGuid(), new XFToastOptions { Title = "Secondary", Message = "Notificação secundária.", Intent = XFIntent.Secondary, RichColors = true });
    private static readonly XFToastItem IntentNeutral = new(Guid.NewGuid(), new XFToastOptions { Title = "Neutral", Message = "Notificação neutra.", Intent = XFIntent.Neutral, RichColors = true });

    private RenderFragment ExIntents() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFToast Item="IntentSuccess" CloseButton="true" RichColors="true" />
        <XFToast Item="IntentError" CloseButton="true" RichColors="true" />
        <XFToast Item="IntentWarning" CloseButton="true" RichColors="true" />
        <XFToast Item="IntentInfo" CloseButton="true" RichColors="true" />
        <XFToast Item="IntentPrimary" CloseButton="true" RichColors="true" />
        <XFToast Item="IntentSecondary" CloseButton="true" RichColors="true" />
        <XFToast Item="IntentNeutral" CloseButton="true" RichColors="true" />
    </XFStack>;

    // === 3. Service ===
    private async Task ShowSuccessToast() => await ToastService.SuccessAsync(T("Concluído", "Completed"), T("Operação realizada com sucesso.", "Operation completed successfully."));
    private async Task ShowErrorToast() => await ToastService.ErrorAsync(T("Erro", "Error"), T("Falha na operação.", "Operation failed."));
    private async Task ShowWarningToast() => await ToastService.WarningAsync(T("Atenção", "Warning"), T("Verifique os dados.", "Check the data."));
    private async Task ShowInfoToast() => await ToastService.InfoAsync(T("Informação", "Info"), T("Processamento em andamento.", "Processing in progress."));

    private RenderFragment ExService() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
            <XFButton Variant="XFButtonVariant.Solid" Color="XFButtonColor.Success" Size="XFExtendedSize.Sm" OnClick="ShowSuccessToast">SuccessAsync</XFButton>
            <XFButton Variant="XFButtonVariant.Solid" Color="XFButtonColor.Danger" Size="XFExtendedSize.Sm" OnClick="ShowErrorToast">ErrorAsync</XFButton>
            <XFButton Variant="XFButtonVariant.Solid" Color="XFButtonColor.Warning" Size="XFExtendedSize.Sm" OnClick="ShowWarningToast">WarningAsync</XFButton>
            <XFButton Variant="XFButtonVariant.Solid" Color="XFButtonColor.Info" Size="XFExtendedSize.Sm" OnClick="ShowInfoToast">InfoAsync</XFButton>
        </XFStack>
    </XFStack>;

    // === 4. Positions ===
    private async Task ShowPositionToast(XFToastPlacement placement) =>
        await ToastService.ShowAsync(new XFToastOptions {
            Title = "Posição",
            Message = $"Toast em {placement}",
            Intent = XFIntent.Info,
            Placement = placement,
            RichColors = true
        });

    private RenderFragment ExPositions() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
            <XFButton Variant="XFButtonVariant.Outline" Color="XFButtonColor.Info" Size="XFExtendedSize.Sm" OnClick="() => ShowPositionToast(XFToastPlacement.TopStart)">TopStart</XFButton>
            <XFButton Variant="XFButtonVariant.Outline" Color="XFButtonColor.Info" Size="XFExtendedSize.Sm" OnClick="() => ShowPositionToast(XFToastPlacement.Top)">Top</XFButton>
            <XFButton Variant="XFButtonVariant.Outline" Color="XFButtonColor.Info" Size="XFExtendedSize.Sm" OnClick="() => ShowPositionToast(XFToastPlacement.TopEnd)">TopEnd</XFButton>
            <XFButton Variant="XFButtonVariant.Outline" Color="XFButtonColor.Info" Size="XFExtendedSize.Sm" OnClick="() => ShowPositionToast(XFToastPlacement.BottomStart)">BottomStart</XFButton>
            <XFButton Variant="XFButtonVariant.Outline" Color="XFButtonColor.Info" Size="XFExtendedSize.Sm" OnClick="() => ShowPositionToast(XFToastPlacement.Bottom)">Bottom</XFButton>
            <XFButton Variant="XFButtonVariant.Outline" Color="XFButtonColor.Info" Size="XFExtendedSize.Sm" OnClick="() => ShowPositionToast(XFToastPlacement.BottomEnd)">BottomEnd</XFButton>
        </XFStack>
    </XFStack>;

    // === 5. Duration ===
    private async Task ShowDurationToast(int? duration) =>
        await ToastService.ShowAsync(new XFToastOptions {
            Title = "Duração",
            Message = duration.HasValue && duration.Value > 0 ? $"Auto-dismiss em {duration}ms" : "Persistente (sem auto-dismiss)",
            Intent = XFIntent.Info,
            Duration = duration,
            RichColors = true
        });

    private RenderFragment ExDuration() => @<XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
        <XFButton Variant="XFButtonVariant.Outline" Color="XFButtonColor.Info" Size="XFExtendedSize.Sm" OnClick="() => ShowDurationToast(2000)">2s</XFButton>
        <XFButton Variant="XFButtonVariant.Outline" Color="XFButtonColor.Info" Size="XFExtendedSize.Sm" OnClick="() => ShowDurationToast(5000)">5s</XFButton>
        <XFButton Variant="XFButtonVariant.Outline" Color="XFButtonColor.Info" Size="XFExtendedSize.Sm" OnClick="() => ShowDurationToast(10000)">10s</XFButton>
        <XFButton Variant="XFButtonVariant.Outline" Color="XFButtonColor.Warning" Size="XFExtendedSize.Sm" OnClick="() => ShowDurationToast(0)">Persistente</XFButton>
    </XFStack>;

    // === 6. Rich Colors ===
