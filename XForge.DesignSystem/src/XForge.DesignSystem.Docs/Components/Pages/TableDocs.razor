@page "/display/table"
@using XForge.DesignSystem.Core.Primitives
@using XForge.DesignSystem.Components.DataDisplay.Table
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFTable" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("6 componentes", "6 components")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Tabela semantica para dados tabulares com header, body, footer e celulas acessiveis.",
                               "Semantic table for tabular data with header, body, footer and accessible cells.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("Container estruturado para exibir dados em linhas e colunas, com suporte a zebra, hover, sticky, alinhamento e tamanhos responsivos. Para dados avancados com paginacao e ordenacao, use XFDataGrid.",
                               "Structured container to display data in rows and columns, with support for striping, hover, sticky, alignment and responsive sizes. For advanced data with pagination and sorting, use XFDataGrid.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico.", "Renders as static HTML.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 6 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Basico", "1. Basic"), T("Tabela simples com header e body.", "Simple table with header and body."), ExBasic(), Code1)
            @Example(T("2. Zebra + Hover", "2. Striped + Hover"), T("Linhas alternadas com destaque ao passar o mouse.", "Alternating rows with hover highlight."), ExStripedHover(), Code2)
            @Example(T("3. Compacta", "3. Compact"), T("Tamanho reduzido para muitos dados.", "Reduced size for dense data."), ExCompact(), Code3)
            @Example(T("4. Sticky Header + Scroll", "4. Sticky Header + Scroll"), T("Header fixo com scroll vertical controlado.", "Fixed header with controlled vertical scroll."), ExStickyHeader(), Code4)
            @Example(T("5. Footer com Totais", "5. Footer with Totals"), T("Rodape com somas e media de colunas numericas.", "Footer with sums and average of numeric columns."), ExFooter(), Code5)
            @Example(T("6. Celulas com Alinhamento", "6. Cell Alignment"), T("Alinhamento Start, Center e End em colunas.", "Start, Center and End alignment in columns."), ExAlignment(), Code6)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>
                <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">XFTable</XFTypography>
                    @ApiTable(XFTableApiRows)
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">XFTableCell</XFTypography>
                    @ApiTable(XFTableCellApiRows)
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">XFTableRow</XFTypography>
                    @ApiTable(XFTableRowApiRows)
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">XFTableHeader / XFTableBody / XFTableFooter</XFTypography>
                    @ApiTable(XFTableContainerApiRows)
                </XFStack>
            </div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string ProductLabelText => T("Core Open Source", "Core Open Source");
    private string PageTitleText => T("XFTable", "XFTable");
    private string PageStatusText => T("Documentacao completa", "Complete docs");
    private string T(string pt, string en) => LanguageService.Text(pt, en);
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFTable Caption="@T("Resumo operacional", "Operational summary")" Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader>
            <XFTableRow>
                <XFTableCell Header="true">@T("Modulo", "Module")</XFTableCell>
                <XFTableCell Header="true">@T("Status", "Status")</XFTableCell>
                <XFTableCell Header="true">@T("SLA", "SLA")</XFTableCell>
            </XFTableRow>
        </XFTableHeader>
        <XFTableBody>
            <XFTableRow><XFTableCell>Pedidos</XFTableCell><XFTableCell>Online</XFTableCell><XFTableCell>99.9%</XFTableCell></XFTableRow>
            <XFTableRow><XFTableCell>Fiscal</XFTableCell><XFTableCell>Atencao</XFTableCell><XFTableCell>98.4%</XFTableCell></XFTableRow>
            <XFTableRow><XFTableCell>Estoque</XFTableCell><XFTableCell>Online</XFTableCell><XFTableCell>99.7%</XFTableCell></XFTableRow>
        </XFTableBody>
    </XFTable>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("6 componentes", "6 components"), T("XFTable, XFTableHeader, XFTableBody, XFTableRow, XFTableCell, XFTableFooter.", "XFTable, XFTableHeader, XFTableBody, XFTableRow, XFTableCell, XFTableFooter."), "cubes"),
        new(T("Semantico e acessivel", "Semantic and accessible"), T("Table HTML nativo com role, scope e caption para leitores de tela.", "Native HTML table with role, scope and caption for screen readers."), "universal-access"),
        new(T("Zero JS", "Zero JS"), T("Nenhum JavaScript interop. Puro C# + Tailwind.", "No JavaScript interop. Pure C# + Tailwind."), "bolt")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFTable, XFTableHeader, XFTableBody, XFTableRow, XFTableCell, XFTableFooter"),
        new("Namespace", "XForge.DesignSystem.Components.DataDisplay.Table"),
        new("Package", "XForge.DesignSystem"),
        new("Category", "Data Display / Table"),
        new("Status", T("Estavel", "Stable")),
        new("Accessibility", T("role=table, caption, scope=col, th semantico.", "role=table, caption, scope=col, semantic th.")),
        new("Theme support", T("Light, dark e data-brand via tokens.", "Light, dark and data-brand via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("Container de tabela", "Table container"), T("Wrapper semantic com suporte a caption e aria.", "Semantic wrapper with caption and aria support."), "table"),
        new(T("Header, Body, Footer", "Header, Body, Footer"), T("Regioes semanticas thead, tbody e tfoot.", "Semantic thead, tbody and tfoot regions."), "layer-group"),
        new(T("Celulas acessiveis", "Accessible cells"), T("th com scope=col e td com alinhamento.", "th with scope=col and td with alignment."), "check-double")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Dados tabulares", "Tabular data"), T("Exibir dados estruturados em linhas e colunas.", "Display structured data in rows and columns."), "table"),
        new(T("Relatorios", "Reports"), T("Resumos operacionais e financeiros.", "Operational and financial summaries."), "chart-bar"),
        new(T("Listas simples", "Simple lists"), T("Dados estaticos sem necessidade de paginacao.", "Static data without need for pagination."), "list")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("HTML bruto sem padrao, inconsistente entre paginas.", "Raw HTML without pattern, inconsistent across pages."), "xmark"),
        new(T("Depois", "After"), T("Componente padronizado com zebra, hover, sticky e alinhamento.", "Standardized component with striping, hover, sticky and alignment."), "check"),
        new(T("Acessibilidade", "Accessibility"), T("Table nativo com caption, scope e th semantico.", "Native table with caption, scope and semantic th."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Dados estaticos", "Static data"), T("Dados que nao precisam de paginacao ou ordenacao client-side.", "Data that does not need client-side pagination or sorting."), "database"),
        new(T("Resumos", "Summaries"), T("Dashboards e relatorios com poucas linhas.", "Dashboards and reports with few rows."), "chart-bar")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Milhares de linhas", "Thousands of rows"), T("Use XFDataGrid para dados massivos com virtualizacao.", "Use XFDataGrid for massive data with virtualization."), "ban"),
        new(T("Ordenacao e filtragem", "Sorting and filtering"), T("Use XFDataGrid que suporta sort e filter nativos.", "Use XFDataGrid which supports native sort and filter."), "filter")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new(T("Caption", "Caption"), T("Legenda acessivel da tabela (aria).", "Accessible table caption (aria)."), "tag"),
        new(T("XFTableHeader", "XFTableHeader"), T("thead com headers das colunas em th.", "thead with column headers in th."), "heading"),
        new(T("XFTableBody", "XFTableBody"), T("tbody com dados em XFTableRow + XFTableCell.", "tbody with data in XFTableRow + XFTableCell."), "align-justify"),
        new(T("XFTableRow", "XFTableRow"), T("Linha individual com suporte a click e selected.", "Individual row with click and selected support."), "minus"),
        new(T("XFTableCell", "XFTableCell"), T("Celula com align, colSpan, rowSpan e sticky.", "Cell with align, colSpan, rowSpan and sticky."), "square"),
        new(T("XFTableFooter", "XFTableFooter"), T("tfoot para totais ou notas de rodape.", "tfoot for totals or footer notes."), "file-lines")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(T("HTML semantico", "Semantic HTML"), T("Table nativo com thead, tbody, tfoot, th e caption.", "Native table with thead, tbody, tfoot, th and caption."), "code"),
        new(T("Separacao de concerns", "Separation of concerns"), T("Cada sub-componente tem uma responsabilidade unica.", "Each sub-component has a single responsibility."), "layer-group"),
        new(T("Progressive enhancement", "Progressive enhancement"), T("Funciona sem JS. Melhora com interacoes.", "Works without JS. Improves with interactions."), "arrow-up")
    ];

    // === EXAMPLES ===
    private RenderFragment ExBasic() => @<XFTable Caption="@T("Resumo operacional", "Operational summary")">
        <XFTableHeader>
            <XFTableRow>
                <XFTableCell Header="true">@T("Modulo", "Module")</XFTableCell>
                <XFTableCell Header="true">@T("Status", "Status")</XFTableCell>
                <XFTableCell Header="true">@T("SLA", "SLA")</XFTableCell>
            </XFTableRow>
        </XFTableHeader>
        <XFTableBody>
            <XFTableRow><XFTableCell>Pedidos</XFTableCell><XFTableCell>Online</XFTableCell><XFTableCell>99.9%</XFTableCell></XFTableRow>
            <XFTableRow><XFTableCell>Fiscal</XFTableCell><XFTableCell>Atencao</XFTableCell><XFTableCell>98.4%</XFTableCell></XFTableRow>
            <XFTableRow><XFTableCell>Estoque</XFTableCell><XFTableCell>Online</XFTableCell><XFTableCell>99.7%</XFTableCell></XFTableRow>
        </XFTableBody>
    </XFTable>;

    private RenderFragment ExStripedHover() => @<XFTable Caption="@T("Financeiro", "Financial")" Striped="true" Hoverable="true">
        <XFTableHeader>
            <XFTableRow>
                <XFTableCell Header="true">@T("Conta", "Account")</XFTableCell>
                <XFTableCell Header="true">@T("Tipo", "Type")</XFTableCell>
                <XFTableCell Header="true">@T("Saldo", "Balance")</XFTableCell>
            </XFTableRow>
        </XFTableHeader>
        <XFTableBody>
            <XFTableRow><XFTableCell>Caixa</XFTableCell><XFTableCell>Ativo</XFTableCell><XFTableCell>R$ 120.000</XFTableCell></XFTableRow>
            <XFTableRow><XFTableCell>Banco BB</XFTableCell><XFTableCell>Ativo</XFTableCell><XFTableCell>R$ 450.000</XFTableCell></XFTableRow>
            <XFTableRow><XFTableCell>Fornecedores</XFTableCell><XFTableCell>Passivo</XFTableCell><XFTableCell>R$ -80.000</XFTableCell></XFTableRow>
            <XFTableRow><XFTableCell>Clientes</XFTableCell><XFTableCell>Ativo</XFTableCell><XFTableCell>R$ 230.000</XFTableCell></XFTableRow>
        </XFTableBody>
    </XFTable>;

    private RenderFragment ExCompact() => @<XFTable Caption="@T("Usuarios", "Users")" Compact="true" Size="XFSize.Sm">
        <XFTableHeader>
            <XFTableRow>
                <XFTableCell Header="true">@T("Nome", "Name")</XFTableCell>
                <XFTableCell Header="true">Email</XFTableCell>
                <XFTableCell Header="true">@T("Perfil", "Profile")</XFTableCell>
            </XFTableRow>
        </XFTableHeader>
        <XFTableBody>
            <XFTableRow><XFTableCell>Ana Silva</XFTableCell><XFTableCell>ana@empresa.com</XFTableCell><XFTableCell>Admin</XFTableCell></XFTableRow>
            <XFTableRow><XFTableCell>Carlos Lima</XFTableCell><XFTableCell>carlos@empresa.com</XFTableCell><XFTableCell>User</XFTableCell></XFTableRow>
            <XFTableRow><XFTableCell>Maria Souza</XFTableCell><XFTableCell>maria@empresa.com</XFTableCell><XFTableCell>User</XFTableCell></XFTableRow>
        </XFTableBody>
    </XFTable>;

    private RenderFragment ExStickyHeader() => @<XFTable Caption="@T("Historico de transacoes", "Transaction history")" StickyHeader="true" ViewportRows="5">
        <XFTableHeader>
            <XFTableRow>
                <XFTableCell Header="true">@T("Data", "Date")</XFTableCell>
                <XFTableCell Header="true">@T("Descricao", "Description")</XFTableCell>
                <XFTableCell Header="true">@T("Valor", "Value")</XFTableCell>
            </XFTableRow>
        </XFTableHeader>
        <XFTableBody>
            <XFTableRow><XFTableCell>2026-06-01</XFTableCell><XFTableCell>Pedido #1001</XFTableCell><XFTableCell>R$ 1.500,00</XFTableCell></XFTableRow>
            <XFTableRow><XFTableCell>2026-06-02</XFTableCell><XFTableCell>Pedido #1002</XFTableCell><XFTableCell>R$ 2.300,00</XFTableCell></XFTableRow>
            <XFTableRow><XFTableCell>2026-06-03</XFTableCell><XFTableCell>Pedido #1003</XFTableCell><XFTableCell>R$ 800,00</XFTableCell></XFTableRow>
