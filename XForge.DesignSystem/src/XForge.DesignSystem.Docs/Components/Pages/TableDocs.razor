    private RenderFragment ExAlignment() => @<XFTable Caption="@T("Alinhamento de colunas", "Column alignment")" Striped="true">
        <XFTableHeader>
            <XFTableRow>
                <XFTableCell Header="true" Align="XFTableAlign.Start">@T("Texto (Start)", "Text (Start)")</XFTableCell>
                <XFTableCell Header="true" Align="XFTableAlign.Center">@T("Centro (Center)", "Center (Center)")</XFTableCell>
                <XFTableCell Header="true" Align="XFTableAlign.End">@T("Numero (End)", "Number (End)")</XFTableCell>
            </XFTableRow>
        </XFTableHeader>
        <XFTableBody>
