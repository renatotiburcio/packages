            <XFTableRow><XFTableCell>2026-06-07</XFTableCell><XFTableCell>Pedido #1007</XFTableCell><XFTableCell>R$ 4.000,00</XFTableCell></XFTableRow>
        </XFTableBody>
    </XFTable>;

    private RenderFragment ExFooter() => @<XFTable Caption="@T("Resumo financeiro", "Financial summary")" Striped="true">
        <XFTableHeader>
            <XFTableRow>
                <XFTableCell Header="true">@T("Produto", "Product")</XFTableCell>
                <XFTableCell Header="true">@T("Qtd", "Qty")</XFTableCell>
                <XFTableCell Header="true">@T("Valor Unit.", "Unit Price")</XFTableCell>
                <XFTableCell Header="true">@T("Total", "Total")</XFTableCell>
