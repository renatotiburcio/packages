@page "/forms/one-time-input"

@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@T("Core Open Source", "Core Open Source")"
                 Title="OneTimeInput"
                 Status="@T("Documentacao completa", "Complete docs")"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFOneTimeInput" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("OTP Input", "OTP Input")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Auto-focus", "Auto-focus")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Paste", "Paste")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Input de OTP/PIN com slots individuais, auto-focus, mascara, agrupamento e suporte a colar.", "OTP/PIN input with individual slots, auto-focus, masking, grouping and paste support.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("XFOneTimeInput e o campo especializado para codigos OTP e PIN com slots individuais, auto-focus entre campos, mascara de digitos, agrupamento configuravel e suporte a colar codigos.", "XFOneTimeInput is the specialized field for OTP and PIN codes with individual slots, auto-focus between fields, digit masking, configurable grouping and paste support.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts)
                            {
                                @Tile(item)
                            }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section(T("Blazor Server e Blazor WebAssembly", "Blazor Server and Blazor WebAssembly"), @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona com prerender-safe guards.", "Works with prerender-safe guards.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona com prerender-safe guards no primeiro render.", "Works with prerender-safe guards on first render.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Parcial", "Partial")" /></XFTableCell><XFTableCell>@T("Renderiza HTML base. Auto-focus e paste indisponiveis durante prerender.", "Renders base HTML. Auto-focus and paste unavailable during prerender.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("JS Interop", "JS Interop")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Arquivo JS: xf-onetimeinput.js — gerencia auto-focus entre slots, distribuicao de paste e focus programatico via FocusSlotAsync.", "JS file: xf-onetimeinput.js — manages auto-focus between slots, paste distribution and programmatic focus via FocusSlotAsync.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Quando carrega: OnAfterRenderAsync.", "When loaded: OnAfterRenderAsync.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Prerender seguro: try/catch para InvalidOperationException e JSDisconnectedException.", "Prerender safe: try/catch for InvalidOperationException and JSDisconnectedException.")</XFTypography>
                </XFStack>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Consideracoes Blazor Server", "Blazor Server Considerations")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("JS interop via SignalR com latencia. Auto-focus entre slots pode ter resposta mais lenta.", "JS interop via SignalR with latency. Auto-focus between slots may have slower response.")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Consideracoes Blazor WebAssembly", "Blazor WebAssembly Considerations")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("JS interop direto sem latencia de rede. Disponivel apos carregamento do WASM.", "Direct JS interop with no network latency. Available after WASM load.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 2)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                        @Example(T("Preview basico", "Basic Preview"),
                T("OTP de 6 digitos com agrupamento e PIN mascarado.", "6-digit OTP with grouping and masked PIN."),
                HeroPreview(), BasicCode)
            @Example(T("Configuracoes", "Configurations"),
                T("Diferentes digitos, grupos e mascaras.", "Different digits, groups and masks."),
                ConfigPreview(), ConfigCode)
            @Example(T("Cenarios enterprise", "Enterprise Scenarios"),
                T("Verificacao de login e 2FA.", "Login verification and 2FA."),
                EnterprisePreview(), EnterpriseCode)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("Design Tokens", @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>

@code {
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);

    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFOneTimeInput Label="@T("Codigo de verificacao", "Verification code")" Digits="6" Group="3,3" />
        <XFOneTimeInput Label="PIN" Digits="4" Mask="true" />
    </XFStack>;


    private IReadOnlyList<DocTile> QuickFacts =>
    [
        new(T("Slots individuais", "Individual slots"), T("Cada digito em seu proprio campo focavel.", "Each digit in its own focusable field."), "keyboard"),
        new(T("Auto-focus", "Auto-focus"), T("Avanca automaticamente para o proximo slot.", "Automatically advances to the next slot."), "bolt"),
        new(T("Colar codigo", "Paste code"), T("Suporta colar codigos inteiros.", "Supports pasting entire codes."), "clipboard")
    ];

    private IReadOnlyList<NameValueRow> MetadataRows =>
    [
        new("Component", "XFOneTimeInput"),
        new("Namespace", "XForge.DesignSystem.Components.Forms.OneTimeInput"),
        new("Package", "XForge.DesignSystem"),
        new("Category", "Forms / OneTimeInput"),
        new("Status", T("Estavel", "Stable")),
        new("Accessibility", T("Label, aria-label por slot, autocomplete one-time-code.", "Label, aria-label per slot, autocomplete one-time-code."))
    ];

    private IReadOnlyList<DocTile> OverviewItems =>
    [
        new(T("Slots de digito", "Digit slots"), T("Campos individuais para cada caractere.", "Individual fields for each character."), "keyboard"),
        new(T("Agrupamento", "Grouping"), T("Separadores visuais entre grupos de digitos.", "Visual separators between digit groups."), "layer-group"),
        new(T("Mascara", "Mask"), T("Ocultar digitos para PINs sensiveis.", "Hide digits for sensitive PINs."), "eye-slash")
    ];

    private IReadOnlyList<DocTile> PurposeItems =>
    [
        new(T("Verificacao OTP", "OTP verification"), T("Inserir codigos de verificacao por email ou SMS.", "Enter verification codes from email or SMS."), "shield-check"),
        new(T("PIN de acesso", "Access PIN"), T("Inserir PIN de 4-6 digitos.", "Enter 4-6 digit PIN."), "key"),
        new(T("2FA", "2FA"), T("Codigos de autenticacao em dois fatores.", "Two-factor authentication codes."), "lock")
    ];

    private IReadOnlyList<DocTile> ProblemItems =>
    [
        new(T("Antes", "Before"), T("Input unico para OTP e confuso e dificil de usar.", "Single input for OTP is confusing and hard to use."), "xmark"),
        new(T("Depois", "After"), T("Slots individuais com auto-focus e feedback claro.", "Individual slots with auto-focus and clear feedback."), "check"),
        new(T("Risco reduzido", "Reduced risk"), T("Reduz erros de digitacao e melhora experiencia.", "Reduces typing errors and improves experience."), "shield-check")
    ];

    private IReadOnlyList<DocTile> UseItems =>
    [
        new("Login", T("Verificacao de codigo por email/SMS.", "Email/SMS code verification."), "key"),
        new("2FA", T("Autenticacao em dois fatores.", "Two-factor authentication."), "lock"),
        new("Transacao", T("Confirmacao de transacao financeira.", "Financial transaction confirmation."), "chart-line-up")
    ];

    private IReadOnlyList<DocTile> AvoidItems =>
    [
        new(T("Texto livre", "Free text"), T("Use XFTextInput para campos de texto.", "Use XFTextInput for text fields."), "triangle-exclamation"),
        new(T("Senha", "Password"), T("Use XFPasswordStrength para senhas.", "Use XFPasswordStrength for passwords."), "eye")
    ];

    private IReadOnlyList<DocTile> AnatomyItems =>
    [
        new("Root", T("Container com label, grupos de slots e helper.", "Container with label, slot groups and helper."), "code"),
        new("Slot", T("Campo individual com h-10 w-10 e focus ring.", "Individual field with h-10 w-10 and focus ring."), "square"),
        new("Separator", T("Separador visual entre grupos (ex: -).", "Visual separator between groups (e.g. -)."), "minus"),
        new("Helper", T("Texto de ajuda abaixo dos slots.", "Help text below slots."), "tag")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems =>
    [
        new(T("Auto-focus", "Auto-focus"), T("Avanca e retrocede automaticamente.", "Advances and retreats automatically."), "bolt"),
        new(T("Feedback claro", "Clear feedback"), T("Cada slot mostra digito ou placeholder.", "Each slot shows digit or placeholder."), "eye"),
        new(T("Colar suportado", "Paste supported"), T("Colar codigo completo distribui nos slots.", "Pasting complete code distributes to slots."), "clipboard")
    ];

    private IReadOnlyList<ApiRow> ApiRows =>
    [
        new("Value", "string?", "null", T("Valor combinado de todos os slots.", "Combined value of all slots.")),
        new("ValueChanged", "EventCallback<string?>", "default", T("Two-way binding.", "Two-way binding.")),
        new("Change", "EventCallback<string?>", "default", T("Mudanca confirmada.", "Committed change.")),
        new("OnComplete", "EventCallback<string>", "default", T("Disparado quando todos digitos preenchidos.", "Fired when all digits filled.")),
        new("Label", "string?", "null", T("Texto do label.", "Label text.")),
        new("AriaLabel", "string?", "null", T("Label acessivel.", "Accessible label.")),
        new("HelperText", "string?", "null", T("Texto de ajuda.", "Helper text.")),
        new("Digits", "int", "6", T("Quantidade de digitos.", "Number of digits.")),
        new("Group", "string?", "\"3,3\"", T("Tamanhos dos grupos separados por virgula.", "Group sizes separated by comma.")),
        new("Separator", "string", "\"-\"", T("Caractere separador entre grupos.", "Separator character between groups.")),
        new("InputMode", "string", "\"numeric\"", T("Tipo de teclado mobile.", "Mobile keyboard type.")),
        new("Pattern", "string", "\"[0-9]*\"", T("Padrao de validacao.", "Validation pattern.")),
        new("AutoComplete", "string", "\"one-time-code\"", T("Autocompletar OTP.", "OTP autocomplete.")),
        new("Mask", "bool", "false", T("Oculta digitos com bullet.", "Hides digits with bullet.")),
        new("ReadOnly", "bool", "false", T("Somente leitura.", "Read-only.")),
        new("Required", "bool", "false", T("Obrigatorio.", "Required.")),
        new("FullWidth", "bool", "false", T("Ocupa toda a largura.", "Fills width.")),
        new("AutoFocusNext", "bool", "true", T("Avanca foco automaticamente.", "Advances focus automatically.")),
        new("SlotAriaLabelFormat", "string", "\"Caractere {0} de {1}\"", T("Formato do aria-label de cada slot.", "Format of each slot aria-label."))
    ];

    private IReadOnlyList<NameValueRow> EventRows =>
    [
        new("ValueChanged", T("A cada mudanca de digito.", "On each digit change.")),
        new("Change", T("Valor completo alterado.", "Complete value changed.")),
        new("OnComplete", T("Todos os digitos preenchidos.", "All digits filled."))
    ];

    private IReadOnlyList<DocTile> AccessibilityItems =>
    [
        new("Label", T("Label associado ao grupo.", "Label associated to group."), "tag"),
        new("Slot labels", T("aria-label por slot: Caractere N de M.", "aria-label per slot: Character N of M."), "universal-access"),
        new("AutoComplete", T("one-time-code para autofill do browser.", "one-time-code for browser autofill."), "bolt")
    ];

    private IReadOnlyList<NameValueRow> KeyboardRows =>
    [
        new("Tab", T("Foca primeiro slot.", "Focuses first slot.")),
        new("Shift+Tab", T("Controle anterior.", "Previous control.")),
        new("Backspace", T("Apaga slot atual e volta.", "Deletes current slot and retreats.")),
        new("Digitos", T("Preenche e avanca.", "Fills and advances.")),
        new("Paste", T("Distribui codigo nos slots.", "Distributes code to slots."))
    ];

    private IReadOnlyList<DocTile> ResponsivenessItems =>
    [
        new("FullWidth", T("Slots empilham se necessario.", "Slots stack if necessary."), "mobile-screen"),
        new("Group", T("Separadores mantem legibilidade.", "Separators maintain readability."), "minus")
    ];

    private IReadOnlyList<DocTile> PerformanceItems =>
    [
        new("JS interop", T("Apenas para focus programatico.", "Only for programmatic focus."), "bolt"),
        new("Light DOM", T("Slots sao inputs nativos.", "Slots are native inputs."), "code")
    ];

    private IReadOnlyList<DocTile> ScenarioItems =>
    [
        new("Login", T("Verificacao de codigo por email/SMS.", "Email/SMS code verification."), "key"),
        new("2FA", T("Autenticacao dois fatores.", "Two-factor authentication."), "lock"),
        new("Financeiro", T("Confirmacao de transacao.", "Transaction confirmation."), "chart-line-up"),
        new("ERP", T("Aprovacao de operacao.", "Operation approval."), "briefcase"),
        new("Portal", T("Verificacao de conta.", "Account verification."), "globe"),
        new("RH", T("Verificacao de identidade.", "Identity verification."), "users")
    ];

    private IReadOnlyList<DocTile> CompositionItems =>
    [
        new("Dialog", T("Use em modais de verificacao.", "Use in verification modals."), "window-restore"),
        new("Card", T("Use em cards de login.", "Use in login cards."), "square"),
        new("Formularios", T("Use com XFEditForm.", "Use with XFEditForm."), "file-lines")
    ];

    private IReadOnlyList<DocTile> BestPracticeItems =>
    [
        new("AutoComplete", T("Mantenha one-time-code para autofill.", "Keep one-time-code for autofill."), "bolt"),
        new("Group", T("Agrupe 3+3 ou 4+4 para legibilidade.", "Group 3+3 or 4+4 for readability."), "layer-group"),
        new("OnComplete", T("Use para submissao automatica.", "Use for auto-submission."), "bolt")
    ];

    private IReadOnlyList<DocTile> AntiPatternItems =>
    [
        new("Input unico", T("Use slots individuais para OTP.", "Use individual slots for OTP."), "xmark"),
        new("Sem label", T("Contexto e obrigatorio para OTP.", "Context is required for OTP."), "eye-slash")
    ];


    private IReadOnlyList<NameValueRow> TokenRows =>
    [
        new("colors", T("border-surface-200, focus:border-primary, focus:ring-primary.", "border-surface-200, focus:border-primary, focus:ring-primary.")),
        new("typography", T("text-base font-semibold para slots.", "text-base font-semibold for slots.")),
        new("spacing", T("h-10 w-10, gap-1.5, gap-2.", "h-10 w-10, gap-1.5, gap-2."))
    ];

    private IReadOnlyList<DocTile> ThemeItems =>
    [
        new("data-theme", T("Light e dark via CSS variables.", "Light and dark via CSS variables."), "moon"),
        new("Contraste", T("AA em ambos temas.", "AA in both themes."), "eye")
    ];

    private IReadOnlyList<NameValueRow> TestingRows =>
    [
        new("Unit", T("Render, slots, auto-focus, paste, backspace, complete.", "Render, slots, auto-focus, paste, backspace, complete.")),
        new("Accessibility", T("Label, slot aria-label, autocomplete.", "Label, slot aria-label, autocomplete."))
    ];

    private IReadOnlyList<NameValueRow> LimitationRows =>
    [
        new("JS dependency", T("Focus programatico requer JS interop.", "Programmatic focus requires JS interop.")),
        new(T("Somente chars", "Chars only"), T("Nao suporta campos multi-linha.", "No multi-line fields."))
    ];

    private IReadOnlyList<DocTile> RelatedComponentItems =>
    [
        new("XFPasswordStrength", T("Para senhas com forca.", "For passwords with strength."), "key"),
        new("XFTextInput", T("Input de texto generico.", "Generic text input."), "font"),
        new("XFField", T("Wrapper de campo.", "Field wrapper."), "tag")
    ];

    private IReadOnlyList<NameValueRow> FaqRows =>
    [
        new(T("Colar funciona?", "Does paste work?"), T("Sim, codigo colado distribui nos slots.", "Yes, pasted code distributes to slots.")),
        new(T("Grupos?", "Groups?"), T("Group=\"3,3\" separa em 2 grupos de 3.", "Group=\"3,3\" separates into 2 groups of 3."))
    ];

    private IReadOnlyList<NameValueRow> ChangelogRows =>
    [
        new("2026-05-26", T("Pagina criada no padrao enterprise.", "Page created in enterprise standard."))
    ];

    private RenderFragment ConfigPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFOneTimeInput Label="PIN 4" Digits="4" />
        <XFOneTimeInput Label=@T("OTP 6 grupos 2", "OTP 6 groups 2")" Digits="6" Group="2,2,2" />
        <XFOneTimeInput Label=@T("PIN mascarado", "Masked PIN")" Digits="4" Mask="true" />
    </XFStack>;

    private RenderFragment EnterprisePreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFOneTimeInput Label=@T("Codigo de verificacao", "Verification code")" Digits="6" Group="3,3" OnComplete="EventCallback.Factory.Create<string>(this, code => { })" />
    </XFStack>;


    private string BasicCode => @T(
        "<XFOneTimeInput Label=\"Codigo de verificacao\" Digits=\"6\" Group=\"3,3\" />",
        "<XFOneTimeInput Label=\"Verification code\" Digits=\"6\" Group=\"3,3\" />");

    private string ConfigCode => @T(
        "<XFOneTimeInput Digits=\"4\" />\n<XFOneTimeInput Digits=\"6\" Group=\"2,2,2\" />\n<XFOneTimeInput Digits=\"4\" Mask=\"true\" />",
        "<XFOneTimeInput Digits=\"4\" />\n<XFOneTimeInput Digits=\"6\" Group=\"2,2,2\" />\n<XFOneTimeInput Digits=\"4\" Mask=\"true\" />");

    private string EnterpriseCode => @T(
        "<XFOneTimeInput Label=\"Codigo de verificacao\" Digits=\"6\" Group=\"3,3\"\n    OnComplete=\"OnCodeComplete\" />\n\n@code {\n    private void OnCodeComplete(string code)\n    {\n        // Handle completed OTP code\n    }\n}",
        "<XFOneTimeInput Label=\"Verification code\" Digits=\"6\" Group=\"3,3\"\n    OnComplete=\"OnCodeComplete\" />\n\n@code {\n    private void OnCodeComplete(string code)\n    {\n        // Handle completed OTP code\n    }\n}");


    private RenderFragment Section(string title, RenderFragment content) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
        <Header><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography></Header>
        <ChildContent>@content</ChildContent>
    </XFCard>;

    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");

    private RenderFragment Example(string title, string description, RenderFragment preview, string codeText) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.None" AreaRestricted="false">
        <Header>
            <div class="px-6 pt-6">
                <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@description</XFTypography>
            </div>
        </Header>
        <ChildContent>
            <div class="grid">
                <div class="border-t border-border-light p-6">@preview</div>
                <div class="border-t border-border-light bg-surface-50 p-6">
                    <XFCode Text="@codeText" Language="razor" Title="@CopyableCodeTitle" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" />
                </div>
            </div>
        </ChildContent>
    </XFCard>;

    private RenderFragment Tile(DocTile item) => @<XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
        <ChildContent>
            <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                <div class="flex items-center gap-4">
                    <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-primary/10 bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                    <div class="min-w-0">
                        <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography>
                    </div>
                </div>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
            </XFStack>
        </ChildContent>
    </XFCard>;

    private RenderFragment TileGrid(IReadOnlyList<DocTile> items, int columns) => @<XFGrid Cols="1" Md="@Math.Min(columns, 2)" Lg="@columns" Gap="4">
        @foreach (var item in items)
        {
            @Tile(item)
        }
    </XFGrid>;

    private RenderFragment WarningGrid(IReadOnlyList<DocTile> items) => @<XFGrid Cols="1" Md="2" Gap="4">
        @foreach (var item in items)
        {
            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
                <ChildContent>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                        <div class="flex items-center gap-4">
                            <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-danger/10 bg-danger/10 text-danger" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                            <div class="min-w-0">
                                <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography>
                            </div>
                        </div>
                        <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
                    </XFStack>
                </ChildContent>
            </XFCard>
        }
    </XFGrid>;

    private RenderFragment NameValueTable(IReadOnlyList<NameValueRow> rows, string nameHeader, string valueHeader) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader>
            <XFTableRow>
                <XFTableCell Header="true">@nameHeader</XFTableCell>
                <XFTableCell Header="true">@valueHeader</XFTableCell>
            </XFTableRow>
        </XFTableHeader>
        <XFTableBody>
            @foreach (var row in rows)
            {
                <XFTableRow>
                    <XFTableCell><XFCode Text="@row.Name" /></XFTableCell>
                    <XFTableCell>@row.Value</XFTableCell>
                </XFTableRow>
            }
        </XFTableBody>
    </XFTable>;

    private RenderFragment ApiTable(IReadOnlyList<ApiRow> rows) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader>
            <XFTableRow>
                <XFTableCell Header="true">@T("Parametro", "Parameter")</XFTableCell>
                <XFTableCell Header="true">Type</XFTableCell>
                <XFTableCell Header="true">Default</XFTableCell>
                <XFTableCell Header="true">@T("Descricao", "Description")</XFTableCell>
            </XFTableRow>
        </XFTableHeader>
        <XFTableBody>
            @foreach (var row in rows)
            {
                <XFTableRow>
                    <XFTableCell><XFCode Text="@row.Name" /></XFTableCell>
                    <XFTableCell>@row.Type</XFTableCell>
                    <XFTableCell><XFCode Text="@row.DefaultValue" /></XFTableCell>
                    <XFTableCell>@row.Description</XFTableCell>
                </XFTableRow>
            }
        </XFTableBody>
    </XFTable>;

    private sealed record DocTile(string Title, string Description, string Icon);
    private sealed record NameValueRow(string Name, string Value);
    private sealed record ApiRow(string Name, string Type, string DefaultValue, string Description);
}
