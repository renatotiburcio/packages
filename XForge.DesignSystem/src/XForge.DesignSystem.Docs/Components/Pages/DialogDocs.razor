@page "/feedback/dialog"
@using XForge.DesignSystem.Core.Primitives
@using XForge.DesignSystem.Components.Overlays.Dialog

@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFDialog" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("5 Tamanhos", "5 Sizes")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Enterprise", "Enterprise")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Dialog modal acessível para confirmacoes, edicao e Fluxos de decisao.", "Accessible modal dialog for confirmations, editing and decision flows.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("5 tamanhos, 3 placements, 4 tons semânticos, drag, resize, maximize, alert dialog, focus trap, service imperativo e WCAG AAA.",
                               "5 sizes, 3 placements, 4 semantic tones, drag, resize, maximize, alert dialog, focus trap, imperative service and WCAG AAA.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section(T("Blazor Server e Blazor WebAssembly", "Blazor Server and Blazor WebAssembly"), @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observações", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona com prerender-safe guards.", "Works with prerender-safe guards.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona com prerender-safe guards no primeiro render.", "Works with prerender-safe guards on first render.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Parcial", "Partial")" /></XFTableCell><XFTableCell>@T("Renderiza HTML base. Focus trap, drag, resize e maximize indisponiveis durante prerender.", "Renders base HTML. Focus trap, drag, resize and maximize unavailable during prerender.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("JS Interop", "JS Interop")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Arquivo JS: xf-dialog.js — gerencia xfDialog.trap/release para focus trap, drag handle, resize handle e maximize toggle.", "JS file: xf-dialog.js — manages xfDialog.trap/release for focus trap, drag handle, resize handle and maximize toggle.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Quando carrega: OnAfterRenderAsync.", "When loaded: OnAfterRenderAsync.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Prerender seguro: try/catch para InvalidOperationExCEPtion e JSDisconnectedExCEPtion.", "Prerender safe: try/catch for InvalidOperationExCEPtion and JSDisconnectedExCEPtion.")</XFTypography>
                </XFStack>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Consideracoes Blazor Server", "Blazor Server Considerations")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("JS interop via SignalR com latencia. Drag e resize podem ter resposta mais lenta.", "JS interop via SignalR with latency. Drag and resize may have slower response.")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Consideracoes Blazor WebAssembly", "Blazor WebAssembly Considerations")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("JS interop direto sem latencia de rede. Disponivel apos carregamento do WASM.", "Direct JS interop with no network latency. Available after WASM load.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando não usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Basico", "1. Basic"),
                T("Dialog simples com Título, Descrição e conteudo.", "Simple dialog with title, description and content."),
                ExBasic(), CodeBasic)

            @Example(T("2. Confirmacao", "2. Confirmation"),
                T("padrão de confirmacao com footer e botões de acao.", "Confirmation pattern with footer and action buttons."),
                ExConfirmation(), CodeConfirmation)

            @Example(T("3. Tamanhos", "3. Sizes"),
                T("Sm, Md, Lg, Xl e Full — todos com focus trap.", "Sm, Md, Lg, Xl and Full — all with focus trap."),
                ExSizes(), CodeSizes)

            @Example(T("4. Tons semânticos", "4. Semantic Tones"),
                T("Default, Primary, Success, Warning e Danger com borda e ring.", "Default, Primary, Success, Warning and Danger with border and ring."),
                ExTones(), CodeTones)

            @Example(T("5. Placements", "5. Placements"),
                T("Center, Right e Left — side panels e dialogs centrais.", "Center, Right and Left — side panels and centered dialogs."),
                ExPlacements(), CodePlacements)

            @Example(T("6. Header e Footer customizados", "6. Custom Header & Footer"),
                T("RenderFragment Header e Footer para layouts ricos.", "Header and Footer RenderFragments for rich layouts."),
                ExCustomHeaderFooter(), CodeCustomHeaderFooter)

            @Example(T("7. Comportamento de fechamento", "7. Close Béavior"),
                T("CloseOnEscape, CloseOnOverlayClick e ShowCloseButton.", "CloseOnEscape, CloseOnOverlayClick and ShowCloseButton."),
                ExCloseBéavior(), CodeCloseBéavior)

            @Example(T("8. Drag, Resize e Maximize", "8. Drag, Resize & Maximize"),
                T("Dialog arrastavel, redimensionavel e maximizavel.", "Draggable, resizable and maximizable dialog."),
                ExDragResizeMaximize(), CodeDragResizeMaximize)

            @Example(T("9. Alert Dialog", "9. Alert Dialog"),
                T("role alertdialog para acoes destrutivas e críticas.", "role alertdialog for destructive and crítical actions."),
                ExAlertDialog(), CodeAlertDialog)

            @Example(T("10. formulário dentro do dialog", "10. Form Inside Dialog"),
                T("EditForm com Validação dentro de um dialog.", "EditForm with validation inside a dialog."),
                ExFormDialog(), CodeFormDialog)

            @Example(T("11. Servico imperativo", "11. Imperative Service"),
                T("XFDialogService.ShowAsync e ConfirmAsync com await.", "XFDialogService.ShowAsync and ConfirmAsync with await."),
                ExService(), CodeService)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>

@code {
    private string ProductLabelText => T("Core Open Source", "Core Open Source");
    private string PageTitleText => T("Dialog", "Dialog");
    private string PageStatusText => T("Documentacao completa", "Complete docs");
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);
    private string CopyableCodeTitle => T("Código copiável", "Copyable code");

    private bool heroOpen;
    private bool basicOpen;
    private bool confirmOpen;
    private bool sizeSmOpen;
    private bool sizeMdOpen;
    private bool sizeLgOpen;
    private bool sizeXlOpen;
    private bool sizeFullOpen;
    private bool toneDefaultOpen;
    private bool tonePrimaryOpen;
    private bool toneSuccessOpen;
    private bool toneWarningOpen;
    private bool toneDangerOpen;
    private bool placementCenterOpen;
    private bool placementRightOpen;
    private bool placementLeftOpen;
    private bool customHeaderOpen;
    private bool customFooterOpen;
    private bool closeEscapeOpen;
    private bool closeOverlayOpen;
    private bool closeNoButtonOpen;
    private bool dragOpen;
    private bool resizeOpen;
    private bool maximizeOpen;
    private bool alertOpen;
    private bool formOpen;
    private bool serviceResultVisible;
    private string serviceResultText = "";

    // ─── Hero ───
    private RenderFragment HeroPreview() => @<div class="flex flex-col gap-3">
        <XFButton Text="@T("Abrir dialog de exemplo", "Open example dialog")" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Md" OnClick="() => heroOpen = true">
            <StartIcon>@XFSvgIcons.MarkupWithSize("window-maximize", 16)</StartIcon>
        </XFButton>
        <XFDialog @bind-Open="heroOpen"
                  Title="@T("Bem-vindo ao XForge", "Welcome to XForge")"
                  Description="@T("Este e um dialog de demonstracao do design system.", "This is a design system demo dialog.")"
                  Size="XFOverlaySize.Md"
                  Tone="XFSemanticColor.Primary">
            <ChildContent>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.Body1">
                    @T("O XFDialog e um overlay modal acessível com focus trap, navegação por teclado e suporte a drag, resize e maximize.",
                       "XFDialog is an accessible modal overlay with focus trap, keyboard navigation and drag, resize, maximize support.")
                </XFTypography>
                <div class="flex gap-2">
                    <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="aria-modal" />
                    <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="focus-trap" />
                    <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="Escape" />
                </div>
            </XFStack>
            </ChildContent>
            <Footer>
                <XFButton Text="@T("Fechar", "Close")" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Md" OnClick="() => heroOpen = false" />
            </Footer>
        </XFDialog>
    </div>;

    // ─── 1. Basic ───
    private RenderFragment ExBasic() => @<div class="flex flex-col gap-3">
        <XFButton Text="@T("Abrir dialog basico", "Open basic dialog")" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Md" OnClick="() => basicOpen = true" />
        <XFDialog @bind-Open="basicOpen"
                  Title="@T("Título do dialog", "Dialog title")"
                  Description="@T("Descrição opcional abaixo do Título.", "Optional description below the title.")">
            <XFTypography Variant="XFTypographyVariant.Body1">
                @T("Este e o conteudo principal do dialog. Use ChildContent para qualquer markup.", "This is the main dialog content. Use ChildContent for any markup.")
            </XFTypography>
        </XFDialog>
    </div>;

    // ─── 2. Confirmation ───
    private RenderFragment ExConfirmation() => @<div class="flex flex-col gap-3">
        <XFButton Text="@T("excluir registro", "Delete record")" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Danger" Size="XFExtendedSize.Md" OnClick="() => confirmOpen = true">
            <StartIcon>@XFSvgIcons.MarkupWithSize("trash", 16)</StartIcon>
        </XFButton>
        <XFDialog @bind-Open="confirmOpen"
                  Title="@T("Confirmar exclusão", "Confirm deletion")"
                  Description="@T("Esta acao não pode ser desfeita.", "This action cannot be undone.")"
                  Tone="XFSemanticColor.Danger"
                  Alert="true"
                  CloseOnOverlayClick="false">
            <ChildContent>
            <XFTypography Variant="XFTypographyVariant.Body1">
                @T("Tem certeza que deseja excluir o registro #4821? Todos os dados associados serao removidos permanentemente.",
                   "Are you sure you want to delete record #4821? All associated data will be permanently removed.")
            </XFTypography>
            </ChildContent>
            <Footer>
                <XFButton Text="@T("Cancelar", "Cancel")" Variant="XFButtonVariant.Outline" Color="XFButtonColor.Neutral" Size="XFExtendedSize.Md" OnClick="() => confirmOpen = false" />
                <XFButton Text="@T("excluir", "Delete")" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Danger" Size="XFExtendedSize.Md" OnClick="() => confirmOpen = false">
                    <StartIcon>@XFSvgIcons.MarkupWithSize("trash", 16)</StartIcon>
                </XFButton>
            </Footer>
        </XFDialog>
    </div>;

    // ─── 3. Sizes ───
    private RenderFragment ExSizes() => @<div class="flex flex-wrap gap-3">
        <XFButton Text="Sm" Variant="XFButtonVariant.Outline" Color="XFButtonColor.Primary" Size="XFExtendedSize.Md" OnClick="() => sizeSmOpen = true" />
        <XFButton Text="Md" Variant="XFButtonVariant.Outline" Color="XFButtonColor.Primary" Size="XFExtendedSize.Md" OnClick="() => sizeMdOpen = true" />
        <XFButton Text="Lg" Variant="XFButtonVariant.Outline" Color="XFButtonColor.Primary" Size="XFExtendedSize.Md" OnClick="() => sizeLgOpen = true" />
        <XFButton Text="Xl" Variant="XFButtonVariant.Outline" Color="XFButtonColor.Primary" Size="XFExtendedSize.Md" OnClick="() => sizeXlOpen = true" />
        <XFButton Text="Full" Variant="XFButtonVariant.Outline" Color="XFButtonColor.Primary" Size="XFExtendedSize.Md" OnClick="() => sizeFullOpen = true" />
        <XFDialog @bind-Open="sizeSmOpen" Title="Sm (max-w-sm)" Size="XFOverlaySize.Sm">
            <XFTypography Variant="XFTypographyVariant.Body1">@T("Tamanho Sm — ideal para confirmacoes rapidas.", "Sm size — ideal for quick confirmations.")</XFTypography>
        </XFDialog>
        <XFDialog @bind-Open="sizeMdOpen" Title="Md (max-w-xl)" Size="XFOverlaySize.Md">
            <XFTypography Variant="XFTypographyVariant.Body1">@T("Tamanho Md — padrão para a maioria dos dialogs.", "Md size — default for most dialogs.")</XFTypography>
        </XFDialog>
        <XFDialog @bind-Open="sizeLgOpen" Title="Lg (max-w-3xl)" Size="XFOverlaySize.Lg">
            <XFTypography Variant="XFTypographyVariant.Body1">@T("Tamanho Lg — para formulários e conteudo extenso.", "Lg size — for forms and extensive content.")</XFTypography>
        </XFDialog>
        <XFDialog @bind-Open="sizeXlOpen" Title="Xl (max-w-5xl)" Size="XFOverlaySize.Xl">
            <XFTypography Variant="XFTypographyVariant.Body1">@T("Tamanho Xl — para dashboards e tabelas largas.", "Xl size — for dashboards and wide tables.")</XFTypography>
        </XFDialog>
        <XFDialog @bind-Open="sizeFullOpen" Title="Full (max-w-6xl)" Size="XFOverlaySize.Full" Maximizable="true">
            <XFTypography Variant="XFTypographyVariant.Body1">@T("Tamanho Full — quase tela cheia, ideal para editor de dados.", "Full size — near full screen, ideal for data editors.")</XFTypography>
        </XFDialog>
    </div>;

    // ─── 4. Tones ───
    private RenderFragment ExTones() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
            <div class="flex flex-col gap-2">
                <div class="h-2 rounded-full bg-surface-300"></div>
                <XFTypography Variant="XFTypographyVariant.Caption" Weight="XFTypographyWeight.Semibold">Default</XFTypography>
                <XFButton Text="@T("Abrir", "Open")" Variant="XFButtonVariant.Outline" Color="XFButtonColor.Neutral" Size="XFExtendedSize.Sm" OnClick="() => toneDefaultOpen = true" />
            </div>
            <div class="flex flex-col gap-2">
                <div class="h-2 rounded-full bg-primary"></div>
                <XFTypography Variant="XFTypographyVariant.Caption" Weight="XFTypographyWeight.Semibold">Primary</XFTypography>
                <XFButton Text="@T("Abrir", "Open")" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Sm" OnClick="() => tonePrimaryOpen = true" />
            </div>
            <div class="flex flex-col gap-2">
                <div class="h-2 rounded-full bg-success"></div>
                <XFTypography Variant="XFTypographyVariant.Caption" Weight="XFTypographyWeight.Semibold">Success</XFTypography>
                <XFButton Text="@T("Abrir", "Open")" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Success" Size="XFExtendedSize.Sm" OnClick="() => toneSuccessOpen = true" />
            </div>
            <div class="flex flex-col gap-2">
                <div class="h-2 rounded-full bg-warning"></div>
                <XFTypography Variant="XFTypographyVariant.Caption" Weight="XFTypographyWeight.Semibold">Warning</XFTypography>
                <XFButton Text="@T("Abrir", "Open")" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Warning" Size="XFExtendedSize.Sm" OnClick="() => toneWarningOpen = true" />
            </div>
            <div class="flex flex-col gap-2">
                <div class="h-2 rounded-full bg-danger"></div>
                <XFTypography Variant="XFTypographyVariant.Caption" Weight="XFTypographyWeight.Semibold">Danger</XFTypography>
                <XFButton Text="@T("Abrir", "Open")" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Danger" Size="XFExtendedSize.Sm" OnClick="() => toneDangerOpen = true" />
            </div>
        </div>
        <XFDialog @bind-Open="toneDefaultOpen" Title="Default" Tone="XFSemanticColor.Default">
            <ChildContent><XFTypography Variant="XFTypographyVariant.Body1">@T("Tone Default — borda e ring padrão.", "Default tone — default border and ring.")</XFTypography></ChildContent>
        </XFDialog>
        <XFDialog @bind-Open="tonePrimaryOpen" Title="Primary" Tone="XFSemanticColor.Primary">
            <ChildContent><XFTypography Variant="XFTypographyVariant.Body1">@T("Tone Primary — destaque da marca.", "Primary tone — brand emphasis.")</XFTypography></ChildContent>
        </XFDialog>
        <XFDialog @bind-Open="toneSuccessOpen" Title="Success" Tone="XFSemanticColor.Success">
            <ChildContent><XFTypography Variant="XFTypographyVariant.Body1">@T("Tone Success — operação concluída com sucesso.", "Success tone — operation completed successfully.")</XFTypography></ChildContent>
        </XFDialog>
        <XFDialog @bind-Open="toneWarningOpen" Title="Warning" Tone="XFSemanticColor.Warning">
            <ChildContent><XFTypography Variant="XFTypographyVariant.Body1">@T("Tone Warning — atencao, revisar antes de prosseguir.", "Warning tone — caution, review before proceeding.")</XFTypography></ChildContent>
        </XFDialog>
        <XFDialog @bind-Open="toneDangerOpen" Title="Danger" Tone="XFSemanticColor.Danger">
            <ChildContent><XFTypography Variant="XFTypographyVariant.Body1">@T("Tone Danger — acao crítica ou destrutiva.", "Danger tone — crítical or destructive action.")</XFTypography></ChildContent>
        </XFDialog>
    </XFStack>;

    // ─── 5. Placements ───
    private bool placementTopOpen;
    private bool placementBottomOpen;

    private RenderFragment ExPlacements() => @<div class="flex flex-wrap gap-3">
        <XFButton Text="Center" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Md" OnClick="() => placementCenterOpen = true" />
        <XFButton Text="Right" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Md" OnClick="() => placementRightOpen = true" />
        <XFButton Text="Left" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Md" OnClick="() => placementLeftOpen = true" />
        <XFButton Text="Top" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Md" OnClick="() => placementTopOpen = true" />
        <XFButton Text="Bottom" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Md" OnClick="() => placementBottomOpen = true" />
