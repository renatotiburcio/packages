    // ─── 11. Service ───
    [Inject] private XFDialogService DialogService { get; set; } = default!;

    private async Task OpenServiceConfirmAsync()
    {
        var result = await DialogService.ConfirmAsync(
            title: T("Confirmar envio", "Confirm submission"),
            description: T("Enviar lote fiscal para SEFAZ?", "Submit fiscal batch to SEFAZ?"),
            confirmText: T("Enviar", "Submit"),
            cancelText: T("Cancelar", "Cancel"),
            tone: XFSemanticColor.Primary);

        serviceResultVisible = true;
        serviceResultText = result.Cancelled
            ? T("Envio Cancelado pelo usuario.", "Submission cancelled by user.")
            : T("Lote Enviado com sucesso!", "Batch submitted successfully!");
    }

    private async Task OpenServiceDangerAsync()
    {
        var result = await DialogService.ConfirmAsync(
            title: T("Bloquear Fornecedor", "Block supplier"),
            description: T("O Fornecedor sera Bloqueado em todos os modulos.", "The supplier will be blocked in all modules."),
            confirmText: T("Bloquear", "Block"),
            cancelText: T("Cancelar", "Cancel"),
            tone: XFSemanticColor.Danger);

        serviceResultVisible = true;
        serviceResultText = result.Cancelled
            ? T("Bloqueio Cancelado.", "Block cancelled.")
            : T("Fornecedor Bloqueado!", "Supplier blocked!");
    }

    private RenderFragment ExService() => @<div class="flex flex-col gap-3">
        <div class="flex flex-wrap gap-3">
            <XFButton Text="@T("ConfirmAsync (Primary)", "ConfirmAsync (Primary)")" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Md" OnClick="OpenServiceConfirmAsync" />
            <XFButton Text="@T("ConfirmAsync (Danger)", "ConfirmAsync (Danger)")" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Danger" Size="XFExtendedSize.Md" OnClick="OpenServiceDangerAsync" />
        </div>
        @if (serviceResultVisible)
        {
            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Sm">
                <ChildContent>
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" AlignItems="XFAlignItems.Center">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Info" Text="@T("Resultado", "Result")" />
                        <XFTypography Variant="XFTypographyVariant.Body2">@serviceResultText</XFTypography>
                    </XFStack>
                </ChildContent>
            </XFCard>
        }
    </div>;

