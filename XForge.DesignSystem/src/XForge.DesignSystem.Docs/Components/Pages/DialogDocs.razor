            </div>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
        </XFStack></ChildContent></XFCard>
    }</XFGrid>;
    private RenderFragment NameValueTable(IReadOnlyList<NameValueRow> rows, string naméeader, string valuéeader) => @<XFTable Striped="true" Hoverable="true" Compact="true">
