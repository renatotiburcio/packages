    // ==================== EXAMPLE 2: DARK THEME ====================
    private RenderFragment ExDarkShell() => @<div class="h-72 overflow-hidden rounded-lg border border-border-light">
        <XFAppShell Theme="dark" Brand="corp" MainClass="flex-1 overflow-auto p-4">
            <AppBar>
                <XFAppBar Bordered="true">
                    <ChildContent>
                        <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@T("Tema escuro", "Dark theme")</XFTypography>
                    </ChildContent>
                </XFAppBar>
            </AppBar>
            <ChildContent>
                <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
                    <ChildContent>
                        <XFTypography Variant="XFTypographyVariant.Body1">@T("Conteúdo com fundo escuro via data-theme.", "Content with dark background via data-theme.")</XFTypography>
                    </ChildContent>
                </XFCard>
            </ChildContent>
        </XFAppShell>
    </div>;

    private string CodeDarkShell => @"<XFAppShell Theme=""dark"" Brand=""corp"" MainClass=""flex-1 overflow-auto p-4"">
    <AppBar>
