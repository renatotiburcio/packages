            <Rail>
                <XFRail Items="@CompleteShellRailItems" />
            </Rail>
            <Sidebar>
                <XFSidebar>
                    <ChildContent>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                            <XFTypography Variant="XFTypographyVariant.Body2" Weight="XFTypographyWeight.Bold">@T("Financeiro", "Finance")</XFTypography>
                            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Contas a receber", "Accounts Receivable")</XFTypography>
                            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Contas a pagar", "Accounts Payable")</XFTypography>
                        </XFStack>
                    </ChildContent>
                </XFSidebar>
            </Sidebar>
            <AppBar>
                <XFAppBar>
                    <ChildContent>
                        <XFStack Orientation="XFOrientation.Horizontal" AlignItems="XFAlignItems.Center" JustifyContent="XFJustifyContent.SpaceBetween" FullWidth="true">
                            <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@T("Contas a receber", "Accounts Receivable")</XFTypography>
                            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="Produção" />
                        </XFStack>
                    </ChildContent>
