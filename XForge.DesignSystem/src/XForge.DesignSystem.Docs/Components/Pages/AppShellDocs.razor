    // ==================== HERO ====================
    private RenderFragment HeroPreview() => @<div class="h-72 overflow-hidden rounded-lg border border-border-light">
        <XFAppShell Brand="preview" MainClass="flex-1 overflow-auto bg-surface-50 p-4">
            <Rail>
                <XFRail Items="@HeroRailItems" />
            </Rail>
            <Sidebar>
                <XFSidebar>
                    <ChildContent>
                        <XFTypography Variant="XFTypographyVariant.Body2" Weight="XFTypographyWeight.Bold">@T("Financeiro", "Finance")</XFTypography>
                    </ChildContent>
                </XFSidebar>
            </Sidebar>
            <AppBar>
                <XFAppBar>
                    <ChildContent>
                        <XFStack Orientation="XFOrientation.Horizontal" AlignItems="XFAlignItems.Center" JustifyContent="XFJustifyContent.SpaceBetween" FullWidth="true">
                            <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@T("Operações", "Operations")</XFTypography>
                            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="Produção" />
                        </XFStack>
                    </ChildContent>
                </XFAppBar>
            </AppBar>
            <ChildContent>
                <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
                    <ChildContent>
                        <XFTypography Variant="XFTypographyVariant.Body1">@T("Conteúdo principal", "Main content")</XFTypography>
                    </ChildContent>
                </XFCard>
            </ChildContent>
        </XFAppShell>
    </div>;

    // ==================== EXAMPLE 1: COMPLETE SHELL ====================
    private RenderFragment ExCompleteShell() => @<div class="h-72 overflow-hidden rounded-lg border border-border-light">
