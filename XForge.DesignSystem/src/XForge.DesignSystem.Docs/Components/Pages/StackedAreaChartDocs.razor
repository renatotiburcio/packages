@page "/components/stacked-area-chart"
@using XForge.Components.Charts
@using XForge.DesignSystem.Components.Layout
@using XForge.DesignSystem.Components.Typography
@using XForge.DesignSystem.Components.DataDisplay.Card
@using XForge.DesignSystem.Components.DataDisplay.Badge
@using XForge.DesignSystem.Components.Shared
@using XForge.DesignSystem.Docs.Shared.Contracts
@using XForge.DesignSystem.Docs.Shared.Navigation
@using XForge.DesignSystem.Docs.Shared.Components
@using XForge.DesignSystem.Core.Primitives

@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">

        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFStackedAreaChart" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Multi-series", "Multi-series")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Cumulativo", "Cumulative")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Areas empilhadas com camadas cumulativas para visualizacao de volume ao longo do tempo.",
                               "Stacked areas with cumulative layers for volume visualization over time.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("XFStackedAreaChart exibe areas coloridas empilhadas onde a altura total representa a soma cumulativa de todas as series. Ideal para visualizar a evolucao de composicao de volume ao longo do tempo.",
                               "XFStackedAreaChart displays colored stacked areas where the total height represents the cumulative sum of all series. Ideal for visualizing volume composition evolution over time.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        <!-- ===== METADATA ===== -->
        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        <!-- ===== OVERVIEW / PURPOSE / WHEN TO USE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
        </XFStack>

        <!-- ===== DESIGN ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Basico", "1. Basic"),
                T("Areas empilhadas com dados de volume mensal.", "Stacked areas with monthly volume data."),
                ExBasic(), CodeBasic)

            @Example(T("2. Com grid e legenda", "2. With grid and legend"),
                T("Areas com grid de referencia e legenda visivel.", "Areas with reference grid and visible legend."),
                ExGridLegend(), CodeGridLegend)

            @Example(T("3. Com limite Y", "3. With Y max"),
                T("Areas com limite maximo do eixo Y definido.", "Areas with defined maximum Y axis value."),
                ExYMax(), CodeYMax)
        </XFStack>

        <!-- ===== API ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API: XFStackedAreaChart", @<div>@ApiTable(ApiRows)</div>)
            @Section("API: XFStackedAreaChartSeries", @<div>@ApiTable(SeriesApiRows)</div>)
        </XFStack>

        <!-- ===== ACCESSIBILITY ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 3)</div>)
        </XFStack>

        <!-- ===== FAQ / CHANGELOG ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>

    </XFStack>
</XForgeDocsShell>

@code {
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");
    private string ProductLabelText => "XFStackedAreaChart";
    private string PageTitleText => "Stacked Area Chart";
    private string PageStatusText => T("Stable", "Stable");

    // ==================== HERO ====================
    private RenderFragment HeroPreview() => @<div class="flex items-center justify-center rounded-lg border border-border-light bg-surface-50 p-8">
        <XFStack Orientation="XFOrientation.Vertical" Gap="4" Alignment="XFAlignment.Center">
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@T("Preview de Stacked Area Chart", "Stacked Area Chart preview")</XFTypography>
        </XFStack>
    </div>;

    // ==================== QUICK FACTS ====================
    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("Camadas cumulativas", "Cumulative layers"), T("Areas empilhadas representando soma cumulativa.", "Stacked areas representing cumulative sum."), "layer-group"),
        new(T("Volume temporal", "Temporal volume"), T("Visualizacao de evolucao de composicao ao longo do tempo.", "Visualization of composition evolution over time."), "chart-line"),
        new(T("Tooltips", "Tooltips"), T("Detalhes de cada camada ao passar o mouse.", "Details of each layer on hover."), "comment"),
        new(T("Legenda interativa", "Interactive legend"), T("Ocultar/mostrar series via clique na legenda.", "Hide/show series via legend click."), "layer-group")
    ];

    // ==================== METADATA ====================
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFStackedAreaChart"),
        new("Namespace", "XForge.Components.Charts"),
        new("Package", "XForge.DesignSystem"),
        new("Category", "Components / Charts"),
        new("Status", T("Estavel", "Stable")),
        new("Accessibility", T("role=img, aria-label, sr-only data table.", "role=img, aria-label, sr-only data table.")),
        new("Theme support", T("Light e dark via CSS variables.", "Light and dark via CSS variables."))
    ];

    // ==================== OVERVIEW ====================
    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("Areas empilhadas", "Stacked areas"), T("Areas coloridas com camadas cumulativas sobre o eixo X.", "Colored areas with cumulative layers over the X axis."), "chart-area"),
        new(T("Suavizacao", "Smoothing"), T("Curvas suaves entre pontos para visualizacao fluida.", "Smooth curves between points for fluid visualization."), "wave-square"),
        new(T("Interatividade", "Interactivity"), T("Tooltips, zoom e legenda interativa.", "Tooltips, zoom and interactive legend."), "hand-pointer")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Volume temporal", "Temporal volume"), T("Evolucao de composicao de metricas ao longo do tempo.", "Evolution of metric composition over time."), "chart-line"),
        new(T("Composicao", "Composition"), T("Contribuicao relativa de cada serie para o total.", "Relative contribution of each series to the total."), "layer-group"),
        new(T("Tendencias", "Trends"), T("Visualizar tendencias de crescimento ou declinio por serie.", "Visualize growth or decline trends per series."), "arrow-trend-up")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Linhas individuais dificultavam visualizar totais.", "Individual lines made it hard to see totals."), "xmark"),
        new(T("Depois", "After"), T("Areas empilhadas mostram totais e composicao.", "Stacked areas show totals and composition."), "check"),
        new(T("Volume", "Volume"), T("Preenchimento visual enfatiza magnitude do volume.", "Visual fill emphasizes volume magnitude."), "chart-area")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Metricas de negocio", "Business metrics"), T("Receita, custos e margem ao longo do tempo.", "Revenue, costs and margin over time."), "dollar-sign"),
        new(T("Composicao de mercado", "Market composition"), T("Participacao de mercado por concorrente ao longo do tempo.", "Market share by competitor over time."), "chart-pie")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Muitas series", "Too many series"), T("Mais de 5 areas empilhadas dificultam a leitura.", "More than 5 stacked areas make reading difficult."), "xmark"),
        new(T("Dados discretos", "Discrete data"), T("Para dados nao temporais, use XFStackedBarChart.", "For non-temporal data, use XFStackedBarChart."), "triangle-exclamation")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new("Eixo X", T("Eixo temporal ou categorico horizontal.", "Temporal or categorical horizontal axis."), "code"),
        new("Eixo Y", T("Valores numericos cumulativos.", "Cumulative numerical values."), "code"),
        new("Areas coloridas", T("Camadas preenchidas com opacidade para cada serie.", "Filled layers with opacity for each series."), "layer-group"),
        new("Legenda", T("Indicadores de cor por serie.", "Color indicators per series."), "tag"),
        new("Tooltip", T("Popup com detalhes por camada ao hover.", "Popup with layer details on hover."), "comment")
    ];

    // ==================== DESIGN ====================
    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(T("Volume visual", "Visual volume"), T("Preenchimento enfatiza magnitude acumulada.", "Fill emphasizes accumulated magnitude."), "chart-area"),
        new(T("Cores com opacidade", "Colors with opacity"), T("Opacidade reduzida para visibilidade das camadas sobrepostas.", "Reduced opacity for visibility of overlapping layers."), "palette"),
        new(T("Suavidade", "Smoothness"), T("Curvas bezier para transicoes naturais entre pontos.", "Bezier curves for natural transitions between points."), "wave-square")
    ];

    // ==================== EXAMPLES ====================
    private RenderFragment ExBasic() => @<div class="flex flex-col gap-4">
        <XFStack Orientation="XFOrientation.Vertical" Gap="2">
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Areas empilhadas basicas", "Basic stacked areas")</XFTypography>
        </XFStack>
    </div>;

    private string CodeBasic => @"<XFStackedAreaChart Data=""@data"" Series=""@series"" />

@code {
    private string[] data = [""Jan"", ""Fev"", ""Mar"", ""Abr"", ""Mai"", ""Jun""];
    private XFStackedAreaChartSeries[] series = [
        new() { Name = ""Receita"", Data = [120, 132, 101, 134, 90, 230] },
        new() { Name = ""Custo"", Data = [220, 182, 191, 234, 290, 330] },
        new() { Name = ""Lucro"", Data = [150, 232, 201, 154, 190, 330] }
    ];
}";

    private RenderFragment ExGridLegend() => @<div class="flex flex-col gap-4">
        <XFStack Orientation="XFOrientation.Vertical" Gap="2">
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Com grid e legenda visiveis", "With visible grid and legend")</XFTypography>
        </XFStack>
    </div>;

    private string CodeGridLegend => @"<XFStackedAreaChart Data=""@data""
                   Series=""@series""
                   ShowGrid=""true""
                   ShowLegend=""true"" />";

    private RenderFragment ExYMax() => @<div class="flex flex-col gap-4">
        <XFStack Orientation="XFOrientation.Vertical" Gap="2">
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Com limite Y definido", "With defined Y max")</XFTypography>
        </XFStack>
    </div>;

    private string CodeYMax => @"<XFStackedAreaChart Data=""@data""
                   Series=""@series""
                   ShowGrid=""true""
                   ShowLegend=""true""
                   YMax=""1000"" />";

    // ==================== API ====================
    private IReadOnlyList<ApiRow> ApiRows => [
        new("Data", "IReadOnlyList<string>", "[]", T("Labels do eixo X (datas ou categorias).", "X axis labels (dates or categories).")),
        new("Series", "IReadOnlyList<XFStackedAreaChartSeries>", "[]", T("Series de dados para empilhar.", "Data series to stack.")),
        new("ShowGrid", "bool", "true", T("Exibir linhas de referencia no eixo Y.", "Show reference lines on Y axis.")),
        new("ShowLegend", "bool", "true", T("Exibir legenda interativa.", "Show interactive legend.")),
        new("YMax", "double?", "null", T("Valor maximo do eixo Y. Auto-calculado se null.", "Maximum Y axis value. Auto-calculated if null.")),
        new("AriaLabel", "string?", "null", T("Label acessivel para screen readers.", "Accessible label for screen readers."))
    ];

    private IReadOnlyList<ApiRow> SeriesApiRows => [
        new("Name", "string", "-", T("Nome da serie na legenda.", "Series name in legend.")),
        new("Data", "IReadOnlyList<double>", "[]", T("Valores da serie.", "Series values.")),
        new("Color", "string?", "null", T("Cor customizada (hex). Auto-selecionada se null.", "Custom color (hex). Auto-selected if null."))
    ];

    // ==================== ACCESSIBILITY ====================
    private IReadOnlyList<DocTile> AccessibilityItems => [
        new("role=img", T("Container com role=img para screen readers.", "Container with role=img for screen readers."), "universal-access"),
        new("aria-label", T("Descricao do grafico para leitores de tela.", "Chart description for screen readers."), "tag"),
        new("sr-only table", T("Tabela acessivel com dados por serie e data.", "Accessible table with data per series and date."), "table"),
        new("Tooltips", T("Tooltips com detalhes de cada camada.", "Tooltips with details of each layer."), "comment"),
        new("Legend interativa", T("Legenda clicavel para ocultar/mostrar series.", "Clickable legend to hide/show series."), "layer-group")
    ];

    // ==================== FAQ ====================
    private IReadOnlyList<NameValueRow> FaqRows => [
        new(T("Qual a diferenca para XFStackedBarChart?", "What is the difference from XFStackedBarChart?"), T("Area Chart usa areas preenchidas e e ideal para dados temporais continuos. Bar Chart usa barras para dados categoricos.", "Area Chart uses filled areas and is ideal for continuous temporal data. Bar Chart uses bars for categorical data.")),
        new(T("Posso usar com datas?", "Can I use with dates?"), T("Sim, passe as datas como strings no array Data.", "Yes, pass dates as strings in the Data array.")),
        new(T("As areas tem opacidade?", "Do areas have opacity?"), T("Sim, a opacidade padrao e 0.6 para visibilidade das camadas sobrepostas.", "Yes, default opacity is 0.6 for visibility of overlapping layers."))
    ];

    // ==================== CHANGELOG ====================
    private IReadOnlyList<NameValueRow> ChangelogRows => [
        new("2026-06-30", T("Documentacao inicial do XFStackedAreaChart.", "Initial XFStackedAreaChart documentation."))
    ];

    // ==================== HELPERS ====================
    private RenderFragment Section(string title, RenderFragment content) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg"><Header><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography></Header><ChildContent>@content</ChildContent></XFCard>;

    private RenderFragment Example(string title, string description, RenderFragment preview, string codeText) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.None" AreaRestricted="false"><Header><div class="px-6 pt-6 pb-2"><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@description</XFTypography></div></Header><ChildContent><div class="flex flex-col"><div class="border-t border-border-light bg-surface-50/30 p-6">@preview</div><div class="border-t border-border-light bg-surface-50 p-6"><XFCode Text="@codeText" Language="razor" Title="@CopyableCodeTitle" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" /></div></div></ChildContent></XFCard>;

    private RenderFragment Tile(DocTile item) => @<XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true"><div class="flex items-center gap-4"><span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-primary/10 bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span><div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div></div><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography></XFStack></ChildContent></XFCard>;

    private RenderFragment TileGrid(IReadOnlyList<DocTile> items, int cols) => @<XFGrid Cols="1" Md="@Math.Min(cols, 2)" Lg="@cols" Gap="4">@foreach (var item in items) { @Tile(item) }</XFGrid>;

    private RenderFragment WarningGrid(IReadOnlyList<DocTile> items) => @<XFGrid Cols="1" Md="2" Gap="4">@foreach (var item in items) {
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true"><div class="flex items-center gap-4"><span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-danger/10 bg-danger/10 text-danger" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span><div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div></div><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography></XFStack></ChildContent></XFCard>
    }</XFGrid>;

    private RenderFragment NameValueTable(IReadOnlyList<NameValueRow> rows, string h1, string h2) => @<XFTable Striped="true" Hoverable="true" Compact="true"><XFTableHeader><XFTableRow><XFTableCell Header="true">@h1</XFTableCell><XFTableCell Header="true">@h2</XFTableCell></XFTableRow></XFTableHeader><XFTableBody>@foreach (var r in rows) { <XFTableRow><XFTableCell><XFCode Text="@r.Name" /></XFTableCell><XFTableCell>@r.Value</XFTableCell></XFTableRow> }</XFTableBody></XFTable>;

    private RenderFragment ApiTable(IReadOnlyList<ApiRow> rows) => @<XFTable Striped="true" Hoverable="true" Compact="true"><XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Parametro", "Parameter")</XFTableCell><XFTableCell Header="true">Type</XFTableCell><XFTableCell Header="true">Default</XFTableCell><XFTableCell Header="true">@T("Descricao", "Description")</XFTableCell></XFTableRow></XFTableHeader><XFTableBody>@foreach (var r in rows) { <XFTableRow><XFTableCell><XFCode Text="@r.Name" /></XFTableCell><XFTableCell>@r.Type</XFTableCell><XFTableCell><XFCode Text="@r.DefaultValue" /></XFTableCell><XFTableCell>@r.Description</XFTableCell></XFTableRow> }</XFTableBody></XFTable>;

    private sealed record DocTile(string Title, string Description, string Icon);
    private sealed record NameValueRow(string Name, string Value);
    private sealed record ApiRow(string Name, string Type, string DefaultValue, string Description);
}
