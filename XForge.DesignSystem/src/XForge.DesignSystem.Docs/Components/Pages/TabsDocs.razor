@page "/components/tabs"
@page "/navigation/tabs"
@using XForge.DesignSystem.Core.Primitives
@using XForge.DesignSystem.Components.Navigation.Tabs

@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">

        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFTabs" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("WAI-ARIA", "WAI-ARIA")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Rotas", "Routing")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Enterprise", "Enterprise")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Navegação por abas acessível e flexível.", "Accessible and flexible tab navigation.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("5 variantes visuais, 3 tamanhos, 4 orientações, lazy load, fechamento de abas, roteamento, modo manual/automático, teclado completo e ARIA.",
                               "5 visual variants, 3 sizes, 4 orientations, lazy load, tab closable, routing, manual/automatic mode, full keyboard and ARIA.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observações", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estático. Interações requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderizacao.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Consideracoes", "Considerations")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor Server: eventos sao tratados via SignalR. Sem latencia adicional para componentes puramente renderizados.", "Blazor Server: events are handled via SignalR. No additional latency for purely rendered components.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor WebAssembly: eventos sao tratados diretamente no cliente. Mais responsivo.", "Blazor WebAssembly: events are handled directly on the client. More responsive.")</XFTypography>
                </XFStack>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Propósito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Basico", "1. Basic"),
                T("Abas horizontais com dados de pedido ERP.", "Horizontal tabs with ERP order data."),
                ExBasic(), CodeBasic)

            @Example(T("2. Tamanhos", "2. Sizes"),
                T("Sm, Md e Lg — declaracoes explicitas por tamanho.", "Sm, Md and Lg — explicit per-size declarations."),
                ExSizes(), CodeSizes)

            @Example(T("3. Variantes", "3. Variants"),
                T("Underline, Pills, Enclosed e Subtle.", "Underline, Pills, Enclosed and Subtle."),
                ExVariants(), CodeVariants)

            @Example(T("4. Orientações", "4. Orientations"),
                T("Horizontal, Vertical esquerda, Vertical direita e Inferior.", "Horizontal, Vertical left, Vertical right and Bottom."),
                ExOrientations(), CodeOrientations)

            @Example(T("5. Variantes de container", "5. Container variants"),
                T("Abas dentro de cards outlined, filled, surface e dark.", "Tabs inside outlined, filled, surface and dark cards."),
                ExContainerVariants(), CodeContainerVariants)

            @Example(T("6. Densidade", "6. Density"),
                T("FullWidth (toolbar) vs. compacto.", "FullWidth (toolbar) vs. compact."),
                ExDensity(), CodeDensity)


            @Example(T("6b. Cor de fundo da barra", "6b. Tab bar background"),
                T("Personalize o fundo da barra de abas com TabBarClass.", "Customize the tab bar background with TabBarClass."),
                ExTabBarBackground(), CodeTabBarBackground)

            @Example(T("7. Comportamento", "7. Behavior"),
                T("Fechavel, desabilitado e modo manual.", "Closable, disabled and manual activation."),
                ExBehavior(), CodeBehavior)

            @Example(T("8. Templates", "8. Templates"),
                T("StartIcon, EndContent com badge e ChildContent custom.", "StartIcon, EndContent with badge and custom ChildContent."),
                ExTemplates(), CodeTemplates)

            @Example(T("9. Feature toggles", "9. Feature toggles"),
                T("ShowIndicator, AllowClose, LazyLoad e LazyReload.", "ShowIndicator, AllowClose, LazyLoad and LazyReload."),
                ExFeatureToggles(), CodeFeatureToggles)

            @Example(T("10. Responsivo", "10. Responsive"),
                T("Abas com overflow horizontal e FullWidth adaptativo.", "Tabs with horizontal overflow and adaptive FullWidth."),
                ExResponsive(), CodeResponsive)

            @Example(T("11. Cenario enterprise", "11. Enterprise scenario"),
                T("Detalhe completo de pedido ERP com 5 abas, ícones e badges.", "Full ERP order detail with 5 tabs, icons and badges."),
                ExEnterprise(), CodeEnterprise)

            @Example(T("12. Roteamento", "12. Routing"),
                T("Abas com Href e Prefix/Exact route match.", "Tabs with Href and Prefix/Exact route match."),
                ExRouting(), CodeRouting)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API — XFTabs", @<div>@ApiTable(ApiRowsXFTabs)</div>)
            @Section("API — XFTab", @<div>@ApiTable(ApiRowsXFTab)</div>)
            @Section("API — XFTabPanel", @<div>@ApiTable(ApiRowsXFTabPanel)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>

@code {
    private string ProductLabelText => T("Core Open Source", "Core Open Source");
    private string PageTitleText => T("Tabs", "Tabs");
    private string PageStatusText => T("Documentacao completa", "Complete docs");
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");

    private RenderFragment HeroPreview() => @<div class="flex flex-col gap-4">
        <XFTabs Size="XFSize.Md" Variant="XFTabsVariant.Underline" AriaLabel="@T("Pedido ERP", "ERP order")">
            <Tabs>
                <XFTab TabId="overview" Label="@T("Visao Geral", "Overview")">
                    <StartIcon>@((MarkupString)XFSvgIcons.MarkupWithSize("eye", 14))</StartIcon>
                </XFTab>
                <XFTab TabId="items" Label="@T("Itens", "Items")">
                    <StartIcon>@((MarkupString)XFSvgIcons.MarkupWithSize("list", 14))</StartIcon>
                    <EndContent><XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="12" /></EndContent>
                </XFTab>
                <XFTab TabId="finance" Label="@T("Financeiro", "Finance")">
                    <StartIcon>@((MarkupString)XFSvgIcons.MarkupWithSize("credit-card", 14))</StartIcon>
                </XFTab>
            </Tabs>
            <Panels>
                <XFTabPanel TabId="overview">
                    <div class="p-4">
                        <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">
                            @T("Pedido #8421 — TechCorp Solucoes LTDA. Valor total: R$ 42.800,00. Prazo: 28/05/2026.", "Order #8421 — TechCorp Solutions Ltd. Total: R$ 42,800.00. Due: 05/28/2026.")
                        </XFTypography>
                    </div>
                </XFTabPanel>
                <XFTabPanel TabId="items">
                    <div class="p-4">
                        <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">
                            @T("12 itens — 3 categorias. SKU principal: HW-4521 Notebook Pro.", "12 items — 3 categories. Main SKU: HW-4521 Notebook Pro.")
                        </XFTypography>
                    </div>
                </XFTabPanel>
                <XFTabPanel TabId="finance">
                    <div class="p-4">
                        <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">
                            @T("Boleto vencido. Juros: R$ 428,00. Multa: R$ 214,00.", "Overdue invoice. Interest: R$ 428.00. Late fee: R$ 214.00.")
                        </XFTypography>
                    </div>
                </XFTabPanel>
            </Panels>
        </XFTabs>
    </div>;

    // ─── 1. Basic ───
    private RenderFragment ExBasic() => @<div class="flex flex-col gap-4">
        <XFTabs Size="XFSize.Md" Variant="XFTabsVariant.Underline" AriaLabel="@T("Basico", "Basic")">
            <Tabs>
                <XFTab TabId="ov1" Label="@T("Visao Geral", "Overview")" />
                <XFTab TabId="it1" Label="@T("Itens do Pedido", "Order Items")" />
                <XFTab TabId="fi1" Label="@T("Financeiro", "Finance")" />
            </Tabs>
            <Panels>
                <XFTabPanel TabId="ov1">
                    <div class="p-4">
                        <XFTypography Variant="XFTypographyVariant.Body2">@T("Pedido #8421 — TechCorp Solucoes LTDA. Emitido em 15/05/2026, entrega prevista para 28/05/2026.", "Order #8421 — TechCorp Solutions Ltd. Issued on 05/15/2026, delivery expected 05/28/2026.")</XFTypography>
                    </div>
                </XFTabPanel>
                <XFTabPanel TabId="it1">
                    <div class="p-4">
                        <XFTypography Variant="XFTypographyVariant.Body2">@T("HW-4521 Notebook Pro x5 | SW-110 Licenca Office x10 | SRV-300 Suporte 24x7 x1", "HW-4521 Notebook Pro x5 | SW-110 Office License x10 | SRV-300 24x7 Support x1")</XFTypography>
                    </div>
                </XFTabPanel>
                <XFTabPanel TabId="fi1">
                    <div class="p-4">
                        <XFTypography Variant="XFTypographyVariant.Body2">@T("Total: R$ 42.800,00. Condicao: 30/60/90 dias. Boleto bancario.", "Total: R$ 42,800.00. Terms: 30/60/90 days. Bank slip.")</XFTypography>
                    </div>
                </XFTabPanel>
            </Panels>
        </XFTabs>
    </div>;

    // ─── 2. Sizes ───
    private RenderFragment ExSizes() => @<div class="flex flex-col gap-5">
        <div class="flex flex-col gap-2">
            <div class="flex items-center gap-2">
                <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="Sm" />
                <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Compacto — tabelas densas.", "Compact — dense tables.")</XFTypography>
            </div>
            <XFTabs Size="XFSize.Sm" Variant="XFTabsVariant.Underline" AriaLabel="Sm tabs">
                <Tabs>
                    <XFTab TabId="sm1" Label="@T("Pedidos", "Orders")" />
                    <XFTab TabId="sm2" Label="@T("Clientes", "Customers")" />
                    <XFTab TabId="sm3" Label="@T("Produtos", "Products")" />
                </Tabs>
                <Panels>
                    <XFTabPanel TabId="sm1"><div class="p-3"><XFTypography Variant="XFTypographyVariant.Body2">@T("248 pedidos no mes.", "248 orders this month.")</XFTypography></div></XFTabPanel>
                    <XFTabPanel TabId="sm2"><div class="p-3"><XFTypography Variant="XFTypographyVariant.Body2">@T("1.342 clientes ativos.", "1,342 active customers.")</XFTypography></div></XFTabPanel>
                    <XFTabPanel TabId="sm3"><div class="p-3"><XFTypography Variant="XFTypographyVariant.Body2">@T("5.670 SKUs cadastrados.", "5,670 registered SKUs.")</XFTypography></div></XFTabPanel>
                </Panels>
            </XFTabs>
        </div>
        <div class="flex flex-col gap-2">
            <div class="flex items-center gap-2">
                <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="Md" />
                <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Padrão — maioria dos cenários.", "Default — most scenários.")</XFTypography>
            </div>
            <XFTabs Size="XFSize.Md" Variant="XFTabsVariant.Underline" AriaLabel="Md tabs">
                <Tabs>
                    <XFTab TabId="md1" Label="@T("Pedidos", "Orders")" />
                    <XFTab TabId="md2" Label="@T("Clientes", "Customers")" />
                    <XFTab TabId="md3" Label="@T("Produtos", "Products")" />
                </Tabs>
                <Panels>
                    <XFTabPanel TabId="md1"><div class="p-4"><XFTypography Variant="XFTypographyVariant.Body2">@T("248 pedidos no mes.", "248 orders this month.")</XFTypography></div></XFTabPanel>
                    <XFTabPanel TabId="md2"><div class="p-4"><XFTypography Variant="XFTypographyVariant.Body2">@T("1.342 clientes ativos.", "1,342 active customers.")</XFTypography></div></XFTabPanel>
                    <XFTabPanel TabId="md3"><div class="p-4"><XFTypography Variant="XFTypographyVariant.Body2">@T("5.670 SKUs cadastrados.", "5,670 registered SKUs.")</XFTypography></div></XFTabPanel>
                </Panels>
            </XFTabs>
        </div>
        <div class="flex flex-col gap-2">
            <div class="flex items-center gap-2">
                <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="Lg" />
                <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Touch-first — tablets e kiosks.", "Touch-first — tablets and kiosks.")</XFTypography>
            </div>
            <XFTabs Size="XFSize.Lg" Variant="XFTabsVariant.Underline" AriaLabel="Lg tabs">
                <Tabs>
                    <XFTab TabId="lg1" Label="@T("Pedidos", "Orders")" />
                    <XFTab TabId="lg2" Label="@T("Clientes", "Customers")" />
                    <XFTab TabId="lg3" Label="@T("Produtos", "Products")" />
                </Tabs>
                <Panels>
                    <XFTabPanel TabId="lg1"><div class="p-4"><XFTypography Variant="XFTypographyVariant.Body2">@T("248 pedidos no mes.", "248 orders this month.")</XFTypography></div></XFTabPanel>
                    <XFTabPanel TabId="lg2"><div class="p-4"><XFTypography Variant="XFTypographyVariant.Body2">@T("1.342 clientes ativos.", "1,342 active customers.")</XFTypography></div></XFTabPanel>
                    <XFTabPanel TabId="lg3"><div class="p-4"><XFTypography Variant="XFTypographyVariant.Body2">@T("5.670 SKUs cadastrados.", "5,670 registered SKUs.")</XFTypography></div></XFTabPanel>
                </Panels>
            </XFTabs>
        </div>
    </div>;

    // ─── 3. Variants ───
    private RenderFragment ExVariants() => @<div class="flex flex-col gap-5">
        @foreach (var variant in Enum.GetValues<XFTabsVariant>())
        {
            <div class="flex flex-col gap-2">
                <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@variant.ToString()" />
                <XFTabs Size="XFSize.Md" Variant="@variant" AriaLabel="@($"{variant} tabs")">
                    <Tabs>
                        <XFTab TabId="@($"v{variant}a")" Label="@T("Resumo", "Summary")" />
                        <XFTab TabId="@($"v{variant}b")" Label="@T("Detalhes", "Details")" />
                        <XFTab TabId="@($"v{variant}c")" Label="@T("Auditoria", "Audit")" />
                    </Tabs>
                    <Panels>
                        <XFTabPanel TabId="@($"v{variant}a")"><div class="p-4"><XFTypography Variant="XFTypographyVariant.Body2">@T("Resumo do pedido.", "Order summary.")</XFTypography></div></XFTabPanel>
                        <XFTabPanel TabId="@($"v{variant}b")"><div class="p-4"><XFTypography Variant="XFTypographyVariant.Body2">@T("Detalhes dos itens.", "Item details.")</XFTypography></div></XFTabPanel>
                        <XFTabPanel TabId="@($"v{variant}c")"><div class="p-4"><XFTypography Variant="XFTypographyVariant.Body2">@T("Historico de alteracoes.", "Change history.")</XFTypography></div></XFTabPanel>
                    </Panels>
                </XFTabs>
            </div>
        }
    </div>;

    // ─── 4. Orientations ───
    private RenderFragment ExOrientations() => @<div class="flex flex-col gap-6">
        <div class="flex flex-col gap-2">
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Primary" Text="@T("Horizontal (padrao)", "Horizontal (default)")" />
            <XFTabs Size="XFSize.Md" Variant="XFTabsVariant.Underline" Orientation="XFTabsOrientation.Horizontal" AriaLabel="Horizontal tabs">
                <Tabs>
                    <XFTab TabId="oh1" Label="@T("NFe", "NF-e")" />
                    <XFTab TabId="oh2" Label="@T("NFCe", "NFC-e")" />
                    <XFTab TabId="oh3" Label="@T("CTe", "CT-e")" />
                </Tabs>
                <Panels>
                    <XFTabPanel TabId="oh1"><div class="p-4"><XFTypography Variant="XFTypographyVariant.Body2">@T("Notas fiscais eletronicas de saida.", "Outbound electronic invoices.")</XFTypography></div></XFTabPanel>
                    <XFTabPanel TabId="oh2"><div class="p-4"><XFTypography Variant="XFTypographyVariant.Body2">@T("Notas fiscais de consumidor.", "Consumer invoices.")</XFTypography></div></XFTabPanel>
                    <XFTabPanel TabId="oh3"><div class="p-4"><XFTypography Variant="XFTypographyVariant.Body2">@T("Conhecimento de transporte eletronico.", "Electronic transport document.")</XFTypography></div></XFTabPanel>
                </Panels>
            </XFTabs>
        </div>
        <div class="flex flex-col gap-2">
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Vertical esquerda", "Vertical left")" />
            <XFTabs Size="XFSize.Md" Variant="XFTabsVariant.Pills" Orientation="XFTabsOrientation.Vertical" AriaLabel="Vertical left tabs">
                <Tabs>
                    <XFTab TabId="ovl1" Label="@T("Dashboard", "Dashboard")" />
                    <XFTab TabId="ovl2" Label="@T("Relatorios", "Reports")" />
                    <XFTab TabId="ovl3" Label="@T("Config", "Settings")" />
                </Tabs>
                <Panels>
