    // ==================== VALIDATION MODEL ====================
    internal sealed class NumberFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Obrigatorio")]
        [System.ComponentModel.DataAnnotations.Range(1, 100000, ErrorMessage = "Minimo 1")]
        public decimal? Quantity { get; set; }

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Obrigatorio")]
        [System.ComponentModel.DataAnnotations.Range(0.01, 999999999, ErrorMessage = "Valor deve ser positivo")]
        public decimal? UnitPrice { get; set; }
    }
