@page "/forms/multi-select"
@page "/forms/multiselect"
@using XForge.DesignSystem.Core.Primitives
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFMultiSelect" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Multi-selecao com chips, filtros e agrupamento", "Multi-selection with chips, filters and grouping")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Selecao multipla com chips, filtros e estados para formularios densos.",
                               "Multi-selection with chips, filters and states for dense forms.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("Componente generico para selecao de multiplos itens com suporte a agrupamento, acoes em lote, filtro por texto, loading, variacoes visuais e acessibilidade completa.",
                               "Generic component for selecting multiple items with support for grouping, bulk actions, text filter, loading, visual variants and full accessibility.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        <!-- ===== SECTION 1: Metadata ===== -->
        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        <!-- ===== SECTION 2: Blazor Server/WebAssembly ===== -->
        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico. Interacoes requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderizacao.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <!-- ===== SECTION 3: Visao geral ===== -->
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            <!-- ===== SECTION 4: Proposito ===== -->
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            <!-- ===== SECTION 5: Problema resolvido ===== -->
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            <!-- ===== SECTION 6: Quando usar ===== -->
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            <!-- ===== SECTION 7: Quando nao usar ===== -->
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            <!-- ===== SECTION 8: Anatomia ===== -->
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            <!-- ===== SECTION 9: Principios de design ===== -->
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 6 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Basico", "1. Basic"), T("Selecao multipla simples com lista de categorias.", "Simple multi-selection with categories list."), ExBasic(), Code1)
            @Example(T("2. Com Filtro e Placeholder", "2. With Filter and Placeholder"), T("Filtro por texto com placeholder customizado e valor de busca.", "Text filter with custom placeholder and search value."), ExFilter(), Code2)
            @Example(T("3. Tamanhos", "3. Sizes"), T("Tres tamanhos: Sm, Md e Lg.", "Three sizes: Sm, Md and Lg."), ExSizes(), Code3)
            @Example(T("4. Variantes Visuais", "4. Visual Variants"), T("Outline, Filled, Soft e Ghost.", "Outline, Filled, Soft and Ghost."), ExVariants(), Code4)
            @Example(T("5. Temas de Cor", "5. Color Tones"), T("Default, Success, Warning e Danger.", "Default, Success, Warning and Danger."), ExTones(), Code5)
            @Example(T("6. Com Labels e Helper", "6. With Labels and Helper"), T("Label, helper text, required e readonly.", "Label, helper text, required and readonly."), ExLabels(), Code6)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <!-- ===== SECTION 10: API ===== -->
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            <!-- ===== SECTION 11: Eventos ===== -->
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <!-- ===== SECTION 12: Acessibilidade ===== -->
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            <!-- ===== SECTION 13: Suporte de teclado ===== -->
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            <!-- ===== SECTION 14: Responsividade ===== -->
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            <!-- ===== SECTION 15: Performance ===== -->
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <!-- ===== SECTION 16: Cenarios enterprise ===== -->
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            <!-- ===== SECTION 17: Padroes de composicao ===== -->
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            <!-- ===== SECTION 18: Boas praticas de UX ===== -->
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            <!-- ===== SECTION 19: Anti-padroes ===== -->
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <!-- ===== SECTION 20: Design Tokens ===== -->
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            <!-- ===== SECTION 21: Temas ===== -->
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            <!-- ===== SECTION 22: Testes ===== -->
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            <!-- ===== SECTION 23: Limitacoes conhecidas ===== -->
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            <!-- ===== SECTION 24: Componentes relacionados ===== -->
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            <!-- ===== SECTION 25: FAQ ===== -->
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            <!-- ===== SECTION 26: Changelog ===== -->
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string ProductLabelText => T("Core Open Source", "Core Open Source");
    private string PageTitleText => T("XFMultiSelect", "XFMultiSelect");
    private string PageStatusText => T("Documentacao completa", "Complete docs");
    private string T(string pt, string en) => LanguageService.Text(pt, en);
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");

    // === HERO ===
    private static readonly string[] HeroCategories = ["Financeiro", "Fiscal", "Estoque"];
    private IReadOnlyList<string> HeroSelected = ["Financeiro", "Estoque"];
    private static readonly string[] HeroTags = ["Urgent", "Review", "Approved"];
    private IReadOnlyList<string> HeroSelectedTags = ["Urgent"];

    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFMultiSelect TItem="string" TValue="string"
            Label="Categorias" Placeholder="Selecione..."
            Items="@HeroCategories" Values="@HeroSelected"
            TextSelector="@(x => x)" ValueSelector="@(x => x)" />
    </XFStack>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("Generico e tipado", "Generic and typed"), T("Suporta TItem, TValue para qualquer modelo.", "Supports TItem, TValue for any model."), "cubes"),
        new(T("Filtro e busca", "Filter and search"), T("Filtro Contains ou StartsWith com busca em tempo real.", "Contains or StartsWith filter with real-time search."), "magnifying-glass"),
        new(T("Zero JS", "Zero JS"), T("Nenhum JavaScript interop. Puro C# + Tailwind.", "No JavaScript interop. Pure C# + Tailwind."), "bolt")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFMultiSelect<TItem, TValue>"),
        new("Namespace", "XForge.DesignSystem.Components.Forms.MultiSelect"),
        new("Package", "XForge.DesignSystem"),
        new("Category", "Forms / MultiSelect"),
        new("Status", T("Estavel", "Stable")),
        new("Accessibility", T("role=combobox, role=listbox, aria-multiselectable, aria-selected, aria-expanded.", "role=combobox, role=listbox, aria-multiselectable, aria-selected, aria-expanded.")),
        new("Theme support", T("Light, dark e data-brand via tokens.", "Light, dark and data-brand via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("Multi-selecao", "Multi-selection"), T("Selecao de multiplos itens com checkbox.", "Selection of multiple items with checkbox."), "check-double"),
        new(T("Chips", "Chips"), T("Itens selecionados exibidos como chips removiveis.", "Selected items displayed as removable chips."), "tags"),
        new(T("Filtro", "Filter"), T("Busca por texto com filtro Contains ou StartsWith.", "Search by text with Contains or StartsWith filter."), "magnifying-glass"),
        new(T("Agrupamento", "Grouping"), T("Itens agrupados por campo com header.", "Items grouped by field with header."), "layer-group"),
        new(T("Acoes em lote", "Bulk actions"), T("Selecionar todos e limpar selecao.", "Select all and clear selection."), "check-double"),
        new(T("Loading", "Loading"), T("Estado de carregamento com spinner.", "Loading state with spinner."), "spinner")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Formularios densos", "Dense forms"), T("Selecao de tags, categorias, permissoes.", "Selection of tags, categories, permissions."), "clipboard-list"),
        new(T("Filtros de busca", "Search filters"), T("Filtrar registros por multiplos criterios.", "Filter records by multiple criteria."), "filter"),
        new(T("Tags de usuario", "User tags"), T("Atribuir tags ou labels a entidades.", "Assign tags or labels to entities."), "tag")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Select multiplas nativas sem UI consistente.", "Native multi-selects without consistent UI."), "xmark"),
        new(T("Depois", "After"), T("Componente com chips, filtro, agrupamento e acessibilidade.", "Component with chips, filter, grouping and accessibility."), "check"),
        new(T("Acessibilidade", "Accessibility"), T("role=combobox, role=listbox, aria-multiselectable, aria-selected.", "role=combobox, role=listbox, aria-multiselectable, aria-selected."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Selecao de tags", "Tag selection"), T("Atribuir multiplos tags a entidades.", "Assign multiple tags to entities."), "tags"),
        new(T("Filtros de relatorio", "Report filters"), T("Filtrar dados por multiplos valores.", "Filter data by multiple values."), "filter"),
        new(T("Permissoes", "Permissions"), T("Selecionar permissoes ou roles.", "Select permissions or roles."), "shield"),
        new(T("Categorias", "Categories"), T("Classificar itens em categorias.", "Classify items into categories."), "folder")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Selecao unica", "Single selection"), T("Use XFSelect para selecao unica.", "Use XFSelect for single selection."), "circle-dot"),
        new(T("Poucos itens", "Few items"), T("Use checkboxes simples para 2-3 opcoes.", "Use simple checkboxes for 2-3 options."), "square-check"),
        new(T("Lista navegavel", "Navigable list"), T("Use XFNav para navegacao.", "Use XFNav for navigation."), "route")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new(T("Label", "Label"), T("Texto descritivo acima do campo.", "Descriptive text above the field."), "font"),
        new(T("Field shell", "Field shell"), T("Container com borda, focus ring e estados.", "Container with border, focus ring and states."), "square"),
        new(T("Chips", "Chips"), T("Itens selecionados como chips removiveis.", "Selected items as removable chips."), "tags"),
        new(T("Input", "Input"), T("Campo de busca com placeholder.", "Search field with placeholder."), "magnifying-glass"),
        new(T("Adornments", "Adornments"), T("Botoes de limpar e toggle.", "Clear and toggle buttons."), "sliders"),
        new(T("Listbox", "Listbox"), T("Dropdown com opcoes e checkbox.", "Dropdown with options and checkbox."), "list"),
        new(T("Bulk actions", "Bulk actions"), T("Selecionar todos e limpar.", "Select all and clear."), "check-double")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(T("Generico", "Generic"), T("Funciona com qualquer TItem e TValue.", "Works with any TItem and TValue."), "cubes"),
        new(T("Composicao", "Composition"), T("Chips, filtro e listbox sao composiveis.", "Chips, filter and listbox are composable."), "puzzle"),
        new(T("Acessibilidade", "Accessibility"), T("role=combobox, aria-multiselectable, navegacao por teclado.", "role=combobox, aria-multiselectable, keyboard navigation."), "universal-access")
    ];

    // === EXAMPLES ===
    private static readonly string[] ExBasicCats = ["Financeiro", "Fiscal", "Estoque", "RH", "Comercial"];
    private IReadOnlyList<string> ExBasicValues = [];

    private RenderFragment ExBasic() => @<div class="w-full max-w-sm">
        <XFMultiSelect TItem="string" TValue="string"
            Label="Categorias" Placeholder="Selecione..."
            Items="@ExBasicCats" Values="@ExBasicValues"
            TextSelector="@(x => x)" ValueSelector="@(x => x)" />
    </div>;

    private static readonly string[] ExFilterTags = ["Urgent", "Review", "Approved", "Blocked", "Pending"];
    private IReadOnlyList<string> ExFilterValues = [];

    private RenderFragment ExFilter() => @<div class="w-full max-w-sm">
        <XFMultiSelect TItem="string" TValue="string"
            Label="Tags" Placeholder="Buscar..."
            Items="@ExFilterTags" Values="@ExFilterValues"
            TextSelector="@(x => x)" ValueSelector="@(x => x)" />
    </div>;

    private static readonly string[] ExSizeItems = ["Opcao A", "Opcao B", "Opcao C"];
    private IReadOnlyList<string> ExSizeValuesSm = [];
    private IReadOnlyList<string> ExSizeValuesMd = [];
    private IReadOnlyList<string> ExSizeValuesLg = [];

    private RenderFragment ExSizes() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <div class="w-full max-w-sm">
            <XFMultiSelect TItem="string" TValue="string"
                Size="XFSize.Sm" Label="Small" Placeholder="Sm..."
                Items="@ExSizeItems" Values="@ExSizeValuesSm"
                TextSelector="@(x => x)" ValueSelector="@(x => x)" />
        </div>
        <div class="w-full max-w-sm">
            <XFMultiSelect TItem="string" TValue="string"
                Size="XFSize.Md" Label="Medium" Placeholder="Md..."
                Items="@ExSizeItems" Values="@ExSizeValuesMd"
                TextSelector="@(x => x)" ValueSelector="@(x => x)" />
        </div>
        <div class="w-full max-w-sm">
            <XFMultiSelect TItem="string" TValue="string"
                Size="XFSize.Lg" Label="Large" Placeholder="Lg..."
                Items="@ExSizeItems" Values="@ExSizeValuesLg"
                TextSelector="@(x => x)" ValueSelector="@(x => x)" />
        </div>
    </XFStack>;

    private static readonly string[] ExVarItems = ["Opcao A", "Opcao B", "Opcao C"];
    private IReadOnlyList<string> ExVarOutline = [];
    private IReadOnlyList<string> ExVarFilled = [];
    private IReadOnlyList<string> ExVarSoft = [];
    private IReadOnlyList<string> ExVarGhost = [];

    private RenderFragment ExVariants() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <div class="w-full max-w-sm">
            <XFMultiSelect TItem="string" TValue="string"
                Variant="XFFormVariant.Outline" Label="Outline" Placeholder="Outline..."
                Items="@ExVarItems" Values="@ExVarOutline"
                TextSelector="@(x => x)" ValueSelector="@(x => x)" />
        </div>
        <div class="w-full max-w-sm">
            <XFMultiSelect TItem="string" TValue="string"
                Variant="XFFormVariant.Filled" Label="Filled" Placeholder="Filled..."
                Items="@ExVarItems" Values="@ExVarFilled"
                TextSelector="@(x => x)" ValueSelector="@(x => x)" />
        </div>
        <div class="w-full max-w-sm">
            <XFMultiSelect TItem="string" TValue="string"
                Variant="XFFormVariant.Soft" Label="Soft" Placeholder="Soft..."
                Items="@ExVarItems" Values="@ExVarSoft"
                TextSelector="@(x => x)" ValueSelector="@(x => x)" />
        </div>
        <div class="w-full max-w-sm">
            <XFMultiSelect TItem="string" TValue="string"
                Variant="XFFormVariant.Ghost" Label="Ghost" Placeholder="Ghost..."
                Items="@ExVarItems" Values="@ExVarGhost"
                TextSelector="@(x => x)" ValueSelector="@(x => x)" />
        </div>
    </XFStack>;

    private static readonly string[] ExToneItems = ["Opcao A", "Opcao B", "Opcao C"];
    private IReadOnlyList<string> ExToneDefault = [];
    private IReadOnlyList<string> ExToneSuccess = [];
    private IReadOnlyList<string> ExToneWarning = [];
    private IReadOnlyList<string> ExToneDanger = [];

    private RenderFragment ExTones() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <div class="w-full max-w-sm">
            <XFMultiSelect TItem="string" TValue="string"
                Tone="XFSemanticColor.Default" Label="Default" Placeholder="Default..."
                Items="@ExToneItems" Values="@ExToneDefault"
                TextSelector="@(x => x)" ValueSelector="@(x => x)" />
        </div>
        <div class="w-full max-w-sm">
            <XFMultiSelect TItem="string" TValue="string"
                Tone="XFSemanticColor.Success" Label="Success" Placeholder="Success..."
                Items="@ExToneItems" Values="@ExToneSuccess"
                TextSelector="@(x => x)" ValueSelector="@(x => x)" />
        </div>
        <div class="w-full max-w-sm">
            <XFMultiSelect TItem="string" TValue="string"
                Tone="XFSemanticColor.Warning" Label="Warning" Placeholder="Warning..."
                Items="@ExToneItems" Values="@ExToneWarning"
                TextSelector="@(x => x)" ValueSelector="@(x => x)" />
        </div>
        <div class="w-full max-w-sm">
            <XFMultiSelect TItem="string" TValue="string"
                Tone="XFSemanticColor.Danger" Label="Danger" Placeholder="Danger..."
                Items="@ExToneItems" Values="@ExToneDanger"
                TextSelector="@(x => x)" ValueSelector="@(x => x)" />
        </div>
    </XFStack>;

    private static readonly string[] ExLabelItems = ["Opcao A", "Opcao B", "Opcao C"];
    private IReadOnlyList<string> ExLabelHelper = [];
    private IReadOnlyList<string> ExLabelRequired = [];
    private IReadOnlyList<string> ExLabelReadonly = ["Opcao A"];

    private RenderFragment ExLabels() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <div class="w-full max-w-sm">
            <XFMultiSelect TItem="string" TValue="string"
                Label="Com Helper" Placeholder="Selecione..." HelperText="Escolha uma ou mais opcoes."
                Items="@ExLabelItems" Values="@ExLabelHelper"
                TextSelector="@(x => x)" ValueSelector="@(x => x)" />
        </div>
        <div class="w-full max-w-sm">
            <XFMultiSelect TItem="string" TValue="string"
                Label="Obrigatorio" Placeholder="Selecione..." Required="true"
                Items="@ExLabelItems" Values="@ExLabelRequired"
                TextSelector="@(x => x)" ValueSelector="@(x => x)" />
        </div>
        <div class="w-full max-w-sm">
            <XFMultiSelect TItem="string" TValue="string"
                Label="Readonly" Placeholder="Selecione..." ReadOnly="true"
                Items="@ExLabelItems" Values="@ExLabelReadonly"
                TextSelector="@(x => x)" ValueSelector="@(x => x)" />
        </div>
    </XFStack>;

    private const string Code1 = @"<XFMultiSelect TItem=""string"" TValue=""string""
    Label=""Categorias"" Placeholder=""Selecione...""
    Items=""@Categories"" Values=""@SelectedCategories""
    TextSelector=""@(x => x)"" ValueSelector=""@(x => x)"" />";
    private const string Code2 = @"<XFMultiSelect TItem=""string"" TValue=""string""
    Label=""Tags"" Placeholder=""Buscar...""
    Items=""@Tags"" Values=""@SelectedTags""
