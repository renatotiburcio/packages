    private Task SaveDefaultAsync(MouseEventArgs args)
    {
        lastAction = T("Salvar", "Save");
        return Task.CompletedTask;
    }

    private Task ExportDefaultAsync(MouseEventArgs args)
    {
        lastAction = T("Exportar padrao", "Default export");
        return Task.CompletedTask;
    }

    private Task PublishDefaultAsync(MouseEventArgs args)
    {
        lastAction = T("Publicar", "Publish");
        return Task.CompletedTask;
    }

    private Task SelectOptionAsync(XFDropdownMenuItem item)
    {
        lastAction = item.Text ?? item.Value?.ToString() ?? T("Opcao selecionada", "Selected option");
        return Task.CompletedTask;
    }

    private Task SetControlledOpenAsync(bool open)
    {
        controlledOpen = open;
        return Task.CompletedTask;
    }

