@page "/components/split-button"
@using XForge.DesignSystem.Core.Primitives
@using Microsoft.AspNetCore.Components.Web
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFSplitButton" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Acao + menu", "Action + menu")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Teclado pronto", "Keyboard-ready")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Fluxos ERP", "ERP flows")" />
                    </XFStack>

                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Um comando principal com alternativas relacionadas no mesmo contexto.",
                               "One primary command with related alternatives in the same context.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("XFSplitButton combina uma acao frequente e direta com um menu de variacoes como salvar copia, exportar em outro formato, agendar publicacao ou executar escopos diferentes. Ele preserva semantica, teclado, roles de menu e governanca visual sem espalhar botoes redundantes pela tela.",
                               "XFSplitButton combines a frequent direct action with a menu of variations such as saving a copy, exporting in another format, scheduling publication or running different scopes. It preserves semantics, keyboard behavior, menu roles and visual governance without spreading redundant buttons across the screen.")
                        </XFTypography>
                    </XFStack>

                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts)
                            {
                                @Tile(item)
                            }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section(T("Blazor Server e Blazor WebAssembly", "Blazor Server and Blazor WebAssembly"), @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona com prerender-safe guards.", "Works with prerender-safe guards.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona com prerender-safe guards no primeiro render.", "Works with prerender-safe guards on first render.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Parcial", "Partial")" /></XFTableCell><XFTableCell>@T("Renderiza HTML base. Posicionamento do menu e focus indisponiveis durante prerender.", "Renders base HTML. Menu positioning and focus unavailable during prerender.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("JS Interop", "JS Interop")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Arquivo JS: xf-splitbutton.js — gerencia xfSplitButton.register/release, posicionamento do painel flutuante e fechamento por clique externo.", "JS file: xf-splitbutton.js — manages xfSplitButton.register/release, floating panel positioning and outside-click close.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Quando carrega: OnAfterRenderAsync.", "When loaded: OnAfterRenderAsync.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Prerender seguro: try/catch para InvalidOperationException e JSDisconnectedException.", "Prerender safe: try/catch for InvalidOperationException and JSDisconnectedException.")</XFTypography>
                </XFStack>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Consideracoes Blazor Server", "Blazor Server Considerations")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("JS interop via SignalR com latencia. Posicionamento do menu pode ter resposta mais lenta.", "JS interop via SignalR with latency. Menu positioning may have slower response.")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Consideracoes Blazor WebAssembly", "Blazor WebAssembly Considerations")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("JS interop direto sem latencia de rede. Disponivel apos carregamento do WASM.", "Direct JS interop with no network latency. Available after WASM load.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Hierarquia visual", "Visual Hierarchy"), @<div>@TileGrid(VisualHierarchyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("Preview renderizado", "Live Preview"),
                T("Acao padrao com alternativas reais de salvamento e exportacao.", "Default action with real save and export alternatives."),
                BasicPreview(),
                BasicCode)

            @Example(T("Cobertura de exemplos: variantes e cores", "Example Coverage: variants and colors"),
                T("A linguagem visual acompanha o contrato de XFButton.", "The visual language follows the XFButton contract."),
                VariantsPreview(),
                VariantsCode)

            @Example(T("Estados e layout", "States and layout"),
                T("FullWidth, disabled e uso em cards estreitos.", "FullWidth, disabled and use in narrow cards."),
                StatePreview(),
                StateCode)

            @Example(T("Integracao: menu rico", "Integration: rich menu"),
                T("Headers, separators, checkbox, radio, shortcuts e item desabilitado via XFDropdownMenuItem.", "Headers, separators, checkbox, radio, shortcuts and disabled item via XFDropdownMenuItem."),
                RichMenuPreview(),
                RichMenuCode)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Variantes", "Variants"), @<div>@NameValueTable(VariantRows, T("Variante", "Variant"), T("Caso de uso", "Use case"))</div>)
            @Section(T("Estados", "States"), @<div>@NameValueTable(StateRows, T("Estado", "State"), T("Comportamento", "Behavior"))</div>)
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Metodos", "Methods"), @<div>@NameValueTable(MethodRows, T("Metodo", "Method"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Navegacao enterprise por teclado", "Enterprise Keyboard Navigation"), @<div>@TileGrid(EnterpriseKeyboardItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Exemplos de integracao", "Integration Examples"), @<div>@TileGrid(IntegrationItems, 2)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("Design Tokens", @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Seguranca", "Security Considerations"), @<div>@TileGrid(SecurityItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Notas de migracao", "Migration Notes"), @<div>@TileGrid(MigrationItems, 2)</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>

@code {
    private string ProductLabelText => T("Core Open Source", "Core Open Source");
    private string PageTitleText => T("Split Button", "Split Button");
    private string PageStatusText => T("Documentacao completa", "Complete docs");
    private string lastAction = "Aguardando acao";
    private bool controlledOpen;

    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");

    private IReadOnlyList<XFDropdownMenuItem> SaveItems => [
        new() { Text = T("Salvar copia", "Save copy"), Description = T("Mantem o documento original", "Keeps the original document"), Shortcut = "Ctrl+Shift+S", Value = "save-copy" },
        new() { Text = T("Salvar como template", "Save as template"), Description = T("Reutilizar em novos cadastros", "Reuse in new records"), Value = "template" },
        new() { Kind = XFDropdownMenuItemKind.Separator },
        new() { Text = T("Descartar alteracoes", "Discard changes"), Tone = XFSemanticColor.Danger, Value = "discard" }
    ];

    private IReadOnlyList<XFDropdownMenuItem> ExportItems => [
        new() { Text = T("Exportar PDF", "Export PDF"), Description = T("Formato final para auditoria", "Final format for audit"), Shortcut = "PDF", Value = "pdf" },
        new() { Text = T("Exportar XLSX", "Export XLSX"), Description = T("Planilha editavel", "Editable spreadsheet"), Shortcut = "XLSX", Value = "xlsx" },
        new() { Text = T("Exportar CSV", "Export CSV"), Description = T("Integracao e carga", "Integration and import"), Shortcut = "CSV", Value = "csv" }
    ];

    private IReadOnlyList<XFDropdownMenuItem> RichExportItems => [
        new() { Kind = XFDropdownMenuItemKind.Header, Text = T("Formato", "Format") },
        new() { Text = T("PDF final", "Final PDF"), Description = T("Com assinatura visual", "With visual signature"), Shortcut = "PDF", Value = "pdf" },
        new() { Text = T("Excel operacional", "Operational Excel"), Description = T("Com colunas de conferencia", "With review columns"), Shortcut = "XLSX", Value = "xlsx" },
        new() { Kind = XFDropdownMenuItemKind.Separator },
        new() { Text = T("Incluir anexos", "Include attachments"), Kind = XFDropdownMenuItemKind.XFCheckbox, Checked = true, Value = "attachments" },
        new() { Text = T("Somente selecionados", "Selected only"), Kind = XFDropdownMenuItemKind.XFRadio, Group = "scope", Checked = true, Value = "selected" },
        new() { Text = T("Todos os registros", "All records"), Kind = XFDropdownMenuItemKind.XFRadio, Group = "scope", Value = "all" },
        new() { Kind = XFDropdownMenuItemKind.Separator },
        new() { Text = T("Exportacao bloqueada", "Export locked"), Description = T("Sem permissao no perfil atual", "No permission in the current profile"), Disabled = true, Value = "locked" }
    ];

    private IReadOnlyList<XFDropdownMenuItem> PublishItems => [
        new() { Text = T("Publicar agora", "Publish now"), Description = T("Envia para producao", "Sends to production"), Value = "publish-now" },
        new() { Text = T("Agendar publicacao", "Schedule publication"), Description = T("Escolher data e hora", "Choose date and time"), Value = "schedule" },
        new() { Text = T("Salvar rascunho", "Save draft"), Value = "draft" }
    ];

    private IReadOnlyList<XFDropdownMenuItem> ValidationItems => [
        new() { Text = T("Validar tudo", "Validate all"), Value = "validate-all" },
        new() { Text = T("Validar apenas alterados", "Validate changed only"), Value = "validate-changed" },
        new() { Text = T("Ignorar avisos leves", "Ignore minor warnings"), Kind = XFDropdownMenuItemKind.XFCheckbox, Checked = false, Value = "ignore-warnings" }
    ];

    private IReadOnlyList<XFDropdownMenuItem> PeriodItems => [
        new() { Text = T("Fechar competencia", "Close period"), Value = "close-period" },
        new() { Text = T("Fechar e notificar", "Close and notify"), Value = "close-notify" }
    ];

    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFStack Orientation="XFOrientation.Horizontal" Gap="3" Wrap="XFWrap.Wrap">
            <XFSplitButton Text="@T("Salvar", "Save")"
                           Items="SaveItems"
                           MenuAriaLabel="@T("Abrir opcoes de salvamento", "Open save options")"
                           OnClick="SaveDefaultAsync"
                           ItemSelected="SelectOptionAsync">
                <StartIcon><span class="inline-flex h-5 w-5">@XFSvgIcons.MarkupWithSize("check", 18)</span></StartIcon>
            </XFSplitButton>

            <XFSplitButton Text="@T("Exportar", "Export")"
                           Variant="XFButtonVariant.Outline"
                           Items="ExportItems"
                           MenuAriaLabel="@T("Abrir formatos de exportacao", "Open export formats")"
                           OnClick="ExportDefaultAsync"
                           ItemSelected="SelectOptionAsync">
                <StartIcon><span class="inline-flex h-5 w-5">@XFSvgIcons.MarkupWithSize("download", 18)</span></StartIcon>
            </XFSplitButton>

            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Primary" Text="@lastAction" />
        </XFStack>

        <XFGrid Cols="1" Md="3" Gap="3">
            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
                <ChildContent>
                    <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Primario", "Primary")</XFTypography>
                    <XFSplitButton Text="@T("Publicar", "Publish")" Items="PublishItems" OnClick="PublishDefaultAsync" ItemSelected="SelectOptionAsync" FullWidth="true" />
                </ChildContent>
            </XFCard>
            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
                <ChildContent>
                    <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Cautela", "Caution")</XFTypography>
                    <XFSplitButton Text="@T("Revalidar", "Revalidate")" Items="ValidationItems" Variant="XFButtonVariant.Soft" Color="XFButtonColor.Warning" ItemSelected="SelectOptionAsync" FullWidth="true" />
                </ChildContent>
            </XFCard>
            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
                <ChildContent>
                    <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Bloqueado", "Locked")</XFTypography>
                    <XFSplitButton Text="@T("Fechar periodo", "Close period")" Items="PeriodItems" Color="XFButtonColor.Danger" Disabled="true" FullWidth="true" />
                </ChildContent>
            </XFCard>
        </XFGrid>
    </XFStack>;

    private RenderFragment BasicPreview() => @<XFStack Orientation="XFOrientation.Horizontal" Gap="3" Wrap="XFWrap.Wrap">
        <XFSplitButton Text="@T("Salvar", "Save")" Items="SaveItems" OnClick="SaveDefaultAsync" ItemSelected="SelectOptionAsync" />
        <XFSplitButton Text="@T("Exportar", "Export")" Items="ExportItems" Variant="XFButtonVariant.Outline" ItemSelected="SelectOptionAsync" />
        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Primary" Text="@lastAction" />
    </XFStack>;

    private RenderFragment VariantsPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFStack Orientation="XFOrientation.Horizontal" Gap="3" Wrap="XFWrap.Wrap">
            <XFSplitButton Text="Solid" Items="SaveItems" />
            <XFSplitButton Text="Outline" Items="SaveItems" Variant="XFButtonVariant.Outline" />
            <XFSplitButton Text="Soft" Items="SaveItems" Variant="XFButtonVariant.Soft" />
            <XFSplitButton Text="Ghost" Items="SaveItems" Variant="XFButtonVariant.Ghost" />
            <XFSplitButton Text="Subtle" Items="SaveItems" Variant="XFButtonVariant.Subtle" />
        </XFStack>
        <XFStack Orientation="XFOrientation.Horizontal" Gap="3" Wrap="XFWrap.Wrap">
            <XFSplitButton Text="Primary" Items="SaveItems" Color="XFButtonColor.Primary" />
            <XFSplitButton Text="Success" Items="SaveItems" Color="XFButtonColor.Success" />
            <XFSplitButton Text="Warning" Items="ValidationItems" Color="XFButtonColor.Warning" />
            <XFSplitButton Text="Danger" Items="PeriodItems" Color="XFButtonColor.Danger" />
            <XFSplitButton Text="Neutral" Items="ExportItems" Color="XFButtonColor.Neutral" />
        </XFStack>
    </XFStack>;

    private RenderFragment StatePreview() => @<XFGrid Cols="1" Md="3" Gap="3">
        <XFSplitButton Text="@T("Enviar proposta", "Send proposal")" Items="ExportItems" FullWidth="true" />
        <XFSplitButton Text="@T("Fechar competencia", "Close fiscal period")" Items="PeriodItems" Color="XFButtonColor.Danger" Disabled="true" FullWidth="true" />
        <XFSplitButton Text="@T("Mais acoes", "More actions")" Items="SaveItems" Open="controlledOpen" OpenChanged="SetControlledOpenAsync" ItemSelected="SelectOptionAsync" FullWidth="true" />
    </XFGrid>;

    private RenderFragment RichMenuPreview() => @<XFStack Orientation="XFOrientation.Horizontal" Gap="3" Wrap="XFWrap.Wrap">
        <XFSplitButton Text="@T("Exportar relatorio", "Export report")"
                       Items="RichExportItems"
                       Variant="XFButtonVariant.Outline"
                       MenuAriaLabel="@T("Abrir opcoes de exportacao", "Open export options")"
                       MenuPanelAriaLabel="@T("Opcoes de exportacao do relatorio", "Report export options")"
                       ItemSelected="SelectOptionAsync">
            <StartIcon><span class="inline-flex h-5 w-5">@XFSvgIcons.MarkupWithSize("download", 18)</span></StartIcon>
        </XFSplitButton>
    </XFStack>;

    private RenderFragment Section(string title, RenderFragment content) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
        <Header><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography></Header>
        <ChildContent>@content</ChildContent>
    </XFCard>;

    private RenderFragment Example(string title, string description, RenderFragment preview, string codeText) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.None" AreaRestricted="false">
        <Header>
            <div class="px-6 pt-6">
                <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@description</XFTypography>
            </div>
        </Header>
        <ChildContent>
            <div class="grid">
                <div class="border-t border-border-light p-6">@preview</div>
                <div class="border-t border-border-light bg-surface-50 p-6">
                    <XFCode Text="@codeText" Language="razor" Title="@CopyableCodeTitle" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" />
                </div>
            </div>
        </ChildContent>
    </XFCard>;

    private RenderFragment Tile(DocTile item) => @<XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
        <ChildContent>
            <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                <div class="flex items-center gap-4">
                    <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-primary/10 bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                    <div class="min-w-0">
                        <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography>
                    </div>
                </div>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
            </XFStack>
        </ChildContent>
    </XFCard>;

    private RenderFragment TileGrid(IReadOnlyList<DocTile> items, int columns) => @<XFGrid Cols="1" Md="@Math.Min(columns, 2)" Lg="@columns" Gap="4">
        @foreach (var item in items)
        {
            @Tile(item)
        }
    </XFGrid>;

    private RenderFragment WarningGrid(IReadOnlyList<DocTile> items) => @<XFGrid Cols="1" Md="2" Gap="4">
        @foreach (var item in items)
        {
            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
                <ChildContent>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                        <div class="flex items-center gap-4">
                            <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-danger/10 bg-danger/10 text-danger" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                            <div class="min-w-0">
                                <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography>
                            </div>
                        </div>
