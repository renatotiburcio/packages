                        <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">primary</XFTypography>
                    </XFStack>
                </ChildContent>
            </XFCard>
            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
                <ChildContent>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2">
