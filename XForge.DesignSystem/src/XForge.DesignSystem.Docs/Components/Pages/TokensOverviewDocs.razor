            </XFCard>
        </XFGrid>

        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" JustifyContent="XFJustifyContent.SpaceBetween" AlignItems="XFAlignItems.Center" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">Contrato visual ativo</XFTypography>
                        <XFBadge Text="data-theme" Color="XFBadgeColor.Info" Variant="XFBadgeVariant.Soft" />
                    </XFStack>
