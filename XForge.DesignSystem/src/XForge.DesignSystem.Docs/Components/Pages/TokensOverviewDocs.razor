                </ChildContent>
            </XFCard>
            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
                <ChildContent>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2">
                        <div class="h-10 rounded-lg bg-danger"></div>
                        <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">danger</XFTypography>
