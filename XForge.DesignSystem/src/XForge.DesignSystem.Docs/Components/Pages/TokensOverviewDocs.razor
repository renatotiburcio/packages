                        <XFBadge Text="shadow-sm" Color="XFBadgeColor.Neutral" />
                        <XFBadge Text="gap-4" Color="XFBadgeColor.Success" />
                    </XFGrid>
                </XFStack>
            </ChildContent>
        </XFCard>
    </XFStack>;

    private static RenderFragment ColorPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFGrid Cols="1" Sm="4" Gap="3">
            <XFBadge Text="Aprovado" Color="XFBadgeColor.Success" />
            <XFBadge Text="Pendente" Color="XFBadgeColor.Warning" />
            <XFBadge Text="Bloqueado" Color="XFBadgeColor.Danger" />
            <XFBadge Text="Informativo" Color="XFBadgeColor.Info" />
        </XFGrid>
        <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">
            Estados usam tokens semânticos, não valores locais de cor.
        </XFTypography>
    </XFStack>;

    private static RenderFragment DensityPreview() => @<XFGrid Cols="1" Md="3" Gap="4">
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Sm"><ChildContent><XFTypography Variant="XFTypographyVariant.Body2" Weight="XFTypographyWeight.Semibold">Compact</XFTypography><XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">p-sm / gap-2</XFTypography></ChildContent></XFCard>
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Md"><ChildContent><XFTypography Variant="XFTypographyVariant.Body2" Weight="XFTypographyWeight.Semibold">Default</XFTypography><XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">p-md / gap-4</XFTypography></ChildContent></XFCard>
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFTypography Variant="XFTypographyVariant.Body2" Weight="XFTypographyWeight.Semibold">Comfort</XFTypography><XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">p-lg / gap-5</XFTypography></ChildContent></XFCard>
    </XFGrid>;

    private static RenderFragment SurfacePreview() => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl">
        <ChildContent>
            <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">Surface tokenizada</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">
