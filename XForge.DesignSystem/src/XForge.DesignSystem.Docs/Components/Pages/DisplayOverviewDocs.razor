    private IReadOnlyList<XForgeCategoryOverviewItem> Objectives => [
        Item("Padronizacao", "Standardization", "Definir uma linguagem unica para dados, midia e status.", "Define one language for data, media and status.", "check"),
        Item("Reuso", "Reusability", "Permitir os mesmos blocos em dashboard, CRUD, relatorio e workflow.", "Allow the same blocks in dashboard, CRUD, report and workflow.", "arrows-rotate"),
        Item("Escala", "Scalability", "Suportar listas grandes, documentos, graficos e estados async.", "Support large lists, documents, charts and async states.", "chart-line-up"),
