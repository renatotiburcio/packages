@page "/display/overview"
@using XForge.DesignSystem.Core.Primitives
@inject XForgeDocsLanguageService Language

<XForgeDocsShell ProductLabel="@T("Core Open Source", "Core Open Source")" Title="@T("Visao geral de Display", "Display Overview")" Status="@T("Padrao de categoria", "Category standard")" Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <div class="grid gap-6">
                    <div class="flex flex-wrap gap-2">
                        <XFBadge Text="@T("Exibicao de dados", "Data Display")" Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" />
                        <XFBadge Text="@T("Dashboards enterprise", "Enterprise dashboards")" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" />
                        <XFBadge Text="@T("Superficies acessiveis", "Accessible data surfaces")" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" />
                    </div>

                    <div class="grid gap-2">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Componentes para transformar dados, midia e estados visuais em superficies confiaveis.",
                               "Components for turning data, media and visual states into trustworthy surfaces.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("A categoria Display cobre tabelas, listas, cards informativos, visualizacoes, midia, timeline, mapas, graficos e esqueletos de leitura. Ela existe para padronizar como aplicacoes enterprise mostram informacao operacional sem sacrificar acessibilidade, performance ou consistencia visual.",
                               "The Display category covers tables, lists, information cards, visualizations, media, timeline, maps, charts and reading skeletons. It exists to standardize how enterprise applications show operational information without sacrificing accessibility, performance or visual consistency.")
                        </XFTypography>
                    </div>

                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @DashboardPreview()
                        </div>
                        <div class="grid gap-3">
                            @foreach (var item in HeroFacts)
                            {
                                <XForgeCategoryOverviewTile Item="item" />
                            }
                        </div>
                    </div>
                </div>
            </ChildContent>
        </XFCard>

        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
            <Header><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">Blazor Server e Blazor WebAssembly</XFTypography></Header>
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                    <XFTable Striped="true" Hoverable="true" Compact="true">
                        <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                        <XFTableBody>
                            <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                            <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                            <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                            <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico. Interacoes requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                        </XFTableBody>
                    </XFTable>
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderizacao.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
                </XFStack>
            </ChildContent>
        </XFCard>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewSection Title="@T("Visao geral", "Overview")" Items="OverviewGoals" Columns="2" />
            <XForgeCategoryOverviewSection Title="@T("Filosofia", "Philosophy")" Items="Philosophy" Columns="2" />
            <XForgeCategoryOverviewSection Title="@T("Objetivos da categoria", "Category Objectives")" Items="Objectives" Columns="3" />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewComponentTable Rows="ComponentRows"
                                                  Description="@T("Cada componente deve ter uso principal, cenario enterprise e nivel de acessibilidade documentado.",
                                                                  "Each component must document primary use, enterprise scenario and accessibility level.")" />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewSection Title="@T("Linguagem visual", "Visual Language")" Items="VisualLanguage" Columns="3" />
            <XForgeCategoryOverviewSection Title="@T("Padroes de UX", "UX Standards")" Items="UxStandards" Columns="2" />
            <XForgeCategoryOverviewSection Title="@T("Padroes de acessibilidade", "Accessibility Standards")" Items="AccessibilityStandards" Columns="2" />
            <XForgeCategoryOverviewSection Title="@T("Padroes de responsividade", "Responsiveness Standards")" Items="ResponsiveStandards" Columns="2" />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewSection Title="@T("Padroes de tema", "Theme Standards")" Items="ThemeStandards" Columns="2" />
            <XForgeCategoryOverviewNameDescriptionTable Title="Design Tokens" NameHeader="@T("Grupo de token", "Token Group")" DescriptionHeader="@T("Proposito", "Purpose")" Rows="TokenRows" CodeName="true" />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewSection Title="@T("Padroes comuns", "Common Patterns")" Items="CommonPatterns" Columns="3" />
            <XForgeCategoryOverviewSection Title="@T("Cenarios enterprise", "Enterprise Scenarios")" Items="EnterpriseScenarios" Columns="3" />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewExampleGallery Examples="Examples" />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewSection Title="@T("Padroes de documentacao", "Documentation Standards")" Items="DocumentationStandards" Columns="2" />
            <XForgeCategoryOverviewSection Title="@T("Anti-padroes", "Anti-patterns")" Items="AntiPatterns" Columns="2" />
            <XForgeCategoryOverviewSection Title="@T("Guia de migracao", "Migration Guidance")" Items="MigrationGuidance" Columns="2" />
            <XForgeCategoryOverviewSection Title="@T("Boas praticas", "Best Practices")" Items="BestPractices" Columns="2" />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewNameDescriptionTable Title="@T("Categorias relacionadas", "Related Categories")" NameHeader="@T("Categoria", "Category")" DescriptionHeader="@T("Relacao", "Relationship")" Rows="RelatedCategories" />
        </XFStack>
    </XFStack>

    <XForgeDocsPageStandard ComponentName="DisplayOverviewDocs" IsOverview="true" />
</XForgeDocsShell>

@code {
    private string T(string ptBr, string enUs) => Language.Text(ptBr, enUs);

    private RenderFragment DashboardPreview() => @<div class="grid gap-4">
        <div class="grid gap-3 md:grid-cols-3">
            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Receita mensal", "Monthly revenue")</XFTypography><XFTypography Variant="XFTypographyVariant.H3" Weight="XFTypographyWeight.Bold">R$ 842k</XFTypography><XFBadge Text="+12%" Color="XFBadgeColor.Success" Variant="XFBadgeVariant.Soft" Size="XFBadgeSize.Sm" /></ChildContent></XFCard>
            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Pedidos abertos", "Open orders")</XFTypography><XFTypography Variant="XFTypographyVariant.H3" Weight="XFTypographyWeight.Bold">1.284</XFTypography><XFBadge Text="@T("operacao", "operation")" Color="XFBadgeColor.Info" Variant="XFBadgeVariant.Soft" Size="XFBadgeSize.Sm" /></ChildContent></XFCard>
            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Risco fiscal", "Tax risk")</XFTypography><XFTypography Variant="XFTypographyVariant.H3" Weight="XFTypographyWeight.Bold">@T("Baixo", "Low")</XFTypography><XFBadge Text="@T("auditado", "audited")" Color="XFBadgeColor.Success" Variant="XFBadgeVariant.Soft" Size="XFBadgeSize.Sm" /></ChildContent></XFCard>
        </div>
        <XFTable Size="XFSize.Sm" Striped="true">
            <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Conta", "Account")</XFTableCell><XFTableCell Header="true">Status</XFTableCell><XFTableCell Header="true">@T("Valor", "Value")</XFTableCell></XFTableRow></XFTableHeader>
            <XFTableBody>
                <XFTableRow><XFTableCell>@T("Fornecedor Alfa", "Alpha Supplier")</XFTableCell><XFTableCell><XFBadge Text="@T("Aprovado", "Approved")" Color="XFBadgeColor.Success" Size="XFBadgeSize.Sm" /></XFTableCell><XFTableCell>R$ 18.900</XFTableCell></XFTableRow>
                <XFTableRow><XFTableCell>NF-e 94381</XFTableCell><XFTableCell><XFBadge Text="@T("Pendente", "Pending")" Color="XFBadgeColor.Warning" Size="XFBadgeSize.Sm" /></XFTableCell><XFTableCell>R$ 7.420</XFTableCell></XFTableRow>
            </XFTableBody>
        </XFTable>
    </div>;

    private RenderFragment TablePreview() => @<div class="grid gap-3">
        <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Aging financeiro", "Financial aging")</XFTypography>
        <XFTable Size="XFSize.Sm" Striped="true">
            <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Faixa", "Range")</XFTableCell><XFTableCell Header="true">@T("Titulos", "Receivables")</XFTableCell><XFTableCell Header="true">@T("Exposicao", "Exposure")</XFTableCell></XFTableRow></XFTableHeader>
            <XFTableBody>
                <XFTableRow><XFTableCell>0-15 @T("dias", "days")</XFTableCell><XFTableCell>248</XFTableCell><XFTableCell>R$ 302k</XFTableCell></XFTableRow>
                <XFTableRow><XFTableCell>16-30 @T("dias", "days")</XFTableCell><XFTableCell>91</XFTableCell><XFTableCell>R$ 118k</XFTableCell></XFTableRow>
                <XFTableRow><XFTableCell>31+ @T("dias", "days")</XFTableCell><XFTableCell>37</XFTableCell><XFTableCell>R$ 64k</XFTableCell></XFTableRow>
            </XFTableBody>
        </XFTable>
    </div>;

    private RenderFragment MediaPreview() => @<div class="grid gap-4 md:grid-cols-2">
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Arquivo analisado", "Analyzed file")</XFTypography><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@T("Relatorio fiscal trimestral com 42 paginas e anexos.", "Quarterly tax report with 42 pages and attachments.")</XFTypography><div class="mt-4 flex flex-wrap gap-2"><XFBadge Text="PDF" Color="XFBadgeColor.Danger" /><XFBadge Text="@T("auditavel", "auditable")" Color="XFBadgeColor.Info" Variant="XFBadgeVariant.Soft" /></div></ChildContent></XFCard>
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Timeline operacional", "Operational timeline")</XFTypography><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@T("Recebido, validado, aprovado e arquivado com rastreabilidade.", "Received, validated, approved and archived with traceability.")</XFTypography><div class="mt-4 grid gap-2"><XFBadge Text="@T("Recebido", "Received")" Color="XFBadgeColor.Success" /><XFBadge Text="@T("Validacao fiscal", "Tax validation")" Color="XFBadgeColor.Warning" Variant="XFBadgeVariant.Soft" /></div></ChildContent></XFCard>
    </div>;

    private RenderFragment TokenPreview() => @<div class="grid gap-3 md:grid-cols-3">
        <XFCard Variant="XFCardVariant.Outlined" Tone="XFSemanticColor.Primary" Padding="XFPadding.Lg"><ChildContent><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">Primary data</XFTypography><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@T("Indicadores principais.", "Primary indicators.")</XFTypography></ChildContent></XFCard>
        <XFCard Variant="XFCardVariant.Outlined" Tone="XFSemanticColor.Warning" Padding="XFPadding.Lg"><ChildContent><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">Warning state</XFTypography><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@T("Atencao operacional.", "Operational attention.")</XFTypography></ChildContent></XFCard>
        <XFCard Variant="XFCardVariant.Outlined" Tone="XFSemanticColor.Success" Padding="XFPadding.Lg"><ChildContent><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">Success state</XFTypography><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@T("Processo concluido.", "Process completed.")</XFTypography></ChildContent></XFCard>
    </div>;

    private XForgeCategoryOverviewItem Item(string ptTitle, string enTitle, string ptDescription, string enDescription, string icon) => new(T(ptTitle, enTitle), T(ptDescription, enDescription), icon);
    private XForgeCategoryOverviewNameDescription Pair(string name, string ptDescription, string enDescription) => new(name, T(ptDescription, enDescription));
    private XForgeCategoryOverviewComponentRow Row(string component, string ptPurpose, string enPurpose, string ptUse, string enUse, string ptEnterprise, string enEnterprise, string accessibility, string complexity) => new(component, T(ptPurpose, enPurpose), T(ptUse, enUse), T(ptEnterprise, enEnterprise), accessibility, complexity);

    private IReadOnlyList<XForgeCategoryOverviewExample> Examples => [
        new(T("Dashboard financeiro", "Financial dashboard"), T("Composicao clara para metricas, tabelas e status de operacao.", "Clear composition for metrics, tables and operation status."), DashboardPreview(), DashboardCode),
        new(T("Tabela operacional", "Operational table"), T("Grade compacta para comparacao, auditoria e tomada de decisao.", "Compact grid for comparison, audit and decision making."), TablePreview(), TableCode),
        new(T("Midia e documentos", "Media and documents"), T("Cards para arquivos, documentos e eventos rastreaveis.", "Cards for files, documents and traceable events."), MediaPreview(), MediaCode),
        new(T("Variacoes de token", "Token variations"), T("Estados visuais derivados dos tokens do tema.", "Visual states derived from theme tokens."), TokenPreview(), TokenCode)
    ];

    private IReadOnlyList<XForgeCategoryOverviewItem> HeroFacts => [
        Item("Objetivo enterprise", "Enterprise objective", "Mostrar alto volume de informacao com hierarquia, leitura rapida e rastreabilidade.", "Show high information volume with hierarchy, quick scanning and traceability.", "chart-bar"),
        Item("Acessibilidade", "Accessibility", "Tabelas, listas, cards e midia precisam manter semantica, foco e estados legiveis.", "Tables, lists, cards and media must preserve semantics, focus and readable states.", "universal-access"),
        Item("Performance", "Performance", "Virtualizacao, carregamento progressivo e dimensoes estaveis sao obrigatorios em superficies densas.", "Virtualization, progressive loading and stable dimensions are required in dense surfaces.", "bolt")
    ];

    private IReadOnlyList<XForgeCategoryOverviewItem> OverviewGoals => [
        Item("Representa dados", "Represents data", "Agrupa componentes que exibem colecoes, midia, documentos, indicadores e historico.", "Groups components that display collections, media, documents, indicators and history.", "table-cells"),
        Item("Existe para padronizar", "Exists to standardize", "Evita que cada modulo ERP invente seu proprio card, tabela, timeline ou visualizacao.", "Prevents each ERP module from inventing its own card, table, timeline or visualization.", "sparkles"),
        Item("Objetivo de UX", "UX goal", "Reduzir carga cognitiva por hierarquia visual, agrupamento e feedback claro.", "Reduce cognitive load through visual hierarchy, grouping and clear feedback.", "eye"),
        Item("Objetivo de arquitetura", "Architecture goal", "Separar apresentacao, templates e fonte de dados sem acoplar regras de dominio.", "Separate presentation, templates and data source without coupling domain rules.", "share-nodes"),
        Item("Objetivo de acessibilidade", "Accessibility goal", "Manter leitura por teclado e leitor de tela em superficies densas.", "Maintain keyboard and screen reader reading in dense surfaces.", "shield-check"),
        Item("Objetivo de performance", "Performance goal", "Controlar listas grandes, midia pesada, graficos e documentos sem bloquear a UI.", "Control large lists, heavy media, charts and documents without blocking the UI.", "gauge")
    ];

    private IReadOnlyList<XForgeCategoryOverviewItem> Philosophy => [
        Item("Clareza antes de ornamento", "Clarity before ornament", "Display deve explicar o estado do negocio sem competir com a tarefa principal.", "Display should explain business state without competing with the main task.", "lightbulb"),
        Item("Consistencia de leitura", "Reading consistency", "Cards, tabelas e listas usam ritmos previsiveis de spacing, borda e tipografia.", "Cards, tables and lists use predictable spacing, border and typography rhythm.", "bars"),
        Item("Responsivo por densidade", "Responsive by density", "Em telas pequenas a informacao empilha; em desktop ela compara e correlaciona.", "On small screens information stacks; on desktop it compares and correlates.", "mobile-screen"),
        Item("Acessivel por padrao", "Accessible by default", "Semantica, headings, captions, labels e foco visivel fazem parte da composicao.", "Semantics, headings, captions, labels and visible focus are part of composition.", "universal-access")
