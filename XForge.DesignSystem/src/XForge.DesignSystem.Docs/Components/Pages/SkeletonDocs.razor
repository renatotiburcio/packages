@page "/feedback/skeleton"
@using XForge.DesignSystem.Core.Primitives
@using XForge.DesignSystem.Components.Feedback.Skeleton
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFSkeleton" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("5 shapes, 2 animacoes", "5 shapes, 2 animations")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Zero JS", "Zero JS")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Placeholder de carregamento com formas, animacoes e acessibilidade.",
                               "Loading placeholder with shapes, animations and accessibility.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("5 shapes, 2 animacoes, 5 tamanhos, tabela skeleton, grupo inline e custom sizing. Puro C# + Tailwind.",
                               "5 shapes, 2 animations, 5 sizes, skeleton table, inline group and custom sizing. Pure C# + Tailwind.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico. Interacoes requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderizacao.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Basico", "1. Basic"), T("Skeleton de texto e retangulo com animacao pulse.", "Text and rectangle skeleton with pulse animation."), ExBasic(), Code1)
            @Example(T("2. Shapes", "2. Shapes"), T("Text, Rectangle, Circle, Avatar e Custom.", "Text, Rectangle, Circle, Avatar and Custom."), ExShapes(), Code2)
            @Example(T("3. Animacoes", "3. Animations"), T("Pulse, Shimmer e None.", "Pulse, Shimmer and None."), ExAnimations(), Code3)
            @Example(T("4. Tamanhos", "4. Sizes"), T("Xs, Sm, Md, Lg e Xl.", "Xs, Sm, Md, Lg and Xl."), ExSizes(), Code4)
            @Example(T("5. SkeletonGroup", "5. SkeletonGroup"), T("Grupo de skeletons com layout inline e grid.", "Skeleton group with inline and grid layout."), ExGroup(), Code5)
            @Example(T("6. SkeletonTable", "6. SkeletonTable"), T("Tabela skeleton com linhas e colunas configuraveis.", "Skeleton table with configurable rows and columns."), ExTable(), Code6)
            @Example(T("7. Custom sizing", "7. Custom sizing"), T("WidthClass, HeightClass e RoundedClass.", "WidthClass, HeightClass and RoundedClass."), ExCustomSizing(), Code7)
            @Example(T("8. Cenario enterprise", "8. Enterprise scenario"), T("Card de usuario com skeleton completo.", "User card with complete skeleton."), ExEnterprise(), Code8)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string ProductLabelText => T("Core Open Source", "Core Open Source");
    private string PageTitleText => T("XFSkeleton", "XFSkeleton");
    private string PageStatusText => T("Documentacao completa", "Complete docs");
    private string T(string pt, string en) => LanguageService.Text(pt, en);
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");

    private RenderFragment HeroPreview() => @<div class="flex flex-col gap-4">
        <div class="flex items-center gap-4">
            <XFSkeleton Shape="XFSkeletonShape.Avatar" Size="XFExtendedSize.Lg" />
            <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                <XFSkeleton Shape="XFSkeletonShape.Text" Size="XFExtendedSize.Sm" WidthClass="w-1/3" />
                <XFSkeleton Shape="XFSkeletonShape.Text" Size="XFExtendedSize.Xs" WidthClass="w-2/3" />
            </XFStack>
        </div>
        <XFSkeleton Shape="XFSkeletonShape.Rectangle" Size="XFExtendedSize.Md" />
        <div class="flex gap-2">
            <XFSkeleton Shape="XFSkeletonShape.Circle" Size="XFExtendedSize.Sm" />
            <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                <XFSkeleton Shape="XFSkeletonShape.Text" Size="XFExtendedSize.Xs" WidthClass="w-full" />
                <XFSkeleton Shape="XFSkeletonShape.Text" Size="XFExtendedSize.Xs" WidthClass="w-3/4" />
            </XFStack>
        </div>
    </div>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("5 shapes", "5 shapes"), T("Text, Rectangle, Circle, Avatar e Custom.", "Text, Rectangle, Circle, Avatar and Custom."), "shapes"),
        new(T("2 animacoes", "2 animations"), T("Pulse (CSS) e Shimmer (gradient).", "Pulse (CSS) and Shimmer (gradient)."), "arrows-rotate"),
        new(T("Zero JS", "Zero JS"), T("Nenhum JavaScript interop. Puro C# + Tailwind.", "No JavaScript interop. Pure C# + Tailwind."), "bolt")
    ];

    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFSkeleton / XFSkeletonGroup / XFSkeletonTable"),
        new("Namespace", "XForge.DesignSystem.Components.Feedback.Skeleton"),
        new("Package", "XForge.DesignSystem"),
        new("Category", "Feedback / Skeleton"),
        new("Status", T("Estavel", "Stable")),
        new("Accessibility", T("aria-hidden=true (decorative), role=status (sem decorative).", "aria-hidden=true (decorative), role=status (without decorative).")),
        new("Theme support", T("Light, dark e data-brand via tokens.", "Light, dark and data-brand via tokens."))
    ];

    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("Placeholder visual", "Visual placeholder"), T("Retangulo ou forma que representa conteudo carregando.", "Rectangle or shape representing loading content."), "square"),
        new(T("Animacao", "Animation"), T("Pulse ou shimmer para feedback de carregamento.", "Pulse or shimmer for loading feedback."), "arrows-rotate"),
        new(T("Grupo e tabela", "Group and table"), T("Composicoes prontas para layouts comuns.", "Ready compositions for common layouts."), "layer-group")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Carregamento de pagina", "Page loading"), T("Skeleton durante carregamento de dados.", "Skeleton during data loading."), "spinner"),
        new(T("Layout shimmer", "Layout shimmer"), T("Efeito visual de shimmer para UX moderna.", "Shimmer visual effect for modern UX."), "sparkles"),
        new(T("Tabela", "Table"), T("Skeleton de tabela com linhas e colunas.", "Table skeleton with rows and columns."), "table")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Spinner generico sem contexto visual.", "Generic spinner without visual context."), "xmark"),
        new(T("Depois", "After"), T("Placeholder que espelha o layout real.", "Placeholder that mirrors real layout."), "check"),
        new(T("Acessibilidade", "Accessibility"), T("aria-hidden para decorativos, role=status para nao decorativos.", "aria-hidden for decorative, role=status for non-decorative."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Carregamento de dados", "Data loading"), T("Enquanto dados estao sendo buscados.", "While data is being fetched."), "database"),
        new(T("Lazy loading", "Lazy loading"), T("Conteudo que carrega progressivamente.", "Content that loads progressively."), "hourglass")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Estado final", "Final state"), T("Nao substitua o conteudo real por skeleton.", "Do not replace real content with skeleton."), "ban"),
        new(T("Skeleton eterno", "Eternal skeleton"), T("Nao deixe skeleton visivel indefinidamente.", "Do not leave skeleton visible indefinitely."), "clock")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new("Shape", T("Forma do skeleton: text, rectangle, circle, avatar, custom.", "Skeleton shape: text, rectangle, circle, avatar, custom."), "shapes"),
        new("Animation", T("Efeito visual: pulse, shimmer ou none.", "Visual effect: pulse, shimmer or none."), "arrows-rotate"),
        new("Size", T("Tamanho pre-definido ou custom via WidthClass/HeightClass.", "Predefined size or custom via WidthClass/HeightClass."), "maximize")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(T("Layout mirror", "Layout mirror"), T("Skeleton deve espelhar o layout do conteudo real.", "Skeleton should mirror real content layout."), "clone"),
        new(T("Animacao sutil", "Subtle animation"), T("Pulse ou shimmer, nunca distraia do conteudo.", "Pulse or shimmer, never distract from content."), "eye"),
        new(T("Acessibilidade", "Accessibility"), T("Decorative = aria-hidden. Nao decorativo = role=status.", "Decorative = aria-hidden. Non-decorative = role=status."), "universal-access")
    ];

    private RenderFragment ExBasic() => @<div class="flex flex-col gap-3 w-full max-w-md">
        <XFSkeleton Shape="XFSkeletonShape.Text" />
        <XFSkeleton Shape="XFSkeletonShape.Text" Size="XFExtendedSize.Sm" WidthClass="w-5/6" />
        <XFSkeleton Shape="XFSkeletonShape.Text" Size="XFExtendedSize.Xs" WidthClass="w-2/3" />
        <XFSkeleton Shape="XFSkeletonShape.Rectangle" Size="XFExtendedSize.Md" />
    </div>;

    private RenderFragment ExShapes() => @<div class="flex flex-wrap items-end gap-5">
        <div class="flex flex-col items-center gap-2">
            <XFSkeleton Shape="XFSkeletonShape.Text" WidthClass="w-32" />
            <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="Text" />
        </div>
        <div class="flex flex-col items-center gap-2">
            <XFSkeleton Shape="XFSkeletonShape.Rectangle" Size="XFExtendedSize.Md" WidthClass="w-32" />
            <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="Rectangle" />
        </div>
        <div class="flex flex-col items-center gap-2">
            <XFSkeleton Shape="XFSkeletonShape.Circle" Size="XFExtendedSize.Lg" />
            <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="Circle" />
        </div>
        <div class="flex flex-col items-center gap-2">
            <XFSkeleton Shape="XFSkeletonShape.Avatar" Size="XFExtendedSize.Xl" />
            <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="Avatar" />
        </div>
        <div class="flex flex-col items-center gap-2">
            <XFSkeleton Shape="XFSkeletonShape.Custom" WidthClass="w-24" HeightClass="h-16" RoundedClass="rounded-xl" />
            <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="Custom" />
        </div>
    </div>;

    private RenderFragment ExAnimations() => @<div class="flex flex-wrap items-end gap-6">
        <div class="flex flex-col items-center gap-2">
            <XFSkeleton Shape="XFSkeletonShape.Rectangle" Animation="XFSkeletonAnimation.Pulse" WidthClass="w-32" HeightClass="h-12" />
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="Pulse" />
        </div>
        <div class="flex flex-col items-center gap-2">
            <XFSkeleton Shape="XFSkeletonShape.Rectangle" Animation="XFSkeletonAnimation.Shimmer" WidthClass="w-32" HeightClass="h-12" />
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="Shimmer" />
        </div>
        <div class="flex flex-col items-center gap-2">
            <XFSkeleton Shape="XFSkeletonShape.Rectangle" Animation="XFSkeletonAnimation.None" WidthClass="w-32" HeightClass="h-12" />
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="None" />
        </div>
    </div>;

    private RenderFragment ExSizes() => @<div class="flex flex-wrap items-end gap-4">
        <div class="flex flex-col items-center gap-2">
            <XFSkeleton Shape="XFSkeletonShape.Avatar" Size="XFExtendedSize.Xs" />
            <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="Xs" />
        </div>
        <div class="flex flex-col items-center gap-2">
            <XFSkeleton Shape="XFSkeletonShape.Avatar" Size="XFExtendedSize.Sm" />
            <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="Sm" />
        </div>
        <div class="flex flex-col items-center gap-2">
            <XFSkeleton Shape="XFSkeletonShape.Avatar" Size="XFExtendedSize.Md" />
            <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="Md" />
        </div>
        <div class="flex flex-col items-center gap-2">
            <XFSkeleton Shape="XFSkeletonShape.Avatar" Size="XFExtendedSize.Lg" />
            <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="Lg" />
        </div>
        <div class="flex flex-col items-center gap-2">
            <XFSkeleton Shape="XFSkeletonShape.Avatar" Size="XFExtendedSize.Xl" />
            <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="Xl" />
        </div>
    </div>;

    private RenderFragment ExGroup() => @<div class="flex flex-col gap-6">
        <div class="flex flex-col gap-2">
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Inline", "Inline")" />
            <XFSkeletonGroup Inline="true" GapClass="gap-4">
                <XFSkeleton Shape="XFSkeletonShape.Avatar" Size="XFExtendedSize.Sm" />
                <XFSkeleton Shape="XFSkeletonShape.Text" WidthClass="w-48" />
            </XFSkeletonGroup>
        </div>
        <div class="flex flex-col gap-2">
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Grid", "Grid")" />
            <XFSkeletonGroup GapClass="gap-3">
                <XFSkeleton Shape="XFSkeletonShape.Rectangle" Size="XFExtendedSize.Md" />
                <div class="flex gap-3">
                    <XFSkeleton Shape="XFSkeletonShape.Circle" Size="XFExtendedSize.Sm" />
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFSkeleton Shape="XFSkeletonShape.Text" WidthClass="w-1/2" />
                        <XFSkeleton Shape="XFSkeletonShape.Text" Size="XFExtendedSize.Xs" WidthClass="w-3/4" />
                    </XFStack>
                </div>
            </XFSkeletonGroup>
        </div>
    </div>;

    private RenderFragment ExTable() => @<div class="flex flex-col gap-3">
        <div class="flex gap-3">
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="Default (4x4)" />
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="Compact (3x3)" />
        </div>
        <div class="grid gap-6 sm:grid-cols-2">
            <XFSkeletonTable Rows="4" Columns="4" />
            <XFSkeletonTable Rows="3" Columns="3" Compact="true" />
        </div>
    </div>;

    private RenderFragment ExCustomSizing() => @<div class="flex flex-wrap items-end gap-4">
        <div class="flex flex-col items-center gap-2">
            <XFSkeleton Shape="XFSkeletonShape.Custom" WidthClass="w-40" HeightClass="h-10" RoundedClass="rounded-lg" />
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">w-40 h-10 rounded-lg</XFTypography>
        </div>
        <div class="flex flex-col items-center gap-2">
            <XFSkeleton Shape="XFSkeletonShape.Custom" WidthClass="w-24" HeightClass="h-24" RoundedClass="rounded-2xl" />
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">w-24 h-24 rounded-2xl</XFTypography>
        </div>
        <div class="flex flex-col items-center gap-2">
            <XFSkeleton Shape="XFSkeletonShape.Custom" WidthClass="w-16" HeightClass="h-8" RoundedClass="rounded-full" />
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">w-16 h-8 rounded-full</XFTypography>
        </div>
    </div>;

    private RenderFragment ExEnterprise() => @<div class="overflow-hidden rounded-lg border border-border-light bg-bg-surface shadow-sm">
        <div class="flex items-center justify-between border-b border-border-light bg-surface-50/80 px-5 py-3">
            <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@T("Card de usuario com skeleton", "User card with skeleton")</XFTypography>
        </div>
        <div class="grid gap-6 p-6 sm:grid-cols-2">
            <div class="flex flex-col gap-4 rounded-lg border border-border-light bg-bg-surface p-4">
                <div class="flex items-center gap-3">
                    <XFSkeleton Shape="XFSkeletonShape.Avatar" Size="XFExtendedSize.Lg" />
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFSkeleton Shape="XFSkeletonShape.Text" WidthClass="w-1/2" />
                        <XFSkeleton Shape="XFSkeletonShape.Text" Size="XFExtendedSize.Xs" WidthClass="w-2/3" />
                    </XFStack>
                </div>
                <XFSkeleton Shape="XFSkeletonShape.Text" WidthClass="w-full" />
                <XFSkeleton Shape="XFSkeletonShape.Text" Size="XFExtendedSize.Xs" WidthClass="w-3/4" />
            </div>
            <div class="flex flex-col gap-3 rounded-lg border border-border-light bg-bg-surface p-4">
                <XFSkeleton Shape="XFSkeletonShape.Text" Size="XFExtendedSize.Sm" WidthClass="w-1/3" />
                <XFSkeleton Shape="XFSkeletonShape.Rectangle" Size="XFExtendedSize.Sm" />
                <div class="flex gap-2">
                    <XFSkeleton Shape="XFSkeletonShape.Rectangle" WidthClass="w-16" HeightClass="h-8" RoundedClass="rounded" />
                    <XFSkeleton Shape="XFSkeletonShape.Rectangle" WidthClass="w-16" HeightClass="h-8" RoundedClass="rounded" />
                </div>
            </div>
        </div>
    </div>;

    private const string Code1 = @"<XFSkeleton Shape=""XFSkeletonShape.Text"" />
