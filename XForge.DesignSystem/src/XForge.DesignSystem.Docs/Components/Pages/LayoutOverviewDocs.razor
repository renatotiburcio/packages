                    <XFBadge Text="Overview" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" />
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">AppShell</XFTypography>
