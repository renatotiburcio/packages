                </XFStack>
                <XFStack Orientation="XFOrientation.Vertical" Gap="3" Class="p-4" FullWidth="true">
                    <XFGrid Cols="1" Sm="3" Gap="3">
                        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Md"><ChildContent><XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">Receita</XFTypography><XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">R$ 842k</XFTypography></ChildContent></XFCard>
                        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Md"><ChildContent><XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">Pedidos</XFTypography><XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">1.284</XFTypography></ChildContent></XFCard>
                        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Md"><ChildContent><XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">Risco</XFTypography><XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">Baixo</XFTypography></ChildContent></XFCard>
                    </XFGrid>
                    <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Md"><ChildContent><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">Area principal com scroll e conteudo previsivel.</XFTypography></ChildContent></XFCard>
                </XFStack>
            </XFStack>
        </XFGrid>
    </div>;

    private static RenderFragment ShellPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
