                    <div class="grid h-10 w-10 place-items-center rounded-lg bg-white/20 font-bold">XF</div>
                    <div class="grid h-9 w-9 place-items-center rounded-lg bg-white/25">@XFSvgIcons.MarkupWithSize("house", 16)</div>
                    <div class="grid h-9 w-9 place-items-center rounded-lg text-white/70">@XFSvgIcons.MarkupWithSize("table-cells", 16)</div>
                    <div class="grid h-9 w-9 place-items-center rounded-lg text-white/70">@XFSvgIcons.MarkupWithSize("sliders", 16)</div>
                </XFStack>
