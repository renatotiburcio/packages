                    <XFBadge Text="Main: conteudo" Color="XFBadgeColor.Primary" />
                    <XFBadge Text="Footer: status" Color="XFBadgeColor.Neutral" />
                </XFGrid>
            </ChildContent>
        </XFCard>
    </XFStack>;

    private static RenderFragment ResponsiveGridPreview() => @<XFGrid Cols="1" Md="3" Gap="4">
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">KPI</XFTypography><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">Coluna responsiva.</XFTypography></ChildContent></XFCard>
