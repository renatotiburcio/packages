@page "/layout/splitter"
@using XForge.DesignSystem.Components.Layout.Splitter
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        @* ==================== HEADER ==================== *@
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFSplitter" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Painéis redimensionáveis", "Resizable panels")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("JS Interop", "JS Interop")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Master-detail", "Master-detail")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Divisores redimensionáveis para painéis, editores, dashboards e workspaces.",
                               "Resizable dividers for panels, editors, dashboards and workspaces.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("XFSplitter divide a área em dois painéis com divisor arrastável. Suporta orientação horizontal e vertical, tamanho min/max/step, colapso, estado controlado via PrimarySizeChanged e Change, além de interop JS para posicionamento e teclado.",
                               "XFSplitter divides the area into two panels with a draggable divider. It supports horizontal and vertical orientation, min/max/step size, collapse, controlled state via PrimarySizeChanged and Change, plus JS interop for positioning and keyboard.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">@HeroPreview()</div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">@foreach (var item in QuickFacts) { @Tile(item) }</XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @* ==================== 1. METADATA ==================== *@
        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @* ==================== 2. BLAZOR SERVER / WASM ==================== *@
        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observações", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona com prerender-safe guards.", "Works with prerender-safe guards.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona com prerender-safe guards no primeiro render.", "Works with prerender-safe guards on first render.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Parcial", "Partial")" /></XFTableCell><XFTableCell>@T("Renderiza HTML base. Divisor arrastável indisponível durante prerender.", "Renders base HTML. Draggable divider unavailable during prerender.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("JS Interop", "JS Interop")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Arquivo JS: xf-splitter.js — gerencia xfSplitter.register/release, drag do divisor, teclado (arrow keys/Home/End) e posicionamento.", "JS file: xf-splitter.js — manages xfSplitter.register/release, divider drag, keyboard (arrow keys/Home/End) and positioning.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Quando carrega: OnAfterRenderAsync (firstRender).", "When loaded: OnAfterRenderAsync (firstRender).")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Prerender seguro: try/catch para InvalidOperationException e JSDisconnectedException.", "Prerender safe: try/catch for InvalidOperationException and JSDisconnectedException.")</XFTypography>
                </XFStack>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Considerações Blazor Server", "Blazor Server Considerations")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("JS interop via SignalR com latência. Drag do divisor pode ter resposta mais lenta.", "JS interop via SignalR with latency. Divider drag may have slower response.")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Considerações Blazor WebAssembly", "Blazor WebAssembly Considerations")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("JS interop direto sem latência de rede. Disponível após carregamento do WASM.", "Direct JS interop with no network latency. Available after WASM load.")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Exemplos de uso", "Usage Examples")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFCode Text="@InteractiveServerExample" Language="razor" Title="InteractiveServer" Variant="XFCodeVariant.Block" Copyable="true" />
                    <XFCode Text="@InteractiveWasmExample" Language="razor" Title="InteractiveWebAssembly" Variant="XFCodeVariant.Block" Copyable="true" />
                    <XFCode Text="@InteractiveAutoExample" Language="razor" Title="InteractiveAuto" Variant="XFCodeVariant.Block" Copyable="true" />
                </XFStack>
            </XFStack>
        </div>)

        @* ==================== 3. OVERVIEW ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visão geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Propósito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando não usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 2)</div>)
        </XFStack>

        @* ==================== 4. VARIANTS & STATES ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Variantes", "Variants"), @<div>@NameValueTable(VariantRows, T("Variante", "Variant"), T("Caso de uso", "Use case"))</div>)
            @Section(T("Estados", "States"), @<div>@NameValueTable(StateRows, T("Estado", "State"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        @* ==================== 5. VISUAL HIERARCHY & DESIGN ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Hierarquia visual", "Visual Hierarchy"), @<div>@TileGrid(VisualHierarchyItems, 3)</div>)
            @Section(T("Princípios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        @* ==================== 6-14. EXAMPLES ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Splitter horizontal básico", "1. Basic horizontal splitter"),
                T("Dois painéis lado a lado com divisor arrastável.", "Two panels side by side with draggable divider."),
                BasicPreview(), BasicCode)

            @Example(T("2. Splitter vertical", "2. Vertical splitter"),
                T("Painéis empilhados verticalmente com divisor horizontal.", "Vertically stacked panels with horizontal divider."),
                VerticalPreview(), VerticalCode)

            @Example(T("3. Splitter com PrimarySize controlado", "3. Controlled PrimarySize"),
                T("PrimarySize=30 com o painel primário menor.", "PrimarySize=30 with a smaller primary panel."),
                PrimarySizePreview(), PrimarySizeCode)

            @Example(T("4. Splitter com Min/Max configurado", "4. Configurable Min/Max"),
                T("Limites de 20% a 60% para evitar painéis extremos.", "20% to 60% limits to prevent extreme panels."),
                MinMaxPreview(), MinMaxCode)

            @Example(T("5. Splitter Collapsed (secundário)", "5. Collapsed secondary"),
                T("Painel secundário colapsado, primário ocupa tudo.", "Secondary panel collapsed, primary fills all."),
                CollapsedPreview(), CollapsedCode)

            @Example(T("6. Splitter CollapsePrimary", "6. CollapsePrimary"),
                T("Painel primário colapsado via CollapsePrimary=true.", "Primary panel collapsed via CollapsePrimary=true."),
                CollapsePrimaryPreview(), CollapsePrimaryCode)

            @Example(T("7. Splitter com Step customizado", "7. Custom Step"),
                T("Step=5 para movimento mais rápido por teclado.", "Step=5 for faster keyboard movement."),
                StepPreview(), StepCode)

            @Example(T("8. Splitter master-detail enterprise", "8. Enterprise master-detail"),
                T("Lista de pedidos à esquerda, detalhe à direita.", "Order list on left, detail on right."),
                MasterDetailPreview(), MasterDetailCode)

            @Example(T("9. Splitter com evento Change", "9. Splitter with Change event"),
                T("Change com XFSplitterChangedEventArgs para ações.", "Change with XFSplitterChangedEventArgs for actions."),
                ChangeEventPreview(), ChangeEventCode)
        </XFStack>

        @* ==================== 16. API ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Métodos", "Methods"), @<div>@NameValueTable(MethodRows, T("Método", "Method"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        @* ==================== 17. ACCESSIBILITY & KEYBOARD ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Navegação enterprise por teclado", "Enterprise Keyboard Navigation"), @<div>@TileGrid(EnterpriseKeyboardItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        @* ==================== 18. RESPONSIVENESS & PERFORMANCE ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        @* ==================== 19. ENTERPRISE SCENARIOS & PATTERNS ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenários enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padrões de composição", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Exemplos de integração", "Integration Examples"), @<div>@TileGrid(IntegrationItems, 2)</div>)
            @Section(T("Boas práticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padrões", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        @* ==================== 20. TOKENS, THEMING, SECURITY, TESTING ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("Design Tokens", @<div>@NameValueTable(TokenRows, "Token", T("Propósito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Segurança", "Security Considerations"), @<div>@TileGrid(SecurityItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidência", "Evidence"))</div>)
        </XFStack>

        @* ==================== EXTRA: LIMITATIONS, MIGRATION, RELATED, FAQ, CHANGELOG ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Limitações conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitação", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Notas de migração", "Migration Notes"), @<div>@TileGrid(MigrationItems, 2)</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versão", "Version"), T("Mudança", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string ProductLabelText => T("Core Open Source", "Core Open Source");
    private string PageTitleText => T("Splitter", "Splitter");
    private string PageStatusText => T("Documentação completa", "Complete docs");
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);

    // ==================== BLAZOR SECTION EXAMPLES ====================
    private string InteractiveServerExample => @"@page ""/erp/financeiro/pedidos""
@rendermode InteractiveServer
<XFSplitter>
    <PrimaryContent><div class=""p-4"">Lista</div></PrimaryContent>
    <SecondaryContent><div class=""p-4"">Detalhe</div></SecondaryContent>
</XFSplitter>";

    private string InteractiveWasmExample => @"@page ""/erp/financeiro/pedidos""
@rendermode InteractiveWebAssembly
<XFSplitter>
    <PrimaryContent><div class=""p-4"">Lista</div></PrimaryContent>
    <SecondaryContent><div class=""p-4"">Detalhe</div></SecondaryContent>
</XFSplitter>";

    private string InteractiveAutoExample => @"@page ""/erp/financeiro/pedidos""
@rendermode InteractiveAuto
<XFSplitter>
    <PrimaryContent><div class=""p-4"">Lista</div></PrimaryContent>
    <SecondaryContent><div class=""p-4"">Detalhe</div></SecondaryContent>
</XFSplitter>";

    // ==================== HERO PREVIEW ====================
    private RenderFragment HeroPreview() => @<div class="h-56 overflow-hidden rounded-lg border border-border-light">
        <XFSplitter PrimarySize="40">
            <PrimaryContent><div class="h-full bg-surface-50 p-4"><XFTypography Weight="XFTypographyWeight.Bold">@T("Lista", "List")</XFTypography><div class="mt-2 text-sm text-text-secondary">@T("Pedidos do dia", "Today orders")</div></div></PrimaryContent>
            <SecondaryContent><div class="h-full bg-bg-surface p-4"><XFTypography Weight="XFTypographyWeight.Bold">@T("Detalhe", "Detail")</XFTypography><div class="mt-2 text-sm text-text-secondary">@T("Selecione um pedido", "Select an order")</div></div></SecondaryContent>
        </XFSplitter>
    </div>;

    // ==================== EXAMPLE PREVIEWS ====================
    private RenderFragment BasicPreview() => @<div class="h-48 overflow-hidden rounded-lg border border-border-light">
        <XFSplitter>
            <PrimaryContent><div class="h-full bg-surface-50 p-4 text-sm">@T("Painel primário", "Primary panel")</div></PrimaryContent>
            <SecondaryContent><div class="h-full bg-bg-surface p-4 text-sm">@T("Painel secundário", "Secondary panel")</div></SecondaryContent>
        </XFSplitter>
    </div>;

    private RenderFragment VerticalPreview() => @<div class="h-56 overflow-hidden rounded-lg border border-border-light">
        <XFSplitter Orientation="XFOrientation.Vertical" PrimarySize="40">
            <PrimaryContent><div class="h-full bg-surface-50 p-4 text-sm">@T("Painel superior", "Top panel")</div></PrimaryContent>
            <SecondaryContent><div class="h-full bg-bg-surface p-4 text-sm">@T("Painel inferior", "Bottom panel")</div></SecondaryContent>
        </XFSplitter>
    </div>;

    private RenderFragment PrimarySizePreview() => @<div class="h-48 overflow-hidden rounded-lg border border-border-light">
        <XFSplitter PrimarySize="30">
            <PrimaryContent><div class="h-full bg-surface-50 p-4 text-sm">@T("30%", "30%")</div></PrimaryContent>
            <SecondaryContent><div class="h-full bg-bg-surface p-4 text-sm">@T("70%", "70%")</div></SecondaryContent>
        </XFSplitter>
    </div>;

    private RenderFragment MinMaxPreview() => @<div class="h-48 overflow-hidden rounded-lg border border-border-light">
        <XFSplitter PrimarySize="40" Min="20" Max="60">
            <PrimaryContent><div class="h-full bg-surface-50 p-4 text-sm">@T("Mín 20% • Máx 60%", "Min 20% • Max 60%")</div></PrimaryContent>
            <SecondaryContent><div class="h-full bg-bg-surface p-4 text-sm">@T("Painel ajustável", "Adjustable panel")</div></SecondaryContent>
        </XFSplitter>
    </div>;

    private RenderFragment CollapsedPreview() => @<div class="h-48 overflow-hidden rounded-lg border border-border-light">
        <XFSplitter Collapsed="true">
            <PrimaryContent><div class="h-full bg-surface-50 p-4 text-sm">@T("Único painel visível", "Only visible panel")</div></PrimaryContent>
            <SecondaryContent><div class="h-full bg-bg-surface p-4 text-sm">@T("Colapsado", "Collapsed")</div></SecondaryContent>
        </XFSplitter>
    </div>;

    private RenderFragment CollapsePrimaryPreview() => @<div class="h-48 overflow-hidden rounded-lg border border-border-light">
        <XFSplitter Collapsed="true" CollapsePrimary="true">
            <PrimaryContent><div class="h-full bg-surface-50 p-4 text-sm">@T("Colapsado", "Collapsed")</div></PrimaryContent>
            <SecondaryContent><div class="h-full bg-bg-surface p-4 text-sm">@T("Único painel visível", "Only visible panel")</div></SecondaryContent>
        </XFSplitter>
    </div>;

    private RenderFragment StepPreview() => @<div class="h-48 overflow-hidden rounded-lg border border-border-light">
        <XFSplitter PrimarySize="50" Step="5">
            <PrimaryContent><div class="h-full bg-surface-50 p-4 text-sm">@T("Step=5", "Step=5")</div></PrimaryContent>
            <SecondaryContent><div class="h-full bg-bg-surface p-4 text-sm">@T("Movimento rápido por teclado", "Fast keyboard movement")</div></SecondaryContent>
        </XFSplitter>
    </div>;

    private RenderFragment MasterDetailPreview() => @<div class="h-56 overflow-hidden rounded-lg border border-border-light">
        <XFSplitter PrimarySize="35" Min="25" Max="50">
            <PrimaryContent><div class="h-full bg-surface-50 p-3 text-sm space-y-1"><div class="rounded bg-primary/10 px-2 py-1.5 text-primary font-semibold text-xs">@T("Pedido #1042", "Order #1042")</div><div class="px-2 py-1.5 text-text-secondary text-xs">@T("Pedido #1041", "Order #1041")</div><div class="px-2 py-1.5 text-text-secondary text-xs">@T("Pedido #1040", "Order #1040")</div></div></PrimaryContent>
            <SecondaryContent><div class="h-full bg-bg-surface p-4"><XFTypography Weight="XFTypographyWeight.Bold" Variant="XFTypographyVariant.Body1">@T("Pedido #1042", "Order #1042")</XFTypography><div class="mt-2 text-xs text-text-secondary space-y-1"><div>@T("Cliente: João Silva", "Customer: John Doe")</div><div>@T("Valor: R$ 1.247,00", "Amount: $ 1,247.00")</div><div>@T("Status: Em aprovação", "Status: Pending approval")</div></div></div></SecondaryContent>
        </XFSplitter>
    </div>;

    private RenderFragment ChangeEventPreview() => @<div class="h-48 overflow-hidden rounded-lg border border-border-light">
        <XFSplitter PrimarySize="50">
            <PrimaryContent><div class="h-full bg-surface-50 p-4 text-sm">@T("Arraste o divisor", "Drag the divider")</div></PrimaryContent>
            <SecondaryContent><div class="h-full bg-bg-surface p-4 text-sm">@T("O evento Change dispara", "The Change event fires")</div></SecondaryContent>
        </XFSplitter>
    </div>;

    // ==================== CODE STRINGS ====================
    private string BasicCode => T("""
<XFSplitter>
    <PrimaryContent>
        <div class="p-4">Painel primário</div>
    </PrimaryContent>
    <SecondaryContent>
        <div class="p-4">Painel secundário</div>
    </SecondaryContent>
</XFSplitter>
""", """
<XFSplitter>
    <PrimaryContent>
        <div class="p-4">Primary panel</div>
    </PrimaryContent>
    <SecondaryContent>
        <div class="p-4">Secondary panel</div>
    </SecondaryContent>
</XFSplitter>
""");

    private string VerticalCode => T("""
<XFSplitter Orientation="XFOrientation.Vertical" PrimarySize="40">
    <PrimaryContent>
        <div class="p-4">Painel superior</div>
    </PrimaryContent>
    <SecondaryContent>
        <div class="p-4">Painel inferior</div>
    </SecondaryContent>
</XFSplitter>
""", """
<XFSplitter Orientation="XFOrientation.Vertical" PrimarySize="40">
    <PrimaryContent>
        <div class="p-4">Top panel</div>
    </PrimaryContent>
    <SecondaryContent>
        <div class="p-4">Bottom panel</div>
    </SecondaryContent>
</XFSplitter>
""");

    private string PrimarySizeCode => T("""
<XFSplitter PrimarySize="30">
    <PrimaryContent><div class="p-4">30%</div></PrimaryContent>
    <SecondaryContent><div class="p-4">70%</div></SecondaryContent>
</XFSplitter>
""", """
<XFSplitter PrimarySize="30">
    <PrimaryContent><div class="p-4">30%</div></PrimaryContent>
    <SecondaryContent><div class="p-4">70%</div></SecondaryContent>
</XFSplitter>
""");

    private string MinMaxCode => T("""
<XFSplitter PrimarySize="40" Min="20" Max="60">
    <PrimaryContent><div class="p-4">Painel com limites</div></PrimaryContent>
    <SecondaryContent><div class="p-4">Painel ajustável</div></SecondaryContent>
</XFSplitter>
""", """
<XFSplitter PrimarySize="40" Min="20" Max="60">
    <PrimaryContent><div class="p-4">Panel with limits</div></PrimaryContent>
    <SecondaryContent><div class="p-4">Adjustable panel</div></SecondaryContent>
</XFSplitter>
""");

    private string CollapsedCode => T("""
<XFSplitter Collapsed="true">
    <PrimaryContent><div class="p-4">Visível</div></PrimaryContent>
    <SecondaryContent><div class="p-4">Colapsado</div></SecondaryContent>
</XFSplitter>
""", """
<XFSplitter Collapsed="true">
    <PrimaryContent><div class="p-4">Visible</div></PrimaryContent>
    <SecondaryContent><div class="p-4">Collapsed</div></SecondaryContent>
</XFSplitter>
""");

    private string CollapsePrimaryCode => T("""
<XFSplitter Collapsed="true" CollapsePrimary="true">
    <PrimaryContent><div class="p-4">Colapsado</div></PrimaryContent>
    <SecondaryContent><div class="p-4">Visível</div></SecondaryContent>
</XFSplitter>
""", """
<XFSplitter Collapsed="true" CollapsePrimary="true">
    <PrimaryContent><div class="p-4">Collapsed</div></PrimaryContent>
    <SecondaryContent><div class="p-4">Visible</div></SecondaryContent>
</XFSplitter>
""");

