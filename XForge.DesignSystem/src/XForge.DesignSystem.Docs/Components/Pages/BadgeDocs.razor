@page "/components/badge"
@page "/display/badges"
@using XForge.DesignSystem.Core.Primitives
@using Microsoft.AspNetCore.Components.Web

@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFBadge" Size="XFBadgeSize.Md" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("5 variantes", "5 variants")" Size="XFBadgeSize.Md" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("7 cores", "7 colors")" Size="XFBadgeSize.Md" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Enterprise", "Enterprise")" Size="XFBadgeSize.Md" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Marcadores compactos para status, metadados e filtros.", "Compact markers for status, metadata and filters.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("5 variantes, 7 cores, 4 tamanhos, 3 formas, dot, icones, dismiss e acessibilidade completa sem CSS local.",
                               "5 variants, 7 colors, 4 sizes, 3 shapes, dot, icons, dismiss and full accessibility without local CSS.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico. Interacoes requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderizacao.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Consideracoes", "Considerations")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor Server: eventos sao tratados via SignalR. Sem latencia adicional para componentes puramente renderizados.", "Blazor Server: events are handled via SignalR. No additional latency for purely rendered components.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor WebAssembly: eventos sao tratados diretamente no cliente. Mais responsivo.", "Blazor WebAssembly: events are handled directly on the client. More responsive.")</XFTypography>
                </XFStack>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Basico", "1. Basic"),
                T("Badges com configuracao padrao (Soft/Info) e variantes explicitas.", "Badges with default config (Soft/Info) and explicit variants."),
                ExBasico(), CodeBasico)

            @Example(T("2. Tamanhos", "2. Sizes"),
                T("Xs, Sm, Md e Lg — todos com tamanho explicito. D-055.", "Xs, Sm, Md and Lg — all with explicit size. D-055."),
                ExTamanhos(), CodeTamanhos)

            @Example(T("3. Cores", "3. Colors"),
                T("7 cores semanticas com variante Soft.", "7 semantic colors with Soft variant."),
                ExCores(), CodeCores)

            @Example(T("4. Formas", "4. Shapes"),
                T("Rounded, Pill e Circle com AriaLabel.", "Rounded, Pill and Circle with AriaLabel."),
                ExFormas(), CodeFormas)

            @Example(T("5. Estilos", "5. Variants"),
                T("Solid, Outline, Soft, Subtle e Ghost.", "Solid, Outline, Soft, Subtle and Ghost."),
                ExEstilos(), CodeEstilos)

            @Example(T("6. Dot e icones", "6. Dot and icons"),
                T("Dot semantico, StartIcon, EndIcon e DismissIcon.", "Semantic dot, StartIcon, EndIcon and DismissIcon."),
                ExDotIcones(), CodeDotIcones)

            @Example(T("7. Dismiss", "7. Dismissible"),
                T("OnDismiss, AriaLabel, Title format e callback.", "OnDismiss, AriaLabel, Title format and callback."),
                ExDismiss(), CodeDismiss)

            @Example(T("8. Interativo", "8. Interactive"),
                T("OnClick com role=button automatico e suporte a teclado.", "OnClick with automatic role=button and keyboard support."),
                ExInterativo(), CodeInterativo)

            @Example(T("9. Templates", "9. Templates"),
                T("ChildContent para conteudo customizado dentro do badge.", "ChildContent for custom content inside the badge."),
                ExTemplates(), CodeTemplates)

            @Example(T("10. Toggles", "10. Feature toggles"),
                T("Dot, Circle e Variant+Shape em combinacao.", "Dot, Circle and Variant+Shape in combination."),
                ExToggles(), CodeToggles)

            @Example(T("11. Responsivo", "11. Responsive"),
                T("Badges em containers restritos com wrapping.", "Badges in constrained containers with wrapping."),
                ExResponsivo(), CodeResponsivo)

            @Example(T("12. Cenario enterprise", "12. Enterprise scenario"),
                T("Tabela ERP de contas a pagar com badges de status.", "ERP accounts payable table with status badges."),
                ExEnterprise(), CodeEnterprise)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string ProductLabelText => T("Core Open Source", "Core Open Source");
    private string PageTitleText => "Badge";
    private string PageStatusText => T("Documentacao completa", "Complete docs");
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);

    private string dismissed = "none";
    private string clicked = "none";

    // ─── Hero ───
    private string InvoiceBadgeText => $"5 {T("contas", "records")}";

    private RenderFragment HeroPreview() => @<div class="flex flex-col gap-4">
        <div class="overflow-hidden rounded-lg border border-border-light bg-bg-surface">
            <div class="flex items-center justify-between border-b border-border-light bg-surface-50/80 px-5 py-3">
                <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@T("Contas a Receber — Maio 2026", "Accounts Receivable — May 2026")</XFTypography>
                <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@InvoiceBadgeText" Size="XFBadgeSize.Md" />
            </div>
            <div class="divide-y divide-border-light/40">
                @foreach (var row in HeroRows) {
                    <div class="flex items-center justify-between px-5 py-3">
                        <div class="flex flex-col gap-0.5">
                            <XFTypography Variant="XFTypographyVariant.Body2" Weight="XFTypographyWeight.Medium">@row[0]</XFTypography>
                            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@row[1]</XFTypography>
                        </div>
                        <div class="flex items-center gap-3">
                            <XFTypography Variant="XFTypographyVariant.Body2" Weight="XFTypographyWeight.Semibold">R$ @row[2]</XFTypography>
                            @if (row[3] == "Pago") { <XFBadge Text="@T("Pago", "Paid")" Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Success" Size="XFBadgeSize.Md" /> }
                            else if (row[3] == "Pendente") { <XFBadge Text="@T("Pendente", "Pending")" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Size="XFBadgeSize.Md" Dot="true" /> }
                            else if (row[3] == "Vencido") { <XFBadge Text="@T("Vencido", "Overdue")" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Danger" Size="XFBadgeSize.Md" /> }
                            else { <XFBadge Text="@T("Conciliado", "Reconciled")" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Size="XFBadgeSize.Md" /> }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>;

    private List<string[]> HeroRows => new() {
        new[] { T("Silva Comercio LTDA", "Silva Commerce Ltd"), "NF 001.234", "12.450,00", "Pago" },
        new[] { T("Tech Solutions S.A.", "Tech Solutions Inc"), "NF 001.235", "8.320,00", "Pago" },
        new[] { T("Distribuidora ABC", "ABC Distributors"), "NF 001.236", "3.100,00", "Pendente" },
        new[] { T("Farmacia Central", "Central Pharmacy"), "NF 001.237", "15.780,00", "Vencido" },
        new[] { T("Supermercado Bom Preco", "Good Price Market"), "NF 001.238", "22.100,00", "Pendente" }
    };

    // ─── Event handlers ───
    private Task OnBadgeClick(MouseEventArgs args) { clicked = T("Clicado", "Clicked"); return Task.CompletedTask; }
    private Task OnBadgeDismiss(MouseEventArgs args) { dismissed = T("Removido", "Removed"); return Task.CompletedTask; }

    // ─── 1. Basic ───
    private RenderFragment ExBasico() => @<div class="flex flex-wrap gap-3">
        <XFBadge Text="@T("Status", "Status")" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Size="XFBadgeSize.Md" />
        <XFBadge Text="@T("Ativo", "Active")" Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Success" Size="XFBadgeSize.Md" />
        <XFBadge Text="@T("Critico", "Critical")" Variant="XFBadgeVariant.Outline" Color="XFBadgeColor.Danger" Size="XFBadgeSize.Md" />
    </div>;

    // ─── 2. Sizes ───
    private RenderFragment ExTamanhos() => @<div class="flex flex-col gap-4">
        <div class="flex flex-wrap items-center gap-3">
            <XFBadge Text="XS" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Size="XFBadgeSize.Xs" />
            <XFBadge Text="SM" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Size="XFBadgeSize.Sm" />
            <XFBadge Text="MD" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Size="XFBadgeSize.Md" />
            <XFBadge Text="LG" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Size="XFBadgeSize.Lg" />
        </div>
        <div class="flex flex-wrap items-center gap-3">
            <XFBadge Text="@T("Pendente", "Pending")" Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Warning" Size="XFBadgeSize.Xs" />
            <XFBadge Text="@T("Aprovado", "Approved")" Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Success" Size="XFBadgeSize.Sm" />
            <XFBadge Text="@T("Pago", "Paid")" Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Success" Size="XFBadgeSize.Md" />
            <XFBadge Text="@T("Urgente", "Urgent")" Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Danger" Size="XFBadgeSize.Lg" />
        </div>
    </div>;

    // ─── 3. Colors ───
    private RenderFragment ExCores() => @<div class="flex flex-wrap gap-3">
        <XFBadge Text="Primary" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Primary" Size="XFBadgeSize.Md" />
        <XFBadge Text="Secondary" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Secondary" Size="XFBadgeSize.Md" />
        <XFBadge Text="Success" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Size="XFBadgeSize.Md" />
        <XFBadge Text="Warning" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Size="XFBadgeSize.Md" />
        <XFBadge Text="Danger" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Danger" Size="XFBadgeSize.Md" />
        <XFBadge Text="Info" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Size="XFBadgeSize.Md" />
        <XFBadge Text="Neutral" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Neutral" Size="XFBadgeSize.Md" />
    </div>;

    // ─── 4. Shapes ───
    private RenderFragment ExFormas() => @<div class="flex flex-wrap items-center gap-3">
        <XFBadge Text="@T("Rounded", "Rounded")" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Primary" Size="XFBadgeSize.Md" Shape="XFBadgeShape.Rounded" />
        <XFBadge Text="@T("Pill", "Pill")" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Primary" Size="XFBadgeSize.Md" Shape="XFBadgeShape.Pill" />
        <XFBadge Text="7" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Primary" Size="XFBadgeSize.Md" Shape="XFBadgeShape.Circle" AriaLabel="@T("Sete pendencias", "Seven pending items")" />
    </div>;

    // ─── 5. Variants ───
    private RenderFragment ExEstilos() => @<div class="flex flex-wrap gap-3">
        <XFBadge Text="Solid" Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Size="XFBadgeSize.Md" />
        <XFBadge Text="Outline" Variant="XFBadgeVariant.Outline" Color="XFBadgeColor.Primary" Size="XFBadgeSize.Md" />
        <XFBadge Text="Soft" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Primary" Size="XFBadgeSize.Md" />
        <XFBadge Text="Subtle" Variant="XFBadgeVariant.Subtle" Color="XFBadgeColor.Primary" Size="XFBadgeSize.Md" />
        <XFBadge Text="Ghost" Variant="XFBadgeVariant.Ghost" Color="XFBadgeColor.Primary" Size="XFBadgeSize.Md" />
    </div>;

    // ─── 6. Dot and Icons ───
    private RenderFragment ExDotIcones() => @<div class="flex flex-col gap-4">
        <div class="flex flex-wrap gap-3">
            <XFBadge Text="@T("Online", "Online")" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Size="XFBadgeSize.Md" Dot="true" />
            <XFBadge Text="@T("Offline", "Offline")" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Neutral" Size="XFBadgeSize.Md" Dot="true" />
            <XFBadge Text="@T("Erro", "Error")" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Danger" Size="XFBadgeSize.Md" Dot="true" />
        </div>
        <div class="flex flex-wrap gap-3">
            <XFBadge Text="@T("Seguro", "Secure")" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Size="XFBadgeSize.Md" OnClick="OnBadgeClick">
                <StartIcon>@((MarkupString)XFSvgIcons.MarkupWithSize("shield-check", 14))</StartIcon>
            </XFBadge>
            <XFBadge Text="@T("Filtro", "Filter")" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Size="XFBadgeSize.Md">
                <EndIcon>@((MarkupString)XFSvgIcons.MarkupWithSize("filter", 14))</EndIcon>
            </XFBadge>
            <XFBadge Text="@T("Excluir", "Delete")" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Danger" Size="XFBadgeSize.Md" OnDismiss="OnBadgeDismiss">
                <DismissIcon>@((MarkupString)XFSvgIcons.MarkupWithSize("trash-can", 12))</DismissIcon>
            </XFBadge>
        </div>
    </div>;

    // ─── 7. Dismiss ───
    private RenderFragment ExDismiss() => @<div class="flex flex-col gap-4">
        <div class="flex flex-col gap-2">
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">
                @T("Title padrao (ingles): \"Remove badge\" / \"Remove {texto}\" — AriaLabel customizavel.", "Default title (English): \"Remove badge\" / \"Remove {text}\" — Customizable AriaLabel.")
            </XFTypography>
            <div class="flex flex-wrap gap-3">
                <XFBadge Text="@T("Filtro SP", "Filter SP")" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Primary" Size="XFBadgeSize.Md"
                         OnDismiss="OnBadgeDismiss" />
                <XFBadge Text="@T("Filtro RJ", "Filter RJ")" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Size="XFBadgeSize.Md"
                         OnDismiss="OnBadgeDismiss" DismissAriaLabel="@T("Remover filtro RJ", "Remove RJ filter")" />
                <XFBadge Text="@T("Tag ativa", "Active tag")" Variant="XFBadgeVariant.Outline" Color="XFBadgeColor.Warning" Size="XFBadgeSize.Md"
                         OnDismiss="OnBadgeDismiss" />
            </div>
        </div>
        <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">
            @T("Ultimo dismiss: ", "Last dismiss: ")@dismissed
        </XFTypography>
    </div>;

    // ─── 8. Interactive ───
    private RenderFragment ExInterativo() => @<div class="flex flex-col gap-4">
        <div class="flex flex-wrap gap-3">
            <XFBadge Text="@T("Ver detalhes", "View details")" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Primary" Size="XFBadgeSize.Md"
                     OnClick="OnBadgeClick" />
            <XFBadge Text="@T("Mais filtros", "More filters")" Variant="XFBadgeVariant.Outline" Color="XFBadgeColor.Info" Size="XFBadgeSize.Md"
                     OnClick="OnBadgeClick" />
            <XFBadge Text="@T("Acoes", "Actions")" Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Success" Size="XFBadgeSize.Md" Shape="XFBadgeShape.Pill"
                     OnClick="OnBadgeClick" />
        </div>
        <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">
            @T("role=button adicionado automaticamente. Tab + Enter/Espaco funcionam.", "role=button added automatically. Tab + Enter/Space work.")
        </XFTypography>
        <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">
            @T("Ultimo clique: ", "Last click: ")@clicked
        </XFTypography>
    </div>;

    // ─── 9. Templates ───
    private RenderFragment ExTemplates() => @<div class="flex flex-wrap gap-3">
        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Size="XFBadgeSize.Md">
            <span class="inline-flex items-center gap-1.5">
