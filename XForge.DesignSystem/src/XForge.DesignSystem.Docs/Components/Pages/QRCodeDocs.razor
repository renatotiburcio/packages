            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("NF-e","Invoice")</XFTypography><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@T("Consulta","Query")</XFTypography><div class="mt-2"><XFQRCode Value="https://www.nfe.fazenda.gov.br/portal/consultanfe.aspx?p=3526..." ModuleSize="4" /></div></ChildContent></XFCard>
        </XFGrid>
    </XFStack>;
