@page "/layout/stack"
@using XForge.DesignSystem.Components.Layout
@using XForge.DesignSystem.Core.Primitives
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        @* ==================== HEADER ==================== *@
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFStack" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Flexbox utility", "Flexbox utility")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Composição linear", "Linear composition")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Layout base", "Base layout")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Composição linear com gap, alinhamento e direção para layouts previsíveis.",
                               "Linear composition with gap, alignment and direction for predictable layouts.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("XFStack é um wrapper sobre flexbox que expõe Orientation, AlignItems, JustifyContent, Gap, Wrap, Reverse, Inline e FullWidth via parâmetros tipados. Ele é a base de composição de layouts do XForge Design System.",
                               "XFStack is a flexbox wrapper that exposes Orientation, AlignItems, JustifyContent, Gap, Wrap, Reverse, Inline and FullWidth via typed parameters. It is the base layout composition of XForge Design System.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">@HeroPreview()</div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">@foreach (var item in QuickFacts) { @Tile(item) }</XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @* ==================== 1. METADATA ==================== *@
        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @* ==================== 2. BLAZOR SERVER / WASM ==================== *@
        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observações", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estático. Interações requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependências JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente não utiliza JavaScript interop. É puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderização.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Considerações", "Considerations")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor Server: eventos são tratados via SignalR. Sem latência adicional para componentes puramente renderizados.", "Blazor Server: events are handled via SignalR. No additional latency for purely rendered components.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor WebAssembly: eventos são tratados diretamente no cliente. Mais responsivo.", "Blazor WebAssembly: events are handled directly on the client. More responsive.")</XFTypography>
                </XFStack>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Exemplos de uso", "Usage Examples")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFCode Text="@InteractiveServerExample" Language="razor" Title="InteractiveServer" Variant="XFCodeVariant.Block" Copyable="true" />
                    <XFCode Text="@InteractiveWasmExample" Language="razor" Title="InteractiveWebAssembly" Variant="XFCodeVariant.Block" Copyable="true" />
                    <XFCode Text="@InteractiveAutoExample" Language="razor" Title="InteractiveAuto" Variant="XFCodeVariant.Block" Copyable="true" />
                </XFStack>
            </XFStack>
        </div>)

        @* ==================== 3. OVERVIEW ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visão geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Propósito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando não usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 2)</div>)
        </XFStack>

        @* ==================== 4. VARIANTS & STATES ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Variantes", "Variants"), @<div>@NameValueTable(VariantRows, T("Variante", "Variant"), T("Caso de uso", "Use case"))</div>)
            @Section(T("Estados", "States"), @<div>@NameValueTable(StateRows, T("Estado", "State"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        @* ==================== 5. VISUAL HIERARCHY & DESIGN ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Hierarquia visual", "Visual Hierarchy"), @<div>@TileGrid(VisualHierarchyItems, 3)</div>)
            @Section(T("Princípios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        @* ==================== 6-14. EXAMPLES ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Stack horizontal básico", "1. Basic horizontal stack"),
                T("Três cards lado a lado com gap de 3.", "Three cards side by side with gap of 3."),
                BasicPreview(), BasicCode)

            @Example(T("2. Stack vertical", "2. Vertical stack"),
                T("Cards empilhados verticalmente com gap de 3.", "Vertically stacked cards with gap of 3."),
                VerticalPreview(), VerticalCode)

            @Example(T("3. Toolbar com Wrap", "3. Toolbar with Wrap"),
                T("Wrap quebra linha quando os itens não cabem na largura.", "Wrap breaks line when items don't fit the width."),
                WrapPreview(), WrapCode)

            @Example(T("4. Alinhamento centralizado", "4. Center alignment"),
                T("AlignItems=Center e JustifyContent=Center para centralização.", "AlignItems=Center and JustifyContent=Center for centering."),
                AlignmentPreview(), AlignmentCode)

            @Example(T("5. Espaçamento entre itens (SpaceBetween)", "5. SpaceBetween justification"),
                T("JustifyContent=SpaceBetween distribui itens com espaço entre eles.", "JustifyContent=SpaceBetween distributes items with space between them."),
                SpaceBetweenPreview(), SpaceBetweenCode)

            @Example(T("6. Stack reverso", "6. Reversed stack"),
                T("Reverse=true inverte a ordem dos filhos.", "Reverse=true reverses the order of children."),
                ReversePreview(), ReverseCode)

            @Example(T("7. Inline stack", "7. Inline stack"),
                T("Inline=true usa inline-flex em vez de flex.", "Inline=true uses inline-flex instead of flex."),
                InlinePreview(), InlineCode)

            @Example(T("8. FullWidth stack", "8. FullWidth stack"),
                T("FullWidth=true ocupa 100%% da largura do container.", "FullWidth=true fills 100%% of container width."),
                FullWidthPreview(), FullWidthCode)

            @Example(T("9. Stack enterprise com Gap e Wrap", "9. Enterprise stack with Gap and Wrap"),
                T("Combinação de Gap, Wrap e AlignItems para toolbar ERP.", "Gap, Wrap and AlignItems combined for an ERP toolbar."),
                EnterprisePreview(), EnterpriseCode)
        </XFStack>

        @* ==================== 16. API ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Métodos", "Methods"), @<div>@NameValueTable(MethodRows, T("Método", "Method"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        @* ==================== 17. ACCESSIBILITY & KEYBOARD ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Navegação enterprise por teclado", "Enterprise Keyboard Navigation"), @<div>@TileGrid(EnterpriseKeyboardItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        @* ==================== 18. RESPONSIVENESS & PERFORMANCE ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        @* ==================== 19. ENTERPRISE SCENARIOS & PATTERNS ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenários enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padrões de composição", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Exemplos de integração", "Integration Examples"), @<div>@TileGrid(IntegrationItems, 2)</div>)
            @Section(T("Boas práticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padrões", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        @* ==================== 20. TOKENS, THEMING, SECURITY, TESTING ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("Design Tokens", @<div>@NameValueTable(TokenRows, "Token", T("Propósito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Segurança", "Security Considerations"), @<div>@TileGrid(SecurityItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidência", "Evidence"))</div>)
        </XFStack>

        @* ==================== EXTRA: LIMITATIONS, MIGRATION, RELATED, FAQ, CHANGELOG ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Limitações conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitação", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Notas de migração", "Migration Notes"), @<div>@TileGrid(MigrationItems, 2)</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versão", "Version"), T("Mudança", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string ProductLabelText => T("Core Open Source", "Core Open Source");
    private string PageTitleText => T("Stack", "Stack");
    private string PageStatusText => T("Documentação completa", "Complete docs");
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);

    // ==================== BLAZOR SECTION EXAMPLES ====================
    private string InteractiveServerExample => @"@page ""/erp/financeiro/toolbar""
@rendermode InteractiveServer
<XFStack Orientation=""XFOrientation.Horizontal"" Gap=""3"" Wrap=""XFWrap.Wrap"">
    <XFButton Text=""Salvar"" Color=""XFButtonColor.Primary"" />
    <XFButton Text=""Cancelar"" Variant=""XFButtonVariant.Outline"" />
    <XFButton Text=""Excluir"" Variant=""XFButtonVariant.Ghost"" Color=""XFButtonColor.Danger"" />
</XFStack>";

    private string InteractiveWasmExample => @"@page ""/erp/financeiro/toolbar""
@rendermode InteractiveWebAssembly
<XFStack Orientation=""XFOrientation.Horizontal"" Gap=""3"" Wrap=""XFWrap.Wrap"">
    <XFButton Text=""Save"" Color=""XFButtonColor.Primary"" />
    <XFButton Text=""Cancel"" Variant=""XFButtonVariant.Outline"" />
    <XFButton Text=""Delete"" Variant=""XFButtonVariant.Ghost"" Color=""XFButtonColor.Danger"" />
</XFStack>";

    private string InteractiveAutoExample => @"@page ""/erp/financeiro/toolbar""
@rendermode InteractiveAuto
<XFStack Orientation=""XFOrientation.Horizontal"" Gap=""3"" Wrap=""XFWrap.Wrap"">
    <XFButton Text=""Salvar"" Color=""XFButtonColor.Primary"" />
    <XFButton Text=""Cancelar"" Variant=""XFButtonVariant.Outline"" />
    <XFButton Text=""Excluir"" Variant=""XFButtonVariant.Ghost"" Color=""XFButtonColor.Danger"" />
</XFStack>";

    // ==================== HERO PREVIEW ====================
    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Horizontal" Gap="3" Wrap="XFWrap.Wrap">
        <XFButton Text="@T("Salvar", "Save")" Color="XFButtonColor.Primary" />
        <XFButton Text="@T("Cancelar", "Cancel")" Variant="XFButtonVariant.Outline" Color="XFButtonColor.Neutral" />
        <XFButton Text="@T("Excluir", "Delete")" Variant="XFButtonVariant.Ghost" Color="XFButtonColor.Danger" />
    </XFStack>;

    // ==================== EXAMPLE PREVIEWS ====================
    private RenderFragment BasicPreview() => @<XFStack Orientation="XFOrientation.Horizontal" Gap="3">
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFTypography>A</XFTypography></ChildContent></XFCard>
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFTypography>B</XFTypography></ChildContent></XFCard>
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFTypography>C</XFTypography></ChildContent></XFCard>
    </XFStack>;

    private RenderFragment VerticalPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3">
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFTypography>@T("Card 1", "Card 1")</XFTypography></ChildContent></XFCard>
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFTypography>@T("Card 2", "Card 2")</XFTypography></ChildContent></XFCard>
    </XFStack>;

    private RenderFragment WrapPreview() => @<XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Primary" Text="NF-e" />
        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Aprovado", "Approved")" />
        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Pendente", "Pending")" />
        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="CT-e" />
        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Danger" Text="@T("Rejeitado", "Rejected")" />
    </XFStack>;

    private RenderFragment AlignmentPreview() => @<div class="h-32 rounded-lg border border-border-light bg-surface-50">
        <XFStack Orientation="XFOrientation.Vertical" AlignItems="XFAlignItems.Center" JustifyContent="XFJustifyContent.Center" FullWidth="true" Class="h-full">
            <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@T("Centralizado", "Centered")</XFTypography>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@T("Align + Justify = Center", "Align + Justify = Center")</XFTypography>
        </XFStack>
    </div>;

    private RenderFragment SpaceBetweenPreview() => @<XFStack Orientation="XFOrientation.Horizontal" JustifyContent="XFJustifyContent.SpaceBetween" FullWidth="true" Gap="2">
        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Primary" Text="@T("Item 1", "Item 1")" />
        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Item 2", "Item 2")" />
        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Item 3", "Item 3")" />
    </XFStack>;

    private RenderFragment ReversePreview() => @<XFStack Orientation="XFOrientation.Horizontal" Gap="3" Reverse="true">
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFTypography>@T("1°", "1st")</XFTypography></ChildContent></XFCard>
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFTypography>@T("2°", "2nd")</XFTypography></ChildContent></XFCard>
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFTypography>@T("3°", "3rd")</XFTypography></ChildContent></XFCard>
    </XFStack>;

    private RenderFragment InlinePreview() => @<div class="text-sm">
        @T("Este é um", "This is an") <XFStack Orientation="XFOrientation.Horizontal" Gap="1" Inline="true">
        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Size="XFBadgeSize.Sm" Text="@T("inline stack", "inline stack")" />
        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Success" Size="XFBadgeSize.Sm" Text="@T("inline-flex", "inline-flex")" />
    </XFStack> @T("dentro de texto.", "within text.")
    </div>;

    private RenderFragment FullWidthPreview() => @<div class="rounded-lg border border-border-light bg-surface-50 p-3">
        <XFStack Orientation="XFOrientation.Horizontal" Gap="2" FullWidth="true">
            <div class="flex-1 rounded bg-primary/10 px-3 py-2 text-xs font-semibold text-primary">@T("100% largura", "100% width")</div>
            <div class="rounded bg-success/10 px-3 py-2 text-xs font-semibold text-success">@T("Preenchido", "Filled")</div>
        </XFStack>
    </div>;

    private RenderFragment EnterprisePreview() => @<div class="rounded-lg border border-border-light bg-surface-50 p-3">
        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap" AlignItems="XFAlignItems.Center">
                <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@T("Pedidos", "Orders")</XFTypography>
                <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Primary" Text="24" />
                <XFButton Text="@T("Novo", "New")" Size="XFExtendedSize.Sm" Color="XFButtonColor.Primary" />
            </XFStack>
            <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                <XFButton Text="@T("Filtrar", "Filter")" Size="XFExtendedSize.Sm" Variant="XFButtonVariant.Outline" />
                <XFButton Text="@T("Exportar", "Export")" Size="XFExtendedSize.Sm" Variant="XFButtonVariant.Outline" />
                <XFButton Text="@T("Imprimir", "Print")" Size="XFExtendedSize.Sm" Variant="XFButtonVariant.Ghost" />
            </XFStack>
        </XFStack>
    </div>;

    // ==================== CODE STRINGS ====================
    private string BasicCode => T("""
<XFStack Orientation="XFOrientation.Horizontal" Gap="3">
    <XFCard>A</XFCard>
    <XFCard>B</XFCard>
    <XFCard>C</XFCard>
</XFStack>
""", """
<XFStack Orientation="XFOrientation.Horizontal" Gap="3">
    <XFCard>A</XFCard>
    <XFCard>B</XFCard>
    <XFCard>C</XFCard>
</XFStack>
""");

    private string VerticalCode => T("""
<XFStack Orientation="XFOrientation.Vertical" Gap="3">
    <XFCard>Card 1</XFCard>
    <XFCard>Card 2</XFCard>
</XFStack>
""", """
<XFStack Orientation="XFOrientation.Vertical" Gap="3">
    <XFCard>Card 1</XFCard>
    <XFCard>Card 2</XFCard>
</XFStack>
""");

    private string WrapCode => T("""
<XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
    <XFBadge Text="NF-e" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Primary" />
    <XFBadge Text="Aprovado" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" />
    <XFBadge Text="Pendente" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" />
    <XFBadge Text="CT-e" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" />
    <XFBadge Text="Rejeitado" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Danger" />
</XFStack>
""", """
<XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
    <XFBadge Text="NF-e" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Primary" />
    <XFBadge Text="Approved" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" />
    <XFBadge Text="Pending" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" />
    <XFBadge Text="CT-e" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" />
    <XFBadge Text="Rejected" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Danger" />
</XFStack>
""");

    private string AlignmentCode => T("""
<XFStack Orientation="XFOrientation.Vertical"
          AlignItems="XFAlignItems.Center"
          JustifyContent="XFJustifyContent.Center"
          FullWidth="true">
    <XFTypography>Centralizado</XFTypography>
    <XFTypography Color="XFTypographyColor.Muted">Align + Justify = Center</XFTypography>
