@page "/forms/time-input"
@using XForge.DesignSystem.Core.Primitives
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFTimeInput" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="WAI-ARIA" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Entrada de horario controlada", "Controlled time input")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Entrada de horario com formato controlado, integracao de formulario e suporte cultural.",
                               "Time input with controlled format, form integration and cultural support.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("Componente de entrada de tempo com formato controlado, precisao configuravel, variantes, tamanhos, tons, prefixo/sufixo, icones, validacao, acessibilidade WCAG AAA e suporte a temas dark/light.",
                               "Time entry component with controlled format, configurable precision, variants, sizes, tones, prefix/suffix, icons, validation, WCAG AAA accessibility and dark/light theme support.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico.", "Renders as static HTML.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 6 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Uso basico", "1. Basic usage"), T("Entrada de horario simples com label e placeholder.", "Simple time input with label and placeholder."), ExBasic(), Code1)
            @Example(T("2. Min, Max e Step", "2. Min, Max and Step"), T("Entrada com limites de horario e incremento de 15 minutos.", "Input with time limits and 15-minute increment."), ExMinMax(), Code2)
            @Example(T("3. Variantes e Tamanhos", "3. Variants and Sizes"), T("Outline, Filled, Soft e tamanhos variados.", "Outline, Filled, Soft and various sizes."), ExVariants(), Code3)
            @Example(T("4. Prefixo, Sufixo e Icones", "4. Prefix, Suffix and Icons"), T("Texto antes e depois, icone de inicio.", "Text before and after, start icon."), ExAdornments(), Code4)
            @Example(T("5. ReadOnly e Required", "5. ReadOnly and Required"), T("Estado somente leitura e campo obrigatorio.", "Read-only state and required field."), ExStates(), Code5)
            @Example(T("6. Cultura e Precisao", "6. Culture and Precision"), T("Formato 24h, precisao por segundo e cultura brasileira.", "24h format, second precision and Brazilian culture."), ExCulture(), Code6)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string ProductLabelText => T("Core Open Source", "Core Open Source");
    private string PageTitleText => T("XFTimeInput", "XFTimeInput");
    private string PageStatusText => T("Documentacao completa", "Complete docs");
    private string T(string pt, string en) => LanguageService.Text(pt, en);
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFTimeInput Label="Horario de inicio" Value="@(new TimeOnly(9, 0))" />
        <XFTimeInput Label="Horario de termino" Value="@(new TimeOnly(17, 30))" />
        <XFTimeInput Label="Pausa para almoco" Value="@(new TimeOnly(12, 0))" />
    </XFStack>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("Entrada controlada", "Controlled input"), T("Valor TimeOnly? com formato validado.", "TimeOnly? value with validated format."), "clock"),
        new(T("Precisao configuravel", "Configurable precision"), T("Minuto ou segundo via Precision.", "Minute or second via Precision."), "sliders"),
        new(T("Zero JS", "Zero JS"), T("Nenhum JavaScript interop. Puro C# + Tailwind.", "No JavaScript interop. Pure C# + Tailwind."), "bolt")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFTimeInput"),
        new("Namespace", "XForge.DesignSystem.Components.Forms.TimeInput"),
        new("Package", "XForge.DesignSystem"),
        new("Category", "Forms / Time Input"),
        new("Status", T("Estavel", "Stable")),
        new("Accessibility", T("role=textbox, aria-label, aria-describedby, aria-valuetext.", "role=textbox, aria-label, aria-describedby, aria-valuetext.")),
        new("Theme support", T("Light, dark e data-brand via tokens.", "Light, dark and data-brand via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("Entrada de tempo", "Time entry"), T("Campo de entrada para horarios formatados.", "Input field for formatted times."), "clock"),
        new(T("Formato controlado", "Controlled format"), T("Valor TimeOnly? com validacao integrada.", "TimeOnly? value with integrated validation."), "check"),
        new(T("Cultura", "Culture"), T("Formato 12h/24h via Culture e CultureName.", "12h/24h format via Culture and CultureName."), "globe")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Agendamento", "Scheduling"), T("Selecionar horarios para agendar tarefas.", "Select times to schedule tasks."), "calendar"),
        new(T("Registro de ponto", "Time tracking"), T("Registrar entrada e saida de funcionarios.", "Register employee check-in and check-out."), "user-clock"),
        new(T("Configuracoes", "Settings"), T("Definir horarios de funcionamento e alertas.", "Set operating hours and alerts."), "gear")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Inputs de texto sem validacao de formato.", "Text inputs without format validation."), "xmark"),
        new(T("Depois", "After"), T("Entrada validada com formato e precisao.", "Validated input with format and precision."), "check"),
        new(T("Acessibilidade", "Accessibility"), T("role=textbox, aria-describedby, aria-valuetext.", "role=textbox, aria-describedby, aria-valuetext."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Agendamentos", "Scheduling"), T("Selecionar horarios para reunioes e tarefas.", "Select times for meetings and tasks."), "calendar"),
        new(T("Formularios", "Forms"), T("Campos de horario em formularios enterprise.", "Time fields in enterprise forms."), "file-lines")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Datas completas", "Full dates"), T("Use XFDateInput para data e hora.", "Use XFDateInput for date and time."), "calendar-days"),
        new(T("Selecao visual", "Visual selection"), T("Use XFTimePicker para selecao visual.", "Use XFTimePicker for visual selection."), "clock")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new("Input", T("Campo de entrada com valor formatado.", "Input field with formatted value."), "i-cursor"),
        new("Label", T("Texto descritivo acima do campo.", "Descriptive text above field."), "font"),
        new("Helper", T("Texto auxiliar abaixo do campo.", "Helper text below field."), "comment"),
        new("Icon", T("Icone opcional no inicio ou fim.", "Optional icon at start or end."), "icon")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(T("Formato controlado", "Controlled format"), T("Valor sempre validado no formato correto.", "Value always validated in correct format."), "check"),
        new(T("Acessibilidade", "Accessibility"), T("Labels, helpers e aria attributes.", "Labels, helpers and aria attributes."), "universal-access"),
        new(T("Simplicidade", "Simplicity"), T("Um campo, uma funcao. Sem sobrecarga.", "One field, one function. No overload."), "minimize")
    ];

    // === EXAMPLES ===
    private RenderFragment ExBasic() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFTimeInput Label="Horario de inicio" />
        <XFTimeInput Label="Horario de termino" HelperText="Formato HH:mm" />
    </XFStack>;

    private RenderFragment ExMinMax() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFTimeInput Label="Horario comercial" Min="@(new TimeOnly(8, 0))" Max="@(new TimeOnly(18, 0))" Step="15" />
        <XFTimeInput Label="Intervalo" Min="@(new TimeOnly(12, 0))" Max="@(new TimeOnly(14, 0))" Step="30" />
    </XFStack>;

    private RenderFragment ExVariants() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFTimeInput Label="Outline (padrao)" Variant="XFFormVariant.Outline" />
        <XFTimeInput Label="Filled" Variant="XFFormVariant.Filled" />
        <XFTimeInput Label="Soft" Variant="XFFormVariant.Soft" />
        <XFTimeInput Label="Pequeno" Size="XFSize.Sm" />
        <XFTimeInput Label="Grande" Size="XFSize.Lg" />
    </XFStack>;

    private RenderFragment ExAdornments() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFTimeInput Label="Com prefixo" PrefixText="UTC" />
        <XFTimeInput Label="Com sufixo" SuffixText="BRT" />
        <XFTimeInput Label="Com icone">
            <StartIcon><span class="text-sm" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize("clock", 16))</span></StartIcon>
        </XFTimeInput>
        <XFTimeInput Label="Completo" PrefixText="UTC" SuffixText="BRT">
            <StartIcon><span class="text-sm" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize("clock", 16))</span></StartIcon>
        </XFTimeInput>
    </XFStack>;

    private RenderFragment ExStates() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFTimeInput Label="Somente leitura" Value="@(new TimeOnly(9, 0))" ReadOnly="true" />
        <XFTimeInput Label="Obrigatorio" Required="true" />
        <XFTimeInput Label="Largura total" FullWidth="true" />
    </XFStack>;

    private RenderFragment ExCulture() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFTimeInput Label="Formato 24h" Precision="XFTimeInputPrecision.Minute" />
        <XFTimeInput Label="Precisao por segundo" Precision="XFTimeInputPrecision.Second" />
        <XFTimeInput Label="Cultura brasileira" CultureName="pt-BR" />
    </XFStack>;

    private const string Code1 = @"<XFTimeInput Label=""Horario de inicio"" />
<XFTimeInput Label=""Horario de termino"" HelperText=""Formato HH:mm"" />";
    private const string Code2 = @"<XFTimeInput Label=""Horario comercial"" Min=""@(new TimeOnly(8, 0))"" Max=""@(new TimeOnly(18, 0))"" Step=""15"" />
<XFTimeInput Label=""Intervalo"" Min=""@(new TimeOnly(12, 0))"" Max=""@(new TimeOnly(14, 0))"" Step=""30"" />";
    private const string Code3 = @"<XFTimeInput Label=""Outline (padrao)"" Variant=""XFFormVariant.Outline"" />
<XFTimeInput Label=""Filled"" Variant=""XFFormVariant.Filled"" />
<XFTimeInput Label=""Soft"" Variant=""XFFormVariant.Soft"" />
<XFTimeInput Label=""Pequeno"" Size=""XFSize.Sm"" />
<XFTimeInput Label=""Grande"" Size=""XFSize.Lg"" />";
    private const string Code4 = @"<XFTimeInput Label=""Com prefixo"" PrefixText=""UTC"" />
<XFTimeInput Label=""Com sufixo"" SuffixText=""BRT"" />
<XFTimeInput Label=""Com icone"">
    <StartIcon><span class=""text-sm"" aria-hidden=""true"">@((MarkupString)XFSvgIcons.MarkupWithSize(""clock"", 16))</span></StartIcon>
</XFTimeInput>
<XFTimeInput Label=""Completo"" PrefixText=""UTC"" SuffixText=""BRT"">
    <StartIcon><span class=""text-sm"" aria-hidden=""true"">@((MarkupString)XFSvgIcons.MarkupWithSize(""clock"", 16))</span></StartIcon>
</XFTimeInput>";
    private const string Code5 = @"<XFTimeInput Label=""Somente leitura"" Value=""@(new TimeOnly(9, 0))"" ReadOnly=""true"" />
<XFTimeInput Label=""Obrigatorio"" Required=""true"" />
<XFTimeInput Label=""Largura total"" FullWidth=""true"" />";
    private const string Code6 = @"<XFTimeInput Label=""Formato 24h"" Precision=""XFTimeInputPrecision.Minute"" />
<XFTimeInput Label=""Precisao por segundo"" Precision=""XFTimeInputPrecision.Second"" />
<XFTimeInput Label=""Cultura brasileira"" CultureName=""pt-BR"" />";

    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("Value", "TimeOnly?", "null", T("Valor atual do horario.", "Current time value.")),
        new("Min", "TimeOnly?", "null", T("Horario minimo permitido.", "Minimum allowed time.")),
        new("Max", "TimeOnly?", "null", T("Horario maximo permitido.", "Maximum allowed time.")),
        new("Step", "int?", "null", T("Incremento em minutos.", "Increment in minutes.")),
        new("Precision", "XFTimeInputPrecision", "Minute", T("Minute, Second.", "Minute, Second.")),
        new("Label", "string?", "null", T("Texto descritivo do campo.", "Descriptive field text.")),
        new("AriaLabel", "string?", "null", T("Label acessivel para leitores de tela.", "Accessible label for screen readers.")),
        new("HelperText", "string?", "null", T("Texto auxiliar abaixo do campo.", "Helper text below field.")),
        new("Name", "string?", "null", T("Nome do campo para formulario.", "Field name for forms.")),
        new("PrefixText", "string?", "null", T("Texto antes do campo.", "Text before field.")),
        new("SuffixText", "string?", "null", T("Texto depois do campo.", "Text after field.")),
        new("StartIcon", "RenderFragment?", "null", T("Icone customizado antes do campo.", "Custom icon before field.")),
        new("Variant", "XFFormVariant", "Outline", T("Outline, Filled, Soft, Ghost.", "Outline, Filled, Soft, Ghost.")),
        new("Size", "XFSize", "Md", T("Sm, Md, Lg.", "Sm, Md, Lg.")),
        new("Tone", "XFSemanticColor", "Default", T("Default, Primary, Secondary, Success, Warning, Danger, Info, Neutral.", "Default, Primary, Secondary, Success, Warning, Danger, Info, Neutral.")),
        new("ReadOnly", "bool", "false", T("Estado somente leitura.", "Read-only state.")),
        new("Required", "bool", "false", T("Campo obrigatorio.", "Required field.")),
        new("FullWidth", "bool", "true", T("Largura total do container.", "Full container width.")),
        new("Immediate", "bool", "false", T("Atualiza valor imediatamente.", "Updates value immediately.")),
        new("Clamp", "bool", "true", T("Limita valor entre Min e Max.", "Clamps value between Min and Max.")),
        new("Culture", "string?", "null", T("Cultura para formato (ex: pt-BR).", "Culture for format (e.g. pt-BR).")),
        new("CultureName", "string?", "null", T("Nome da cultura para localizacao.", "Culture name for localization.")),
        new("AriaValueTextFormat", "string?", "null", T("Formato do texto de valor acessivel.", "Accessible value text format."))
    ];

    private IReadOnlyList<NameValueRow> EventRows => [
        new("ValueChanged", T("Evento quando o valor muda. Usado com @bind-Value.", "Event when value changes. Used with @bind-Value.")),
        new("Change", T("Evento quando o usuario confirma a entrada.", "Event when user confirms input."))
    ];

    // === ACCESSIBILITY ===
    private IReadOnlyList<DocTile> AccessibilityItems => [
        new(T("role=textbox", "role=textbox"), T("Campo usa role=textbox para leitores de tela.", "Field uses role=textbox for screen readers."), "universal-access"),
        new(T("aria-label", "aria-label"), T("Label descritivo do campo.", "Descriptive field label."), "tag"),
        new(T("aria-describedby", "aria-describedby"), T("Referencia helper text para contexto.", "References helper text for context."), "comment"),
        new(T("aria-valuetext", "aria-valuetext"), T("Texto legivel do valor (ex: 09:00).", "Readable value text (e.g. 09:00)."), "font")
    ];

    private IReadOnlyList<NameValueRow> KeyboardRows => [
        new("Tab", T("Move foco para o campo.", "Moves focus to field.")),
        new("Setas", T("Incrementa ou decrementa valor.", "Increments or decrements value.")),
        new("Enter", T("Confirma entrada e dispara Change.", "Confirms input and fires Change.")),
        new("Escape", T("Cancela entrada e restaura valor anterior.", "Cancels input and restores previous value."))
    ];

    // === RESPONSIVENESS ===
    private IReadOnlyList<DocTile> ResponsivenessItems => [
        new(T("Largura total", "Full width"), T("Campo ocupa 100% do container por padrao.", "Field occupies 100% of container by default."), "maximize"),
        new(T("Tamanho responsivo", "Responsive size"), T("Sm para mobile, Md para desktop.", "Sm for mobile, Md for desktop."), "mobile-screen")
    ];

    // === PERFORMANCE ===
    private IReadOnlyList<DocTile> PerformanceItems => [
        new(T("Zero JS", "Zero JS"), T("Nenhum JavaScript interop.", "No JavaScript interop."), "bolt"),
        new(T("Render leve", "Light render"), T("Tag input nativa sem wrappers.", "Native input tag without wrappers."), "feather")
    ];

    // === SCENARIOS ===
    private IReadOnlyList<DocTile> ScenarioItems => [
        new(T("Agendamento ERP", "ERP scheduling"), T("Agendar tarefas com horarios fixos.", "Schedule tasks with fixed times."), "calendar"),
        new(T("Registro de ponto", "Time tracking"), T("Registrar entrada e saida de funcionarios.", "Register employee check-in and check-out."), "user-clock"),
        new(T("Configuracoes", "Settings"), T("Definir horarios de funcionamento.", "Set operating hours."), "gear")
    ];

    // === COMPOSITION ===
    private IReadOnlyList<DocTile> CompositionItems => [
        new(T("TimeInput + Label", "TimeInput + Label"), T("Label descritivo acima do campo.", "Descriptive label above field."), "font"),
        new(T("TimeInput + Helper", "TimeInput + Helper"), T("Texto auxiliar abaixo do campo.", "Helper text below field."), "comment"),
        new(T("TimeInput + Card", "TimeInput + Card"), T("Campo dentro de XFCard para contexto.", "Field inside XFCard for context."), "square")
    ];

    // === BEST PRACTICES ===
    private IReadOnlyList<DocTile> BestPracticeItems => [
        new(T("Label descritivo", "Descriptive label"), T("Sempre descreva o campo.", "Always describe the field."), "align-left"),
        new(T("Min/Max quando util", "Min/Max when useful"), T("Limite horarios para evitar erros.", "Limit times to prevent errors."), "sliders"),
        new(T("Precisao apropriada", "Appropriate precision"), T("Minuto para agendamento, segundo para log.", "Minute for scheduling, second for logging."), "clock"),
        new(T("Cultura correta", "Correct culture"), T("Use Culture para formato local.", "Use Culture for local format."), "globe")
