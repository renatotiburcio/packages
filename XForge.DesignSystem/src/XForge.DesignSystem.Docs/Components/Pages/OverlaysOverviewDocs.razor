@page "/overlays/overview"
@using XForge.DesignSystem.Core.Primitives
@inject XForgeDocsLanguageService LanguageService


<XForgeDocsShell ProductLabel="Core Open Source" Title="Overlays Overview" Status="Category standard" Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Text="Overlays" Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Warning" />
                        <XFBadge Text="Layered UX" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" />
                        <XFBadge Text="Focus managed" Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Primary" />
                    </XFStack>

                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            Camadas contextuais para decidir, editar e agir sem perder o Fluxo principal.
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            A categoria Overlays cobre dialog, drawer, dropdown menu, popover e context menu.
                            Ela existe para padronizar camadas temporarias com foco, bloqueio, escape, responsividade,
                            contraste e governanca visual em Fluxos enterprise densos.
                        </XFTypography>
                    </XFStack>

                    <XFGrid Cols="1" Gap="4" Class="lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in HeroFacts)
                            {
                                @InfoTile(item)
                            }
                        </XFStack>
                    </XFGrid>
                </XFStack>
            </ChildContent>
        </XFCard>

        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
            <Header><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">Blazor Server e Blazor WebAssembly</XFTypography></Header>
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                    <XFTable Striped="true" Hoverable="true" Compact="true">
                        <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observações", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                        <XFTableBody>
                            <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                            <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                            <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                            <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estático. Interações requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                        </XFTableBody>
                    </XFTable>
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependências JS", "No JS Dependencies")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente não utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderizacao.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
                </XFStack>
            </ChildContent>
        </XFCard>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewSection Title="Overview" Items="OverviewItems" Columns="3" />
            <XForgeCategoryOverviewSection Title="Philosophy" Items="PhilosophyItems" />
            <XForgeCategoryOverviewSection Title="Category Objectives" Items="ObjectiveItems" Columns="3" />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewComponentTable Rows="ComponentRows"
                                                  Description="Componentes de Overlays controlam camadas temporarias para decisoes, edicao contextual, acoes locais e informacoes ancoradas." />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewSection Title="Visual Language" Items="VisualLanguageItems" Columns="3" />
            <XForgeCategoryOverviewSection Title="UX Standards" Items="UxStandardItems" Columns="3" />
            <XForgeCategoryOverviewSection Title="Accessibility Standards" Items="AccessibilityItems" />
            <XForgeCategoryOverviewSection Title="Responsiveness Standards" Items="ResponsiveItems" />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewSection Title="Theme Standards" Items="ThemeItems" />
            <XForgeCategoryOverviewNameDescriptionTable Title="Design Tokens"
                                                        NameHeader="Token Group"
                                                        DescriptionHeader="Purpose"
                                                        CodeName="true"
                                                        Rows="TokenRows" />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewSection Title="Common Patterns" Items="PatternItems" Columns="3" />
            <XForgeCategoryOverviewSection Title="Enterprise Scenários" Items="ScenárioItems" Columns="3" />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewExampleGallery Examples="Examples" />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewSection Title="Documentation Standards" Items="DocumentationItems" Columns="3" />
            <XForgeCategoryOverviewSection Title="Anti-patterns" Items="AntiPatternItems" Columns="3" />
            <XForgeCategoryOverviewSection Title="Migration Guidance" Items="MigrationItems" Columns="3" />
            <XForgeCategoryOverviewSection Title="Best Practices" Items="BestPracticeItems" Columns="3" />
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            <XForgeCategoryOverviewNameDescriptionTable Title="Related Categories"
                                                        NameHeader="Category"
                                                        DescriptionHeader="Relationship"
                                                        Rows="RelatedCategories" />
        </XFStack>
    </XFStack>

    <XForgeDocsPageStandard ComponentName="OverlaysOverviewDocs" IsOverview="true" />
</XForgeDocsShell>

@code {
    private string T(string pt, string en) => LanguageService.Text(pt, en);

    private IReadOnlyList<XForgeCategoryOverviewExample> Examples =>
    [
        new("Approval dialog contract", "Dialog de decisao com risco, resumo e acoes explicitas.", ApprovalDialogPreview(), ApprovalDialogCode),
        new("Contextual drawer", "Drawer de detalhe preserva a lista e concentra edicao contextual.", DrawerPreview(), DrawerCode),
        new("Action menu and popover", "Dropdown menu e popover organizam acoes e ajuda ancorada sem trocar rota.", MenuPopoverPreview(), MenuPopoverCode)
    ];

    private static RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFGrid Cols="1" Md="12" Gap="4">
            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg" Class="md:col-span-7">
                <ChildContent>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                        <XFStack Orientation="XFOrientation.Horizontal" JustifyContent="XFJustifyContent.SpaceBetween" AlignItems="XFAlignItems.Center" FullWidth="true">
                            <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">Aprovacao de Pagamento</XFTypography>
                            <XFBadge Text="Dialog" Color="XFBadgeColor.Warning" Variant="XFBadgeVariant.Soft" />
                        </XFStack>
                        <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">
                            Confirme uma decisao sensivel com contexto, risco e acao primaria clara.
                        </XFTypography>
                        <XFGrid Cols="1" Sm="3" Gap="3">
                            <XFBadge Text="R$ 84.200" Color="XFBadgeColor.Info" />
                            <XFBadge Text="Alto impacto" Color="XFBadgeColor.Warning" />
                            <XFBadge Text="2 Aprovadores" Color="XFBadgeColor.Primary" />
                        </XFGrid>
                    </XFStack>
                </ChildContent>
            </XFCard>

            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg" Class="md:col-span-5">
                <ChildContent>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">Detalhes laterais</XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">Drawer para editar sem sair da fila.</XFTypography>
                        <XFBadge Text="Focus trap ativo" Color="XFBadgeColor.Success" Variant="XFBadgeVariant.Soft" />
                    </XFStack>
                </ChildContent>
            </XFCard>
        </XFGrid>

        <XFStack Orientation="XFOrientation.Horizontal" Gap="3" Wrap="XFWrap.Wrap">
            <XFDropdownMenu ButtonText="Acoes" Items="ActionItems" Open="true" ActiveTone="XFSemanticColor.Primary" MenuAriaLabel="Acoes do registro" />
            <XFPopover ButtonText="Ajuda" Open="true" Size="XFSize.Sm" PanelAriaLabel="Ajuda contextual">
                <XFStack Orientation="XFOrientation.Vertical" Gap="2">
                    <XFTypography Variant="XFTypographyVariant.Body2" Weight="XFTypographyWeight.Semibold">Politica de aprovacao</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Secondary">Pagamentos acima do limite exigem segundo Aprovador.</XFTypography>
                </XFStack>
            </XFPopover>
        </XFStack>
    </XFStack>;

    private static RenderFragment ApprovalDialogPreview() => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
        <ChildContent>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFStack Orientation="XFOrientation.Horizontal" JustifyContent="XFJustifyContent.SpaceBetween" AlignItems="XFAlignItems.Center" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">Confirmar aprovacao fiscal</XFTypography>
                    <XFBadge Text="crítico" Color="XFBadgeColor.Danger" />
                </XFStack>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">
                    Esta acao libera o Pagamento e registra auditoria para o periodo fiscal.
                </XFTypography>
                <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                    <XFButton Text="Cancelar" Variant="XFButtonVariant.Outline" />
                    <XFButton Text="Confirmar" Color="XFButtonColor.Danger" />
                </XFStack>
            </XFStack>
        </ChildContent>
    </XFCard>;

    private static RenderFragment DrawerPreview() => @<XFGrid Cols="1" Md="12" Gap="4">
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg" Class="md:col-span-7">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">Fila de pedidos</XFTypography>
                    <XFBadge Text="Pedido 2048 selecionado" Color="XFBadgeColor.Info" Variant="XFBadgeVariant.Soft" />
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">A lista permanece visivel enquanto o painel lateral recebe edicao contextual.</XFTypography>
                </XFStack>
            </ChildContent>
        </XFCard>
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg" Class="md:col-span-5">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">Detalhes do pedido</XFTypography>
                    <XFBadge Text="Drawer right" Color="XFBadgeColor.Primary" />
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">Dados resumidos, acoes e campos ficam isolados da tabela.</XFTypography>
                </XFStack>
            </ChildContent>
        </XFCard>
    </XFGrid>;

    private static RenderFragment MenuPopoverPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFStack Orientation="XFOrientation.Horizontal" Gap="3" Wrap="XFWrap.Wrap">
            <XFDropdownMenu ButtonText="Acoes do contrato" Items="ContractActionItems" Open="true" ActiveTone="XFSemanticColor.Warning" MenuAriaLabel="Acoes do contrato" />
            <XFPopover ButtonText="SLA" Open="true" Size="XFSize.Sm" PanelAriaLabel="Resumo de SLA">
                <XFStack Orientation="XFOrientation.Vertical" Gap="2">
                    <XFTypography Variant="XFTypographyVariant.Body2" Weight="XFTypographyWeight.Semibold">SLA 98.4%</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Secondary">Sem incidentes críticos no periodo.</XFTypography>
                </XFStack>
            </XFPopover>
        </XFStack>
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
            <ChildContent>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">Context menu segue o mesmo contrato de itens do dropdown, aplicado a superfícies interativas.</XFTypography>
            </ChildContent>
        </XFCard>
    </XFStack>;

