@page "/components/fab"
@using XForge.DesignSystem.Core.Primitives
@using Microsoft.AspNetCore.Components.Web
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFFAB" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Acao flutuante", "Floating action")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Viewport fixo", "Fixed viewport")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("AriaLabel obrigatorio", "Required AriaLabel")" />
                    </XFStack>

                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("A acao primaria sempre ao alcance, sem disputar espaco com o conteudo.",
                               "The primary action always within reach, without competing with content.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("XFFAB e o Floating Action Button do XForge para criar, anexar, iniciar fluxo ou abrir um menu curto de acoes contextuais. Ele fica fixo no viewport, suporta modo estendido com texto, menu linear, estados controlados e exige nome acessivel explicito.",
                               "XFFAB is the XForge Floating Action Button for creating, attaching, starting a flow or opening a short contextual action menu. It is fixed to the viewport, supports extended text mode, a linear menu, controlled state and requires an explicit accessible name.")
                        </XFTypography>
                    </XFStack>

                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts)
                            {
                                @Tile(item)
                            }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico. Interacoes requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderizacao.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Consideracoes", "Considerations")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor Server: eventos sao tratados via SignalR. Sem latencia adicional para componentes puramente renderizados.", "Blazor Server: events are handled via SignalR. No additional latency for purely rendered components.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor WebAssembly: eventos sao tratados diretamente no cliente. Mais responsivo.", "Blazor WebAssembly: events are handled directly on the client. More responsive.")</XFTypography>
                </XFStack>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Hierarquia visual", "Visual Hierarchy"), @<div>@TileGrid(VisualHierarchyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("Preview renderizado", "Live Preview"),
                T("FAB contido dentro do preview da documentacao para nao sobrepor a pagina inteira.", "FAB contained inside the documentation preview so it does not overlay the whole page."),
                BasicPreview(),
                BasicCode)

            @Example(T("Cobertura de exemplos: menu curto", "Example Coverage: short menu"),
                T("Itens de criacao e upload usam XFFABMenuItem e fecham o menu ao selecionar.", "Creation and upload items use XFFABMenuItem and close the menu when selected."),
                MenuPreview(),
                MenuCode)

            @Example(T("Posicoes, cores e tamanhos", "Placements, colors and sizes"),
                T("Placement fixa o canto do viewport; em docs usamos Class para simular dentro do card.", "Placement anchors the viewport corner; in docs we use Class to simulate it inside the card."),
                PlacementPreview(),
                PlacementCode)

            @Example(T("Estado controlado e modo estendido", "Controlled state and extended mode"),
                T("Open/OpenChanged permite controlar abertura; Text transforma o botao em FAB estendido.", "Open/OpenChanged enables controlled opening; Text turns the button into an extended FAB."),
                ExtendedPreview(),
                ExtendedCode)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Variantes", "Variants"), @<div>@NameValueTable(VariantRows, T("Variante", "Variant"), T("Uso", "Usage"))</div>)
            @Section(T("Estados", "States"), @<div>@NameValueTable(StateRows, T("Estado", "State"), T("Comportamento", "Behavior"))</div>)
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Metodos", "Methods"), @<div>@NameValueTable(MethodRows, T("Metodo", "Method"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Navegacao enterprise por teclado", "Enterprise Keyboard Navigation"), @<div>@TileGrid(EnterpriseKeyboardItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Exemplos de integracao", "Integration Examples"), @<div>@TileGrid(IntegrationItems, 2)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("Design Tokens", @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Seguranca", "Security Considerations"), @<div>@TileGrid(SecurityItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Notas de migracao", "Migration Notes"), @<div>@TileGrid(MigrationItems, 2)</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>

@code {
    private string ProductLabelText => T("Core Open Source", "Core Open Source");
    private string PageTitleText => T("FAB", "FAB");
    private string PageStatusText => T("Documentacao completa", "Complete docs");
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");
    private int createCount;
    private string lastAction = "Nenhuma acao executada";
    private bool controlledOpen = true;

    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);

    private IReadOnlyList<XFFABMenuItem> CreateItems => [
        new() { Text = T("Novo cliente", "New customer"), Value = "customer" },
        new() { Text = T("Nova oportunidade", "New opportunity"), Value = "opportunity" },
        new() { Text = T("Nova tarefa", "New task"), Value = "task" }
    ];

    private IReadOnlyList<XFFABMenuItem> ImportItems => [
        new() { Text = T("Importar planilha", "Import spreadsheet"), Value = "spreadsheet" },
        new() { Text = T("Anexar arquivo", "Attach file"), Value = "attachment" },
        new() { Text = T("Sincronizar origem", "Sync source"), Value = "sync" }
    ];

    private IReadOnlyList<XFFABMenuItem> ExportItems => [
        new() { Text = T("Exportar CSV", "Export CSV"), Value = "csv" },
        new() { Text = T("Exportar PDF", "Export PDF"), Value = "pdf", Disabled = true },
        new() { Text = T("Enviar por email", "Send by email"), Value = "email" }
    ];

    private RenderFragment HeroPreview() => @<div class="relative min-h-72 overflow-hidden rounded-lg border border-border-light bg-bg-surface p-5 shadow-[0_20px_60px_rgb(15_23_42/.08)]">
        <XFStack Orientation="XFOrientation.Vertical" Gap="3">
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Preview contido no card", "Preview contained in the card")</XFTypography>
            <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@T("Criacao rapida", "Quick creation")</XFTypography>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">
                @T("O FAB real e fixo no produto. Na documentacao, a Class sobrescreve para absolute e preserva a leitura da pagina.",
                   "The real FAB is fixed in the product. In documentation, Class overrides it to absolute and preserves page reading.")
            </XFTypography>
            <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Primary" Text="bottom-end" />
                <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="aria-label" />
                <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("menu opcional", "optional menu")" />
            </XFStack>
        </XFStack>

        <XFFAB AriaLabel="@T("Abrir acoes de criacao", "Open creation actions")"
               Items="CreateItems"
               ItemSelected="SelectFabItemAsync"
               MenuLabel="@T("Acoes de criacao", "Creation actions")"
               OpenMenuAriaLabel="@T("Abrir acoes rapidas", "Open quick actions")"
               CloseMenuAriaLabel="@T("Fechar acoes rapidas", "Close quick actions")"
               Placement="XFFABPlacement.BottomEnd"
               Class="!absolute !bottom-5 !right-5 !z-10" />
    </div>;

    private RenderFragment BasicPreview() => @<div class="relative min-h-56 overflow-hidden rounded-lg border border-border-light bg-surface-50 p-5">
        <XFStack Orientation="XFOrientation.Vertical" Gap="2">
            <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@T("Pipeline comercial", "Sales pipeline")</XFTypography>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@T("Clique no FAB para criar uma oportunidade.", "Click the FAB to create an opportunity.")</XFTypography>
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T($"{createCount} criacao(oes)", $"{createCount} creation(s)")" />
        </XFStack>
        <XFFAB AriaLabel="@T("Criar oportunidade", "Create opportunity")"
               OnClick="CreateRecordAsync"
               Placement="XFFABPlacement.BottomEnd"
               Class="!absolute !bottom-4 !right-4 !z-10" />
    </div>;

    private RenderFragment MenuPreview() => @<div class="relative min-h-72 overflow-hidden rounded-lg border border-border-light bg-surface-50 p-5">
        <XFStack Orientation="XFOrientation.Vertical" Gap="2">
            <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@T("Acoes de criacao", "Creation actions")</XFTypography>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@T("Ultima acao", "Last action"): <span class="font-semibold text-text-primary">@lastAction</span></XFTypography>
        </XFStack>
        <XFFAB AriaLabel="@T("Abrir acoes de criacao", "Open creation actions")"
               Items="CreateItems"
               ItemSelected="SelectFabItemAsync"
               MenuLabel="@T("Acoes de criacao", "Creation actions")"
               Class="!absolute !bottom-4 !right-4 !z-10" />
    </div>;

    private RenderFragment PlacementPreview() => @<XFGrid Cols="1" Md="2" Gap="3">
        @foreach (var placement in PlacementPreviews)
        {
            <div class="relative min-h-40 overflow-hidden rounded-lg border border-border-light bg-surface-50 p-4">
                <XFTypography Variant="XFTypographyVariant.Body2" Weight="XFTypographyWeight.Semibold">@placement.Label</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@placement.Token</XFTypography>
                <XFFAB AriaLabel="@placement.AriaLabel"
                       Placement="@placement.Placement"
                       Size="XFExtendedSize.Sm"
                       Color="@placement.Color"
                       Class="@placement.Class" />
            </div>
        }
    </XFGrid>;

    private RenderFragment ExtendedPreview() => @<div class="relative min-h-72 overflow-hidden rounded-lg border border-border-light bg-surface-50 p-5">
        <XFStack Orientation="XFOrientation.Vertical" Gap="3">
            <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@T("Importacao assistida", "Assisted import")</XFTypography>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@T("Open esta controlado por estado externo e inicia aberto.", "Open is controlled by external state and starts open.")</XFTypography>
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Primary" Text="Open/OpenChanged" />
        </XFStack>
        <XFFAB AriaLabel="@T("Abrir importacoes", "Open imports")"
               Text="@T("Importar", "Import")"
               Items="ImportItems"
               Open="controlledOpen"
               OpenChanged="SetControlledOpenAsync"
               ItemSelected="SelectFabItemAsync"
               Color="XFButtonColor.Success"
               Class="!absolute !bottom-4 !right-4 !z-10" />
    </div>;

    private RenderFragment Section(string title, RenderFragment content) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
        <Header><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography></Header>
        <ChildContent>@content</ChildContent>
    </XFCard>;

    private RenderFragment Example(string title, string description, RenderFragment preview, string codeText) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.None" AreaRestricted="false">
        <Header>
            <div class="px-6 pt-6 pb-2">
                <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@description</XFTypography>
            </div>
        </Header>
        <ChildContent>
            <div class="flex flex-col">
                <div class="border-t border-border-light p-6">@preview</div>
                <div class="border-t border-border-light bg-surface-50 p-6">
                    <XFCode Text="@codeText" Language="razor" Title="@CopyableCodeTitle" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" />
                </div>
            </div>
        </ChildContent>
    </XFCard>;

    private RenderFragment TileGrid(IReadOnlyList<DocTile> items, int columns) => @<XFGrid Cols="1" Md="@Math.Min(columns, 2)" Lg="@columns" Gap="4">
        @foreach (var item in items)
        {
            @Tile(item)
        }
    </XFGrid>;

    private RenderFragment WarningGrid(IReadOnlyList<DocTile> items) => @<XFGrid Cols="1" Md="2" Gap="4">
        @foreach (var item in items)
        {
            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
                <ChildContent>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                        <div class="flex items-center gap-4">
                            <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-danger/10 bg-danger/10 text-danger" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                            <div class="min-w-0">
                                <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography>
                            </div>
                        </div>
                        <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
                    </XFStack>
                </ChildContent>
            </XFCard>
        }
    </XFGrid>;

    private RenderFragment Tile(DocTile item) => @<XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
        <ChildContent>
            <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                <div class="flex items-center gap-4">
                    <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-primary/10 bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                    <div class="min-w-0">
                        <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography>
                    </div>
                </div>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
            </XFStack>
        </ChildContent>
    </XFCard>;

    private RenderFragment NameValueTable(IReadOnlyList<NameValueRow> rows, string nameHeader, string valueHeader) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader>
            <XFTableRow>
                <XFTableCell Header="true">@nameHeader</XFTableCell>
                <XFTableCell Header="true">@valueHeader</XFTableCell>
            </XFTableRow>
        </XFTableHeader>
        <XFTableBody>
            @foreach (var row in rows)
            {
                <XFTableRow>
                    <XFTableCell><XFCode Text="@row.Name" /></XFTableCell>
                    <XFTableCell>@row.Value</XFTableCell>
                </XFTableRow>
            }
        </XFTableBody>
    </XFTable>;

    private RenderFragment ApiTable(IReadOnlyList<ApiRow> rows) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader>
            <XFTableRow>
                <XFTableCell Header="true">@T("Parametro", "Parameter")</XFTableCell>
                <XFTableCell Header="true">Type</XFTableCell>
                <XFTableCell Header="true">Default</XFTableCell>
                <XFTableCell Header="true">@T("Descricao", "Description")</XFTableCell>
            </XFTableRow>
        </XFTableHeader>
        <XFTableBody>
            @foreach (var row in rows)
            {
                <XFTableRow>
                    <XFTableCell><XFCode Text="@row.Name" /></XFTableCell>
                    <XFTableCell>@row.Type</XFTableCell>
                    <XFTableCell><XFCode Text="@row.DefaultValue" /></XFTableCell>
                    <XFTableCell>@row.Description</XFTableCell>
                </XFTableRow>
            }
        </XFTableBody>
    </XFTable>;

    private IReadOnlyList<PlacementPreviewRow> PlacementPreviews => [
        new("Bottom end", "XFFABPlacement.BottomEnd", T("Acao inferior direita", "Bottom right action"), XFFABPlacement.BottomEnd, XFButtonColor.Primary, "!absolute !bottom-4 !right-4 !z-10"),
        new("Bottom start", "XFFABPlacement.BottomStart", T("Acao inferior esquerda", "Bottom left action"), XFFABPlacement.BottomStart, XFButtonColor.Success, "!absolute !bottom-4 !left-4 !right-auto !z-10"),
        new("Top end", "XFFABPlacement.TopEnd", T("Acao superior direita", "Top right action"), XFFABPlacement.TopEnd, XFButtonColor.Warning, "!absolute !top-4 !right-4 !bottom-auto !z-10"),
        new("Top start", "XFFABPlacement.TopStart", T("Acao superior esquerda", "Top left action"), XFFABPlacement.TopStart, XFButtonColor.Neutral, "!absolute !top-4 !left-4 !bottom-auto !right-auto !z-10")
