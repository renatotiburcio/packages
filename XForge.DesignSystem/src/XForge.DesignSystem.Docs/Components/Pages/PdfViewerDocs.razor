@page "/display/pdf-viewer"
@using XForge.DesignSystem.Core.Primitives
@using XForge.DesignSystem.Components.DataDisplay.PdfViewer
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFPdfViewer" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="JS Interop" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Iframe e Canvas", "Iframe and Canvas")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Visualizador de PDF com toolbar, paginacao, zoom e modos de renderizacao.",
                               "PDF viewer with toolbar, pagination, zoom and render modes.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("Exibicao de documentos PDF em fluxos de backoffice, com suporte a iframe nativo e canvas via PDF.js, paginacao, zoom, download, impressao e tela cheia.",
                               "PDF document display in backoffice workflows, with native iframe and PDF.js canvas support, pagination, zoom, download, print and fullscreen.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Parcial", "Partial")" /></XFTableCell><XFTableCell>@T("JS interop via SignalR. PDF.js carregado dinamicamente.", "JS interop via SignalR. PDF.js loaded dynamically.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("JS interop direto. PDF.js disponivel apos carregamento WASM.", "Direct JS interop. PDF.js available after WASM load.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Parcial", "Partial")" /></XFTableCell><XFTableCell>@T("Depende do modo ativo no momento.", "Depends on the active mode at the time.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Danger" Text="@T("Nao", "No")" /></XFTableCell><XFTableCell>@T("JS interop nao disponivel em modo estatico.", "JS interop not available in static mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("JS Interop", "JS Interop")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente utiliza JavaScript interop com PDF.js. O arquivo xf-pdf-viewer.js e carregado dinamicamente via import() para renderizar documentos PDF no canvas.", "This component uses JavaScript interop with PDF.js. The xf-pdf-viewer.js file is dynamically loaded via import() to render PDF documents on canvas.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 6 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Modo Iframe", "1. Iframe Mode"), T("Renderizacao nativa do navegador com toolbar e paginacao.", "Native browser rendering with toolbar and pagination."), ExIframeMode(), Code1)
            @Example(T("2. Modo Canvas", "2. Canvas Mode"), T("Renderizacao via PDF.js com deteccao automatica de paginas.", "Rendering via PDF.js with automatic page count detection."), ExCanvasMode(), Code2)
            @Example(T("3. Labels personalizados", "3. Custom Labels"), T("Toolbar com textos customizados e formatos de pagina.", "Toolbar with custom text and page formats."), ExCustomLabels(), Code3)
            @Example(T("4. Navegacao controlada", "4. Controlled Navigation"), T("Paginacao programatica com Page e PageChanged.", "Programmatic pagination with Page and PageChanged."), ExControlledNav(), Code4)
            @Example(T("5. Controle de zoom", "5. Zoom Control"), T("Zoom com min, max, step e callback de mudanca.", "Zoom with min, max, step and change callback."), ExZoomControl(), Code5)
            @Example(T("6. Canvas com acoes", "6. Canvas with Actions"), T("Modo canvas com download, impressao e tela cheia.", "Canvas mode with download, print and fullscreen."), ExCanvasActions(), Code6)
        </XFStack>

        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string ProductLabelText => T("Core Open Source", "Core Open Source");
    private string PageTitleText => T("XFPdfViewer", "XFPdfViewer");
    private string PageStatusText => T("Documentacao completa", "Complete docs");
    private string T(string pt, string en) => LanguageService.Text(pt, en);
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");

    private int _currentPage = 1;
    private int _currentZoom = 100;

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFPdfViewer Title="Nota Fiscal" Url="https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf" ShowToolbar="true" RenderMode="XFPdfRenderMode.Iframe" />
    </XFStack>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("Iframe e Canvas", "Iframe and Canvas"), T("Dois modos de renderizacao: nativo e PDF.js.", "Two render modes: native and PDF.js."), "display"),
        new(T("Toolbar integrada", "Integrated toolbar"), T("Paginacao, zoom, download, impressao e tela cheia.", "Pagination, zoom, download, print and fullscreen."), "wrench"),
        new(T("JS Interop", "JS Interop"), T("PDF.js carregado dinamicamente no modo canvas.", "PDF.js dynamically loaded in canvas mode."), "bolt")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFPdfViewer"),
        new("Namespace", "XForge.DesignSystem.Components.DataDisplay.PdfViewer"),
        new("Package", "XForge.DesignSystem"),
        new("Category", "DataDisplay / PdfViewer"),
        new("Status", T("Estavel", "Stable")),
        new("Accessibility", T("aria-label, frame-title, botoes com aria-label.", "aria-label, frame-title, buttons with aria-label.")),
        new("Theme support", T("Light, dark e data-brand via tokens.", "Light, dark and data-brand via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("Visualizador de PDF", "PDF viewer"), T("Exibe documentos PDF com toolbar e controles.", "Displays PDF documents with toolbar and controls."), "file-pdf"),
        new(T("Iframe nativo", "Native iframe"), T("Renderiza via iframe do navegador sem JS extra.", "Renders via browser iframe without extra JS."), "globe"),
        new(T("Canvas PDF.js", "Canvas PDF.js"), T("Renderiza via PDF.js com controle total de paginas.", "Renders via PDF.js with full page control."), "paintbrush")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Backoffice", "Backoffice"), T("Visualizacao de notas fiscais e documentos.", "Viewing invoices and documents."), "building"),
        new(T("Compliance", "Compliance"), T("Exibicao de contratos e documentos legais.", "Displaying contracts and legal documents."), "shield"),
        new(T("Relatorios", "Reports"), T("Visualizacao de relatorios gerados em PDF.", "Viewing reports generated as PDF."), "chart-bar")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Links externos ou iframes sem toolbar.", "External links or iframes without toolbar."), "xmark"),
        new(T("Depois", "After"), T("Viewer completo com paginacao, zoom e acoes.", "Complete viewer with pagination, zoom and actions."), "check"),
        new(T("Acessibilidade", "Accessibility"), T("aria-label, botoes acessiveis, navegacao por teclado.", "aria-label, accessible buttons, keyboard navigation."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Documentos PDF", "PDF documents"), T("Exibir notas fiscais, contratos, relatorios.", "Display invoices, contracts, reports."), "file-pdf"),
        new(T("Modo controlado", "Controlled mode"), T("Paginacao e zoom programaticos.", "Programmatic pagination and zoom."), "code")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Arquivos nao-PDF", "Non-PDF files"), T("Use XFImage ou outro componente.", "Use XFImage or another component."), "file"),
        new(T("Edicao de PDF", "PDF editing"), T("O componente e somente leitura.", "The component is read-only only."), "pencil")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new("Toolbar", T("Barra superior com titulo, paginacao, zoom e acoes.", "Top bar with title, pagination, zoom and actions."), "bars"),
        new("Viewport", T("Area de exibicao do PDF (iframe ou canvas).", "PDF display area (iframe or canvas)."), "display"),
        new("Previous/Next", T("Botoes de navegacao entre paginas.", "Page navigation buttons."), "arrows-left-right"),
        new("Zoom +/-", T("Botoes de zoom com nivel percentual.", "Zoom buttons with percentage level."), "magnifying-glass"),
        new("Actions", T("Botoes de download, impressao e tela cheia.", "Download, print and fullscreen buttons."), "download")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(T("Degradacao elegante", "Graceful degradation"), T("Iframe sem JS. Canvas com PDF.js.", "Iframe without JS. Canvas with PDF.js."), "shield"),
        new(T("Toolbar completa", "Full toolbar"), T("Controles de paginacao, zoom e acoes.", "Pagination, zoom and action controls."), "wrench"),
        new(T("Acessibilidade", "Accessibility"), T("Aria-labels em todos os botoes interativos.", "Aria-labels on all interactive buttons."), "universal-access")
    ];

    // === EXAMPLES ===
    private RenderFragment ExIframeMode() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFPdfViewer Title="Exemplo Iframe" Url="https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf" RenderMode="XFPdfRenderMode.Iframe" ShowToolbar="true" />
    </XFStack>;

    private RenderFragment ExCanvasMode() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFPdfViewer Title="Exemplo Canvas" Url="https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf" RenderMode="XFPdfRenderMode.Canvas" ShowToolbar="true" ShowDownload="true" ShowPrint="true" ShowFullscreen="true" />
    </XFStack>;

    private RenderFragment ExCustomLabels() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFPdfViewer Title="Documento personalizado" SourceLabel="Fonte: Sistema ERP" Url="https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf" PreviousLabel="Voltar" NextLabel="Avancar" ZoomInLabel="Mais" ZoomOutLabel="Menos" PageCountLabelFormat="Pag {0} de {1}" RenderMode="XFPdfRenderMode.Iframe" ShowToolbar="true" />
    </XFStack>;

    private RenderFragment ExControlledNav() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
            <XFButton Text="@($"Pagina {_currentPage}")" Variant="XFButtonVariant.Outline" Size="XFExtendedSize.Sm" Disabled="true" />
            <XFButton Text="@T("Anterior", "Previous")" Variant="XFButtonVariant.Outline" Size="XFExtendedSize.Sm" OnClick="() => _currentPage = Math.Max(1, _currentPage - 1)" Disabled="@(_currentPage <= 1)" />
            <XFButton Text="@T("Proxima", "Next")" Variant="XFButtonVariant.Outline" Size="XFExtendedSize.Sm" OnClick="() => _currentPage++" />
        </XFStack>
        <XFPdfViewer Title="Navegacao controlada" Url="https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf" Page="_currentPage" PageChanged="p => _currentPage = p" RenderMode="XFPdfRenderMode.Iframe" ShowToolbar="true" />
    </XFStack>;

    private RenderFragment ExZoomControl() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
            <XFButton Text="@($"Zoom: {_currentZoom}%")" Variant="XFButtonVariant.Outline" Size="XFExtendedSize.Sm" Disabled="true" />
            <XFButton Text="@T("Diminuir", "Decrease")" Variant="XFButtonVariant.Outline" Size="XFExtendedSize.Sm" OnClick="() => _currentZoom = Math.Max(50, _currentZoom - 10)" Disabled="@(_currentZoom <= 50)" />
            <XFButton Text="@T("Aumentar", "Increase")" Variant="XFButtonVariant.Outline" Size="XFExtendedSize.Sm" OnClick="() => _currentZoom = Math.Min(200, _currentZoom + 10)" Disabled="@(_currentZoom >= 200)" />
        </XFStack>
        <XFPdfViewer Title="Zoom controlado" Url="https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf" Zoom="_currentZoom" ZoomChanged="z => _currentZoom = z" MinZoom="50" MaxZoom="200" ZoomStep="10" RenderMode="XFPdfRenderMode.Iframe" ShowToolbar="true" />
    </XFStack>;

    private RenderFragment ExCanvasActions() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFPdfViewer Title="Acoes do Canvas" Url="https://www.w3.org/WAI/ER/tests/xhtml/testfiles/resources/pdf/dummy.pdf" RenderMode="XFPdfRenderMode.Canvas" ShowToolbar="true" ShowDownload="true" ShowPrint="true" ShowFullscreen="true" DownloadFileName="documento.pdf" LoadingText="Carregando documento..." />
    </XFStack>;

    private const string Code1 = @"<XFPdfViewer
    Title=""Exemplo Iframe""
    Url=""https://example.com/sample.pdf""
    RenderMode=""XFPdfRenderMode.Iframe""
    ShowToolbar=""true"" />";
    private const string Code2 = @"<XFPdfViewer
    Title=""Exemplo Canvas""
    Url=""https://example.com/sample.pdf""
    RenderMode=""XFPdfRenderMode.Canvas""
    ShowToolbar=""true""
    ShowDownload=""true""
    ShowPrint=""true""
    ShowFullscreen=""true"" />";
    private const string Code3 = @"<XFPdfViewer
    Title=""Documento personalizado""
    SourceLabel=""Fonte: Sistema ERP""
    Url=""https://example.com/sample.pdf""
    PreviousLabel=""Voltar""
    NextLabel=""Avancar""
    ZoomInLabel=""Mais""
    ZoomOutLabel=""Menos""
    PageCountLabelFormat=""Pag {0} de {1}""
    RenderMode=""XFPdfRenderMode.Iframe""
    ShowToolbar=""true"" />";
    private const string Code4 = @"@code {
    private int _currentPage = 1;
}

<XFPdfViewer
    Title=""Navegacao controlada""
    Url=""https://example.com/sample.pdf""
    Page=""@_currentPage""
    PageChanged=""p => _currentPage = p""
    RenderMode=""XFPdfRenderMode.Iframe""
    ShowToolbar=""true"" />";
    private const string Code5 = @"@code {
    private int _currentZoom = 100;
}

<XFPdfViewer
    Title=""Zoom controlado""
    Url=""https://example.com/sample.pdf""
    Zoom=""@_currentZoom""
    ZoomChanged=""z => _currentZoom = z""
    MinZoom=""50""
    MaxZoom=""200""
    ZoomStep=""10""
    RenderMode=""XFPdfRenderMode.Iframe""
    ShowToolbar=""true"" />";
    private const string Code6 = @"<XFPdfViewer
    Title=""Acoes do Canvas""
    Url=""https://example.com/sample.pdf""
    RenderMode=""XFPdfRenderMode.Canvas""
    ShowToolbar=""true""
    ShowDownload=""true""
    ShowPrint=""true""
    ShowFullscreen=""true""
    DownloadFileName=""documento.pdf""
    LoadingText=""Carregando documento..."" />";

    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("Url", "string?", "null", T("URL do PDF a ser exibido.", "URL of the PDF to display.")),
        new("Base64", "string?", "null", T("Conteudo PDF em base64 (alternativa a Url).", "PDF content in base64 (alternative to Url).")),
        new("Title", "string?", T("Documento PDF", "PDF Document"), T("Titulo exibido na toolbar.", "Title displayed in the toolbar.")),
        new("SourceLabel", "string?", "null", T("Subtitulo da fonte na toolbar.", "Source subtitle in the toolbar.")),
        new("AriaLabel", "string?", T("Visualizador de PDF", "PDF Viewer"), T("Label de acessibilidade do componente.", "Component accessibility label.")),
        new("FrameTitle", "string?", "PDF", T("Titulo do iframe para acessibilidade.", "Iframe title for accessibility.")),
        new("EmptyText", "string?", T("Informe uma URL ou base64 para visualizar o PDF.", "Provide a URL or base64 to view the PDF."), T("Texto exibido quando nao ha fonte.", "Text displayed when no source is provided.")),
        new("ShowToolbar", "bool", "true", T("Exibe ou oculta a toolbar.", "Shows or hides the toolbar.")),
        new("Page", "int", "1", T("Pagina atual (1-indexed).", "Current page (1-indexed).")),
        new("PageChanged", "EventCallback<int>", "-", T("Callback ao mudar de pagina.", "Callback when page changes.")),
        new("PageCount", "int?", "null", T("Total de paginas (fallback se detectado pelo canvas).", "Total pages (fallback if detected by canvas).")),
        new("Zoom", "int", "100", T("Nivel de zoom percentual.", "Percentage zoom level.")),
        new("ZoomChanged", "EventCallback<int>", "-", T("Callback ao mudar zoom.", "Callback when zoom changes.")),
        new("MinZoom", "int", "50", T("Zoom minimo permitido.", "Minimum allowed zoom.")),
        new("MaxZoom", "int", "200", T("Zoom maximo permitido.", "Maximum allowed zoom.")),
        new("ZoomStep", "int", "10", T("Incremento de zoom por clique.", "Zoom increment per click.")),
        new("PreviousLabel", "string?", T("Anterior", "Previous"), T("Label do botao anterior.", "Previous button label.")),
        new("NextLabel", "string?", T("Proxima", "Next"), T("Label do botao proximo.", "Next button label.")),
        new("ZoomInLabel", "string?", T("Aumentar zoom", "Zoom in"), T("Label do botao de zoom in.", "Zoom in button label.")),
        new("ZoomOutLabel", "string?", T("Reduzir zoom", "Zoom out"), T("Label do botao de zoom out.", "Zoom out button label.")),
        new("PageLabelFormat", "string?", T("Pagina {0}", "Page {0}"), T("Formato do texto de pagina unica.", "Single page text format.")),
        new("PageCountLabelFormat", "string?", T("{0}/{1}", "{0}/{1}"), T("Formato do texto de contagem de paginas.", "Page count text format.")),
        new("RenderMode", "XFPdfRenderMode", "Iframe", T("Iframe ou Canvas.", "Iframe or Canvas.")),
        new("ShowDownload", "bool", "true", T("Exibe botao de download (somente Canvas).", "Shows download button (Canvas only).")),
        new("ShowPrint", "bool", "true", T("Exibe botao de impressao (somente Canvas).", "Shows print button (Canvas only).")),
        new("ShowFullscreen", "bool", "true", T("Exibe botao de tela cheia (somente Canvas).", "Shows fullscreen button (Canvas only).")),
        new("DownloadFileName", "string?", "null", T("Nome do arquivo ao baixar.", "Filename when downloading.")),
        new("DownloadLabel", "string?", T("Baixar", "Download"), T("Label do botao de download.", "Download button label.")),
        new("PrintLabel", "string?", T("Imprimir", "Print"), T("Label do botao de impressao.", "Print button label.")),
        new("FullscreenLabel", "string?", T("Tela cheia", "Fullscreen"), T("Label do botao de tela cheia.", "Fullscreen button label.")),
        new("LoadingText", "string?", T("Carregando PDF...", "Loading PDF..."), T("Texto exibido durante carregamento no canvas.", "Text shown during canvas loading.")),
        new("OnDocumentLoaded", "EventCallback<XFPdfDocumentLoadedEventArgs>", "-", T("Callback apos carregar PDF no canvas.", "Callback after loading PDF in canvas."))
    ];

