@page "/display/markdown"
@using Microsoft.AspNetCore.Components.Web
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@T("Core Open Source", "Core Open Source")"
                 Title="Markdown"
                 Status="@T("Documentacao completa", "Complete docs")"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                    <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFMarkdown" />
                    <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Inline parsing", "Inline parsing")" />
                    <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Code blocks", "Code blocks")" />
                    <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Copy code", "Copy code")" />
                </XFStack>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">@T("Renderizacao segura e tematizada de conteudo markdown para documentacao enterprise.","Secure and themed markdown content rendering for enterprise documentation.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">@T("XFMarkdown parseia e renderiza markdown com headings, paragrafos, listas, blockquotes, code blocks com copia, e inline: bold, italic, code e links com validacao de seguranca.","XFMarkdown parses and renders markdown with headings, paragraphs, lists, blockquotes, code blocks with copy, and inline: bold, italic, code and links with security validation.")</XFTypography>
                </XFStack>
                <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                    <div class="rounded-lg border border-border-light bg-surface-50 p-5">@HeroPreview()</div>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">@foreach (var item in QuickFacts){@Tile(item)}</XFStack>
                </div>
            </XFStack></ChildContent>
        </XFCard>
        @Section(T("Metadados","Metadata"),@<div>@NameValueTable(MetadataRows,T("Campo","Field"),T("Valor","Value"))</div>)

        @Section(T("Blazor Server e Blazor WebAssembly", "Blazor Server and Blazor WebAssembly"), @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona. Parser markdown e renderizado em C#.", "Works. Markdown parsing and rendering in C#.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Parcial", "Partial")" /></XFTableCell><XFTableCell>@T("Renderiza HTML base. Botao de copia indisponivel durante prerender.", "Renders base HTML. Copy button unavailable during prerender.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("JS Interop", "JS Interop")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Arquivo JS: xf-code.js — modulo de clipboard importado sob demanda para copiar code blocks via navigator.clipboard.writeText.", "JS file: xf-code.js — clipboard module imported on demand to copy code blocks via navigator.clipboard.writeText.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Quando carrega: sob demanda ao clicar no botao de copia.", "When loaded: on demand when clicking the copy button.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Prerender seguro: try/catch para InvalidOperationException e JSDisconnectedException.", "Prerender safe: try/catch for InvalidOperationException and JSDisconnectedException.")</XFTypography>
                </XFStack>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Consideracoes Blazor Server", "Blazor Server Considerations")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Parser markdown executa no servidor. Copia de code blocks via SignalR com latencia.", "Markdown parsing executes on server. Code block copy via SignalR with latency.")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Consideracoes Blazor WebAssembly", "Blazor WebAssembly Considerations")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Parser markdown executa no cliente. Copia de code blocks direta sem latencia.", "Markdown parsing executes on client. Code block copy direct with no latency.")</XFTypography>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral","Overview"),@<div>@TileGrid(OverviewItems,3)</div>)
            @Section(T("Proposito","Purpose"),@<div>@TileGrid(PurposeItems,3)</div>)
            @Section(T("Problema resolvido","Problem Solved"),@<div>@TileGrid(ProblemItems,3)</div>)
            @Section(T("Quando usar","When To Use"),@<div>@TileGrid(UseItems,2)</div>)
            @Section(T("Quando nao usar","When Not To Use"),@<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia","Anatomy"),@<div>@TileGrid(AnatomyItems,2)</div>)
        </XFStack>
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Hierarquia visual","Visual Hierarchy"),@<div>@TileGrid(VisualHierarchyItems,3)</div>)
            @Section(T("Principios de design","Design Principles"),@<div>@TileGrid(DesignPrincipleItems,3)</div>)
        </XFStack>
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("Preview renderizado","Live Preview"),T("Markdown com headings, listas, code blocks e inline formatting.","Markdown with headings, lists, code blocks and inline formatting."),BasicPreview(),BasicCode)
            @Example(T("Code blocks com copia","Code blocks with copy"),T("Code blocks com linguagem, copia e tema escuro.","Code blocks with language, copy and dark theme."),CodePreview(),CodeCode)
            @Example(T("Inline formatting","Inline Formatting"),T("Bold, italic, code e links.","Bold, italic, code and links."),InlinePreview(),InlineCode)
        </XFStack>
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Variantes","Variants"),@<div>@NameValueTable(VariantRows,T("Variante","Variant"),T("Caso de uso","Use case"))</div>)
            @Section(T("Estados","States"),@<div>@NameValueTable(StateRows,T("Estado","State"),T("Comportamento","Behavior"))</div>)
            @Section("API",@<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos","Events"),@<div>@NameValueTable(EventRows,T("Evento","Event"),T("Comportamento","Behavior"))</div>)
            @Section(T("Metodos","Methods"),@<div>@NameValueTable(MethodRows,T("Metodo","Method"),T("Comportamento","Behavior"))</div>)
        </XFStack>
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade","Accessibility"),@<div>@TileGrid(AccessibilityItems,2)</div>)
            @Section(T("Navegacao enterprise por teclado","Enterprise Keyboard Navigation"),@<div>@TileGrid(EnterpriseKeyboardItems,2)</div>)
            @Section(T("Suporte de teclado","Keyboard Support"),@<div>@NameValueTable(KeyboardRows,T("Tecla","Key"),T("Comportamento","Behavior"))</div>)
            @Section(T("Responsividade","Responsiveness"),@<div>@TileGrid(ResponsivenessItems,2)</div>)
            @Section(T("Performance","Performance"),@<div>@TileGrid(PerformanceItems,2)</div>)
        </XFStack>
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise","Enterprise Scenarios"),@<div>@TileGrid(ScenarioItems,3)</div>)
            @Section(T("Padroes de composicao","Composition Patterns"),@<div>@TileGrid(CompositionItems,3)</div>)
            @Section(T("Exemplos de integracao","Integration Examples"),@<div>@TileGrid(IntegrationItems,2)</div>)
            @Section(T("Boas praticas de UX","UX Best Practices"),@<div>@TileGrid(BestPracticeItems,2)</div>)
            @Section(T("Anti-padroes","Anti-patterns"),@<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("Design Tokens",@<div>@NameValueTable(TokenRows,"Token",T("Proposito","Purpose"))</div>)
            @Section(T("Temas","Theming"),@<div>@TileGrid(ThemeItems,2)</div>)
            @Section(T("Seguranca","Security Considerations"),@<div>@TileGrid(SecurityItems,2)</div>)
            @Section(T("Testes","Testing"),@<div>@NameValueTable(TestingRows,T("Cobertura","Coverage"),T("Evidencia","Evidence"))</div>)
        </XFStack>
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Limitacoes conhecidas","Known Limitations"),@<div>@NameValueTable(LimitationRows,T("Limitacao","Limitation"),T("Status","Status"))</div>)
            @Section(T("Notas de migracao","Migration Notes"),@<div>@TileGrid(MigrationItems,2)</div>)
            @Section(T("Componentes relacionados","Related Components"),@<div>@TileGrid(RelatedComponentItems,3)</div>)
            @Section("FAQ",@<div>@NameValueTable(FaqRows,T("Pergunta","Question"),T("Resposta","Answer"))</div>)
            @Section("Changelog",@<div>@NameValueTable(ChangelogRows,T("Versao","Version"),T("Mudanca","Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>

@code {
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);
    private string sampleMd => T("# Titulo ERP\n\nParagrafo com **negrito** e *italico*.\n\n- Item 1\n- Item 2\n\n> Citacao de exemplo.\n\n```csharp\nvar pedido = new Pedido { Id = 1234 };\n```\n\nConsulte [documentacao](https://xforge.com.br/docs).","# ERP Title\n\nParagraph with **bold** and *italic*.\n\n- Item 1\n- Item 2\n\n> Example quote.\n\n```csharp\nvar order = new Order { Id = 1234 };\n```\n\nSee [documentation](https://xforge.com.br/docs).");
    private string codeMd => """# Configuracao\n\n```json\n{ "env": "production", "timeout": 30 }\n```\n\n```sql\nSELECT * FROM Pedidos WHERE Status = 'Aprovado';\n```\n\n```bash\ndotnet build --configuration Release\n```""";
    private string inlineMd => T("Use **negrito** para enfase, *italico* para termos, `código` para refs e [links](https://xforge.com.br) para navegacao.","Use **bold** for emphasis, *italic* for terms, `code` for refs and [links](https://xforge.com.br) for navigation.");
    private RenderFragment HeroPreview() => @<XFMarkdown Text="@sampleMd" ShowCodeLanguage="true" ShowCodeCopy="true" />;
    private RenderFragment BasicPreview() => @<XFMarkdown Text="@sampleMd" />;
    private RenderFragment CodePreview() => @<XFMarkdown Text="@codeMd" ShowCodeLanguage="true" ShowCodeCopy="true" />;
    private RenderFragment InlinePreview() => @<XFMarkdown Text="@inlineMd" />;
    private string BasicCode => """<XFMarkdown Text="# Titulo\n\nParagrafo com **negrito** e *italico*.\n\n- Item 1\n- Item 2" />""";
    private string CodeCode => """<XFMarkdown Text='# Config\n\n```json\n{ "env": "production" }\n```' ShowCodeLanguage="true" ShowCodeCopy="true" />""";
    private string InlineCode => """<XFMarkdown Text="Use **negrito** e *italico* e \`code\` e [link](url)." />""";
    private IReadOnlyList<DocTile> QuickFacts => [new(T("Parser puro","Pure parser"),T("Parseia markdown em C# sem dependencia JS.","Parses markdown in C# without JS dependency."),"code"),new(T("Code blocks","Code blocks"),T("Header com linguagem, copia e tema escuro.","Header with language, copy and dark theme."),"file-code"),new(T("Links seguros","Safe links"),T("Valida URLs: http, https, mailto, # e /.","Validates URLs: http, https, mailto, # and /."),"shield-check")];
