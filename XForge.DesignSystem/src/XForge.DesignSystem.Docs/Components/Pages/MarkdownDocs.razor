    private IReadOnlyList<DocTile> UseItems => [new("Docs",T("Documentacao viva de componentes e APIs.","Living documentation of components and APIs."),"book"),new("ERP",T("Notas de pedido, observacoes e justificativas.","Order notes, observations and justifications."),"briefcase"),new("AI",T("Respostas de assistente AI com formatacao.","AI assistant responses with formatting."),"sparkles")];
