@using XForge.DesignSystem.Services
@page "/layout/rail"
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        @* ==================== HEADER ==================== *@
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFRail" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Navegação de apps", "App navigation")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Shell slot", "Shell slot")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Indicador ativo", "Active indicator")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Navegação vertical por app ou categoria com marca ativa e suporte ao shell.",
                               "Vertical navigation by app or category with active brand and shell support.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("XFRail é a barra vertical estreita do shell que representa cada aplicativo. Ela suporta itens de rota, ação e separador, com indicador visual de app ativo, tooltip, auto-tracking e integração com NavigationStateService.",
                               "XFRail is the narrow vertical bar of the shell that represents each application. It supports route, action and separator items, with active app visual indicator, tooltip, auto-tracking and NavigationStateService integration.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">@HeroPreview()</div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">@foreach (var item in QuickFacts) { @Tile(item) }</XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @* ==================== 1. METADATA ==================== *@
        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @* ==================== 2. BLAZOR SERVER / WASM ==================== *@
        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observações", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona com prerender seguro. Tooltips inicializados após circuit conectar.", "Works with prerender-safe guards. Tooltips initialized after circuit connects.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições. JS interop direto sem latência de rede.", "Works without restrictions. Direct JS interop with no network latency.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Inicialmente Server, depois WASM. Tooltips e auto-tracking funcionam em ambos os modos.", "Initially Server, then WASM. Tooltips and auto-tracking work in both modes.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Parcial", "Partial")" /></XFTableCell><XFTableCell>@T("Renderiza HTML estático do rail. Tooltips, indicador ativo e navegação requerem modo interativo.", "Renders static rail HTML. Tooltips, active indicator and navigation require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("JS Interop", "JS Interop")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Arquivo JS: xf-tooltip.js — gerencia posicionamento, show/hide e dispose dos tooltips via XFTooltip (usado por XFRailItem).", "JS file: xf-tooltip.js — manages positioning, show/hide and disposal of tooltips via XFTooltip (used by XFRailItem).")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Arquivo JS: xf-nav-state.js — persistência de brand via localStorage no NavigationStateService.", "JS file: xf-nav-state.js — brand persistence via localStorage in NavigationStateService.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Prerender seguro: todas as chamadas JS interop em XFTooltip possuem try/catch para InvalidOperationException e JSDisconnectedException.", "Prerender-safe: all JS interop calls in XFTooltip have try/catch for InvalidOperationException and JSDisconnectedException.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Quando carrega: OnAfterRenderAsync (firstRender) inicializa tooltips; NavigationStateService.InitializeAsync no layout.", "When it loads: OnAfterRenderAsync (firstRender) initializes tooltips; NavigationStateService.InitializeAsync in layout.")</XFTypography>
                </XFStack>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Considerações Blazor Server", "Blazor Server Considerations")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Latência de JS interop via SignalR — tooltips podem ter leve atraso na primeira exibição.", "JS interop latency via SignalR — tooltips may have slight delay on first display.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Circuit disconnect — se a conexão SignalR cair, tooltips e navegação param de funcionar. Reconexão automática restaura funcionalidade.", "Circuit disconnect — if SignalR connection drops, tooltips and navigation stop working. Automatic reconnection restores functionality.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("localStorage via JS interop — NavigationStateService usa localStorage para persistir brand. Indisponível durante prerender, disponível após circuit conectar.", "localStorage via JS interop — NavigationStateService uses localStorage to persist brand. Unavailable during prerender, available after circuit connects.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Auto-tracking — LocationChanged events são tratados via SignalR. Indicador ativo atualiza automaticamente.", "Auto-tracking — LocationChanged events are handled via SignalR. Active indicator updates automatically.")</XFTypography>
                </XFStack>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Considerações Blazor WebAssembly", "Blazor WebAssembly Considerations")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("JS interop direto — sem latência de rede. Tooltips aparecem instantaneamente.", "Direct JS interop — no network latency. Tooltips appear instantly.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("localStorage disponível imediatamente — NavigationStateService persiste brand sem dependência de circuit.", "localStorage available immediately — NavigationStateService persists brand without circuit dependency.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Tamanho do bundle JS — xf-tooltip.js e xf-nav-state.js são carregados no início da aplicação.", "JS bundle size — xf-tooltip.js and xf-nav-state.js are loaded at application startup.")</XFTypography>
                </XFStack>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Exemplos de uso", "Usage Examples")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFCode Text="@InteractiveServerExample" Language="razor" Title="InteractiveServer" Variant="XFCodeVariant.Block" Copyable="true" />
                    <XFCode Text="@InteractiveWasmExample" Language="razor" Title="InteractiveWebAssembly" Variant="XFCodeVariant.Block" Copyable="true" />
                    <XFCode Text="@InteractiveAutoExample" Language="razor" Title="InteractiveAuto" Variant="XFCodeVariant.Block" Copyable="true" />
                </XFStack>
            </XFStack>
        </div>)

        @* ==================== 3. OVERVIEW ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visão geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Propósito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando não usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 2)</div>)
        </XFStack>

        @* ==================== 4. VARIANTS & STATES ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Variantes", "Variants"), @<div>@NameValueTable(VariantRows, T("Variante", "Variant"), T("Caso de uso", "Use case"))</div>)
            @Section(T("Estados", "States"), @<div>@NameValueTable(StateRows, T("Estado", "State"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        @* ==================== 5. VISUAL HIERARCHY & DESIGN ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Hierarquia visual", "Visual Hierarchy"), @<div>@TileGrid(VisualHierarchyItems, 3)</div>)
            @Section(T("Princípios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        @* ==================== 6-14. EXAMPLES ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Rail programático com Items", "1. Programmatic rail with Items"),
                T("Rail com itens definidos via parâmetro Items usando RailNavItem.", "Rail with items defined via Items parameter using RailNavItem."),
                ItemsPreview(), ItemsCode)

            @Example(T("2. Rail com ChildContent", "2. Rail with ChildContent"),
                T("Rail com XFRailItem como filhos diretos do ChildContent.", "Rail with XFRailItem as direct children of ChildContent."),
                ChildContentPreview(), ChildContentCode)

            @Example(T("3. Rail com Header e Footer", "3. Rail with Header and Footer"),
                T("Header com logo e Footer com configurações.", "Header with logo and Footer with settings."),
                HeaderFooterPreview(), HeaderFooterCode)

            @Example(T("4. Rail com indicador ativo", "4. Rail with active indicator"),
                T("ShowActiveIndicator=true com ActiveIndex destacando o primeiro item.", "ShowActiveIndicator=true with ActiveIndex highlighting the first item."),
                ActiveIndicatorPreview(), ActiveIndicatorCode)

            @Example(T("5. Rail com Action items", "5. Rail with Action items"),
                T("Itens do tipo Action para ações como notificações e ajuda.", "Action type items for actions like notifications and help."),
                ActionItemsPreview(), ActionItemsCode)

            @Example(T("6. Rail com separador", "6. Rail with separator"),
                T("RailNavItemType.Separator divide grupos de itens.", "RailNavItemType.Separator divides item groups."),
                SeparatorPreview(), SeparatorCode)

            @Example(T("7. Rail sem tooltip", "7. Rail without tooltip"),
                T("ShowTooltip=false desabilita o tooltip nos itens.", "ShowTooltip=false disables tooltip on items."),
                NoTooltipPreview(), NoTooltipCode)

            @Example(T("8. Rail com navegação manual", "8. Rail with manual navigation"),
                T("AutoTrackActiveItem=false desabilita rastreio automático de URL.", "AutoTrackActiveItem=false disables automatic URL tracking."),
                ManualNavPreview(), ManualNavCode)

            @Example(T("9. Rail enterprise completo", "9. Complete enterprise rail"),
                T("Header + Footer + Itens + indicador ativo em cenário ERP completo.", "Header + Footer + Items + active indicator in full ERP scenario."),
                EnterprisePreview(), EnterpriseCode)
        </XFStack>

        @* ==================== 16. API ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Métodos", "Methods"), @<div>@NameValueTable(MethodRows, T("Método", "Method"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        @* ==================== 17. ACCESSIBILITY & KEYBOARD ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Navegação enterprise por teclado", "Enterprise Keyboard Navigation"), @<div>@TileGrid(EnterpriseKeyboardItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        @* ==================== 18. RESPONSIVENESS & PERFORMANCE ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        @* ==================== 19. ENTERPRISE SCENARIOS & PATTERNS ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenários enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padrões de composição", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Exemplos de integração", "Integration Examples"), @<div>@TileGrid(IntegrationItems, 2)</div>)
            @Section(T("Boas práticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padrões", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        @* ==================== 20. TOKENS, THEMING, SECURITY, TESTING ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("Design Tokens", @<div>@NameValueTable(TokenRows, "Token", T("Propósito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Segurança", "Security Considerations"), @<div>@TileGrid(SecurityItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidência", "Evidence"))</div>)
        </XFStack>

        @* ==================== EXTRA: LIMITATIONS, MIGRATION, RELATED, FAQ, CHANGELOG ==================== *@
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Limitações conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitação", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Notas de migração", "Migration Notes"), @<div>@TileGrid(MigrationItems, 2)</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versão", "Version"), T("Mudança", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string ProductLabelText => T("Core Open Source", "Core Open Source");
    private string PageTitleText => T("Rail", "Rail");
    private string PageStatusText => T("Documentação completa", "Complete docs");
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);

    // ==================== BLAZOR SECTION EXAMPLES ====================
    private string InteractiveServerExample => @"@page ""/erp/financeiro/dashboard""
@rendermode InteractiveServer
<XFRail AriaLabel=""App navigation"">
    <ChildContent>
        <XFRailItem Icon=""chart-line"" Label=""Financeiro"" Active=""true"" />
        <XFRailItem Icon=""calculator"" Label=""Fiscal"" />
        <XFRailItem Icon=""boxes-stacked"" Label=""Estoque"" />
    </ChildContent>
</XFRail>";

    private string InteractiveWasmExample => @"@page ""/erp/financeiro/dashboard""
@rendermode InteractiveWebAssembly
<XFRail AriaLabel=""App navigation"">
    <ChildContent>
        <XFRailItem Icon=""chart-line"" Label=""Financeiro"" Active=""true"" />
        <XFRailItem Icon=""calculator"" Label=""Fiscal"" />
        <XFRailItem Icon=""boxes-stacked"" Label=""Estoque"" />
    </ChildContent>
</XFRail>";

    private string InteractiveAutoExample => @"@page ""/erp/financeiro/dashboard""
@rendermode InteractiveAuto
<XFRail AriaLabel=""App navigation"">
    <ChildContent>
        <XFRailItem Icon=""chart-line"" Label=""Financeiro"" Active=""true"" />
        <XFRailItem Icon=""calculator"" Label=""Fiscal"" />
        <XFRailItem Icon=""boxes-stacked"" Label=""Estoque"" />
    </ChildContent>
</XFRail>";

    // ==================== HERO PREVIEW ====================
    private RenderFragment HeroPreview() => @<XFRail AriaLabel="App navigation" ShowActiveIndicator="false" AutoTrackActiveItem="false" Class="!w-16 !h-72 !relative !overflow-hidden" ItemsClass="!gap-2">
        <Header><span class="text-xs font-bold text-primary-contrast">XF</span></Header>
        <ChildContent>
            <XFRailItem Icon="chart-line" Label="Financeiro" ShowTooltip="false" Active="true" />
            <XFRailItem Icon="calculator" Label="Fiscal" ShowTooltip="false" />
            <XFRailItem Icon="boxes-stacked" Label="Estoque" ShowTooltip="false" />
            <XFRailItem Icon="users" Label="RH" ShowTooltip="false" />
        </ChildContent>
        <Footer>
            <XFRailItem Icon="gear" Label="Configurações" ShowTooltip="false" />
        </Footer>
    </XFRail>;

    // ==================== EXAMPLE PREVIEWS ====================
    private RenderFragment ItemsPreview() => @<XFRail Items="@_demoRailItems1" ActiveIndex="0" ShowActiveIndicator="true" AutoTrackActiveItem="false" Class="!w-16 !h-64 !relative !overflow-hidden" />;

    private RenderFragment ChildContentPreview() => @<XFRail AutoTrackActiveItem="false" ShowActiveIndicator="false" Class="!w-16 !h-64 !relative !overflow-hidden">
        <ChildContent>
            <XFRailItem Icon="chart-line" Label="Financeiro" ShowTooltip="false" />
            <XFRailItem Icon="calculator" Label="Fiscal" ShowTooltip="false" />
            <XFRailItem Icon="boxes-stacked" Label="Estoque" ShowTooltip="false" />
        </ChildContent>
    </XFRail>;

    private RenderFragment HeaderFooterPreview() => @<XFRail AutoTrackActiveItem="false" ShowActiveIndicator="false" Class="!w-16 !h-72 !relative !overflow-hidden">
        <Header><span class="text-xs font-bold text-primary-contrast">XF</span></Header>
        <ChildContent>
            <XFRailItem Icon="chart-line" Label="Financeiro" ShowTooltip="false" Active="true" />
            <XFRailItem Icon="calculator" Label="Fiscal" ShowTooltip="false" />
        </ChildContent>
        <Footer>
            <XFRailItem Icon="gear" Label="Configurações" ShowTooltip="false" />
        </Footer>
    </XFRail>;

    private RenderFragment ActiveIndicatorPreview() => @<XFRail ActiveIndex="0" ShowActiveIndicator="true" AutoTrackActiveItem="false" Class="!w-16 !h-64 !relative !overflow-hidden">
        <ChildContent>
            <XFRailItem Icon="chart-line" Label="Financeiro" ShowTooltip="false" Active="true" />
            <XFRailItem Icon="calculator" Label="Fiscal" ShowTooltip="false" />
            <XFRailItem Icon="boxes-stacked" Label="Estoque" ShowTooltip="false" />
        </ChildContent>
    </XFRail>;

    private RenderFragment ActionItemsPreview() => @<XFRail Items="@_demoActionItems" AutoTrackActiveItem="false" ShowActiveIndicator="false" Class="!w-16 !h-64 !relative !overflow-hidden" />;

    private RenderFragment SeparatorPreview() => @<XFRail Items="@_demoSeparatorItems" ActiveIndex="0" ShowActiveIndicator="true" AutoTrackActiveItem="false" Class="!w-16 !h-72 !relative !overflow-hidden" />;

    private RenderFragment NoTooltipPreview() => @<XFRail AutoTrackActiveItem="false" ShowActiveIndicator="false" Class="!w-16 !h-48 !relative !overflow-hidden">
        <ChildContent>
            <XFRailItem Icon="chart-line" Label="Financeiro" ShowTooltip="false" />
            <XFRailItem Icon="calculator" Label="Fiscal" ShowTooltip="false" />
        </ChildContent>
    </XFRail>;

    private RenderFragment ManualNavPreview() => @<XFRail AutoTrackActiveItem="false" ActiveIndex="1" ShowActiveIndicator="true" Class="!w-16 !h-48 !relative !overflow-hidden">
        <ChildContent>
            <XFRailItem Icon="chart-line" Label="Financeiro" ShowTooltip="false" />
            <XFRailItem Icon="calculator" Label="Fiscal" ShowTooltip="false" Active="true" />
        </ChildContent>
    </XFRail>;

    private RenderFragment EnterprisePreview() => @<XFRail Items="@_demoEnterpriseItems" ActiveIndex="0" ShowActiveIndicator="true" AutoTrackActiveItem="false" Class="!w-16 !h-80 !relative !overflow-hidden">
        <Header><span class="text-xs font-bold text-primary-contrast">XF</span></Header>
    </XFRail>;

    // ==================== DEMO DATA ====================
    private List<RailNavItem> _demoRailItems1 => new()
    {
        new() { Brand = "financeiro", Label = "Financeiro", Icon = "chart-line", Type = RailNavItemType.Route },
        new() { Brand = "fiscal", Label = "Fiscal", Icon = "calculator", Type = RailNavItemType.Route },
        new() { Brand = "estoque", Label = "Estoque", Icon = "boxes-stacked", Type = RailNavItemType.Route }
    };

    private List<RailNavItem> _demoActionItems => new()
    {
        new() { Brand = "notifications", Label = "Notificações", Icon = "bell", Type = RailNavItemType.Action },
        new() { Brand = "help", Label = "Ajuda", Icon = "circle-question", Type = RailNavItemType.Action },
        new() { Brand = "logout", Label = "Sair", Icon = "right-from-bracket", Type = RailNavItemType.Action }
    };

    private List<RailNavItem> _demoSeparatorItems => new()
    {
        new() { Brand = "financeiro", Label = "Financeiro", Icon = "chart-line", Type = RailNavItemType.Route },
        new() { Brand = "fiscal", Label = "Fiscal", Icon = "calculator", Type = RailNavItemType.Route },
        new() { Brand = "sep1", Label = "Separador", Type = RailNavItemType.Separator },
        new() { Brand = "rh", Label = "RH", Icon = "users", Type = RailNavItemType.Route },
        new() { Brand = "folha", Label = "Folha", Icon = "file-lines", Type = RailNavItemType.Route }
    };

    private List<RailNavItem> _demoEnterpriseItems => new()
    {
        new() { Brand = "financeiro", Label = "Financeiro", Icon = "chart-line", Type = RailNavItemType.Route },
        new() { Brand = "fiscal", Label = "Fiscal", Icon = "calculator", Type = RailNavItemType.Route },
        new() { Brand = "estoque", Label = "Estoque", Icon = "boxes-stacked", Type = RailNavItemType.Route },
        new() { Brand = "contabil", Label = "Contábil", Icon = "scale-balanced", Type = RailNavItemType.Route },
        new() { Brand = "rh", Label = "RH", Icon = "users", Type = RailNavItemType.Route },
