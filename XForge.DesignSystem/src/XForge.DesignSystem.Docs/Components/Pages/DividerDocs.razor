@page "/display/divider"
@using XForge.DesignSystem.Core.Primitives
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFDivider" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Acessivel", "Accessible")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Tailwind-first", "Tailwind-first")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Separador visual para organizar superficies densas com semantica e acessibilidade.",
                               "Visual separator to organize dense surfaces with semantics and accessibility.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("XFDivider e um separador horizontal ou vertical com suporte a labels, tons semanticos, espessuras variaveis e orientacao acessivel.",
                               "XFDivider is a horizontal or vertical separator with label support, semantic tones, variable thickness and accessible orientation.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico. Interacoes requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderizacao.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Consideracoes", "Considerations")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor Server: eventos sao tratados via SignalR. Sem latencia adicional para componentes puramente renderizados.", "Blazor Server: events are handled via SignalR. No additional latency for purely rendered components.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor WebAssembly: eventos sao tratados diretamente no cliente. Mais responsivo.", "Blazor WebAssembly: events are handled directly on the client. More responsive.")</XFTypography>
                </XFStack>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 2)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Basico", "1. Basic"),
                T("Separador horizontal simples entre duas secoes de conteudo.", "Simple horizontal separator between two content sections."),
                ExBasic(), CodeBasic)

            @Example(T("2. Orientacoes", "2. Orientations"),
                T("Horizontal e Vertical - uso em layouts de formulario e toolbar.", "Horizontal and Vertical - usage in form layouts and toolbar."),
                ExOrientations(), CodeOrientations)

            @Example(T("3. Labels", "3. Labels"),
                T("Divisor com texto centralizado, alinhado a esquerda e com ChildContent customizado.", "Divider with centered text, left-aligned and custom ChildContent."),
                ExLabels(), CodeLabels)

            @Example(T("4. Tons", "4. Tones"),
                T("Todos os tons semanticos: Neutral, Primary, Success, Warning e Danger.", "All semantic tones: Neutral, Primary, Success, Warning and Danger."),
                ExTones(), CodeTones)

            @Example(T("5. Espessuras e estilos", "5. Thickness and styles"),
                T("Thin, Md, Lg e tracejado para diferentes hierarquias visuais.", "Thin, Md, Lg and dashed for different visual hierarchies."),
                ExThickness(), CodeThickness)

            @Example(T("6. Espacamentos", "6. Spacing"),
                T("None, Sm, Md, Lg e Xl para controle fino de margem.", "None, Sm, Md, Lg and Xl for fine margin control."),
                ExSpacing(), CodeSpacing)

            @Example(T("7. Cenario enterprise", "7. Enterprise scenario"),
                T("Formulario de cadastro de cliente ERP com divisores semanticos.", "ERP customer registration form with semantic dividers."),
                ExEnterprise(), CodeEnterprise)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Variantes", "Variants"), @<div>@NameValueTable(VariantRows, T("Variante", "Variant"), T("Caso de uso", "Use case"))</div>)
            @Section(T("Estados", "States"), @<div>@NameValueTable(StateRows, T("Estado", "State"), T("Comportamento", "Behavior"))</div>)
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>

@code {
    private string ProductLabelText => T("Core Open Source", "Core Open Source");
    private string PageTitleText => T("Divider", "Divider");
    private string PageStatusText => T("Documentacao completa", "Complete docs");
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");

    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFTypography Variant="XFTypographyVariant.Body1">@T("Secao superior", "Top section")</XFTypography>
        <XFDivider />
        <XFTypography Variant="XFTypographyVariant.Body1">@T("Secao inferior", "Bottom section")</XFTypography>
    </XFStack>;

    private RenderFragment ExBasic() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFTypography Variant="XFTypographyVariant.Body2">@T("Conteudo da primeira secao.", "First section content.")</XFTypography>
        <XFDivider />
        <XFTypography Variant="XFTypographyVariant.Body2">@T("Conteudo da segunda secao.", "Second section content.")</XFTypography>
    </XFStack>;

    private RenderFragment ExOrientations() => @<div class="grid gap-6 md:grid-cols-2">
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
            <Header><XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Horizontal", "Horizontal")</XFTypography></Header>
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2">@T("Dados pessoais", "Personal data")</XFTypography>
                    <XFDivider />
                    <XFTypography Variant="XFTypographyVariant.Body2">@T("Endereco", "Address")</XFTypography>
                </XFStack>
            </ChildContent>
        </XFCard>
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
            <Header><XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Vertical", "Vertical")</XFTypography></Header>
            <ChildContent>
                <div class="flex items-center gap-1 h-8">
                    <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="@T("Editar", "Edit")" />
                    <XFDivider Orientation="XFOrientation.Vertical" />
                    <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Danger" Text="@T("Excluir", "Delete")" />
                    <XFDivider Orientation="XFOrientation.Vertical" />
                    <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Info" Text="@T("Duplicar", "Duplicate")" />
                </div>
            </ChildContent>
        </XFCard>
    </div>;

    private RenderFragment ExLabels() => @<XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
        <div>
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted" Class="mb-1">@T("Label centralizado (padrao)", "Centered label (default)")</XFTypography>
            <XFDivider Label="@T("OU", "OR")" />
        </div>
        <div>
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted" Class="mb-1">@T("Label alinhado a esquerda", "Left-aligned label")</XFTypography>
            <XFDivider Label="@T("Secao 2", "Section 2")" Align="XFDividerAlign.Start" />
        </div>
        <div>
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted" Class="mb-1">@T("Label alinhado a direita", "Right-aligned label")</XFTypography>
            <XFDivider Label="@T("Fim", "End")" Align="XFDividerAlign.End" />
        </div>
        <div>
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted" Class="mb-1">@T("ChildContent customizado", "Custom ChildContent")</XFTypography>
            <XFDivider>
                <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Secao avancada", "Advanced section")" />
            </XFDivider>
        </div>
    </XFStack>;

    private RenderFragment ExTones() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        @foreach (var tone in new[] { XFSemanticColor.Neutral, XFSemanticColor.Primary, XFSemanticColor.Success, XFSemanticColor.Warning, XFSemanticColor.Danger })
        {
            <div>
                <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Neutral" Text="@tone.ToString()" />
                <XFDivider Tone="@tone" Class="mt-1" />
            </div>
        }
    </XFStack>;

    private RenderFragment ExThickness() => @<XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
        @foreach (var thickness in Enum.GetValues<XFDividerThickness>())
        {
            <div>
                <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Neutral" Text="@thickness.ToString()" />
                <XFDivider Thickness="@thickness" Class="mt-1" />
            </div>
        }
        <div>
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Tracejado", "Dashed")" />
            <XFDivider Dashed="true" Class="mt-1" />
        </div>
        <div>
            <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Danger" Text="@T("Tracejado + Danger", "Dashed + Danger")" />
            <XFDivider Dashed="true" Tone="XFSemanticColor.Danger" Class="mt-1" />
        </div>
    </XFStack>;

    private RenderFragment ExSpacing() => @<XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
        @foreach (var spacing in Enum.GetValues<XFDividerSpacing>())
        {
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Espacamento", "Spacing"): @spacing</XFTypography>
            <XFDivider Spacing="@spacing" />
        }
    </XFStack>;

    private RenderFragment ExEnterprise() => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg" AreaRestricted="false">
        <Header>
            <div class="flex items-center gap-2">
                <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize("user-plus", 16))</span>
                <div>
                    <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@T("Cadastro de Cliente", "Customer Registration")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Formulario ERP com divisores semanticos", "ERP form with semantic dividers")</XFTypography>
                </div>
            </div>
        </Header>
        <ChildContent>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Nome", "Name")</XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body2">Silva Comercio LTDA</XFTypography>
                    </div>
                    <div>
                        <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">CNPJ</XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body2">12.345.678/0001-90</XFTypography>
                    </div>
                </div>
                <XFDivider Label="@T("Endereco", "Address")" Align="XFDividerAlign.Start" />
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Logradouro", "Street")</XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body2">Rua das Flores, 123</XFTypography>
                    </div>
                    <div>
                        <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Cidade", "City")</XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body2">Sao Paulo - SP</XFTypography>
                    </div>
                </div>
                <XFDivider Label="@T("Contato", "Contact")" Align="XFDividerAlign.Start" Tone="XFSemanticColor.Primary" />
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">E-mail</XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body2">contato@silvacomercio.com.br</XFTypography>
                    </div>
                    <div>
                        <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Telefone", "Phone")</XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body2">(11) 3456-7890</XFTypography>
                    </div>
                </div>
            </XFStack>
        </ChildContent>
    </XFCard>;

    private RenderFragment Section(string title, RenderFragment content) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
        <Header><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography></Header>
        <ChildContent>@content</ChildContent>
    </XFCard>;

    private RenderFragment Example(string title, string description, RenderFragment preview, string codeText) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.None" AreaRestricted="false">
        <Header><div class="px-6 pt-6 pb-2">
            <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@description</XFTypography>
        </div></Header>
        <ChildContent><div class="flex flex-col">
            <div class="border-t border-border-light bg-surface-50/30 p-6">@preview</div>
            <div class="border-t border-border-light bg-surface-50 p-6">
                <XFCode Text="@codeText" Language="razor" Title="@CopyableCodeTitle" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" />
            </div>
        </div></ChildContent>
    </XFCard>;

    private RenderFragment Tile(DocTile item) => @<XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent>
        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <div class="flex items-center gap-4">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-primary/10 bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                <div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div>
            </div>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
        </XFStack>
    </ChildContent></XFCard>;

    private RenderFragment TileGrid(IReadOnlyList<DocTile> items, int columns) => @<XFGrid Cols="1" Md="@Math.Min(columns, 2)" Lg="@columns" Gap="4">@foreach (var item in items) { @Tile(item) }</XFGrid>;

    private RenderFragment WarningGrid(IReadOnlyList<DocTile> items) => @<XFGrid Cols="1" Md="2" Gap="4">@foreach (var item in items) {
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <div class="flex items-center gap-4">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-danger/10 bg-danger/10 text-danger" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                <div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div>
            </div>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
        </XFStack></ChildContent></XFCard>
    }</XFGrid>;

    private RenderFragment NameValueTable(IReadOnlyList<NameValueRow> rows, string nameHeader, string valueHeader) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader><XFTableRow><XFTableCell Header="true">@nameHeader</XFTableCell><XFTableCell Header="true">@valueHeader</XFTableCell></XFTableRow></XFTableHeader>
        <XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Value</XFTableCell></XFTableRow> }</XFTableBody>
    </XFTable>;

    private RenderFragment ApiTable(IReadOnlyList<ApiRow> rows) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Parametro", "Parameter")</XFTableCell><XFTableCell Header="true">Type</XFTableCell><XFTableCell Header="true">Default</XFTableCell><XFTableCell Header="true">@T("Descricao", "Description")</XFTableCell></XFTableRow></XFTableHeader>
        <XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Type</XFTableCell><XFTableCell><XFCode Text="@row.DefaultValue" /></XFTableCell><XFTableCell>@row.Description</XFTableCell></XFTableRow> }</XFTableBody>
    </XFTable>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("Acessibilidade WAI-ARIA", "WAI-ARIA accessibility"), T("role=separator com aria-orientation para leitores de tela.", "role=separator with aria-orientation for screen readers."), "universal-access"),
