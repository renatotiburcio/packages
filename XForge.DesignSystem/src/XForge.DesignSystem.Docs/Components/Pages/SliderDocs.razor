        new(T("Slider + Value", "Slider + Value"), T("Numero atual ao lado do slider.", "Current number alongside slider."), "hashtag"),
        new(T("Slider + Bounds", "Slider + Bounds"), T("Min/Max nas pontas.", "Min/Max at ends."), "arrows-left-right")
    ];

