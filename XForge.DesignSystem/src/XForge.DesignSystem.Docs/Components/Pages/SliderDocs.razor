@page "/forms/slider"
@using XForge.DesignSystem.Core.Primitives
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel='@T("Forms", "Forms")' Title='@T("Slider", "Slider")' Status='@T("Documentacao completa", "Complete docs")' Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFSlider" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="Range" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="Orientation" />
                    </XFStack>
                    <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">Controle de intervalo numerico para pesos, limites, score e configuracoes.</XFTypography>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            <XFSlider Label="Peso do risco" Value="72m" Min="0" Max="100" Step="1" SuffixText="%" ShowBounds="true" ShowValue="true" />
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="3"><div class="flex items-center gap-4"><span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-primary/10 bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize("sliders", 18))</span><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">Range input</XFTypography></div><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">Input type=range com label e bounds.</XFTypography></XFStack></ChildContent></XFCard>
                            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="3"><div class="flex items-center gap-4"><span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-primary/10 bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize("arrows-up-down", 18))</span><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">2 orientacoes</XFTypography></div><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">Horizontal e Vertical.</XFTypography></XFStack></ChildContent></XFCard>
                            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="3"><div class="flex items-center gap-4"><span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-primary/10 bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize("universal-access", 18))</span><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">WCAG AAA</XFTypography></div><XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">aria-valuemin/max/now, touch 44px.</XFTypography></XFStack></ChildContent></XFCard>
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>
        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico. Interacoes requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderizacao.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
            </XFStack>
        </div>)
        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
            @Section(T("Principios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 4 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Basico", "1. Basic"), T("XFSlider com Label, Min, Max, Step.", "XFSlider with Label, Min, Max, Step."), ExBasic(), Code1)
            @Example(T("2. Bounds + Suffix", "2. Bounds + Suffix"), T("ShowBounds e SuffixText.", "ShowBounds and SuffixText."), ExBounds(), Code2)
            @Example(T("3. Orientacao", "3. Orientation"), T("Vertical e Horizontal.", "Vertical and Horizontal."), ExOrientation(), Code3)
            @Example(T("4. Enterprise", "4. Enterprise"), T("Painel de configuracoes com sliders.", "Settings panel with sliders."), ExEnterprise(), Code4)
        </XFStack>
        <!-- ===== API + REFERENCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padroes de composicao", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Design Tokens", "Design Tokens"), @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section(T("Limitacoes conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitacao", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>
@code {
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");

    // === HERO ===
    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFSlider Label="Peso do risco" Value="72m" Min="0" Max="100" Step="1" SuffixText="%" ShowBounds="true" ShowValue="true" />
    </XFStack>;

    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("Range input", "Range input"), T("Input type=range com label e bounds.", "Input type=range with label and bounds."), "sliders"),
        new(T("2 orientacoes", "2 orientations"), T("Horizontal e Vertical.", "Horizontal and Vertical."), "arrows-up-down"),
        new(T("WCAG AAA", "WCAG AAA"), T("aria-valuemin/max/now, touch 44px.", "aria-valuemin/max/now, touch 44px."), "universal-access")
    ];

    // === METADATA ===
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFSlider"),
        new("Namespace", "XForge.DesignSystem.Components.Forms.Slider"),
        new("Package", "XForge.DesignSystem"),
        new("Category", "Forms / Slider"),
        new("Status", T("Estavel", "Stable")),
        new("Accessibility", T("aria-valuemin, aria-valuemax, aria-valuenow, aria-label, touch 44px.", "aria-valuemin, aria-valuemax, aria-valuenow, aria-label, 44px touch.")),
        new("Theme support", T("Light, dark e data-brand via tokens.", "Light, dark and data-brand via tokens."))
    ];

    // === OVERVIEW ===
    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("Range input", "Range input"), T("Controle deslizante para selecao de valor.", "Slider control for value selection."), "sliders"),
        new(T("Label e bounds", "Label and bounds"), T("Texto descritivo com minimo e maximo visiveis.", "Descriptive text with visible min and max."), "tag"),
        new(T("Orientacoes", "Orientations"), T("Horizontal (padrao) e Vertical.", "Horizontal (default) and Vertical."), "arrows-up-down")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Configuracoes", "Settings"), T("Ajustar parametros como volume, brilho, limite.", "Adjust parameters like volume, brightness, limit."), "gear"),
        new(T("Pesos e prioridades", "Weights and priorities"), T("Definir peso de risco, prioridade, score.", "Set risk weight, priority, score."), "scale-balanced"),
        new(T("Limites", "Limits"), T("Definir limites de taxa, desconto, margem.", "Set rate, discount, margin limits."), "sliders")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Inputs numericos sem feedback visual.", "Numeric inputs without visual feedback."), "xmark"),
        new(T("Depois", "After"), T("Slider com label, valor e bounds visiveis.", "Slider with visible label, value and bounds."), "check"),
        new(T("Acessibilidade", "Accessibility"), T("aria-valuemin/max/now, teclado, touch 44px.", "aria-valuemin/max/now, keyboard, 44px touch."), "universal-access")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("Faixa de valores", "Value range"), T("Quando o valor esta em uma faixa continua.", "When value is in a continuous range."), "arrows-left-right"),
        new(T("Configuracao visual", "Visual setting"), T("Ajuste rapido com feedback imediato.", "Quick adjustment with immediate feedback."), "gear")
