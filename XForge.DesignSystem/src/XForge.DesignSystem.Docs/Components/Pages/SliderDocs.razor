    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Valores exatos", "Exact values"), T("Use XFNumberInput para valores precisos.", "Use XFNumberInput for precise values."), "keyboard"),
        new(T("Multipla selecao", "Multiple selection"), T("Use XFCheckbox para selecao multipla.", "Use XFCheckbox for multiple selection."), "check")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new("Track", T("Barra horizontal/vertical com fundo neutro.", "Horizontal/vertical bar with neutral background."), "minus"),
        new("Thumb", T("Indicador deslizante arrastavel.", "Draggable sliding indicator."), "hand-pointer"),
        new("Label", T("Texto descritivo acima do slider.", "Descriptive text above slider."), "font"),
        new("Value", T("Numero atual (ShowValue).", "Current number (ShowValue)."), "hashtag"),
        new("Bounds", T("Min/Max nas pontas (ShowBounds).", "Min/Max at ends (ShowBounds)."), "arrows-left-right")
    ];

    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(T("Feedback imediato", "Immediate feedback"), T("Valor atualiza ao arrastar.", "Value updates on drag."), "bolt"),
        new(T("Bounds visiveis", "Visible bounds"), T("Min/Max mostram a faixa completa.", "Min/Max show full range."), "arrows-left-right"),
        new(T("Touch-first", "Touch-first"), T("Thumb minimo 44px para WCAG 2.5.8.", "Thumb minimum 44px for WCAG 2.5.8."), "hand-pointer")
    ];

    // === EXAMPLES ===
    private RenderFragment ExBasic() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFSlider Label="Capacidade" Value="65m" Min="0" Max="100" Step="5" ShowValue="true" />
    </XFStack>;

    private RenderFragment ExBounds() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFSlider Label="Desconto" Value="15m" Min="0" Max="50" Step="1" SuffixText="%" ShowBounds="true" ShowValue="true" />
    </XFStack>;

    private RenderFragment ExOrientation() => @<XFStack Orientation="XFOrientation.Horizontal" Gap="6">
        <XFSlider Label="Horizontal" Value="50m" Orientation="XFOrientation.Horizontal" ShowValue="true" />
        <XFSlider Label="Vertical" Value="50m" Orientation="XFOrientation.Vertical" ShowValue="true" />
    </XFStack>;

    private RenderFragment ExEnterprise() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFSlider Label="Nivel de risco" Value="30m" Min="0" Max="100" Step="5" SuffixText="%" ShowBounds="true" ShowValue="true" Tone="XFSemanticColor.Success" />
        <XFSlider Label="Tolerancia de atraso" Value="15m" Min="0" Max="60" Step="1" SuffixText="min" ShowBounds="true" ShowValue="true" Tone="XFSemanticColor.Warning" />
    </XFStack>;

    private string Code1 => "<XFSlider Label=\"Capacidade\" Value=\"65m\" Min=\"0\" Max=\"100\" Step=\"5\" ShowValue=\"true\" />";
    private string Code2 => "<XFSlider Label=\"Desconto\" Value=\"15m\" Min=\"0\" Max=\"50\" Step=\"1\" SuffixText=\"%\" ShowBounds=\"true\" ShowValue=\"true\" />";
    private string Code3 => "<XFSlider Label=\"Horizontal\" Value=\"50m\" Orientation=\"XFOrientation.Horizontal\" ShowValue=\"true\" />\n<XFSlider Label=\"Vertical\" Value=\"50m\" Orientation=\"XFOrientation.Vertical\" ShowValue=\"true\" />";
    private string Code4 => "<XFSlider Label=\"Nivel de risco\" Value=\"30m\" Tone=\"XFSemanticColor.Success\" SuffixText=\"%\" ShowBounds=\"true\" ShowValue=\"true\" />\n<XFSlider Label=\"Tolerancia\" Value=\"15m\" Tone=\"XFSemanticColor.Warning\" SuffixText=\"min\" ShowBounds=\"true\" ShowValue=\"true\" />";

    // === API ===
    private IReadOnlyList<ApiRow> ApiRows => [
        new("Value", "decimal", "0m", T("Valor atual.", "Current value.")),
        new("Min", "decimal", "0m", T("Valor minimo.", "Minimum value.")),
        new("Max", "decimal", "100m", T("Valor maximo.", "Maximum value.")),
        new("Step", "decimal", "1m", T("Incremento.", "Step increment.")),
        new("Label", "string?", "null", T("Texto descritivo.", "Descriptive text.")),
