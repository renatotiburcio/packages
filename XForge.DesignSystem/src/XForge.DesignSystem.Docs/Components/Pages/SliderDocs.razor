        new("ShowValue", "bool", "false", T("Exibe valor atual.", "Shows current value.")),
        new("ShowBounds", "bool", "false", T("Exibe Min/Max.", "Shows Min/Max.")),
        new("Orientation", "XFOrientation", "Horizontal", T("Horizontal ou Vertical.", "Horizontal or Vertical.")),
        new("Tone", "XFSemanticColor", "Default", T("Tom semantico da barra.", "Semantic tone of bar."))
    ];

    private IReadOnlyList<NameValueRow> EventRows => [];

    // === ACCESSIBILITY ===
    private IReadOnlyList<DocTile> AccessibilityItems => [
        new(T("aria-valuemin/max/now", "aria-valuemin/max/now"), T("Valores minimo, maximo e atual.", "Minimum, maximum and current values."), "universal-access"),
        new(T("Touch target 44px", "Touch target 44px"), T("Area clicavel minima (WCAG 2.5.8 AAA).", "Minimum clickable area (WCAG 2.5.8 AAA)."), "hand-pointer"),
        new(T("Teclado", "Keyboard"), T("Setas incrementam/decrementam.", "Arrows increment/decrement."), "keyboard")
    ];

    private IReadOnlyList<NameValueRow> KeyboardRows => [
        new("ArrowRight/Up", T("Incrementa valor.", "Increments value.")),
        new("ArrowLeft/Down", T("Decrementa valor.", "Decrements value.")),
        new("Home", T("Valor minimo.", "Minimum value.")),
        new("End", T("Valor maximo.", "Maximum value."))
    ];

    // === RESPONSIVENESS ===
    private IReadOnlyList<DocTile> ResponsivenessItems => [
        new(T("Largura total", "Full width"), T("Slider ocupa 100% do container.", "Slider occupies 100% of container."), "maximize"),
        new(T("Touch-first", "Touch-first"), T("Thumb 44px para mobile.", "Thumb 44px for mobile."), "mobile-screen")
    ];

    // === PERFORMANCE ===
    private IReadOnlyList<DocTile> PerformanceItems => [
        new(T("Zero JS", "Zero JS"), T("Nenhum JavaScript interop.", "No JavaScript interop."), "bolt"),
        new(T("Render leve", "Light render"), T("Input nativo HTML.", "Native HTML input."), "feather")
    ];

    // === SCENARIOS ===
    private IReadOnlyList<DocTile> ScenarioItems => [
        new(T("Configuracoes ERP", "ERP settings"), T("Limite de credito, margem, desconto.", "Credit limit, margin, discount."), "gear"),
        new(T("Pesos de risco", "Risk weights"), T("Nivel de risco, tolerancia, prioridade.", "Risk level, tolerance, priority."), "scale-balanced"),
        new(T("Limites fiscais", "Tax limits"), T("Aliquota, base de calculo, margem.", "Rate, calculation base, margin."), "building")
    ];

