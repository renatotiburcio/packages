                         JustifyContent=""XFJustifyContent.SpaceBetween""
                         FullWidth=""true"">
                    <XFTypography Variant=""XFTypographyVariant.Body1""
                                  Weight=""XFTypographyWeight.Semibold"">
                        Financeiro
                    </XFTypography>
                    <XFBadge Variant=""XFBadgeVariant.Soft""
                              Color=""XFBadgeColor.Success""
                              Text=""Produção"" />
                </XFStack>
            </ChildContent>
        </XFAppBar>
    </AppBar>
    <ChildContent>
        <XFTypography>Conteúdo principal</XFTypography>
    </ChildContent>
</XFAppShell>";

    private string InteractiveAutoExample => @"@page ""/erp/financeiro""
@rendermode InteractiveAuto
@using XForge.DesignSystem.Components.Layout.Shell

<XFAppShell>
    <AppBar>
        <XFAppBar Position=""XFAppBarPosition.Fixed"" Bordered=""true"">
            <ChildContent>
                <XFStack Orientation=""XFOrientation.Horizontal""
                         AlignItems=""XFAlignItems.Center""
                         JustifyContent=""XFJustifyContent.SpaceBetween""
                         FullWidth=""true"">
                    <XFTypography Variant=""XFTypographyVariant.Body1""
                                  Weight=""XFTypographyWeight.Semibold"">
                        Financeiro
                    </XFTypography>
                    <XFBadge Variant=""XFBadgeVariant.Soft""
                              Color=""XFBadgeColor.Success""
                              Text=""Produção"" />
                </XFStack>
            </ChildContent>
        </XFAppBar>
    </AppBar>
    <ChildContent>
        <XFTypography>Conteúdo principal</XFTypography>
    </ChildContent>
</XFAppShell>";

    // ==================== HERO ====================
    private RenderFragment HeroPreview() => @<div class="overflow-hidden rounded-lg border border-border-light">
        <XFAppBar Position="XFAppBarPosition.Static" Bordered="true">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Horizontal" AlignItems="XFAlignItems.Center" JustifyContent="XFJustifyContent.SpaceBetween" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="3" AlignItems="XFAlignItems.Center">
                        <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@T("Financeiro", "Finance")</XFTypography>
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Produção", "Production")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="3" AlignItems="XFAlignItems.Center">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Danger" Text="5" />
                        <XFAvatar Size="XFAvatarSize.Sm" Text="AD" />
                    </XFStack>
                </XFStack>
            </ChildContent>
        </XFAppBar>
        <div class="bg-surface-50 p-4">
            <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg">
                <ChildContent>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Conteúdo principal abaixo do AppBar.", "Main content below the AppBar.")</XFTypography>
                </ChildContent>
            </XFCard>
        </div>
    </div>;

    // ==================== EXAMPLE 1: DEFAULT ====================
    private RenderFragment ExDefault() => @<div class="overflow-hidden rounded-lg border border-border-light">
        <XFAppBar>
            <ChildContent>
                <XFStack Orientation="XFOrientation.Horizontal" AlignItems="XFAlignItems.Center" JustifyContent="XFJustifyContent.SpaceBetween" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@T("Título", "Title")</XFTypography>
                </XFStack>
            </ChildContent>
        </XFAppBar>
        <div class="bg-surface-50 p-4">
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Conteúdo da página", "Page content")</XFTypography>
        </div>
    </div>;

    private string CodeDefault => @"<XFAppBar>
    <ChildContent>
        <XFStack Orientation=""XFOrientation.Horizontal""
                 AlignItems=""XFAlignItems.Center""
                 JustifyContent=""XFJustifyContent.SpaceBetween""
                 FullWidth=""true"">
            <XFTypography Variant=""XFTypographyVariant.Body1""
                          Weight=""XFTypographyWeight.Semibold"">
                Título
            </XFTypography>
        </XFStack>
    </ChildContent>
</XFAppBar>";

    // ==================== EXAMPLE 2: FIXED ====================
    private RenderFragment ExFixed() => @<div class="overflow-hidden rounded-lg border border-border-light">
        <XFAppBar Position="XFAppBarPosition.Fixed" Bordered="true">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Horizontal" AlignItems="XFAlignItems.Center" JustifyContent="XFJustifyContent.SpaceBetween" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@T("Barra fixa", "Fixed bar")</XFTypography>
                    <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="sticky top-0" />
                </XFStack>
            </ChildContent>
        </XFAppBar>
        <div class="bg-surface-50 p-4">
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("A barra permanece visível ao rolar.", "The bar stays visible on scroll.")</XFTypography>
        </div>
    </div>;

    private string CodeFixed => @"<XFAppBar Position=""XFAppBarPosition.Fixed"" Bordered=""true"">
    <ChildContent>
        <XFStack Orientation=""XFOrientation.Horizontal""
                 AlignItems=""XFAlignItems.Center""
                 JustifyContent=""XFJustifyContent.SpaceBetween""
                 FullWidth=""true"">
            <XFTypography Variant=""XFTypographyVariant.Body1""
                          Weight=""XFTypographyWeight.Semibold"">
                Barra fixa
            </XFTypography>
            <XFBadge Variant=""XFBadgeVariant.Soft""
                      Color=""XFBadgeColor.Info""
                      Text=""sticky top-0"" />
        </XFStack>
    </ChildContent>
</XFAppBar>";

    // ==================== EXAMPLE 3: NO BORDER ====================
    private RenderFragment ExNoBorder() => @<div class="overflow-hidden rounded-lg border border-border-light">
        <XFAppBar Bordered="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Horizontal" AlignItems="XFAlignItems.Center" JustifyContent="XFJustifyContent.SpaceBetween" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@T("Sem borda", "Borderless")</XFTypography>
                </XFStack>
            </ChildContent>
        </XFAppBar>
        <div class="bg-surface-50 p-4">
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Visual limpo sem borda inferior.", "Clean look without bottom border.")</XFTypography>
        </div>
    </div>;

    private string CodeNoBorder => @"<XFAppBar Bordered=""false"">
    <ChildContent>
        <XFStack Orientation=""XFOrientation.Horizontal""
                 AlignItems=""XFAlignItems.Center""
                 JustifyContent=""XFJustifyContent.SpaceBetween""
                 FullWidth=""true"">
            <XFTypography Variant=""XFTypographyVariant.Body1""
                          Weight=""XFTypographyWeight.Semibold"">
                Sem borda
            </XFTypography>
        </XFStack>
    </ChildContent>
</XFAppBar>";

    // ==================== EXAMPLE 4: BREADCRUMBS ====================
    private RenderFragment ExBreadcrumbs() => @<div class="overflow-hidden rounded-lg border border-border-light">
        <XFAppBar Position="XFAppBarPosition.Fixed" Bordered="true">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Horizontal" AlignItems="XFAlignItems.Center" JustifyContent="XFJustifyContent.SpaceBetween" FullWidth="true">
                    <XFBreadcrumb Items="BreadcrumbNavItems" />
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="3" AlignItems="XFAlignItems.Center">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Danger" Text="5" />
                        <XFAvatar Size="XFAvatarSize.Sm" Text="AD" />
                    </XFStack>
                </XFStack>
            </ChildContent>
        </XFAppBar>
        <div class="bg-surface-50 p-4">
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Breadcrumbs com badges e avatar.", "Breadcrumbs with badges and avatar.")</XFTypography>
        </div>
    </div>;

    private string CodeBreadcrumbs => @"<XFAppBar Position=""XFAppBarPosition.Fixed"" Bordered=""true"">
    <ChildContent>
        <XFStack Orientation=""XFOrientation.Horizontal""
                 AlignItems=""XFAlignItems.Center""
                 JustifyContent=""XFJustifyContent.SpaceBetween""
                 FullWidth=""true"">
            <XFBreadcrumb Items=""@BreadcrumbItems"" />
            <XFStack Orientation=""XFOrientation.Horizontal""
                     Gap=""3""
                     AlignItems=""XFAlignItems.Center"">
                <XFBadge Variant=""XFBadgeVariant.Solid""
                          Color=""XFBadgeColor.Danger""
                          Text=""5"" />
                <XFAvatar Size=""XFAvatarSize.Sm"" Text=""AD"" />
            </XFStack>
        </XFStack>
    </ChildContent>
</XFAppBar>";

    // ==================== EXAMPLE 5: SEARCH ====================
    private RenderFragment ExSearch() => @<div class="overflow-hidden rounded-lg border border-border-light">
        <XFAppBar Bordered="true">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Horizontal" AlignItems="XFAlignItems.Center" JustifyContent="XFJustifyContent.SpaceBetween" FullWidth="true">
