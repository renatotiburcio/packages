@page "/layout/app-bar"
@using XForge.DesignSystem.Components.Layout.Shell
@using XForge.DesignSystem.Components.Navigation.Breadcrumb
@using XForge.DesignSystem.Components.Button
@using XForge.DesignSystem.Components.DataDisplay.Avatar
@using XForge.DesignSystem.Services
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFAppBar" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Shell slot", "Shell slot")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("Top bar", "Top bar")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("data-theme", "data-theme")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Barra superior do aplicativo com posicionamento, borda e conteúdo flexível.",
                               "Application top bar with positioning, border and flexible content.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("XFAppBar é o slot de barra superior do XFAppShell. Renderiza um header semântico com altura fixa de 64px, suporte a posição static/fixed, borda inferior opcional e container interno flex para alinhamento de branding, navegação, busca e ações.",
                               "XFAppBar is the top bar slot of XFAppShell. It renders a semantic header with fixed 64px height, static/fixed positioning support, optional bottom border and flex inner container for branding, navigation, search and actions alignment.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts)
                            {
                                @Tile(item)
                            }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observações", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições. Layout puramente CSS.", "Works without restrictions. Purely CSS layout.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições em ambos os estágios.", "Works without restrictions in both stages.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Parcial", "Partial")" /></XFTableCell><XFTableCell>@T("Renderiza HTML base com layout flex. Interações dos slots requerem modo interativo.", "Renders base HTML with flex layout. Slot interactions require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependências JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente não utiliza JavaScript interop. É puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderização.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Exemplos de uso por modo", "Usage Examples by Mode")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Weight="XFTypographyWeight.Semibold">@T("InteractiveServer", "InteractiveServer")</XFTypography>
                    <XFCode Text="@InteractiveServerExample" Language="razor" Title="InteractiveServer" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" />
                    <XFTypography Variant="XFTypographyVariant.Body2" Weight="XFTypographyWeight.Semibold">@T("InteractiveWebAssembly", "InteractiveWebAssembly")</XFTypography>
                    <XFCode Text="@InteractiveWasmExample" Language="razor" Title="InteractiveWebAssembly" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" />
                    <XFTypography Variant="XFTypographyVariant.Body2" Weight="XFTypographyWeight.Semibold">@T("InteractiveAuto", "InteractiveAuto")</XFTypography>
                    <XFCode Text="@InteractiveAutoExample" Language="razor" Title="InteractiveAuto" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" />
                </XFStack>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visão geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Propósito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando não usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Hierarquia visual", "Visual Hierarchy"), @<div>@TileGrid(VisualHierarchyItems, 3)</div>)
            @Section(T("Princípios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 9 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. AppBar padrão", "1. Default AppBar"),
                T("XFAppBar com configuração padrão: Static, Bordered, InnerClass padrão.",
                 "XFAppBar with default settings: Static, Bordered, default InnerClass."),
                ExDefault(), CodeDefault)

            @Example(T("2. AppBar fixo", "2. Fixed AppBar"),
                T("Position=Fixed para barra sticky com shadow ao rolar.",
                 "Position=Fixed for sticky bar with shadow on scroll."),
                ExFixed(), CodeFixed)

            @Example(T("3. AppBar sem borda", "3. Borderless AppBar"),
                T("Bordered=false remove a borda inferior para visual limpo.",
                 "Bordered=false removes bottom border for clean look."),
                ExNoBorder(), CodeNoBorder)

            @Example(T("4. AppBar com breadcrumbs", "4. AppBar with breadcrumbs"),
                T("XFBreadcrumb no lado esquerdo com badge de notificação e avatar.",
                 "XFBreadcrumb on the left side with notification badge and avatar."),
                ExBreadcrumbs(), CodeBreadcrumbs)

            @Example(T("5. AppBar com busca", "5. AppBar with search"),
                T("Campo de busca centralizado com botão de ação à direita.",
                 "Centered search field with action button on the right."),
                ExSearch(), CodeSearch)

            @Example(T("6. AppBar minimalista", "6. Minimalist AppBar"),
                T("Apenas título e botão de ação — sem InnerClass customizado.",
                 "Only title and action button — no custom InnerClass."),
                ExMinimal(), CodeMinimal)

            @Example(T("7. AppBar com InnerClass customizado", "7. Custom InnerClass AppBar"),
                T("InnerClass sobrescreve o layout interno padrão do container.",
                 "InnerClass overrides the default inner container layout."),
                ExCustomInner(), CodeCustomInner)

            @Example(T("8. AppBar com AriaLabel customizado", "8. Custom AriaLabel AppBar"),
                T("AriaLabel sobrescreve o label padrão para contextos específicos.",
                 "AriaLabel overrides the default label for specific contexts."),
                ExCustomAria(), CodeCustomAria)

            @Example(T("9. Cenário enterprise completo", "9. Full enterprise scenario"),
                T("AppBar dentro de XFAppShell com rail, sidebar, breadcrumbs, busca, badges e avatar.",
                 "AppBar inside XFAppShell with rail, sidebar, breadcrumbs, search, badges and avatar."),
                ExEnterprise(), CodeEnterprise)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Variantes", "Variants"), @<div>@NameValueTable(VariantRows, T("Variante", "Variant"), T("Caso de uso", "Use case"))</div>)
            @Section(T("Estados", "States"), @<div>@NameValueTable(StateRows, T("Estado", "State"), T("Comportamento", "Behavior"))</div>)
            @Section("API — XFAppBar", @<div>@ApiTable(AppBarApiRows)</div>)
            @Section("API — XFAppBarPosition", @<div>@NameValueTable(EnumRows, T("Valor", "Value"), T("Descrição", "Description"))</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Métodos", "Methods"), @<div>@NameValueTable(MethodRows, T("Método", "Method"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Navegação enterprise por teclado", "Enterprise Keyboard Navigation"), @<div>@TileGrid(EnterpriseKeyboardItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenários enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padrões de composição", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Exemplos de integração", "Integration Examples"), @<div>@TileGrid(IntegrationItems, 2)</div>)
            @Section(T("Boas práticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padrões", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("Design Tokens", @<div>@NameValueTable(TokenRows, "Token", T("Propósito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidência", "Evidence"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Limitações conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitação", "Limitation"), T("Status", "Status"))</div>)
            @Section(T("Notas de migração", "Migration Notes"), @<div>@TileGrid(MigrationItems, 2)</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versão", "Version"), T("Mudança", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>

@code {
    private string ProductLabelText => T("Core Open Source", "Core Open Source");
    private string PageTitleText => T("App Bar", "App Bar");
    private string PageStatusText => T("Documentação completa", "Complete docs");
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);

    // ==================== BLAZOR SECTION EXAMPLES ====================
    private string InteractiveServerExample => @"@page ""/erp/financeiro""
@rendermode InteractiveServer
@using XForge.DesignSystem.Components.Layout.Shell

<XFAppShell>
    <AppBar>
        <XFAppBar Position=""XFAppBarPosition.Static"" Bordered=""true"">
            <ChildContent>
                <XFStack Orientation=""XFOrientation.Horizontal""
                         AlignItems=""XFAlignItems.Center""
                         JustifyContent=""XFJustifyContent.SpaceBetween""
                         FullWidth=""true"">
                    <XFTypography Variant=""XFTypographyVariant.Body1""
                                  Weight=""XFTypographyWeight.Semibold"">
                        Financeiro
                    </XFTypography>
                    <XFBadge Variant=""XFBadgeVariant.Soft""
                              Color=""XFBadgeColor.Success""
                              Text=""Produção"" />
                </XFStack>
            </ChildContent>
        </XFAppBar>
    </AppBar>
    <ChildContent>
        <XFTypography>Conteúdo principal</XFTypography>
    </ChildContent>
</XFAppShell>";

    private string InteractiveWasmExample => @"@page ""/erp/financeiro""
@rendermode InteractiveWebAssembly
@using XForge.DesignSystem.Components.Layout.Shell

