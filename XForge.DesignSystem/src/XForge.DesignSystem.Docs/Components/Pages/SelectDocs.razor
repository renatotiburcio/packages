    // ==================== 8. VALIDATION ====================
    private RenderFragment ExValidation() => @<div>
        <EditForm EditContext="@_editContext" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />
            <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                <XFSelect TValue="string" Label="@T("Categoria do produto", "Product category")" Placeholder="@T("Selecione a categoria", "Select category")" @bind-Value="_formModel.Category" HelperText="@T("Campo obrigatorio.", "Required field.")">
                    <XFSelectOption TValue="string" Value="@("eletronicos")" Text="@T("Eletronicos", "Electronics")" />
                    <XFSelectOption TValue="string" Value="@("moveis")" Text="@T("Moveis", "Furniture")" />
                    <XFSelectOption TValue="string" Value="@("vestuario")" Text="@T("Vestuario", "Clothing")" />
                </XFSelect>
                <XFSelect TValue="string" Label="@T("Regiao de entrega", "Delivery region")" Placeholder="@T("Selecione a regiao", "Select region")" @bind-Value="_formModel.Region">
                    <XFSelectOption TValue="string" Value="@("sudeste")" Text="Sudeste" />
                    <XFSelectOption TValue="string" Value="@("sul")" Text="Sul" />
                    <XFSelectOption TValue="string" Value="@("nordeste")" Text="Nordeste" />
                </XFSelect>
                <XFButton Type="XFButtonType.Submit" Variant="XFButtonVariant.Solid" Color="XFButtonColor.Primary" Size="XFExtendedSize.Md">@T("Enviar", "Submit")</XFButton>
                @if (_formSubmitted)
                {
                    <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Success" Text="@T("Formulario valido!", "Form valid!")" />
                }
            </XFStack>
        </EditForm>
    </div>;

