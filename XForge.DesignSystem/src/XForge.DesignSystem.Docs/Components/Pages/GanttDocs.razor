@page "/display/gantt"
@using XForge.DesignSystem.Components.DataDisplay.Gantt
@using XForge.DesignSystem.Core.Primitives
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFGantt" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("4 views", "4 views")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Acessivel", "Accessible")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Diagrama de Gantt para cronograma de projetos com tarefas, progresso e navegacao.",
                               "Gantt chart for project scheduling with tasks, progress and navigation.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("XFGantt exibe tarefas hierarquicas em timeline com 4 modos de visualizacao, barras de progresso, linha de hoje, dependencias e navegacao programatica.",
                               "XFGantt displays hierarchical tasks on a timeline with 4 view modes, progress bars, today line, dependencies and programmatic navigation.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts) { @Tile(item) }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observacoes", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restricoes.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Renderiza como HTML estatico. Interacoes requerem modo interativo.", "Renders as static HTML. Interactions require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependencias JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente nao utiliza JavaScript interop. E puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderizacao.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Consideracoes", "Considerations")</XFTypography>
                <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor Server: eventos sao tratados via SignalR. Sem latencia adicional para componentes puramente renderizados.", "Blazor Server: events are handled via SignalR. No additional latency for purely rendered components.")</XFTypography>
                    <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Blazor WebAssembly: eventos sao tratados diretamente no cliente. Mais responsivo.", "Blazor WebAssembly: events are handled directly on the client. More responsive.")</XFTypography>
                </XFStack>
            </XFStack>
        </div>)

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visao geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Proposito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 2)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando nao usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Basico — Projeto ERP", "1. Basic — ERP Project"),
                T("Gantt semanal com 5 tarefas, progresso e linha de hoje.", "Weekly Gantt with 5 tasks, progress and today line."),
                ExBasic(), CodeBasic)

            @Example(T("2. Hierarquia — Pai e filho", "2. Hierarchy — Parent and child"),
                T("Tarefas pai-filho com expand/collapse e profundidade.", "Parent-child tasks with expand/collapse and depth."),
                ExHierarchy(), CodeHierarchy)

            @Example(T("3. Views — Day, Week, Month, Year", "3. Views — Day, Week, Month, Year"),
                T("4 modos de visualizacao com colunas dinamicas.", "4 view modes with dynamic columns."),
                ExViews(), CodeViews)

            @Example(T("4. Navegacao programatica", "4. Programmatic navigation"),
                T("NavigateToToday, NavigatePrevious, NavigateNext, SetView.", "NavigateToToday, NavigatePrevious, NavigateNext, SetView."),
                ExNavigation(), CodeNavigation)

            @Example(T("5. Dependencias entre tarefas", "5. Task dependencies"),
                T("Setas de dependencia entre tarefas com 4 tipos de ligacao.", "Dependency arrows between tasks with 4 link types."),
                ExDependencies(), CodeDependencies)

            @Example(T("6. Variantes de tamanho e densidade", "6. Size and density variants"),
                T("Compact+Sm vs Comfortable+Lg.", "Compact+Sm vs Comfortable+Lg."),
                ExSizeVariant(), CodeSizeVariant)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Variantes", "Variants"), @<div>@NameValueTable(VariantRows, T("Variante", "Variant"), T("Caso de uso", "Use case"))</div>)
            @Section(T("Estados", "States"), @<div>@NameValueTable(StateRows, T("Estado", "State"), T("Comportamento", "Behavior"))</div>)
            @Section("API", @<div>@ApiTable(ApiRows)</div>)
            @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Metodos publicos", "Public methods"), @<div>@NameValueTable(MethodRows, T("Metodo", "Method"), T("Descricao", "Description"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 2)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Comportamento", "Behavior"))</div>)
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 2)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 2)</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenarios enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Boas praticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section("Design Tokens", @<div>@NameValueTable(TokenRows, "Token", T("Proposito", "Purpose"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestingRows, T("Cobertura", "Coverage"), T("Evidencia", "Evidence"))</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
        </XFStack>

        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Anti-padroes", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, T("Versao", "Version"), T("Mudanca", "Change"))</div>)
        </XFStack>
    </XFStack>
</XForgeDocsShell>

@code {
    private string ProductLabelText => T("Core Open Source", "Core Open Source");
    private string PageTitleText => "Gantt";
    private string PageStatusText => T("Estavel", "Stable");
    private string T(string ptBr, string enUs) => LanguageService.Text(ptBr, enUs);
    private string CopyableCodeTitle => T("Codigo copiavel", "Copyable code");

    // ── Sample Data ────────────────────────────────────────────────

    private static List<GanttTask> GetBasicTasks() => new()
    {
        new("1", null, "Analise de requisitos", DateTime.Today.AddDays(-3), DateTime.Today.AddDays(2), 80),
        new("2", null, "Design de interface", DateTime.Today.AddDays(1), DateTime.Today.AddDays(5), 40),
        new("3", null, "Desenvolvimento backend", DateTime.Today.AddDays(3), DateTime.Today.AddDays(10), 15),
        new("4", null, "Desenvolvimento frontend", DateTime.Today.AddDays(4), DateTime.Today.AddDays(12), 10),
        new("5", null, "Testes e homologacao", DateTime.Today.AddDays(10), DateTime.Today.AddDays(15), 0),
    };

    private static List<GanttTask> GetHierarchicalTasks() => new()
    {
        new("1", null, "Fase 1 — Planejamento", DateTime.Today.AddDays(-5), DateTime.Today.AddDays(0), 100),
        new("2", "1", "Levantamento de requisitos", DateTime.Today.AddDays(-5), DateTime.Today.AddDays(-3), 100),
        new("3", "1", "Documentacao tecnica", DateTime.Today.AddDays(-3), DateTime.Today.AddDays(0), 100),
        new("4", null, "Fase 2 — Desenvolvimento", DateTime.Today.AddDays(1), DateTime.Today.AddDays(14), 30),
        new("5", "4", "API REST", DateTime.Today.AddDays(1), DateTime.Today.AddDays(7), 60),
        new("6", "4", "Interface web", DateTime.Today.AddDays(5), DateTime.Today.AddDays(14), 10),
        new("7", null, "Fase 3 — Entrega", DateTime.Today.AddDays(14), DateTime.Today.AddDays(20), 0),
    };

    private static List<GanttTask> GetDependencyTasks() => new()
    {
        new("1", null, "Analise de requisitos", DateTime.Today.AddDays(-3), DateTime.Today.AddDays(2), 100),
        new("2", null, "Design de interface", DateTime.Today.AddDays(2), DateTime.Today.AddDays(6), 60),
        new("3", null, "Desenvolvimento backend", DateTime.Today.AddDays(3), DateTime.Today.AddDays(12), 20),
        new("4", null, "Desenvolvimento frontend", DateTime.Today.AddDays(7), DateTime.Today.AddDays(15), 0),
        new("5", null, "Testes e homologacao", DateTime.Today.AddDays(15), DateTime.Today.AddDays(20), 0),
    };

    private static List<XFGanttDependency> GetSampleDependencies() => new()
    {
        new XFGanttDependency { FromId = "1", ToId = "2", Type = XFGanttDependencyType.FinishToStart },
        new XFGanttDependency { FromId = "1", ToId = "3", Type = XFGanttDependencyType.FinishToStart },
        new XFGanttDependency { FromId = "2", ToId = "4", Type = XFGanttDependencyType.FinishToStart },
        new XFGanttDependency { FromId = "3", ToId = "5", Type = XFGanttDependencyType.FinishToStart },
    };

    // ── Live Examples ──────────────────────────────────────────────

    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFGantt TItem="GanttTask" Data="@GetBasicTasks()"
            IdFunc="@(t => t.Id)" TitleFunc="@(t => t.Title)"
            StartFunc="@(t => t.Start)" EndFunc="@(t => t.End)"
            ProgressFunc="@(t => t.Progress)"
            View="XFGanttView.Week" ShowProgress="true" ShowTodayLine="true"
            Height="300px" />
    </XFStack>;

    private RenderFragment ExBasic() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFGantt TItem="GanttTask" Data="@GetBasicTasks()"
            IdFunc="@(t => t.Id)" TitleFunc="@(t => t.Title)"
            StartFunc="@(t => t.Start)" EndFunc="@(t => t.End)"
            ProgressFunc="@(t => t.Progress)"
            View="XFGanttView.Week" ShowProgress="true" ShowTodayLine="true"
            Height="300px" />
    </XFStack>;

    private RenderFragment ExHierarchy() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFGantt TItem="GanttTask" Data="@GetHierarchicalTasks()"
            IdFunc="@(t => t.Id)" ParentIdFunc="@(t => t.ParentId)"
            TitleFunc="@(t => t.Title)"
            StartFunc="@(t => t.Start)" EndFunc="@(t => t.End)"
            ProgressFunc="@(t => t.Progress)"
            View="XFGanttView.Week" ShowProgress="true" ShowTodayLine="true"
            Height="350px" />
    </XFStack>;

    private RenderFragment ExViews() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <div class="grid grid-cols-2 gap-4">
            @foreach (var view in Enum.GetValues<XFGanttView>())
            {
                <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Sm">
                    <Header><XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@view</XFTypography></Header>
                    <ChildContent>
                        <XFGantt TItem="GanttTask" Data="@GetBasicTasks()"
                            IdFunc="@(t => t.Id)" TitleFunc="@(t => t.Title)"
                            StartFunc="@(t => t.Start)" EndFunc="@(t => t.End)"
                            ProgressFunc="@(t => t.Progress)"
                            View="@view" ShowProgress="true" ShowTodayLine="true"
                            Height="200px" />
                    </ChildContent>
                </XFCard>
            }
        </div>
    </XFStack>;

    private RenderFragment ExNavigation() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFGantt @ref="_ganttNav" TItem="GanttTask" Data="@GetBasicTasks()"
            IdFunc="@(t => t.Id)" TitleFunc="@(t => t.Title)"
            StartFunc="@(t => t.Start)" EndFunc="@(t => t.End)"
            ProgressFunc="@(t => t.Progress)"
            View="XFGanttView.Week" ShowProgress="true" ShowTodayLine="true"
            Height="300px" />
        <XFStack Orientation="XFOrientation.Horizontal" Gap="2">
            <XFButton Size="XFExtendedSize.Sm" Color="XFButtonColor.Primary" OnClick="@(() => _ganttNav.NavigateToToday())">
                <XFTypography Variant="XFTypographyVariant.Caption">@T("Hoje", "Today")</XFTypography>
            </XFButton>
            <XFButton Size="XFExtendedSize.Sm" Color="XFButtonColor.Secondary" OnClick="@(() => _ganttNav.NavigatePrevious())">
                <XFTypography Variant="XFTypographyVariant.Caption">@T("Anterior", "Previous")</XFTypography>
            </XFButton>
            <XFButton Size="XFExtendedSize.Sm" Color="XFButtonColor.Secondary" OnClick="@(() => _ganttNav.NavigateNext())">
                <XFTypography Variant="XFTypographyVariant.Caption">@T("Proximo", "Next")</XFTypography>
            </XFButton>
            <XFButton Size="XFExtendedSize.Sm" Color="XFButtonColor.Info" OnClick="@(() => _ganttNav.SetView(XFGanttView.Month))">
                <XFTypography Variant="XFTypographyVariant.Caption">@T("Mes", "Month")</XFTypography>
            </XFButton>
            <XFButton Size="XFExtendedSize.Sm" Color="XFButtonColor.Success" OnClick="@(() => _ganttNav.ExpandAll())">
                <XFTypography Variant="XFTypographyVariant.Caption">@T("Expandir", "Expand")</XFTypography>
            </XFButton>
            <XFButton Size="XFExtendedSize.Sm" Color="XFButtonColor.Warning" OnClick="@(() => _ganttNav.CollapseAll())">
                <XFTypography Variant="XFTypographyVariant.Caption">@T("Recolher", "Collapse")</XFTypography>
            </XFButton>
        </XFStack>
    </XFStack>;

    private XFGantt<GanttTask> _ganttNav = default!;

    private RenderFragment ExDependencies() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFGantt TItem="GanttTask" Data="@GetDependencyTasks()"
            IdFunc="@(t => t.Id)" TitleFunc="@(t => t.Title)"
            StartFunc="@(t => t.Start)" EndFunc="@(t => t.End)"
            ProgressFunc="@(t => t.Progress)"
            Dependencies="@GetSampleDependencies()"
            View="XFGanttView.Week" ShowProgress="true" ShowDependencies="true"
            ShowTodayLine="true" Height="300px" />
    </XFStack>;

    private RenderFragment ExSizeVariant() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <div class="grid grid-cols-2 gap-4">
            <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Sm">
                <Header><XFTypography Variant="XFTypographyVariant.Caption">Compact + Sm</XFTypography></Header>
                <ChildContent>
                    <XFGantt TItem="GanttTask" Data="@GetBasicTasks()"
                        IdFunc="@(t => t.Id)" TitleFunc="@(t => t.Title)"
                        StartFunc="@(t => t.Start)" EndFunc="@(t => t.End)"
                        ProgressFunc="@(t => t.Progress)"
                        View="XFGanttView.Week" ShowProgress="true" ShowTodayLine="true"
                        Variant="XFGanttVariant.Compact" Size="XFSize.Sm" Height="250px" />
                </ChildContent>
            </XFCard>
            <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Sm">
                <Header><XFTypography Variant="XFTypographyVariant.Caption">Comfortable + Lg</XFTypography></Header>
                <ChildContent>
                    <XFGantt TItem="GanttTask" Data="@GetBasicTasks()"
                        IdFunc="@(t => t.Id)" TitleFunc="@(t => t.Title)"
                        StartFunc="@(t => t.Start)" EndFunc="@(t => t.End)"
                        ProgressFunc="@(t => t.Progress)"
                        View="XFGanttView.Week" ShowProgress="true" ShowTodayLine="true"
                        Variant="XFGanttVariant.Comfortable" Size="XFSize.Lg" Height="350px" />
                </ChildContent>
            </XFCard>
        </div>
    </XFStack>;

    // ── Code Strings ───────────────────────────────────────────────

    private string CodeBasic => "@code {\n    private List<GanttTask> _tasks = new()\n    {\n        new(\"1\", null, \"Analise de requisitos\", DateTime.Today.AddDays(-3), DateTime.Today.AddDays(2), 80),\n        new(\"2\", null, \"Design de interface\", DateTime.Today.AddDays(1), DateTime.Today.AddDays(5), 40),\n        new(\"3\", null, \"Desenvolvimento backend\", DateTime.Today.AddDays(3), DateTime.Today.AddDays(10), 15),\n        new(\"4\", null, \"Desenvolvimento frontend\", DateTime.Today.AddDays(4), DateTime.Today.AddDays(12), 10),\n        new(\"5\", null, \"Testes e homologacao\", DateTime.Today.AddDays(10), DateTime.Today.AddDays(15), 0),\n    };\n}\n\n<XFGantt TItem=\"GanttTask\" Data=\"_tasks\"\n    IdFunc=\"t => t.Id\" TitleFunc=\"t => t.Title\"\n    StartFunc=\"t => t.Start\" EndFunc=\"t => t.End\"\n    ProgressFunc=\"t => t.Progress\"\n    View=\"XFGanttView.Week\"\n    ShowProgress=\"true\" ShowTodayLine=\"true\" />";
    private string CodeHierarchy => "@code {\n    private List<GanttTask> _tasks = new()\n    {\n        new(\"1\", null, \"Fase 1 — Planejamento\", DateTime.Today.AddDays(-5), DateTime.Today, 100),\n        new(\"2\", \"1\", \"Levantamento de requisitos\", DateTime.Today.AddDays(-5), DateTime.Today.AddDays(-3), 100),\n        new(\"3\", \"1\", \"Documentacao tecnica\", DateTime.Today.AddDays(-3), DateTime.Today, 100),\n        new(\"4\", null, \"Fase 2 — Desenvolvimento\", DateTime.Today.AddDays(1), DateTime.Today.AddDays(14), 30),\n        new(\"5\", \"4\", \"API REST\", DateTime.Today.AddDays(1), DateTime.Today.AddDays(7), 60),\n    };\n}\n\n<XFGantt TItem=\"GanttTask\" Data=\"_tasks\"\n    IdFunc=\"t => t.Id\" ParentIdFunc=\"t => t.ParentId\"\n    TitleFunc=\"t => t.Title\"\n    StartFunc=\"t => t.Start\" EndFunc=\"t => t.End\"\n    ProgressFunc=\"t => t.Progress\" />";
    private string CodeViews => "@foreach (var view in Enum.GetValues<XFGanttView>())\n{\n    <XFGantt TItem=\"GanttTask\" Data=\"_tasks\"\n        IdFunc=\"t => t.Id\" TitleFunc=\"t => t.Title\"\n        StartFunc=\"t => t.Start\" EndFunc=\"t => t.End\"\n        View=\"@view\" ShowProgress=\"true\" ShowTodayLine=\"true\" />\n}";
    private string CodeNavigation => "<XFGantt @ref=\"_gantt\" TItem=\"GanttTask\" Data=\"_tasks\"\n    IdFunc=\"t => t.Id\" TitleFunc=\"t => t.Title\"\n    StartFunc=\"t => t.Start\" EndFunc=\"t => t.End\" />\n\n@code {\n    private XFGantt<GanttTask> _gantt = default!;\n    private async Task GoToToday() => await _gantt.NavigateToToday();\n    private async Task Prev() => await _gantt.NavigatePrevious();\n    private async Task Next() => await _gantt.NavigateNext();\n    private async Task SetMonth() => await _gantt.SetView(XFGanttView.Month);\n    private async Task ExpandAll() => await _gantt.ExpandAll();\n    private async Task CollapseAll() => await _gantt.CollapseAll();\n}";
    private string CodeDependencies => "<XFGantt TItem=\"GanttTask\" Data=\"_tasks\"\n    IdFunc=\"t => t.Id\" TitleFunc=\"t => t.Title\"\n    StartFunc=\"t => t.Start\" EndFunc=\"t => t.End\"\n    ProgressFunc=\"t => t.Progress\"\n    Dependencies=\"_dependencies\"\n    View=\"XFGanttView.Week\"\n    ShowProgress=\"true\" ShowDependencies=\"true\" ShowTodayLine=\"true\" />\n\n@code {\n    private List<XFGanttDependency> _dependencies = new()\n    {\n        new XFGanttDependency { FromId = \"1\", ToId = \"2\", Type = XFGanttDependencyType.FinishToStart },\n        new XFGanttDependency { FromId = \"1\", ToId = \"3\", Type = XFGanttDependencyType.FinishToStart },\n        new XFGanttDependency { FromId = \"2\", ToId = \"4\", Type = XFGanttDependencyType.FinishToStart },\n    };\n}";
    private string CodeSizeVariant => "<XFGantt TItem=\"GanttTask\" Data=\"_tasks\"\n    IdFunc=\"t => t.Id\" TitleFunc=\"t => t.Title\"\n    StartFunc=\"t => t.Start\" EndFunc=\"t => t.End\"\n    View=\"XFGanttView.Week\"\n    Variant=\"XFGanttVariant.Compact\" Size=\"XFSize.Sm\" />\n\n<XFGantt TItem=\"GanttTask\" Data=\"_tasks\"\n    IdFunc=\"t => t.Id\" TitleFunc=\"t => t.Title\"\n    StartFunc=\"t => t.Start\" EndFunc=\"t => t.End\"\n    View=\"XFGanttView.Week\"\n    Variant=\"XFGanttVariant.Comfortable\" Size=\"XFSize.Lg\" />";

    // ── Static Data ────────────────────────────────────────────────

    private RenderFragment Section(string title, RenderFragment content) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Lg">
        <Header><XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography></Header>
        <ChildContent>@content</ChildContent>
    </XFCard>;

    private RenderFragment Example(string title, string description, RenderFragment preview, string codeText) => @<XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.None" AreaRestricted="false">
        <Header><div class="px-6 pt-6 pb-2">
            <XFTypography Variant="XFTypographyVariant.H4" Weight="XFTypographyWeight.Semibold">@title</XFTypography>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Muted">@description</XFTypography>
        </div></Header>
        <ChildContent><div class="flex flex-col">
            <div class="border-t border-border-light bg-surface-50/30 p-6">@preview</div>
            <div class="border-t border-border-light bg-surface-50 p-6">
                <XFCode Text="@codeText" Language="razor" Title="@CopyableCodeTitle" Variant="XFCodeVariant.Block" Copyable="true" Wrap="true" />
            </div>
        </div></ChildContent>
    </XFCard>;

    private RenderFragment Tile(DocTile item) => @<XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent>
        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <div class="flex items-center gap-4">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-primary/10 bg-primary/10 text-primary" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                <div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div>
            </div>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
        </XFStack>
    </ChildContent></XFCard>;

    private RenderFragment TileGrid(IReadOnlyList<DocTile> items, int columns) => @<XFGrid Cols="1" Md="@Math.Min(columns, 2)" Lg="@columns" Gap="4">@foreach (var item in items) { @Tile(item) }</XFGrid>;

    private RenderFragment WarningGrid(IReadOnlyList<DocTile> items) => @<XFGrid Cols="1" Md="2" Gap="4">@foreach (var item in items) {
        <XFCard Variant="XFCardVariant.Filled" Padding="XFPadding.Lg"><ChildContent><XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
            <div class="flex items-center gap-4">
                <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-danger/10 bg-danger/10 text-danger" aria-hidden="true">@((MarkupString)XFSvgIcons.MarkupWithSize(item.Icon, 18))</span>
                <div class="min-w-0"><XFTypography Variant="XFTypographyVariant.Body1" Weight="XFTypographyWeight.Semibold">@item.Title</XFTypography></div>
            </div>
            <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@item.Description</XFTypography>
        </XFStack></ChildContent></XFCard>
    }</XFGrid>;

    private RenderFragment NameValueTable(IReadOnlyList<NameValueRow> rows, string nameHeader, string valueHeader) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader><XFTableRow><XFTableCell Header="true">@nameHeader</XFTableCell><XFTableCell Header="true">@valueHeader</XFTableCell></XFTableRow></XFTableHeader>
        <XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Value</XFTableCell></XFTableRow> }</XFTableBody>
    </XFTable>;

    private RenderFragment ApiTable(IReadOnlyList<ApiRow> rows) => @<XFTable Striped="true" Hoverable="true" Compact="true">
        <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Parametro", "Parameter")</XFTableCell><XFTableCell Header="true">Type</XFTableCell><XFTableCell Header="true">Default</XFTableCell><XFTableCell Header="true">@T("Descricao", "Description")</XFTableCell></XFTableRow></XFTableHeader>
        <XFTableBody>@foreach (var row in rows) { <XFTableRow><XFTableCell><XFCode Text="@row.Name" /></XFTableCell><XFTableCell>@row.Type</XFTableCell><XFTableCell><XFCode Text="@row.DefaultValue" /></XFTableCell><XFTableCell>@row.Description</XFTableCell></XFTableRow> }</XFTableBody>
    </XFTable>;

