@page "/"

<XForgeDocsShell ProductLabel="Core OSS"
                 Title="XForge.DesignSystem.Docs"
                 Status="Migration target"
                 Items="XForgeDocsCatalog.CoreItems">
    <section class="grid gap-4 md:grid-cols-3">
        @foreach (var item in XForgeDocsCatalog.CoreItems)
        {
            <XFCard>
                <Header>
                    <div class="text-sm font-semibold">@item.Label</div>
                </Header>
                <ChildContent>
                    <p class="text-sm text-text-secondary">@item.ComponentName</p>
                </ChildContent>
            </XFCard>
        }
    </section>

    <XForgeDocsPageStandard ComponentName="Home" />
</XForgeDocsShell>