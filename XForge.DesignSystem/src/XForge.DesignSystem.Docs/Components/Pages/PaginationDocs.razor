@page "/navigation/pagination"
@page "/components/pagination"
@using XForge.DesignSystem.Components.Navigation.Pagination
@using XForge.DesignSystem.Components.Icon
@using XForge.DesignSystem.Services
@inject XForgeDocsLanguageService LanguageService

<XForgeDocsShell ProductLabel="@ProductLabelText"
                 Title="@PageTitleText"
                 Status="@PageStatusText"
                 Items="XForgeDocsCatalog.CoreItems">
    <XFStack Orientation="XFOrientation.Vertical" Gap="6" FullWidth="true">

        <!-- ===== HERO ===== -->
        <XFCard Variant="XFCardVariant.Outlined" Padding="XFPadding.Xl" AreaRestricted="false">
            <ChildContent>
                <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
                    <XFStack Orientation="XFOrientation.Horizontal" Gap="2" Wrap="XFWrap.Wrap">
                        <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="XFPagination" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("nav aria-label", "nav aria-label")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info" Text="@T("3 variantes", "3 variants")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Touch 44px", "Touch 44px")" />
                        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Danger" Text="@T("WAI-ARIA", "WAI-ARIA")" />
                    </XFStack>
                    <XFStack Orientation="XFOrientation.Vertical" Gap="2" FullWidth="true">
                        <XFTypography Variant="XFTypographyVariant.H2" Weight="XFTypographyWeight.Bold">
                            @T("Navegação paginada adaptativa e acessível.", "Adaptive and accessible paginated navigation.")
                        </XFTypography>
                        <XFTypography Variant="XFTypographyVariant.Body1" Color="XFTypographyColor.Secondary">
                            @T("XFPagination implementa navegação por páginas com ellipsis inteligente, resumo de itens, seletor de pageSize, templates customizados, layout responsivo e touch target 44px WCAG AAA.",
                               "XFPagination implements page navigation with smart ellipsis, item summary, pageSize selector, custom templates, responsive layout and 44px WCAG AAA touch target.")
                        </XFTypography>
                    </XFStack>
                    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_22rem]">
                        <div class="rounded-lg border border-border-light bg-surface-50 p-5">
                            @HeroPreview()
                        </div>
                        <XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
                            @foreach (var item in QuickFacts)
                            {
                                @Tile(item)
                            }
                        </XFStack>
                    </div>
                </XFStack>
            </ChildContent>
        </XFCard>

        <!-- ===== METADATA ===== -->
        @Section(T("Metadados", "Metadata"), @<div>@NameValueTable(MetadataRows, T("Campo", "Field"), T("Valor", "Value"))</div>)

        <!-- ===== BLAZOR COMPAT ===== -->
        @Section("Blazor Server e Blazor WebAssembly", @<div>
            <XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Compatibilidade", "Compatibility")</XFTypography>
                <XFTable Striped="true" Hoverable="true" Compact="true">
                    <XFTableHeader><XFTableRow><XFTableCell Header="true">@T("Modo", "Mode")</XFTableCell><XFTableCell Header="true">@T("Suporte", "Support")</XFTableCell><XFTableCell Header="true">@T("Observações", "Notes")</XFTableCell></XFTableRow></XFTableHeader>
                    <XFTableBody>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveServer" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições. Eventos via SignalR.", "Works without restrictions. Events via SignalR.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveWebAssembly" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições.", "Works without restrictions.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="InteractiveAuto" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Success" Text="@T("Sim", "Yes")" /></XFTableCell><XFTableCell>@T("Funciona sem restrições em ambos os estágios.", "Works without restrictions in both stages.")</XFTableCell></XFTableRow>
                        <XFTableRow><XFTableCell><XFCode Text="Static SSR" /></XFTableCell><XFTableCell><XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Warning" Text="@T("Parcial", "Partial")" /></XFTableCell><XFTableCell>@T("Renderiza HTML estático. Cliques requerem modo interativo.", "Renders static HTML. Clicks require interactive mode.")</XFTableCell></XFTableRow>
                    </XFTableBody>
                </XFTable>
                <XFTypography Variant="XFTypographyVariant.H5" Weight="XFTypographyWeight.Semibold">@T("Sem dependências JS", "No JS Dependencies")</XFTypography>
                <XFTypography Variant="XFTypographyVariant.Body2" Color="XFTypographyColor.Secondary">@T("Este componente não utiliza JavaScript interop. É puramente renderizado com C# e Tailwind CSS. Funciona identicamente em todos os modos de renderização.", "This component does not use JavaScript interop. It is purely rendered with C# and Tailwind CSS. It works identically in all rendering modes.")</XFTypography>
            </XFStack>
        </div>)

        <!-- ===== OVERVIEW / PURPOSE / WHEN TO USE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Visão geral", "Overview"), @<div>@TileGrid(OverviewItems, 3)</div>)
            @Section(T("Propósito", "Purpose"), @<div>@TileGrid(PurposeItems, 3)</div>)
            @Section(T("Problema resolvido", "Problem Solved"), @<div>@TileGrid(ProblemItems, 3)</div>)
            @Section(T("Quando usar", "When To Use"), @<div>@TileGrid(UseItems, 2)</div>)
            @Section(T("Quando não usar", "When Not To Use"), @<div>@WarningGrid(AvoidItems)</div>)
            @Section(T("Anatomia", "Anatomy"), @<div>@TileGrid(AnatomyItems, 3)</div>)
        </XFStack>

        <!-- ===== DESIGN ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Princípios de design", "Design Principles"), @<div>@TileGrid(DesignPrincipleItems, 3)</div>)
        </XFStack>

        <!-- ===== 11 EXAMPLES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Example(T("1. Básico — paginação simples", "1. Basic — simple pagination"),
                T("Paginação com seletor de itens por página, resumo e recarga. O exemplo mais comum em DataGrids.",
                 "Pagination with items-per-page selector, summary and reload. The most common pattern in DataGrids."),
                ExBasic(), CodeBasic)

            @Example(T("2. Tamanhos", "2. Sizes"),
                T("Sm (28px), Md (36px) e Lg (40px) — todos com touch target mínimo 44px para WCAG AAA.",
                 "Sm (28px), Md (36px) and Lg (40px) — all with minimum 44px touch target for WCAG AAA."),
                ExSizes(), CodeSizes)

            @Example(T("3. Variantes de container", "3. Container variants"),
                T("Plain (sem estilo), Soft (fundo sutil) e Surface (borda + sombra) para diferentes contextos visuais.",
                 "Plain (no style), Soft (subtle background) and Surface (border + shadow) for different visual contexts."),
                ExVariants(), CodeVariants)

            @Example(T("4. Densidade", "4. Density"),
                T("Comfortable (padrão) e Compact (espaçamento reduzido) para diferentes densidades de UI.",
                 "Comfortable (default) and Compact (reduced spacing) for different UI densities."),
                ExDensity(), CodeDensity)

            @Example(T("5. Cores ativas", "5. Active colors"),
                T("ActiveColor define a cor da página ativa: Primary (padrão), Secondary, Success, Warning e Danger.",
                 "ActiveColor defines the active page color: Primary (default), Secondary, Success, Warning and Danger."),
                ExActiveColor(), CodeActiveColor)

            @Example(T("6. Ellipsis e janela de páginas", "6. Ellipsis and page window"),
                T("SiblingCount e BoundaryCount controlam quantas páginas são visíveis ao redor da atual.",
                 "SiblingCount and BoundaryCount control how many pages are visible around the current one."),
                ExEllipsis(), CodeEllipsis)

            @Example(T("7. Templates customizados", "7. Custom templates"),
                T("SummaryTemplate e PageTemplate para personalizar a renderização do resumo e dos números de página.",
                 "SummaryTemplate and PageTemplate to customize the rendering of summary and page numbers."),
                ExTemplates(), CodeTemplates)

            @Example(T("8. Ícones customizados", "8. Custom icons"),
                T("FirstContent, PreviousContent, NextContent, LastContent e ReloadContent para substituir os ícones padrão.",
                 "FirstContent, PreviousContent, NextContent, LastContent and ReloadContent to replace default icons."),
                ExCustomIcons(), CodeCustomIcons)

            @Example(T("9. Recursos toggle", "9. Feature toggles"),
                T("Controle individual de cada elemento: ShowSummary, ShowFirstLast, ShowPageNumbers, AutoHide.",
                 "Individual control of each element: ShowSummary, ShowFirstLast, ShowPageNumbers, AutoHide."),
                ExToggles(), CodeToggles)

            @Example(T("10. Eventos interativos", "10. Interactive events"),
                T("Callback Change com estado reativo. Clique nas páginas para ver o evento disparado em tempo real.",
                 "Change callback with reactive state. Click pages to see the fired event in real time."),
                ExInteractive(), CodeInteractive)

            @Example(T("11. Desabilitado", "11. Disabled"),
                T("Componente desabilitado com Disabled=true. Todos os botões ficam inativos e com opacidade reduzida.",
                 "Disabled component with Disabled=true. All buttons become inactive with reduced opacity."),
                ExDisabled(), CodeDisabled)

            @Example(T("12. Cenário enterprise — notas fiscais", "12. Enterprise scenario — invoices"),
                T("Paginação completa integrada a uma tabela de notas fiscais com status, totais e seletor de pageSize.",
                 "Full pagination integrated with an invoice table with status, totals and pageSize selector."),
                ExEnterprise(), CodeEnterprise)
        </XFStack>

        <!-- ===== VARIANTS / STATES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Variantes", "Variants"), @<div>@NameValueTable(VariantRows, T("Variante", "Variant"), T("Descrição", "Description"))</div>)
            @Section(T("Estados", "States"), @<div>@NameValueTable(StateRows, T("Estado", "State"), T("Comportamento", "Behavior"))</div>)
        </XFStack>

        <!-- ===== API ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("API: XFPagination", @<div>@ApiTable(PaginationApiRows)</div>)
            @Section("API: XFPaginationChangedEventArgs", @<div>@ApiTable(EventArgsApiRows)</div>)
        </XFStack>

        <!-- ===== EVENTS ===== -->
        @Section(T("Eventos", "Events"), @<div>@NameValueTable(EventRows, T("Evento", "Event"), T("Descrição", "Description"))</div>)

        <!-- ===== ACCESSIBILITY ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Acessibilidade", "Accessibility"), @<div>@TileGrid(AccessibilityItems, 3)</div>)
            @Section(T("Suporte de teclado", "Keyboard Support"), @<div>@NameValueTable(KeyboardRows, T("Tecla", "Key"), T("Ação", "Action"))</div>)
        </XFStack>

        <!-- ===== RESPONSIVENESS / PERFORMANCE ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Responsividade", "Responsiveness"), @<div>@TileGrid(ResponsivenessItems, 3)</div>)
            @Section(T("Performance", "Performance"), @<div>@TileGrid(PerformanceItems, 3)</div>)
        </XFStack>

        <!-- ===== ENTERPRISE / COMPOSITION / BEST PRACTICES ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Cenários enterprise", "Enterprise Scenarios"), @<div>@TileGrid(ScenarioItems, 3)</div>)
            @Section(T("Padrões de composição", "Composition Patterns"), @<div>@TileGrid(CompositionItems, 3)</div>)
            @Section(T("Boas práticas de UX", "UX Best Practices"), @<div>@TileGrid(BestPracticeItems, 2)</div>)
            @Section(T("Anti-padrões", "Anti-patterns"), @<div>@WarningGrid(AntiPatternItems)</div>)
        </XFStack>

        <!-- ===== TOKENS / THEMES / SECURITY / TESTING ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section("Design Tokens", @<div>@NameValueTable(TokenRows, T("Categoria", "Category"), T("Tokens", "Tokens"))</div>)
            @Section(T("Temas", "Theming"), @<div>@TileGrid(ThemeItems, 2)</div>)
            @Section(T("Segurança", "Security"), @<div>@TileGrid(SecurityItems, 2)</div>)
            @Section(T("Testes", "Testing"), @<div>@NameValueTable(TestRows, T("Tipo", "Type"), T("Cobertura", "Coverage"))</div>)
        </XFStack>

        <!-- ===== LIMITATIONS / RELATED / FAQ / CHANGELOG ===== -->
        <XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
            @Section(T("Limitações conhecidas", "Known Limitations"), @<div>@NameValueTable(LimitationRows, T("Limitação", "Limitation"), T("Detalhe", "Detail"))</div>)
            @Section(T("Componentes relacionados", "Related Components"), @<div>@TileGrid(RelatedComponentItems, 3)</div>)
            @Section("FAQ", @<div>@NameValueTable(FaqRows, T("Pergunta", "Question"), T("Resposta", "Answer"))</div>)
            @Section("Changelog", @<div>@NameValueTable(ChangelogRows, "Version", T("Mudança", "Change"))</div>)
        </XFStack>

    </XFStack>
</XForgeDocsShell>

@code {
    private string ProductLabelText => "Core OSS";
    private string PageTitleText => "Pagination";
    private string PageStatusText => "Premium";
    private string T(string pt, string en) => LanguageService.Text(pt, en);
    private static RenderFragment SvgIcon(string name) => builder => builder.AddMarkupContent(0, XFSvgIcons.GetWithSize(name, 16));
    private string CopyableCodeTitle => T("Código copiável", "Copyable code");
    private IReadOnlyList<int> PageSizeOptions => [10, 25, 50, 100];

    // ==================== HERO PREVIEW ====================
    private int heroPage = 3;
    private int heroPageSize = 25;

    private RenderFragment HeroPreview() => @<XFStack Orientation="XFOrientation.Vertical" Gap="4" FullWidth="true">
        <XFStack Orientation="XFOrientation.Horizontal" Gap="3" Align="XFAlign.Center">
            <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="@($"248 {T("notas", "invoices")}")" />
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Página", "Page") @heroPage / 10</XFTypography>
        </XFStack>
        <XFPagination Size="XFSize.Md" Page="@heroPage" PageSize="@heroPageSize" TotalItems="248"
                      ShowPageSize="true" PageSizeOptions="PageSizeOptions" AllowReload="true"
                      ShowSummary="true" Variant="XFContainerVariant.Surface" AriaLabel="Hero pagination" />
    </XFStack>;

    // ==================== QUICK FACTS ====================
    private IReadOnlyList<DocTile> QuickFacts => [
        new(T("Ellipsis inteligente", "Smart ellipsis"), T("BoundaryCount e SiblingCount controlam páginas visíveis ao redor da atual.", "BoundaryCount and SiblingCount control visible pages around the current one."), "arrows-left-right"),
        new(T("3 variantes", "3 variants"), T("Plain, Soft e Surface para diferentes contextos visuais.", "Plain, Soft and Surface for different visual contexts."), "palette"),
        new(T("Templates custom", "Custom templates"), T("SummaryTemplate e PageTemplate para renderização personalizada.", "SummaryTemplate and PageTemplate for personalized rendering."), "pen"),
        new(T("Touch 44px AAA", "44px AAA touch"), T("min-h/w em todos os botões para conformidade WCAG 2.5.8.", "min-h/w on all buttons for WCAG 2.5.8 compliance."), "hand-pointer"),
        new(T("Sem JS", "No JS"), T("Navegação por páginas implementada em C# puro, sem interop.", "Page navigation implemented in pure C#, no interop."), "bolt")
    ];

    // ==================== METADATA ====================
    private IReadOnlyList<NameValueRow> MetadataRows => [
        new("Component", "XFPagination"),
        new("Namespace", "XForge.DesignSystem.Components.Navigation.Pagination"),
        new("Package", "XForge.DesignSystem"),
        new("Category", "Navigation / Pagination"),
        new("Status", T("Estável", "Stable")),
        new("Accessibility", T("nav aria-label, aria-current=page, aria-disabled, touch target 44px AAA, focus 40%.", "nav aria-label, aria-current=page, aria-disabled, 44px AAA touch target, 40% focus.")),
        new("Theme support", T("Light, dark e data-brand via CSS variables.", "Light, dark and data-brand via CSS variables."))
    ];

    // ==================== OVERVIEW ====================
    private IReadOnlyList<DocTile> OverviewItems => [
        new(T("Navegação", "Navigation"), T("First/prev/pages/next/last com ellipsis inteligente.", "First/prev/pages/next/last with smart ellipsis."), "list-ol"),
        new(T("Resumo", "Summary"), T("Faixa de itens visíveis e total, ou template custom.", "Visible item range and total, or custom template."), "list"),
        new(T("PageSize", "PageSize"), T("Seletor de itens por página configurável.", "Configurable items-per-page selector."), "sliders")
    ];

    private IReadOnlyList<DocTile> PurposeItems => [
        new(T("Listas grandes", "Large lists"), T("Navegar por centenas/milhares de registros.", "Browse hundreds/thousands of records."), "database"),
        new(T("Controle de carga", "Load control"), T("Limita itens por request para performance.", "Limits items per request for performance."), "gauge"),
        new(T("UX consistente", "Consistent UX"), T("Padrão reconhecível em todo o ERP.", "Recognizable pattern across the ERP."), "circle-check")
    ];

    private IReadOnlyList<DocTile> ProblemItems => [
        new(T("Antes", "Before"), T("Listas longas sem paginação causam lentidão e sobrecarga de dados.", "Long lists without pagination cause slowness and data overload."), "xmark"),
        new(T("Depois", "After"), T("Paginação server-side com resumo, navegação acessível e seletor de pageSize.", "Server-side pagination with summary, accessible navigation and pageSize selector."), "check"),
        new(T("Acessibilidade", "Accessibility"), T("nav aria-label, aria-current=page e touch target 44px WCAG AAA.", "nav aria-label, aria-current=page and 44px WCAG AAA touch target."), "shield-check")
    ];

    private IReadOnlyList<DocTile> UseItems => [
        new(T("DataGrid", "DataGrid"), T("Paginação de tabelas com muitas linhas e ordenação.", "Table pagination with many rows and sorting."), "table"),
        new(T("Listas", "Lists"), T("Listagens de produtos, clientes, funcionários.", "Product, customer, employee listings."), "list"),
        new(T("Relatórios", "Reports"), T("Resultados paginados com filtros e exportação.", "Paginated results with filters and export."), "chart-bar")
    ];

    private IReadOnlyList<DocTile> AvoidItems => [
        new(T("Poucos itens", "Few items"), T("Não use para menos de 10 itens. Mostre tudo de uma vez.", "Do not use for fewer than 10 items. Show everything at once."), "xmark"),
        new(T("Conteúdo infinito", "Infinite content"), T("Use virtual scroll para feeds infinitos, não paginação.", "Use virtual scroll for infinite feeds, not pagination."), "triangle-exclamation")
    ];

    private IReadOnlyList<DocTile> AnatomyItems => [
        new("nav[aria-label]", T("Container semântico nav com aria-label para leitores de tela.", "Semantic nav container with aria-label for screen readers."), "code"),
        new("Summary", T("Exibe faixa de itens visíveis (ex: 1-25 de 248) ou template custom.", "Displays visible item range (e.g. 1-25 of 248) or custom template."), "list"),
        new("PageSize selector", T("Select com opções de itens por página (10, 25, 50, 100).", "Select with items-per-page options (10, 25, 50, 100)."), "sliders"),
        new("First / Prev / Pages / Next / Last", T("Botões de navegação com aria-current=page na página ativa.", "Navigation buttons with aria-current=page on the active page."), "arrows-left-right"),
        new("Reload", T("Botão opcional para recarregar a página atual.", "Optional button to reload the current page."), "arrows-rotate"),
        new("Ellipsis", T("Indicador visual de páginas ocultas com aria-hidden.", "Visual indicator of hidden pages with aria-hidden."), "ellipsis")
    ];

    // ==================== DESIGN ====================
    private IReadOnlyList<DocTile> DesignPrincipleItems => [
        new(T("Clareza", "Clarity"), T("Resumo visível mostra exatamente onde o usuário está na lista.", "Visible summary shows exactly where the user is in the list."), "eye"),
        new(T("Eficiência", "Efficiency"), T("Seletor de pageSize permite controlar a quantidade de dados carregados.", "PageSize selector allows controlling the amount of loaded data."), "gauge"),
        new(T("Acessibilidade", "Accessibility"), T("Navegação completa por teclado com aria-current e aria-disabled.", "Full keyboard navigation with aria-current and aria-disabled."), "universal-access")
    ];

    // ==================== EXAMPLES ====================

    // --- EX 1: BASIC ---
    private int basicPage = 1;
    private int basicPageSize = 10;

    private RenderFragment ExBasic() => @<XFStack Orientation="XFOrientation.Vertical" Gap="3" FullWidth="true">
        <XFPagination Size="XFSize.Md" Page="@basicPage" PageSize="@basicPageSize" TotalItems="890"
                      ShowPageSize="true" PageSizeOptions="PageSizeOptions" AllowReload="true"
                      ShowSummary="true" Change="OnBasicChange" AriaLabel="@T("Paginação básica", "Basic pagination")" />
        <XFBadge Variant="XFBadgeVariant.Soft" Color="XFBadgeColor.Info"
                 Text="@($"Page: {basicPage} | PageSize: {basicPageSize} | Total: 890")" />
    </XFStack>;

    private void OnBasicChange(XFPaginationChangedEventArgs args)
    {
        basicPage = args.Page;
        basicPageSize = args.PageSize;
    }

    private const string CodeBasic = @"<XFPagination Size=""XFSize.Md"" Page=""@basicPage"" PageSize=""@basicPageSize""
              TotalItems=""890"" ShowPageSize=""true""
              PageSizeOptions=""new[] { 10, 25, 50, 100 }""
              AllowReload=""true"" ShowSummary=""true""
              Change=""OnBasicChange"" />

@code {
    private int basicPage = 1;
    private int basicPageSize = 10;

    private void OnBasicChange(XFPaginationChangedEventArgs args)
    {
        basicPage = args.Page;
        basicPageSize = args.PageSize;
    }
}";

    // --- EX 2: SIZES ---
    private RenderFragment ExSizes() => @<XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
        <XFStack Orientation="XFOrientation.Vertical" Gap="1" FullWidth="true">
            <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="Sm" />
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Compacto, 28px.", "Compact, 28px.")</XFTypography>
            <XFPagination Size="XFSize.Sm" Page="3" PageSize="10" TotalItems="100" AriaLabel="Small pagination" />
        </XFStack>
        <XFStack Orientation="XFOrientation.Vertical" Gap="1" FullWidth="true">
            <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="Md" />
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Padrão, 36px.", "Default, 36px.")</XFTypography>
            <XFPagination Size="XFSize.Md" Page="3" PageSize="10" TotalItems="100" AriaLabel="Medium pagination" />
        </XFStack>
        <XFStack Orientation="XFOrientation.Vertical" Gap="1" FullWidth="true">
            <XFBadge Variant="XFBadgeVariant.Solid" Color="XFBadgeColor.Primary" Text="Lg" />
            <XFTypography Variant="XFTypographyVariant.Caption" Color="XFTypographyColor.Muted">@T("Touch-first, 40px.", "Touch-first, 40px.")</XFTypography>
            <XFPagination Size="XFSize.Lg" Page="3" PageSize="10" TotalItems="100" AriaLabel="Large pagination" />
        </XFStack>
    </XFStack>;

    private const string CodeSizes = @"<XFPagination Size=""XFSize.Sm"" Page=""3"" PageSize=""10"" TotalItems=""100"" />
<XFPagination Size=""XFSize.Md"" Page=""3"" PageSize=""10"" TotalItems=""100"" />
<XFPagination Size=""XFSize.Lg"" Page=""3"" PageSize=""10"" TotalItems=""100"" />";

    // --- EX 3: VARIANTS ---
    private RenderFragment ExVariants() => @<XFStack Orientation="XFOrientation.Vertical" Gap="5" FullWidth="true">
        <XFStack Orientation="XFOrientation.Vertical" Gap="1" FullWidth="true">
