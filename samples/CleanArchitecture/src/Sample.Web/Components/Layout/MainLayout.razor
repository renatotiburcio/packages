@inherits LayoutComponentBase
@implements IDisposable

<a href="#main-content"
   class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:bg-surface focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-text-primary focus:shadow-lg">
    Pular para o conteudo principal
</a>

<XFAppShell Theme="@Theme"
            Brand="@CurrentBrand"
            MainClass="flex-1 overflow-y-auto overflow-x-hidden bg-surface-50/30 outline-none p-4 md:p-6 lg:p-8">
    <Rail>
        <SampleRail />
    </Rail>
    <Sidebar>
        <SampleSidebar />
    </Sidebar>
    <AppBar>
        <SampleAppBar IsDark="@_isDark" OnToggleTheme="@ToggleThemeAsync" />
    </AppBar>
    <Footer>
        <XFFooter UserName="Sample Clean Architecture"
                  AppName="Clientes"
                  Version="v1.0.0"
                  StatusText="Estável"
                  Environment="Produção" />
    </Footer>
    <ChildContent>
        <XFDialogProvider />
        <XFDrawerProvider />
        <XFToastProvider />
        @Body
    </ChildContent>
</XFAppShell>

@code {
    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;
    [Inject] private NavigationStateService NavigationState { get; set; } = default!;
    [Inject] private BrandMetadataService BrandMetadata { get; set; } = default!;

    private bool _isDark;
    private int _renderKey;

    private string Theme => _isDark ? "dark" : "light";

    private string CurrentBrand => string.IsNullOrWhiteSpace(NavigationState.CurrentBrand)
        ? "clientes"
        : NavigationState.CurrentBrand;

    [Inject] private NavigationManager Navegacao { get; set; } = default!;

    protected override void OnInitialized()
    {
        NavigationState.BrandChanged += OnBrandChanged;
        Navegacao.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Forca o layout a re-renderizar em TODA navegacao, inclusive quando a marca
        // nao muda (ex.: /clientes -> /clientes/novo). Sem isto o RouteView mantém o
        // RouteData anterior e o conteúdo não troca apesar da URL mudar.
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // NAO chamar NavigationState.InitializeAsync aqui: XFRail.OnInitializedAsync
        // ja registra os itens. Chamar duas vezes limpava e re-registrava a lista,
        // e o item "Clientes" sumia do rail interativo.
        await InitializeThemeAsync();
        StateHasChanged();
    }

    private async Task InitializeThemeAsync()
    {
        try
        {
            var theme = await JSRuntime.InvokeAsync<string>("xfTheme.getTheme");
            _isDark = string.Equals(theme, "dark", StringComparison.OrdinalIgnoreCase);
        }
        catch
        {
            _isDark = false;
        }
    }

    private async Task ToggleThemeAsync()
    {
        try
        {
            var theme = await JSRuntime.InvokeAsync<string>("xfTheme.toggleTheme");
            _isDark = string.Equals(theme, "dark", StringComparison.OrdinalIgnoreCase);
        }
        catch
        {
            _isDark = !_isDark;
        }
    }

    private void OnBrandChanged(object? sender, string brand)
    {
        _ = InvokeAsync(() =>
        {
            _renderKey++;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        NavigationState.BrandChanged -= OnBrandChanged;
        Navegacao.LocationChanged -= OnLocationChanged;
        GC.SuppressFinalize(this);
    }
}
