<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(Sample.Web.Components.Layout.MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(Sample.Web.Components.Layout.MainLayout)">
            <main class="p-8 text-text-primary">
                <h1 class="text-xl font-semibold">Pagina nao encontrada</h1>
            </main>
        </LayoutView>
    </NotFound>
</Router>
