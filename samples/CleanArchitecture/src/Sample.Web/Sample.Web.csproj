<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Sample.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- O Sdk.Web ja referencia Microsoft.AspNetCore.App; explicitar duplica a
         referencia e muda a resolucao das assemblies de compilacao do Razor. -->
  </ItemGroup>

  <!--
    O CSS do design system traz somente os tokens de tema. As classes utilitarias
    (.flex, .h-5, .grid...) sao geradas pelo Tailwind a partir dos .razor do projeto.
    Sem este target o app sobe sem estilo nenhum.
    O build e ignorado quando node_modules nao existe (ex.: restore em CI sem npm).
  -->
  <Target Name="BuildTailwindCSS" BeforeTargets="Build" Condition="Exists('node_modules')">
    <Exec Command="npm run build:css" StandardOutputImportance="low" />
  </Target>

  <ItemGroup>
    <!-- referencias de projeto, no mesmo padrao da Sample.Api -->
    <ProjectReference Include="..\..\..\..\XForge.Mediator.Behaviors\src\XForge.Mediator.Behaviors\XForge.Mediator.Behaviors.csproj" />
    <ProjectReference Include="..\..\..\..\XForge.Validation\src\XForge.Validation\XForge.Validation.csproj" />
    <ProjectReference Include="..\..\..\..\XForge.DesignSystem\src\XForge.DesignSystem\XForge.DesignSystem.csproj" />
    <ProjectReference Include="..\Sample.Domain\Sample.Domain.csproj" />
    <ProjectReference Include="..\Sample.Application\Sample.Application.csproj" />
    <ProjectReference Include="..\Sample.Infrastructure\Sample.Infrastructure.csproj" />
  </ItemGroup>

</Project>
