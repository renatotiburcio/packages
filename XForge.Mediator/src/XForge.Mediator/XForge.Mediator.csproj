<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>XForge.Mediator</RootNamespace>

    <!-- Packaging -->
    <PackageId>XForge.Mediator</PackageId>
    <Version>0.1.0</Version>
    <Authors>XForge</Authors>
    <Company>XForge</Company>
    <Product>XForge.Mediator</Product>
    <Description>Simple, flexible and fast in-process mediator for requests, commands, queries, notifications and streams. Clean/CQRS-friendly with pipeline behaviors, pre/post processors, exception handling and publishing strategies.</Description>
    <PackageTags>mediator;mediatr;cqrs;clean-architecture;pipeline;in-memory;eventing;commands;queries</PackageTags>
    <PackageProjectUrl>https://github.com/renatotiburcio/packages</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="8.0.1" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.5.4" />
  </ItemGroup>

</Project>
