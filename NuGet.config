<?xml version="1.0" encoding="utf-8"?>
<!--
  Feed local de pacotes XForge.

  Enquanto a publicacao no nuget.org nao acontece, os pacotes sao distribuidos por
  uma pasta local (servidor de arquivos). O nuget.org continua como fallback para
  as dependencias externas (Microsoft.*, xunit, bunit, etc).

  Para publicar uma nova versao:
    dotnet pack <projeto> -c Release -o D:\Pacotes
-->
<configuration>
  <packageSources>
    <clear />
    <add key="XForge.Local" value="D:\Pacotes" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="XForge.Local">
      <package pattern="XForge.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
