<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>XForge.Validation</RootNamespace>

    <!-- Packaging -->
    <PackageId>XForge.Validation</PackageId>
    <Version>0.1.0</Version>
    <Authors>XForge</Authors>
    <Company>XForge</Company>
    <Product>XForge.Validation</Product>
    <Description>Simple, flexible and fast validation for .NET — fluent RuleFor API with 20+ built-in validators, rule sets, conditions, collections, async, severity, standardized error codes, guard clauses (Ensure) and built-in DI scanning.</Description>
    <PackageTags>validation;validator;fluentvalidation;fluent;rules;guard;clauses;ensure;cqrs;clean-architecture</PackageTags>
    <PackageProjectUrl>https://github.com/renatotiburcio/packages</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>

</Project>
